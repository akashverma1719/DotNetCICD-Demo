        [HttpPost]
        public ActionResult ForgetPassword1(Users Data)
        {

            string ipAddress1 = Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
            if (string.IsNullOrEmpty(ipAddress1))
            {
                ipAddress1 = Request.ServerVariables["REMOTE_ADDR"];
            }

