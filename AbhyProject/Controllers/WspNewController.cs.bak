            if (string.IsNullOrEmpty(ipAddress1))
            {
                ipAddress1 = Request.ServerVariables["REMOTE_ADDR"];
            }
            var Data = ABE.obj_abhy_tbl_error.Where(x => x.ipaddress == ipAddress1).ToList();
            return Json(Data, JsonRequestBehavior.AllowGet);

        }


