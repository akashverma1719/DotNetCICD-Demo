@model IEnumerable<AbhyProject.Models.supplyside_dli3_new>
@{
    Layout = "~/Views/Shared/loginlogoutcheck.cshtml";
    var i = 1;
}

<!DOCTYPE html>
<link href="~/Content/Website/lib/nivo-slider/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<script src="~/Content/Website/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.19/js/dataTables.bootstrap.min.js"></script>

<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid orange;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }
</style>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HackFixForLatAndLongitude</title>
</head>
<body>
    <div class="ss">
        <div class="row">
            <div class="col-md-12">
                <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="tbl-responsive">
                    <table id="example" class=" display  table stripe row-border order-column table-striped table-bordered dataTable no-footer" style="width:100%">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Latitude</th>
                                <th>Validate Latitude</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.longitude)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.old_lon)
                                        </td>
                                    </tr>
                                    i = i + 1;
                                }




                            }
                            <!--Rows here-->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
