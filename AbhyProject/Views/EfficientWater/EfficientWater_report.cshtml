            $("#fy_phase").show();
        }
        else if (YearForDropDown == "2024-25") {
            optionState = '<option value="Phase-1">Phase-1[Apr 2024 - Sep 2024]</option>';
            $("#fy_phase").html(optionState);
            $("#fy_phase").show();
        }
