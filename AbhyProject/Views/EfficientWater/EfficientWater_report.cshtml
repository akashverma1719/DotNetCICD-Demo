            $("#fy_phase").hide();
        }
        else if (YearForDropDown == "2023-24") {
            optionState = '<option value="Phase-1">Phase-1[Apr 2023 - Sep 2023]</option>';
            optionState += '<option value="Phase-2">Phase-2[Oct 2023 - March 2024]</option>';
