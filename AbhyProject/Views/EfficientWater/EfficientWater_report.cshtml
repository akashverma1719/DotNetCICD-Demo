    function approve_state(id, RowNo) {
        var i = 0;
        var id = id;
        if (i == 0) {
            var formdata = new FormData();
            formdata.append("id", id);
            $.ajax({
                url: '/EfficientWater/approve_data_state',
                data: formdata,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (response) {
                    alert(response);
                    if (response == "SessionTimeOut") {
                          window.location = "/Home/LogOut";
                    }
                    Data_get();
                },
                error: function () {
                    alert('Approved Failed');
                }
            });
        }
    }
