        code += '<td>' + count_shifting + '</td>';
        code += '<td><input type="text" id="txtGround_water_req_khaif' + count_shifting + '" data-decimal="4" maxlength="10" class="form-control decimal" oninput="waterDemand_calc(\'txt_area_khaif' + count_shifting + '\',\'txtGround_water_req_khaif' + count_shifting + '\',\'irri_kharif_waterdemand\',' + count_shifting + ',\'kharif\',this)"></td>';
        code += '<td><input type="text" id="txtGround_water_req_khaif' + count_shifting + '" data-decimal="4" maxlength="10" class="form-control decimal" oninput="waterDemand_calc(\'txt_area_khaif' + count_shifting + '\',\'txtGround_water_req_khaif' + count_shifting + '\',\'irri_kharif_waterdemand\',' + count_shifting + ',\'kharif\',this)"></td>';
        code += '<td><input type="text" id="txtGround_water_req_khaif' + count_shifting + '" data-decimal="4" maxlength="10" class="form-control decimal" oninput="waterDemand_calc(\'txt_area_khaif' + count_shifting + '\',\'txtGround_water_req_khaif' + count_shifting + '\',\'irri_kharif_waterdemand\',' + count_shifting + ',\'kharif\',this)"></td>';
        code += '<td id="other_crop" style="display:none;"><input type="text" id = "othercrop_khaif' + count_shifting + '" class="form-control"></td>';
        code += '<td><select id="ddlcrop_khaif_type1' + count_shifting + '" onchange="type2_get(ddlcrop_khaif_type1' + count_shifting + ',' + count_shifting + ',ddlcrop_khaif_type2' + count_shifting + ')"><option value="0">--Select Name of scheme--</option ><option value="Agriculture department">Agriculture Department</option ><option value="Horticulture Department">Horticulture Department</option ></select ></td></tr>';

        /* code += '<td><input type="number" id="txt_water_dem_khaif' + count_shifting + '"oninput="Auto_CheckVal(event,1,100)" class="form-control"></td></tr >';*/

        $('table#TblData_abc_part1 tbody').prepend(code);
        count_shifting++;
    }


