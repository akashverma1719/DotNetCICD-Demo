    <center>
        <div class="text-h g-mb-20" style="font-size: 35px; color:white; font-family: raleway; margin-top: 10px; font-weight: 900; background-color: #72a230">
            Adoption of Efficient Water Use Practices
        </div>

    </center>
    <div class="col-md-12 text-center " style="margin-top: 10px;">


        @*<a href="~/WSPHome/Gp_information" class="btn btn-success pull-right">
                Back To GP Modules
            </a>*@





        <!--<a class="btn btn-success" id="btn_pdf" onclick="Report_PDF()" style="float:right">Export (Pdf)</a>-->
        @*<button class="btn btn-success" id="btn_Excel" onclick="baselinedata_download()" style="float:right">Export Part-B (Excel)</button>*@
        <!--<a class="btn btn-success btn_export" onclick="Create_Excel()" id="btnsubmit" style="float:right">Export (Excel)</a>-->




    </div>
    <div class="row" id="tablediv">
        <div class="tab-content">
            <!--2nd Water Budget Form-->
            <div role="tabpanel" class="tab-pane fade in active" id="WaterbudgetingformWBF">

                @*<div class="col-md-12 scrollform">*@
                <div class="col-md-12">
                    <!-- Accordion -->
                    <div class="" id="">
                        <div class="col-md-15">
                            <table class="table demandsidetable demandside_text demandside_text_123 table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:1px;">
                                <tbody>
                                    <tr>
                                        <th colspan="6" style="background-color:#337ab7;color:#fff !important" class="text-center">
                                            Increase in area with efficient irrigation system (Ha)
                                        </th>
                                    </tr>
                                    <tr class="tableheader1 tableheader_text">

                                        <th>Irrigation System</th>
                                        <th>Area covered through convergence</th>
                                        <th>Area covered exclusively through Atal Jal Incentive</th>
                                        <th>Area covered exclusively through self/private financing</th>
                                        <th>Total area</th>
                                    </tr>
                                    <tr>
                                        <th>Sprinkler</th>

                                        <td><input type="text" class="form-control" id="sprinkler_convergence" onkeypress="validate(event)" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        <td><input type="text" class="form-control decimal" id="sprinkler_incentive" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        <td><input type="text" class="form-control decimal" id="sprinkler_financing" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        @*<td><span  class="form-control decimal" id="sprinkler_total" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>*@
                                        <td><span><label id="sprinkler_total"></label></span></td>
                                    </tr>
                                    <tr>
                                        <th>Drip</th>

                                        <td><input type="text" class="form-control decimal" id="drip_convergence" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        <td><input type="text" class="form-control decimal" id="drip_incentive" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        <td><input type="text" class="form-control decimal" id="drip_financing" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        @*<td><input type="text" class="form-control decimal" id="drip_total" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>*@
                                        <td><span><label id="drip_total"></label></span></td>
                                    </tr>
                                    <tr>
                                        <th>Pipeline Irrigation</th>

                                        <td><input type="text" class="form-control decimal" id="pipeline_convergence" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        <td><input type="text" class="form-control decimal" id="pipeline_incentive" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        <td><input type="text" class="form-control decimal" id="pipeline_financing" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>
                                        @*<td><input type="text" class="form-control decimal" id="pipeline_total" onkeyup="sum_of_all()" onkeydown="sum_of_all()" /></td>*@
                                        <td><span><label id="pipeline_total"></label></span></td>
                                    </tr>
                                    <tr>
                                        <th style="background-color:orange;color:#fff">Total</th>
                                        @*<td><input type="text" class="form-control decimal" id="total_convergence" /></td>
                                            <td><input type="text" class="form-control decimal" id="total_incentive" /></td>
                                            <td><input type="text" class="form-control decimal" id="total_financing" /></td>
                                            <td><input type="text" class="form-control decimal" id="all_irrigation_total" /></td>*@
                                        <td><span><label id="total_convergence"></label></span></td>
                                        <td><span><label id="total_incentive"></label></span></td>
                                        <td><span><label id="total_financing"></label></span></td>
                                        <td><span><label id="all_irrigation_total"></label></span></td>
                                    </tr>

                                </tbody>
                            </table>

                        </div>

                    </div>

                </div>

            </div>
            <!--2nd Water Budget Form closed-->
            <!--3rd Water Budgeting page-->
            @*<div role="tabpanel" class="tab-pane fade in" id="GroundwaterGWM">sankar1</div>*@
        </div>

    </div>

    <div class="text-center" style="margin:5px 0px 5px 0px;">
        <ul class="clearfix btnall" style=" list-style-type: none; margin: 0;  padding: 0;  overflow: hidden;">
            <li>
                <a class=" btn btn-success" id="btnFinalSave"><i class="fa fa-save"></i>Save</a>
            </li>
        </ul>
    </div>

    <div class="row" id="tablediv" style="margin-top: 40px;">
        <div class="tab-content">
            <!--2nd Water Budget Form-->
            <div role="tabpanel" class="tab-pane fade in active" id="WaterbudgetingformWBF">

                @*<div class="col-md-12 scrollform">*@
                <div class="col-md-12">
                    <!-- Accordion -->
                    <div class="" id="">
                        <div class="col-md-15">
                            <table class="table demandsidetable demandside_text demandside_text_123 table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:1px;">
                                <tbody>
                                    <tr>
                                        <th colspan="6" style="background-color:#337ab7;color:#fff !important" class="text-center">
                                            Increase in area with crop shifting (Ha)
                                        </th>
                                    </tr>
                                    <tr class="tableheader1 tableheader_text">

                                        <th class="text-center">Name of existing high water consuming crop</th>
                                        <th class="text-center">Name of replacing low water consuming crop</th>
                                        <th class="text-center">Area with shifting from high to low water consuming crop</th>
                                        <th class="text-center">Name of Department</th>
                                        <th class="text-center">Name of Scheme</th>
                                    </tr>

                                </tbody>
                            </table>

                        </div>

                    </div>

                </div>

            </div>
            <!--2nd Water Budget Form closed-->
            <!--3rd Water Budgeting page-->
            @*<div role="tabpanel" class="tab-pane fade in" id="GroundwaterGWM">sankar1</div>*@
        </div>

    </div>

    <div class="text-center" style="margin:5px 0px 5px 0px;">
        <ul class="clearfix btnall" style=" list-style-type: none; margin: 0;  padding: 0;  overflow: hidden;">
            <li>
                <a class=" btn btn-success" id="btnFinalSave2" onclick="openmodel()"><i class="fa fa-save"></i>Save</a>
            </li>
        </ul>
    </div>



    <div class="row" id="tablediv" style="margin-top: 40px;">
        <div class="tab-content">
            <!--2nd Water Budget Form-->
            <div role="tabpanel" class="tab-pane fade in active" id="WaterbudgetingformWBF">

                @*<div class="col-md-12 scrollform">*@
                <div class="col-md-12">
                    <!-- Accordion -->
                    <div class="" id="">
                        <div class="col-md-15">
                            <table class="table demandsidetable demandside_text demandside_text_123 table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:1px;">
                                <tbody>
                                    <tr>
                                        <th colspan="5" style="background-color:#337ab7;color:#fff !important" class="text-center">
                                            Increase in area under other water saving agriculture method
                                        </th>
                                    </tr>
                                    <tr class="tableheader1 tableheader_text">

                                        <th class="text-center">Water Saving Methods</th>
                                        <th class="text-center">Area covered through convergence</th>
                                        <th class="text-center">Area covered through Atal Jal incentive</th>
                                        <th class="text-center">Area covered through self/private financing</th>
                                        <th class="text-center">Total Area</th>
                                    </tr>
                                    <tr>

                                        <th><span id="dsr">DSR</span></th>
                                        <td><input type="text" class="form-control decimal" id="dsr_area_covered_through_convergence" onkeypress="validate(event)" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="dsr_area_covered_through_incentive" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="dsr_area_covered_through_financing" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <th><sapn id="dsr_total_area"></sapn></th>


                                    </tr>
                                    <tr>

                                        <th><span id="laser_land_levelling">Laser Land Levelling</span></th>
                                        <td><input type="text" class="form-control decimal" id="lll_area_covered_through_convergence" onkeypress="validate(event)" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="lll_area_covered_through_incentive" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="lll_area_covered_through_financing" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <th><sapn id="lll_total_area"></sapn></th>


                                    </tr>
                                    <tr>

                                        <th><span id="mulching">Mulching</span></th>
                                        <td><input type="text" class="form-control decimal" id="mulching_area_covered_through_convergence" onkeypress="validate(event)" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="mulching_area_covered_through_incentive" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="mulching_area_covered_through_financing" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <th><sapn id="mulching_total_area"></sapn></th>


                                    </tr>
                                    <tr>

                                        <th><span id="polyhouse">Polyhouse/green house/shadenet</span></th>
                                        <td><input type="text" class="form-control decimal" id="polyhouse_area_covered_through_convergence" onkeypress="validate(event)" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="polyhouse_area_covered_through_incentive" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="polyhouse_area_covered_through_financing" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <th><sapn id="polyhouse_total_area"></sapn></th>
                                    </tr>
                                    <tr>

                                        <td><input type="text" id="other_water_saving_method1" class="form-control" placeholder="Enter other Water Saving Methods" /></td>
                                        <td><input type="text" class="form-control decimal" id="other_area_covered_through_convergence1" onkeypress="validate(event)" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="other_area_covered_through_incentive1" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="other_area_covered_through_financing1" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <th><sapn id="other_total_area1"></sapn></th>


                                    </tr>
                                    <tr>

                                        <td><input type="text" id="other_water_saving_method2" class="form-control" placeholder="Enter other Water Saving Methods" /></td>
                                        <td><input type="text" class="form-control decimal" id="other_area_covered_through_convergence2" onkeypress="validate(event)" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="other_area_covered_through_incentive2" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <td><input type="text" class="form-control decimal" id="other_area_covered_through_financing2" onkeyup="CalAgriData()" onkeydown="CalAgriData()" /></td>
                                        <th><sapn id="other_total_area2"></sapn></th>

                                    </tr>
                                    <tr>
                                        <th style="background-color:orange;color:#fff"><sapn id="other_total_methods">Total</sapn></th>
                                        <th><sapn id="convergence_total_area"></sapn></th>
                                        <th><sapn id="incentive_total_area"></sapn></th>
                                        <th><sapn id="financing_total_area"></sapn></th>
                                        <th><sapn id="all_total_area"></sapn></th>
                                    </tr>

                                </tbody>
                            </table>

                        </div>

                    </div>

                </div>

            </div>
            <!--2nd Water Budget Form closed-->
            <!--3rd Water Budgeting page-->
            @*<div role="tabpanel" class="tab-pane fade in" id="GroundwaterGWM">sankar1</div>*@
        </div>

    </div>
    <div class="text-center" style="margin:5px 0px 5px 0px;">
        <ul class="clearfix btnall" style=" list-style-type: none; margin: 0;  padding: 0;  overflow: hidden;">
            <li>
                <a class=" btn btn-success" id="btnFinalSave3"><i class="fa fa-save"></i>Save</a>
            </li>
        </ul>
    </div>
    <div class="row text-center" style="margin-top: 40px;">

        <!--<div class="col-md-12 col-sm-12">
            <div class="tbl-responsive" style="overflow-x:scroll;">
                <table id="tbl_kharif_edit" class="table industry_table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic">
                    <thead>
                        <tr>
                            <th colspan="6" style="background-color:#337ab7;color:#fff !important" class="text-center">
                                Increase in area with efficient irrigation system (Ha)
                            </th>
