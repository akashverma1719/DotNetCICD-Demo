</main>

<div class="modal fade" id="modalDialogScrollable_gp" tabindex="-1" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form action="@Url.Action("EfficientWater", "EfficientWater")" method="post">
                    <div class="modal-body">
                        <div class="panel panel-default">
                            <div class="panel-heading " role="tab" id="headingOne">
                                <h4 class="panel-title">
                                    <a role="button">
                                        Increase in area with crop shifting (Ha)
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseOne" aria-labelledby="headingOne">
                                <div class="panel-body">

                                    <table class="firstformt">
                                        <thead>
                                            <tr>
                                                <td>1. Name of existing high water consuming crop :</td>
                                                <td>
                                                    @Html.DropDownListFor(model => model.existing_high_wcc,
                                                     new List<SelectListItem> {
                                                          new SelectListItem { Value = "" , Text = "--Select--", Selected=true},
                                                          new SelectListItem { Value = "Wheat" , Text = "Wheat" },
                                                          new SelectListItem { Value = "Maize" , Text = "Maize" },
                                                          new SelectListItem { Value = "Others" , Text = "Others" }
                                                       },
                                                     new { @class = "form-control" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>2. Name of replacing low water consuming crop :</td>
                                                <td>@Html.TextBoxFor(model => model.replacing_low_wcc, new { @class = "form-control", placeholder = "Enter name" })</td>
                                            </tr>
                                            <tr>
                                                <td>3. Area with shifting from high to low water consuming crop :</td>
                                                <td>@Html.TextBoxFor(model => model.hightolow_wcc, new { @class = "form-control", placeholder = "Enter the numeric value" })</td>
                                            </tr>
                                            <tr>
                                                <td>4. Name of Department :</td>
                                                <td>@Html.TextBoxFor(model => model.department, new { @class = "form-control", placeholder = "Enter the numeric value" })</td>
                                            </tr>
                                            <tr>
                                                <td>5. Name of Scheme :</td>
                                                <td>@Html.TextBoxFor(model => model.scheme, new { @class = "form-control", placeholder = "Enter the numeric value" })</td>
                                            </tr>
                                        </thead>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                    </div>
                </form>
            </div>
    </div>
</div>

@*<script src="~/Scripts/jquery-3.3.1.js"></script>*@
@*<script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>*@
<script src="~/Content/JS_Files/EfficientWater.js"></script>
<script>
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    var count_shifting = 1;
    var count_agri = 1;
    $(document).ready(function () {
        $('.loader').hide();
        $("#modalDialogScrollable_gp").modal("show");
        $("#other_scheme_name").prop("disabled", true);
        $("#other_agricultural_techniques").prop("disabled", true);
        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#alert_waiting').hide();

       DropDownInfo_ef();
    });
    function Dropdown_Search() {
        get_irrigation_system();
    }
    function DropDownInfo_ef() {


        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select State Name</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select Gram Panchayat</option>';
                    $("#gram").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';
                        for (var i = 0; i < Jsondata.length; i++) {

                            if (!ddlst[Jsondata[i].state_name]) {
                                all_dists.push(Jsondata[i].state_name);
                                ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
                            else if (a > b) return 1;
                            return 0;
                        });
                        optionState = '<option value="0">Select State Name</option>';
                        for (var i = 0; i < DistArray.length; i++) {
                            if (DistArray[i] != null && DistArray[i] != "") {
                                optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                            }
                        }
                        $("#spnstate").html(optionState);
                    }

                }

                SessionInfo_ef();


            }
        });
    }


    function SessionInfo_ef() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/SocialMointoring/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                //apl_bpl();
                //Categories_scstobc();

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    //$('#DropdownSearch_btn').hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin" || Str[0] == "National Level Nodal Officer") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        State_Dropdown_Function();

                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        Dist_fun();
                        Dist_fun();

                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $('#btn_submitNDO').hide();

                        Block_fun();

                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();

                    }


                }
            }

        });

    }


    function State_Dropdown_Function() {

        $("#dist11").empty();
        var opdist = '<option value="0">Select District</option>';
        $("#dist11").append(opdist);
        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select Gram Panchayat</option>';
        $("#gram").append(opgram);

        var StateName = $("#spnstate").val();
        if (off_1 == "state") {
            StateName = State;
        } else {
            State = StateName;
        }

        if (StateName != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_dists = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (StateName == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].district_name]) {
                        all_dists.push(Jsondata[i].district_name);
                        ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                    }
                }
            }


            var DistArray = [];
            DistArray = all_dists.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < DistArray.length; i++) {
                if (DistArray[i] != null && DistArray[i] != "") {
                    optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                }
            }
            $("#dist11").append(optionDist);
        }

    }

    function Dist_fun() {

        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var dist = $("#dist11").val();
        if (off_1 == "dist") {
            dist = Dist;
        } else {
            Dist = dist;
        }
        if (dist != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_blocks = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].block_name]) {
                        all_blocks.push(Jsondata[i].block_name);
                        ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                        //  $("#block").append(optionDist);
                    }
                }
            }


            var BlockArray = [];
            BlockArray = all_blocks.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < BlockArray.length; i++) {
                if (BlockArray[i] != null && BlockArray[i] != "") {
                    optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                }
            }
            $("#block1").append(optionDist);

        }
    }



    function Block_fun() {

        $("#gram").empty();
        var opgram = '<option value="0">Select Gram Panchayat</option>';
        $("#gram").append(opgram);
        var block = $("#block1").val();

        if (off_1 == "block") {
            block = Block;
        } else {
            Block = block;
        }


        if (block != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_grams = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                    if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                        ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                        all_grams.push(Jsondata[i].gram_panchayat_name);
                        //   $("#gram").append(optionDist);
                    }
                }
            }


            var GramArray = [];
            GramArray = all_grams.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < GramArray.length; i++) {
                if (GramArray[i] != null && GramArray[i] != "") {

                    optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
                }
            }
            $("#gram").append(optionDist);
        }
    }

    function Gram_Fun() {
        var Gram1 = $("#gram").val();
        if (Gram1 == "0") {
            alert("Please Select Grampanchayat");
        } else {
            Gram = $('#gram').val();
        }
    }


    $("#btnFinalSave").click(function () {

        save_irrigation_system();

    });

    function save_irrigation_system() {
        debugger
        var state = $("#spnstate").val();
        var district = $("#dist11").val();
        var block = $("#block1").val();
        var gram = $("#gram").val();
        var year = $("#year").val();
        /*var month = $("#month").val();*/
        if (state == "0") {
            alert("Plase select state name");
            return false;
        } else if (district == "0") {
            alert("Plase select district name");
            return false;
        } else if (block == "0") {
            alert("Plase select block name");
            return false;
        } else if (gram == "0") {
            alert("Plase select gram panchayat name");
            return false;
        }
        else if (year == "0") {
            alert("Plase select year");
            return false;
        }
        //else if (month == "0") {
        //    alert("Plase select month");
        //    return false;
        //}

        debugger
        var sprinkler_convergence = $("#sprinkler_convergence").val();
        var sprinkler_incentive = $("#sprinkler_incentive").val();
        var sprinkler_financing = $("#sprinkler_financing").val();
        var sprinkler_total = $("#sprinkler_total").text();


        var drip_convergence = $("#drip_convergence").val();
        var drip_incentive = $("#drip_incentive").val();
        var drip_financing = $("#drip_financing").val();
        var drip_total = $("#drip_total").text();

        var pipeline_convergence = $("#pipeline_convergence").val();
        var pipeline_incentive = $("#pipeline_incentive").val();
        var pipeline_financing = $("#pipeline_financing").val();
        var pipeline_total = $("#pipeline_total").text();

        var total_convergence = $("#total_convergence").text();
        var total_financing = $("#total_financing").text();
        var total_incentive = $("#total_incentive").text();

        var all_irrigation_total = $("#all_irrigation_total").text();

        if (sprinkler_convergence == "") {
            sprinkler_convergence = 0;
        }
        if (sprinkler_incentive == "") {
            sprinkler_incentive = 0;
        }
        if (sprinkler_financing == "") {
            sprinkler_financing = 0;
        }
        if (drip_convergence == "") {
            drip_convergence = 0;
        }
        if (drip_incentive == "") {
            drip_incentive = 0;
        }
        if (drip_financing == "") {
            drip_financing = 0;
        }
        if (pipeline_convergence == "") {
            pipeline_convergence = 0;
        }
        if (pipeline_incentive == "") {
            pipeline_incentive = 0;
        }
        if (pipeline_financing == "") {
            pipeline_financing = 0;
        }
        if (total_convergence == "") {
            total_convergence = 0;
        }
        if (total_financing == "") {
            total_financing = 0;
        }
        if (total_financing == "") {
            total_financing = 0;
        }
        if (all_irrigation_total == "") {
            all_irrigation_total = 0;
        }
        if (sprinkler_total == "") {
            sprinkler_total = 0;
        }
        if (drip_total == "") {
            drip_total == 0;
        }
        if (pipeline_total == "") {
            pipeline_total == 0;
        }
            var FinalData = [];

            FinalData.push({
                state: state,
                district: district,
                block: block,
                gram: gram,
                year: year,
                /*month: month,*/
                sprinkler_convergence: sprinkler_convergence,
                drip_convergence: drip_convergence,
                pipeline_convergence: pipeline_convergence,
                total_convergence: total_convergence,
                sprinkler_incentive: sprinkler_incentive,
                drip_incentive: drip_incentive,
                pipeline_incentive: pipeline_incentive,
                total_incentive: total_incentive,
                sprinkler_financing: sprinkler_financing,
                drip_financing: drip_financing,
                pipeline_financing: pipeline_financing,
                total_financing: total_financing,
                sprinkler_total: sprinkler_total,
                drip_total: drip_total,
                pipeline_total: pipeline_total,
                all_irrigation_total: all_irrigation_total
            });
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: '/EfficientWater/save_irrigation_system',
                data: JSON.stringify(FinalData),
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    $("#sprinkler_convergence").val("");
                    $("#sprinkler_incentive").val("");
                    $("#sprinkler_financing").val("");
                    $("#sprinkler_total").text("");
                    $("#drip_convergence").val("");
                    $("#drip_incentive").val("");
                    $("#drip_financing").val("");
                    $("#drip_total").text("");
                    $("#pipeline_convergence").val("");
                    $("#pipeline_incentive").val("");
                    $("#pipeline_financing").val("");
                    $("#pipeline_total").text("");
                    $("#total_convergence").text("");
                    $("#total_financing").text("");
                    $("#total_incentive").text("");
                    $("#all_irrigation_total").text("");
                    get_irrigation_system();
                }
            });
    }




    function validate(e) {
        var c = 0;
        var { value } = event.target;
        var count1 = 0;

        for (var i = 0; i < value.length; i++) {
            count1++;
            if (value[i] != '.') {
                if (count1 == 6 && value[i] != '.') {

                    e.preventDefault();
                }
            } else {
                var count = 0, point = false;
                for (var i = 0; i < value.length; i++) {

                    if (value[i] == '.' || point) {
                        count++;
                        point = true;
                    }
                    if (count > 2) {
                        e.preventDefault();
                    }
                }
            }

        }
    }

    $("#scheme_name").change(function () {
        if ($("#scheme_name").val() == 'Others') {
            $("#other_scheme_name").prop("disabled", false);
        } else {
            $("#other_scheme_name").prop("disabled", true);
        }

    })


    $("#agricultural_techniques").change(function (){
        if ($("#agricultural_techniques").val() == "Others") {
            $("#other_agricultural_techniques").prop("disabled", false);
        } else {
            $("#other_agricultural_techniques").prop("disabled", true);
        }



    });
