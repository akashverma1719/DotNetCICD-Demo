    function Dropdown_Search() {

        var year = $("#year").val();
        var fy_phase = $("#fy_phase").val();

        if (State == "0") {
            alert("Please select state name");
            return false;
        } else if (Dist == "0") {
            alert("Please select district name");
            return false;
        } else if (Block == "0") {
            alert("Please select block name");
            return false;
        } else if (Gram == "0") {
            alert("Please select gram panchayat name");
            return false;
        }
        else if (year == "0") {
            alert("Please select year");
            return false;
        }

        $("#state").val(State);
        $("#district").val(Dist);
        $("#block").val(Block);
        $("#gram1").val(Gram);
        $("#year1").val(year);
        $("#fy_phase1").val(fy_phase);

        get_irrigation_system();
    }

