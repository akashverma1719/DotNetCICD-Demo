    function deleteAgri(id) {
        if (confirm("Are you sure you want to delete this record?")) {
            $.ajax({
                type: 'POST',
                url: '/EfficientWater/delete_dli4_water_saving_agriculture',
                data: "{'id': '" + id + "'}",
                contentType: 'application/json; chatset=utf-8',
                dataType: 'JSON',
                success: function (data) {
                    if (data == 1) {
                        //alert("Data deleted successfully.");
                        get_dli4_water_saving_agriculture();
                    } else {
                        alert("Some error occured.");
                    }
                }
            })
        }
        else {
            return false;
        }
    }


    function editAgri(id) {
        $.ajax({
            type: 'POST',
            url: '/EfficientWater/get_dli4_water_saving_agriculture_byId',
            data: "{'id': '" + id + "'}",
            contentType: 'application/json; chatset=utf-8',
            dataType: 'JSON',
            success: function (data) {

                $("#agri_id").val(data.id);
                $("#state2").val(data.state);
                $("#district2").val(data.district);
                $("#block2").val(data.block);
                $("#gram2").val(data.gram);
                $("#year2").val(data.year);
                $("#water_saving_methods").val(data.water_saving_methods);
                if (data.water_saving_methods == "Others") {
                    $("#other_water_saving_methods").show();
                    $("#other_water_saving_methods").val(data.other_water_saving_methods);
                }
                $("#area_covered_through_convergence").val(data.area_covered_through_convergence);

                $("#area_covered_through_incentive").val(data.area_covered_through_incentive);
                $("#area_covered_through_financing").val(data.area_covered_through_financing);
                $("#total_area").val(data.total_area);


                $("#modalDialogScrollable_agriculture").modal("show");
            }
        });
    }
</script>

