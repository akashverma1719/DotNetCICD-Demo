    function validate(e) {
        var c = 0;
        var { value } = event.target;
        var count1 = 0;

        for (var i = 0; i < value.length; i++) {
            count1++;
            if (value[i] != '.') {
                if (count1 == 6 && value[i] != '.') {

                    e.preventDefault();
                }
            } else {
                var count = 0, point = false;
                for (var i = 0; i < value.length; i++) {

                    if (value[i] == '.' || point) {
                        count++;
                        point = true;
                    }
                    if (count > 2) {
                        e.preventDefault();
                    }
                }
            }

        }
    }




