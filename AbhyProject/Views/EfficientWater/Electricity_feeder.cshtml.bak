<script src="~/Scripts/jquery.min.js"></script>
<link href="https://code.jquery.com/ui/1.10.4/themes/ui-lightness/jquery-ui.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
<script src="https://code.jquery.com/ui/1.10.4/jquery-ui.js"></script>
<script src="~/Scripts/validations.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>
<script src="~/Content/JS_Files/training_workshop.js"></script>
<script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>

<script>

    var StateOfficer = "";
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    $(document).ready(function () {
        

        StateOfficer = '@Session["Officer"]';
         if (StateOfficer == "Gram Panchyat Nodal Officer") {
             window.location = "/WspNew/WSP_GWM_HOME";
             $(".entryfoam").hide();
        }
        if (StateOfficer == "Block Level Nodal Officer") {
            $(".entryfoam").hide();
        }
         if (StateOfficer == "District Level Nodal Officer") {
             $(".entryfoam").hide();
        }
         if (StateOfficer == "State Level Nodal Officer") {
             $(".entryfoam").show();
        }
        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
            $(".entryfoam").hide();
        }
        DropDownInfo();

        //$('#myModal').modal('show');
    });

    function DropDownInfo() {

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select StateName</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select GramPanchayat</option>';
                    $("#gram").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';

                        for (var i = 0; i < Jsondata.length; i++) {

                            if (!ddlst[Jsondata[i].state_name]) {
                                all_dists.push(Jsondata[i].state_name);
                                ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
                            else if (a > b) return 1;
                            return 0;
                        });
                        optionState = '<option value="0">Select StateName</option>';

                        for (var i = 0; i < DistArray.length; i++) {
                            if (DistArray[i] != null && DistArray[i] != "") {
                                optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';

                            }
                        }
                        $("#spnstate").html(optionState);

                    }

                }

                SessionInfo();


            }
        });
    }
    function State_Dropdown_Function() {
        $("#dist11").empty();
        var opdist = '<option value="0">Select District</option>';
        $("#dist11").append(opdist);
        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var StateName = $("#spnstate").val();
        if (off_1 == "state") {
            StateName = State;
        } else {
            State = StateName;
        }

        if (StateName != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_dists = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (StateName == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].district_name]) {
                        all_dists.push(Jsondata[i].district_name);
                        ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                    }
                }
            }


            var DistArray = [];
            DistArray = all_dists.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < DistArray.length; i++) {
                if (DistArray[i] != null && DistArray[i] != "") {
                    optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                }
            }
            $("#dist11").append(optionDist);
        }

    }
    function Dist_fun() {

        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var dist = $("#dist11").val();
        if (off_1 == "dist") {
            dist = Dist;
        } else {
            Dist = dist;
        }

        if (dist != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_blocks = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                //if (Jsondata[i].district_name == 'Kaithal' ) {
                //    alert(dist);

                //    return;
                //}

                if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].block_name]) {
                        all_blocks.push(Jsondata[i].block_name);
                        ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                        //  $("#block").append(optionDist);
                    }
                }
            }


            var BlockArray = [];
            BlockArray = all_blocks.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < BlockArray.length; i++) {
                if (BlockArray[i] != null && BlockArray[i] != "") {
                    optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                }
            }
            $("#block1").append(optionDist);

        }
    }
    function Block_fun() {

        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);
        var block = $("#block1").val();

        if (off_1 == "block") {
            block = Block;
        } else {
            Block = block;
        }


        if (block != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_grams = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                    if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                        ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                        all_grams.push(Jsondata[i].gram_panchayat_name);
                        //   $("#gram").append(optionDist);
                    }
                }
            }


            var GramArray = [];
            GramArray = all_grams.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < GramArray.length; i++) {
                if (GramArray[i] != null && GramArray[i] != "") {

                    optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
                }
            }
            $("#gram").append(optionDist);
        }
    }
    function Gram_change() {

        Gram = $("#gram").val();
        if (Gram == "0") {
            /* alert("Please Select Grampanchayat");*/
        }
        else {
            Gram = $('#gram').val();

        }
    }
    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Demand_new/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $('.loader').hide();
                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        State_Dropdown_Function();
                        State_Dropdown_Function();
                        Data_get();


                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        Dist_fun();
                        Dist_fun();
                        Data_get();

                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').hide();
                        Block_fun();
                        Block_fun();
                        Data_get();

                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').show();

                    }


                }
            }

        });

    }
    function Dropdown_Search() {
        
        $('.loader').show();
        var xx = 0;
        if (State == "0") {
            xx = 1;
            alert("Please Select State Name");
            $('.loader').hide();
        }
        if (xx == 0) {

            $.ajax({
                type: "Post",
                url: "/Home/StateLevel_Dropdown",
                contentType: "application/json;charset=utf-8",
                data: "{'StateName':'" + State + "','Dist':'" + Dist + "','Block':'" + Block + "','Gram':'" + Gram + "'}",
                dataType: "json",
                success: function (results) {
                    Data_get();
                }
            });
        }
    }

    function Insert_data() {
        
        $('.loader').show();
        if (State == "0") {
            alert("Please Select State Name");
            $('.loader').hide();
            return false;
        } else if (Dist == "0") {
            alert("Please Select District Name");
            $('.loader').hide();
            return false;
        } else if (Block == "0") {
            alert("Please Select Block Name");
            $('.loader').hide();
            return false;
        }
        var year = $('#year').val();
        var fy_phase = $('#fy_phase').val();

        var xx = 0;
        var state = State;
        var dist = Dist;
        var block = Block;
        var separation = $('#ddlseparation').val();
        if (separation == '0') {
            alert("Please Select Yes / No");
            xx = 1;
            $('.loader').hide();
        }
        if (xx == 0) {
            $.ajax({
                url: "/EfficientWater/Save_data",
                type: "POST",
                data: function () {

                    var data = new FormData();
                    data.append("state", state);
                    data.append("dist", dist);
                    data.append("block", block);
                    data.append("year", year);
                    data.append("fy_phase", fy_phase);
                    data.append("separation", separation);
                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else if (response == "Successfully Saved") {
                        Data_get();
                        $('#ddlseparation').val("0");
                    }

                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                }
            });
        }


    }


    function Data_get() {

        
        var year = $("#year").val();
        var fy_phase = $("#fy_phase").val();
        var obj = {};
        obj.statename = State;
        obj.districtname = Dist;
        obj.blockname = Block;
        obj.year = year;
        obj.fy_phase = fy_phase;
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: '/EfficientWater/Data_upload_doc',
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (data) {
                    
                    if (data == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    var tr = '';
                    var sno = 0;
                    if (data == 'No Data') {
                        tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                        $('#tbl_details').html(tr);
                    }
                    else {
                        if (data.length != 0) {
                            for (var i = 0; i < data.length; i++) {
                                sno += 1;
                                tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].year + '</td><td>' + data[i].fy_phase + '</td><td><center>' + data[i].separation + '</center></td></tr> ';

                            }
                        }
                        $('#tbl_details').html(tr);
                    }
                    $('.loader').hide();
                }
            });

    }


</script>


