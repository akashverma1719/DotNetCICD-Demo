<script src="~/Scripts/jquery.min.js"></script>
<link href="https://code.jquery.com/ui/1.10.4/themes/ui-lightness/jquery-ui.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
<script src="https://code.jquery.com/ui/1.10.4/jquery-ui.js"></script>
<script src="~/Scripts/validations.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>
<script src="~/Content/JS_Files/training_workshop.js"></script>
<script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>

<script>

    var Jsondata = "";
    var WaterAvialability = 0;
    var WaterDropt = 0;
    var AA = 0, DD = 0;
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var off_1 = "";
    var Gram = "0";
    var YearForDropDown = "";
    var StateOfficer = "";
    $(document).ready(function () {
        
        StateOfficer = '@Session["Officer"]';
        //if (StateOfficer == "") {
        //    window.location = "/WspNew/WSP_GWM_HOME";
        //}
        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
        $('.loader').hide();
        DropDownInfo();


    });

    function DropDownInfo() {
        if ($("#year").val() == "2023-24") {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/EfficientWater/DropdownInfoDli4",
                data: "{ }",
                dataType: 'JSON',
                success: function (response) {

                    if (response.length != 0) {
                        Jsondata = response;
                        $("#spnstate").empty();
                        var opstate = '<option value="0">Select StateName</option>';
                        $("#spnstate").append(opstate);
                        $("#dist11").empty();
                        var opdist = '<option value="0">Select District</option>';
                        $("#dist11").append(opdist);
                        $("#block1").empty();
                        var opblock = '<option value="0">Select Block</option>';
                        $("#block1").append(opblock);
                        $("#gram").empty();
                        var opgram = '<option value="0">Select GramPanchayat</option>';
                        $("#gram").append(opgram);

                        if (Jsondata.length != 0) {
                            var ddlst = {};
                            var all_dists = [];
                            var optionState = '';

                            for (var i = 0; i < Jsondata.length; i++) {

                                if (!ddlst[Jsondata[i].state_name]) {
                                    all_dists.push(Jsondata[i].state_name);
                                    ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                                }
                            }
                            var DistArray = [];
                            DistArray = all_dists.sort(function (a, b) {
                                if (a < b) return -1;
                                else if (a > b) return 1;
                                return 0;
                            });
                            optionState = '<option value="0">Select StateName</option>';

                            for (var i = 0; i < DistArray.length; i++) {
                                if (DistArray[i] != null && DistArray[i] != "") {
                                    optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';

                                }
                            }
                            $("#spnstate").html(optionState);

                        }

                    }
                    $(".loader").hide();
                    SessionInfo();


                }
            });
        } else {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/Sign_Up_DropdownInfo",
                data: "{ }",
                dataType: 'JSON',
                success: function (response) {

                    if (response.length != 0) {
                        Jsondata = response;
                        $("#spnstate").empty();
                        var opstate = '<option value="0">Select StateName</option>';
                        $("#spnstate").append(opstate);
                        $("#dist11").empty();
                        var opdist = '<option value="0">Select District</option>';
                        $("#dist11").append(opdist);
                        $("#block1").empty();
                        var opblock = '<option value="0">Select Block</option>';
                        $("#block1").append(opblock);
                        $("#gram").empty();
                        var opgram = '<option value="0">Select GramPanchayat</option>';
                        $("#gram").append(opgram);

                        if (Jsondata.length != 0) {
                            var ddlst = {};
                            var all_dists = [];
                            var optionState = '';

                            for (var i = 0; i < Jsondata.length; i++) {

                                if (!ddlst[Jsondata[i].state_name]) {
                                    all_dists.push(Jsondata[i].state_name);
                                    ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                                }
                            }
                            var DistArray = [];
                            DistArray = all_dists.sort(function (a, b) {
                                if (a < b) return -1;
                                else if (a > b) return 1;
                                return 0;
                            });
                            optionState = '<option value="0">Select StateName</option>';

                            for (var i = 0; i < DistArray.length; i++) {
                                if (DistArray[i] != null && DistArray[i] != "") {
                                    optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';

                                }
                            }
                            $("#spnstate").html(optionState);

                        }

                    }

                    SessionInfo();


                }
            });
        }
        
    }
    function State_Dropdown_Function() {
        $("#dist11").empty();
        var opdist = '<option value="0">Select District</option>';
        $("#dist11").append(opdist);
        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var StateName = $("#spnstate").val();
        if (off_1 == "state") {
            StateName = State;
        } else {
            State = StateName;
        }

        if (StateName != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_dists = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (StateName == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].district_name]) {
                        all_dists.push(Jsondata[i].district_name);
                        ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                    }
                }
            }


            var DistArray = [];
            DistArray = all_dists.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < DistArray.length; i++) {
                if (DistArray[i] != null && DistArray[i] != "") {
                    optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                }
            }
            $("#dist11").append(optionDist);
        }

    }
    function Dist_fun() {

        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var dist = $("#dist11").val();
        if (off_1 == "dist") {
            dist = Dist;
        } else {
            Dist = dist;
        }

        if (dist != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_blocks = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {

                if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].block_name]) {
                        all_blocks.push(Jsondata[i].block_name);
                        ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;

                    }
                }
            }


            var BlockArray = [];
            BlockArray = all_blocks.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < BlockArray.length; i++) {
                if (BlockArray[i] != null && BlockArray[i] != "") {
                    optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                }
            }
            $("#block1").append(optionDist);

        }
    }
    function Block_fun() {

        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);
        var block = $("#block1").val();

        if (off_1 == "block") {
            block = Block;
        } else {
            Block = block;
        }


        if (block != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_grams = [];
            var optionDist = '';
            
            for (var i = 0; i < Jsondata.length; i++) {
                if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {
                    if ($("#year").val() == "2023-24") {
                        if (!ddlst[Jsondata[i].gp_name]) {
                            ddlst[Jsondata[i].gp_name] = Jsondata[i].gp_name;
                            all_grams.push(Jsondata[i].gp_name);
                            //   $("#gram").append(optionDist);
                        }
                    } else {
                        if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                            ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                            all_grams.push(Jsondata[i].gram_panchayat_name);
                            //   $("#gram").append(optionDist);
                        }
                    }
                    
                }
            }


            var GramArray = [];
            GramArray = all_grams.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < GramArray.length; i++) {
                if (GramArray[i] != null && GramArray[i] != "") {

                    optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
                }
            }
            $("#gram").append(optionDist);
        }
    }
    function Gram_change() {

         Gram = $("#gram").val();
        if (Gram == "0") {
            /* alert("Please Select Grampanchayat");*/
        }
        else {
            Gram = $('#gram').val();

        }
    }
    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Demand_new/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $('.loader').hide();
                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        State_Dropdown_Function();
                        State_Dropdown_Function();
                        $('.loader').hide();



                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        Dist_fun();
                        Dist_fun();
                        $('.loader').hide();



                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        Block_fun();
                        Block_fun();
                        $('.loader').hide();



                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').show();
                        Data_get();
                        $('.loader').hide();


                    }


                }
            }

        });

    }
    function Dropdown_Search() {
        
        /*$('.loader').show();*/
        var xx = 0;
        if (State == "0") {
            xx = 1;
            alert("Please Select State Name");
            $('.loader').hide();
        }
        if (xx == 0) {

            $.ajax({
                type: "Post",
                url: "/Home/StateLevel_Dropdown",
                contentType: "application/json;charset=utf-8",
                data: "{'StateName':'" + State + "','Dist':'" + Dist + "','Block':'" + Block + "','Gram':'" + Gram + "'}",
                dataType: "json",
                success: function (results) {
                    Data_get();
                }
            });
        }
    }

    function Excel_a() {
        
        var year = $("#year").val();
        var fy_phase = $("#fy_phase").val();

        if (State == "0") {
            alert("Please Select State");
            return false;
        } {
            window.location.href = "/EfficientWater/DLI4_excel_a?state=" + State + "&district=" + Dist + "&block=" + Block + "&gram=" + Gram + "&year=" + year + "&fy_phase=" + fy_phase;
        }
    }
    function Excel_b() {
        
        var year = $("#year").val();
        var fy_phase = $("#fy_phase").val();

        if (State == "0") {
            alert("Please Select State");
            return false;
        } {
            window.location.href = "/EfficientWater/DLI4_excel_b?state=" + State + "&district=" + Dist + "&block=" + Block + "&gram=" + Gram + "&year=" + year + "&fy_phase=" + fy_phase;
        }
    }
    function Excel_c() {

        var year = $("#year").val();
        var fy_phase = $("#fy_phase").val();

        if (State == "0") {
            alert("Please Select State");
            return false;
        } {
            window.location.href = "/EfficientWater/DLI4_excel_c?state=" + State + "&district=" + Dist + "&block=" + Block + "&gram=" + Gram + "&year=" + year + "&fy_phase=" + fy_phase;
        }
    }


    function Data_get() {

        
        var year = $('#year').val();
        var fy_phase = $('#fy_phase').val();
        var obj = {};
        obj.statename = State;
        obj.districtname = Dist;
        obj.blockname = Block;
        obj.gpname = Gram;
        obj.year = year;
        obj.fy_phase = fy_phase;

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/EfficientWater/Data_DLI4_report',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                var tr = '';
                var sno = 0;
                if (data == 'No Data') {
                    tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                    $('#tbl_details').html(tr);
                }
                else {
                    if (data.length != 0) {
                        for (var i = 0; i < data.length; i++) {
                            var reject = data[i].reject;
                            if (reject == null) {
                                reject = "";
                            }
                            if (StateOfficer == "State Level Nodal Officer") {
                                if (data[i].approve == "State") {
                                    sno += 1;
                                    tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gram + '</td><td>' + data[i].year + '</td><td>' + data[i].sprinkler_convergence + '</td><td>' + data[i].drip_convergence + '</td><td>' + data[i].pipeline_convergence + '</td><td>' + data[i].total_convergence + '</td><td>' + data[i].sprinkler_incentive + '</td><td>' + data[i].drip_incentive + '</td><td>' + data[i].pipeline_incentive + '</td><td>' + data[i].total_incentive + '</td><td>' + data[i].sprinkler_financing + '</td><td>' + data[i].drip_financing + '</td><td>' + data[i].pipeline_financing + '</td><td>' + data[i].total_financing + '</td><td>' + data[i].all_irrigation_total + '</td><td>' + data[i].tot_spr_ben + '</td><td>' + data[i].tot_drip_ben + '</td><td>' + data[i].tot_pipe_ben + '</td><td></td><td></td><td><label style="color: blue;">Approved</label></td></tr> ';

                                }
                                else if (data[i].approve == "Reject") {
                                    sno += 1;
                                    tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gram + '</td><td>' + data[i].year + '</td><td>' + data[i].sprinkler_convergence + '</td><td>' + data[i].drip_convergence + '</td><td>' + data[i].pipeline_convergence + '</td><td>' + data[i].total_convergence + '</td><td>' + data[i].sprinkler_incentive + '</td><td>' + data[i].drip_incentive + '</td><td>' + data[i].pipeline_incentive + '</td><td>' + data[i].total_incentive + '</td><td>' + data[i].sprinkler_financing + '</td><td>' + data[i].drip_financing + '</td><td>' + data[i].pipeline_financing + '</td><td>' + data[i].total_financing + '</td><td>' + data[i].all_irrigation_total + '</td><td>' + data[i].tot_spr_ben + '</td><td>' + data[i].tot_drip_ben + '</td><td>' + data[i].tot_pipe_ben + '</td><td></td><td>' + reject + '</td><td><label style="color: red;">Rejected</label></td></tr> ';

                                }
                                else if (data[i].approve == "Dist") {
                                    sno += 1;
                                    tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gram + '</td><td>' + data[i].year + '</td><td>' + data[i].sprinkler_convergence + '</td><td>' + data[i].drip_convergence + '</td><td>' + data[i].pipeline_convergence + '</td><td>' + data[i].total_convergence + '</td><td>' + data[i].sprinkler_incentive + '</td><td>' + data[i].drip_incentive + '</td><td>' + data[i].pipeline_incentive + '</td><td>' + data[i].total_incentive + '</td><td>' + data[i].sprinkler_financing + '</td><td>' + data[i].drip_financing + '</td><td>' + data[i].pipeline_financing + '</td><td>' + data[i].total_financing + '</td><td>' + data[i].all_irrigation_total + '</td><td>' + data[i].tot_spr_ben + '</td><td>' + data[i].tot_drip_ben + '</td><td>' + data[i].tot_pipe_ben + '</td><td> <button type="button" class="btn btn-primary disable_btn"  onclick="approve_state(' + data[i].id + ',' + i + ')">Approved</button><button type="button" style="margin-left: 10px;" class="btn btn-danger disable_btn"  onclick="reject_gram(' + data[i].id + ',' + i + ')">Reject</button></td><td><textarea id="remarks_status' + i + '"  class=" form-control" rows="" cols="40" placeholder="Remarks"  name="push_title"></textarea></td></tr> ';
                                }
                                else {
