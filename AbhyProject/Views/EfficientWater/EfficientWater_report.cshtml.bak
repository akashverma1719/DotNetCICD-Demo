                                    <th rowspan="1" class="text-center">Super seeder /happy seeder/zero tillage</th>
                                    <th rowspan="1" class="text-center">Polyhouse /net house</th>
                                    <th rowspan="1" class="text-center">Mulching</th>
                                    <th rowspan="1" class="text-center">Hydrogel</th>
