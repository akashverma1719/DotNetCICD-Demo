    function approve_state(id, RowNo) {
        
        var i = 0;
        var id = id;

        if (i == 0) {


            var formdata = new FormData();
            formdata.append("id", id);
            $.ajax({
                url: '/EfficientWater/approve_data_state',
                data: formdata,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (response) {

                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    Data_get();
                },
                error: function () {
                    alert('Approved Failed');
                }
            });
        }


    }
    function reject_gram(id, RowNo) {
        /*$('.loader').show();*/
        var i = 0;
        var id = id;
        var reject = $('#remarks_status' + RowNo).val();
        if (reject == "") {
            alert("Please Enter Reject Remark ");
            $('.loader').hide();
            i = 1;
        }
        if (i == 0) {

            var formdata = new FormData();
            formdata.append("id", id);
            formdata.append("reject", reject);
            $.ajax({
                url: '/EfficientWater/reject_data',
                data: formdata,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (response) {
                    
                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    Data_get();
                },
                error: function () {
                    alert('Approved Failed');
                }
            });
        }


    }

