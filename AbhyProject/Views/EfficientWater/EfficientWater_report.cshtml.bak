    function Data_get_a() {

        
        var year = $('#year').val();
        var fy_phase = $('#fy_phase').val();
        var obj = {};
        obj.statename = State;
        obj.districtname = Dist;
        obj.blockname = Block;
        obj.gpname = Gram;
        obj.year = year;
        obj.fy_phase = fy_phase;

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/EfficientWater/Data_DLI4_report2',
