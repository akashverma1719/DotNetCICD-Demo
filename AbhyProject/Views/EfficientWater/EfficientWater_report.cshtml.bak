<title>Efficient Water Report</title>

<style>
    .database_trainer_row > h3 {
        background-color: #337ab7;
        color: #fff;
        padding: 7px 15px;
        font-size: 18px;
        margin: 6px 0px;
    }
    /*table fix code*/

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
    }

    .font-bold {
        font-weight: bold;
    }

    /*ends here*/
    .second_heading {
        background-color: #337ab7;
        color: #fff;
        list-style: none;
        padding: 12px 10px;
        font-size: 18px;
        font-weight: bold
    }

    .main_div {
        padding-bottom: 30px;
    }

    .btn-success {
        margin: 5px 0px !important;
    }


    table#TblData_b_part tr.info > th,
    table#TblData_c_part tr.info > th,
    table#TblData_d_part tr.info > th,
    table#TblData_e_part tr.info > th,
    table#TblData_abc_part1 tr.info > th,
    table#TblData_jj_part1 tr.info > th,
    table.GWL_deviation_table tr.info > th,
    table#TblData_g_part tr.info > th {
        background-color: #337ab7;
        color: #fff;
        vertical-align: middle;
    }

        table#TblData_abc_part1 tr.info > th.background_color {
            background-color: #fff !important;
            color: #000;
        }

    .E_table_header > h4 {
        color: #337ab7;
        padding: 10px 0px;
    }

    .alertshowingdiv {
        height: 25px;
    }

        .alertshowingdiv > label {
            color: red;
            font-size: 16px;
        }

    #breadcrumb {
        color: #0000ff;
        font-size: 15px;
        margin: 0;
        height: 15px;
        margin-bottom: 10px;
    }

        #breadcrumb a {
            color: #0000ff;
            text-decoration: underline;
        }

    ul#myTabs > li > a > span > img {
        height: 26px;
        width: 26px;
    }

    ul.ReRecharge_list > li > span {
        width: 70%;
    }

    ul#submenu1 > li > span {
        font-size: 17px;
    }

    ul.imgHome > li > a > span {
        font-size: 17px;
        text-decoration: none;
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

        ul.imgHome > li > a > span :hover {
            text-decoration: none;
        }

    ul.imgHome > li > a > label {
        font-size: 13px;
        text-decoration: underline;
        color: #fff;
        padding: 0px 0px 0px 5px;
        margin: 0;
        height: 15px;
    }

    ul.imgHome > li > label {
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

    ul.imgHome > li > a > span > img,
    ul.imgHome > li > span > img {
        width: 25px;
    }

    ul.imgHome > li > a > label {
        padding: 5px 0px 0px 0px;
    }

    .nav-justified {
        padding-bottom: 0em;
    }

    ul.imgHome > li > img,
    ul.imgHome > li > a > img {
        width: 25px !important;
    }

    .highcharts-background {
        /*width: 100% !important;*/
    }

    .highcharts-title {
        display: none;
    }

    span.marqueegwr {
        font-weight: 700;
        margin-top: 10px;
        /*font-family: raleway;*/
        color: #333;
        font-size: 1vw;
    }

    .modal-backdrop.in {
        z-index: 0px !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    ul.btnall > li {
        display: inline-block;
    }

    .backgroundtr {
        background-color: lightgray !important;
    }

        .backgroundtr:hover {
            background-color: #fff !important;
        }

    .backgroundtr1 {
        background-color: lightgoldenrodyellow !important;
    }

        .backgroundtr1:hover {
            background-color: #fff !important;
        }

    .selectdistshowoption select {
        border-radius: 25px;
        width: 180px;
    }

    #style-1::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background-color: #F5F5F5;
        border-radius: 25px;
    }

    #style-1::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
    }

    .card {
        margin-top: 25px;
    }

    .card-body {
        border: 1px solid#ccc;
        /*padding: 5px;*/
    }

    .headings_border {
        position: relative;
        color: #fff;
        font-size: 35px;
        text-align: center;
        font-family: raleway;
        font-weight: 900;
        display: inline-block;
    }

    /*.headings_border::after {
            content: '';
            position: absolute;
            top: 45px;
            left: 13%;
            width: 168px;
            height: 2px;
            background: #5cb85c;
        }*/
    .box_shadow {
        box-shadow: 0px 3px 46px rgb(0 0 0 / 7%);
        padding: 15px 15px;
        background: #f2f2f2;
    }

    ul.Select_option {
        padding-left: 0;
        text-align: initial;
        padding-top: 24px;
    }

    #border {
        border-spacing: 2px;
        /* border: 2px solid green;*/
        box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 4px;
        margin-left: 50px;
        margin-right: 50px;
        margin-top: 15px;
        background: #f2f2f2;
    }

        #border select {
            width: 100%;
            border-radius: 5px !important;
        }

        #border input {
            width: 100%;
            border-radius: 5px !important;
        }

    .ul.Select_option > li {
        padding: 0 0 0 11px !important;
    }

    #demandside::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background-color: #F5F5F5;
        border-radius: 25px;
    }

    #demandside::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
    }
</style>
<style>
    .under_list > li {
        list-style: none;
        padding: 5px;
        font-size: 15px;
        font-weight: 600;
    }

        .under_list > li > span > input {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

        .under_list > li > span > select {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

    @@media (max-width:1200px) and (min-width: 360px) {
        .panelbodyheading {
            background: none !important;
            color: #337ab7;
        }
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }

    .cust_center {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .cust_center h6 {
            font-size: 15px;
        }

    .text-center {
        background-color: #337ab7 !important;
    }
</style>

<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>

<main>
    <header class="header hederImage">
        <div class="clearfix">
            <div class="clearfix">
                <div class="col-lg-9">
                    <div class="header-top-info">
                        <ul class="clearfix">
                            <li>
                                <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                            </li>

                            <li>
                                <span>
                                    <a target="_blank" href="http://ataljal.in/" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                </span>
                                <span>
                                    <a href="Javascript:;" style="color:#fff;font-size:14px;" role="link">Ministry of Jal Shakti</a>
                                </span>
                                <span class="li_eng responsive_go_eng"><a href="javascript:;" role="link" style="color: #fff;font-size:14px;">Department of Water Resources,</a></span>
                                <span style="text-align:center;">
                                    <a href="javascript:;" title="GOVERNMENT OF INDIA" style="text-transform:none; font-size:14px;">River Development & Ganga Rejuvenation</a>
                                </span>

                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <ul class="imgHome clearfix">

                        <li>
                            <img src="~/Content/WspImages/user-silhouette.png" title="User" />
                            @if (Session["UserName"] != null)
                            {
                                <span style="color:#fff;">:@Session["UserName"].ToString()</span>
                            }

                        </li>
                        <li>
                            <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                        </li>

                    </ul>
                </div>
                <div class="col-md-8" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                    <ul class="imgHome clearfix">
                        <li>
                            <a href="~/WspNew/WSP_GWM_HOME">
                                <span>
                                    <img src="~/Content/WspImages/home-icon-silhouette.png" title="Home" />
                                </span>
                                <label>MIS Login <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>
                        <li>
                            <span><img src="~/Content/WspImages/WSP Home.png" style="width:23px;" /></span>
                            <label>DLI 4 Report</label>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>
    <center>
        <div class="text-h g-mb-20" style="font-size: 35px; color:white; font-family: raleway; margin-top: 10px; font-weight: 900; background-color: #72a230">
            DLI 4 Report
        </div>
    </center>
    <div>
        <ul style="color:white;">
            <li style=" text-align: right; margin-top: 10px; margin-right: 25px;">
                <a href="~/EfficientWater/main_page" class="btn btn-danger">
                    Back To Module
                </a>
            </li>
        </ul>
    </div>
    <div class="row">
        <div class="container-fluid">
            <div class="content">
                <div class="col-lg-12" style="background-color:#fff;">
                    <div id="border">
                        <div class="row container-fluid main_div">
                            <div class="col-md-12 col-sm-12">
                                <div>
                                    <div class="">
                                        <div class="selectdistshowoption">
                                            <ul class="Select_option col-md-12 col-sm-12  text-left">
                                                <li class="">
                                                    <select name="" id="year" class="form-control" onchange="HideShowPhase()">
                                                        <option value="2022-23">2022-23</option>
                                                        <option value="2023-24" selected>2023-24</option>
                                                    </select>
                                                </li>
                                                <li>
                                                    <select class="form-control" id="fy_phase" disabled>
                                                        <option value="0">---Select---</option>
                                                        <option value="Phase-1" selected>Phase-1[Apr 2023 - Sep 2023]</option>
                                                        <option value="Phase-2">Phase-2</option>
                                                    </select>
                                                </li>
                                                <li id="StateLabel">
                                                    <label id="lblstate">State:</label>
                                                    <span id="spnstate1">@Session["gstate"]</span>
                                                </li>
                                                <li id="StateDropdownLabel">

                                                    <select class="form-control" id="spnstate" onchange="State_Dropdown_Function()">
                                                    </select>
                                                </li>

                                                <li id="DistLabel">
                                                    <i class="fas fa fa-angle-double-right"></i>
                                                    <label id="lbldistrict">District:</label>
                                                    <span id="spndistrict">@Session["gdist"]</span>
                                                </li>

                                                <li id="DistDropdownLabel">

                                                    <select class="form-control" id="dist11" onchange="Dist_fun()">
                                                    </select>
                                                </li>

                                                <li id="BlockLabel">
                                                    <i class="fas fa fa-angle-double-right"></i>
                                                    <label>Block:</label>
                                                    <span>@Session["gblock"] </span>
                                                </li>

                                                <li id="BlockDropdownLabel">

                                                    <select class="form-control" id="block1" onchange="Block_fun()">
                                                    </select>
                                                </li>
                                                <li id="GramLabel">
                                                    <i class="fas fa fa-angle-double-right"></i>
                                                    <label>Gram panchayat:</label>
                                                    <span>@Session["ggram"]</span>
                                                </li>

                                                <li id="GramDropdownLabel">
                                                    <select class="form-control" id="gram" onchange="Gram_change()">
                                                    </select>
                                                </li>


                                                <li id="DropdownSearch_btn">
                                                    <button class="btn btn-success" onclick="Dropdown_Search()">Search</button>
                                                </li>

                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <br />
    <main>

        <div id="border">
            <div class="row container-fluid main_div">
                <div class="col-md-12 col-sm-12">
                    <div>
                        <ul style="color:white;">
                            <li style=" text-align: right; margin-top:10px;">
                                <button class="btn btn-success download1" id="btnexcel_a" onclick="Excel_a()">Export To Excel</button>
                            </li>
                        </ul>
                    </div>
                    <div class="tbl-responsive" id="demandside" style=" overflow-x:scroll;overflow-y:scroll; height:600px;">
                        <table id="tbldemand" class="table wa_table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic" style="width:100%;">
                            <thead style="color: #fff;">
                                <tr class="tableheader1"></tr>
                                <tr class="success">
                                    <th rowspan="3" class="text-center">Sr.No</th>
                                    <th rowspan="3" class="text-center">State Name</th>
                                    <th rowspan="3" class="text-center">District Name</th>
                                    <th rowspan="3" class="text-center">Block Name</th>
                                    <th rowspan="3" class="text-center">Gram Panchayat Name </th>
                                    <th rowspan="3" class="text-center">Financial Year </th>
                                    <th colspan="13" class="text-center"><label>Increase in Area (in Ha) with Efficient Irrigation System </label></th>

                                    <th colspan="3" class="text-center">Total Beneficiary</th>

                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Data Validation</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Remark</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Status</th>

                                </tr>
                                <tr class="success">
                                    <th colspan="4" class="text-center">Increase in area through convergence</th>
                                    <th colspan="4" class="text-center">Increase in area exclusively through Incentive fund</th>
                                    <th colspan="4" class="text-center">Increase in area through self/  private financing</th>
                                    <th rowspan="2" class="text-center"> Total</th>
                                    <th rowspan="3" class="text-center">Total Sprinkler</th>
                                    <th rowspan="3" class="text-center">Total Drip</th>
                                    <th rowspan="3" class="text-center">Total Pipelines</th>
                                </tr>
                                <tr class="success">
                                    <th rowspan="1" class="text-center">Area under Sprinkler Irrigation</th>
                                    <th rowspan="1" class="text-center">Area under Drip Irrigation</th>
                                    <th rowspan="1" class="text-center">Irrigation through  Pipelines</th>
                                    <th rowspan="1" class="text-center">Total</th>

                                    <th rowspan="1" class="text-center">Area under Sprinkler Irrigation</th>
                                    <th rowspan="1" class="text-center">Area under Drip Irrigation</th>
                                    <th rowspan="1" class="text-center">Irrigation through  Pipelines</th>
                                    <th rowspan="1" class="text-center">Total</th>

                                    <th rowspan="1" class="text-center">Area under Sprinkler Irrigation</th>
                                    <th rowspan="1" class="text-center">Area under Drip Irrigation</th>
                                    <th rowspan="1" class="text-center">Irrigation through  Pipelines</th>
                                    <th rowspan="1" class="text-center">Total</th>

                                </tr>
                                
                            </thead>
                            <tbody id="tbl_details"></tbody>
                        </table>
                    </div>
                    <br />
                    <div>
                        <ul style="color:white;">
                            <li style=" text-align: right; margin-top:10px;">
                                <button class="btn btn-success download1" id="btnexcel_b" onclick="Excel_b()">Export To Excel</button>
                            </li>
                        </ul>
                    </div>
                    <div class="tbl-responsive" id="demandside" style=" overflow-x:scroll;overflow-y:scroll; height:600px;">
                        <table id="tbldemand" class="table wa_table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic" style="width:100%;">
                            <thead style="color: #fff;">
                                <tr class="tableheader1"></tr>
                                <tr class="success">
                                    <th rowspan="3" class="text-center">Sr.No</th>
                                    <th rowspan="3" class="text-center">State Name</th>
                                    <th rowspan="3" class="text-center">District Name</th>
                                    <th rowspan="3" class="text-center">Block Name</th>
                                    <th rowspan="3" class="text-center">Gram Panchayat Name </th>
                                    <th rowspan="3" class="text-center">Financial Year </th>
                                    <th colspan="5" class="text-center"><label>Increase in area with shift in cropping pattern </label></th>
                                    <th rowspan="3" class="text-center">Total Beneficiary</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Data Validation</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Remark</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Status</th>

                                </tr>
                                <tr class="success">
                                    <th rowspan="1" class="text-center">Name of existing High water consuming Crop</th>
                                    <th rowspan="1" class="text-center">Name of replacing low water consuming crop</th>
                                    <th rowspan="1" class="text-center">Area with crop shifting  (Ha)</th>
                                    <th rowspan="1" class="text-center" style="padding: 80px; padding-bottom: 10px;">Name of Department</th>
                                    <th rowspan="1" class="text-center" style="padding: 80px; padding-bottom: 10px;">Name of Scheme</th>
                                </tr>


                            </thead>
                            <tbody id="tbl_details_a"></tbody>
                        </table>
                    </div>
                    <br />
                    <div>
                        <ul style="color:white;">
                            <li style=" text-align: right; margin-top:10px;">
                                <button class="btn btn-success download1" id="btnexcel_c" onclick="Excel_c()">Export To Excel</button>
                            </li>
                        </ul>
                    </div>
                    <div class="tbl-responsive" id="demandside" style=" overflow-x:scroll;overflow-y:scroll; height:600px;">
                        <table id="tbldemand" class="table wa_table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic" style="width:100%;">
                            <thead style="color: #fff;">
                                <tr class="tableheader1"></tr>
                                <tr class="success">
                                    <th rowspan="3" class="text-center">Sr.No</th>
                                    <th rowspan="3" class="text-center">State Name</th>
                                    <th rowspan="3" class="text-center">District Name</th>
                                    <th rowspan="3" class="text-center">Block Name</th>
                                    <th rowspan="3" class="text-center">Gram Panchayat Name </th>
                                    <th rowspan="3" class="text-center">Financial Year </th>
                                    <th colspan="31" class="text-center"><label>Increase in area under other water saving method ( Ha) used for agriculture</label></th>
                                    <th colspan="8" class="text-center"><label>Total Beneficiary</label></th>


                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Data Validation</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Remark</th>
                                    <th rowspan="3" class="text-center" style="padding:8px 70px;">Status</th>

                                </tr>
                                <tr class="success">
                                    <th colspan="9" class="text-center">Increase in area through convergence</th>
                                    <th colspan="9" class="text-center">Increase in area through Incentive fund</th>
                                    <th colspan="9" class="text-center">Increase in area through self/private financing</th>
                                    <th rowspan="3" class="text-center">All Total</th>
                                    <th rowspan="3" class="text-center"> Other Type 1</th>
                                    <th rowspan="3" class="text-center"> Other Type 2</th>
                                    <th rowspan="3" class="text-center"> Other Type 3</th>

                                    <th rowspan="3" class="text-center"> Super seeder /happy seeder/zero tillage</th>
                                    <th rowspan="3" class="text-center"> Polyhouse /net house</th>
