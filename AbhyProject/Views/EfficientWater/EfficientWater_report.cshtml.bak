    function HideShowPhase() {
        $(".loader").show();
        YearForDropDown = $("#year").val();
        if (YearForDropDown == "2023-24") {
            $("#fy_phase").show();
        } else {
            $("#fy_phase").hide();
        }
        DropDownInfo();
    }

