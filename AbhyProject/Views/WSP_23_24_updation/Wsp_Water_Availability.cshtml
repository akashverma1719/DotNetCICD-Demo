    });

    function Twa_cal() {

        var total_storage_capacity = $('#total_storage_capacity').val();
        if (total_storage_capacity == "") {
            total_storage_capacity = 0;

        }
        var Losses_if_any = $('#loss_percentage').val();
        if (Losses_if_any == "") {
            Losses_if_any = 0;

        }
        var Surface_Water_Available = ((total_storage_capacity) * (Losses_if_any / 100));
        var totalStorages = total_storage_capacity - Surface_Water_Available;
        $('#sw_available_for_use').val(totalStorages.toFixed(4));

        var gp_area_ham = $('#trans_wat_ogp').val();
        if (gp_area_ham != '') {
            $('#tot_sur_wat_avail').val((parseFloat(Surface_Water_Available) + parseFloat(gp_area_ham)).toFixed(4));
        } else {

            $('#tot_sur_wat_avail').val('0');
        }

        var total_gw_available = $('#total_gw_available').text();
        if (total_gw_available != '') {
            $('#tot_wat_avail').val((parseFloat(total_gw_available) + parseFloat($('#tot_sur_wat_avail').val())).toFixed(4));
        }
        else {

            $('#tot_sur_wat_avail').val('0');
        }
        Total_Numbers2();
    }


    function Total_Numbers1() {

        var total = 0;
        var sw_available_for_use = $('#sw_available_for_use').val();
        var trans_wat_ogp = $('#trans_wat_ogp').val();

        if (sw_available_for_use == "") {

            sw_available_for_use = 0;
        }

        if (trans_wat_ogp == "") {

            trans_wat_ogp = 0;
        }

        total = parseFloat(sw_available_for_use) + parseFloat(trans_wat_ogp);

        $('#tot_sur_wat_avail').val(total.toFixed(4));

    }


    function Total_Numbers2() {

        Total_Numbers1();

        var total1 = 0;
        var total_gw_available = $('#total_gw_available').text();
        var tot_sur_wat_avail = $('#tot_sur_wat_avail').val();

        if (total_gw_available != '' && tot_sur_wat_avail != '') {
            if (total_gw_available == "") {

                total_gw_available = 0;
            }

            if (tot_sur_wat_avail == "") {

                tot_sur_wat_avail = 0;
            }

            total1 = parseFloat(total_gw_available) + parseFloat(tot_sur_wat_avail);

            $('#tot_wat_avail').val(total1.toFixed(4));

        }
        else {
            $('#tot_wat_avail').val('0');
        }
    }

    function HideShowSource() {
        $("#Source_Name_div").show();
    }


    $("#other_source_name").on("input", function (e) {
        if ($("#other_source_name").val() != "") {
            $("#other_source_name").css("border-color", "white");
        } else {
            $("#other_source_name").css("border-color", "red");
        }
    })
</script>
