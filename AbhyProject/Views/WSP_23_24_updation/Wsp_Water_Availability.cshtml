                }
                $('#upload_wsp_avail_file').html(tr);
                $("#btn_avail_dlt").attr("id", data[0].id);

            }
        });
    }


    function Delete_avail_upload() {

        var obj = {};
        obj.IDD = $(".btn_wsp").attr("id");


        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
