            data: '',
            dataType: 'JSON',
            success: function (data) {

                var tr = '';
                if (data == "SessionTimeOut") {
                      window.location = "/Home/LogOut";
                }
                if (data[0].avail_upload_file != null && data[0].avail_upload_file != "") {
                    tr = '<label><a href="' + data[0].avail_upload_dir + '" download="" target="_blank" >' + data[0].avail_upload_file + '</a></label>&nbsp;&nbsp;';
