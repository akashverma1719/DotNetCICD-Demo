    function Upload_WSP_AVAIL() {
        var avail_upload = $("#avail_upload_btn").get(0);
        var avail_upload_file = avail_upload.files;

        var formdata = new FormData();
        formdata.append("avail_upload_file", avail_upload_file[0]);


        $.ajax({
            url: '/WSP_23_24_updation/Upload_WSP_AVAIL',
            data: formdata,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (response) {

                alert(response);
                $('input[type = file]').val('');
                if (response == "SessionTimeOut") {
                      window.location = "/Home/LogOut";
                }
                if (response == "Successfully Uploaded") {
                    Get_wsp_avail();
                }
            },
            error: function () {
                alert('Update Failed');
            }
        });
    }

    function Get_wsp_avail() {

        $.ajax({
