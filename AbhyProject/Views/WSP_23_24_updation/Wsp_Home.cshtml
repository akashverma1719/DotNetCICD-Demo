<script type="text/javascript">


    function getCurrentFiscalYear() {
        //get current date
        var today = new Date();

        //get current month
        var curMonth = today.getMonth();

        var fiscalYr = "";
        if (curMonth > 3) { //
            var nextYr1 = (today.getFullYear() + 1).toString();
            fiscalYr = today.getFullYear().toString() + "-" + nextYr1.charAt(2) + nextYr1.charAt(3);
        } else {
            var nextYr2 = today.getFullYear().toString();
            fiscalYr = (today.getFullYear() - 1).toString() + "-" + nextYr2.charAt(2) + nextYr2.charAt(3);
        }

        return (fiscalYr);
    }

    function Availability_Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSP_23_24_updation/WaterAvailabiltyInfo_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    window.location = "/WSP_23_24_updation/waterAval_report";
                }
                $('#WaterAvailabilty').text("0");
                if (response == "Logout") {
                    window.location = "/Home/LogOut";
                }
                if (response.length != 0) {

                    if (response[0].total_avail_water != null && response[0].total_avail_water != "") {
                        $('#WaterAvailabilty').text(parseFloat(response[0].total_avail_water).toFixed(4));
                    } else {

                        $('#WaterAvailabilty').text("0");
                    }
                }
            }
        });
    }


    var Domestic_Total = 0;
    var Irrigated_Total = 0;

    function Water_Utilization_Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSP_23_24_updation/Water_Utilization_Info',
            data: '',
            dataType: 'JSON',
            success: function (response) {

                $('#WaterUtilization').text(response.toFixed(4));
                if (response == "Logout") {
                    window.location = "/Home/LogOut";
                }
            }
        });
    }

