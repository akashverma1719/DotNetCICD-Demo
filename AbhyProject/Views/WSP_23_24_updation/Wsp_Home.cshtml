                if (status_check >= 3) {
                    if (ss == "Wspgram") {
                        window.location = "/WSP_23_24_updation/WSP_gram";
                    }
                    else if (ss == "WSPR") {
                        window.location = "/WspNew/report_declaration";
                    }
                    else if (ss == "WaterAvailabilty") {
                        window.location = "Wsp_Water_Availability", "WSP_23_24_updation";
                    }
                    else if (ss == "WaterUtilization") {
                        window.location = " /WSP_23_24_updation/Water_Utilization";
                    }
                    else if (ss == "WaterBalance") {
                        window.location = " /WSP_23_24_updation/Wsp_Balance";
                    }
                    else if (ss == "WaterBudget") {
                        window.location = " /WSP_23_24_updation/Water_Budget";
                    }
                    else if (ss == "WSPDemandside") {
                        window.location = " /WSP_23_24_updation/DemandSide";
                    } else if (ss == "PGWM") {
                        window.location = " /WSP_23_24_updation/PGWM";
                    }
                    else if (ss == "Demand") {
                        window.location = " /WSP_23_24_updation/DemandSide";
                    }
                    else if (ss == "Supply") {
                        window.location = " /WSP_23_24_updation/SupplySide";
                    }
                    else if (ss == "DPMU") {
                        window.location = " /WSP_23_24_updation/declaration";
                    } else if (ss == "wsp_report") {
                        window.location = "/WSP_23_24_updation/Total_WSP_Report";
                    } else if (ss == "Wspremarks") {
                        window.location = "/WSP_23_24_updation/Wspremarks";
                    }
                }
            }
            else {
                if (ss == "Wspgram") {
                    window.location = "/WSP_23_24_updation/WSP_gram";
                }
            }

        }
    }


    function Goto_page() {

        var path = $('#goto_page').val();
        window.location = path;
    }
</script>
<script>
        $(document).ready(function () {
            var currentUrl = window.location.href;
            const myArray = currentUrl.split("/");
            let coun = myArray.length - 1;
            //alert(myArray[coun].toString());
            if ((myArray[coun] != "WSP_GWM_HOME") && (myArray[coun] != "LogInForce")) {
                GetCunCurrentUser();
                setInterval(GetCunCurrentUser, 30000);
            }
            GetPagelog();
        });

        function GetCunCurrentUser() {
            $.ajax({
                type: 'get',
                url: '@Url.Action("CheckCunCurrentUser", "WspNew")',
                success: function (data) {
                    if (data == "False") {
                        //window.location.href = "/Home/LogOut";
                        window.location.href = "../../WspNew/WSP_GWM_HOME";
                    }
                }
            });
    }

    function GetPagelog() {
    var dateTime = "@dateTime";
    var pageName = "@lastAccessedPage"

    $.ajax({
        url: '/WspNew/UpdatePageLog',
        type: 'POST',
        data: {
            dateTime: dateTime,
            pageName: pageName
        },
        success: function (response) {
            if (response.success) {
                console.log(response.message);
            } else {
                alert("Error: " + response.message);
            }
        },
        error: function () {
            alert("Failed to update the log.");
        }
    });
}


</script>
