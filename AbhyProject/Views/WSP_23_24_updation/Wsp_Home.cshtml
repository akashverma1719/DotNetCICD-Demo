    var status_check = 0;
    function get_approved_reject_status() {

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WSP_23_24_updation/get_approved_reject_status",
            dataType: 'JSON',
            success: function (data) {
                status_check = data.status_id;
                var status = '';
                if (data == "null") {
                    status = 'In Progress';
                    $('#status_wsp').text(status).css({ 'color': 'blue' });
                }
                if (data.reject_status == "Rejected By State") {
                    status = 'Rejected By State';
                    $('#status_wsp').text(status).css({ 'color': 'red' });
                }
                if (data.reject_status == "Rejected By District") {
                    status = 'Rejected By District';
                    $('#status_wsp').text(status);
                }
                if ((data.reject_status == "" || data.reject_status == null) && data.status_id == 3) {
                    status = 'Submitted to DPMU';
                    $('#status_wsp').text(status).css({ 'color': 'green' });
                }
                if ((data.reject_status == "" || data.reject_status == null) && data.status_id == 4) {
                    status = 'Submitted to SPMU';
                    $('#status_wsp').text(status).css({ 'color': 'green' });
                }
                if (data.status_id == 5) {
                    status = 'Approved';
                    $('#status_wsp').text(status).css({ 'color': 'green' });
                }
                if (data.status_id == 1) {

                    status = 'In Progress';
                    $('#status_wsp').text(status).css({ 'color': 'blue' });
                }
            }
        });
    }
