<script>
    var StateOfficer = '';
    $(document).ready(function () {
        $('#dpmu_btn').hide();
        $('#pgwm_btn').hide();
        get_remarks_status();
        StateOfficer = '@Session["Officer"]';
        if (StateOfficer != "Gram Panchyat Nodal Officer") {
            $('#dpmu_btn').show();
        } else {
            $('#pgwm_btn').show();
        }
    });

    function get_remarks_status() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WSP_23_24_updation/get_remarks_status",
            dataType: 'JSON',
            success: function (data) {
                
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                @* status_id = @ViewBag.status_id;
                alert(status_id) *@
                if (data.gp_remarks != null) {
                    $('#gp_remarks').val(data.gp_remarks);
                }
                if (data.wa_remarks != null) {
                    $('#wa_remarks').val(data.wa_remarks);
                }
                if (data.wu_remarks != null) {
                    $('#wu_remarks').val(data.wu_remarks);
                }
                if (data.wb_remarks != null) {
                    $('#wb_remarks').val(data.wb_remarks);
                }
                if (data.wbu_remarks != null) {
                    $('#wbu_remarks').val(data.wbu_remarks);
                }
                if (data.ds_remarks != null) {
                    $('#ds_remarks').val(data.ds_remarks);
                }
                if (data.ss_remarks != null) {
                    $('#ss_remarks').val(data.ss_remarks);
                }
                if (data.pgwm_remarks != null) {
                    $('#pgwm_remarks').val(data.pgwm_remarks);
                }
            }
        });
    }

    function goto_page() {

        var path = $('#goto_page').val();
        window.location = path;
    }
</script>