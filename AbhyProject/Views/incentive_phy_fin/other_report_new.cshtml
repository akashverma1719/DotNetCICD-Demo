<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demobalance2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>

    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demobalance").innerHTML = today;
    var financialYear = getFinancialYear(today);
    function getFinancialYear(date) {
        
        var year = yyyy;
        var month = mm + 1; // January is 0, so we add 1 to get the correct month number

        // Financial year starts in April and ends in March
        if (month >= 4) {
            var startYear = year;
            var endYear = (year + 1).toString().slice(-2);
        } else {
            var startYear = year - 1;
            var endYear = year.toString().slice(-2);
        }

        return startYear + "-" + endYear;
    }


</script>

<script>


    function state_data() {
        $(".loader").show();
        
        var state = $('#state').val();
        var year = $('#year').val();
        var month = $('#month').val();


        $.ajax({
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            url: '/incentive_phy_fin/other_tracker',
            data: {
                statename: state, year: year, month: month
            },
            success: function (data) {
                
                var Tbodyhtml = '';
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
              else if (data == 'No Data') {
                    Tbodyhtml = '<tr colspan="15"><td colspan="16" style="text-align: center;">No Data</td></tr>';
                    $('#tblreport tbody').html(Tbodyhtml);
                    $(".loader").hide();
                }
                else {
                    if (data.length == 1) {

                        for (var i = 0; i < data.length; i++) {

                            Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
                            Tbodyhtml += '<td id="rainfall"><label>' + data[i].department + '</label></td>';
                            Tbodyhtml += '<td id="rainfall"><label>' + data[i].otherdepartment + '</label></td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].atal_gp + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].inc_gp + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].cost.toFixed(2) + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].area+ '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].beneficery + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].m_sc + '</td>';

                            Tbodyhtml += '<td id="rainfall">' + data[i].activity + '</td></tr >';

                        }


                        $('#tblreport tbody').html(Tbodyhtml);
                        $(".loader").hide();

                    }
                    else {

                        var atal_gp = 0;
                        var inc_gp = 0;
                        var cost = 0;
                        var area = 0;
                        var beneficery = 0;
                        var m_sc = 0;




                        for (var i = 0; i < data.length; i++) {

                            atal_gp += data[i].atal_gp;
                            inc_gp += data[i].inc_gp;
                            cost += data[i].cost;
                            area += data[i].area;
                            beneficery += data[i].beneficery;
                            m_sc += data[i].m_sc;


                            Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
                            Tbodyhtml += '<td id="rainfall"><label>' + data[i].department + '</label></td>';
                            Tbodyhtml += '<td id="rainfall"><label>' + data[i].otherdepartment + '</label></td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].atal_gp + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].inc_gp + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].cost.toFixed(2) + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].area + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].beneficery + '</td>';
                            Tbodyhtml += '<td id="rainfall">' + data[i].m_sc + '</td>';

                            Tbodyhtml += '<td id="rainfall">' + data[i].activity + '</td></tr >';

                        }

                        Tbodyhtml += '<tr><td colspan="4" id="srNo"><label>' + "Total" + '</label></td>';
                       
                        Tbodyhtml += '<td id="rainfall"><label>' + inc_gp + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + cost.toFixed(2) + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + area + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + beneficery + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + m_sc + '</label></td>';

                        Tbodyhtml += '<td id="rainfall"></td></tr >';


                        $('#tblreport tbody').html(Tbodyhtml);
                        $(".loader").hide();

                    }
                }
            }


        });



    }



</script>

