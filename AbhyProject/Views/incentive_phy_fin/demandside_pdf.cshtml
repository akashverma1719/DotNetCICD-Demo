        //Print the page content
        window.print()
        $('div#btnExport').removeClass('hideDownload');
        $('div#btnExport1').removeClass('hideDownload');
        //printButton.style.visibility = 'visible';
    }
</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demo").innerHTML = today;
</script>

<script>
    $(document).ready(function () {
        
        var StateOfficer = '@Session["Officer"]';
        var month = '@Session["month"]';
        var month_name = Get_Month_Number(month)
        $('#spnmonth').text(month_name);
        $('#spnmonth1').text(month_name);
        if (StateOfficer == "") {
              window.location = "/Home/LogOut";
        }

        sarpanch_getting();

    });

   

    function Get_Month_Number(month) {
        
        var month_num = "";
        switch (month) {
            case "1":
                month_num = 'April';
                break;
            case "2":
                month_num = 'May';
                break;
            case "3":
                month_num = "June";
                break;
            case "4":
                month_num = "July";
                break;
            case "5":
                month_num = "August";
                break;
            case "6":
                month_num = "September";
                break;
            case "7":
                month_num = "October";
                break;
            case "8":
                month_num = "November";
                break;
            case "9":
                month_num = "December";
                break;
            case "10":
                month_num = "January";
                break;
            case "11":
                month_num = "February";
                break;
            case "12":
                month_num = "March";
                break;
        }
        return month_num;
    }

    function sarpanch_getting() {
        
        $('.loader').hide();
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/incentive_phy_fin/Data_get_pdf',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }

                var tr = '';
                var j = 0;
                if (data.length != 0) {
                    for (var i = 0; i < data.length; i++) {
                        var remark = data[i].remark;
                        if (remark == null) {
                            remark = "";
                        }
                        var update_month = data[i].update_month;
                        if (update_month == null) {
                            update_month = "";
                        }
                        var otherdepartment = data[i].otherdepartment;
                        if (otherdepartment == null) {
                            otherdepartment = "";
                        }
                        tr += '<tr id="AWP1_TR' + i + '"><td>' + (++j) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gp + '</td><td>' + data[i].year + '</td><td>' + data[i].month + '</td><td>' + update_month + '</td><td>' + data[i].department + '</td><td>' + otherdepartment + '</td><td>' + data[i].activity + '</td> <td>' + data[i].cost + '</td><td>' + data[i].area_under + '</td><td>' + data[i].total_beneficiary + '</td><td>' + data[i].msc + '</td><td>' + data[i].mst + '</td><td>' + data[i].mobc + '</td><td>' + data[i].mother + '</td><td>' + data[i].fsc + '</td><td>' + data[i].fst + '</td><td>' + data[i].fobc + '</td><td>' + data[i].fother + '</td><td>' + remark + '</td></tr>';
                    }

                }
                if (tr == '') {
                    tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                    $('#tbldata').html(tr);
                    //$('.loader').hide();
                }
                else {
                    $('#tbldata').html(tr);
                    $('#raintotal').text(data.length);
                   // $('.loader').hide();
                }

            }
        });
    }

</script>