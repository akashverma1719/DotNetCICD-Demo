        function enforceNumberValidation(i, ele) {

            let j = i.toString();
            /*var i = aaa;*/
            var match = false;
            var match2 = false;
            var matchwr = false;
            var matchwr2 = false;
            var lat = $('#cf' + j).val();
            var long = $('#cg' + j).val();




            if (!(lat.indexOf(".") == -1)) {
                match = true; // decimal
            } else {
                match = false;
            }
            if (lat.length == 2 && match != true) {
                $('#cf' + j).val(lat + '.');
            } else if (lat.length == 1 && match != false) {
                $('#cf' + j).val('');
            }


            if (!(long.indexOf(".") == -1)) {
                match2 = true; // decimal
            } else {
                match2 = false;
            }
