        function enforceNumberValidationlat(ele) {

            var match = false;
            var match2 = false;
            var matchwr = false;
            var matchwr2 = false;
            var lat = $('#latitude').val();
            var long = $('#longitude').val();




            if (!(lat.indexOf(".") == -1)) {
                match = true; // decimal
            } else {
                match = false;
            }
            if (lat.length == 2 && match != true) {
                $('#latitude').val(lat + '.');
            } else if (lat.length == 1 && match != false) {
                $('#latitude').val('');
            }


            if (!(long.indexOf(".") == -1)) {
                match2 = true; // decimal
            } else {
                match2 = false;
            }
            if (long.length == 2 && match2 != true) {
                $('#longitude').val(long + '.');
            } else if (long.length == 1 && match2 != false) {
                $('#longitude').val('');
            }


            var latwr = $('#latitude').val();
            var longwr = $('#longitude').val();

            if (!(latwr.indexOf(".") == -1)) {
                matchwr = true; // decimal
            } else {
                matchwr = false;
            }
            if (latwr.length == 2 && matchwr != true) {
                $('#latitude').val(latwr + '.');
            } else if (latwr.length == 1 && matchwr != false) {
                $('#latitude').val('');
            }


            if (!(longwr.indexOf(".") == -1)) {
                matchwr2 = true; // decimal
            } else {
                matchwr2 = false;
            }
            if (longwr.length == 2 && matchwr2 != true) {
                $('#longitude').val(longwr + '.');
            } else if (longwr.length == 1 && matchwr2 != false) {
                $('#longitude').val('');
            }
            $('#latitude, #longitude').on('keydown', function (e) {
                if (e.which == 8) { // Check if the pressed key is the backspace key
                    var val = $(this).val();
                    if (val.charAt(val.length - 1) === '.') {
                        // If the last character is a decimal point, remove it
                        $(this).val(val.slice(0, -1));
                    }
                }
            });

            if ($(ele).data('decimal') != null) {
                // found valid rule for decimal
                var decimal = parseInt($(ele).data('decimal')) || 0;
                var val = $(ele).val();
                if (decimal > 0) {
                    var splitVal = val.split('.');
                    if (splitVal.length == 2 && splitVal[1].length > decimal) {
                        // user entered invalid input
                        $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                    }
                } else if (decimal == 0) {
                    // do not allow decimal place
                    var splitVal = val.split('.');
                    if (splitVal.length > 1) {
                        // user entered invalid input
                        $(ele).val(splitVal[0]); // always trim everything after '.'
                    }
                }
            }
        }


