                } else {
                    var count = 0, point = false;
                    for (var i = 0; i < value.length; i++) {

                        if (value[i] == '.' || point) {
                            count++;
                            point = true;
                        }
                        if (count > 2) {
                            e.preventDefault();
                        }
                    }
                }

            }
