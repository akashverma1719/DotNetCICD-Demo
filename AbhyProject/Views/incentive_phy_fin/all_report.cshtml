<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demobalance2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demobalance").innerHTML = today;
</script>

<script>

    function state_data() {
        $(".loader").show();
        
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/incentive_phy_fin/demand_report',
            dataType: '',
            success: function (data) {
                debugger;
                var Tbodyhtml = '';
                if (data.length != 0) {
                    
                    var area_under = 0;
                    var cost = 0;
                    var total_beneficiary = 0;
                    var msc = 0;
                    var mst = 0;
                    var mobc = 0;
                    var mother = 0;
                    var fsc = 0;
                    var fst = 0;
                    var fobc = 0;
                    var fother = 0;
                    var totalgp = 0;
                    var totalgp_count = 0;
                    

                    for (var i = 0; i < data.length; i++) {

                        area_under += data[i].area_under;
                        cost += data[i].cost;
                        total_beneficiary += data[i].total_beneficiary ;
                        msc += data[i].msc;
                        mst += data[i].mst;
                        mobc += data[i].mobc ;
                        mother += data[i].mother;
                        fsc += data[i].fsc;
                        fst += data[i].fst;
                        fobc += data[i].fobc;
                        fother += data[i].fother;
                        totalgp += data[i].totalgp;
                        totalgp_count += data[i].totalgp_count;

                        

                            Tbodyhtml += '<tr><td id="srNo"><label>' + (i+1) + '</label></td>';
                            Tbodyhtml += '<td id="rainfall"><label>' + data[i].statename + '</label></td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].totalgp + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].totalgp_count + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].cost.toFixed(2) + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].area_under.toFixed(2) + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].total_beneficiary + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].msc + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].mst + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].mobc + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].mother + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].fsc + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].fst + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].fobc + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].fother + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].activity_name + '</td></tr >';
                            
                    }


                    Tbodyhtml += '<tr><td colspan="2" id="srNo"><label>' + "Total" + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + totalgp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + totalgp_count + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + cost.toFixed(2) + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + area_under.toFixed(2) + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + total_beneficiary + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + msc + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + mst + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + mobc + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + mother + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + fsc + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + fst + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + fobc + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + fother + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"></td></tr >';



                    $('#tblreport tbody').html(Tbodyhtml);
                    $(".loader").hide();

                }



            }


        });



    }



</script>

