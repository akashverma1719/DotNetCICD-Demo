    function CheckDataGPInfo() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WSP_2024_25/CheckDataGPInfo",
            dataType: 'JSON',
            success: function (response) {
                if (response.result == true) {
                    window.location = "Wsp_Water_Availability", "WSP_2024_25"
                } else {
                    alert(response)
                }
            }
        });
    }
    function gpimagesgeting_Location() {

        var state = $('#spnstate').text();
        var dist = $('#spndistrict').text();
        var block = $('#spnblock').text();
        var gram = $('#spngram').text();
        var obj = {};
        obj.state_name = state;
        obj.district_name = dist;
        obj.block_name = block;
        obj.gpname = gram;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSP_2024_25/MapImagesdetails1',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                //alert(data.length);
                $("#loaction_map_geting").html("");
                $("#Drainage_map_geting").html("");
                $("#Aquifer_map_geting").html("");
                $("#Watershed_map_geting").html("");
                var i = 0;
                var tr = '';
                if (data.length != 0) {
                    //alert('imagegetting');
                    for (var i = 0; i < data.length; i++) {
                        tr += '<tr><td></td></tr > ';
                        tr += '<tr> <th colspan="4" style=" background-color: #ececec;text-align: center;color: #5080a9; ">Location Map</th></tr > ';
                        tr += '<tr><td><label><a  href="/WSP_2024_25/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage1) + '"   target="_blank"><img src="/WSP_2024_25/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage1) + '"  style="width: 100%;"/></a></label></td></tr>';
                        tr += '<tr><th colspan="4" style=" background-color: #ececec;text-align: center;color: #5080a9; ">Watershed Map</th></tr>';
                        tr += '<tr><td><label><a  href="/WSP_2024_25/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage2) + '" target="_blank"><img src="/WSP_2024_25/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage2) + '" style="width: 100%;"/></a></label></td></tr>';
                        tr += '<tr><th colspan="4" style=" background-color: #ececec;text-align: center;color: #5080a9; ">Aquifer Map</th></tr>';
                        tr += '<tr><td><label><a href="/WSP_2024_25/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage3) + '"   target="_blank"><img src="/WSP_2024_25/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage3) + '"  style="width: 100%;"/></a></label></td></tr>';

                    }
                    $('#image_div').append(tr);
                    get_map();
                }

            }

        });
    }
        function ReportPdf() {

        $("#Data1").width(1110);
        var element = document.getElementById('Data1');
