    function Details() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSP_2024_25/GrampanchayatDetails',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Error") {
                    window.location = "/WSP_2024_25/WSp_Gram_Report";
                }
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (data.length != 0) {
                    var sub_basin_name = data[0].sub_basin_name;
                    if (sub_basin_name == "Other") {
                        sub_basin_name = data[0].sub_basin_name + " - " + data[0].other_sub_basin_name;
                    } else if (sub_basin_name == "0") {
                        sub_basin_name = "";
                    }
                    var basin_name = data[0].basin_name;
                    if (basin_name == "Other") {
                        basin_name = data[0].basin_name + " - " + data[0].other_basin_name;
                    }

                    $('#gp_id').text(data[0].gp_id);
                    if (data[0].block_area != null) {
                        $('#block_area').text(parseFloat(data[0].block_area).toFixed(4));
                    }
                    if (data[0].gp_area != null) {
                        $('#gp_area').text(parseFloat(data[0].gp_area).toFixed(4));
                    }
                    $('#watershed_code').text(data[0].watershed_code);

                    $('#watershed_name').text(data[0].watershed_name);
                    $('#watershed_area_block').text(data[0].watershed_area_block);
                    $('#sub_basin_code').text(data[0].sub_basin_code);
                    $('#sub_basin_name').text(sub_basin_name);

                    $('#basin_name').text(basin_name);
                    $('#basin_code').text(data[0].basin_code);


                }

                $('.Loader').hide();
                gpimagesgeting_Location();
            }
        });
    }

    

