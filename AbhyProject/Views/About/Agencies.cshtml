<script>
    $(document).ready(function () {
        Info();
        $('#example').DataTable();
    });
    function Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/About/Agencies_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                var Divv = "";
                var ddlst = {};
                var all_dists = [];
                if (data != null) {

                    for (var i = 0; i < data.length; i++) {

                        var project_coordinator = data[i].project_coordinator;
                        if (project_coordinator == null) {
                            project_coordinator = "";

                        }
                        var contact_details = data[i].contact_details;
                        if (contact_details == null) {
                            contact_details = "";

                        }
                        var nodel_officer_project_director = data[i].nodel_officer_project_director;
                        if (nodel_officer_project_director == null) {
                            nodel_officer_project_director = "";

                        }
                        var agency_name = data[i].agency_name;
                        if (agency_name == null) {
                            agency_name = "";

                        }

                        if (!ddlst[data[i].state]) {
                            all_dists.push(data[i].state);
                            ddlst[data[i].state] = data[i].state;

                        }

                        Divv += ' <tr> <td>' + (i + 1) + '</td><td>' + data[i].state + '</td><td>' + project_coordinator + ' </td><td>' + contact_details + '<td>' + nodel_officer_project_director + '</td>' +
                            '<td>' + agency_name + '</td><td></td></tr>';
                    }
                    $('#AgenciesInfo').html(Divv);
                }
                else {
                    Divv += ' <tr><td colspan="7"> No Data</td> </tr>';
                    $('#AgenciesInfo').html(Divv);

                }

                $('#states_count').text(all_dists.length);
            }
        });
    }
</script>