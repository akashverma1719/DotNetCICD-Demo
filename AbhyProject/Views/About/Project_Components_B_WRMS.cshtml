
@{
    ViewBag.Title = "Project_Components_B_WRMS";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}
<title>Incentive Component </title>
<style>
    .div-w99 {
        max-width: 97% !important;
        margin: auto;
        width: 97% !important;
    }


    .container {
    }

    .nav-tabs {
        border-bottom: 1px solid #e4e5e7;
    }

        .nav-tabs > li > a {
            font-weight: 600;
            color: #fff;
            background-color: #30ABEC;
            padding: 8px 10px;
            border: 1px solid #eee;
            border-bottom: none;
        }

        .nav-tabs > li a:hover {
            background: transparent;
        }

        .nav-tabs > li.active > a,
        .nav-tabs > li.active > a:hover,
        .nav-tabs > li.active > a:focus {
            border: 1px solid #e4e5e7;
            border-bottom-color: transparent;
        }

    .tab-content {
        border: 1px solid #cacaca;
        border-top: none;
        padding: 12px 16px;
    }

        .tab-content > .active,
        .pill-content > .active {
            display: block;
        }

        .tab-content p:last-child {
            margin-bottom: 0;
        }

    .fade {
        opacity: 1 !important;
        transition: opacity .15s linear;
    }

    .tabs-section ul li > .active {
        background: #ffffff !important;
        color: #000000;
    }

    .nav-tabs > li > a i {
        margin-right: 1px;
        padding-right: 5px;
    }

    ul#myTabs1 > li.active::after {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #2E578C;
        content: " ";
        position: absolute;
        bottom: -15px;
        margin-left: -15px;
        left: 50%;
    }

    ul#myTabs1 > li {
        background-color: #3A99ED;
        padding: 0px;
    }

        ul#myTabs1 > li.active > a,
        ul#myTabs1 > li.active > a:focus,
        ul#myTabs1 > li.active > a:hover {
            color: #fff !important;
            background-color: #2E578C !important;
        }

    .nav > li > a:focus, .nav > li > a:hover {
        text-decoration: none;
        background-color: #6FB11D;
    }

    ul#myTabs1 > li > a {
        color: #fff;
    }

    body {
        line-height: 24px;
    }


    .panel-title a .control-icon {
        position: absolute;
        right: 33px;
        margin-top: -11px;
    }

    .panel-title a i {
        font-size: 1.2em;
        padding-right: 5px;
    }

    .fa-desktop {
        padding: 5px;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:sans-serif;margin-top:20px;font-weight:900">Incentive Component : </div>
    </div>
</div>
<div class="container-fluid div-w99">
    <div class="row">
        <div class="col-md-12" style="padding-top:20px">

            <div class="col-md-12">
                <h5 style="line-height:1.5em; margin-bottom:20px;font-size:16px;">
                    The incentive component is for incentivizing the States for convergence amongst various schemes of the Central and State Governments and achievement of pre-defined results measured against the Disbursement Linked Indicators (DLIs) of optimal water use and consequent improvement in ground water scenario. Total outlay under incentive component is Rs 4600 Crore with World Bank contribution of Rs. 3000 Crore and GoI contribution of Rs. 1600 Crore
                </h5>
            </div>
        </div>
    </div>
</div>



<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<script>
    $("nav#primary-menu > ul.main-menu > li:nth-child(2)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(2)").siblings().removeClass('active');
    $("nav#primary-menu > ul.main-menu > li:nth-child(2) > ul.dropdown > li:nth-child(3) ").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(2) > ul.dropdown > li:nth-child(3)").siblings().removeClass('active');
    $("nav#primary-menu > ul.main-menu > li:nth-child(2) > ul.dropdown > li:nth-child(3)> ul.inside-menu > li:nth-child(2)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(2) > ul.dropdown > li:nth-child(3)> ul.inside-menu > li:nth-child(2)").siblings().removeClass('active');
</script>