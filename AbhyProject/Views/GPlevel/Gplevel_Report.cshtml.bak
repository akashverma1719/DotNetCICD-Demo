
@{
    Layout = null;
}

<!DOCTYPE html>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/css/wsp_report_css.css" rel="stylesheet" />
<link href="~/Scripts/all_scripts/w3.css" rel="stylesheet" />
<link href="~/Scripts/all_scripts/bootstrap.min.css" rel="stylesheet" />
<link href="~/Scripts/all_scripts/font-awesome.min.css" rel="stylesheet" />
<script src="~/Scripts/all_scripts/jquery3.3.1.min.js"></script>
<!-- Latest compiled JavaScript -->
<script src="~/Scripts/all_scripts/bootstrap_3.4.0.min.js"></script>
<script src="~/Content/css/baseline_gp_js.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>
<style>
    body {
        font-family: Calibri !important;
    }

    .page2el2 {
        margin-top: 50px;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .reportheading {
        color: #337ab7;
        font-size: 25px;
        font-weight: bold;
    }

    .demandside_text > tbody > tr > td {
        text-align: right;
        font-size: 14px !important;
    }

    .demandside_text > tbody > tr.tableheader_text > th {
        font-size: 14px !important;
    }

    .demandside_text > tbody > tr > td:last-child {
        text-align: left !important;
    }

    .demanside_padding_heading1 {
        padding: 0px !important;
    }

    .supplyside_demandside_space1 > .reportheading > p {
        margin: 0px 0 6px !important;
    }

    .gramReport_div_start.col-md-12 {
        padding: 0px;
    }

    .demandside_text_123 > tbody > tr > th {
        font-size: 14px !important;
    }

    .dateandtime_ul {
        padding: 0px;
    }


        .dateandtime_ul > li {
            display: inline-block;
            color: #000;
            font-size: 18px;
            padding: 0px 15px;
        }

    .table-striped tbody tr td:last-child {
        text-align: right;
    }

    .pgwmtable tbody tr td:last-child,
    .demandsidetable tr td:last-child {
        text-align: left !important;
    }

    .wateratextiablity_space {
        margin-top: 186px;
    }

    .waterdrft_space {
        margin-top: 18px;
    }

    .waterdrft_balance {
        margin-top: 180px;
    }

    .waterdrft_Budgeting_space {
        margin-top: 280px;
    }

    .hideDownload {
        display: none;
    }

    .singnatire_table tbody tr td {
        height: 100px;
    }

    .supplyside_demandside_space {
        margin-top: 340px;
    }

    .pgwmCommiteee_space {
        margin-top: 70px;
        margin-bottom: 50px;
    }

    .pgwm_range {
        margin-top: 280px;
    }

    .background_after_download * {
        font-weight: normal !important;
        text-decoration: none !important;
        text-shadow: none !important;
    }

    .tableheadingbg {
        color: #337ab7 !important;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        background: #fff;
    }

    .colorline1 {
        background: #ddd;
        background-size: 100% 6px;
        background-position: 50% 100%;
        background-repeat: no-repeat;
        text-align: center;
        margin-top: 12px;
        height: 3px;
        width: 100%
    }

    .col-md-9 > h1 {
        font-weight: bold;
        color: #404040;
        text-shadow: -1px -1px #000;
    }

    .col-md-9 > p {
        color: #404040;
    }

    .col12 > .firsttable > h6 {
        letter-spacing: 0px;
        padding-left: 10px;
    }

    .firstptag {
        padding-left: 4%;
    }

    body {
        background-color: #ddd;
    }

    .clearfixcolor {
        margin-top: 15px;
    }

    .col12 {
        background-color: #fff;
        padding: 25px;
    }

    .highcharts-credits {
        display: none;
    }



    .highcharts-button-box {
        display: none;
    }


    .text-right > .btn-success {
        margin-top: 20px;
        font-weight: bold;
    }

    .text-right {
        padding: 5px;
    }

        .text-right > .btn-success {
            padding: 8px 20px 8px 20px;
            border-radius: 50px;
            font-size: 18px;
        }

    .btn-success {
        color: #fff;
        background-color: #6fb01d;
        border-color: #4cae4c;
    }

    .coll7 {
        padding-right: 0px;
    }

    ul.Select_option {
        list-style: none;
        display: block;
        padding: 0px 0px 0px 0px;
        font-size: 15px;
        margin: 0px;
    }

        ul.Select_option > li {
            display: inline-block;
            padding: 0px 0px 0px 46px;
            word-spacing: 1px;
            text-transform: uppercase;
        }

            ul.Select_option > li > span > i {
                padding: 0px 0px 0px 10px;
            }

    #Select_dist_level {
        padding: 10px 0px 5px 15px;
        text-transform: capitalize;
    }

    ul.firstimages {
        display: block;
        margin-bottom: 0px;
    }

        ul.firstimages > li {
            display: inline-block;
            padding-left: 5px;
            border: 1px solid #ddd;
            padding: 10px 10px 5px 10px;
        }

            ul.firstimages > li > img {
                border-left: 2px solid #ddd;
            }

            ul.firstimages > li > span > img {
                width: 25px;
                height: 25px;
            }

    .highcharts-title {
        font-weight: bold;
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
        font-size: 13px;
    }

    tspan {
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    }



    .secondtable {
        text-align: right;
    }

    sup {
        font-weight: bold;
    }

    .tableheadingbg > span {
        color: purple;
        font-size: 20px;
    }

    .totatal_textue_label {
        background-color: #fff;
        padding: 10px;
    }

    #Data1 {
        background-color: #fff;
    }

    .firsttable {
        padding: 0px 0px 0px 0px;
    }

    .report_heading_div {
        background-color: #ddd;
        border-radius: 10px;
        padding: 10px;
    }

    .cololr-div {
        background: #4cae4c;
        height: 3px;
        padding: 0px;
    }

    .last-div-footer {
        padding: 10px 0px;
    }

    .table-condensed {
        font-weight: 100;
        text-shadow: none;
    }

    .tolat_report_color {
        color: #6FB11D !important;
    }

    .wateratextiablity_table > thead > tr > td,
    .wateratextiablity_table > tbody > tr > td {
        padding: 0px 3px;
    }

    table > tbody > tr > td {
        color: #337ab7 !important;
        font-weight: 500;
    }

    table > tbody > tr > th {
        color: #337ab7 !important;
    }

    table > tbody > tr > td > label {
        color: #000 !important;
    }

    table > tbody > tr > td > span {
        color: #000 !important;
    }

    .pgwmtable > tbody > tr > td {
        color: #000 !important;
    }

    .text_left_left {
        text-align: left !important;
        color: #000 !important;
    }
</style>
<div class="loading-container">
    @*<div class="loader">
            <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
        </div>*@
</div>
<div class="container" id="Data1">
    <div class="row row_padding_10">
        <div class="col-md-12">
            <div class="firsttable col-md-12">
                <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
            </div>
        </div>
        <div class="col-md-12 report_heading_div">
            <div class="col-md-9">
                <h1>GPDCI Report </h1>
            </div>
            <div class="col-md-3 text-right" id="btnExport">
                <button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>
                <button class="btn btn-success" id="print" onclick="printpage()">Print</button>
            </div>
            <div class="col-md-12">
                <ul class="dateandtime_ul">
                    <li>Date : <span id="demo"></span></li>
                    <li>Time : <span id="demo2"></span></li>
                    <li>
                        User Name:
                        @if (Session["UserName"] != null)
                        {
                            <span>@Session["UserName"].ToString()</span>
                        }
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">

            <div class="col-md-12 last-div-footer" id="btnExport1">
                <div class="col-md-12 text-center">
                    <a href="~//Gplevel/Gplevel" class="btn btn-danger"> Back</a>
                    @*<button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>*@


                </div>
            </div>

        </div>
        <div class="col-md-12 state_dist_level">
            <div class="row" id="Select_dist_level">
                <ul class="Select_option">
                    @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                    {

                        <li>
                            <label id="lblstate">State:</label>
                            <span id="spnstate">@Session["gstate"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                    {
                        <li>
                            <label id="lblstate">Admin</label>

                        </li>
                    }
                    else
                    {
                        <li>
                            <label id="lblstate">National Level Nodal Officer</label>

                        </li>
                    }


                    @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                    {
                        <li>

                            <label style="text-align:left" id="lbldistrict">District:</label>
                            <span id="spndistrict">@Session["gdist"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }

                    @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                    {
                        <li>

                            <label>Block:</label>
                            <span id="spnblock">@Session["gblock"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                    {
                        <li>

                            <label>Gram panchayat:</label>
                            <span style="text-align:left" id="spngram">@Session["ggram"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    @if (Session["year"] != null && Session["year"].ToString() != "null" && Session["year"].ToString() != "")
                    {
                        <li>

                            <label>Year:</label>
                            <span id="spnyear"></span>

                        </li>
                    }
                    @if (Session["month"] != null && Session["month"].ToString() != "null" && Session["month"].ToString() != "")
                    {
                        <li>

                            <label>Month:</label>
                            <span id="spngram">@Session["month"]</span>

                        </li>
                    }


                </ul>
            </div>

        </div>

        <div class="gramReport_div_start col-md-12">
            <div class="text-center reportheading">
                <p>
                    GP Profile
                </p>
            </div>

            <div class="col-md-12">
                <div id="resetinfo" class="tbl-responsive" style="padding:5px;overflow-x:scroll">
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody class="tablebody">

                            <tr>
                                <td>State:</td>
                                <td>
                                    <span id="state_name"></span>
                                </td>
                                <td>District:</td>
                                <td>
                                    <span id="district_name"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>Block / Taluk :</td>
                                <td>
                                    <span id="block_name"></span>
                                </td>
                                <td>GP Name :</td>
                                <td>
                                    <span id="gram_panchayat_name"></span>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="4" id="village_download"> </th>

                            </tr>
                            <tr>
                                <td>
                                    1. Total number of villages under the selected GP :
                                </td>
                                <td class="text_left_left">
                                    <span id="total_no_of_village"></span>
                                </td>

                                <td class="text_left_left">
                                    <span id="VillageName"></span>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="4">Village Name</th>

                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody id="village_name" class="tablebody text_left_left"></tbody>
                    </table>
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody class="">
                            <tr>
                                <th colspan="4" id="population_download"> </th>

                            </tr>
                            <tr>
                                <th colspan="4">2. Demographic Profile</th>

                            </tr>
                            <tr>
                                <td colspan="4" class="text_left_left">2.1 Population</td>
                            </tr>

                            <tr>
                                <td>Male :</td>
                                <td>
                                    <span id="male_population"></span>

                                </td>
                                <td>Female :</td>
                                <td>
                                    <span id="female_population"></span>

                                </td>
                            </tr>
                            <tr>
                                <td>Transgender :</td>
                                <td>
                                    <span id="transgender_population"></span>

                                </td>
                                <td>Total Population:</td>
                                <td>
                                    <span id="tol_population"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>Source Year :</td>
                                <td>
                                    <span id="source_year"></span>
                                </td>
                            </tr>
                            <tr><td colspan="4" class="text_left_left">2.2 Categories</td></tr>
                            <tr>
                                <td>SC :</td>
                                <td>
                                    <span id="no_of_sc"></span>

                                </td>
                                <td>ST :</td>
                                <td>
                                    <span id="no_of_st"></span>

                                </td>
                            </tr>
                            <tr>
                                <td>OBC :</td>
                                <td>
                                    <span id="no_of_obc"></span>

                                </td>
                                <td>General :</td>
                                <td>
                                    <span id="no_of_general"></span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text_left_left">2.3 Class/Status</td>
                            </tr>
                            <tr>
                                <td colspan="3">Number of BPL Card Holders :</td>
                                <td>
                                    <span id="no_of_bpl"></span>

                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" class="text_left_left">2.4 No.of Households</td>
                            </tr>
                            <tr>
                                <td colspan="3">No. of Households :</td>
                                <td>
                                    <span id="no_of_households"></span>

                                </td>
                            </tr>
                            <tr>
                                <th colspan="4" id="livestock_download"> </th>

                            </tr>
                            <tr>
                                <td colspan="4" class="text_left_left">2.5 Livestock Population</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody id="livestockthead" class="tablebody text_left_left"></tbody>
                    </table>
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody class="tablebody">
                            <tr class="text_left_left">
                                <td>Total Livestock population :</td>
                                <td class="text_left_left">
                                    <span id="livestock_population"></span>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="4" id="gparea_download"> </th>

                            </tr>
                            <tr>
                                <th colspan="4">3. GP Area (In ha)</th>
                            </tr>
                            <tr>
                                <td>Total GP Area :</td>
                                <td class="text_left_left">
                                    <span id="gp_area_in_ha"></span>

                                </td>
                            </tr>
                            <tr>
                                <th colspan="4">4. Land use and  Land Cover (in ha)</th>
                            </tr>
                            <tr>


                                <td>Forest area (ha) :</td>
                                <td class="text_left_left">
                                    <span id="forest_area_in_ha"></span>

                                </td>
                            </tr>
                            <tr>

                                <td class="text_left_left">Fallow land (ha):</td>
                                <td>
                                    <span id="fallow_land_in_ha"></span>

                                </td>
                                <td>Cultivable land (ha) :</td>
                                <td>
                                    <span id="cultivable_land_in_ha"></span>

                                </td>
                            </tr>
                            <tr>

                                <td>Other Land use (Settlement, Barren land etc.) :</td>
                                <td class="text_left_left">
                                    <span id="other_land_use"></span>

                                </td>
                            </tr>
                            <tr>
                                <th colspan="4" id="sownarea_download"> </th>

                            </tr>
                            <tr>
                                <th colspan="4">5. Net Area (In ha)</th>
                            </tr>
                            <tr>
                                <td>Net Sown Area :</td>
                                <td class="text_left_left">
                                    <span id="net_sown_area"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>Net Irrigated Area :</td>
                                <td class="text_left_left">
                                    <span id="net_irrigated_area"></span>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="4" id="irrigated_download"> </th>

                            </tr>
                            <tr>
                                <th colspan="4">6. Area Under Cultivation Kharif/Rabi/Summer (in ha)</th>
                            </tr>
                            <tr>
                                <td colspan="4" class="text_left_left">6.1 Irrigated Area</td>
                            </tr>
                            <tr>
                                <td> Area in kharif :</td>
                                <td>
                                    <span id="irrigated_area_in_kharif"></span>

                                </td>
                                <td> Area in rabi :</td>
                                <td>
                                    <span id="irrigated_area_in_rabi"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>Area in summer :</td>
                                <td>
                                    <span id="irrigated_area_in_summer"></span>

                                </td>
                                <td>Total Irrigated Area :</td>
                                <td>
                                    <span id="total_irrigated_area"></span>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" class="text_left_left">6.2 Un-Irrigated / Rainfed Area</td>
                            </tr>
                            <tr>
                                <td> Area in kharif :</td>
                                <td>
                                    <span id="un_irrigated_area_in_kharif"></span>

                                </td>
                                <td> Area in rabi :</td>
                                <td>
                                    <span id="un_irrigated_area_in_rabi"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>Area in summer :</td>
                                <td>
                                    <span id="un_irrigated_area_in_summer"></span>

                                </td>
                                <td>Total Irrigated Area :</td>
                                <td>
                                    <span id="total_un_irrigated_area"></span>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" class="text_left_left">6.3 Total Cropped Area</td>
                            </tr>
                            <tr>
                                <td>Total Cropped Area :</td>
                                <td class="text_left_left">
                                    <span id="total_cropped_area"></span>

                                </td>
                            </tr>
                            <tr>
                                <th colspan="4">7. Irrigation Source (in ha)</th>
                            </tr>


                            <tr>
                                <th colspan="4" id="ground_download"> </th>

                            </tr>
                            <tr>
                                <td colspan="4" class="text_left_left">7.1 Ground Water</td>
                            </tr>
                        </tbody>
                    </table>
                    @*<tr id="trirrsurfother"></tr>*@
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody id="irriggroundwatertr" class="tablebody"></tbody>
                    </table>
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody class="tablebody">

                            <tr>
                                <td>Total Irrigation from Ground Water :</td>
                                <td>
                                    <span id="totalGround"></span>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="4" id="surface_download"> </th>

                            </tr>
                            <tr>
                                <td colspan="4" class="text_left_left">7.2 Surface Water</td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody id="trirrsurfother" class="tablebody"></tbody>
                    </table>

                    @*<tr id="irriggroundwatertr"></tr>*@
