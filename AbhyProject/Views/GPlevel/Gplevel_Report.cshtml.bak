<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script>
    function ReportPdf() {
        $("#Data1").width(1095);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'GPDCI_report.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el11' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('#Data1').addClass('table-condensed');

        $(".highcharts-credits").css("display", "none");
        $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

        $('div#btnExport').addClass('hideDownload');

        $('div#btnExport1').addClass('hideDownload');

        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");


            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
    }
</script>

<script>
    //Code for print page
    function printpage() {
        //Get the print button and put it into a variable
        var printButton = document.getElementById("print");
        //Set the print button visibility to 'hidden'
        //printButton.style.visibility = 'hidden';
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        //Print the page content
        window.print()
        $('div#btnExport').removeClass('hideDownload');
        $('div#btnExport1').removeClass('hideDownload');
        //printButton.style.visibility = 'visible';
    }
</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demo").innerHTML = today;
</script>

<script>
    $(document).ready(function () {
        debugger;
        if (@Session["year"] == "2022") {
            $("#spnyear").text("2022-2023")
        } else if (@Session["year"] == "2023") {
            $("#spnyear").text("2023-2024")
        }else if (@Session["year"] == "2024") {
            $("#spnyear").text("2024-2025")
        }
        report_getting();
        sarpanch_getting();


    });

    function report_getting() {
        debugger;

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GPlevel/GPlevelreport_getting',
            data: '',
            //data: { 'state': State, 'dist': Dist, 'block': Block, 'gram': Gram,'year': Year },
            //data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                debugger;

                $("#state_name").text(data[0].objgpdata[0].state_name);
                $("#district_name").text(data[0].objgpdata[0].district_name);
                $("#block_name").text(data[0].objgpdata[0].block_name);
                $("#gram_panchayat_name").text(data[0].objgpdata[0].gpname);
                //$("#state_name").text(data[0].objgpdata[0].year);

                if (data[0].length != 0) {


                    if (data[0].objgpdata[0].total_no_of_village != null && data[0].objgpdata[0].total_no_of_village != "") {
                        $('#total_no_of_village').text(parseInt(data[0].objgpdata[0].total_no_of_village));
                    }


                    //population

                    if (data[0].objgpdata[0].male_population != null && data[0].objgpdata[0].male_population != "") {
                        //male_population = data[0].male_population;
                        $('#male_population').text(parseInt(data[0].objgpdata[0].male_population));
                    }
                    if (data[0].objgpdata[0].female_population != null && data[0].objgpdata[0].female_population != "") {

                        //female_population = data[0].female_population;
                        $('#female_population').text(parseInt(data[0].objgpdata[0].female_population));
                    }
                    if (data[0].objgpdata[0].transgender_population != null && data[0].objgpdata[0].transgender_population != "") {
                        // child_population = data[0].child_population;
                        $('#transgender_population').text(parseInt(data[0].objgpdata[0].transgender_population));
                    }

                    if (data[0].objgpdata[0].tol_population != null && data[0].objgpdata[0].tol_population != "") {

                        $('#tol_population').text(parseInt(data[0].objgpdata[0].tol_population));
                    }
                    if (data[0].objgpdata[0].source_year != null && data[0].objgpdata[0].source_year != "") {
                        $('#source_year').text(data[0].objgpdata[0].source_year);
                    }

                    if (data[0].objgpdata[0].no_of_sc != null && data[0].objgpdata[0].no_of_sc != "") {

                        $('#no_of_sc').text(parseInt(data[0].objgpdata[0].no_of_sc));
                    }
                    if (data[0].objgpdata[0].no_of_st != null && data[0].objgpdata[0].no_of_st != "") {

                        $('#no_of_st').text(parseInt(data[0].objgpdata[0].no_of_st));
                    }
                    if (data[0].objgpdata[0].no_of_obc != null && data[0].objgpdata[0].no_of_obc != "") {

                        $('#no_of_obc').text(parseInt(data[0].objgpdata[0].no_of_obc));
                    }

                    if (data[0].objgpdata[0].no_of_general != null && data[0].objgpdata[0].no_of_general != "") {

                        $('#no_of_general').text(parseInt(data[0].objgpdata[0].no_of_general));
                    }
                    if (data[0].objgpdata[0].no_of_bpl != null && data[0].objgpdata[0].no_of_bpl != "") {

                        $('#no_of_bpl').text(parseInt(data[0].objgpdata[0].no_of_bpl));
                    }
                    //Number of House holds

                    if (data[0].objgpdata[0].no_of_households != null && data[0].objgpdata[0].no_of_households != "") {

                        $('#no_of_households').text(parseInt(data[0].objgpdata[0].no_of_households));
                    }

                    // Gp area in Ha

                    if (data[0].objgpdata[0].gp_area_in_ha != null && data[0].objgpdata[0].gp_area_in_ha != "") {

                        $('#gp_area_in_ha').text(parseFloat(data[0].objgpdata[0].gp_area_in_ha).toFixed(4));
                    }
                    if (data[0].objgpdata[0].forest_area_in_ha != null && data[0].objgpdata[0].forest_area_in_ha != "") {

                        $('#forest_area_in_ha').text(parseFloat(data[0].objgpdata[0].forest_area_in_ha).toFixed(4));
                    }
                    if (data[0].objgpdata[0].fallow_land_in_ha != null && data[0].objgpdata[0].fallow_land_in_ha != "") {

                        $('#fallow_land_in_ha').text(parseFloat(data[0].objgpdata[0].fallow_land_in_ha).toFixed(4));
                    }

                    if (data[0].objgpdata[0].cultivable_land_in_ha != null && data[0].objgpdata[0].cultivable_land_in_ha != "") {

                        $('#cultivable_land_in_ha').text(parseFloat(data[0].objgpdata[0].cultivable_land_in_ha).toFixed(4));
                    }

                    if (data[0].objgpdata[0].other_land_use != null && data[0].objgpdata[0].other_land_use != "") {

                        $("#other_land_use").text(parseFloat(data[0].objgpdata[0].other_land_use).toFixed(4));
                    }
                    if (data[0].objgpdata[0].net_sown_area != null && data[0].objgpdata[0].net_sown_area != "") {

                        $('#net_sown_area').text(parseFloat(data[0].objgpdata[0].net_sown_area).toFixed(4));
                    } else {
                        $('#net_sown_area').text("");
                    }
                    if (data[0].objgpdata[0].net_irrigated_area != null && data[0].objgpdata[0].net_irrigated_area != "") {

                        $('#net_irrigated_area').text(parseFloat(data[0].objgpdata[0].net_irrigated_area).toFixed(4));
                    } else {
                        $('#net_irrigated_area').text("");
                    }

                    //net_sown_area

                    // Agriculture

                    if (data[0].objgpdata[0].irrigated_area_in_kharif != null && data[0].objgpdata[0].irrigated_area_in_kharif != "") {

                        $('#irrigated_area_in_kharif').text(parseFloat(data[0].objgpdata[0].irrigated_area_in_kharif).toFixed(4));
                    }
                    if (data[0].objgpdata[0].irrigated_area_in_rabi != null && data[0].objgpdata[0].irrigated_area_in_rabi != "") {

                        $('#irrigated_area_in_rabi').text(parseFloat(data[0].objgpdata[0].irrigated_area_in_rabi).toFixed(4));
                    }
                    if (data[0].objgpdata[0].irrigated_area_in_summer != null && data[0].objgpdata[0].irrigated_area_in_summer != "") {

                        $('#irrigated_area_in_summer').text(parseFloat(data[0].objgpdata[0].irrigated_area_in_summer).toFixed(4));
                    }
                    if (data[0].objgpdata[0].total_irrigated_area != null && data[0].objgpdata[0].total_irrigated_area != "") {

                        $('#total_irrigated_area').text(parseFloat(data[0].objgpdata[0].total_irrigated_area).toFixed(4));
                    }
                    if (data[0].objgpdata[0].un_irrigated_area_in_kharif != null && data[0].objgpdata[0].un_irrigated_area_in_kharif != "") {

                        $('#un_irrigated_area_in_kharif').text(parseFloat(data[0].objgpdata[0].un_irrigated_area_in_kharif).toFixed(4));
                    }
                    if (data[0].objgpdata[0].un_irrigated_area_in_rabi != null && data[0].objgpdata[0].un_irrigated_area_in_rabi != "") {

                        $('#un_irrigated_area_in_rabi').text(parseFloat(data[0].objgpdata[0].un_irrigated_area_in_rabi).toFixed(4));
                    }
                    if (data[0].objgpdata[0].un_irrigated_area_in_summer != null && data[0].objgpdata[0].un_irrigated_area_in_summer != "") {

                        $('#un_irrigated_area_in_summer').text(parseFloat(data[0].objgpdata[0].un_irrigated_area_in_summer).toFixed(4));
                    }
                    if (data[0].objgpdata[0].total_un_irrigated_area != null && data[0].objgpdata[0].total_un_irrigated_area != "") {

                        $('#total_un_irrigated_area').text(parseFloat(data[0].objgpdata[0].total_un_irrigated_area).toFixed(4));
                    }
                    if (data[0].objgpdata[0].total_cropped_area != null && data[0].objgpdata[0].total_cropped_area != "") {

                        $('#total_cropped_area').text(parseFloat(data[0].objgpdata[0].total_cropped_area).toFixed(4));
                    }

                    if (data[0].objgpdata[0].unirrigated_area != null && data[0].objgpdata[0].unirrigated_area != "") {

                        $('#non_irrigated_area').text(parseFloat(data[0].objgpdata[0].unirrigated_area).toFixed(4));
                    }

                    // Water lifting source

                    if (data[0].objgpdata[0].non_energised != null && data[0].objgpdata[0].non_energised != "") {

                        $('#non_energised').text(parseInt(data[0].objgpdata[0].non_energised));
                    }
                    if (data[0].objgpdata[0].diesel_pumps != null && data[0].objgpdata[0].diesel_pumps != "") {

                        $('#diesel_pumps').text(parseInt(data[0].objgpdata[0].diesel_pumps));
                    }
                    if (data[0].objgpdata[0].centrifugal_pumps != null && data[0].objgpdata[0].centrifugal_pumps != "") {

                        $('#centrifugal_pumps').text(parseInt(data[0].objgpdata[0].centrifugal_pumps));
                    }
                    if (data[0].objgpdata[0].submersible_pumps != null && data[0].objgpdata[0].submersible_pumps != "") {

                        $('#submersible_pumps').text(parseInt(data[0].objgpdata[0].submersible_pumps));
                    }
                    if (data[0].objgpdata[0].solar_pumps != null && data[0].objgpdata[0].solar_pumps != "") {

                        $('#solar_pumps').text(parseInt(data[0].objgpdata[0].solar_pumps));
                    }
                    if (data[0].objgpdata[0].total_electric_pumps != null && data[0].objgpdata[0].total_electric_pumps != "") {

                        $('#total_electric_pumps').text(parseInt(data[0].objgpdata[0].total_electric_pumps));
                    }

                    if (data[0].objgpdata[0].total_water_lifting_devices != null && data[0].objgpdata[0].total_water_lifting_devices != "") {

                        $('#total_water_lifting_devices').text(parseInt(data[0].objgpdata[0].total_water_lifting_devices));
                    }
                    //Village Name section
                    if (data[0].objgpdata[0] != null && data[0].objgpdata[0] != "") {
                        var VillageName = data[0].objgpdata[0].village_name.split(',');
                        $('#villagethead').empty('');
                        var html = "";
                        var j = 3;
                        debugger;
                        for (var i = 0; i < VillageName.length; i++) {
                            if (0 == (j % 3)) {
                                html += '<tr><td style="text-align: left">'   + VillageName[i] + '</td>';

                            } else if (1 == (j % 3)) {
                                html += '<td style="text-align: left">' + VillageName[i] + '</td>';
                            }
                            else {
                                html += '<td style="text-align: left">' + VillageName[i] + '</td></tr>';

                            }
                            //if ((i + 1) % 2 == 0) {
                            j++;
                            //}

                        }
                        $('#village_name').append(html);
                    }

                    ///Livestock Section
                    debugger;
                    if (data[0].objlivestock.length != null && data[0].objlivestock.length != "") {
                        //var LivestockName = data[0].l["livestockname"].split(',');
                        //var LivestockValue = data[0].l["livestockvalue"].split(',');
                        $('#livestockthead').empty('');
                        var html = "";
                        var html1 = "";
                        var total_livestock = 0;
                        var j = 0;
                        for (var i = 0; i < data[0].objlivestock.length; i++) {
                            if (j == (i + 10) % 2) {
                                html = '<tr><td>' + data[0].objlivestock[i].livestock_name + '</td>';
                                html += '<td class="text_left_left"><span id="">' + data[0].objlivestock[i].livestock_value + '</span></td>';

                            } else {
                                html = '<td>' + data[0].objlivestock[i].livestock_name + '</td>';
                                html += '<td><span id="">' + data[0].objlivestock[i].livestock_value + '</span></td></tr>';

                            }
                            html1 += html;

                            total_livestock += parseInt(data[0].objlivestock[i].livestock_value);
                            LivestockCounter = parseFloat(i);
                        }

                        $('#livestockthead').append(html1);
                        $('#livestock_population').text(total_livestock);
                    }


                    ///Irrigation Surface Water Section
                    if (data[0].objsurfacewater.length != null && data[0].objsurfacewater.length != "") {
                        //var other_irrigation_sur_name = data[0].gp["other_irrigation_sur_name"].split(',');
                        //var other_irrigation_sur_numeric = data[0].gp["other_irrigation_sur_numeric"].split(',');

                        $('#trirrsurfother').empty('');
                        var html = "";
                        var html1 = "";
                        var total_surfacewater = 0;
                        var j = 0;

                        for (var i = 0; i < data[0].objsurfacewater.length; i++) {
                            if (j == (i + 10) % 2) {
                                html = '<tr><td>' + data[0].objsurfacewater[i].surface_water_name + '</td>';
                                html += '<td class="text_left_left"><span id="">' + parseFloat(data[0].objsurfacewater[i].surface_water_value).toFixed(4) + '</span></td>';

                            } else {
                                html = '<td>' + data[0].objsurfacewater[i].surface_water_name + '</td>';
                                html += '<td><span id="">' + parseFloat(data[0].objsurfacewater[i].surface_water_value).toFixed(4) + '</span></td></tr>';

                            }
                            total_surfacewater += parseFloat(data[0].objsurfacewater[i].surface_water_value);

                            html1 += html;
                            IrriSurfaceWaterCounter = i;
                        }
                        IrriSurfaceWaterCounter = i + 1;
                        $('#trirrsurfother').append(html1);
                        $('#totalSurfaceWater').text(parseFloat(total_surfacewater).toFixed(4));

                    }

                    ///Irrigation Ground Water Section
                    if (data[0].objgroundwater.length != null && data[0].objgroundwater.length != "") {
                        //var other_irrigation_gr_name = data[0].gp["other_irrigation_gr_name"].split(',');
                        //var other_irrigation_gr_numeric = data[0].gp["other_irrigation_gr_numeric"].split(',');

                        $('#irriggroundwatertr').empty('');
                        var html = "";
                        var html1 = "";
                        var total_groundwater = 0;
                        var j = 0;

                        for (var i = 0; i < data[0].objgroundwater.length; i++) {
                            if (j == (i + 10) % 2) {
                                html = '<tr><td>' + data[0].objgroundwater[i].ground_water_name + '</td>';
                                html += '<td class="text_left_left"><span id="">' + parseFloat(data[0].objgroundwater[i].ground_water_value).toFixed(4) + '</span></td>';

                            } else {
                                html = '<td>' + data[0].objgroundwater[i].ground_water_name + '</td>';
                                html += '<td><span id="">' + parseFloat(data[0].objgroundwater[i].ground_water_value).toFixed(4) + '</span></td></tr>';

                            }
                            total_groundwater += parseFloat(data[0].objgroundwater[i].ground_water_value);
                            html1 += html;
                            IrriGroundWaterCounter = parseInt(i);
                        }
                        $('#irriggroundwatertr').append(html1);
                        $('#totalGround').text(parseFloat(total_groundwater).toFixed(4));
                    }

                    ///Ground Water Section
                    debugger;
                    if (data[0].objexwells.length != null && data[0].objexwells.length != "") {
                        //var othergroundwatername = data[0].gp["other_well_name"].split(',');
                        //var othergroundwaternumeric = data[0].gp["other_well_existing"].split(',');
                        $('#trgroundwater').empty('');
                        var html = "";
                        var html1 = "";
                        var total_existing = 0;

                        for (var i = 0; i < data[0].objexwells.length; i++) {
                            if (j == (i + 10) % 2) {
                                html = '<tr><td>' + data[0].objexwells[i].existing_wells_name + '</td>';
                                html += '<td class="text_left_left"><span id="">' + parseFloat(data[0].objexwells[i].existing_wells_value) + '</span></td>';

                            } else {
                                html = '<td>' + data[0].objexwells[i].existing_wells_name + '</td>';
                                html += '<td><span id="">' + parseFloat(data[0].objexwells[i].existing_wells_value) + '</span></td></tr>';

                            }

                            html1 += html;
                            total_existing += parseFloat(data[0].objexwells[i].existing_wells_value);
                            GroundWaterCounter = i;
                        }
                        GroundWaterCounter = i + 1;
                        $('#totalWells').text(total_existing);
                        $('#trgroundwater').append(html1);
                    }


                    ///Water Efficient Section
                    debugger;
                    if (data[0].objwatereff.length != null && data[0].objwatereff.length != "") {
                        //var otherIrriName = data[0].gp["other_irrigation_name"].split(',');
                        //var otherIrrivalue = data[0].gp["other_irrigation"].split(',');
                        $('#watereffthead').empty('');
                        var html = "";
                        var html1 = "";
                        var total_watereff = 0;
                        for (var i = 0; i < data[0].objwatereff.length; i++) {
                            if (j == (i + 10) % 2) {
                                html = '<tr><td>' + data[0].objwatereff[i].water_eff_practices_name + '</td>';
                                html += '<td class="text_left_left"><span id="">' + parseFloat(data[0].objwatereff[i].water_eff_practices_value).toFixed(4) + '</span></td>';

                            } else {
                                html = '<td>' + data[0].objwatereff[i].water_eff_practices_name + '</td>';
                                html += '<td><span id="">' + parseFloat(data[0].objwatereff[i].water_eff_practices_value).toFixed(4) + '</span></td></tr>';

                            }

                            total_watereff += parseFloat(data[0].objwatereff[i].water_eff_practices_value);
                            html1 += html;
                            WaterEffCounter = i;

                        }
                        WaterEffCounter = i + 1;
                        $('#watereffthead').append(html1);
                        $('#total_water_efficient').text(parseFloat(total_watereff).toFixed(4));
                    }
                    debugger;
                    for (var i = 0; i < data[0].objupload.length; i++) {

                        if (data[0].objupload[i].villages_file != null && data[0].objupload[i].villages_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].villages_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source Total number of villages</u></a></label>';
                            $('#village_download').html(tr1);

                        }
                        if (data[0].objupload[i].demographic_file != null && data[0].objupload[i].demographic_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].demographic_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Demographic Profile</u></a></label>';
                            $('#population_download').html(tr1);

                        }
                        if (data[0].objupload[i].livestock_file != null && data[0].objupload[i].livestock_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].livestock_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Livestock Population</u></a></label>';
                            $('#livestock_download').html(tr1);

                        }
                        if (data[0].objupload[i].gparea_file != null && data[0].objupload[i].gparea_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].gparea_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of GP Area</u></a></label>';
                            $('#gparea_download').html(tr1);

                        }
                        if (data[0].objupload[i].netsown_area_file != null && data[0].objupload[i].netsown_area_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].netsown_area_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Net Sown Area</u></a></label>';
                            $('#sownarea_download').html(tr1);

                        }
                        if (data[0].objupload[i].area_cultivation_file != null && data[0].objupload[i].area_cultivation_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].area_cultivation_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Area Under Cultivation Kharif/Rabi/Summer</u></a></label>';
                            $('#irrigated_download').html(tr1);

                        }
                        if (data[0].objupload[i].suface_water_file != null && data[0].objupload[i].suface_water_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].suface_water_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Surface Water</u></a></label>';
                            $('#surface_download').html(tr1);

                        }
                        if (data[0].objupload[i].ground_water_file != null && data[0].objupload[i].ground_water_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].ground_water_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Ground Water</u></a></label>';
                            $('#ground_download').html(tr1);

                        }
                        if (data[0].objupload[i].existing_wells_file != null && data[0].objupload[i].existing_wells_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].existing_wells_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Existing Wells</u></a></label>';
                            $('#existing_download').html(tr1);

                        }
                        if (data[0].objupload[i].water_lifting_file != null && data[0].objupload[i].water_lifting_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].water_lifting_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Water Lifting Devices</u></a></label>';
                            $('#lifting_download').html(tr1);

                        }

                        if (data[0].objupload[i].water_efficient_file != null && data[0].objupload[i].water_efficient_file != "") {
                            var tr1 = '<label><a href="' + data[0].objupload[i].water_efficient_path + '" download="" target="_blank" ><i class="fa fa-file"></i><u> Download Data Source of Water Efficient Practices (Existing)</u></a></label>';
                            $('#efficient_download').html(tr1);

                        }
                    }

                } else {

                    $('#state_name').text('');
                    $('#district_name').text('');
                    $('#block_name').text('');
                    $('#gram_panchayat_name').text('');
                    $('#male_population').text('');
                    $('#female_population').text('');
                    $('#child_population').text('');
                    $('#tol_population').text('');
                    $('#no_of_apl').text('');
                    $('#no_of_bpl').text('');
                    $('#no_of_sc').text('');
                    $('#no_of_st').text('');
                    $('#no_of_obc').text('');
                    $('#general').text('');
                    $('#no_of_households').text('');
                    $('#no_of_cows').text('');
                    $('#no_of_bullocks').text('');
                    $('#no_of_buffalos').text('');
                    $('#no_of_sheeps_goats').text('');
                    $('#no_of_others_or_general').text('');
                    $('#livestock_population').text('');
                    $('#gp_area_in_ha').text('');
                    $('#forest_area_in_ha').text('');
                    $('#fallow_land_in_ha').text('');
                    $('#cultivable_land_in_ha').text('');
                    $('#net_sown_area').text('');
                    $('#net_irrigated_area').text('');
                    $('#irrigated_area_in_kharif').text('');
                    $('#irrigated_area_in_rabi').text('');
                    $('#irrigated_area_in_summer').text('');
                    $('#non_irrigated_area').text('');
                    $('#total_cropped_area').text('');
                    $('#irrigation_type_canal').text('');
                    $('#irrigation_type_tanks').text('');
                    $('#dug_wells').text('');
                    $('#dug_cum_bore_wells').text('');
                    $('#bore_well_or_tube_well').text('');
                    $('#dug_well_existing').text('');
                    $('#bore_well_existing').text('');
                    $('#tube_well_existing').text('');
                    $('#dug_cum_bore_wells_existing').text('');
                    $('#other_well_existing').text('');
                    $('#non_energised').text('');
                    $('#diesel_pump').text('');
                    $('#centrifugal_pump').text('');
                    $('#electric_pump').text('');
                    $('#submersible_pump').text('');
                    $('#solar_pump').text('');
                    $('#area_under_sprinkler_irrigation').text('');
                    $('#area_under_drip_irrigation').text('');
                    $('#other_irrigation').text('');
                    $('#total_water_efficient').text('');


                }
            }
        });

        sarpanch_getting();

    }

    function sarpanch_getting() {
        debugger;

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GPlevel/GPlevelreport_sarpanch_getting',
            data: '',
            // data: { 'state': State, 'dist': Dist, 'block': Block, 'gram': Gram },
            dataType: 'JSON',
            success: function (response) {
                debugger;
                var tr = "";
                $('#tbldata').html(tr);
                if (response.length != 0) {

                    for (var i = 0; i < response.length; i++) {

                        var gender = '';
                        if (response[i].gender != null && response[i].gender != '' && response[i].gender != 'NULL') {
                            gender = response[i].gender;
                        }

                        tr += '<tr><td> ' + (i + 1) + '</td><td>' + response[i].designation_name + '</td><td>' + response[i].name + '</td><td>' + gender + '</td><td>' + response[i].contact_details + '</td> </tr>';
                    }

                }
                if (tr == '') {
                    tr = '<tr colspan="5"><td colspan="5" style="text-align:center;">No Data</td></tr>';
                }
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                $('#tbldata').html(tr);
            }
        });
    }

</script>