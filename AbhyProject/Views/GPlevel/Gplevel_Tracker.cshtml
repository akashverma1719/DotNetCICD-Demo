<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/css/abhycss.css" rel="stylesheet" />
<link href="~/Content/wsp_formcss.css" rel="stylesheet" />

<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        /*opacity: 0.95;*/
        visibility: visible;
        /*background-color: #fff;*/
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .color_database {
        color: green !important;
    }

    tr.info th {
        background-color: #337ab7 !important;
        color: #fff;
        text-align: center;
    }

    .total_wsp_count > label {
        background-color: #f5ae91;
        color: #000;
        padding: 10px 10px 0px 10px;
    }
    /*body {
        background: #D1E8E2 !important;
    }*/

    .color_red_pdf {
        color: red;
        font-style: normal;
    }

    .Select_option > li:last-child {
        text-align: right !important;
        position: absolute;
        right: 0;
    }

    .check_mark_right > label {
        color: lightgreen;
    }

    .check_mark_wrong > label {
        color: red;
    }

    @@media screen and (max-width: 767px) {
        .Select_option > li:last-child {
            position: unset;
        }
    }
</style>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Gplevel_Tracker</title>

</head>
<body>

    <div class="loading-container">
        <div class="loader">
            <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
        </div>
    </div>
    <div class="clearfix">
        <header class="header hederImage">
            <div class="clearfix">
                <div class="clearfix">
                    <div class="col-lg-9">
                        <div class="header-top-info">
                            <ul class="clearfix">

                                <li>
                                    <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                                </li>

                                <li>
                                    <span>
                                        <a href="~/home/index" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                    </span>
                                    <span>
                                        <a href="javascript:;" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                            Ministry of Jal Shakti
                                        </a>
                                    </span>
                                    <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size: 14px;">Department of Water Resources,</a></span>
                                    <span style="text-align:center;">
                                        <a href="javascript:;" title="GOVERNMENT OF INDIA"
                                           style="text-transform:none; font-size:14px;">
                                            River Development & Ganga Rejuvenation
                                        </a>
                                    </span>

                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <ul class="imgHome clearfix">

                            <li>
                                <img src="~/Content/WspImages/user-silhouette.png" title="Username" />
                                <span style="color:#fff;">:@Session["UserName"]</span>
                            </li>
                            <li>

                                <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                            </li>

                        </ul>
                    </div>
                    <div class="col-md-12" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                        <ul class="imgHome clearfix">

                            <li>
                                <span><img src="~/Content/WspImages/WSP Home.png" /></span>
                                <label> WSP Tracker</label>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </header>
        <div class="clearfix padding-top-10">

            <div class="col-md-12  Select_option_div">
                <div style="text-align:center;color:red;"><label id="Error_123" style="text-align: center;"></label></div><br />
                <ul class="Select_option col-md-12 col-sm-12 text-center" id="Dropdowns_">

                    <li id="StateLabel">
                        <label id="lblstate">State:</label>
                        <span id="spnstate1">@Session["gstate"]</span>
                    </li>
                    <li id="StateDropdownLabel">

                        <select class="form-control" id="state" onchange="State_Dropdown_Function()">
                        </select>
                    </li>

                    <li id="DistLabel">
                        <i class="fas fa fa-angle-double-right"></i>
                        <label id="lbldistrict">District:</label>
                        <span id="spndistrict">@Session["gdist"]</span>
                    </li>

                    <li id="DistDropdownLabel">

                        <select class="form-control" id="dist" onchange="Dist_fun()">
                        </select>
                    </li>

                    @*<li id="BlockLabel">
                            <i class="fas fa fa-angle-double-right"></i>
                            <label>Block:</label>
                            <span>@Session["gblock"] </span>
                        </li>*@

                    <li id="BlockDropdownLabel">

                        <select class="form-control" id="block">
                        </select>
                    </li>
                    @*<li id="GramLabel">
                            <i class="fas fa fa-angle-double-right"></i>
                            <label>Gram panchayat:</label>
                            <span>@Session["ggram"]</span>
                        </li>*@

                    <li>
                        <a href="~/WSPHome/Gp_information" class="btn btn-primary">
                            Back To GP Modules
                        </a>
                    </li>

                </ul>

            </div>
        </div>
        <div class="container-fluid">

            <div class="col-md-12 col-sm-12">
                <div class="total_wsp_count">
                    <label>
                        Total Number of Water Security Plans Completed are : <label id="ttl_count"></label>
                    </label>
                    @*<div class="col-md-2 col-sm-3 pull-right">
                            <select class="form-control" id="status_com_not_com" onchange="status_com_not_com()">
                                <option value="0">Select Status</option>
                                <option value="Completed">Completed</option>
                                <option value="Not Completed">Not Completed</option>
                            </select>
                        </div>*@

                    <span class="pull-right">

                        <button class="btn btn-success form-control" onclick="saveAsExcel('TblData_abc_part1', 'wsp_tracker.xls')">  Download Excel</button>

                    </span>
                </div>
            </div>
            <div style="color:red;text-align:center;">
                <b> <span id="Error_alert"></span></b>
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 form-body" style="padding:10px 15px" id="data11">
                <div class="form-div background-border-Database">
                    <div class="table-responsive" style="overflow-y:auto">
                        <table class="Table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic" id="TblData_abc_part1">
                            <thead>
                                <tr class="info">
                                    <th class="text-center">S.No.</th>
                                    <th class="text-center">State Name</th>
                                    <th class="text-center">District Name</th>
                                    <th class="text-center">Block Name</th>
                                    <th class="text-center">GP Name</th>
                                    <th class="text-center">
                                        Gram Panchayat
                                    </th>
                                    <th class="text-center">Water Availability</th>
                                    <th class="text-center">Water Utilisation</th>
                                    <th class="text-center">Water Balance</th>
                                    <th class="text-center">Water Budget</th>
                                    <th class="text-center">
                                        WSP - Demand Side
                                    </th>
                                    <th class="text-center">
                                        WSP - Supply Side
                                    </th>
                                    <th class="text-center">Status</th>

                                </tr>
                            </thead>
                            <tbody id="Data_wspTracker">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


        </div>



        <div id="progress">
            <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
                <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                    <span class="progress-group-label" data-target="#music" data-toggle="tab"> WSP Tracker</span>
                    <div class="tri shadow"></div>
                    <div class="tri"></div>
                </li>
            </ul>
        </div>

    </div>
</body>
</html>
