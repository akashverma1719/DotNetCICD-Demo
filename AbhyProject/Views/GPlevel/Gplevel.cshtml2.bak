<script>

    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    var Jsondata = "";
    var Access_Auth = '';
    $(document).ready(function () {
    Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('input[type=text]').prop("disabled", true);
            $('.btn_disabled').prop("disabled", true);
            $('input[type=file]').prop("disabled", true)
        }

         Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
        $('#alert_waiting').hide();

        DropDownInfo();

    });


    function DropDownInfo() {
        debugger;

        if (Jsondata.length != 0) {

                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select StateName</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select GramPanchayat</option>';
                    $("#gram").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';
                        for (var i = 0; i < Jsondata.length; i++) {

                            if (!ddlst[Jsondata[i].state_name]) {
                                all_dists.push(Jsondata[i].state_name);
                                ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
                            else if (a > b) return 1;
                            return 0;
                        });
                        optionState = '<option value="0">Select StateName</option>';
                        for (var i = 0; i < DistArray.length; i++) {
                            if (DistArray[i] != null && DistArray[i] != "") {
                                optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                            }
                        }
                        $("#spnstate").html(optionState);
                    }

                }

                SessionInfo();
            }



    var n = 1;
    var ddd = 0;
    function adddonordetails() {

        $('#DUError').text("");
        if (ddd == 0) {
            ddd = 1;
            //$('#tdata1111 tbody tr').length;
            for (var a = 0; a < n; a++) {
                $('#tdata1111 tr:first').after('<tr id="abc_' + a + '"><tr class="trbordercolor"><td colspan="1">Category:</td><td colspan="4"><input type="text" class="form-control" /></td><td colspan="3">Total Households:</td><td colspan="6"><input type="text" class="form-control" /></td></tr><tr class="trbordercolor"><td colspan="1">SC (M):</td><td colspan="4"><input type="text" class="form-control" /></td><td colspan="3">SC (F):</td><td colspan="6"><input type="text" class="form-control" /></td></tr><tr class="trbordercolor"><td colspan="1">ST (M):</td><td colspan="4"><input type="text" class="form-control" /></td><td colspan="3">ST (F):</td><td colspan="6"><input type="text" class="form-control" /></td></tr>    <tr class="trbordercolor"><td colspan="1">OBC (M):</td><td colspan="4"><input type="text" class="form-control" /></td><td colspan="3">OBC (F):</td><td colspan="6"><input type="text" class="form-control" /></td></tr>   <tr class="trbordercolor"><td colspan="1">Minority (M):</td><td colspan="4"><input type="text" class="form-control" /></td><td colspan="3">Minority (F):</td><td colspan="6"><input type="text" class="form-control" /></td></tr><tr class="trbordercolor"><td colspan="1">Others (M):</td><td colspan="4"><input type="text" class="form-control" /></td><td colspan="3">Others (F):</td><td colspan="6"><input type="text" class="form-control" /></td></tr> <tr class="trbordercolor"><td><button type="button" class=" btn btn-primary" onclick="SaveDonarDetails(' + a + ')">Save</button></td><td><button type="button" class=" btn btn-danger" onclick="cancel();">Cancel</button></td></tr></tr>');
                //$('.donarclass').first().show();
            }
        }
        //a = a + 1;
        //DonarDetails();
    }
    function cancel() {

        $('.trbordercolor').remove();
    }
    var Data;
</script>
<script>
    function cancelonedit(i) {
        $('#hiderowonedit_' + i).show();
        $('#trn' + i).hide();
    }
    function editrow(i) {
        $('#DUError').text("");
        $('#trn' + i).show();
        $('#hiderowonedit_' + i).hide();
    }
</script>
