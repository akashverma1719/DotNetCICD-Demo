@{
    /**/

    /**/

    ViewBag.Title = "GPlevel";
    Layout = null;
}



<!-- favicon
============================================ -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<!-- jQuery library -->
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
@*<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>*@
<link href="~/Content/Website/css/font-awesome.min.css" rel="stylesheet" />
<link href="~/Content/wspView.css" rel="stylesheet" />

<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>

<script src="~/Content/css/baseline_gp_js.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>

<style>

    .database_trainer_row > h3 {
        background-color: #72a230;
        color: #fff;
        padding: 7px 15px;
        font-size: 18px;
        margin: 6px 0px;
    }

    table#TblData_b_part tr.info > th,
    table#TblData_c_part tr.info > th,
    table#TblData_d_part tr.info > th,
    table#TblData_e_part tr.info > th,
    table#TblData_abc_part1 tr.info > th,
    table#TblData_jj_part1 tr.info > th,
    table.GWL_deviation_table tr.info > th,
    table#TblData_g_part tr.info > th {
        background-color: #337ab7;
        color: #fff;
    }

    .E_table_header > h4 {
        color: #337ab7;
        padding: 10px 0px;
    }

    .alertshowingdiv {
        height: 25px;
    }

        .alertshowingdiv > label {
            color: red;
            font-size: 16px;
        }

    #breadcrumb {
        color: #0000ff;
        font-size: 15px;
        margin: 0;
        height: 15px;
        margin-bottom: 10px;
    }

        #breadcrumb a {
            color: #0000ff;
            text-decoration: underline;
        }

    ul#myTabs > li > a > span > img {
        height: 26px;
        width: 26px;
    }

    ul.ReRecharge_list > li > span {
        width: 70%;
    }

    ul#submenu1 > li > span {
        font-size: 17px;
    }

    ul.imgHome > li > a > span {
        font-size: 17px;
        text-decoration: none;
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

        ul.imgHome > li > a > span :hover {
            text-decoration: none;
        }

    ul.imgHome > li > a > label {
        font-size: 13px;
        text-decoration: underline;
        color: #fff;
        padding: 0px 0px 0px 5px;
        margin: 0;
        height: 15px;
    }

    ul.imgHome > li > label {
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

    ul.imgHome > li > a > span > img,
    ul.imgHome > li > span > img {
        width: 25px;
    }

    ul.imgHome > li > a > label {
        padding: 5px 0px 0px 0px;
    }

    .nav-justified {
        padding-bottom: 0em;
    }

    ul.imgHome > li > img,
    ul.imgHome > li > a > img {
        width: 25px !important;
    }

    .highcharts-background {
        /*width: 100% !important;*/
    }

    .highcharts-title {
        display: none;
    }

    span.marqueegwr {
        font-weight: 700;
        margin-top: 10px;
        /*font-family: raleway;*/
        color: #333;
        font-size: 1vw;
    }

    .modal-backdrop.in {
        z-index: 0px !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    ul.btnall > li {
        display: inline-block;
    }

    .backgroundtr {
        background-color: lightgray !important;
    }

        .backgroundtr:hover {
            background-color: #fff !important;
        }

    .backgroundtr1 {
        background-color: lightgoldenrodyellow !important;
    }

        .backgroundtr1:hover {
            background-color: #fff !important;
        }
</style>
<style>
    .under_list > li {
        list-style: none;
        padding: 5px;
        font-size: 15px;
        font-weight: 600;
    }

        .under_list > li > span > input {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

        .under_list > li > span > select {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

    .panel-title {
        font-size: 18px;
        font-weight: 700;
    }

    .ullistdiv_menu {
        margin: 10px 0px;
    }

    .firstformtable > thead > tr > td {
        padding: 5px;
        font-weight: 600;
    }

    * {
        box-sizing: border-box;
    }

    panel-group .panel {
        border-radius: 0;
        box-shadow: none;
        border-color: #EEEEEE;
    }

    .panel-default > .panel-heading {
        padding: 0;
        border-radius: 0;
        color: #212121;
        /*background-color: #FAFAFA;
            border-color: #EEEEEE;*/
    }




    .panel-title > a {
        display: block;
        padding: 7px;
        text-decoration: none;
    }

    .more-less {
        float: right;
        color: #212121;
    }

    .panel-default > .panel-heading + .panel-collapse > .panel-body {
        border-top-color: #EEEEEE;
    }



    .demo-footer {
        position: fixed;
        bottom: 0;
        width: 100%;
        padding: 15px;
        background-color: #212121;
        text-align: center;
    }

        .demo-footer > a {
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            color: #fff;
        }

    .panel-heading {
        text-align: left;
        font-size: 19PX;
    }

    .panel-body {
        text-align: left;
    }
</style>

<main>
    <header class="header hederImage">
        <div class="clearfix">
            <div class="clearfix">
                <div class="col-lg-9">
                    <div class="header-top-info">
                        <ul class="clearfix">
                            <li>
                                <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                            </li>

                            <li>
                                <span>
                                    <a target="_blank" href="http://mowr.gov.in/" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                </span>
                                <span>
                                    <a target="_blank" href="http://mowr.gov.in/" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                        Ministry of Jal Shakti
                                    </a>
                                </span>
                                <span class="li_eng responsive_go_eng"><a target="_blank" href="https://india.gov.in/" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size:14px;">Department of Water Resources,</a></span>
                                <span style="text-align:center;">
                                    <a target="_blank"
                                       href="http://mowr.gov.in/" title="GOVERNMENT OF INDIA"
                                       style="text-transform:none; font-size:14px;">
                                        River Development & Ganga Rejuvenation
                                    </a>
                                </span>

                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <ul class="imgHome clearfix">

                        <li>
                            <img src="~/Content/WspImages/user-silhouette.png" title="User" />
                            @if (Session["UserName"] != null)
                            {
                                <span style="color:#fff;">:@Session["UserName"].ToString()</span>
                            }

                        </li>
                        <li>
                            <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                        </li>

                    </ul>
                </div>
                <div class="col-md-8" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                    <ul class="imgHome clearfix">
                        <li>
                            <a href="~/WspNew/WSP_GWM_HOME">
                                <span>
                                    <img src="~/Content/WspImages/home-icon-silhouette.png" title="Home" />
                                </span>
                                <label>MIS Login <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>
                        <li>
                            <span><img src="~/Content/WspImages/home-icon-silhouette.png" title="Home" /></span>
                            <label>GPDCI</label>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <div class="row container-fluid">
        <div class="col-md-12 col-sm-12">
            <div class="selectdistshowoption" id="Select_dist_level">
                <label style="text-align:center;color:red;" id="Error_"></label>
                <ul class="Select_option selectbackhome">
                    <li id="StateLabel">
                        <label id="lblstate">State:</label>
                        <span id="spnstate1">@Session["gstate"]</span>
                    </li>
                    <li id="StateDropdownLabel">

                        <select class="form-control" id="spnstate" onchange="State_Dropdown_Function()"></select>
                    </li>

                    <li id="DistLabel">
                        <i class="fas fa fa-angle-double-right"></i>
                        <label id="lbldistrict">District:</label>
                        <span id="spndistrict">@Session["gdist"]</span>
                    </li>

                    <li id="DistDropdownLabel">

                        <select class="form-control" id="dist11" onchange="Dist_fun()"></select>
                    </li>

                    <li id="BlockLabel">
                        <i class="fas fa fa-angle-double-right"></i>
                        <label>Block:</label>
                        <span>@Session["gblock"] </span>
                    </li>

                    <li id="BlockDropdownLabel">

                        <select class="form-control" id="block1" onchange="Block_fun()"></select>
                    </li>
                    <li id="GramLabel">
                        <i class="fas fa fa-angle-double-right"></i>
                        <label>Gram panchayat:</label>
                        <span>@Session["ggram"]</span>
                    </li>

                    <li id="GramDropdownLabel">
                        <select class="form-control" id="gram" onchange="Gram_Fun()"></select>
                    </li>
                    <li id="DropdownSearch_btn">
                        <button class="btn btn-success" onclick="Dropdown_Search()">Search</button>
                    </li>


                </ul>

            </div>
        </div>

        <div class="col-md-12 text-center alertshowingdiv">
            <label id="alertrt_aa_part_data"></label>
        </div>
        <div class="col-md-12 text-center ">
            <button onclick="baselinedata_download()" class="btn btn-primary btn_disabled">Download</button>
            <a href="~/WSPHome/Gp_information" class="btn btn-success pull-right">
                Back To GP Modules
            </a>
            <button class="btn btn-success" onclick="Report_BTN()" style="float:right">
                Report
            </button>
        </div>

        <div class="col-md-12">
            <div class="b_part_div">
                <div class="panelbodyheading">
                    (A) Contact Details of GP Sarpanch & Panchayat Secretary
                </div>

                <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll;height:300px; font-size:12px;">
                    <table id="TblData_abc_part1" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                        <thead>
                            <tr class="info">
                                <th rowspan="3" class="text-center"><button class="updatenew btn btn-success btn_disabled" onclick="addrow_a_part()"> New </button></th>
                                <th class="text-center">S.No.</th>
                                <th class="text-center">Sarpanch</th>
                                <th class="text-center">Gender</th>
                                <th class="text-center">Sarpanch Contact Details</th>
                                <th class="text-center">Panchayat Secretary</th>
                                <th class="text-center">
                                    Contact Details
                                </th>
                            </tr>


                        </thead>
                        <tbody id="TblData_abc_part"></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    <div class="col-md-12 text-center ">
        <button onclick="sarpanchdetails_download1()" class="btn btn-primary btn_disabled">Download</button>
    </div>
    <div class="row" id="tablediv">
        <div class="tab-content">
            <!--2nd Water Budget Form-->
            <div role="tabpanel" class="tab-pane fade in active" id="WaterbudgetingformWBF">

                @*<div class="col-md-12 scrollform">*@
                <div class="col-md-12">
                    <!-- Accordion -->
                    <div class="" id="">

                        <div class="" style="padding:0px;overflow-x:scroll;">
                            <div class="panelbodyheading">
                                (B)	GP Profile: ( Latest Available Data)
                            </div>
                            <!--bodyof panel-->

                            <div class=" demo">
                                <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                                    <div class="row database_trainer_row ">
                                        <h3>
                                            1. Demographic Profile
                                        </h3>
                                    </div>

                                    <div class="panel panel-default">
                                        <div class="panel-heading " role="tab" id="headingOne">
                                            <h4 class="panel-title">
                                                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                                    <i class="more-less glyphicon glyphicon-plus"></i>
                                                    1.Population
                                                </a>
                                            </h4>
                                        </div>
                                        <div id="collapseOne" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingOne">
                                            <div class="panel-body">

                                                <table class="firstformtable">
                                                    <thead>

                                                        <tr>
                                                            <td>a.Male  : </td>
                                                            <td><span id=""><input type="text" onkeyup="TotalPapulation_fun()" onkeydown="TotalPapulation_fun()" class="form-control decimal" id="male_population" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>b.Female  :</td>
                                                            <td><span id=""><input type="text" onkeyup="TotalPapulation_fun()" onkeydown="TotalPapulation_fun()" class="form-control decimal" id="female_population" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr class="tableheadertr2">
                                                            <td>
                                                                c.Others <a href="javascript:;" data-toggle="tooltip" data-original-title="Transgender" title="Transgender">
                                                                    <span class="glyphicon fa fa-star" aria-hidden="true"></span>
                                                                </a>  :
                                                            </td>
                                                            <td><span id=""> <input type="text" onkeyup="TotalPapulation_fun()" onkeydown="TotalPapulation_fun()" class="form-control decimal" id="child_population" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr class="tableheadertr2">
                                                            <td>d.Total :</td>
                                                            <td><span id=""> <input type="text" class="form-control decimal" readonly id="tol_population" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2">
                                                                <label>Class/Status</label>
                                                            </td>
                                                        </tr>

                                                        <tr class="tableheadertr2">
                                                            <td>a. APL :</td>
                                                            <td><span id=""> <input type="text" class="form-control decimal" id="no_of_apl" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>b. BPL : </td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="no_of_bpl" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2">
                                                                <label> Categories</label>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>a. SC :</td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="no_of_sc" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr>
                                                            <td>b. ST :</td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="no_of_st" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr>
                                                            <td>c. OBC :</td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="no_of_obc" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr>
                                                            <td>d. General :</td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="general" name="general" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                    </thead>
                                                </table>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="panel panel-default">
                                        <div class="panel-heading" role="tab" id="headingTwo">
                                            <h4 class="panel-title">
                                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                                    <i class="more-less glyphicon glyphicon-plus"></i>
                                                    2.No. of Households
                                                </a>
                                            </h4>
                                        </div>
                                        <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
                                            <div class="panel-body">

                                                <table class="firstformtable">
                                                    <thead>
                                                        <tr class="tableheadertr2">
                                                            <td>a. No. of Households  :</td>
                                                            <td><span id=""> <input type="text" class="form-control decimal" id="no_of_households" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>

                                                    </thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="panel panel-default">
                                        <div class="panel-heading" role="tab" id="headingThree">
                                            <h4 class="panel-title">
                                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                                    <i class="more-less glyphicon glyphicon-plus"></i>
                                                    3.Livestock Population
                                                </a>
                                            </h4>
                                        </div>
                                        <div id="collapseThree" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingThree">
                                            <div class="panel-body">

                                                <table class="firstformtable">
                                                    <thead>

                                                        <tr class="tableheadertr2">
                                                            <td>a. Cows : </td>
                                                            <td><span id=""> <input type="text" onkeyup="Total_Livestock_fun()" onkeydown="Total_Livestock_fun()" class="form-control decimal" id="no_of_cows" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>b. Bullocks :</td>
                                                            <td><span id=""><input type="text" onkeyup="Total_Livestock_fun()" onkeydown="Total_Livestock_fun()" class="form-control decimal" id="no_of_bullocks" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>c. Buffalos :</td>
                                                            <td><span id=""><input type="text" onkeyup="Total_Livestock_fun()" onkeydown="Total_Livestock_fun()" class="form-control decimal" id="no_of_buffalos" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr>
                                                            <td>d. Sheeps & Goats:</td>
                                                            <td><span id=""><input type="text" onkeyup="Total_Livestock_fun()" onkeydown="Total_Livestock_fun()" class="form-control decimal" id="no_of_sheeps_goats" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr>
                                                            <td>e. Others (General) : </td>
                                                            <td><span id=""><input type="text" onkeyup="Total_Livestock_fun()" onkeydown="Total_Livestock_fun()" class="form-control decimal" id="no_of_others_or_general" placeholder="Enter the numeric value" /></span>  </td>
                                                        </tr>
                                                        <tr class="tableheadertr2">
                                                            <td>f. Total Livestock population : </td>
                                                            <td><span id=""> <input type="text" class="form-control decimal" readonly id="livestock_population" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                    </thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="row database_trainer_row ">
                                        <h3>
                                            2.Landuse and  Land Cover

                                        </h3>
                                    </div>
                                    <div class="panel panel-default">
                                        <div class="panel-heading" role="tab" id="headingfour">
                                            <h4 class="panel-title">
                                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapsefour" aria-expanded="false" aria-controls="collapseThree">
                                                    <i class="more-less glyphicon glyphicon-plus"></i>
                                                    1.GP area in ha.
                                                </a>
                                            </h4>
                                        </div>
                                        <div id="collapsefour" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingfour">
                                            <div class="panel-body">
                                                <table class="firstformtable">
                                                    <thead>
                                                        <tr class="tableheadertr2">
                                                            <td>a. GP area (ha) :</td>
                                                            <td><span id=""> <input type="text" class="form-control decimal" id="gp_area_in_ha" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>b. Forest area (ha) : </td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="forest_area_in_ha" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>
                                                        <tr>
                                                            <td>c. Fallow land (ha) : </td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="fallow_land_in_ha" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>

                                                        <tr>
                                                            <td>d. Cultivable land (ha) :</td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="cultivable_land_in_ha" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>

                                                        <tr>
                                                            <td>
                                                                f. Net sown area (ha) :
                                                            </td>
                                                            <td><span id=""><input type="text" class="form-control decimal" id="net_sown_area_ha" placeholder="Enter the numeric value" /></span></td>
                                                        </tr>

                                                    </thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="row database_trainer_row ">
                                        <h3>
                                            3.Irrigated area in Kharif/ Rabi/ summers
                                        </h3>
                                    </div>

                                    <div class="panel panel-default">
                                        <div class="panel-heading" role="tab" id="heading9">
                                            <h4 class="panel-title">
                                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapse9" aria-expanded="false" aria-controls="collapseThree">
                                                    <i class="more-less glyphicon glyphicon-plus"></i>
                                                    1.Area Under Cultivation (Area in ha)
                                                </a>
                                            </h4>
                                        </div>
                                        <div id="collapse9" class="panel-collapse collapse" role="tabpanel" aria-labelledby="heading9">
                                            <div class="panel-body">
