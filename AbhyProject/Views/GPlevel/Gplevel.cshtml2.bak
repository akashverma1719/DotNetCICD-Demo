<script type="text/javascript">

    $('li.leftbtnnext > button.btnprocess1').click(function () {


        $('ul#myTabsss.nav-pills.nav-justified > li').siblings('li').removeClass('active');
        var fine = $(this).closest("div[role=tabpanel]").attr("id");
        $('ul#myTabsss.nav-pills.nav-justified > li > a[data-target="#WaterbudgetingWB' + fine + '"]').parent('li').next("li").addClass('active');
        //$('ul#myTabs.nav-pills.nav-justified > li.active').next('li').addClass('active');
        //$('ul#myTabs.nav-pills.nav-justified > li.active').siblings('li').removeClass('active');
        $('#' + fine + '').tab('show');
        $('ul#myTabsss.nav-pills.nav-justified > li > a[data-target="#' + fine + '"]').parent('li').next('li').find('a').trigger('click');
    });

    $('button.btnprocess2').click(function () {


        $('ul#myTabsss.nav-pills.nav-justified > li').siblings('li').removeClass('active');
        var fine = $(this).closest("div[role=tabpanel]").attr("id");
        $('ul#myTabsss.nav-pills.nav-justified > li > a[data-target="#WatersecurityplanWSP' + fine + '"]').parent('li').next("li").addClass('active');
        //$('ul#myTabs.nav-pills.nav-justified > li.active').next('li').addClass('active');
        //$('ul#myTabs.nav-pills.nav-justified > li.active').siblings('li').removeClass('active');
        $('#' + fine + '').tab('show');
        $('ul#myTabsss.nav-pills.nav-justified > li > a[data-target="#' + fine + '"]').parent('li').next('li').find('a').trigger('click');
    });

    $("ul#myTabsss > li > a").on("show.bs.tab", function () {

        $('ul.tabs_menu > li:first-child').trigger('click');
    });
</script>
<script>
    var WSPFORMID = "";
    var statename = "";
    var distname = "";
    var blockname = "";
    var gramname = "";
    function HouseholdsDetails(s, d, b, g) {
        statename = s;
        distname = d;
        blockname = b;
        gramname = g;



        cancel();

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_total/HouseholdDetails',
            data: '{"state": "' + s + '","dist": "' + d + '","block": "' + b + '","gram": "' + g + '"}',
            dataType: 'JSON',
            success: function (data) {

                var tr = "";

                if (data != null) {
                    var count = data.length;
                    for (var i = 0; i < data.length; i++) {
                        tr +=
                            '<tr id="trn' + i + '" class="donarclass"  role="row" style="display:none">' +
                            '<tr class="trhideclass' + i + '" style="display:none" ><td colspan="2">Category</td><td colspan="5" class="tdborder"><input type="text" id="Category' + i + '" value="' + data[i].category + '" /></td>' +
                            '<td colspan="2">Total_Households</td><td colspan="5" class="tdborder"><input type="text" id="Total_Households' + i + '" value="' + data[i].tol_households + '" /></td></tr>' +
                            '<tr class="trhideclass' + i + '" style="display:none"><td colspan="2">SC(M)</td><td colspan="5" class="tdborder"><input type="text" id="sc_m' + i + '" value="' + data[i].sc_m + '" /></td>' +
                            '<td colspan="2">SC(F)</td><td colspan="5" class="tdborder"><input type="text" id="sc_f' + i + '" value="' + data[i].sc_f + '" /></td></tr>' +
                            '<tr class="trhideclass' + i + '" style="display:none"><td colspan="2">ST(M)</td><td colspan="5" class="tdborder"><input type="text" id="st_m' + i + '" value="' + data[i].st_m + '" /></td>' +
                            '<td colspan="2">ST(F)</td><td colspan="5" class="tdborder"><input type="text" id="st_f' + i + '" value="' + data[i].st_f + '" /></td></tr>' +
                            '<tr class="trhideclass' + i + '" style="display:none"><td colspan="2">OBC(M)</td><td colspan="5" class="tdborder"><input type="text" id="obc_m' + i + '" value="' + data[i].obc_m + '" /></td>' +
                            '<td colspan="2">OBC(F)</td><td colspan="5" class="tdborder"><input type="text" id="obc_f' + i + '" value="' + data[i].obc_f + '" /></td></tr>' +
                            '<tr class="trhideclass' + i + '" style="display:none"><td colspan="2">Minority(M)</td><td colspan="5" class="tdborder"><input type="text" id="minority_m' + i + '" value="' + data[i].minority_m + '" /></td>' +
                            '<td colspan="2">Minority(F)</td><td colspan="5" class="tdborder"><input type="text" id="minority_f' + i + '" value="' + data[i].minority_f + '" /></td></tr>' +
                            '<tr class="trhideclass' + i + '" style="display:none"><td colspan="2">Others(M)</td><td colspan="5" class="tdborder"><input type="text" id="others_m' + i + '" value="' + data[i].others_m + '" /></td>' +
                            '<td colspan="2">Others(F)</td><td colspan="5" class="tdborder"><input type="text" id="others_f' + i + '" value="' + data[i].others_f + '" /></td></tr>' +
                            '<tr class="trhideclass' + i + '" style="display:none"><td><button type="button" class="btn btn-success" onclick="update_detail(' + data[i].hlid + ',' + i + ')">Update</button>' + '</td><td><button type="button" class="btn btn-danger" onclick="cancelonedit(' + i + ');">Cancel</button>' + '</td>' +
                            '</tr>' + '</tr>' +
                            '<tr role="row"  id="hiderowonedit_' + i + '"><td><button type="submit" class="btn btn-primary" disabled onclick=editrow(' + i + ');> Edit </button></td>' + '<td><button type="button" disabled  class="btn btn-danger" onclick = "delete_detail(' + data[i].hlid + ',' + i + ')" > Delete</button ></td> ' + ' <td > ' + data[i].category + '</td> <td>' + data[i].tol_households + '</td> <td>' + data[i].sc_m + '</td> <td>' + data[i].sc_f + '</td><td>' + data[i].st_m + '</td> <td>' + data[i].st_f + '</td> <td>' + data[i].obc_m + '</td> <td>' + data[i].obc_f + '</td> <td>' + data[i].minority_m + '</td> <td>' + data[i].minority_f + '</td> <td>' + data[i].others_m + '</td> <td>' + data[i].others_f + '</td></tr>'
                    }

                }
                else {
                    tr += '<tr  role="row"><td colspan="2">No Data</td></tr>';
                }

                $("#tblHouseholdsDetails").html(tr);


            }
        });
    }
    function cancel() {
        ddd = 0;
        $('.trbordercolor').remove();
    }
    function SaveHDetails() {
        ddd = 0;
        var obj = {};
        obj.category = $("#gpicat").val();
        obj.tol_households = $("#gpith").val();
        obj.sc_m = $("#gpiscm").val();
        obj.sc_f = $("#gpiscf").val();
        obj.st_m = $("#gpistm").val();
        obj.st_f = $("#gpistf").val();
        obj.obc_m = $("#gpiobcm").val();
        obj.obc_f = $("#gpiobcf").val();
        obj.minority_m = $("#minorm").val();
        obj.minority_f = $("#minorf").val();
        obj.others_m = $("#gpiothersm").val();
        obj.others_f = $("#gpiothersf").val();

        obj.state_name = statename;
        obj.district_name = distname;
        obj.block = blockname;
        obj.gname = gramname;

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_total/SaveHouseHolds",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                HouseholdsDetails();
                document.getElementById('AlertError').innerHTML = response;
            }
        });
    }
    function delete_detail(IDD, i) {
        $('.trhideclass' + i).hide();
        var obj = {};
        obj.hlid = IDD;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WSP/DeleteHouseholds",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                document.getElementById('AlertError').innerHTML = response;
                HouseholdsDetails();
            }
        });
    }
    function update_detail(Id, i) {

        var obj = {};
        obj.category = $('#Category' + i).val();
        obj.tol_households = $('#Total_Households' + i).val();
        obj.sc_m = $('#sc_m' + i).val();
        obj.sc_f = $('#sc_f' + i).val();
        obj.st_m = $('#st_m' + i).val();
        obj.st_f = $('#st_f' + i).val();
        obj.obc_m = $('#obc_m' + i).val();
        obj.obc_f = $('#obc_f' + i).val();
        obj.minority_m = $('#minority_m' + i).val();
        obj.minority_f = $('#minority_f' + i).val();
        obj.others_m = $('#others_m' + i).val();
        obj.others_f = $('#others_f' + i).val();
        obj.hlid = Id;
        //obj.ttkid = DID;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/WSP/UpdateHouseholds",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                document.getElementById('AlertError').innerHTML = response;
                $('.trhideclass' + i).hide();
                HouseholdsDetails();
            }
        });


    }
    function cancelonedit(i) {
        $('.trhideclass' + i).hide();
        $('#hiderowonedit_' + i).show();
        $('#trn' + i).hide();
    }
    function editrow(i) {
        $('#DUError').text("");
        $('#trn' + i).show();
        $('#hiderowonedit_' + i).hide();
        $('.trhideclass' + i).show();


    }

    $('#resetdata').click(function () {
        if (confirm("You want to Delete the data ?")) {
            /*Clear all input type="text" box*/
            $('#resetinfo input[type="text"]').val('');
            /*Clear textarea using id */
            $('#resetinfo #txtAddress').val('');
            document.getElementById('AlertError').innerHTML = "Deleted Successfully";
        }
    });

    //   $("#reset").bind("click", function () {
    //    $("input[type=text], textarea").val("");
    //    document.getElementById('AlertError').innerHTML = "Deleted Successfully";
    //});

</script>
<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
    function toggleIcon(e) {
        $(e.target)
            .prev('.panel-heading')
            .find(".more-less")
            .toggleClass('glyphicon-plus glyphicon-minus');
    }
    $('.panel-group').on('hidden.bs.collapse', toggleIcon);
    $('.panel-group').on('shown.bs.collapse', toggleIcon);


    function Report_BTN() {
        var xx = 0;
        if (State != "0" && State != "") {
            if (Dist != "0" && Dist != "") {
                if (Block != "0" && Block != "") {
                    if (Gram != "0" && Gram != "") {

                    } else {
                        xx = 1;
                        alert("Please Select Gram Panchayat");
                    }
                } else {
                    xx = 1;
                    alert("Please Select Block");
                }
            } else {
                xx = 1;
                alert("Please Select District");
            }
        } else {
            xx = 1;
            alert("Please Select StateName");
        }



        if (xx == 0) {
            window.location = "/GPlevel/GPlevel_Report";
        }
    }
</script>
