<div class="allcontent">
    <div class="row">

        <div class="col-md-7 mis_module_section pb-4">

            <div class="card border-0 mis_module_section_card mt-1 blockBoxWhite mt-4">
                <div class="card-body" style=" min-height: 138px;">
                    <div class="row align-items-center">
                        <div class="col-md-2 iconImg">
                            <img src="~/DashboardStyles/images/grampanchayat_icon.png" />
                        </div>
                        <div class="col-md-8">
                            <h4 class="text-info pb-3">Gram Panchayat Modules</h4>
                            <p class="m-0 text-secondary">
                                This module offers features and forms to capture micro-level data at the Gram Panchayat level through various in-built modules including preparation of Water Security Plans.

                            </p>
                            <p class="m-0 pt-1 text-secondary">(User rights- NPMU, SPMU, DPMU & GP)</p>
                        </div>
                        <div class="sideImg">
                            <img src="~/DashboardStyles/images/grampanchayat_module.png" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 mis_module_section_card mt-1 blockBoxWhite">
                <div class="card-body" style=" min-height: 138px;">
                    <div class="row align-items-center">
                        <div class="col-md-2 iconImg">
                            <img src="~/DashboardStyles/images/Monitoring.png" />
                        </div>
                        <div class="col-md-8">
                            <h4 class="text-info pb-3">
                                Monitoring And Evaluation Modules
                            </h4>
                            <p class="m-0 text-secondary">
                                This module captures all details related to physical and financial monitoring of the scheme at National, State and District level including data submission for the Disbursement Linked Indicators (DLIs)



                            </p>
                            <p class="m-0 pt-1 text-secondary">(User rights- NPMU, SPMU & DPMU)</p>
                        </div>
                        <div class="sideImg">
                            <img src="~/DashboardStyles/images/monitoring_module.png" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-0 mis_module_section_card mt-1 blockBoxWhite">
                <div class="card-body" style=" min-height: 138px;">
                    <div class="row align-items-center">
                        <div class="col-md-2 iconImg">
                            <img src="~/DashboardStyles/images/training.png" />
                        </div>
                        <div class="col-md-8">
                            <h4 class="text-info pb-3">
                                Training And Workshop
                            </h4>
                            <p class="m-0 text-secondary">
                                This module showcases state wise Training and Workshop events, registration, feedback forms and resources. Trainings at the national, state, district, block, and GP levels can be registered and viewed for analysis.




                            </p>
                            <p class="m-0 pt-1 text-secondary">(User rights- NPMU, SPMU, DPMU & GP)</p>
                        </div>
                        <div class="sideImg">
                            <img src="~/DashboardStyles/images/workshop_module.png" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-0 mis_module_section_card mt-1 blockBoxWhite">
                <div class="card-body" style=" min-height: 138px;">
                    <div class="row align-items-center">
                        <div class="col-md-2 iconImg">
                            <img src="~/DashboardStyles/images/gis_portal.png" />
                        </div>
                        <div class="col-md-8">
                            <h4 class="text-info pb-3">
                                GIS Web Portal
                            </h4>
                            <p class="m-0 text-secondary">
                                The portal serves as a repository of geospatial data related to groundwater resources, providing stakeholders with valuable information, maps, and analysis tools to take informed decisions regarding groundwater management and planning.



                            </p>
                            <p class="m-0 pt-1 text-secondary"> (User rights- NPMU, SPMU, DPMU & GP)</p>
                        </div>
                        <div class="sideImg">
                            <img src="~/DashboardStyles/images/gis_module.png" />
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <div class="col-md-5 border p-0 mis_login_register_section">
