@*<script src="~/Content/JS_Files/WSP_GWM_HOME.js"></script>*@
<script>
    $(function () {

        $("#logoutbtn").click(function () {
            let text = "Are you sure you want to force logout from previous login?";
            if (confirm(text) == true) {
                logout_btn();
            } else {
                console.log("You rejected.");
                return false;
            }
        });
        $("#loginbtn").click(function () {
            let text = "Are you sure you want to force logout from previous and login here?";
            if (confirm(text) == true) {
                login_btn();
            } else {
                console.log("You rejected.");
                return false;
            }
        });
    });

    function logout_btn() {
        $.get("@Url.Action("LogOutForceP", "WspNew")",
            function (data) {
                window.location = "/WspNew/WSP_GWM_HOME_New";
                //if (data == 0) {
                //    console.log("not success");  // Log success message to console
                //}
                //    else {
                //    console.log("success");  // Log success message to console
                //    }
            });
    }

    function login_btn() {
        $.get("@Url.Action("LogInForceP", "WspNew")",
            function (data) {
               window.location = "/WspNew/WSP_GRM_HOMEF";
            });
    }
</script>
