
@{
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}

<html lang="en">
<head>
    <title>Bootstrap Example</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        .confirm-alert-box {
            background-color: #f6f6f6b3;
            border-color: #fcb9b9;
        }
    </style>
</head>
<body>

    <div class="d-flex align-items-center justify-content-center w-100" style="height:50vh;margin:40px 0px;">
        <div class="row d-flex align-items-center justify-content-center w-100 m-0">
            <div class="col-md-6">
                <div class="card alert confirm-alert-box">
                    <div class="card-body">
                        <h4 class="modal-title text-center" style="color:#c68631">
                            <i class="fa fa-exclamation-triangle" aria-hidden="true" style="font-size: 27px; padding-right: 13px; color: #fdb729;"></i>
                            Your account has been logged in from another device/computer
                        </h4>
                        <h3 style="font-size: 15px; color: red; margin: 25px 0px;text-align:center;" "><b>Caution:</b> If you press " Yes" you will be auto- logged out from the previous device.</h3>
                        <p style="font-weight:500;text-align:center;">Do you want to login?</p>
                        <div class="d-flex align-items-center justify-content-center">
                            <a href="/WspNew/WSP_GRM_HOME_Login" id="Login" class="btn btn-primary mr-2">Yes</a>
                            <a href="/WspNew/WSP_GWM_HOME" id="cancel" class="btn btn-danger">No</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Modal -->
        @*<div class="modal-dialog modal-dialog-centered" id="myModal" role="dialog">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
