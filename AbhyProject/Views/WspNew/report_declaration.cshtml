        </div>
    </div>
</body>
</html>
<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {
        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,
            filename: 'Declaration of source of data in WSP.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }
        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $(".highcharts-credits").css("display", "none");
        $(".error_div").css("display", "none");
        $(".alertid").css("display", "none");
        
        
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
            $(".error_div").css("display", "block");
            $(".alertid").css("display", "block");
        }, 2000);
    }
</script>

<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demoaval2").innerHTML = hours + ":" + minutes + " " + suffix;

    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demoaval").innerHTML = today;
</script>
<script type="text/javascript">
    var Access_Auth = "";
    $(document).ready(function () {
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
    State = '@Session["gstate"]';
         Dist ='@Session["gdist"]';
     Block ='@Session["gblock"]';
        Gram ='@Session["ggram"]';
        $('#state_name').val(State);
        $('#district_name').val(Dist);
        $('#block_name').val(Block);
        $('#gpname').val(Gram);
        report_declaration_details();

    });




    function SaveSurfaceWater_info() {
        

        var i = 0;
        var gpname = $('#gpname').val();
        var block_area = $('#block_area').val();
        var gp_area = $('#gp_area').val();
        var annual_rainfall = $('#annual_rainfall').val();

        var evapo = $('#evapo').val();
        var surface_water_bodies = $('#surface_water_bodies').val();
        var human_population = $('#human_population').val();
        var livestock_population = $('#livestock_population').val();

        var from_surface_water = $('#from_surface_water').val();
        var from_ground_water = $('#from_ground_water').val();
        var water_req_various_crops = $('#water_req_various_crops').val();
        if (gpname == "") {
            i = 1;
            alert('Please Enter Gram anchayat');
        }
        else if (block_area == "") {
            i = 1;
            alert('Please Enter Block Area');
        } else if (gp_area == "") {
            i = 1;
            alert('Please Enter gp_area');
        } else if (annual_rainfall == "") {
            i = 1;
            alert('Please Enter annual_rainfall');
        } else if (evapo == "") {
            i = 1;
            alert('Please Enter evapo');
        } else if (surface_water_bodies == "") {
            i = 1;
            alert('Please Enter surface_water_bodies');
        } else if (human_population == "") {
            i = 1;
            alert('Please Enter human_population');
        } else if (livestock_population == "") {
            i = 1;
            alert('Please Enter livestock_population');
        } else if (from_surface_water == "") {
            i = 1;
            alert('Please Enter from_surface_water');
        } else if (from_ground_water == "") {
            i = 1;
            alert('Please Enter from_ground_water');
        } else if (water_req_various_crops == "") {
            i = 1;
            alert('Please Enter water_req_various_crops');
        }


        if (i == 0) {

            
            $.ajax({
                url: "/WspNew/report_declaration__InsertData",
                type: "POST",
                data: function () {
                    var data = new FormData();


                    data.append("gpname", gpname);
                    data.append("block_area", block_area);
                    data.append("gp_area", gp_area);
                    data.append("annual_rainfall", annual_rainfall);
                    data.append("evapo", evapo);
                    data.append("surface_water_bodies", surface_water_bodies);
                    data.append("human_population", human_population);
                    data.append("livestock_population", livestock_population);

                    data.append("from_surface_water", from_surface_water);
                    data.append("from_ground_water", from_ground_water);
                    //data.append("total_gw_racharge", total_gw_racharge);
                    data.append("water_req_various_crops", water_req_various_crops);
                    //new columns

                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response == "Logout") {
                          window.location = "/Home/LogOut";
                    }
                    alert(response);
                    //$('#ERRor1').text(response);
                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                }

            });

            report_declaration_details();
        }
    }


    function report_declaration_details()
    {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            //url: '/Wsp_new/WaterAvailabiltyInfo_Details',
            url: '/WspNew/report_declaration_details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    window.location = "/WspNew/WspWaterAvailability";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (response.length != 0) {
                    
                    if (response[0].block_area != null && response[0].block_area != "") {
                        $('#block_area').val(response[0].block_area);
                    }
                    if (response[0].gp_area != null && response[0].gp_area != "") {
                        $('#gp_area').val(response[0].gp_area);
                    }
                    if (response[0].annual_rainfall != null && response[0].annual_rainfall != "") {
                        $('#annual_rainfall').val(response[0].annual_rainfall);
                    }

                    if (response[0].evapo != null && response[0].evapo != "") {
                        $('#evapo').val(response[0].evapo);
                    }
                    if (response[0].surface_water_bodies != null && response[0].surface_water_bodies != "") {
                        $('#surface_water_bodies').val(response[0].surface_water_bodies);
                    }

                    if (response[0].human_population != null && response[0].human_population != "") {
                        $('#human_population').val(response[0].human_population);
                    }

                    if (response[0].livestock_population != null && response[0].livestock_population != "") {

                        $('#livestock_population').val(response[0].livestock_population);
                    }

                    if (response[0].from_surface_water != null && response[0].from_surface_water != "") {

                        $('#from_surface_water').val(response[0].from_surface_water);
                    }

                    if (response[0].from_ground_water != null && response[0].from_ground_water != "") {

                        $('#from_ground_water').val(response[0].from_ground_water);
                    }

                    if (response[0].water_req_various_crops != null && response[0].water_req_various_crops != "") {

                        $('#water_req_various_crops').val(response[0].water_req_various_crops);
                    }


                    else {
                        $('#block_area').val("");
                        $('#gp_area').val("");
                        $('#annual_rainfall').val("");

                        $('#evapo').val("");
                        $('#surface_water_bodies').val("");
                        $('#human_population').val("");
                        $('#livestock_population').val("");

                        $('#from_surface_water').val("");
                        $('#from_ground_water').val("");
                        $('#water_req_various_crops').val("");
                    }





                }
            }
        });

    }
</script>