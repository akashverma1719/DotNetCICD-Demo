    var DPMU_Level_Count = 0;
    function Save_Full_Info() {
        DPMU_Level_Count = 1;
        Domestic_Info();
    }

    function DPMU_Submission() {

        var verification_val = 0;
        var lfckv = document.getElementById("WspTacker_Verification_CheckBox").checked;

        if (lfckv == true) {
            verification_val = 1;
            DPMU_Level_Count += 1;
        }
        else {
            verification_val = 0;
            alert("Please Check The data entered has been checked and verified by DPMU");
        }

        var obj = {};
        obj.longitude = long;
        obj.latitude = lat;
        obj.domestic_people_water_requirement = $('#domestic_people_water_requirement').val();
        obj.domestic_livestock_water_requirement = $('#domestic_livestock_water_requirement').val();
        obj.domestic_buffalo_water_requirement = $('#domestic_buffalo_water_requirement').val();
        obj.domestic_bullock_water_requirement = $('#domestic_bullock_water_requirement').val();
        obj.domestic_cow_water_requirement = $('#domestic_cow_water_requirement').val();
        obj.domestic_sheeps_water_requirement = $('#domestic_sheeps_water_requirement').val();
        obj.domestic_goat_water_requirement = $('#domestic_goat_water_requirement').val();
        obj.domestic_donkey_water_requirement = $('#domestic_donkey_water_requirement').val();
        obj.domestic_camel_water_requirement = $('#domestic_camel_water_requirement').val();
        obj.domestic_people_count = $('#domestic_people_count').val();
        obj.domestic_livestock_count = $('#domestic_livestock_count').val();
        obj.domestic_buffalo_count = $('#domestic_buffalo_count').val();
        obj.domestic_bullocks_count = $('#domestic_bullocks_count').val();
        obj.domestic_cow_count = $('#domestic_cow_count').val();
        obj.domestic_sheeps_count = $('#domestic_sheeps_count').val();
        obj.domestic_goat_count = $('#domestic_goat_count').val();
        obj.domestic_donkey_count = $('#domestic_donkey_count').val();
        obj.domestic_camel_count = $('#domestic_camel_count').val();
        obj.domestic_people_water_req = $('#domestic_people_water_req').text();
        obj.domestic_buffalo_water_req = $('#domestic_buffalo_water_req').text();
        obj.domestic_bullock_water_req = $('#domestic_bullock_water_req').text();
        obj.domestic_cow_water_req = $('#domestic_cow_water_req').text();
        obj.domestic_sheeps_water_req = $('#domestic_sheeps_water_req').text();
        obj.domestic_goat_water_req = $('#domestic_goat_water_req').text();
        obj.domestic_donkey_water_req = $('#domestic_donkey_water_req').text();
        obj.domestic_camel_water_req = $('#domestic_camel_water_req').text();
        obj.domestic_livestock_water_req = $('#domestic_livestock_water_req').text();
        obj.domestic_annual_req_people = $('#domestic_annual_req_people').text();
        obj.domestic_annual_req_livestock = $('#domestic_annual_req_livestock').text();
        obj.domestic_demand_userentry_groundwater_human = $('#domestic_demand_userentry_groundwater_human').val();
        obj.domestic_demand_ground_water = $('#domestic_demand_ground_water').text();
        obj.domestic_demand_userentry_surfacewater_human = $('#domestic_demand_userentry_surfacewater_human').val();
        obj.domestic_demand_surface_water = $('#domestic_demand_surface_water').text();
        obj.domestic_demand_userentry_groundwater_livestock = $('#domestic_demand_userentry_groundwater_livestock').val();
        obj.domestic_demand_ground_water_livestock = $('#domestic_demand_ground_water_livestock').text();
        obj.domestic_demand_userentry_surfacewater_livestock = $('#domestic_demand_userentry_surfacewater_livestock').val();
        obj.domestic_demand_surface_water_livestock = $('#domestic_demand_surface_water_livestock').text();
