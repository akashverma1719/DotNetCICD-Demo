        obj.domestic_demand_surface_water_total_value = $('#domestic_demand_surface_water_total_value').text();

        if (verification_val == 1 && DPMU_Level_Count == 2) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Wsp_new/Water_Domestic_InsertData",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert("Verified Successfully");
                    if (response != "Successfully Saved") {
                        window.location = "/Error/DefaultError";
                    }

                }
            });

        }
        else {
            DPMU_Level_Count = 1;
            Domestic_Info();
        }

    }
