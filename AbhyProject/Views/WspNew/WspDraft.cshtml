<style>
    .nav-tabs > li {
        float: none;
    }

    #progress-ui {
        text-align: center !important;
    }

    h3 {
        font-weight: 600;
    }

    @@media (min-width: 992px) {
        .Sider_column {
            width: 23%;
        }
    }

    @@media (min-width: 992px) {
        .hole_column {
            width: 77%;
        }
    }

    @@media (max-width:1491px) and (min-width: 990px) {
        .imgdiv2 > img {
            width: 100% !important;
            height: 300px !important;
        }
    }

    @@media (max-width:1364px) and (min-width:990px) {
        .imgdiv2 > img {
            width: 100% !important;
            height: 290px !important;
        }
    }

    @@media (max-width: 1200px) and (min-width: 990px) {
        .imgdiv2 > img {
            width: 100% !important;
            height: 200px !important;
        }
    }

    @@media (max-width: 990px) and (min-width: 360px) {
        .imgdiv2 > img {
            width: 300px !important;
            height: 200px !important;
            text-align: center;
        }
    }

    table > tbody > tr > td > span {
        float: right;
    }

    .Sider_column > ul.sider_images_sider[data-target] {
        display: none;
    }

    .Sider_column > ul.sider_images_sider:after {
        position: absolute;
        content: "";
        /*height: 10%;*/
        width: 1px;
        display: block;
        background-color: black;
        right: -1px;
    }

    .Sider_column > ul.sider_images_sider[data-target]:after {
        position: absolute;
        content: "";
        height: 0%;
        width: 1px;
        display: block;
        background-color: black;
        right: -1px;
    }

    .Sider_column > ul.sider_images_sider[data-target].active {
        display: block;
    }



    .btnprocess {
        padding: 5px 30px;
        border-radius: 30px;
        font-size: 15px;
        font-weight: 600;
        /*background-color: #fff !important;*/
        border: none;
        /* border: none; */
        background-color: #03A9F4 !important;
        color: #fff !important;
    }

    .btnprocess1 {
        padding: 5px 30px;
        border-radius: 30px;
        font-size: 15px;
        font-weight: 600;
        /*background-color: #fff !important;*/
        border: none;
        /* border: none; */
        background-color: #03A9F4 !important;
        color: #fff !important;
    }

    ul[id$="_menu"] {
        padding: 0;
        margin: 0;
    }

    .Side_Image {
        padding: 0;
        margin: auto;
    }

    ul[id$="_menu"] > li {
        display: inline-flex;
        position: relative;
        width: 100%;
        margin-bottom: 15px;
        justify-content: center;
    }

        ul[id$="_menu"] > li > a {
            display: block;
            text-align: center;
        }

    [id^="menu-"][class*="-info"] {
        font-size: 21px;
    }

        [id^="menu-"][class*="-info"] > .clearfix {
            padding: 15px 0;
        }

            [id^="menu-"][class*="-info"] > .clearfix:last-child {
                text-align: center;
            }



    ul[id$="_menu"] > li > a > span {
        border-radius: 50%;
        border: 1px solid #333;
        display: inline-block;
        padding: 10px;
    }

        ul[id$="_menu"] > li > a > span > img {
            height: 40px;
            width: 40px;
            margin: auto;
        }

    ul[id$="_menu"] > li > a > label {
        /*color: #7c3c0b;*/
        color: #000;
        font-size: 12px;
        display: block;
        border: 2px solid transparent;
    }

    ul[id$="_menu"] > li > a:hover > label,
    ul[id$="_menu"] > li > a:focus > label,
    ul[id$="_menu"] > li.active > a > label {
        border-color: #337ab7;
        background-color: #fde0ca;
    }

    #myTabs.nav-pills > li.active > a:before {
        content: "";
        /*height: 2px;*/
        position: absolute;
        bottom: 6px;
        display: inline-block;
        width: 98%;
        z-index: 99;
        left: 2%;
        background-color: #fff;
    }

    ul[id$="_menu"] > li > a:active,
    ul[id$="_menu"] > li > a:focus,
    ul[id$="_menu"] > li > a:hover {
        text-decoration: none;
    }

    ul[id$="_menu"] > li.active > a > span {
        border-width: 2px;
        border-color: #337ab7;
    }

    ul[id$="_menu"] > li.active:after {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #337ab7;
        content: " ";
        position: absolute;
        bottom: -10px;
        margin-left: -15px;
        left: 50%;
    }

    .form-control {
        border: none;
        box-shadow: none;
        border-bottom: 1px solid;
        border-radius: 0;
    }


    a:hover {
        color: red;
        border-bottom: 2px;
    }

    a:active {
        color: green;
    }

    h2 {
        text-align: center;
        font-weight: 600;
    }
</style>
<style>
    [id^="menu-"][class*="-info"] {
        display: none;
    }

        [id^="menu-"][class*="-info"].active {
            display: block;
        }

    @@media(min-width: 992px) {
        ul[id$="_menu"] > li {
            /*width: calc(100%/7);
            float: left;*/
