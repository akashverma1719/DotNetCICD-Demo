<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        $('#SAVE_BTN').prop('disabled', true);
        var Auth = '@Session["Access_Auth"]';
        if (Auth == "Testing" || Auth == "WSP-Testing") {
            $('#SAVE_BTN').prop('disabled', false);
        }
    });
    $(document).ready(function () {
        $('[data-toggle="tooltip1"]').tooltip();
    });


</script>


<script>
    var StateOfficer = '';
    $(document).ready(function () {
        $('#Wsp_gram_submit').hide();
        $('#Wsp_gram_checkbox').hide();

        StateOfficer = '@Session["Officer"]';
        if (StateOfficer != "Gram Panchyat Nodal Officer") {
            //if (StateOfficer == "District Level Nodal Officer") {
            //    $('#Wsp_gram_submit').show();
            //    $('#Wsp_gram_checkbox').show();

            //}
            //$('#SAVE_BTN').hide();
        }
         else if (StateOfficer != "" && StateOfficer != null) {

        } else {
              window.location = "/Home/LogOut";
        }
    });

    var DPMU_Level_Count = 0;
    function Save_Full_Info() {

        DPMU_Submission();

    }


    function DPMU_Submission() {
        DPMU_Level_Count = 1;

        var verification_val = 0;
        var lfckv = document.getElementById("WspTacker_Verification_CheckBox").checked;

        if (lfckv == true) {
            verification_val = 1;
            DPMU_Level_Count += 1;
        } else {
            verification_val = 0;
            alert("Please Check The data entered has been checked and verified by DPMU");
        }
        var obj = {};
        obj.latitude = lat;
        obj.longitude = long;


            obj.wb_sw_avail = $('#wb_sw_avail').val();


            obj.wb_gw_avail = $('#wb_gw_avail').val();

        obj.wb_sw_utili = $('#wb_sw_utili').val();

        obj.wb_total_avail = $('#wb_total_avail').val();

        obj.wb_gw_utili = $('#wb_gw_utili').val();


        obj.wb_total_utili = $('#wb_total_utili').val();



        obj.wb_sw_balance = $('#wb_sw_balance').val();



        obj.wb_gw_balance= $('#wb_gw_balance').val();


        obj.wb_total_balance = $('#wb_total_balance').val();

        

        if (verification_val == 1 && DPMU_Level_Count == 2) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Wsp_new/WaterBalanceInfo__InsertData",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert("Verified Successfully");

                    if (response != "Successfully Saved") {
                        window.location = "/Error/DefaultError";
                    }

                }
            });
        }
        else {
            DPMU_Level_Count = 1;
            Info();
        }
    }
</script>




