                                    </div>
                                    <div class="col-md-7 p-0">
                                        <input type="text" class="form-control p-2" placeholder="Enter Captcha" id="clientCaptcha1">
                                        <p id="status1" class="error_captch" style="font-weight:bold;color:red;"></p>
                                        <p id="AlertInfo" class="error_captch" style="font-weight:bold;color:red;"></p>
                                    </div>
                                    <input type="submit" id="reg_btn" hidden />
                                    <button class="btn btn-primary w-100 mt-4 register lemon" id="register-btn" type="button">Register</button>
                                </div>
                            </form>

                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>
