<script type="text/javascript">
        var Jsondata = "";
        var Jsondata2 = "";
        var StateName = "0";
        var DistName = "0";
        var BlockName = "0";
        var SessionTabName = "WSP_HOME_WSP";

        $(document).ready(function () {
            Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.list));
            $("#logout_session").show()
            DropDownInfo();
            /*State_Bind();*/
            refress();
            refress1();
            refress2();
            $("#username1").val("");
            $("#Signup_useremail").val("");
            $("#mobilenumber").val("");
            $("#usercreatepassword").val("");
            $("#userconfirmpassword").val("");

            $('#Session_Name').val(SessionTabName);
            $('#District1').hide();
            $('#State1').hide();
            $('#Block1').hide();
            $('#Gram1').hide();
            $('#state').hide();

            $('#dist').hide();

            $('#block').hide();

            $('#gram').hide();
            $('#village').hide();

            //  DropDownInfo();



            // Error_Info();
            $("#Change").css("display", "none");



            if ($('#change').val() == 'Nodal Officer') {
                // $('#modal1').modal('hide');
                $('#District1').hide();
                $('#State1').hide();
                $('#Block1').hide();
                $('#Gram1').hide();
                $('#state').hide();

                $('#dist').hide();

                $('#block').hide();

                $('#gram').hide();
                $('#village').hide();


            }

            $.noConflict();

            $('#example_admin').DataTable();
            $('#example44').DataTable();


            $('[data-id]').on('click', function (e) {/*h4.uppercas*/
                e.preventDefault();
                if ($(this).hasClass("uppercas")) {

                    $(this).parent().addClass('append');
                    $(this).parent().siblings().removeClass('append');
                }
                var ref = $(this).attr('data-id');
                $('div[id^="MIS"]').hide();
                $("#" + ref).fadeIn(500);
            });


            $('[data-content]').on('click', function (e) {/*h4.uppercas*/
                e.preventDefault();
                if ($(this).hasClass("change_image")) {

                    $(this).parent().addClass('append');
                    $(this).parent().siblings().removeClass('append');
                }
                var ref = $(this).attr('data-content');
                $('div[id^="gwm"]').hide();
                $("#" + ref).fadeIn(500);
            });


        });

        function Error() {
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: "/WspNew/Error_Info",
                data: '',
                dataType: 'JSON',
                success: function (response) {
                    $('#status').text('');
                    $('#status1').text('');
                    $('#status3').text('');
                    $('#useremail').val();
                    $('#userpassword').val('');
                    if (response.length != 0) {

                        $('#District1').hide();
                        $('#State1').hide();
                        $('#Block1').hide();
                        $('#Gram1').hide();
                        $('#state').hide();

                        $('#dist').hide();

                        $('#block').hide();

                        $('#gram').hide();
                        $('#village').hide();
                        if (response[0].user_type == "ForgetPassword") {

                            // $('#myModal').modal('show');
                            // $('#myModal').show();
                            $('#FPassword')[0].click();
                            $('#status3').text(response[0].error_test);
                            $('#forget_password_email').val(response[0].user_email);
                        }
                        else if (response[0].user_type == "MisSignup") {
