<script>

    function ChangePassword() {

        document.getElementById('AlertInfo_mail').innerHTML = "";
        var old_password = $('#old_password').val();
        var gmail_change = $('#gmail_change').val();
        var new_password = $('#new_password').val();
        var confirm_password = $('#confirm_password').val();

        var s = 0;
        if (old_password == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter Old Password";
            s = 1;
        }
        else if (gmail_change == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter your Email id";
            s = 1;
        }
        else if (new_password == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter New Password";
            s = 1;
        }
        else if (confirm_password == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter Confirm Password";
            s = 1;
        }
        else if (new_password != confirm_password) {

            document.getElementById('AlertInfo_mail').innerHTML = "New Password and Confirm Password is Not Matched";
            s = 1;

        }



        if (s == 0) {
            var obj = {};


            obj.Password = new_password;
            obj.DepartmentName = old_password;
            obj.Email = gmail_change;

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/ChangePassword",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    document.getElementById('AlertInfo_mail').innerHTML = response;

                    if (response == "Password Changed Successfully") {
                        $('#old_password').val("");
                        $('#gmail_change').val("");
                        $('#new_password').val("");
                        $('#confirm_password').val("");

                        $('#AlertInfo_mail').text(response);
                        $('#password_change_id').hide();

                        $('#emailid_show').show();
                        $("#f_close_btn").click();
                        alert(response);
                        document.getElementById('AlertInfo_mail').innerHTML = "";

                    }
                    else {
                        $('#AlertInfo_mail').text(response);


                    }


                }
            });
        }

    }
</script>
