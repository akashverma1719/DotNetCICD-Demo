        $('#msghint').css("display", "none");
        var pass = $('#usercreatepassword').val();
        if (pass != "") {
            if (pass.match(/[a-z]/g) && pass.match(/[A-Z]/g) && pass.match(/[0-9]/g) && pass.match(/[^a-zA-Z\d]/g) && pass.length >= 8) {
                $('#msgpass').css("display", "none");
