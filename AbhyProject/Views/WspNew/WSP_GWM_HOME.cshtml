                                        <li style="color: #dc3545;" id="liL">Atleast one lowercase</li>
                                        <li style="color: #dc3545;" id="liS">Atleast one special character</li>
                                        <li style="color: #dc3545;" id="liD">Atleast one digit</li>
                                    </ul>
                                </div>
                                <div class="input-group mb-3">
                                    <span class="input-group-text icon_section"><img src="~/DashboardStyles/images/password.png" /></span>

                                    <input type="password" class="form-control p-2" name="Verifiedornot" id="userconfirmpassword" autocomplete="off" placeholder="Confirm Password" maxlength="25" min="3" required>
                                    <input type="hidden" name="VerificationCode" id="VerificationCode" />

                                </div>
                                <div class="row mt-4 mb-4">
                                    <div class="col-md-5 p-0">
                                        <div class="">
                                            <img src="@Url.Action("Reg_GetCaptchaImage","Home")" id="C_img2" />
                                            <span class="refreshicon"><i class="fa fa-refresh" onclick="refress1()"></i></span>
                                            <span id="Grv_captcha1" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>

