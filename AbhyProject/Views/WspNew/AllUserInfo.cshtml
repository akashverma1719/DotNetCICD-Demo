        var i = 0;
        var id = userid;
        var password = $('#password' + RowNo).val();
        var mis_mobile = $('#users').val();

        var new_hashText = CryptoJS.SHA256(password);
        $('#hasspass').val(new_hashText);
        var hash_password = $('#hasspass').val();

        if (aspassword == password) {
            alert("Your old Password and new password is same. please use diffrent password");
            return false;
            i = 1;
        }
        else if (password != "") {
            var str = password;
            if (str.match(/[a-z]/g) && str.match(/[A-Z]/g) && str.match(/[0-9]/g) && str.match(/[^a-zA-Z\d]/g) && str.length >= 8) {
                i = 0;
            }

            else {
                alert("Your  Password should be [Minimum 8 characters which contain at least one lowercase letter, one uppercase letter, one numeric digit, and one special character]");
                return false;
                i = 1;
            }
        }
        else {
            alert("Please Enter Password");
            return false;
            i = 1;
        }


        if (i == 0) {

            if (confirm("Are you sure you want to Update this entry?")) {
                var formdata = new FormData();
                formdata.append("id", id);
                formdata.append("password", password);
                formdata.append("hash_password", hash_password);
                formdata.append("mis_mobile", mis_mobile);

                $.ajax({
                    url: '/WspNew/SaveUserdetails_new',
