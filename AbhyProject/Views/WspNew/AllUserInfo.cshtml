                    // Create download link element
                    downloadLink = document.createElement("a");

                    document.body.appendChild(downloadLink);

                    var ws = XLSX.utils.table_to_sheet(tableSelect);
                    var wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, "MIS Mobile Report");

                    var wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

                    function s2ab(s) {
                        var buf = new ArrayBuffer(s.length);
                        var view = new Uint8Array(buf);
                        for (var i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
                        return buf;
                    }

                    // Create a Blob from the binary data
                    var blob = new Blob([s2ab(wbout)], { type: dataType });

                    // Create an object URL for the Blob and set it as the href attribute of the download link
                    downloadLink.href = URL.createObjectURL(blob);

                    // Set the download attribute of the link to specify the file name
                    downloadLink.download = filename;

