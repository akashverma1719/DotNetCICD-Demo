        display: none;
    }

    .Sider_column > ul.sider_images_sider:after {
        position: absolute;
        content: "";
        /*height: 10%;*/
        width: 1px;
        display: block;
        background-color: black;
        right: -1px;
    }

    .Sider_column > ul.sider_images_sider[data-target]:after {
        position: absolute;
        content: "";
        height: 0%;
        width: 1px;
        display: block;
        background-color: black;
        right: -1px;
    }

    .Sider_column > ul.sider_images_sider[data-target].active {
