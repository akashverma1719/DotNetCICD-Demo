    }



    .btnprocess {
        padding: 5px 30px;
        border-radius: 30px;
        font-size: 15px;
        font-weight: 600;
        /*background-color: #fff !important;*/
        border: none;
        /* border: none; */
        background-color: #03A9F4 !important;
        color: #fff !important;
    }

    .btnprocess1 {
        padding: 5px 30px;
        border-radius: 30px;
        font-size: 15px;
        font-weight: 600;
        /*background-color: #fff !important;*/
        border: none;
        /* border: none; */
        background-color: #03A9F4 !important;
        color: #fff !important;
    }

    ul[id$="_menu"] {
        padding: 0;
        margin: 0;
    }

    .Side_Image {
        padding: 0;
        margin: auto;
    }

    ul[id$="_menu"] > li {
        display: inline-flex;
        position: relative;
        width: 100%;
        margin-bottom: 15px;
        justify-content: center;
    }

        ul[id$="_menu"] > li > a {
            display: block;
            text-align: center;
        }

    [id^="menu-"][class*="-info"] {
        font-size: 21px;
    }

        [id^="menu-"][class*="-info"] > .clearfix {
            padding: 15px 0;
        }

            [id^="menu-"][class*="-info"] > .clearfix:last-child {
                text-align: center;
            }



    ul[id$="_menu"] > li > a > span {
        border-radius: 50%;
        border: 1px solid #333;
        display: inline-block;
        padding: 10px;
    }

        ul[id$="_menu"] > li > a > span > img {
            height: 40px;
            width: 40px;
            margin: auto;
        }

    ul[id$="_menu"] > li > a > label {
        /*color: #7c3c0b;*/
        color: #000;
        font-size: 12px;
        display: block;
        border: 2px solid transparent;
    }

    ul[id$="_menu"] > li > a:hover > label,
    ul[id$="_menu"] > li > a:focus > label,
    ul[id$="_menu"] > li.active > a > label {
        border-color: #337ab7;
        background-color: #fde0ca;
    }

    #myTabs.nav-pills > li.active > a:before {
        content: "";
        /*height: 2px;*/
        position: absolute;
        bottom: 6px;
        display: inline-block;
        width: 98%;
        z-index: 99;
        left: 2%;
        background-color: #fff;
    }

    ul[id$="_menu"] > li > a:active,
    ul[id$="_menu"] > li > a:focus,
    ul[id$="_menu"] > li > a:hover {
        text-decoration: none;
    }

    ul[id$="_menu"] > li.active > a > span {
        border-width: 2px;
        border-color: #337ab7;
    }

    ul[id$="_menu"] > li.active:after {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #337ab7;
        content: " ";
        position: absolute;
        bottom: -10px;
        margin-left: -15px;
        left: 50%;
    }

    .form-control {
        border: none;
        box-shadow: none;
        border-bottom: 1px solid;
        border-radius: 0;
    }


    a:hover {
        color: red;
        border-bottom: 2px;
    }

    a:active {
        color: green;
    }

    h2 {
        text-align: center;
        font-weight: 600;
    }
    .color_database {
        color: green !important;
    }
    .wa_table thead tr th{
        background-color:#337ab7;
        color:#fff;
    }
</style>
<style>
