@model IEnumerable<AbhyProject.Models.abhy_villages>
@{
    ViewBag.Title = "WSP_GWM_HOME";
    Layout = null;
}

<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>

<title>MIS Login</title>
