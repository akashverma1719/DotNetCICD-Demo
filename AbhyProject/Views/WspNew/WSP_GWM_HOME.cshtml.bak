<script>

    $("#register-btn").click(function () {

        SaveDetails();

    });


    function SaveDetails() {
        debugger;
        var j = 0;
        var State = $("#state").val();
        var Dist = $("#dist").val();
        var Block = $("#block").val();
        var Gram = $("#gram").val();
        var Pass = $("#usercreatepassword").val();
        var CPass = $("#userconfirmpassword").val();
        var UserName = $("#username1").val();
        var Email = $("#Signup_useremail").val();
        var NodalOfficer = $("#NodalOfficer").val();
        var Mobile = $("#mobilenumber").val();
        var DepartmentName = $("#department").val();
        var str = document.getElementById("usercreatepassword").value;


        if (Pass != CPass && Pass != "" && CPass != "") {
            document.getElementById('AlertInfo').innerHTML = "Password's Doesn't Matched";
        }
        else if (NodalOfficer == "Nodal Officer") {

            document.getElementById('AlertInfo').innerHTML = "Please Select Nodal Officer";
            j = 1;
        }
        else if (UserName == "") {
            document.getElementById('AlertInfo').innerHTML = "Please Enter UserName";
            j = 1;
        }
        else if (Email == "") {
            document.getElementById('AlertInfo').innerHTML = "Please Enter Email";
            j = 1;
        }

        else if (Mobile == "") {

            document.getElementById('AlertInfo').innerHTML = "Please Enter Mobile Number";
            j = 1;
        }
        else if (DepartmentName == "") {

            document.getElementById('AlertInfo').innerHTML = "Please Enter Department Name";
            j = 1;
        }
        else if (Pass == "") {
            document.getElementById('AlertInfo').innerHTML = "Please Enter Password";
            j = 1;
        }
        //else if (Email != "") {
        //    if (Email.match(validRegex)) {

        //    } else {
        //        alert("Your Email Id is Invalid")
        //    }
        //}
        else if (Pass != "") {

            if (str.match(/[a-z]/g) && str.match(/[A-Z]/g) && str.match(/[0-9]/g) && str.match(/[^a-zA-Z\d]/g) && str.length >= 8) {

                alert("Your Password is Allowed")
            }

            else {
                alert("Your  Password should be [Minimum 8 characters which contain at least one lowercase letter, one uppercase letter, one numeric digit, and one special character]");
                j = 1;
            }

        }
        else if (CPass == "") {

            document.getElementById('AlertInfo').innerHTML = "Please Enter Confirm Password";
            j = 1;
        }

        if (NodalOfficer == "State Level Nodal Officer") {

            if (State != "0" && State != null) {
            }
            else {

                document.getElementById('AlertInfo').innerHTML = "Please Fill StateName";
                j = 1;
            }
        }
        if (NodalOfficer == "District Level Nodal Officer") {

            if (State != "0" && State != null && Dist != "0" && Dist != null) {

            }
            else {
                document.getElementById('AlertInfo').innerHTML = "Please Select State And District ";

                j = 1;
            }
        }
        if (NodalOfficer == "Block Level Nodal Officer") {

            if (State != "0" && State != null && Dist != "0" && Dist != null && Block != "0" && Block != null) {

            }
            else {
                document.getElementById('AlertInfo').innerHTML = "Please Select State, District and Block";

                j = 1;
            }
        }
        if (NodalOfficer == "Gram Panchyat Nodal Officer") {
            if (State != "0" && State != null && Dist != "0" && Dist != null && Block != "0" && Block != null && Gram != "0" && Gram != null) {

            }
            else {
                document.getElementById('AlertInfo').innerHTML = "Please Select State,District, Block and  Gram Panchayat";
                j = 1;
            }
        }


        if (j != 1) {
            ddd = 0;
            //var randomnumber = $('#randomnumber').text();
            debugger;
            var Password = $("#usercreatepassword").val();

            var C_Password = $("#userconfirmpassword").val();
            $("#VerificationCode").val(Password);

            var hashText = CryptoJS.SHA256(Password);
            var CP_hashText = CryptoJS.SHA256(C_Password);

            //var Compound = randomnumber.concat(hashText);

            //var Complex = CryptoJS.SHA256(Compound);

            //$("#CheckingCode").val(randomnumber);
            $("#usercreatepassword").val(hashText);
            $("#userconfirmpassword").val(CP_hashText);


            $('#reg_btn').click();


        }

    }
</script>

