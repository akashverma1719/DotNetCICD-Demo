    function Login() {

        var obj = {};
        var XX = 0;
        var Email = $('#useremail').val();
        if (Email == "") {
            XX = 1;
            $('#LoginError').text('Please Enter Email');
        }
        // obj.stateofficer_email = token;
        debugger;
        obj.DepartmentName = SessionTabName;
        var Password = $('#userpassword').val();
        if (Password == "") {
            XX = 1;
            $('#LoginError').text('Please Enter Password');
        }

        if (XX == 0) {
            debugger;
            var randomnumber = $('#randomnumber').text();

            var Password = $('#userpassword').val();
            debugger;
            var hashText = CryptoJS.SHA256(Password);
            $('#CheckingCode').val(randomnumber);
            var Compound = randomnumber.concat(hashText);
            var Complex = CryptoJS.SHA256(Compound);
            $('#userpassword').val(Complex);
            $('#ss1').click();
        }
    }
    function show_admin_table() {

        var obj = {};
        var XX = 0;
        var Email = $('#AEmail').val();
        if (Email == "") {
            XX = 1;
            $('#AdError').text('Please Enter Email');
        }
        var Password = $('#APassword').val();
        if (Password == "") {
            XX = 1;
            $('#AdError').text('Please Enter Password');
        }

        if (XX == 0) {
            obj.Email = Email;
            obj.Password = Password;
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/WSPHomeAdminRole",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {

                    if (response == "OK") {
                        // GetAdminDetails();
                        window.location = "/Aminview/admin";
                    }
                    else {
                        $('#AdError').text(response);
                    }

                }
            });
        }


    }
    //var table = $('#example_admin').DataTable();
    //$('.example_admin').on('keyup', function () {
    //    table.search(this.value).draw();
    //});
    function Error_Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WspNew/Error_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                $('#status').text("");
                if (data.length != 0) {

                    $('#status').text(data[0].error_test);
                }
            }
        });
    }

    function GetAdminDetails() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Home/UsersInfoo',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Error") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                debugger;
                if (data.length != 0) {
                    var ss = "";

                    for (var i = 0; i < data.length; i++) {
                        ss += '<tr><td> ' + (i + 1) + ' </td><td> Sankar </td><td>  ' + data[i].Email + ' </td><td>  ' + data[i].ContactNumber + ' </td>' +
                            '<td>  ' + data[i].DepartmentName + ' </td> <td class="text-center"><button type="button" title="Accept" class="btn btn-success btn-md" onclick="Approved(' + data[i].UserId + ')"><i class="fa fa-check"></i></button></td>' +
                            '<td class="text-center"> <button type="button" title="Reject" class="btn btn-danger btn-md" onclick="Rejected(' + data[i].UserId + ')"><i class="fa fa-close"></i></button></td></tr>';
                    }

                    if (ss == "") {
                        ss = '<tr>No Data</tr>';
                    }
                    $('.odd').hide();
                    $('#TBLUSERS').html(ss);
                    $('.example_admin_table').show();
                    $('.Admin_view_form').hide();
                }

            }
        });

    }

    function Approved(userid) {
        debugger;
        var obj = {};

        obj.UserId = userid;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/WSPHomeAdminApproved",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);

                GetAdminDetails();


            }
        });
    }

    function Rejected(userid) {
        var obj = {};

        obj.UserId = userid;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/WSPHomeAdminRejected",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);

                GetAdminDetails();


            }
        });
    }


    function openCity(evt, cityName) {
        debugger;
        $('#Session_Name').val(cityName);

        var i, tabcontent, tablinks1;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks1 = document.getElementsByClassName("tablinks1");
        for (i = 0; i < tablinks1.length; i++) {
            tablinks1[i].className = tablinks1[i].className.replace(" active", "");
        }
        document.getElementById(cityName).style.display = "block";
        evt.currentTarget.className += " active";
        if (cityName == "admin_view") {


            $("div.login_div_view").hide();

        }
    }


    // Get the element with id="defaultOpen" and click on it
    document.getElementById("defaultOpen").click();
    //$("div.admin_view_hid_show").click(function () {

    //    $("div.login_div_view").addClass("login_div_view_hide");

    //});
    //$("div.admin_view_hid_show1").click(function () {
    //    debugger

    //    $("div.login_div_view").remove("login_div_view_hide");

    //});
    $(function () {
        $(".admin_view_hid_show1").click(function () {
            $(".login_div_view").show();
            return false;
        });
        $(".admin_view_hid_show").click(function () {
            $(".login_div_view").hide();
            return false;
        });
    });

</script>
<script>

    function ChangePassword() {

        document.getElementById('AlertInfo_mail').innerHTML = "";
        var old_password = $('#old_password').val();
        var gmail_change = $('#gmail_change').val();
        var new_password = $('#new_password').val();
        var confirm_password = $('#confirm_password').val();

        var s = 0;
        if (old_password == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter Old Password";
            s = 1;
        }
        else if (gmail_change == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter your Email id";
            s = 1;
        }
        else if (new_password == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter New Password";
            s = 1;
        }
        else if (confirm_password == "") {

            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter Confirm Password";
            s = 1;
        }
        else if (new_password != confirm_password) {

            document.getElementById('AlertInfo_mail').innerHTML = "New Password and Confirm Password is Not Matched";
            s = 1;

        }



        if (s == 0) {
            var obj = {};


            obj.Password = new_password;
            obj.DepartmentName = old_password;
            obj.Email = gmail_change;

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/ChangePassword",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    document.getElementById('AlertInfo_mail').innerHTML = response;

                    if (response == "Password Changed Successfully") {
                        $('#old_password').val("");
                        $('#gmail_change').val("");
                        $('#new_password').val("");
                        $('#confirm_password').val("");

                        $('#AlertInfo_mail').text(response);
                        $('#password_change_id').hide();

                        $('#emailid_show').show();
                        $("#f_close_btn").click();
                        alert(response);
                        document.getElementById('AlertInfo_mail').innerHTML = "";

                    }
                    else {
                        $('#AlertInfo_mail').text(response);


                    }


                }
            });
        }

    }
</script>
