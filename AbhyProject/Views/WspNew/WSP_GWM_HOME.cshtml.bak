<style>
    .gis_card {
        background: aliceblue;
        height: 446px;
        width: 332px;
        padding: 20px 1px;
        border-left: 18px solid #023157db;
        border-top-left-radius: 50px;
        border-bottom-left-radius: 50px;
    }

        .gis_card p:first-child {
            background-color: #337ab7;
            width: 262px;
            font-size: 19px;
            color: #fff;
            font-weight: 600;
            margin-left: 60px;
            padding: 16px;
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;
        }

        .gis_card img {
            width: 231px;
            padding-top: 45px;
        }

    .gis_web_icon {
        width: 115px;
    }

    .gis_card .card:focus, div.card:hover {
        transition: none !important;
        transform: none !important;
        border-top-left-radius: 50px !important;
        border-bottom-left-radius: 50px !important;
    }

    .about-area .col-md-6 img {
        margin-top: 0px;
    }

    .passwordchangepass > li {
        display: inline-block;
    }

    .refreshicon {
        position: relative;
        right: 21px;
        top: -12px;
    }

    .highlight {
        color: red;
    }

    .captch_div > input {
        background-color: #fff;
        background-image: none;
        border: 1px solid #ccc;
        border-radius: 4px;
        height: 34px;
    }

    .captch_div > label {
        color: #000;
    }

    .error_captch {
        height: 10px;
        text-align: center;
    }


    .input-box {
        font-size: 42px;
        border: none;
        border-bottom: 1px solid #000;
        height: 42px;
        line-height: 28px;
        border-radius: 0px;
        box-shadow: none;
        padding: 0px;
    }

    .header-top-info {
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    }



    .input-box input {
        width: 100%;
    }

    .sss1 {
        margin-top: 0px !important;
    }



    .button.lemon {
        background: #5cb85c;
        padding: 4px;
        text-align: center;
        border: none;
        border-radius: 10px;
        /*box-shadow: 8px 3px 17px rgba(0, 0, 0, 1);*/
        transition: all 0.3s ease 0s;
        font-size: 14px;
        height: 40px;
        font-size: 20px;
        width: 100%;
        border-color: #4cae4c;
        text-transform: none;
    }

    @@media (max-width:768px) {
        /*.button.lemon {
                position: absolute;
            }*/
        .btnsinup {
            font-size: 14px !important;
        }
    }

    .modal-body > .form-control {
        display: block;
        width: 100%;
        height: 34px;
        padding: 6px 12px;
        font-size: 14px;
        line-height: 1.42857143;
        color: #555;
        background-color: #fff;
        background-image: none;
        border: 1px solid #ccc;
        border-radius: 4px;
        -webkit-box-shadow: inset 0 1px 1px rgb(0 0 0 / 8%);
        box-shadow: inset 0 1px 1px rgb(0 0 0 / 8%);
        -webkit-transition: border-color ease-in-out .15s, -webkit-box-shadow ease-in-out .15s;
        -o-transition: border-color ease-in-out .15s, box-shadow ease-in-out .15s;
    }

    #ss {
    }

    .field-icon {
        float: right;
        font-size: 20px;
        margin-top: -32px;
        position: relative;
        z-index: 2;
    }

    p {
        text-align: justify;
    }

    .mt-140 {
        margin-top: 0px !important;
    }

    .mb-19 {
        margin-bottom: 10px;
    }


    a.button, button {
        text-transform: none;
    }

    ul.relogin {
        display: inline-flex;
        width: 98%;
    }

        ul.relogin > li {
        }


    a {
        color: #1c94e0;
        text-decoration: none;
    }

    a {
        background: transparent;
    }

    .EdgeButton--secondary:hover {
        background-color: #eaf5fd;
        color: #1da1f2;
    }

    .EdgeButton:active, .EdgeButton:focus, .EdgeButton:hover {
        text-decoration: none;
    }

    .text-dark .text-icon > h2, .single-fun-factor.text-dark h4 {
        padding: 1px 1px 6px 1px !important;
    }
    /*#ss {
            border: 1px solid #000;
        }*/
    .input-box input {
        padding: 0px !important;
    }

    .forgotlink {
        font-size: 16px;
        width: 100%;
        color: #1c94e0;
        font-weight: 600;
    }


    .mb-191 {
        margin-bottom: 6px;
    }

    .row {
        margin-left: 0px;
        margin-right: 0px;
    }

    .nav-pills > li.active > a, .nav-pills > li.active > a:focus, .nav-pills > li.active > a:hover {
        color: #fff !important;
        border-bottom: 2px solid #fff !important;
        background-color: transparent !important;
        font-size: 13px;
        font-weight: 600 !important;
        border-radius: 0 !important;
    }

    @@media (min-width: 992px) {
        ul.nav-justified > li {
            width: auto;
        }

        ul.nav-justified {
            display: table;
        }
    }

    @@media (min-width: 768px) {
        .nav-justified > li {
            display: inline-block;
            width: auto;
        }
    }
</style>


<header class="header hederImage">

    <div class="clearfix">
        <div class="clearfix">
            <div class="col-lg-8">
                <div class="header-top-info">
                    <ul class="clearfix">
                        <li>
                            <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                        </li>

                        <li>
                            <span>
                                <a href="~/home/index" class="text-white" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                            </span>
                            <span>
                                <a href="Javascript:;" title="GOVERNMENT OF INDIA" class="text-white" style="font-size:14px;" role="link">
                                    Ministry of Jal Shakti
                                </a>
                            </span>
                            <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" class="text-white" role="link" style="font-size:14px;">Department of Water Resources,</a></span>
                            <span style="text-align:center;">
                                <a href="javascript:;" class="text-white" title="GOVERNMENT OF INDIA" style="text-transform:none; font-size:14px;">
                                    River Development & Ganga Rejuvenation
                                </a>
                            </span>

                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <ul class="imgHome clearfix">
                    <li>
                        <a href="https://forms.gle/k5pHsGLwPpPdCbmU7" class="text-white" target="_blank" style="font-size:16px">
                            Data Disclosure Modalities Questionnaire
                        </a>
                    </li>

                </ul>
            </div>
            <div class="col-md-7" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                <ul class="imgHome clearfix">
                    <li>
                        <a href="~/Home/index">
                            <span>
                                <img src="~/Content/WspImages/home-icon-silhouette.png" title="Home" />
                            </span>
                            <label>Home <i class="fa fa-angle-double-right"></i></label>
                        </a>
                    </li>
                    <li>

                        <span><img src="~/Content/WspImages/home-icon-silhouette.png" title="Home" /></span>
                        <label>MIS Login</label>

                    </li>

                </ul>
            </div>
            <div class="col-md-5">
                <ul id="myTabs" class="nav nav-pills nav-justified">

                    <li class="active">
                        <a href="javascript:;">
                            <span> @*<img src="~/Content/WspImages/draft new 1.png" />*@</span>MIS Login
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
<div class="allcontent">
    <div class="">
        <div class="container-fluid">
            <div class="col-lg-12 col-md-12 col-md-12">
                <div class="col-md-3 col-sm-12">
                    <div class="tab-side">
                        <div class="row">
                            <div class=" col-md-12 tablinks1 admin_view_hid_show1" onclick="openCity(event, 'WSP_HOME_WSP')" id="defaultOpen">
                                <ul>
                                    <li><img src="~/Content/Agriculture_icons/grampanchayat_icon.png" /> </li>
                                    <li> Gram Panchayat Modules</li>
                                </ul>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-12 tablinks1 admin_view_hid_show1" onclick="openCity(event, 'Gplevel_data')">
                                <ul>
                                    <li><img src="~/Content/Agriculture_icons/monitoring_and_evaluation_icon.png" />
                                    <li>
                                        Monitoring And Evaluation <br />  Modules
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 tablinks1 admin_view_hid_show1" onclick="openCity(event, 'Physical_view')">
                                <ul>
                                    <li><img src="~/Content/Agriculture_icons/training_user_manual_icon.png" />
                                    <li> Training And Workshop</li>
                                </ul>
                            </div>


                        </div>
                        <div class="row">
                            <div class="col-md-12 tablinks1 admin_view_hid_show1" onclick="openCity(event, 'Gis_portel')">
                                <ul>
                                    <li><img class="gis_web_icon" src="~/Content/Agriculture_icons/gis_portal_icon.png" />
                                    <li> GIS Web Portal</li>
                                </ul>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="panel_addmin_wsp">
                        <div id="WSP_HOME_WSP" class="tabcontent">

                            <div class="col-md-12 col-sm-12 text-center">
                                <div class="image_login_img">
                                    <img src="~/Content/Agriculture_icons/gp_module_side_infographics_1.png" title="Gram Panchayt Module" />
                                </div>
                            </div>

                        </div>
                        <div id="Gplevel_data" class="tabcontent">

                            <div class="col-md-12 col-sm-12 text-center">
                                <div class="image_login_img">
                                    <img src="~/Content/Agriculture_icons/Monitoring And Evaluation_latest.png" title="Monitoring And Evaluation" />
                                </div>
                            </div>
                        </div>
                        <div id="Physical_view" class="tabcontent">
                            <div class="col-md-12 col-sm-12 text-center">
                                <div class="image_login_img">
                                    <img src="~/Content/Agriculture_icons/training manuals_latest2.png" title="Training Manuals" />
                                </div>
                            </div>
                        </div>

                        <div id="Gis_portel" class="tabcontent">
                            <div class="col-md-12 col-sm-12 text-center">
                                <div class="image_login_img">
                                    <div class="card gis_card">
                                        <div class="card-body">
                                            <p>GIS Web Portal</p>
                                            <img src="~/Content/Agriculture_icons/gis_protal.png" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="col-md-4 col-sm-6 login_div_view ">
                    <div class="col-md-4"></div>
                    <div class="col-md-7 col-sm-12">
                        <div class="col-xs-6 col-md-6 append" style="padding:0px;">
                            <h4 id="login_tab_id" class="uppercas" data-id="MISLOGIN" style="text-align: center;font-family: 'montserratlight'; display:block;padding:6px">
                                <span class="text-color" id="login_tab_id_span">Log in</span>
                            </h4>
                        </div>
                        <div class="col-xs-6 col-md-6" style="padding:0px;">
                            <h4 id="reg_tab_id" class="uppercas" data-id="MISSIGUP" style="text-align: center;font-family: 'montserratlight'; display:block;padding:6px">
                                <span class="text-color" id="reg_tab_id_span">Register</span>
                            </h4>
                        </div>
                    </div>

                    <label id="randomnumber" hidden>@ViewBag.RandomNumber</label>
                    <div id="MISLOGIN" style="margin-top:100px;padding:10px;">
                        @using (Html.BeginForm("WSP_GRM_HOME", "WspNew", FormMethod.Post))
                        {


                            <label class="Loginlabel">Log in</label>
                            <div>
                                <label class="labelName"> <i class="fa fa-envelope"></i>Email</label>
                            </div>
                            <div class="input-box mb-19 form-control">

                                @*<i class="fa fa-envelope"></i>*@

                                <input type="email" id="useremail" name="Email" autocomplete="off" placeholder="Enter your email id" required>
                            </div>
                            <label class="labelName"> <i class="fa fa-lock"></i>Password</label>
                            <div class="input-box form-control">
                                @*<i class="fa fa-lock"></i>*@

                                <input type="password" name="Password" id="userpassword" placeholder=" Enter your password" autocomplete="off" min="4" maxlength="25" required>
                                <span toggle="#userpassword" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                            </div>
                            <div class="text-center">
                                <img src="@Url.Action("GetCaptchaImage","Home")" id="C_img1" />
                                <span class="refreshicon"><i class="fa fa-refresh" onclick="refress()"></i></span>
                                <span id="Grv_captcha" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>

                            </div>
                            <input type="text" name="CheckingCode" id="CheckingCode" hidden />
                            @*<input type="text" name="Villagename" id="Villagename" hidden />*@
                            <div class="text-center captch_div">
                                <label for="message">Enter the code above here </label>
                                <input type="text" class="" style="width:60%;" name="clientcaptcha" autocomplete="off" id="clientCaptcha" placeholder="Type the text" required />


                                <p id="status" class="error_captch" style="font-weight:bold;color:red;"></p>
                                <label style="font-weight:bold;color:red;">@Session["Error"]</label>
                            </div>
                            <input type="text" name="NodalOfficer" id="Session_Name" hidden>
                            <div class="" style="margin-top: 8px;font-size: 18px;">
                                <ul>
                                    <li class="col-md-12 colmd12" style="">
                                        <button type="button" class="login-btn button lemon" id="btnSubmit" style="">Log in</button>
                                        <button type="submit" id="ss1" hidden></button>
                                    </li>
                                </ul>
                            </div>


                        }
                        <div class="">
                            <ul style="margin-top:15px;" class="passwordchangepass">
                                <li class="col-md-12 col-sm-12" style="margin-top:15px;padding:0px">
                                    <a href="#" class="forgotlink" data-toggle="modal" data-target="#myModal" id="FPassword">Change or forgot password ?</a>

                                </li>
                                @*
                                    <li class="col-md-5 col-sm-6" style="margin-top: 15px;padding: 0px">
                                        <a href="~/Contact/Change_password" class="forgotlink">Change password ?</a>
                                    </li>*@

                            </ul>
                        </div>
                        <div style="text-align:center;font-size:25px;"><label id="LoginError"></label></div>

                    </div>
                    <div id="MISSIGUP" style="display:none;margin-top:100px;padding:10px;">
                        <label class="Loginlabel">Register</label>
                        <div>
                            <label class="labelName"><span class="fa"><img src="~/Images/officer_2@1x.png" style="margin-top:-2px;"></span>Select Nodal Officer</label>
                        </div>

                        @using (Html.BeginForm("Register", "WspNew", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return myFunction()" }))
                        {
                            <div class="input-box form-control  mb-191">
                                <select id="NodalOfficer" name="NodalOfficer" onchange="NodalOfficer_fun(this)" required>
                                    <option value="Nodal Officer">Select Nodal Officer</option>
                                    @*
                                        <option value="Admin">Admin</option>*@
                                    <option value="National Level Nodal Officer">National Level Nodal Officer</option>
                                    <option value="State Level Nodal Officer">State Level Nodal Officer</option>
                                    <option value="District Level Nodal Officer">District Level Nodal Officer</option>
                                    <option value="Block Level Nodal Officer">Block Level Nodal Officer</option>
                                    <option value="Gram Panchyat Nodal Officer">Gram Panchyat Nodal Officer</option>
                                </select>

                            </div>
                            <select style="margin-bottom: 10px;text-transform: capitalize; height:35px" name="StateName" id="state" onchange="State_Dropdown_Function()" class="state form-control">
                                <option value="0">Select State</option>
                            </select>
                            <select style="margin-bottom: 10px; text-transform: capitalize; height: 35px" name="DistrictName" id="dist" onchange="Dist_fun()()" class="dist form-control">
                                <option value="0">Select District</option>
                            </select>
                            <select style="margin-bottom: 10px !important; text-transform: capitalize; height: 35px" name="BlockName" onchange="Block_fun()" id="block" class="block form-control">
                                <option value="0">Select Block</option>

                            </select>
                            <select style="margin-bottom: 10px; text-transform: capitalize; height: 35px" name="GramPanchayatName" id="gram" class="gram form-control">
                                <option value="0">Select Panchayat</option>
                            </select>
                            <input type="text" name="signupdata" hidden />
                            <label class="labelName"><i class="fa fa-user"></i>Username</label>
                            <div class="input-box form-control  mb-191">
                                <input type="text" name="UserName" id="username1" class="sinup" autocomplete="off" placeholder="Enter your username" maxlength="30" required />
                            </div>
                            <label class="labelName"><i class="fa fa-envelope"></i>Email</label>
                            <div class="input-box form-control mb-191">
                                <input type="email" name="Email" id="Signup_useremail" autocomplete="off" placeholder="Enter your email id" required>
                            </div> <label class="labelName"><i class="fa fa-mobile" style="font-size:22px;"></i>Mobile Number</label>
                            <div class="input-box form-control mb-191">
                                <input type="text" name="ContactNumber" id="mobilenumber" autocomplete="off" placeholder="Enter your mobile number" class="integer" maxlength="10" required>
                            </div>
                            <label class="labelName"><i class="fa fa-building"></i>Department Name</label>
                            <div class="input-box form-control mb-191">
                                <input type="text" id="department" name="DepartmentName" autocomplete="off" placeholder="Enter your department name" maxlength="25" required>
                            </div>
                            <label class="labelName"><i class="fa fa-lock"></i>Password</label>
                            <div class="input-box form-control mb-191">
                                <input type="password" name="Password" id="usercreatepassword" autocomplete="off" placeholder="Create your password" maxlength="25" min="3" required>
                                <span toggle="#usercreatepassword" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                            </div>
                            <label class="labelName"><i class="fa fa-lock"></i>Confirm Password</label>
                            <div class="input-box form-control mb-191">
                                <input type="password" name="Verifiedornot" id="userconfirmpassword" autocomplete="off" placeholder="Confirm your password" maxlength="25" min="3" required>
                                <input type="hidden" name="VerificationCode" id="VerificationCode" />
                                <span toggle="#userconfirmpassword" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                            </div>

                            <div class="text-center">
                                <img src="@Url.Action("Reg_GetCaptchaImage","Home")" id="C_img2" />
                                <span class="refreshicon"><i class="fa fa-refresh" onclick="refress1()"></i></span>
                                <span id="Grv_captcha1" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>

                            </div>
                            <div class="text-center captch_div">
                                <label for="message">Enter the code above here </label>
                                <input type="text" class="" style="width:60%;" name="clientcaptcha" autocomplete="off" id="clientcaptcha" placeholder="Type the text" required />

                                <p id="status1" class="error_captch" style="font-weight:bold;color:red;"></p>
                            </div>

                            <div class="button-box mt-20" style="font-size:25px">
                                <ul>
                                    <li class="col-md-12" style="padding:0px;">
                                        <input type="submit" id="reg_btn" hidden />
                                        <button type="button" id="register-btn" class="register-btn button lemon pull_right" @*onclick="myFunction()" *@>Register</button>
                                    </li>
                                </ul>
                            </div>
                        }

                        <input type="text" name="state" hidden />
                        <input type="text" name="dist" hidden />
                        <input type="text" name="block" hidden />
                        <input type="text" name="gram" hidden />
                        <input type="text" name="village" hidden />
                    </div>
                    <div style="text-align:center;color:red;font-weight:600;font-size:21px;"><b><label id="AlertInfo"></label></b></div>
                </div>
                @*<div id="Admin_view" class="tabcontent">
                    <div class="about-area mt-140 about-two">
                        <div class="row">
                            <div class=" col-md-8 col-sm-12 ">
                                <div class="form Admin_view_form">
                                    <label class="text-center admin_login_name_label">Admin Login</label>
                                    <ul class="admin_login_form">
                                        <li>
                                            <input type="email" class="form-control" autocomplete="off" placeholder="Enter your email id" id="AEmail" />
                                        </li>
                                        <li>
                                            <input type="password" class="form-control" autocomplete="off" placeholder="Enter your password" id="APassword" style="">
                                            <span toggle="#chpwd" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                                        </li>
                                        <li><button type="button" class="btn btn-success" onclick="show_admin_table();">Login</button></li>
                                    </ul>
                                    <div style="text-align:center;color:red;">
                                        <label id="AdError"></label>
                                    </div>
                                </div>
                                <div class="row example_admin_table">
                                    <div class="col-md-12 col-sm-12">
                                        <div class="tbl-responsive">
                                            <table id="example_admin" class="data2 display  table stripe row-border order-column   table-striped table-bordered dataTable no-footer" style="width:100%">
                                                <thead>
                                                    <tr style="color:darkslateblue">
                                                        <th>S.No</th>
                                                        <th>User Name</th>
                                                        <th>E-Mail</th>
                                                        <th> Mobile</th>
                                                        <th> Department </th>
                                                        <th>Accept</th>
                                                        <th>Reject</th>

                                                    </tr>
                                                </thead>
                                                <tbody id="TBLUSERS"></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>*@
            </div>
        </div>
        <div id="progress">
            <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
                <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                    <span class="progress-group-label" data-target="#music" data-toggle="tab">MIS Login</span>
                    <div class="tri shadow"></div>
                    <div class="tri"></div>
                </li>
            </ul>
        </div>
    </div>
</div>
<!--password icon script start-->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div id="emailid_show">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="myModalLabel">Password Recovery</h4>
                </div>
                @using (Html.BeginForm("ForgetPassword1", "WspNew", FormMethod.Post))
                {
                    <div class="modal-body">
                        <input type="text" class="form-control" autocomplete="off" name="Email" id="forget_password_email" placeholder="Enter Valid Email Address" required />
                        <div class="text-center">
                            <img src="@Url.Action("Forget_PWD__GetCaptchaImage", "Home" )" id="C_img3" />
                            <span class="refreshicon"><i class="fa fa-refresh" onclick="refress2()"></i></span>
                            <span id="Grv_captcha" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>

                        </div>
                        <div class="text-center captch_div">
                            <label for="message">Enter the code above here </label>
                            <input type="text" class="" style="width:60%;" name="clientCaptcha" autocomplete="off" id="clientCaptcha2" placeholder="Type the text" required />

                            <p id="status3" class="error_captch" style="font-weight:bold;color:red;"></p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="" class="btn btn-default" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="ForgetPassWord_Info()">Submit</button>
                        <input type="submit" id="Btn_forgetClick" hidden />
                    </div>

                }
            </div>
            <div id="password_change_id" style="display:none">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="myModalLabel">Change Password</h4>
                </div>

                <div class="modal-body">
                    <input type="text" class="form-control" name="old_password" id="old_password" placeholder="Enter old password" required />
                    <input type="text" class="form-control" name="gmail_change" id="gmail_change" placeholder="Enter your Email" required />
                    <input type="text" class="form-control" name="new_password" id="new_password" placeholder="Enter New password" required />
                    <input type="text" class="form-control" name="confirm_password" id="confirm_password" placeholder="Enter Confirm password" required />

                </div>
                <div class="modal-footer">
                    <button type="button" id="f_close_btn" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="ChangePassword()">Change Password</button>
                </div>
            </div>
            <div class="text-center" id="">
                <label style="color:red" id="AlertInfo_mail"></label>
            </div>

        </div>

    </div>
</div>
<script src="~/Scripts/validations.js"></script>
<script type="text/javascript">
    //var token = "";
    //function Token_generate() {
    //    var form = $('#__AjaxAntiForgeryForm');
    //    token = $('input[name="__RequestVerificationToken"]', form).val();
    //}
    //alert('This website is under construction, Few modules are available for view purpose only');
    $(".toggle-password").click(function () {
        $(this).toggleClass("fa-eye fa-eye-slash");
        var input = $($(this).attr("toggle"));
        if (input.attr("type") == "password") {
            input.attr("type", "text");
        } else {
            input.attr("type", "password");
        }
    });


    $('#userconfirmpassword').on('change', function () {

        //// alert($('#usercreatepassword').val());
        // alert($('#userconfirmpassword').val());

        if ($('#usercreatepassword').val() != $('#userconfirmpassword').val()) {
            //   alert("not equal");
            $('#message').css("display", "block");
            return false;
        }
        else {
            $('#message').css("display", "none");
            return false;
        }
    });

</script>
<!--password iconscript End-->
<!--Nodel officer pop script start-->
<script type="text/javascript">
        var Jsondata = "";
        var Jsondata2 = "";
        var StateName = "0";
        var DistName = "0";
        var BlockName = "0";
        var SessionTabName = "WSP_HOME_WSP";

        $(document).ready(function () {
            debugger;
            Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.list));
            DropDownInfo();
            /*State_Bind();*/
            debugger;
            refress();
            refress1();
            refress2();
            $('#Session_Name').val(SessionTabName);
            $('#District1').hide();
            $('#State1').hide();
            $('#Block1').hide();
            $('#Gram1').hide();
            $('#state').hide();

            $('#dist').hide();

            $('#block').hide();

            $('#gram').hide();
            $('#village').hide();

            //  DropDownInfo();



            // Error_Info();
            $("#Change").css("display", "none");



            if ($('#change').val() == 'Nodal Officer') {
                // $('#modal1').modal('hide');
                $('#District1').hide();
                $('#State1').hide();
                $('#Block1').hide();
                $('#Gram1').hide();
                $('#state').hide();

                $('#dist').hide();

                $('#block').hide();

                $('#gram').hide();
                $('#village').hide();


            }

            $.noConflict();

            $('#example_admin').DataTable();
            $('#example44').DataTable();


            $('[data-id]').on('click', function (e) {/*h4.uppercas*/
                e.preventDefault();
                if ($(this).hasClass("uppercas")) {

                    $(this).parent().addClass('append');
                    $(this).parent().siblings().removeClass('append');
                }
                var ref = $(this).attr('data-id');
                $('div[id^="MIS"]').hide();
                $("#" + ref).fadeIn(500);
            });


            $('[data-content]').on('click', function (e) {/*h4.uppercas*/
                e.preventDefault();
                if ($(this).hasClass("change_image")) {

                    $(this).parent().addClass('append');
                    $(this).parent().siblings().removeClass('append');
                }
                var ref = $(this).attr('data-content');
                $('div[id^="gwm"]').hide();
                $("#" + ref).fadeIn(500);
            });


        });

        function Error() {
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: "/WspNew/Error_Info",
                data: '',
                dataType: 'JSON',
                success: function (response) {
                    debugger;
                    $('#status').text('');
                    $('#status1').text('');
                    $('#status3').text('');
                    $('#useremail').val();
                    $('#userpassword').val('');
                    if (response.length != 0) {

                        $('#District1').hide();
                        $('#State1').hide();
                        $('#Block1').hide();
                        $('#Gram1').hide();
                        $('#state').hide();

                        $('#dist').hide();

                        $('#block').hide();

                        $('#gram').hide();
                        $('#village').hide();
                        debugger;
                        if (response[0].user_type == "ForgetPassword") {

                            // $('#myModal').modal('show');
                            // $('#myModal').show();
                            $('#FPassword')[0].click();
                            $('#status3').text(response[0].error_test);
                            $('#forget_password_email').val(response[0].user_email);
                        }
                        else if (response[0].user_type == "MisSignup") {
                            $('#MISLOGIN').hide();

                            $('#MISSIGUP').show();

                            $('#reg_tab_id').css("background", "#337ab7");
                            $('#reg_tab_id').css("color", "#fff");
                            $('#login_tab_id').css("background", "#fff");
                            $('#reg_tab_id_span').css("background", "337ab7");
                            // $('#reg_tab_id_span').css("color", "black");
                            $('#login_tab_id').css("color", "black");
                            $('#login_tab_id_span').css("background", "#fff");
                            $('#login_tab_id_span').css("color", "black");

                            $('#AlertInfo').text(response[0].error_test);

                            if (response[0].nodal_officer == "National Level Nodal Officer") {

                            }
                            else if (response[0].nodal_officer == "State Level Nodal Officer") {
                                $('#state').show();
                                $("#state").val(response[0].state_name);


                            } else if (response[0].nodal_officer == "District Level Nodal Officer") {
                                $('#state').show();
                                $('#dist').show();
                                $("#state").val(response[0].state_name);
                                State_Fun1(response[0].district_name);
                                $("#dist").val(response[0].district_name);
                            }
                            else if (response[0].nodal_officer == "Block Level Nodal Officer") {
                                $('#state').show();
                                $('#dist').show();
                                $('#block').show();
                                $("#state").val(response[0].state_name);
                                State_Fun1(response[0].district_name);
                                $("#dist").val(response[0].district_name);
                                Dist_Fun1(response[0].block_name);
                                $("#block").val(response[0].block_name);


                            }
                            else {
                                $('#state').show();
                                $('#dist').show();
                                $('#block').show();
                                $('#gram').show();
                                $("#state").val(response[0].state_name);
                                State_Fun1(response[0].district_name);
                                $("#dist").val(response[0].district_name);
                                Dist_Fun1(response[0].block_name);

                                $("#block").val(response[0].block_name);
                                Block_Fun1(response[0].gpname);
                                $("#gram").val(response[0].gpname);
                                // $('#village').show();
                            }

                            $("#usercreatepassword").val(response[0].user_password);
                            $("#userconfirmpassword").val(response[0].user_password);
                            $("#username1").val(response[0].user_name);
                            $("#Signup_useremail").val(response[0].user_email);
                            $('#NodalOfficer').val(response[0].nodal_officer);
                            $("#mobilenumber").val(response[0].mobile);
                            $("#department").val(response[0].department);

                        }
                        else if (response[0].user_type == "login") {
                            $('#userpassword').val(response[0].user_password);
                            $('#status').text(response[0].error_test);
                            $('#useremail').val(response[0].user_email);
                        }

                    }
                }
            });
        }
        function DropDownInfo() {

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/Sign_Up_DropdownInfo",
                data: "{ }",
                dataType: 'JSON',
                success: function (response) {

                    if (response.length != 0) {
                        Jsondata2 = response;
                        $("#state").empty();
                        var opstate = '<option value="0">Select State Name</option>';
                        $("#state").append(opstate);
                        $("#dist").empty();
                        var opdist = '<option value="0">Select District</option>';
                        $("#dist").append(opdist);
                        $("#block").empty();
                        var opblock = '<option value="0">Select Block</option>';
                        $("#block").append(opblock);
                        $("#gram").empty();
                        var opgram = '<option value="0">Select Gram Panchayat</option>';
                        $("#gram").append(opgram);
                        //var StateName = $("#spnstate").text();
                        if (Jsondata2.length != 0) {
                            var ddlst = {};
                            var all_dists = [];
                            var optionState = '';
                            for (var i = 0; i < Jsondata2.length; i++) {

                                if (!ddlst[Jsondata2[i].state_name]) {
                                    all_dists.push(Jsondata2[i].state_name);
                                    ddlst[Jsondata2[i].state_name] = Jsondata2[i].state_name;

                                }
                            }
                            var DistArray = [];
                            DistArray = all_dists.sort(function (a, b) {
                                if (a < b) return -1;
                                else if (a > b) return 1;
                                return 0;
                            });
                            optionState = '<option value="0">Select State Name</option>';
                            for (var i = 0; i < DistArray.length; i++) {
                                if (DistArray[i] != null && DistArray[i] != "") {
                                    optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                                }
                            }
                            $("#state").html(optionState);
                        }

                    }

                }
            });
        }

        function State_Dropdown_Function() {
            debugger;
            $("#dist").empty();
            var opdist = '<option value="0">Select District</option>';
            $("#dist").append(opdist);
            $("#block").empty();
            var opblock = '<option value="0">Select Block</option>';
            $("#block").append(opblock);
            $("#gram").empty();
            var opgram = '<option value="0">Select Gram Panchayat</option>';
            $("#gram").append(opgram);

            StateName = $("#state").val();


            if (StateName != "0" && Jsondata2.length != 0) {
                var ddlst = {};
                var all_dists = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata2.length; i++) {
                    if (StateName == Jsondata2[i].state_name) {

                        if (!ddlst[Jsondata2[i].district_name]) {
                            all_dists.push(Jsondata2[i].district_name);
                            ddlst[Jsondata2[i].district_name] = Jsondata2[i].district_name;

                        }
                    }
                }


                var DistArray = [];
                DistArray = all_dists.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < DistArray.length; i++) {
                    if (DistArray[i] != null && DistArray[i] != "") {
                        optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                    }
                }
                $("#dist").append(optionDist);
            }

        }



        function Dist_fun() {
            debugger;
            $("#block").empty();
            var opblock = '<option value="0">Select Block</option>';
            $("#block").append(opblock);
            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);

            DistName = $("#dist").val();

            if (DistName != "0" && Jsondata2.length != 0) {
