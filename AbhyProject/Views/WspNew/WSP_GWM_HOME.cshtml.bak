                var all_blocks = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata2.length; i++) {
                    if (DistName == Jsondata2[i].district_name && StateName == Jsondata2[i].state_name) {

                        if (!ddlst[Jsondata2[i].block_name]) {
                            all_blocks.push(Jsondata2[i].block_name);
                            ddlst[Jsondata2[i].block_name] = Jsondata2[i].block_name;
                            //  $("#block").append(optionDist);
                        }
                    }
                }


                var BlockArray = [];
                BlockArray = all_blocks.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < BlockArray.length; i++) {
                    if (BlockArray[i] != null && BlockArray[i] != "") {
                        optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                    }
                }
                $("#block").append(optionDist);

            }
        }



        function Block_fun() {
            debugger;
            $("#gram").empty();
            var opgram = '<option value="0">Select Gram Panchayat</option>';
            $("#gram").append(opgram);
            BlockName = $("#block").val();

            if (BlockName != "0" && Jsondata2.length != 0) {
                var ddlst = {};
                var all_grams = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata2.length; i++) {
                    if (StateName == Jsondata2[i].state_name && DistName == Jsondata2[i].district_name && BlockName == Jsondata2[i].block_name) {

                        if (!ddlst[Jsondata2[i].gram_panchayat_name]) {
                            ddlst[Jsondata2[i].gram_panchayat_name] = Jsondata2[i].gram_panchayat_name;
                            all_grams.push(Jsondata2[i].gram_panchayat_name);
