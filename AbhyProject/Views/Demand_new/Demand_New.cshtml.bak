        .headings_border {
            position: relative;
            color: white;
            font-size: 25px;
            text-align: center;
            font-family: raleway;
            font-weight: 900;
            display: inline-block;
            padding-left: 15px;
        }

            .headings_border::after {
                content: '';
                position: absolute;
                top: 45px;
                left: 13%;
                width: 168px;
                height: 2px;
                /*background: #5cb85c;*/
            }

        .headings_border_gram {
            position: relative;
            color: white;
            font-size: 25px;
            text-align: center;
            font-family: raleway;
            font-weight: 900;
            display: inline-block;
            padding-left: 15px;
        }

            .headings_border_gram::after {
                content: '';
                position: absolute;
                top: 45px;
