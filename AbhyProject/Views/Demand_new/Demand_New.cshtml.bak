        function sarpanch_getting() {
            debugger;
            $('.loader').show();
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Demand_new/Demand_report_data',
                data: '',
                dataType: 'JSON',
                success: function (data) {
                    debugger;
                    var tr = '';
                    var sno = 0;
                    var data = data;
                    if (data == 'No Data') {
                        tr = '<tr colspan="11"><td colspan="11" style="text-align: center;"></td></tr>';
                        $('#existingtotal').text(0);
                    }
                    else {
                        if (data.length != 0) {

                            if (StateOfficer == "District Level Nodal Officer") {
                                for (var i = 0; i < data.length; i++) {
                                    var reject = data[i].reject;
                                    if (reject == null) {
                                        reject = "";
                                    }
                                    var approval = data[i].approval;
                                    if (approval == null) {
                                        approval = "";
                                    }
                                    var schemeother = data[i].schemeother;
                                    if (schemeother == null) {
                                        schemeother = "";
                                    }
                                    if (approval == "District") {
                                        if (data[i].new_row == "1") {

                                            var schemeother = data[i].schemeother;
                                            if (schemeother == null) {
                                                schemeother = "";
                                            }
                                            var ddother = data[i].typeother;
                                            if (ddother == null) {
                                                ddother = "";
                                            }
                                            sno += 1;

                                            tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].area_converged_new + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td></td><td><label style="color: green;">Submited To SPMU</label></td> </tr> ';

                                        }
                                        else if (data[i].new_row == "2") {
                                            var schemeother = data[i].schemeother;
                                            if (schemeother == null) {
                                                schemeother = "";
                                            }
                                            var ddother = data[i].typeother;
                                            if (ddother == null) {
                                                ddother = "";
                                            }
                                            tr += '<tr id="AWP1_TR_new' + i + '"><td></td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].area_converged_new + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td></td><td><label style="color: green;">Submited To SPMU</label></td> </tr> ';

