        var old_id = 0;
        function Insert_data(id, abc) {

            var xx = 0;
            old_id = id;
            var state_name = $('#state_name' + abc).val();
            var district_name = $('#district_name' + abc).val();
            var block_name = $('#block_name' + abc).val();
            var gp_name = $('#gp_name' + abc).val();
            var year = $('#claim_year' + abc).val();
            var latitude = $('#latitude' + abc).val();
            var longitude = $('#longitude' + abc).val();
            var type = $('#type' + abc).val();
            var typeother = $('#typeother' + abc).val();
            var department_name = $('#department_name' + abc).val();
            var scheme_name = $('#scheme_name' + abc).val();
            var proposed_area = $('#proposed_area' + abc).val();
            var approximate_cost = $('#approximate_cost' + abc).val();
            var work_start = $('#da' + abc).val();
            var work_completion = $('#ea' + abc).val();
            var department_name_new = $('#fa' + abc).val();
            var scheme_name_new = $('#ga' + abc).val();
            var area_converged = $('#ha' + abc).val();
            var expenditure_incurred = $('#ia' + abc).val();
            var ataljal_incentive = $('#ja' + abc).val();
            var remark = $('#ka' + abc).val();


            if (xx == 0) {
                $.ajax({
                    url: "/Demand_new/Save_data",
                    type: "POST",
                    data: function () {

                        var data = new FormData();
                        data.append("old_id", old_id);
                        data.append("state_name", jQuery('#state_name' + abc).val());
                        data.append("district_name", jQuery('#district_name' + abc).val());
                        data.append("block_name", jQuery('#block_name' + abc).val());
                        data.append("gp_name", jQuery('#gp_name' + abc).val());
                        data.append("year", jQuery('#claim_year' + abc).val());
                        data.append("latitude", jQuery('#latitude' + abc).val());
                        data.append("longitude", jQuery('#longitude' + abc).val());
                        data.append("type", jQuery('#type' + abc).val());
                        data.append("typeother", jQuery('#typeother' + abc).val());
                        data.append("department_name", jQuery('#department_name' + abc).val());
                        data.append("scheme_name", jQuery('#scheme_name' + abc).val());
                        data.append("proposed_area", jQuery('#proposed_area' + abc).val());
                        data.append("approximate_cost", jQuery('#approximate_cost' + abc).val());
                        data.append("work_start", jQuery('#da' + abc).val());
                        data.append("work_completion", jQuery('#ea' + abc).val());
                        data.append("department_name_new", jQuery('#fa' + abc).val());
                        data.append("scheme_name_new", jQuery('#ga' + abc).val());
                        data.append("area_converged", jQuery('#ha' + abc).val());
                        data.append("expenditure_incurred", jQuery('#ia' + abc).val());
                        data.append("ataljal_incentive", jQuery('#ja' + abc).val());
                        data.append("remark", jQuery('#ka' + abc).val());
                        data.append("departmentother", jQuery('#departmentother' + abc).val());
                        data.append("schemeother", jQuery('#schemeother' + abc).val());


                        return data;
                    }(),
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        alert(response);
                        if (response == "Logout") {
                            window.location = "/WspNew/WSP_GWM_HOME";
                        }
                        else if (response == "Successfully Saved") {
                            Update_data(old_id);
                        }

                    },
                    error: function (jqXHR, textStatus, errorMessage) {
                        console.log(errorMessage);
                    }
                });
            }
        }


        function Update_data() {

            var i = 0;
            var id = old_id;

            if (i == 0) {


                var formdata = new FormData();
                formdata.append("id", id);
                $.ajax({
                    url: '/Demand_new/Update_data',
                    data: formdata,
                    type: 'POST',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        /*alert(response);  */
                        Data_get();
                    }
                });
            }
        }

        function Update(id, i) {
            debugger;
            $('.loader').show();
            var xx = 0;
            var id = id;
            var date1 = $('#d' + i).val();
            var date2 = $('#e' + i).val();
            var date3 = $('#f' + i).val();
            var date4 = $('#g' + i).val();
            var date6 = $('#ha' + i).val();
            var date7 = $('#ia' + i).val();
            var date8 = $('#ka' + i).val();

            if (date1 == "0") {
                xx = 1;
                alert("Please Select Year Of Subsidy Disbursement");
                $('.loader').hide();
            }

            else if (date3 == "0") {
                xx = 1;
                alert("Please Select Department Name");
                $('.loader').hide();
            }
            else if (date4 == "0") {
                xx = 1;
                alert("Please Select Scheme Name");
                $('.loader').hide();
            }
            else if (date4 != "Other") {
                $('#ssother' + i).val("");
            }
            else if (date4 == "Other") {
                var date5 = $('#ssother' + i).val();
                if (date5 == "") {
                    xx = 1;
                    alert("Please Enter Scheme Name Other");
                    $('.loader').hide();
                }
            }
            if (date6 == "") {
                xx = 1;
                alert("Please Enter Area converged (in ha)");
                $('.loader').hide();
            }
            if (date7 == "") {
                xx = 1;
                alert("Please Enter Expenditure incurred other than Atal jal (in lakh)");
                $('.loader').hide();
            }




            if (xx == 0) {
                $.ajax({
                    url: '/Demand_new/Update',
                    type: "POST",
                    data: function () {

                        var data = new FormData();
                        data.append("id", id);
                        data.append("state_name", jQuery('#state_name' + i).val());
                        data.append("district_name", jQuery('#district_name' + i).val());
                        data.append("block_name", jQuery('#block_name' + i).val());
                        data.append("gp_name", jQuery('#gp_name' + i).val());
                        data.append("year", jQuery('#year' + i).val());
                        data.append("latitude", jQuery('#latitude' + i).val());
                        data.append("longitude", jQuery('#longitude' + i).val());
                        data.append("type", jQuery('#type' + i).val());
                        data.append("typeother", jQuery('#typeother' + i).val());
                        data.append("department_name", jQuery('#department_name' + i).val());
                        data.append("scheme_name", jQuery('#scheme_name' + i).val());
                        data.append("proposed_area", jQuery('#proposed_area' + i).val());
