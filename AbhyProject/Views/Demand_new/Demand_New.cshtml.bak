            var date4 = $('#gnew' + abc).val();
            var date5 = $('#ssothernew' + abc).val();
            var date6 = $('#h' + abc).val();
            var date7 = $('#i' + abc).val();
            var date8 = $('#k' + abc).val();

            if (date1 == "0") {
                xx = 1;
                alert("Please Select Year Of Subsidy Disbursement");
                $('.loader').hide();
            }

            else if (date3 == "0") {
                xx = 1;
                alert("Please Select Department Name");
                $('.loader').hide();
