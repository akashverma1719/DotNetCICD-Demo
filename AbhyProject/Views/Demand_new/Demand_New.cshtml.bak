                                            tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].area_converged_new + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td>' + data[i].reject + '</td><td><label style="color: red;">Rejected</label></td> </tr> ';

                                        }
                                        else if (data[i].new_row == "2") {
                                            var schemeother = data[i].schemeother;
                                            if (schemeother == null) {
                                                schemeother = "";
                                            }
                                            var ddother = data[i].typeother;
                                            if (ddother == null) {
                                                ddother = "";
                                            }
                                            tr += '<tr id="AWP1_TR_new' + i + '"><td></td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].area_converged_new + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td>' + data[i].reject + '</td><td><label style="color: red;">Rejected</label></td></tr> ';

                                        }

                                    }
                                    else {
                                        if (data[i].new_row == "1") {

                                            var schemeother = data[i].schemeother;
                                            if (schemeother == null) {
                                                schemeother = "";
                                            }
                                            var ddother = data[i].typeother;
                                            if (ddother == null) {
                                                ddother = "";
                                            }
                                            sno += 1;

                                            tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].area_converged_new + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td></td><td><label style="color: Black;">At DPMU</label></td> </tr> ';

                                        }
                                        else if (data[i].new_row == "2") {
                                            var schemeother = data[i].schemeother;
                                            if (schemeother == null) {
                                                schemeother = "";
                                            }
                                            var ddother = data[i].typeother;
                                            if (ddother == null) {
                                                ddother = "";
                                            }
                                            tr += '<tr id="AWP1_TR_new' + i + '"><td></td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].area_converged_new + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td></td><td><label style="color: Black;">At DPMU</label></td> </tr> ';

                                        }
                                        else if (data[i].new_table_entry != "1") {
                                            var ddother = data[i].other_measures;
                                            if (ddother == null) {
                                                ddother = "";
                                            }
                                            sno += 1;
                                            tr += '<tr id="AWP1_TR' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td>' + data[i].latitude_gp_centre_point + '</td><td>' + data[i].longitude_gp_centre_point + '</td><td>' + data[i].claim_year + '</td><td>' + data[i].type + '</td><td>' + ddother + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].proposed_area + '</td><td>' + data[i].approximate_cost + '</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td> </tr> ';

                                        }
                                    }

                                }
                            }

                        }
                        debugger;
                        $('#tbl_details_Excel').html(tr);
                        $('#existing_well_total').html(sno);

                    }
                    $('.loader').hide();
                }
            });
        }


        function isNumberKey(txt, evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode == 46) {
                //Check if the text already contains the . character
                if (txt.value.indexOf('.') === -1) {
                    return true;
                } else {
                    return false;
                }
            } else {
                if (charCode > 31 &&
                    (charCode < 48 || charCode > 57))
                    return false;
            }
            return true;
        }

        function ChangeByYear() {
            if ($("#year").val() == "2023-24") {
                $("#demandside_new").show();
                $("#demandside").hide();

            }
            else {
                $("#demandside_new").hide();
                $("#demandside").show();
            }
        }

