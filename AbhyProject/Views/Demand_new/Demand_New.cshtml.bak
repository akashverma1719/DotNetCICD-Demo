        function Delete_data(ss) {
            $('.loader').show();
            var obj = {};
            obj.id = ss;
            $.ajax({
                type: "POST",
                contentType: "application/json;charset=utf-8",
                url: "/Demand_new/Delete_data",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else if (response == "Deleted Successfully") {
                        Data_get();
                    }
                }
            });
        }
        var idold = 0;
        function Delete(oldid, ss) {
            $('.loader').show();
            idold = oldid;
            var obj = {};
            obj.id = ss;
            $.ajax({
                type: "POST",
                contentType: "application/json;charset=utf-8",
                url: "/Demand_new/Delete_data",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else if (response == "Deleted Successfully") {
                        Update_data_new(idold);
                    }
                    else if (response == "No Data") {
                        $('.loader').hide();
                    }
                }
            });
        }

