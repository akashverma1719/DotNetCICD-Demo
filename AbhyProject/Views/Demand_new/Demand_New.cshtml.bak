    <script>

   var Jsondata = "";

    var WaterAvialability = 0;
    var WaterDropt = 0;
    var AA = 0, DD = 0;
    var State = "0";
    var Dist = "0";
    var Block = "0";
    /*var Gram = "0";*/
        var off_1 = "";
        var Gram = "0";
        var StateOfficer = '';
        $(document).ready(function () {
         StateOfficer = '@Session["Officer"]';
            if (StateOfficer == "") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            else if (StateOfficer == "Gram Panchyat Nodal Officer") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            $("#demandside_new").hide();
        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
        $('#supply_side').hide();
            $('#Demand_side').hide();
            $('#ddldemand').hide();
            $('#btnpreexe').hide();
            $('#btnnextexe').hide();
            $('#pdf').prop('disabled', true);
            $('#excel').prop('disabled', true);
            $('#Excel').hide();


            DropDownInfo();
            ddldemandside();



    });
    function pagechange() {
        window.location = "WspWaterAvailability", "WspNew"
    }
    </script>

    <script type="text/javascript">



        function Goto_page() {
            window.location = "/Demand_new/Supply_New";

        }

        function Report_PDF() {
            debugger;
            var ddldemand = $('#ddldemand').val();
            var demand_val = $('#Demand_side').val();

            if (State == "0") {
                alert("Please Select State");
                return false;
            }
            else if (ddldemand == "Demand Side") {
                if (demand_val == '0') {
                    alert("Please Select Demand side");
                    return false;
                }
            }
            {
                window.location = "/Demand_new/demand_report";
            }
        }

        function Excel() {
            debugger;
            var year = $("#year").val();
            var ddldemand = $('#ddldemand').val();
            var demand_val = $('#Demand_side').val();

            if (State == "0") {
                alert("Please Select State");
                return false;
            }
            {
                window.location.href = "/Demand_new/Demand_excel?State=" + State + "&Dist=" + Dist + "&Block=" + Block + "&Gram=" + Gram + "&Year=" + year + "&demand_val=" + demand_val + "&ddldemand=" + ddldemand;
            }
        }

        function SessionInfo() {

            var obj = {};
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Demand_new/State_SessionInfo_1",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (data) {

                    if (data == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else {
                        $('#Error_').text("");

                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();

                        var Str = data.split(',');
                        if (Str[0] == "Admin") {
                            $('#StateLabel').hide();
                            $('#StateDropdownLabel').show();
                            $('#DistLabel').hide();
                            $('#DistDropdownLabel').show();
                            $('#BlockLabel').hide();
                            $('#BlockDropdownLabel').show();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            $('.loader').hide();
                        }
                        else if (Str[0] == "State Level Nodal Officer") {
                            State = Str[1];
                            off_1 = "state";
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').hide();
                            $('#DistDropdownLabel').show();
                            $('#BlockLabel').hide();
                            $('#BlockDropdownLabel').show();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            State_Dropdown_Function();
                            State_Dropdown_Function();
                            $('.loader').hide();

                        }
                        else if (Str[0] == "District Level Nodal Officer") {
                            off_1 = "dist";
                            State = Str[1];
                            Dist = Str[2];
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').show();
                            $('#DistDropdownLabel').hide();
                            $('#BlockLabel').hide();
                            $('#BlockDropdownLabel').show();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            Dist_fun();
                            Dist_fun();
                            $('.loader').hide();

                        }
                        else if (Str[0] == "Block Level Nodal Officer") {
                            off_1 = "block";
                            State = Str[1];
                            Dist = Str[2];
                            Block = Str[3];
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').show();
                            $('#DistDropdownLabel').hide();
                            $('#BlockLabel').show();
                            $('#BlockDropdownLabel').hide();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            Block_fun();
                            Block_fun();
                            $('.loader').hide();


                        }
                        else if (Str[0] == "Gram Panchyat Nodal Officer") {
                            State = Str[1];
                            Dist = Str[2];
                            Block = Str[3];
                            Gram = Str[4];
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').show();
                            $('#DistDropdownLabel').hide();
                            $('#BlockLabel').show();
                            $('#BlockDropdownLabel').hide();
                            $('#GramLabel').show();
                            $('#GramDropdownLabel').hide();
                            $('#DropdownSearch_btn').show();
                            $('.loader').hide();



                        }


                    }
                }

            });

        }
        function DropDownInfo() {

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/Sign_Up_DropdownInfo",
                data: "{ }",
                dataType: 'JSON',
                success: function (response) {

                    if (response.length != 0) {
                        Jsondata = response;
                        $("#spnstate").empty();
                        var opstate = '<option value="0">Select StateName</option>';
                        $("#spnstate").append(opstate);
                        $("#dist11").empty();
                        var opdist = '<option value="0">Select District</option>';
                        $("#dist11").append(opdist);
                        $("#block1").empty();
                        var opblock = '<option value="0">Select Block</option>';
                        $("#block1").append(opblock);
                        $("#gram").empty();
                        var opgram = '<option value="0">Select GramPanchayat</option>';
                        $("#gram").append(opgram);
                        //var StateName = $("#spnstate").text();
                        if (Jsondata.length != 0) {
                            var ddlst = {};
                            var all_dists = [];
                            var optionState = '';

                            for (var i = 0; i < Jsondata.length; i++) {

                                if (!ddlst[Jsondata[i].state_name]) {
                                    all_dists.push(Jsondata[i].state_name);
                                    ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                                }
                            }
                            var DistArray = [];
                            DistArray = all_dists.sort(function (a, b) {
                                if (a < b) return -1;
                                else if (a > b) return 1;
                                return 0;
                            });
                            optionState = '<option value="0">Select StateName</option>';
                            /*optionState += '<option value="All">ALL</option>';*/

                            for (var i = 0; i < DistArray.length; i++) {
                                if (DistArray[i] != null && DistArray[i] != "") {
                                    optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';

                                }
                            }
                            $("#spnstate").html(optionState);

                        }

                    }

                    SessionInfo();


                }
            });
        }
        function DBG_hide() {
            var state = $("#spnstate").val();
            if (state == "All") {
                $('#DistDropdownLabel').hide();
                $('#BlockDropdownLabel').hide();
                $('#GramDropdownLabel').hide();
            }
            else {
                $('#DistDropdownLabel').show();
                $('#BlockDropdownLabel').show();
                $('#GramDropdownLabel').show();
            }
        }

        function State_Dropdown_Function() {
            DBG_hide();
            $("#dist11").empty();
            var opdist = '<option value="0">Select District</option>';
            $("#dist11").append(opdist);
            $("#block1").empty();
            var opblock = '<option value="0">Select Block</option>';
            $("#block1").append(opblock);
            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);

            var StateName = $("#spnstate").val();
            if (off_1 == "state") {
                StateName = State;
            } else {
                State = StateName;
            }

            if (StateName != "0" && Jsondata.length != 0) {
                var ddlst = {};
                var all_dists = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata.length; i++) {
                    if (StateName == Jsondata[i].state_name) {

                        if (!ddlst[Jsondata[i].district_name]) {
                            all_dists.push(Jsondata[i].district_name);
                            ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                        }
                    }
                }


                var DistArray = [];
                DistArray = all_dists.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < DistArray.length; i++) {
                    if (DistArray[i] != null && DistArray[i] != "") {
                        optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                    }
                }
                $("#dist11").append(optionDist);
            }

        }
        function Dist_fun() {

            $("#block1").empty();
            var opblock = '<option value="0">Select Block</option>';
            $("#block1").append(opblock);
            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);

            var dist = $("#dist11").val();
            if (off_1 == "dist") {
                dist = Dist;
            } else {
                Dist = dist;
            }

            if (dist != "0" && Jsondata.length != 0) {
                var ddlst = {};
                var all_blocks = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata.length; i++) {
                    //if (Jsondata[i].district_name == 'Kaithal' ) {
                    //    alert(dist);

                    //    return;
                    //}

                    if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                        if (!ddlst[Jsondata[i].block_name]) {
                            all_blocks.push(Jsondata[i].block_name);
                            ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                            //  $("#block").append(optionDist);
                        }
                    }
                }


                var BlockArray = [];
                BlockArray = all_blocks.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < BlockArray.length; i++) {
                    if (BlockArray[i] != null && BlockArray[i] != "") {
                        optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                    }
                }
                $("#block1").append(optionDist);

            }
        }
        function Block_fun() {

            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);
            var block = $("#block1").val();

            if (off_1 == "block") {
                block = Block;
            } else {
                Block = block;
            }


            if (block != "0" && Jsondata.length != 0) {
                var ddlst = {};
                var all_grams = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata.length; i++) {
                    if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                        if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                            ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                            all_grams.push(Jsondata[i].gram_panchayat_name);
                            //   $("#gram").append(optionDist);
                        }
                    }
                }


                var GramArray = [];
                GramArray = all_grams.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < GramArray.length; i++) {
                    if (GramArray[i] != null && GramArray[i] != "") {

                        optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
                    }
                }
                $("#gram").append(optionDist);
            }
        }
        function Gram_change() {

            var Gram = $("#gram").val();
            if (Gram == "0") {
                /* alert("Please Select Grampanchayat");*/
            }
            else {
                Gram = $('#gram').val();

            }
        }
        function Dropdown_Search() {
            $('.loader').show();
            if ($("#year").val() == "2023-24") {
                if ($("#phase").val() == "0") {
                    alert("Please Select Phase");
                    $('.loader').hide();
                    $("#phase").focus();
                }
            } 
            var ddldemand = $('#ddldemand').val();
            var demand_val = $('#Demand_side').val();
            var supply_side = $('#supply_side').val();

            Gram = $('#gram').val();
            /* var Gram = $('#gram').val();*/
            //if (Gram == "0") {

            //} else {

            //}

            var xx = 0;
            if (State == "0") {
                xx = 1;
                alert("Please Select State Name");
                $('.loader').hide();
            }
            if (StateOfficer != "Admin" && StateOfficer != "National Level Nodal Officer") {
                if (Dist == "0") {
                    xx = 1;
                    alert("Please Select District Name");
                    $('.loader').hide();
                }
                else if (StateOfficer != "State Level Nodal Officer") {
                    if (Block == "0") {
                        xx = 1;
                        alert("Please Select Block Name");
                        $('.loader').hide();
                    }
                    else if (ddldemand == "Demand Side") {
                        if (demand_val == '0') {
                            xx = 1;
                            alert("Please Select Demand side");
                            $('.loader').hide();
                        }
                    }
                    else if (ddldemand == "Supply Side") {
                        if (supply_side == '0') {
                            xx = 1;
                            alert("Please Select Supply side");
                            $('.loader').hide();
                        }
                    }
                }
            }
            else {
                if (ddldemand == "Demand Side") {
                    if (demand_val == '0') {
                        xx = 1;
                        alert("Please Select Demand side");
                        $('.loader').hide();
                    }
                }
                else if (ddldemand == "Supply Side") {
                    if (supply_side == '0') {
                        xx = 1;
                        alert("Please Select Supply side");
                        $('.loader').hide();
                    }
                }
            }


            if (xx == 0) {

                $.ajax({
                    type: "Post",
                    url: "/Home/StateLevel_Dropdown",
                    contentType: "application/json;charset=utf-8",
                    data: "{'StateName':'" + State + "','Dist':'" + Dist + "','Block':'" + Block + "','Gram':'" + Gram + "'}",
                    dataType: "json",
                    success: function (results) {
                        Dropdown_session();


                    }
                });
            }
        }

        function Dropdown_session() {
            $('.loader').show();
            var ddldemand = $('#ddldemand').val();
            var demand_val = $('#Demand_side').val();
            var year = $('#year').val();
            var xx = 0;
            if (xx == 0) {

                $.ajax({
                    type: "Post",
                    url: "/Demand_new/ddlsession",
                    contentType: "application/json;charset=utf-8",
                    data: "{'ddldem':'" + ddldemand + "','demand_v':'" + demand_val + "','yea':'" + year + "'}",
                    dataType: "json",
                    success: function (results) {

                        $('#pdf').prop('disabled', false);
                        if (ddldemand == "All") {
                            Data_get();
                            /*sarpanch_getting();*/

                        }
                        else if (ddldemand == "Demand Side") {
                            Data_get();
                            /*sarpanch_getting();*/
                        }
                        else if (ddldemand == "Supply Side") {

                        }
                    }
                });
            }
        }

        function ddldemandside() {
            var ddl = $('#ddldemand').val();
            if (ddl == "Demand Side") {
                $('#Demand_side').show();
                $('#supply_side').hide();
                $('#supplyside').hide();
                $('#demandside').show();
                $('#supply_side').val("0");
            }
            else if (ddl == "Supply Side") {
                $('#supply_side').show();
                $('#Demand_side').hide();
                $('#supplyside').show();
                $('#demandside').hide();
                $('#Demand_side').val("0");
            }
            else if (ddl == "All") {
                $('#supply_side').hide();
                $('#Demand_side').hide();
                $('#supplyside').show();
                $('#demandside').show();

                $('#supply_side').val("0");
                $('#Demand_side').val("0");


            }
        }


        var PageNumberexe = 1;
        var snoexe = 0;
        var countexe = 0;
        var j = 0;

        function Data_get() {

            var year = $('#year').val();
            var month = $('#month').val();
            var demand_val = $('#Demand_side').val();
            var ddldemand = $('#ddldemand').val();

            var obj = {};
            obj.statename = State;
            obj.districtname = Dist;
            obj.blockname = Block;
            obj.gpname = Gram;
            obj.year = year;
            obj.month = month;
