        function enforceNumberValidation(i, ele) {

            let j = i.toString();
            /*var i = aaa;*/
            var match = false;
            var match2 = false;
            var matchwr = false;
            var matchwr2 = false;
            var lat = $('#cf' + j).val();
            var long = $('#cg' + j).val();




            if (!(lat.indexOf(".") == -1)) {
                match = true; // decimal
            } else {
                match = false;
            }
            if (lat.length == 2 && match != true) {
                $('#cf' + j).val(lat + '.');
            } else if (lat.length == 1 && match != false) {
                $('#cf' + j).val('');
            }


            if (!(long.indexOf(".") == -1)) {
                match2 = true; // decimal
            } else {
                match2 = false;
            }
            if (long.length == 2 && match2 != true) {
                $('#cg' + j).val(long + '.');
            } else if (long.length == 1 && match2 != false) {
                $('#cg' + j).val('');
            }


            var latwr = $('#cf' + j).val();
            var longwr = $('#cg' + j).val();

            if (!(latwr.indexOf(".") == -1)) {
                matchwr = true; // decimal
            } else {
                matchwr = false;
            }
            if (latwr.length == 2 && matchwr != true) {
                $('#cf' + j).val(latwr + '.');
            } else if (latwr.length == 1 && matchwr != false) {
                $('#cf' + j).val('');
            }


            if (!(longwr.indexOf(".") == -1)) {
                matchwr2 = true; // decimal
            } else {
                matchwr2 = false;
            }
            if (longwr.length == 2 && matchwr2 != true) {
                $('#cg' + j).val(longwr + '.');
            } else if (longwr.length == 1 && matchwr2 != false) {
                $('#cg' + j).val('');
            }


            if ($(ele).data('decimal') != null) {
                // found valid rule for decimal
                var decimal = parseInt($(ele).data('decimal')) || 0;
                var val = $(ele).val();
                if (decimal > 0) {
                    var splitVal = val.split('.');
                    if (splitVal.length == 2 && splitVal[1].length > decimal) {
                        // user entered invalid input
                        $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                    }
                } else if (decimal == 0) {
                    // do not allow decimal place
                    var splitVal = val.split('.');
                    if (splitVal.length > 1) {
                        // user entered invalid input
                        $(ele).val(splitVal[0]); // always trim everything after '.'
                    }
                }
            }
        }
        function isNumberKey(txt, evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode == 46) {
                //Check if the text already contains the . character
                if (txt.value.indexOf('.') === -1) {
                    return true;
                } else {
                    return false;
                }
            } else {
                if (charCode > 31 &&
                    (charCode < 48 || charCode > 57))
                    return false;
            }
            return true;
        }
