        function ddldemandside() {
            var ddl = $('#ddldemand').val();
            if (ddl == "Demand Side") {
                $('#Demand_side').show();
                $('#supply_side').hide();
                $('#supplyside').hide();
                $('#demandside').show();
                $('#supply_side').val("0");
            }
            else if (ddl == "Supply Side") {
                $('#supply_side').show();
                $('#Demand_side').hide();
                $('#supplyside').show();
                $('#demandside').hide();
                $('#Demand_side').val("0");
            }
            else if (ddl == "All") {
                $('#supply_side').hide();
                $('#Demand_side').hide();
                $('#supplyside').show();
                $('#demandside').show();

                $('#supply_side').val("0");
                $('#Demand_side').val("0");


            }
        }


