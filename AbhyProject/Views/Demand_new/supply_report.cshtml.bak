                                        tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td></td><td></td><td>' + data[i].village + '</td><td>' + data[i].year + '</td><td><label>' + data[i].supply_side + ' </label></td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].name_of_structure + '</td><td>' + data[i].latitude_of_proposed + '</td><td>' + data[i].longitude_of_proposed + '</td><td>' + data[i].total_approximate + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].work_completion_date + '</td><td>' + data[i].ddlnew + '</td><td>' + data[i].latitude_of_structure + '</td><td>' + data[i].longitude_of_structure + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td>' + reject + '</td><td><label style="color: red;">Rejected</label></td> </tr> ';

                                    }
                                }
                                else {
                                    if (new_row == "1") {
                                        var schemeother = "";
                                        if (data[i].schemename_other != null) {
                                            schemeother = data[i].schemename_other;
                                        }
                                        sno += 1;
                                        tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gp_name + '</td><td></td><td></td><td>' + data[i].village + '</td><td>' + data[i].year + '</td><td><label>' + data[i].supply_side + ' </label></td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].name_of_structure + '</td><td>' + data[i].latitude_of_proposed + '</td><td>' + data[i].longitude_of_proposed + '</td><td>' + data[i].total_approximate + '</td><td>' + data[i].work_start_date + '</td><td>' + data[i].work_completion_date + '</td><td>' + data[i].ddlnew + '</td><td>' + data[i].latitude_of_structure + '</td><td>' + data[i].longitude_of_structure + '</td><td>' + data[i].department_name_new + '</td><td>' + data[i].scheme_name_new + '</td><td>' + schemeother + '</td><td>' + data[i].expenditure_incurred + '</td><td>' + data[i].remark + '</td><td></td><td><label style="color: black;">At DPMU</label></td> </tr> ';

                                    }
                                    else if (new_table_entry_c == "0") {
                                        sno += 1;
                                        tr += '<tr id="AWP1_TR_c' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gpname + '</td><td></td><td></td><td>' + data[i].village_name + '</td><td>' + data[i].any_year + '</td><td><label>Any Other Intervention</label></td><td>' + data[i].other_department_name + '</td><td>' + data[i].possible_funding_source + '</td><td>' + data[i].other_structure + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].anyother_approx_estimated_cost + '</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td> </tr> ';

                                    }
                                    else if (new_table_entry_b == "0") {
                                        sno += 1;
                                        tr += '<tr id="AWP1_TR_b' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gpname + '</td><td></td><td></td><td>' + data[i].village_name + '</td><td>' + data[i].wc_year + '</td><td><label>Water Conservation Structures</label></td><td>' + data[i].wc_department_name + '</td><td>' + data[i].possiable_funding_source + '</td><td>' + data[i].type_wc_structure + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].wc_approx_estimated_cost + '</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td> </tr> ';

                                    }
                                    else if (new_table_entry_a == "0") {
                                        sno += 1;

                                        tr += '<tr id="AWP1_TR_a' + i + '"><td>' + (sno) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gpname + '</td><td></td><td></td><td>' + data[i].village_name + '</td><td>' + data[i].sp_year + '</td><td><label>Artificial Recharge Structures</label></td><td>' + data[i].ar_department_name + '</td><td>' + data[i].possible_funding_source + '</td><td>' + data[i].type_ar_structure + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].ar_approx_estimated_cost + '</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td> </tr> ';

                                    }
                                }

                            }
                        }
                    }
                    debugger;
                    $('#tbl_details').html(tr);
                    $('#existing_well_total').html(sno);

                }
                $('.loader').hide();
            }
        });
    }

</script>
