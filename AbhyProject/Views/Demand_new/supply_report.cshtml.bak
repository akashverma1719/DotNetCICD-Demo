<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<div class="container" id="Data1">
    <div class="row row_padding_10">
        <div class="col-md-12">
            <div class="firsttable col-md-12">
                <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
            </div>
        </div>
        <div class="col-md-12 report_heading_div">
            <div class="col-md-9">
                <h1>
                    DLI 3 Convergence Claim
                </h1>
            </div>
            <div class="col-md-3 text-right" id="btnExport">
                <button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>
                <button class="btn btn-success download1" id="btnexcel">Excel</button>
            </div>
            <div class="col-md-12">
                <ul class="dateandtime_ul">
                    <li>Date : <span id="demo"></span></li>
                    <li>Time : <span id="demo2"></span></li>
                    <li>
                        User Name:
                        @if (Session["UserName"] != null)
                        {
                            <span>@Session["UserName"].ToString()</span>
                        }
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">

            <div class="col-md-12 last-div-footer" id="btnExport1">
                <div class="col-md-12 text-center">
                    <a href="~/Demand_new/Supply_New" class="btn btn-danger"> Back</a>

                    @*<button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>*@


                </div>
            </div>

        </div>
        <div class="col-md-12 state_dist_level">
            <div class="row" id="Select_dist_level">
                <ul class="Select_option">
                    @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                    {

                        <li>
                            <label id="lblstate">State:</label>
                            <span id="spnstate">@Session["gstate"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                    {
                        <li>
                            <label id="lblstate">Admin</label>

                        </li>
                    }
                    else
                    {
                        <li>
                            <label id="lblstate">National Level Nodal Officer</label>

                        </li>
                    }


                    @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                    {
                        <li>

                            <label id="lbldistrict">District:</label>
                            <span id="spndistrict">@Session["gdist"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }

                    @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                    {
                        <li>

                            <label>Block:</label>
                            <span id="spnblock">@Session["gblock"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                    {
                        <li>

                            <label>Gram panchayat:</label>
                            <span id="spngram">@Session["ggram"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    @if (Session["year"] != null && Session["year"].ToString() != "null" && Session["year"].ToString() != "")
                    {
                        <li>

                            <label>Year:</label>
                            <span id="Year">@Session["year"]</span>

                        </li>
                    }
                    @if (Session["month"] != null && Session["month"].ToString() != "null" && Session["month"].ToString() != "")
                    {
                        <li>

                            <label>Month:</label>
                            <span id="spnmonth"></span>

                        </li>
                    }



                </ul>
            </div>

        </div>

        <div class="gramReport_div_start col-md-12">
            <div class="text-center reportheading">
                <p>
                    DLI 3 Convergence Claim (Supply Side)

                </p>
            </div>

            <div class="col-md-12">
                <div id="resetinfo" class="tbl-responsive" style="padding:5px">
                    <table class="table table-striped gp_profile table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody class="tablebody">

                            <tr>
                                <td>State:</td>
                                <td>
                                    <span id="spnstate">@Session["gstate"]</span>
                                    @*<span id="state_name"></span>*@
                                </td>
                                <td>District:</td>
                                <td>
                                    <span id="spndistrict">@Session["gdist"]</span>
                                    @*<span id="district_name"></span>*@
                                </td>
                            </tr>
                            <tr>
                                <td>Block / Taluk :</td>
                                <td>
                                    <span id="spnblock">@Session["gblock"]</span>
                                    @*<span id="block_name"></span>*@
                                </td>
                                <td>GP Name :</td>
                                <td>
                                    <span id="spngram">@Session["ggram"]</span>
                                    @*<span id="gram_panchayat_name"></span>*@
                                </td>
                            </tr>
                            <tr>
                                <td>Year :</td>
                                <td>
                                    <span id="spnblock">@Session["yea"]</span>
                                    @*<span id="block_name"></span>*@
                                </td>
                                <!--<td>Month:</td>
                                <td>
                                    <span id="spnmonth1"></span>-->
                                @*<span id="gram_panchayat_name"></span>*@
                                <!--</td>-->
                            </tr>
                        </tbody>
                    </table>
                    <h3>
                        <label class="bg-light text-left display_flex">
                            Total Rows   :  <label id="existing_well_total"></label>
                        </label>
                    </h3>
                </div>

                <div class="tbl-responsive" style="overflow-x:scroll">
                    <table id="tbldemand" class="table pgwmtable table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border: 1px solid #dddddd; margin-top: 10px; width: 100%;">
                        <thead style="color: #fff;">
                            <tr class="tableheader1"></tr>
                            <tr class="success">
                                <td rowspan="2" class="text-center">Sr.No</td>
                                <td rowspan="2" class="text-center">State Name</td>
                                <td rowspan="2" class="text-center">District Name</td>
                                <td rowspan="2" class="text-center">Block Name</td>
                                <td rowspan="2" class="text-center">Gram Panchyat Name </td>
                                <td rowspan="2" class="text-center">GP Center Point (Latitude)</td>
                                <td rowspan="2" class="text-center">GP Center Point (Longitude)</td>
                                <td rowspan="2" class="text-center">Village Name </td>
                                <td rowspan="2" class="text-center">Financial Year </td>
                                <td colspan="7" class="text-center"><label>Supply Side proposed under WSP</label></td>
                                <td colspan="10" class="text-center">Convergence Expenditure Claim Other than Atal Bhujal Yojana Share    </td>
                                <td rowspan="2" class="text-center" style="padding-right: 70px;">Remark</td>
                                <td rowspan="2" class="text-center" style="padding-right: 55px;">Submit to</td>
                            </tr>
                            <tr class="success">
                                <td rowspan="1" class="text-center">Supply Side</td>
                                <td rowspan="1" class="text-center">Department Name</td>
                                <td rowspan="1" class="text-center">Scheme Name </td>
                                <td rowspan="1" class="text-center">Name of Structure (Proposed)</td>
                                <td rowspan="1" class="text-center">Latitude of proposed structure</td>
                                <td rowspan="1" class="text-center">Longitude of proposed structure</td>
                                <td rowspan="1" class="text-center">Total Approximate Estimated Cost(in lakh)</td>
                                <td rowspan="1" class="text-center">Work Start Date</td>
                                <td rowspan="1" class="text-center">Work Completion Date</td>
                                <td rowspan="1" class="text-center">Type of Work (New / Renovation)</td>
                                <td rowspan="1" class="text-center">Latitude of structure</td>
                                <td rowspan="1" class="text-center"> Longitude of structure </td>
                                <td rowspan="1" class="text-center">Department Name</td>
                                <td rowspan="1" class="text-center">Scheme Name </td>
                                <td rowspan="1" class="text-center">Scheme Name Other</td>
                                <td rowspan="1" class="text-center">Expenditure incurred other than Atal jal (lakhs) </td>
                                <td rowspan="1" class="text-center">Remark, if any</td>

                            </tr>

                        </thead>
                        <tbody id="tbl_details"></tbody>

                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="col-md-12 last-div-footer" id="btnExport1">
                <div class="col-md-12 text-center">
                    <a href="~/Demand_new/Supply_New" class="btn btn-danger"> Back</a>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script>
    function ReportPdf() {
        $("#Data1").width(3000);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'DLI 3 Convergence Claim.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el11' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A1', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('#Data1').addClass('table-condensed');

        $(".highcharts-credits").css("display", "none");
        $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

        $('div#btnExport').addClass('hideDownload');

        $('div#btnExport1').addClass('hideDownload');

        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");


            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 3000);
        window.setTimeout(set_detault, 1000);

    }
    function set_detault() {
        $("#Data1").width(1095);
    }

</script>

<script>
    //Code for print page
    function printpage() {
        //Get the print button and put it into a variable
        var printButton = document.getElementById("print");
        //Set the print button visibility to 'hidden'
        //printButton.style.visibility = 'hidden';
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        //Print the page content
        window.print()
        $('div#btnExport').removeClass('hideDownload');
        $('div#btnExport1').removeClass('hideDownload');
        //printButton.style.visibility = 'visible';
    }
</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demo").innerHTML = today;
</script>

<script>
    var StateOfficer = "";
    $(document).ready(function () {
        debugger;
         StateOfficer = '@Session["Officer"]';
        var year = '@Session["yea"]';
        var year_name = Get_year_Number(year)
        $('#spnmonth').text(year_name);
        //$('#spnmonth1').text(month_name);
        if (StateOfficer == "") {
            window.location = "/WspNew/WSP_GWM_HOME";
        }

        report_getting();
        sarpanch_getting();


    });

    function report_getting() {


        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GplevelMobileData/exesting_getting',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                var month_num = data[0].fymonth;
                debugger;

                $("#state_name").text(data[0].state);
                $("#district_name").text(data[0].district);
                $("#block_name").text(data[0].block);
                $("#gram_panchayat_name").text(data[0].grampanchayat);
                if (data[0].length != 0) {

                } else {

                    $('#state_name').text('');
                    $('#district_name').text('');
                    $('#block_name').text('');
                    $('#gram_panchayat_name').text('');

                }
            }
        });

        sarpanch_getting();

    }

    function Get_year_Number(year) {
        debugger;
        var month_num = "";
        switch (year) {
            case "":
                month_num = 'April';
                break;
            case "2":
                month_num = 'May';
                break;
            case "3":
                month_num = "June";
                break;
            case "4":
                month_num = "July";
                break;
        }
        return month_num;
    }
    function sarpanch_getting() {
        debugger;

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Demand_new/Data_get_supply_report',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                var tr = '';
                var sno = 0;
                var data = data;
                if (data == 'No Data') {
                    tr = '<tr colspan="11"><td colspan="11" style="text-align: center;"></td></tr>';
                    $('#existing_well_total').text(0);
                }
                else {
                    if (data.length != 0) {
                        if (StateOfficer == "District Level Nodal Officer") {
                            for (var i = 0; i < data.length; i++) {

