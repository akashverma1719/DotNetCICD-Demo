                                    <table id="" class="table Supply_side_table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic">
                                        <div class="text-right">
                                            @using (Html.BeginForm("Export", "WSPHOME", FormMethod.Post))
                                            {
                                                <input type="hidden" name="DataForM" value="Anyother" />
                                                <input type="submit" class="btn btn-success btn_export" id="btnSubmit" value="Export" />
                                            }
                                        </div>
                                        <thead>
                                            <tr class="info text-center">
                                                <th colspan="18" class="text-center">Any Other Intervention</th>
                                            </tr>
                                            <tr class="info">
                                                <th>S.no.</th>
                                                <th>Village Name</th>
                                                <th>Lat</th>
                                                <th class="text-center">Long </th>
                                                <th class="text-center">Type of WC Structure</th>
                                                <th class="text-center">Storage Capacity</th>
                                                <th class="text-center">Number of Fillings(Kharif)</th>
                                                <th class="text-center">Number of Fillings (Rabi)</th>
                                                <th class="text-center"> Recharge %</th>
                                                <th class="text-center">GW Recharge (Ha.m) Kharif</th>
                                                <th class="text-center">GW Recharge (Ha.m) Rabi</th>
                                                <th class="text-center">GW Recharge (Ha.m) Annual</th>
                                                <th class="text-center">Financial Year</th>
                                                <th class="text-center">Department Name</th>
                                                <th class="text-center"> Possible Funding Source</th>
                                                <th class="text-center">Approximate Estimated Cost (in Lakhs)</th>
                                                <th>Edit</th>
                                                <th>Delete</th>
                                            </tr>

                                        </thead>
                                        <tbody id="AO_tbl_info"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div id="progress">
            <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
                <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                    <span class="progress-group-label" data-target="#music" data-toggle="tab">Supply Side</span>
                    <div class="progress-node answering active now tab-link subtab1" data-tab="menu-11">
                        <div class="progress-label">Artificial Recharge Structures<span class="pointer"></span></div>
                    </div>
                    <div class="progress-node tab-link subtab2" data-tab="menu-12">
