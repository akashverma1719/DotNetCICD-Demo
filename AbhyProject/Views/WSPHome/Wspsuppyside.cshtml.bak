        var wc_type_structure = $("#wc_type_structure").val();
        if (wc_type_structure == 'Other') {
            $("#other_wc_type_structure").show();
        } else {
            $("#other_wc_type_structure").hide();
        }
    }
    function select_other() {
        var ar_type_structure = $("#ar_type_structure").val();
        if (ar_type_structure == 'Other') {
            $("#other_ar_type_structure").show();
        } else {
            $("#other_ar_type_structure").hide();
        }
    }

    function Save_Full_Info() {
        var verification_val = 0;
        var lfckv = document.getElementById("WspTacker_Verification_CheckBox").checked;

        if (lfckv == true) {
            verification_val = 1;
        } else {
            verification_val = 0;
