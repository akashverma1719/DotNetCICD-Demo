<script>
    function openCity(evt, cityName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(cityName).style.display = "block";
        evt.currentTarget.className += " active";
    }

    // Get the element with id="defaultOpen" and click on it
    document.getElementById("defaultOpen").click();

    // Other Option Script AR
    function Checkar_possible_funding_source(val) {

        var element = document.getElementById('other_ar_possible_funding_source');
        var elementSelect = document.getElementById('ar_possible_funding_source');
        if (val == 'Others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'Others')
            elementSelect.style.display = 'none';

        else
            elementSelect.style.display = 'block';
    }

    // Other Option Script WC
    function Checkwc_possible_funding_source(val) {

        var element = document.getElementById('other_wc_possible_funding_source');
        var elementSelect = document.getElementById('wc_possible_funding_source');
        if (val == 'Others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'Others')
            elementSelect.style.display = 'none';

        else
            elementSelect.style.display = 'block';
    }
    // Other Option Script Reduction
    function Checkother_possible_funding_source(val) {

        var element = document.getElementById('other_other_possible_funding_source');
        var elementSelect = document.getElementById('other_possible_funding_source');
        if (val == 'Others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'Others')
            elementSelect.style.display = 'none';

        else
            elementSelect.style.display = 'block';
    }

</script>



