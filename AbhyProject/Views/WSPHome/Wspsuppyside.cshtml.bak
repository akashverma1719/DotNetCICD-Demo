                                                <th class="text-center">Number of Fillings (Rabi)</th>
                                                <th class="text-center"> Recharge %</th>
                                                <th class="text-center">GW Recharge (Ha.m) Kharif</th>
                                                <th class="text-center">GW Recharge (Ha.m) Rabi</th>
                                                <th class="text-center">GW Recharge (Ha.m) Annual</th>
                                                <th class="text-center">Financial Year</th>
                                                <th class="text-center">Department Name</th>
                                                <th class="text-center"> Possible Funding Source</th>
                                                <th class="text-center">Approximate Estimated Cost (in Lakhs)</th>
                                                <th>Edit</th>
                                                <th>Delete</th>


                                            </tr>

                                        </thead>
                                        <tbody id="Ar_tbl_info"></tbody>
                                    </table>
                                </div>
