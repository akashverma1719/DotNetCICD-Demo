                                        <div class="text-right">
                                            @using (Html.BeginForm("Export", "WSPHOME", FormMethod.Post))
                                            {
                                                <input type="hidden" name="DataForM" value="AI" />
                                                <input type="submit" class="btn btn-success btn_export" id="btnSubmit" value="Export" />
                                            }
                                        </div>
                                        <thead>
                                            <tr class="info text-center">
                                                <th colspan="16" class="text-center">Artificial Recharge Structures</th>
                                            </tr>
                                            <tr class="info">
                                                <th>S.no.</th>
                                                <th>Village Name</th>
                                                <th>Lat</th>
                                                <th class="text-center">Long </th>

                                                <th class="text-center">Type of AR Structure</th>
                                                <th class="text-center">Storage Capacity</th>
