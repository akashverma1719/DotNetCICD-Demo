                    <div class="hair-info" id="menu-12">
                        <div class="container-fluid">
                            <div class="col-lg-offset-1 col-md-12 col-sm-12 col-lg-10 col-lg-offset-1 form-body">
                                <div class="form-div">
                                    <div class="col-md-12 background-border-Database ">
                                        <div class="row database_trainer_row ">
                                            <h3>Water Conservation Structures </h3>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Type of WC Structure:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <select class="form-control" id="wc_type_structure" onchange="wc_other()">
                                                </select>
                                                <input type="text" id="other_wc_type_structure" class="form-control alpha" name="" placeholder="Enter other type of WC structure">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="fname">Village Name:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="wc_village" class="form-control alpha" name="" placeholder="Village Name..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="fname">Latitude:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="wc_lat" class="form-control decimal" name="" placeholder="Enter your latitude..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="fname">Longitude:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="wc_long" class="form-control decimal" name="" placeholder="Enter your longitude..">
                                            </div>
                                        </div>


                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Storage Capacity (Ha.m):</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="number" id="wc_storage_capacity" min="0" class="form-control" name="" placeholder="Enter Storage Capacity..">
                                            </div>
                                        </div>

                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">
                                                    Effective Storage Available for Use
                                                    <a href="javascript:;" data-toggle="tooltip" title="" data-original-title="Storage capacity (Ha.m) * 0.6">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a>
                                                    :
                                                </label>

                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="number" id="wc_effective_storage" class="form-control" min="0" name="" placeholder="Enter Effective storage available for use.." readonly>
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
