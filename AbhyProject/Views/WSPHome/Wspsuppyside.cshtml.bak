
@{
    ViewBag.Title = "Wspsuppyside";
    Layout = null;
}
<meta name="viewport" content="width=device-width" />
<title>Water Security Plan</title>
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/datecss.css" rel="stylesheet" />
<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/css/abhycss.css" rel="stylesheet" />
<link href="~/Content/wsp_formcss.css" rel="stylesheet" />
<script src="~/Content/JS_Files/IdealState.js"></script>
<header class="header hederImage">
    <div class="clearfix">
        <div class="clearfix">
            <div class="col-lg-9">
                <div class="header-top-info">
                    <ul class="clearfix">
                        <li>
                            <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                        </li>
                        <li>
                            <span>
                                <a href="~/home/index" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                            </span>
                            <span>
                                <a href="javascript:;" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                    Ministry of Jal Shakti
                                </a>
                            </span>
                            <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size:14px;">Department of Water Resources,</a></span>
                            <span style="text-align:center;">
                                <a href="javascript:;" title="GOVERNMENT OF INDIA"
                                   style="text-transform:none; font-size:14px;">
                                    River Development & Ganga Rejuvenation
                                </a>
                            </span>

                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-3">
                <ul class="imgHome clearfix">

                    <li>
                        <img src="~/Content/WspImages/user-silhouette.png" title="User" />
                        @if (Session["UserName"] != null)
                        {
                            <span style="color:#fff;">:@Session["UserName"].ToString()</span>
                        }

                    </li>
                    <li>
                        <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                    </li>

                </ul>
            </div>
            <div class="col-md-8" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                <ul class="imgHome clearfix">
                    <li>
                        <a href="~/WspNew/WSP_GWM_HOME">
                            <span>
                                <img src="~/Content/WspImages/home-icon-silhouette.png" />
                            </span>
                            <label>MIS Login <i class="fa fa-angle-double-right"></i></label>
                        </a>
                    </li>

                    <li>
                        <a href="~/Wsp_new/WSPHOME">
                            <span><img src="~/Content/WspImages/home-icon-silhouette.png" /></span>
                            <label>WSP Home <i class="fa fa-angle-double-right"></i></label>
                        </a>
                    </li>

                    @*<li>
                            <a href="~/WspNew/WspWaterAvailability">
                                <span><img src="~/Content/WspImages/home-icon-silhouette.png" /></span>
                                <label>WSP Availablity <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>*@
                    <li>

                        <span> <img src="~/Content/WspImages/draft new 1.png" /></span>
                        <label>Supply Side</label>

                    </li>


                </ul>
            </div>
            <div class="col-md-4">
                <ul id="myTabs" class="nav nav-pills nav-justified" role="tablist" data-tabs="tabs">
                    <li class="active">
                        <a href="javascript:;">
                            <span> <img src="~/Content/WspImages/draft new 1.png" /></span>Supply Side
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>

<section>
    <div class="tab-content">
        <!--Rainfail_menu Start-->
        <div role="tabpanel" class="tab-pane fade in active" id="music">
            <div class="container-fluid">
                <!--images Row Started-->
                <div class="clearfix">
                    <div class="row" id="Select_dist_level">
                        <ul class="Select_option  selectbackhome">
                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Block:</label>
                                <span>@Session["gblock"] </span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Gram panchayat:</label>
                                <span>@Session["ggram"]</span>
                            </li>
                        </ul>
                        <ul class="selectbackhome" style="float:right;">
                            <li>
                                <a href="~/Wsp_new/WSPHOME">
                                    <button class="btn btn-success">Back To WSP Home</button>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="row" style="margin-top:10px;">
                        <div class="col-md-12 col-lg-12 text-center">
                            <ul class="tabs_menu sru_menu" id="Surface_menu">
                                <li class="tab-link active subtab1" data-tab="menu-11">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/WspImages/Rainfall1.png" /></span>
                                        <label>Artificial Recharge Structures</label>
                                    </a>
                                </li>
                                <li class="tab-link subtab2" data-tab="menu-12">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/WspImages/WSPplan/irrigation tank 5.png" /></span>
                                        <label>Water Conservation Structures </label>
                                    </a>
                                </li>
                                <li class="tab-link subtab3" data-tab="menu-13">
                                    <a href="javascript:;">
                                        <span> <img src="~/Content/WspImages/WSPplan/dam icon 1.png" /></span>
                                        <label>Any Other Intervention </label>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="clearfix tabfirst">
                    <div class="suface-info active" id="menu-11">
                        <div class="container-fluid">

                            <div class="col-lg-offset-1 col-md-12 col-sm-12 col-lg-10 col-lg-offset-1 form-body">
                                <div class="form-div">
                                    <div class="col-md-12 background-border-Database">
                                        <div class="row database_trainer_row">
                                            <h3>Artificial Recharge Structures</h3>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Type of AR Structure:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <select class="form-control" id="ar_type_structure" onchange="select_other()">
                                                </select>
                                                <input type="text" id="other_ar_type_structure" class="form-control alpha" name="" placeholder="Enter other type of AR structure">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="fname">Village Name:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="ar_village" class="form-control alpha" name="" placeholder="Village Name..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">

                                                <label for="fname">Latitude:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="ar_lat" class="form-control decimal" name="" placeholder="Enter your latitude..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="fname">Longitude:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="ar_long" class="form-control decimal" name="" placeholder="Enter your longitude..">
                                            </div>
                                        </div>

                                        @*<div class="row database_trainer_row">
            <div class="col-md-6 col-sm-6">
                <label for="lname">Other AR Structure:</label>
            </div>
            <div class="col-md-5 col-sm-6">
                <input type="text" id="ar_other_structure" class="form-control" name="" placeholder="Enter Other AR Structure..">
            </div>
        </div>*@
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Storage Capacity (Ha.m):</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="number" id="ar_storage_capacity" class="form-control" min="0" name="" placeholder="Enter Storage Capacity..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Number of Fillings (Kharif):</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="number" id="ar_noof_filling_kharif" class="form-control" min="0" name="" placeholder="No. of Fillings (Kharif) ..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Number of Fillings (Rabi):</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="number" id="ar_noof_filling_rabi" class="form-control" min="0" name="" placeholder="No. of Fillings (Rabi)..">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Recharge % :</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="number" id="ar_recharge" class="form-control" min="0" name="" placeholder="Recharge">
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">
                                                    GW Recharge (Ha.m) Kharif
                                                    <a href="javascript:;" data-toggle="tooltip" title="" data-original-title="Storage Capacity (Ha.m) * Number of Fillings kharif * Recharge % * 0.01">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a>:
                                                </label>

                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="ar_gw_recharge_kharif" class="form-control" name="" placeholder="GW Recharge (Ha.m) Kharif.." readonly>
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">
                                                    GW Recharge (Ha.m) Rabi
                                                    <a href="javascript:;" data-toggle="tooltip" title="" data-original-title="Storage Capacity (Ha.m) * Number of Fillings Rabi * Recharge % * 0.01">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a>:
                                                </label>

                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="ar_gw_recharge_rabi" class="form-control" name="" placeholder="GW Recharge (Ha.m) Rabi: .." readonly>
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">
                                                    GW Recharge (Ha.m) Annual
                                                    <a href="javascript:;" data-toggle="tooltip" title="" data-original-title=" GW Recharge kharif (Ha.m) + GW Recharge Rabi (Ha.m)">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a>:
                                                </label>

                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <input type="text" id="ar_gw_recharge_anuual" class="form-control" name="" placeholder="GW Recharge (Ha.m) Annual" readonly>
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">
                                                    Financial Year
                                                    :
                                                </label>

                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <select class="form-control" id="sp_year">
                                                    <option value="0">Select Financial Year</option>
                                                    <option value="2020-21">2020-21</option>
                                                    <option value="2021-22">2021-22</option>
                                                    <option value="2022-23">2022-23</option>
                                                    <option value="2023-24">2023-24</option>
                                                    <option value="2024-25">2024-25</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Department Name:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">

                                                <select class="form-control" id="ar_department_name" onchange="ar_department_other()">
                                                    <option value="0">Select Department Name</option>
                                                    <option value="Agriculture & Farmer Welfare Department">Agriculture & Farmer Welfare Department</option>
                                                    <option value="Department of Forest">Department of Forest</option>
                                                    <option value="Department of Horticulture">Department of Horticulture</option>

                                                    <option value="Department of Sericulture">Department of Sericulture</option>
                                                    <option value="Departmnet of Agriculture">Departmnet of Agriculture</option>

                                                    <option value="District Soil and Water Conservation Officer Department">District Soil and Water Conservation Officer Department</option>

                                                    <option value="Education Department">Education Department</option>
                                                    <option value="Gujarat Green Revolution Company Ltd. (GGRC)">Gujarat Green Revolution Company Ltd. (GGRC)</option>
                                                    <option value="Gujarat Water Resources Development Corporation Ltd. (GWRDC)">Gujarat Water Resources Development Corporation Ltd. (GWRDC)</option>
                                                    <option value="Irrigation & Water Resource Development">Irrigation & Water Resource Development</option>
                                                    <option value="Major Irrigation Deaprtment">Major Irrigation Deaprtment</option>
                                                    <option value="MICADA">MICADA</option>
                                                    <option value="Minor Irrigation Deaprtement">Minor Irrigation Department</option>
                                                    <option value="Minor Irrigation ZP/STATE (ZP)">Minor Irrigation ZP/STATE (ZP)</option>
                                                    <option value="Panchayat Raj Engineering Department">Panchayat Raj Engineering Department</option>
                                                    <option value="Panchayati Raj Institutions (PRI)">Panchayati Raj Institutions (PRI)</option>
                                                    <option value="Public health Engineering Department">Public health Engineering Department</option>
                                                    <option value="Rural Department and Panchayati Raj">Rural Department and Panchayati Raj</option>
                                                    <option value="Rural Development">Rural Development</option>
                                                    <option value="Rural Development Department">Rural Development Department</option>
                                                    <option value="Rural Development Department (ZP / GP)">Rural Development Department (ZP / GP)</option>
                                                    <option value="Rural Water Supply Department">Rural Water Supply Department</option>
                                                    <option value="Soil & Conservation Department">Soil & Conservation Department</option>
                                                    <option value="Water Resources Department">Water Resources Department</option>
                                                    <option value="Water Supply and Sanitation Department">Water Supply and Sanitation Department</option>
                                                    <option value="Watershed Development & Soil Conservation">Watershed Development & Soil Conservation</option>
                                                    <option value="Watershed Development Department">Watershed Development Department</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                                <input type="text" class="form-control" id="ar_department" placeholder="Enter Deparment Name" />
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">Possible Funding Source:</label>
                                            </div>
                                            <div class="col-md-5 col-sm-6">
                                                <select class="form-control" id="ar_possible_funding_source" onchange="Checkar_possible_funding_source(this.value);">
                                                </select>
                                                <input type='text' class='form-control' name="other_ar_possible_funding_source" id="other_ar_possible_funding_source" style='display:none;' />
                                            </div>
                                        </div>
                                        <div class="row database_trainer_row">
                                            <div class="col-md-6 col-sm-6">
                                                <label for="lname">
                                                    Approximate Estimated Cost:(<span style="color:red">Note:</span>The filled value will be considered only for single structure):
                                                </label>

                                            </div>
                                            <div class="col-md-3 col-sm-4">
                                                <input type="text" id="ar_approx_estimated_cost" min=0 class="form-control decimal" name="" placeholder=" Approximate Estimated Cost ..">
                                            </div>
                                            <div class="col-md-2 col-sm-2">
                                                <select class="form-control" id="ar_cost_type" onchange="">
                                                    <option value="0">Select Cost</option>
                                                    @*<option value="Rupees">Rupees</option>
                    <option value="Thousands">Thousands</option>*@
                                                    <option value="Lakhs">Lakhs</option>
                                                </select>
                                            </div>
                                        </div>


