<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }

        .loader > img {
            top: 45%;
            left: 45%;
            position: fixed;
            height: 150px;
            width: 150px;
        }

    ul.estimate_cost_ul {
        list-style: none;
        padding: 0px;
        text-align: left;
    }

        ul.estimate_cost_ul > li {
            display: inline-block;
        }

    ul.wsp-content-content > li > a {
        position: absolute;
        right: 30px;
        color: #fff;
        top: 77px;
    }

    ul.labelvalueShowing_leftpanel {
        list-style: none;
        padding: 0px;
        text-align: left;
    }

        ul.labelvalueShowing_leftpanel > li {
            padding: 2px 5px;
        }

    #progress-ui .progress-group#Surface-water {
        margin-left: -2px;
        z-index: 4;
        background-color: #6FB11D;
    }

    #progress-ui .progress-group.active .progress-node, #progress-ui .progress-group.hover .progress-node {
        border-color: #6FB11D;
    }

    #progress-ui .progress-group#Surface-water .progress-label {
        background-color: #6FB11D;
    }
</style>

