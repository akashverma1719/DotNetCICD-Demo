<script>
    $(document).ready(function () {
        var Auth = '@Session["Access_Auth"]';
        if (Auth == "Training-SM") {
              window.location = "/Home/LogOut";
            alert("Please Select Gram Panchayat or Monitoring Evaluation Module");    
        }
        Info();
        WspHome_Info_Get();
    });
    function Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSPHome/Training_mannual_testing',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                else {
                    if (response == "NPMU") {
                        $('#Upload1').show();
                        $('#Upload2').show();
                        $('#Upload3').show();
                        $('#Upload4').show();
                    } else {
                        $('#Upload1').hide();
                        $('#Upload2').hide();
                        $('#Upload3').hide();
                        $('#Upload4').hide();
                    }
                }
            }
        });

    }

    function Upload1() {
        var fileUpload = $("#filename_mobile").get(0);
        var files = fileUpload.files;
        if (files.length != 0) {
            var formData = new FormData();
            formData.append('filename_mobile', files[0]);

            $.ajax({
                url: '/WSPHome/WspHome_Info',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    WspHome_Info_Get();
                    $("#filename_mobile").val("");

                }
            });

        } else {
            alert("Please Upload File");
        }

    }

    function Upload2() {
        var fileUpload = $("#filename_mis").get(0);
        var files = fileUpload.files;
        if (files.length != 0) {
            var formData = new FormData();
            formData.append('filename_mis', files[0]);

            $.ajax({
                url: '/WSPHome/WspHome_Info',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    WspHome_Info_Get();
                    $("#filename_mis").val("");
                }
            });

        } else {
            alert("Please Upload File");
        }
    }

    function Upload3() {
        var fileUpload = $("#filename_wsp").get(0);
        var files = fileUpload.files;
        if (files.length != 0) {
            var formData = new FormData();
            formData.append('filename_wsp', files[0]);

            $.ajax({
                url: '/WSPHome/WspHome_Info',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    WspHome_Info_Get();
                    $("#filename_wsp").val("");
                }
            });

        } else {
            alert("Please Upload File");
        }
    }


    function WspHome_Info_Get() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSPHome/WspHome_Info_Get',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                $('#mobile_download').html("");
                $('#mis_download').html("");
                $('#wsp_download').html("");
                if (data == "Error") {
                      window.location = "/Home/LogOut";
                }
                if (data == "Logout") {
                      window.location = "/Home/LogOut";

                }
                if (data.length != 0) {
                    
                    if (data[0].filename_mobile != null && data[0].filename_mobile != '') {
                        var aa2 = '<a href="' + data[0].filepath_mobile + '" target="_blank" download="">Old Atal Jal_Mobile App_UserManual.docx</a> ';

                        $('#mobile_download').html(aa2);

                    }
                    if (data[0].filename_mis != null && data[0].filename_mis != '') {
                        var aa1 = '<a href="' + data[0].filepath_mis + '" target="_blank" download="">Old ATALJAL_MIS_WebManual.pdf</a> ';

                        $('#mis_download').html(aa1);
                    }
                    if (data[0].filename_wsp != null && data[0].filename_wsp != '') {
                        var aa = '<a href="' + data[0].filepath_wsp + '" target="_blank" download="">Old WSP - User Manual.pdf</a> ';
                        $('#wsp_download').html(aa);
                    }


                }
                else {
                    $('#mobile_download').val("");
                    $('#mis_download').val("");
                    $('#wsp_download').val("");

                }

            }
        });
    }
</script>



