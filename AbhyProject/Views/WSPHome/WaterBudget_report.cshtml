<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script>
    function ReportPdf() {
        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterBudgetReport.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 210, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
    }

</script>


<script>
    var Access_Auth = "";
    $(document).ready(function () {
    Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
        Info();

    });

    var Ground_Water = [];
    var Surface_Water = [];

    var wb_drinking_from_gw = 0;
    var wb_drinking_from_sw = 0;
    var wb_irri_agri_gw = 0;
    var wb_irri_agri_sw = 0;
    var wb_drinking_total = 0;
    var wb_irri_agri_total = 0;

    function Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/WaterBudgetInfo_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                
                if (response == "Error") {
                    window.location = "/Wsp_new/WaterBudget_report";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (response.length != 0) {

                    if (response[0].wb_drinking_from_sw != "" && response[0].wb_drinking_from_sw != null) {
                        wb_drinking_from_sw = response[0].wb_drinking_from_sw;
                    }
                    if (response[0].wb_drinking_from_gw != "" && response[0].wb_drinking_from_gw != null) {
                        wb_drinking_from_gw = response[0].wb_drinking_from_gw;
                    }
                    if (response[0].wb_drinking_total != "" && response[0].wb_drinking_total != null) {
                        wb_drinking_total = response[0].wb_drinking_total;
                    }
                    if (response[0].wb_irri_agri_sw != "" && response[0].wb_irri_agri_sw != null) {
                        wb_irri_agri_sw = response[0].wb_irri_agri_sw;
                    }


                    if (response[0].wb_irri_agri_gw != "" && response[0].wb_irri_agri_gw != null) {
                        wb_irri_agri_gw = response[0].wb_irri_agri_gw;
                    }
                    if (response[0].wb_irri_agri_total != "" && response[0].wb_irri_agri_total != null) {
                        wb_irri_agri_total = response[0].wb_irri_agri_total;
                    }


                    $('#wb_drinking_from_sw').text(wb_drinking_from_sw);
                    $('#wb_drinking_from_gw').text(wb_drinking_from_gw);
                    $('#wb_drinking_total').text(wb_drinking_total);
                    $('#wb_irri_agri_sw').text(wb_irri_agri_sw);
                    $('#wb_irri_agri_gw').text(wb_irri_agri_gw);
                    $('#wb_irri_agri_total').text(wb_irri_agri_total);



                    Ground_Water.push(parseFloat(wb_drinking_from_gw));
                    Ground_Water.push(parseFloat(wb_drinking_from_sw));

                    Surface_Water.push(parseFloat(wb_irri_agri_gw));
                    Surface_Water.push(parseFloat(wb_irri_agri_sw));
                    Charts();

                }

            }
        });
    }

    function Charts() {
        Highcharts.chart('container_WaterbudgetReport', {
            chart: {
                type: 'column'
            },
            title: {
                text: 'Projected Water Budget for future (for 2050)'
            },
            //subtitle: {
            //    text: 'Source: WorldClimate.com'
            //},
            xAxis: {
                categories: [
                    'Ground Water',
                    'Surface Water'
                ],
                crosshair: true
            },
            yAxis: {
                //  min: 0,
                title: {
                    text: ''
                }
            },
            colors: [
                '#ED5565',
                '#a6c96a'
            ],
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.1f} </b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },
            series: [{
                name: 'Allocation for Domestic & Industrial Requirements',
                data: Ground_Water

            }, {
                name: 'Irrigation',
                data: Surface_Water

            }]
        });



    }
</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demoBudget2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demoBudget").innerHTML = today;
</script>





