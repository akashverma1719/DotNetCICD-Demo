<script>
    function C2() {
        Highcharts.chart('container_demand_side', {
            chart: {
                type: 'column'
            },
            title: {
                text: ''
            },
            //subtitle: {
            //    text: 'Source: WorldClimate.com'
            //},
            xAxis: {
                categories: [
                    //   'Standard Water<br/> Demand(ha.m)',
                    'Micro-irrigation (Sprinkler)',
                    'Micro-irrigation (Drip)',
                    'Irrigation through <br/>underground <br/> pipelines ',
                    'Crop <br/>diversification',
                    'Reduction in <br/>GW by added <br/>use of  SW',
                    'Other measures <br/>for saving water'

                ],
                crosshair: true
            },
            yAxis: {
                //  min: 0,
                title: {
                    text: ''
                }
            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.1f} (Ha.m)</b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },
            series: [{
                name: 'Standard water Demand (Ha.m)',
                data: DemandSide_KharifArray

            }, {
                name: 'Total water Demand(Ha.m)',
                data: DemandSide_RabiArray

            }, {
                name: 'Reduction in water Demand(Ha.m)',
                data: DemandSide_SummerArray

            }]
        });
    }
    function Supply_SideReport() {
        Highcharts.chart('container_supply_side', {
            chart: {
                type: 'column'
            },
            title: {
                text: ''
            },
            //subtitle: {
            //    text: 'Source: WorldClimate.com'
            //},
            xAxis: {
                categories: [
                    'GW Recharge AR Structures',
                    'GW Recharge WC Structures',
                    'Any Other Intervention'


                ],
                crosshair: true
            },
            yAxis: {
                //  min: 0,
                title: {
                    text: ''
                }
            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.1f} (Ha.m)</b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },
            series: [{
                name: 'Kharif season',
                data: KharifArray,

            }, {
                name: 'Rabi season',
                data: RabiArray,

            }, {
                name: 'Annual',
                data: AOIArray

            }]
        });
    }
</script>
<script>



    function ReportPdf() {

        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterSecurityPlan.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $('div.demandsidesupplyside_space1_12').addClass('demandsidesupplyside_space1_121');
        demandsidesupplyside_space1_121
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
            $('div.demandsidesupplyside_space1_12').removeClass('demandsidesupplyside_space1_121');
        }, 2000);

    }
</script>
<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demodemandsupply2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demodemandsupply").innerHTML = today;


    function get_demandside_fund() {
        var tr_sp = '';

        $.ajax({
            type: "POST",
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_new/get_demandside_fund",
            data: "",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                var department_name = "";
                var scheme_name = "";
                var proposed_area = "";
                var approximate_cost = "";
                var fund = 0;
                for (var i = 0; i < data.length; i++) {
                    if (data[i].department_name != null && data[i].department_name != "" && data[i].department_name != "NULL") {
                        department_name = data[i].department_name;
                    }
                    if (data[i].scheme_name != null && data[i].scheme_name != "" && data[i].scheme_name != "NULL") {
                        scheme_name = data[i].scheme_name;
                    }
                    if (data[i].proposed_area != null && data[i].proposed_area != "" && data[i].proposed_area != "NULL") {
                        proposed_area = data[i].proposed_area;
                    }
                    if (data[i].approximate_cost != null && data[i].approximate_cost != "" && data[i].approximate_cost != "NULL") {
                        approximate_cost = data[i].approximate_cost;
                        fund += parseFloat(data[i].approximate_cost);
                    }


                    tr_sp += '<tr><td>' + (i + 1) + '</td>' +
                        '<td>' + data[i].type + '</td >' +
                        '<td>' + data[i].claim_year + '</td >' +
                        '<td>' + data[i].other_measures + '</td >' +
                        '<td>' + department_name + '</td >' +
                        '<td>' + scheme_name + '</td >' +
                        '<td>' + proposed_area + '</td >' +
                        '<td>' + approximate_cost + '</td ></tr>'

                }
                tr_sp += '<tr><td>Total</td><td></td><td></td><td></td><td></td><td></td><td></td><td>' + parseFloat((fund).toFixed(2) + " Lakhs") + '</td></tr>'
                if (tr_sp != '') {
                    $('#sprinkler_data').html(tr_sp);
                } else {
                    tr_sp = '<tr style="text-align:center;"><td colspan="16" style="text-align:center;">No Data</td></tr>';
                    $('#sprinkler_data').html(tr_sp);
                }
                get_supplyside_fund();
            }
        })
    }


    function get_supplyside_fund() {
        var tr_sp = '';
        var j = 0;
        $.ajax({
            type: "POST",
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_new/get_ar_supplyside_fund",
            data: "",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                var ar = "Artificial Recharge Structures";
                var possible_funding = '';
                var fund = 0;
                for (var i = 0; i < data.length; i++) {
                    if (data[i].possible_funding_source == "Others") {
                        possible_funding = data[i].other_funding_source;
                    } else {
                        possible_funding = data[i].possible_funding_source;
                    }
                    if (data[i].ar_approx_estimated_cost != null && data[i].ar_approx_estimated_cost != "NULL" && data[i].ar_approx_estimated_cost != "") {
                        fund += parseFloat(data[i].ar_approx_estimated_cost);
                    }

                    tr_sp += '<tr><td>' + (++j) + '</td>' +
                        '<td>' + ar + '</td >' +
                        '<td>' + data[i].type_ar_structure + '</td >' +
                        '<td>' + data[i].latitude + '</td >' +
                        '<td>' + data[i].longitude + '</td >' +
                        '<td>' + data[i].sp_year + '</td >' +
                        '<td>' + data[i].ar_department_name + '</td >' +
                        '<td>' + possible_funding + '</td >' +

                        '<td>' + (data[i].ar_approx_estimated_cost + " Lakhs") + '</td ></tr>'

                }
                $.ajax({
                    type: "POST",
                    contentType: 'application/json; chatset=utf-8',
                    url: "/Wsp_new/get_wc_supplyside_fund",
                    data: "",
                    dataType: 'JSON',
                    success: function (data) {
                        debugger;
                        var wc = "Water Conservation Structures";
                        for (var i = 0; i < data.length; i++) {
                            if (data[i].possible_funding_source == "Others") {
                                possible_funding = data[i].other_funding_source;
                            } else {
                                possible_funding = data[i].possiable_funding_source;
                            }
                            if (data[i].wc_approx_estimated_cost != null && data[i].wc_approx_estimated_cost != "NULL" && data[i].wc_approx_estimated_cost != "") {
                                fund += parseFloat(data[i].wc_approx_estimated_cost);
                            }

                            tr_sp += '<tr><td>' + (++j) + '</td>' +
                                '<td>' + wc + '</td >' +
                                '<td>' + data[i].type_wc_structure + '</td >' +
                                '<td>' + data[i].latitude + '</td >' +
                                '<td>' + data[i].longitude + '</td >' +
                                '<td>' + data[i].wc_year + '</td >' +
                                '<td>' + data[i].wc_department_name + '</td >' +
                                '<td>' + possible_funding + '</td >' +

                                '<td>' + (data[i].wc_approx_estimated_cost + " Lakhs") + '</td ></tr>'

                        }

                        $.ajax({
                            type: "POST",
                            contentType: 'application/json; chatset=utf-8',
                            url: "/Wsp_new/get_other_supplyside_fund",
                            data: "",
                            dataType: 'JSON',
                            success: function (data) {
                                debugger;
                                var ot = "Any Other Intervention";
                                for (var i = 0; i < data.length; i++) {

                                    if (data[i].possible_funding_source == "Others") {
                                        possible_funding = data[i].other_funding_source;
                                    } else {
                                        possible_funding = data[i].possible_funding_source;
                                    }
                                    if (data[i].anyother_approx_estimated_cost != null && data[i].anyother_approx_estimated_cost != "NULL" && data[i].anyother_approx_estimated_cost != "") {
                                        fund += parseFloat(data[i].anyother_approx_estimated_cost);
                                    }

                                    tr_sp += '<tr><td>' + (++j) + '</td>' +
                                        '<td>' + ot + '</td >' +
                                        '<td>' + data[i].other_structure + '</td >' +
                                        '<td>' + data[i].latitude + '</td >' +
                                        '<td>' + data[i].longitude + '</td >' +
                                        '<td>' + data[i].any_year + '</td >' +
                                        '<td>' + data[i].other_department_name + '</td >' +
                                        '<td>' + possible_funding + '</td >' +

                                        '<td>' + (data[i].anyother_approx_estimated_cost + " Lakhs") + '</td ></tr>'

                                }

                                tr_sp += '<tr><td>Total</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td>' + parseFloat((fund).toFixed(2) + " Lakhs") + '</td></tr>'
                                if (tr_sp != '') {
                                    $('#supply_data').html(tr_sp);
                                } else {
                                    tr_sp = '<tr style="text-align:center;"><td colspan="16" style="text-align:center;">No Data</td></tr>';
                                    $('#supply_data').html(tr_sp);
                                }
                            }
                        })
                    }
                })

            }
        })
        
        
    }
</script>

