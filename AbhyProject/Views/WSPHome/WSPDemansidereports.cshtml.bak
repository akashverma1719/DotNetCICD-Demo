
@{
    ViewBag.Title = "WSPDemansidereports";
    Layout = null;
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="~/Scripts/all_scripts/bootstrap_3.4.0.min.js"></script>

<script src="~/Scripts/all_scripts/highcharts.js"></script>

<script src="~/Scripts/all_scripts/data.js"></script>

<script src="~/Scripts/all_scripts/drilldown.js"></script>


<!--Pie Chart-->

<script src="~/Scripts/all_scripts/exporting.js"></script>

<script src="~/Scripts/all_scripts/export-data.js"></script>


<!--pie chart-->
@*<script src="https://code.highcharts.com/modules/variable-pie.js"></script>*@


<meta name="viewport" content="width=device-width" />
<title>Water Security Plan Report</title>


<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<!--favicon end-->

<link href="/Scripts/all_scripts/bootstrap.min.css" rel="stylesheet" />

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/css/wsp_report_css.css" rel="stylesheet" />
<!-- jQuery library -->
<!-- Latest compiled JavaScript -->
<script src="~/Content/JS_Files/IdealState.js"></script>
<style>
    .reportheading {
        color: #337ab7;
        font-size: 25px;
        font-weight: bold;
    }

    .demandside_text > tbody > tr > td {
        text-align: right;
        font-size: 14px !important;
    }

    .demandside_text > tbody > tr.tableheader_text > th {
        font-size: 14px !important;
    }

    .demandside_text > tbody > tr > td:last-child {
        text-align: left !important;
    }

    .background_after_download * {
        font-weight: normal !important;
        text-decoration: none !important;
        text-shadow: none !important;
    }

    .demandsidesupplyside_space {
        margin-top: 70px;
    }

    .dateandtime_ul {
        padding: 0px;
    }

    .hideDownload {
        display: none;
    }

    .dateandtime_ul > li {
        display: inline-block;
        color: #000;
        font-size: 18px;
        padding: 0px 15px;
    }

    .heding_demandindside {
        padding: 0px 20px;
        color: #337ab7
    }

        .heding_demandindside > #resetinfo {
            padding: 5px;
        }

    .tableheadingbg {
        color: #337ab7 !important;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        background: #fff;
    }

    .colorline1 {
        background: #ddd;
        background-size: 100% 6px;
        background-position: 50% 100%;
        background-repeat: no-repeat;
        text-align: center;
        margin-top: 12px;
        height: 3px;
        width: 100%
    }

    .col-xs-9 > h1 {
        font-weight: bold;
        color: #404040;
        text-shadow: -1px -1px #000;
    }

    .col-md-9 > p {
        color: #404040;
    }

    .col12 > .firsttable > h6 {
        letter-spacing: 0px;
        padding-left: 10px;
    }

    #Data1 {
        background-color: #fff;
    }

    .firstptag {
        padding-left: 4%;
    }

    body {
        background-color: #ddd;
    }

    .clearfixcolor {
        margin-top: 15px;
    }

    .col12 {
        background-color: #fff;
        padding: 25px;
    }

    .highcharts-credits {
        display: none;
    }



    .highcharts-button-box {
        display: none;
    }



    .text-right > .btn-success {
        margin-top: 20px;
        font-weight: bold;
    }

    .text-right {
        padding: 5px;
    }

        .text-right > .btn-success {
            padding: 8px 20px 8px 20px;
            border-radius: 50px;
            font-size: 18px;
        }

    .btn-success {
        color: #fff;
        background-color: #6fb01d;
        border-color: #4cae4c;
    }

    .coll7 {
        padding-right: 0px;
    }

    ul.Select_option {
        list-style: none;
        display: block;
        padding: 0px 0px 0px 0px;
        font-size: 15px;
        margin: 0px;
    }

        ul.Select_option > li {
            display: inline-block;
            padding: 0px 0px 0px 46px;
            text-transform: uppercase;
            word-spacing: 1px;
        }

            ul.Select_option > li > span > i {
                padding: 0px 0px 0px 10px;
            }

    #Select_dist_level {
        padding: 10px 0px 5px 15px;
        text-transform: capitalize;
    }

    ul.firstimages {
        display: block;
        margin-bottom: 0px;
        padding: 0px;
    }

        ul.firstimages > li {
            display: inline-block;
            padding-left: 5px;
            border: 1px solid #ddd;
            padding: 10px 10px 5px 10px;
        }

            ul.firstimages > li > img {
                border-left: 2px solid #ddd;
            }

            ul.firstimages > li > span > img {
                width: 25px;
                height: 25px;
            }

    .highcharts-title {
        font-weight: bold;
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
        font-size: 13px;
    }

    tspan {
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    }

    /*.firsttable {
        display: block;
    }
        */
    .secondtable {
        text-align: right;
    }

    .report_heading_div {
        background-color: #ddd;
        border-radius: 10px;
        padding: 10px;
    }

    .cololr-div {
        background: #4cae4c;
        height: 3px;
        padding: 0px;
    }

    .last-div-footer {
        padding: 10px 0px;
    }

    sup {
        font-weight: bold;
    }

    .demandsidesupplyside_space1_121 {
        margin-top: 300px;
    }
    /*  .firsttable
    {
        margin-bottom:10px;
    }*/
    /*    .report_heading_div
    {
        margin-bottom:15px;
    }*/
</style>
<div class="container" id="Data1">
    <div class="col-md-12">
        <div class="firsttable col-md-12" style="margin-bottom:15px;">
            <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
        </div>
    </div>
    <div class="col-md-12 report_heading_div">
        <div class="col-md-9">
            <h1>Water Security Plan Report </h1>

        </div>
        <div class="col-md-3 text-right btn_hide" id="btnExport">
            <button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>
        </div>
        <div class="col-md-12">
            <ul class="dateandtime_ul">
                <li>Date : <span id="demodemandsupply"></span></li>
                <li>Time : <span id="demodemandsupply2"></span></li>
                <li>
                    User Name :
                    @if (Session["UserName"] != null)
                    {
                        <span>@Session["UserName"].ToString()</span>
                    }
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-12 state_dist_level">
        <div class="row" id="Select_dist_level">
            <ul class="Select_option">
                @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                {

                    <li>
                        <label id="lblstate">State:</label>
                        <span id="spnstate">@Session["gstate"]</span>
                        <i class="fas fa fa-angle-double-right"></i>
                    </li>
                }
                else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                {
                    <li>
                        <label id="lblstate">Admin</label>

                    </li>
                }
                else
                {
                    <li>
                        <label id="lblstate">National Level Nodal Officer</label>

                    </li>
                }


                @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                {
                    <li>

                        <label id="lbldistrict">District:</label>
                        <span id="spndistrict">@Session["gdist"]</span>
                        <i class="fas fa fa-angle-double-right"></i>
                    </li>

                }

                @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                {
                    <li>

                        <label>Block:</label>
                        <span id="spnblock">@Session["gblock"]</span>
                        <i class="fas fa fa-angle-double-right"></i>
                    </li>
                }
                @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                {
                    <li>

                        <label>Gram panchayat:</label>
                        <span id="spngram">@Session["ggram"]</span>

                    </li>
                }


            </ul>
        </div>

    </div>
    <div class="col-md-12 text-center heding_demandindside">
        <div id="resetinfo">
            <h2>Demand Side</h2>
        </div>
    </div>
    <div class="col-md-12">
        <div id="resetinfo" style="padding:5px;">
            <div id="container_demand_side" style="height:400px"></div>
        </div>
    </div>
    <div class="col-md-12 demandsidesupplyside_space1">
        <div class="col-md-12 ">
            <div tbl-responsive" style="overflow:scroll">
                <table class="table demandside_text table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;height: 340px;">
                    <tbody>
                        <tr>
                            <th colspan="10" style="background-color:#337ab7;color:#fff">
                                Demand Side
                            </th>
                        </tr>
                        <tr class="tableheader1">
                            <th></th>
                            <th>Area Under Measures (ha)</th>
                            <th>Standard Water Demand (Ha.m)</th>
                            <th>Kharif Season(ha.m)</th>
                            <th>Rabi Season(ha.m)</th>
                            <th>Summer Season(ha.m)</th>

                            <th>Total Water Demand (ha.m)</th>
                            <th>Reduction in Water Demand(Ha.m)</th>
                            <th>Possible Funding Source</th>
                            <th>Approx Cost</th>
                        </tr>
                        @*<tr>
                                <th>Standard Water Demand(ha.m)</th>
                                <td><span id="swd_Kharif"></span></td>
                                <td><span id="swd_rabi"></span></td>
                                <td><span id="swd_summer"></span></td>
                                <td><span id=""></span></td>
                                <td><span id=""></span></td>
                                <td><span id=""></span></td>
                                <td><span id=""></span></td>

                            </tr>*@
                        <tr>
                            <th>Micro-Irrigation  <br />(Sprinkler)</th>
                            <td><span id="all_area_spinkler"></span></td>
                            <td><span id="sprinkler_TotalStandardDemand"></span></td>
                            <td><span id="sprinkler_kharif"></span></td>
                            <td><span id="sprinkler_rabi"></span></td>
                            <td><span id="sprinkler_summer"></span></td>

                            <td><span id="sprinkler_TotalDemand"></span></td>
                            <td><span id="sprinkler_TotalReduction"></span></td>
                            <td><span id="sprinkler_FundingSource"></span></td>
                            <td><span id="sprinkler_approx_cost"></span><span id="sprinkler_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Micro-Irrigation<br /> (Drip)</th>
                            <td><span id="all_area_drip"></span></td>
                            <td><span id="drip_TotalStandardDemand"></span></td>
                            <td><span id="drip_kharif"></span></td>
                            <td><span id="drip_rabi"></span></td>
                            <td><span id="drip_summer"></span></td>
                            <td><span id="drip_TotalWaterdDemand"></span></td>
                            <td><span id="drip_TotalReduction"></span></td>
                            <td><span id="drip_FundingSource"></span></td>
                            <td><span id="drip_approx_cost"> </span><span id="drip_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Irrigation Through Underground Pipelines</th>
                            <td><span id="all_area_ug_pipeline"></span></td>
                            <td><span id="pipeline_TotalStandardDemand"></span></td>
                            <td><span id="pipeline_kharif"></span></td>
                            <td><span id="pipeline_rabi"></span></td>
                            <td><span id="pipeline_summer"></span></td>

                            <td><span id="pipeline_TotalWaterDemand"></span></td>
                            <td><span id="pipeline_TotalReduction"></span></td>
                            <td><span id="pipeline_FundingSource"></span></td>
                            <td><span id="pipeline_approx_cost"></span><span id="pipeline_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Crop<br /> Diversification</th>
                            <td><span id="all_area_Crop_diversification"></span></td>
                            <td><span id="crop_total_Standard"></span></td>
                            <td><span id="crop_kharif"></span></td>
                            <td><span id="crop_rabi"></span></td>
                            <td><span id="crop_summer"></span></td>

                            <td><span id="crop_TotalDemand"></span></td>
                            <td><span id="crop_TotalReduction"></span></td>
                            <td><span id="crop_FundingSource"></span></td>
                            <td><span id="crop_approx_cost"> </span><span id="crop_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Reduction in GW by Added Use of  SW</th>
                            <td><span id="all_area_Reduction_in_GW_SW"></span></td>
                            <td><span id="reduction_TotalStandardDemand"></span></td>
                            <td><span id="reduction_kharif"></span></td>
                            <td><span id="reduction_rabi"></span></td>
                            <td><span id="reduction_summer"></span></td>

                            <td><span id="reduction_TotalWaterDemand"></span></td>
                            <td><span id="reduction_TotalReduction"></span></td>
                            <td><span id="reduction_FundingSource"></span></td>
                            <td><span id="reduction_approx_cost"> </span><span id="reduction_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Other Measures for Saving Water</th>
                            <td><span id="all_area_other_measures"></span></td>
                            <td><span id="other_TotalStandardDemand"></span></td>
                            <td><span id="other_kharif"></span></td>
                            <td><span id="other_rabi"></span></td>
                            <td><span id="other_summer"></span></td>

                            <td><span id="other_TotalWaterDemand"></span></td>
                            <td><span id="other_TotalReduction"></span></td>
                            <td><span id="other_FundingSource"></span></td>
                            <td><span id="other_approx_cost"> </span><span id="other_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Total</th>
                            <td><span id="total_of_Area_Proposed_under_various_Measures_value_sum"></span></td>
                            <td colspan="7"></td>
                            <td><span id="DemandSide_Approx_mate_Cost_Total"></span> </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-12 text-center heding_demandindside demandsidesupplyside_space1_12">
        <div id="resetinfo">
            <h2>Supply Side</h2>
        </div>
    </div>
    <div class="col-md-12">
        <div id="resetinfo" style="padding:5px;">
            <div id="container_supply_side" style="height:350px"></div>
        </div>

    </div>
    <div class="col-md-12">
        <div class="col-md-12 ">
            <div class="tbl-responsive" style="overflow-x:scroll">
                <table class="table demandside_text table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                    <tbody>
                        <tr>
                            <th colspan="6" style="background-color:#337ab7;color:#fff">
                                Supply Side
                            </th>
                        </tr>
                        <tr class="tableheader1">
                            <th></th>
                            <th>Kharif Season(ha.m)</th>
                            <th>Rabi Season(ha.m)</th>
                            <th>Annual (ha.m)</th>
                            <th>Possible Funding Source</th>
                            <th>Approx Cost</th>
                        </tr>
                        <tr>
                            <th>Artificial Recharge Structures</th>
                            <td><span id="ar_kharif"></span></td>
                            <td><span id="ar_rabi"></span></td>
                            <td><span id="ar_annual"></span></td>
                            <td><span id="AR_PossibleFundingSource"></span></td>
                            <td><span id="ar_approx_cost"></span><span id="ar_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Water Conservation Structures</th>
                            <td><span id="wc_kharif"></span></td>
                            <td><span id="wc_rabi"></span></td>
                            <td><span id="wc_annual"></span></td>
                            <td><span id="WC_PossibleFundingSource"></span></td>
                            <td><span id="wc_approx_cost"></span><span id="wc_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Any Other Intervention</th>
                            <td><span id="aoi_kharif"></span></td>
                            <td><span id="aoi_rabi"></span></td>
                            <td><span id="aoi_annual"></span></td>
                            <td><span id="Other_PossibleFundingSource"></span></td>
                            <td><span id="aoi_approx_cost"></span><span id="aoi_approx_cost_type"></span></td>
                        </tr>
                        <tr>
                            <th>Total</th>
                            <td colspan="4"></td>
                            <td id="supply_side_approx_cost_total"></td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tbl-responsive">
        <table id="TblData_abc_part1" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
            <thead>
                <tr>
                    <th colspan="9" style="background-color:#337ab7;color:#fff">
                        Demand Side New
                    </th>
                </tr>
                <tr class="info">
                    @*<th rowspan="3" class="text-center"><button class="updatenew btn btn-success" onclick="addrow_a_part()"> New </button></th>*@

                    <th class="text-center">S.No.</th>
                    <th class="text-center">Type</th>
                    <th class="text-center">Financial Year</th>
                    <th class="text-center">Other Measures Type</th>
                    <th class="text-center">Deparment Name</th>
                    <th class="text-center">Scheme Name</th>
                    <th class="text-center">Area Proposed (in ha)</th>
                    <th class="text-center">
                        Approximate Cost (in Lakhs)
                    </th>

                </tr>


            </thead>
            <tbody id="sprinkler_data"></tbody>
        </table>
    </div>

    <div class="tbl-responsive">
        <table id="TblData_abc_part1" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
            <thead>
                <tr>
                    <th colspan="12" style="background-color:#337ab7;color:#fff">
                        Supply Side New
                    </th>
                </tr>
                <tr class="info">
                    @*<th rowspan="3" class="text-center"><button class="updatenew btn btn-success" onclick="addrow_a_part()"> New </button></th>*@

                    <th class="text-center">S.No.</th>
                    <th class="text-center">Categories</th>
                    <th class="text-center">Type of Structure</th>
                    <th class="text-center">Latitude</th>
                    <th class="text-center">Longitude</th>
                    <th class="text-center">Financial Year</th>
                    <th class="text-center">Deparment Name</th>
                    <th class="text-center">Scheme Name</th>

                    <th class="text-center">
                        Approximate Cost (in Lakhs)
                    </th>

                </tr>


            </thead>
            <tbody id="supply_data"></tbody>
        </table>
    </div>
    <div class="col-md-12" style="margin-bottom:15px;">
        <div class="col-md-12">
            <p class="text-center">
                .............................
            </p>
            <p class="text-justify">
                The results and analysis contained within the Water Security Plan Report are generated with the help of inputs given by the
                user as well as existing database. Each component of water budgeting is designed to make understand the users about
                the processes, parameters and equations involved in the system. The overall goal of water budgeting is therefore to
                improve the management of ground water resources in priority areas of the country.
            </p>
            <p class="text-center">
                .............................
            </p>
        </div>

        <div class="container hidediv " id="btnExport1">
            <div class="col-md-12 text-center">
                <a href=""></a>
                <a href="~/WSPHOME/Wspsuppyside" class="btn btn-danger">
                    Back
                </a>

                @*<button type="button" class="btn btn-success" onclick="ReportPdf();">Download</button>*@

                <a href="~/WspNew/report_declaration" class=" btn btn-primary">Go to Total Report</a>
            </div>
        </div>

    </div>

</div>






<script>
    var Access_Auth = "";
    $(document).ready(function () {
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
        DemandSideDetails();
    });
    //DemandSide and Suppaly side Reports
    var AR_Kharif = 0, AR_Rabi = 0, AR_Annual = 0;
    var WC_Kharif = 0, WC_Rabi = 0, WC_Annual = 0;
    var AOI_Kharif = 0, AOI_Rabi = 0, AOI_Annual = 0;
    var KharifArray = [];
    var RabiArray = [];
    var AOIArray = [];
    var DemandSide_KharifArray = [];
    var DemandSide_RabiArray = [];
    var DemandSide_SummerArray = [];
    function DemandSideDetails() {
        Sprinkler_Info();
        get_demandside_fund();
    }



    var DemandSide_Approx_mate_Cost_Total = 0;
    var supply_side_approx_cost_total = 0;

    function Sprinkler_Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSPHome/Sprinkler_Info1',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Error") {
                    window.location = "/WSPHome/WSPDemansidereports";
                }
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                debugger;
                if (data.length != 0) {

                    if (data.sprinkler_approx_estimated_cost != "" && data.sprinkler_approx_estimated_cost != null) {
                        //$('#sprinkler_approx_cost').text(data.sprinkler_approx_estimated_cost);
                        var ss1 = parseFloat(data.sprinkler_approx_estimated_cost).toFixed(2) + " " + "Lakhs";
                        $('#sprinkler_approx_cost_type').text(ss1);
                        DemandSide_Approx_mate_Cost_Total += parseFloat(data.sprinkler_approx_estimated_cost);
                        //alert(DemandSide_Approx_mate_Cost_Total + 'sprinkler_info');

                        //if (data.sprinkler_cost_type != "0" && data.sprinkler_cost_type != "" && data.sprinkler_cost_type != null) {
                        //    var ss1 = parseFloat(data.sprinkler_approx_estimated_cost).toFixed(2) + " " + data.sprinkler_cost_type;
                        //    $('#sprinkler_approx_cost_type').text(ss1);
                        //}
                    }



                    var swd_total = 0;
                    var Sprinkeler_Kharif = 0;
                    if (data.sprinkler_kharif_total_sprinkler_waterdemand != null && data.sprinkler_kharif_total_sprinkler_waterdemand != "") {
                        Sprinkeler_Kharif = parseFloat(data.sprinkler_kharif_total_sprinkler_waterdemand);
                    }


                    var Sprinkeler_Rabi = 0;
                    if (data.sprinkler_rabi_total_rabi_waterdemand != null && data.sprinkler_rabi_total_rabi_waterdemand != "") {
                        Sprinkeler_Rabi = parseFloat(data.sprinkler_rabi_total_rabi_waterdemand);
                    }

                    var Sprinkeler_Summer = 0;
                    if (data.sprinkler_summer_total_summer_waterdemand != null && data.sprinkler_summer_total_summer_waterdemand != "") {
                        Sprinkeler_Summer = parseFloat(data.sprinkler_summer_total_summer_waterdemand);
                    }
                    var swd_total_WaterDemand = 0;


                    var Sprinkeler_Kharif_WaterDemand = 0;
                    if (data.sprinkler_kharif_total_waterdemand != null && data.sprinkler_kharif_total_waterdemand != "") {
                        Sprinkeler_Kharif_WaterDemand = parseFloat(data.sprinkler_kharif_total_waterdemand);
                    }

                    var Sprinkeler_Rabi_WaterDemand = 0;
                    if (data.sprinkler_rabi_total_waterdemand != null && data.sprinkler_rabi_total_waterdemand != "") {
                        Sprinkeler_Rabi_WaterDemand = parseFloat(data.sprinkler_rabi_total_waterdemand);
                    }

                    var Sprinkeler_Summer_WaterDemand = 0;
                    if (data.sprinkler_summer_total_waterdemand != null && data.sprinkler_summer_total_waterdemand != "") {
                        Sprinkeler_Summer_WaterDemand = parseFloat(data.sprinkler_summer_total_waterdemand);
                    }
                    if (Sprinkeler_Kharif_WaterDemand != null && Sprinkeler_Kharif_WaterDemand != "") {
                        swd_total_WaterDemand = Sprinkeler_Kharif_WaterDemand + swd_total_WaterDemand;
                        $('#sprinkler_kharif').text(parseFloat(swd_total_WaterDemand).toFixed(2));
                    }
                    else {
                        $('#sprinkler_kharif').text(0);
                    }


                    if (data.sprinkler_kharif_paddy_fundingsource != "" && data.sprinkler_kharif_paddy_fundingsource != null) {
                        if (data.sprinkler_kharif_paddy_fundingsource == "Others") {
                            $('#sprinkler_FundingSource').text(data.sprinkler_other_funding_source);
                        }
                        else {
                            $('#sprinkler_FundingSource').text(data.sprinkler_kharif_paddy_fundingsource);
                        }

                    }


                    if (Sprinkeler_Rabi_WaterDemand != null && Sprinkeler_Rabi_WaterDemand != "") {
                        swd_total_WaterDemand = Sprinkeler_Rabi_WaterDemand + swd_total_WaterDemand;
                        $('#sprinkler_rabi').text(parseFloat(Sprinkeler_Rabi_WaterDemand).toFixed(2));
                    }
                    else {

                        $('#sprinkler_rabi').text(0);
                    }
                    if (Sprinkeler_Summer_WaterDemand != null && Sprinkeler_Summer_WaterDemand != "") {
                        swd_total_WaterDemand = Sprinkeler_Summer_WaterDemand + swd_total_WaterDemand;

                        $('#sprinkler_summer').text(parseFloat(Sprinkeler_Summer_WaterDemand).toFixed(2));

                    }
                    else {

                        $('#sprinkler_summer').text(0);
                    }

                    if (Sprinkeler_Kharif != null && Sprinkeler_Kharif != "") {
                        swd_total = Sprinkeler_Kharif + swd_total;

                    }




                    if (Sprinkeler_Rabi != null && Sprinkeler_Rabi != "") {
                        swd_total = Sprinkeler_Rabi + swd_total;

                    }


                    if (Sprinkeler_Summer != null && Sprinkeler_Summer != "") {
                        swd_total = Sprinkeler_Summer + swd_total;


                    }



                    $('#sprinkler_TotalDemand').text(swd_total.toFixed(2));

                    $('#sprinkler_TotalStandardDemand').text(swd_total_WaterDemand.toFixed(2));
                    var sprinkler_TotalReduction = swd_total_WaterDemand - swd_total;

                    $('#sprinkler_TotalReduction').text(sprinkler_TotalReduction.toFixed(2));

                    // DemandSide_KharifArray.push(Sprinkeler_Kharif);
                    DemandSide_KharifArray.push(swd_total_WaterDemand);
                    //   DemandSide_RabiArray.push(Sprinkeler_Rabi);
                    DemandSide_RabiArray.push(swd_total);
                    //   DemandSide_SummerArray.push(Sprinkeler_Summer);
                    DemandSide_SummerArray.push(sprinkler_TotalReduction);


                }
                else {
                    // DemandSide_KharifArray.push(Sprinkeler_Kharif);
                    DemandSide_KharifArray.push(0);
                    //   DemandSide_RabiArray.push(Sprinkeler_Rabi);
                    DemandSide_RabiArray.push(0);
                    //   DemandSide_SummerArray.push(Sprinkeler_Summer);
                    DemandSide_SummerArray.push(0);
                }

                Drip_Info();

            }
        });
    }

    function Drip_Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSPHome/Drip_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                if (data == "Error") {
                    window.location = "/WSPHome/WSPDemansidereports";
                }
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                debugger;
                if (data.length != 0) {


                    if (data.drip_approx_estimated_cost != "" && data.drip_approx_estimated_cost != null) {

                            // $('#drip_approx_cost_type').text(data.drip_cost_type);
                            var ss1 = parseFloat(data.drip_approx_estimated_cost).toFixed(2) + " " + "Lakhs";
                            $('#drip_approx_cost').text(ss1);



                        DemandSide_Approx_mate_Cost_Total += parseFloat(data.drip_approx_estimated_cost);
                        //alert(DemandSide_Approx_mate_Cost_Total + 'Drip_Info');
                    }




                    if (data.drip_kharif_paddy_fundingsource != null && data.drip_kharif_paddy_fundingsource != "") {
                        if (data.drip_kharif_paddy_fundingsource == "Others") {
                            $('#drip_FundingSource').text(data.drip_other_funding_source);
                        } else {
                            $('#drip_FundingSource').text(data.drip_kharif_paddy_fundingsource);
                        }
                    }



                    var drip_total = 0;
                    var drip_total_WaterDemand = 0;
                    var drip_Kharif = 0;
                    if (data.drip_kharif_total_drip_waterdemand != null && data.drip_kharif_total_drip_waterdemand != "") {
                        drip_Kharif = parseFloat(data.drip_kharif_total_drip_waterdemand);
                    }


                    var drip_Rabi = 0;
                    if (data.drip_rabi_total_rabi_waterdemand != null && data.drip_rabi_total_rabi_waterdemand != "") {
                        drip_Rabi = parseFloat(data.drip_rabi_total_rabi_waterdemand);
                    }

                    var drip_Summer = 0;
                    if (data.drip_summer_total_summer_waterdemand != null && data.drip_summer_total_summer_waterdemand != "") {
                        drip_Summer = parseFloat(data.drip_summer_total_summer_waterdemand);
                    }

                    var drip_Kharif_WaterDemand = 0;
                    if (data.drip_kharif_total_waterdemand != null && data.drip_kharif_total_waterdemand != "") {
                        drip_Kharif_WaterDemand = parseFloat(data.drip_kharif_total_waterdemand);
                    }
                    var drip_Rabi_WaterDemand = parseFloat(data.drip_rabi_total_waterdemand);
                    var drip_Summer_WaterDemand = parseFloat(data.drip_summer_total_waterdemand);


                    if (drip_Kharif_WaterDemand != null && drip_Kharif_WaterDemand != "") {
                        drip_total_WaterDemand = drip_Kharif_WaterDemand + drip_total_WaterDemand;
                        $('#drip_kharif').text(parseFloat(drip_Kharif_WaterDemand).toFixed(2));

                    }
                    else {
                        drip_Kharif_WaterDemand = 0;
                        $('#drip_kharif').text(0);
                    }
                    if (drip_Rabi_WaterDemand != null && drip_Rabi_WaterDemand != "") {
                        drip_total_WaterDemand = drip_Rabi_WaterDemand + drip_total_WaterDemand;
                        $('#drip_rabi').text(parseFloat(drip_Rabi_WaterDemand).toFixed(2));

                    }

                    else {
                        drip_Rabi_WaterDemand = 0;
                        $('#drip_rabi').text(0);
                    }
                    if (drip_Summer_WaterDemand != null && drip_Summer_WaterDemand != "") {
                        drip_total_WaterDemand = drip_Summer_WaterDemand + drip_total_WaterDemand;

                        $('#drip_summer').text(parseFloat(drip_Summer_WaterDemand).toFixed(2));

                    }
                    else {
                        drip_Summer_WaterDemand = 0;
                        $('#drip_summer').text(0);
                    }

                    if (drip_Kharif != null && drip_Kharif != "") {
                        drip_total = drip_total + drip_Kharif;

                    }
                    if (drip_Rabi != null && drip_Rabi != "") {
                        drip_total = drip_total + drip_Rabi;

                    }
                    if (drip_Summer != null && drip_Summer != "") {
                        drip_total = drip_total + drip_Summer;

                    }

                    $('#drip_TotalStandardDemand').text(parseFloat(drip_total_WaterDemand).toFixed(2));

                    $('#drip_TotalWaterdDemand').text(parseFloat(drip_total).toFixed(2));
                    var drip_TotalReduction = parseFloat(drip_total_WaterDemand) - parseFloat(drip_total);
                    $('#drip_TotalReduction').text(drip_TotalReduction.toFixed(2));

                    DemandSide_KharifArray.push(drip_total_WaterDemand);
                    DemandSide_RabiArray.push(drip_total);
                    DemandSide_SummerArray.push(drip_TotalReduction);
                }
                else {
                    DemandSide_KharifArray.push(0);
                    DemandSide_RabiArray.push(0);
                    DemandSide_SummerArray.push(0);
                }
                PipeLine_Info();

            }
        });
    }

