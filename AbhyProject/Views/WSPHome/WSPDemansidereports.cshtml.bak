    function Crop_Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSPHome/Crop_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                if (data == "Error") {
                    window.location = "/WSPHome/WSPDemansidereports";
                }
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
