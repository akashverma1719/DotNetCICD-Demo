<script type="text/javascript">
    $(document).ready(function () {
        var Email = '@Session["Email"]';
        var Auth = '@Session["Access_Auth"]';
        var SateName = '@Session["gstate"]';
        if (Auth == "WSP") {
            $("#wsp_approved_div").hide();
        }

        if (Auth == "admin") {
            $("#wsp_2024_25").show();
        } if (SateName == "Delhi_7") {
            $("#wsp_new_module_div3").show();
            $("#wsp_2024_25_update").show();
        }
        else {
            $("#wsp_2024_25_update").hide();
        }
       
    });

   
</script>
<script>
        $(document).ready(function () {
            var currentUrl = window.location.href;
            const myArray = currentUrl.split("/");
            let coun = myArray.length - 1;
            //alert(myArray[coun].toString());
            if ((myArray[coun] != "WSP_GWM_HOME") && (myArray[coun] != "LogInForce")) {
                GetCunCurrentUser();
                setInterval(GetCunCurrentUser, 30000);
            }
        });

        function GetCunCurrentUser() {
            $.ajax({
                type: 'get',
                url: '@Url.Action("CheckCunCurrentUser", "WspNew")',
                success: function (data) {
                    if (data == "False") {
                        //window.location.href = "/Home/LogOut";
                        window.location.href = "../../WspNew/WSP_GWM_HOME";
                    }
                }
            });
        }
</script>
