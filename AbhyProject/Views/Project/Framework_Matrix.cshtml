<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    ul.stateul {
        text-align: center;
    }

        ul.stateul > li {
            display: inline-block;
        }

    .tableheader1 > th {
        padding: 5px;
        font-weight: bold;
    }

    .btn-success {
        width: 100px;
        float: none;
        right: 0px;
    }

    .fa-trash,
    .fa-save {
        padding-right: 5px;
    }

    tbody.tablebaody > tr > th {
        width: 10%;
    }

    tbody.tablebaody > tr > td {
        width: 10%;
    }
    /*.add-on {
            position: absolute;

            top:12px;
        }*/
    .dateinput {
        position: relative;
        top: 23px;
    }

    .add-on > i {
        position: relative;
        /* top: 1px; */
        right: -70px;
    }

    .headeings > h4 {
        margin-top: 10px;
        color: #337ab7;
        font-size: 20px;
        font-family: raleway;
        font-weight: 500
    }

    .headeings > h3 {
        margin-top: 10px;
        color: #337ab7;
        font-size: 20px;
        font-family: raleway;
        font-weight: 500
    }

    tbody.tablebaody > tr > th.tdverticalline {
        vertical-align: middle;
    }

    #dateid {
        position: relative;
        top: 24px;
    }

    .objectiveclass {
        padding: 10px 0px;
    }

    .FrameWork_Matrix_table tr td,
    .FrameWork_Matrix_table tr th {
        text-align: center;
        color: #000;
    }

        .FrameWork_Matrix_table tr td:nth-child(3),
        .FrameWork_Matrix_table tr td:nth-child(2) {
            text-align: left !important;
        }
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        z-index: 9999;
        text-align: center;
    }

    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
</style>
