        obj.role_clarify = $("#role_clarify").val();
        obj.budget_expenditure = $("#budget_expenditure").val();
        obj.committee_fees = $("#committee_fees").val();
        var MCK11 = "";
        if ($("#mck1").val() != "" && $("#mck1").val() != null) {
            for (var i = 0; i < $("#mck1").val().length; i++) {
                MCK11 = MCK11 + "," + $("#mck1").val()[i] + ",";
            }

        }

        var MCK22 = "";
        if ($("#mck2").val() != "" && $("#mck2").val() != null) {

            for (var i = 0; i < $("#mck2").val().length; i++) {
                MCK22 = MCK22 + "," + $("#mck2").val()[i] + ",";
            }
        }
