<label id="AlertError" style="text-align:center;color:red;"></label>





<script>
    (function ($) {


        $('select[multiple].active.55col').multiselect({

            placeholder: 'Information Communicated',

            search: true,
            searchOptions: {
                'default': 'Information Communicated'
            },
            selectAll: true
        });

    })(jQuery);

    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah')
                    .attr('src', e.target.result);
            };

            reader.readAsDataURL(input.files[0]);
        }
    }
</script>






