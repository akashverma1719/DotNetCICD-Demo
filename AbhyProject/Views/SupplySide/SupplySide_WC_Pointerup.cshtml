<script>
    var KharifArray = [];
    var RabiArray = [];
    var AOIArray = [];
    var KharifArray_wcs = [];
    var RabiArray_wcs = [];
    var AOIArray_wcs = [];
    var DemandSide_KharifArray = [];
    var DemandSide_RabiArray = [];
    var DemandSide_SummerArray = [];
    function demandside_graph() {
        Highcharts.chart('container_demand_side', {
            chart: {
                type: 'column'
            },
            title: {
                text: ''
            },
            //subtitle: {
            //    text: 'Source: WorldClimate.com'
            //},

            xAxis: {
                categories: [
                    // 'Standard Water<br/> Demand(ha.m)',
                    'Micro-irrigation (Sprinkler)',
                    'Micro-irrigation (Drip)',
                    'Irrigation through <br/>underground <br/> pipelines ',
                    'Crop <br/>diversification',
                    'Any other measure <br/> for saving of <br/>water in agriculture',
                    'Other measures <br/>for saving water'
                ],
                title: {
                    useHTML: true,
                    enabled: true,
                    text: '<b>Name of intervention<b>',
                    style: {
                        fontWeight: 'normal'
                    }
                },

                crosshair: true
            },
            yAxis: {
                //  min: 0,
                title: {
                    text: '<b>Volume of water (ha m)<b>'
                }
            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.2f} (Ha.m)</b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true
                    }
                },

            },
            series: [{
                name: 'Total water Demand',
                data: DemandSide_KharifArray

            }, {
                name: 'Net water Demand',
                data: DemandSide_RabiArray

            }, {
                name: 'Reduction in water Demand',
                data: DemandSide_SummerArray

            }]
        });
    }


    function Supply_SideReport() {
        Highcharts.chart('container_supply_ar', {
            chart: {
                type: 'column'
            },

