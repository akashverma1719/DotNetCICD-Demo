    function validatenum() {
        var txt_annual_fil_ar = parseInt($('#txt_annual_fil_ar').val());
        if (txt_annual_fil_ar < 1 || txt_annual_fil_ar > 8) {
            alert("Please input between 1 to 8");
            $('#txt_annual_fil_ar').val('');
        }

        var txt_annual_fil_wr = parseInt($('#txt_annual_fil_wr').val());
        if (txt_annual_fil_wr < 1 || txt_annual_fil_wr > 8) {
            alert("Please input between 1 to 8");
            $('#txt_annual_fil_wr').val('');
        }
    }

    function goto_mapview() {
        debugger;
        var Values_all_select = [];
        //$('#tbl1 tbl_ar_details')
        $('#tbl1 > tbody').each(function () {
            //var customerId = $(this).find(".customerIDCell").html();


            $($('.supply_ar')).each(function () {// id of ul
                //var aa = $(this).find('input[type=checkbox],select');
                var aa = $(this).closest('tr').find('input[type=checkbox],select');
                if (aa.prop('checked') == true) {
                    var id = aa.attr("id")
                    Values_all_select.push({
                        menu_id: id,
                    });
                }

            })

        });
        console.log(Values_all_select);
    }


    function goto_mapview_wr() {
        debugger;
        var Values_all_select = [];
        //$('#tbl1 tbl_ar_details')
        $('#tbl2 > tbody').each(function () {
            //var customerId = $(this).find(".customerIDCell").html();


            $($('.supply_wr')).each(function () {// id of ul
                //var aa = $(this).find('input[type=checkbox],select');
                var aa = $(this).closest('tr').find('input[type=checkbox],select');
                if (aa.prop('checked') == true) {
                    var id = aa.attr("id")
                    Values_all_select.push({
                        menu_id: id,
                    });
                }

            })

        });
        console.log(Values_all_select);
    }

</script>
<script>

    function Department_Info() {

        $.ajax({
            type: "GET",
            url: "/SupplySide/SupplySide_Department_Info",
            //url: "/WSPHome/SupplaySide_Funding_Source",
            contentType: "application/json;charset=utf-8",
            data: '',
            dataType: 'JSON',
            success: function (response) {

                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                $("#ar_department_name").empty();
                //$("#ar_possible_funding_source").empty();
                //$("#other_possible_funding_source").empty();

                var optionhtml = "<option value='0'>--Select Department name--</option>";
                if (response.length != 0) {

                    for (var i = 0; i < response.length; i++) {
                        if (response[i].department_name != null && response[i].department_name != "") {
                            optionhtml += '<option value="' + response[i].department_name + '">' + response[i].department_name + '</option>';
                        }
                    }
                    $("#ar_department_name").append(optionhtml);
                    $("#wc_department_name").append(optionhtml);
                    
                    
                }
            }
        });
    }
    function Scheme_Info() {

        $.ajax({
            type: "GET",
            url: "/wspDemandSide/Scheme_Info",
            //url: "/WSPHome/SupplaySide_Funding_Source",
            contentType: "application/json;charset=utf-8",
            data: '',
            dataType: 'JSON',
            success: function (response) {

                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                /*$("#sprinkler_scheme").empty();*/
                //$("#ar_possible_funding_source").empty();
                //$("#other_possible_funding_source").empty();

                var optionhtml = "<option value='0'>--Select Scheme--</option>";
                if (response.length != 0) {

                    for (var i = 0; i < response.length; i++) {
                        if (response[i].scheme_name != null && response[i].scheme_name != "") {
                            optionhtml += '<option value="' + response[i].scheme_name + '">' + response[i].scheme_name + '</option>';
                        }
                    }
                    optionhtml += "<option value='Other'>Other</option>";
                    $("#ar_scheme_name").append(optionhtml);
                    $("#wc_scheme_name").append(optionhtml);
                    Department_Info();
                }
            }
        });
    }

    function CheckOther() {
        var ar_scheme_name = $("#ar_scheme_name").val();
        if (ar_scheme_name == "Other") {
            $("#other_scheme").show();
        } else {
            $("#other_scheme").hide();
        }
    }
    function WC_CheckOther() {
        var wc_scheme_name = $("#wc_scheme_name").val();
        if (wc_scheme_name == "Other") {
            $("#wc_other_scheme").show();
        } else {
            $("#wc_other_scheme").hide();
        }
    }
</script>
<script src="~/Scripts/validations.js"></script>