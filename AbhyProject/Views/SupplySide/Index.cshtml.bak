    function SaveDetails_WR() {
        debugger;
            var formData = new FormData();
            var state ='@Session["gstate"]';
            var dis ='@Session["gdist"]';
            var block ='@Session["gblock"]';
        var gp = '@Session["ggram"]';
        var txt_village_wr = $("#txt_village_wr").val();
        var ddl_structure_wr = $('#ddl_structure_wr').val();
        if (txt_village_wr == '0') {
            alert('Please Select Village Name');
            $('#txt_village_wr').focus()
            return;
        }
        if (ddl_structure_wr == '0') {
            alert('Please Select Type of Water Conservation Structure');
            $('#ddl_structure_wr').focus()
            return;
        }
        if ($('#txt_latitude_wr').val() == '') {
            alert('Please Fill Latitude of proposed structure');
            $('#txt_latitude_wr').focus()
            return;
        }
        if ($('#txt_longitude_wr').val() == '') {
            alert('Please Fill Longitude of proposed structure');
            $('#txt_longitude_wr').focus()
            return;
        }
        if ($('#ddl_work_rproposed_wr').val() == '0') {
            alert('Please Select Work Proposed');
            $('#ddl_work_rproposed_wr').focus()
            return;
        }
        if ($('#txt_storage_wr').val() == '') {
            alert('Please Fill Storage capacity');
            $('#txt_storage_wr').focus()
            return;
        }
        if ($('#txt_annual_fil_wr').val() == '') {
            alert('Please Fill Annual no. of fillings');
            $('#txt_annual_fil_wr').focus()
            return;
        }
        else if ($("#wc_year").val() == "0") {
            alert('Please Select Financial Year');
            $("#wc_year").focus()
            return;
        } else if ($("#wc_department_name").val() == "0") {
            alert('Please Select Department Name');
            $("#wc_department_name").focus()
            return;
        } else if ($("#wc_scheme_name").val() == "0") {
            alert('Please Select Financial Year');
            $("#wc_scheme_name").focus()
            return;
        } else if ($("#wc_scheme_name").val() == "Other") {
            if ($("#wc_other_scheme").val() == "") {
                alert("Please Enter Other Scheme Name");
                $("#wc_other_scheme").focus();
                return;
            }
        }
        //if ($('#txt_app_fr_conve_wr').val() == '') {
        //    alert('Please Fill Total Approximate Estimated Cost');
        //    $('#txt_app_fr_conve_wr').focus()
        //    return;
        //}
        if ($("#wc_scheme_name").val() != "Other") {
            $("#wc_other_scheme").val("");
        }
        formData.append('financial_year', $("#wc_year").val());
        formData.append('department_name', $("#wc_department_name").val());
        formData.append('scheme_name', $("#wc_scheme_name").val());
        formData.append('other_scheme', $("#wc_other_scheme").val());
            formData.append('State', state);
            formData.append('District', dis);
            formData.append('Block', block);
            formData.append('Gp', gp);
        formData.append('village_name', $('#txt_village_wr').val());
        formData.append('location_detail', $('#txt_loaction_Details_wr').val());
        if ($('#ddl_structure_wr').val() == 'Other') {
            formData.append('type_of_wr', $('#txt_structure_wr').val());
        }
        else {
            formData.append('type_of_wr', $('#ddl_structure_wr').val());
        }
        formData.append('latitude', $('#txt_latitude_wr').val());
        formData.append('longitude', $('#txt_longitude_wr').val());
        formData.append('work_proposed', $('#ddl_work_rproposed_wr').val());
        formData.append('storage_capacity', $('#txt_storage_wr').val());
        formData.append('annual_filling_no', $('#txt_annual_fil_wr').val());
        formData.append('effective_storage', $('#txt_effective_storage_wr').val());
        formData.append('fund_resource', $('#txt_funding_sorce_wr').val());
        formData.append('estimated_cost', $('#txt_app_esti_wr').val());
        /*formData.append('fund_avail_convergence', $('#txt_app_fr_conve_wr').val());*/
        /*formData.append('gap_funding_atal', $('#txt_gap_fund_at_wr').val());*/
        if ($('#SAVE_BTN1').text() == "Save") {
            $.ajax({
                url: '/SupplySide/Save_Data_WR',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    GetWRData();
                    if (data != 'Data already entered for that Lat, Long') {
                        $('#txt_village_wr').val(0);
                        $('#txt_loaction_Details_wr').val('');
                        $('#ddl_structure_wr').val(0);
                        $('#txt_latitude_wr').val('');
                        $('#txt_longitude_wr').val('');
                        $('#ddl_work_rproposed_wr').val(0);
                        $('#txt_storage_wr').val('');
                        $('#txt_annual_fil_wr').val('');
                        $('#txt_effective_storage_wr').val('');
                        $('#txt_funding_sorce_wr').val('');
                        $('#txt_app_esti_wr').val('');
                        $("#wc_scheme_name").val("0");
                        $("#wc_department_name").val("0");
                        $("#wc_year").val("0");
                        /*$('#txt_app_fr_conve_wr').val('');*/
                        /*$('#txt_gap_fund_at_wr').val('');*/
                    }
                }
            });
        }
        if ($('#SAVE_BTN1').text() == "Update") {
            formData.append('IDD_WR', IDD_WR);
            $.ajax({
                url: '/SupplySide/Update_Data_WR',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    GetWRData();
                    window.location.reload();
                }
            });
        }
    }
    function check_other()
    {
        debugger;
        if ($('#ddl_structure_ar').val() == 'Other') {
             /*$('#ddl_structure_ar').hide();*/
             $('#txt_structure_ar').show();
         }
         else {
             $('#ddl_structure_ar').show();
            $('#txt_structure_ar').hide();
            $('#txt_structure_ar').val("");
         }

         if ($('#ddl_structure_wr').val() == 'Other') {
             /*$('#ddl_structure_wr').hide();*/
             $('#txt_structure_wr').show();
         }
         else {
             $('#ddl_structure_wr').show();
             $('#txt_structure_wr').hide();
             $('#txt_structure_wr').val("");
         }
    }
    var tableToExcel = (function () {

        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--><meta http-equiv="content-type" content="text/plain; charset=UTF-8"/></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
