        function cal_AR(e) {
            if (e != undefined) {
                var Data = e.target.value;
                check = parseFloat(Data);

                if (check < 1 || check > 100) {
                    alert('Please Enter Vaue in % between 0-100');
                    $("#txt_recharge_ar").val('');
                    return;
                }
            }
        var a = $('#txt_storage_ar').val();
        var b = $('#txt_annual_fil_ar').val();
        var c = $('#txt_recharge_ar').val();

        if (a != '' && b != '' && c != '') {
            var d = parseFloat(a) * parseFloat(b) * parseFloat(c) * 0.01;
            $('#txt_annual_recharge_ar').val(d.toFixed(4));
        }
    }
    function Cal_wr() {
        var a = $('#txt_storage_wr').val();

        if (a != '') {
            var d = parseFloat(a) * 0.06;
            $('#txt_effective_storage_wr').val(d.toFixed(4));
        } else {
            $('#txt_effective_storage_wr').val('');
        }
    }
    function SaveDetails_AR()
    {
        debugger;
            var formData = new FormData();
            var state ='@Session["gstate"]';
            var dis ='@Session["gdist"]';
            var block ='@Session["gblock"]';
        var gp = '@Session["ggram"]';
        var txt_village_ar = $('#txt_village_ar').val();
        var ddl_structure_ar = $("#ddl_structure_ar").val();

        var vall = $('#txt_recharge_ar').val();

        
        if (txt_village_ar == "0") {
            alert("Please Select Village Name");
            $('#txt_village_ar').focus();
            return;
        }
        if (ddl_structure_ar == "0") {
            alert("Please Select Type of Artificial recharge Structure");
            $('#ddl_structure_ar').focus();
            return;
        }
        if ($('#txt_latitude_ar').val() == '') {
            alert('Please Fill Latitude of proposed structure');
            $('#txt_latitude_ar').focus()
            return;
        }
        if ($('#txt_longitude_ar').val() == '') {
            alert('Please Fill Longitude of proposed structure');
            $('#txt_longitude_ar').focus()
            return;
        }
        if ($('#ddl_work_rproposed_ar').val() == '0') {
            alert('Please Select Work Proposed');
            $('#ddl_work_rproposed_ar').focus()
            return;
        }
        if ($('#txt_storage_ar').val() == '') {
            alert('Please Fill Storage capacity');
            $('#txt_storage_ar').focus()
            return;
        }
        if ($('#txt_annual_fil_ar').val() == '') {
            alert('Please Fill Annual no. of fillings');
            $('#txt_annual_fil_ar').focus()
            return;
        } else if (vall < 1 || vall > 100) {
            alert('Please Enter Vaue in % between 0-100');
            $('#txt_recharge_ar').focus()
            return;
        }
        else if ($("#ar_year").val() == "0") {
            alert('Please Select Financial Year');
            $("#ar_year").focus()
            return;
        } else if ($("#ar_department_name").val() == "0") {
            alert('Please Select Department Name');
            $("#ar_department_name").focus()
            return;
        } else if ($("#ar_scheme_name").val() == "0") {
            alert('Please Select Scheme Name');
            $("#ar_scheme_name").focus()
            return;
        } else if ($("#ar_scheme_name").val() == "Other") {
            if ($("#other_scheme").val() == "") {
                alert("Please Enter Other Scheme Name");
                $("#other_scheme").focus();
                return;
            }
        }
        if ($('#txt_ap_es_cost_ar').val() == '') {
            alert('Please Fill Total Approximate Estimated Cost');
            $('#txt_ap_es_cost_ar').focus()
            return;
        }
        if ($("#ar_scheme_name").val() != "Other") {
            $("#other_scheme").val("");
        }

        
        formData.append('financial_year', $("#ar_year").val());
        formData.append('department_name', $("#ar_department_name").val());
        formData.append('scheme_name', $("#ar_scheme_name").val());
        formData.append('other_scheme', $("#other_scheme").val());
            formData.append('State', state);
            formData.append('District', dis);
            formData.append('Block', block);
            formData.append('Gp', gp);
        formData.append('village_name', $('#txt_village_ar').val());
        formData.append('location_detail', $('#txt_loaction_Details_ar').val());
        if ($('#ddl_structure_ar').val()=='Other')
        {
            formData.append('type_of_ar', $('#txt_structure_ar').val());
        }
        else {
            formData.append('type_of_ar', $('#ddl_structure_ar').val());
        }
        formData.append('latitude', $('#txt_latitude_ar').val());
        formData.append('longitude', $('#txt_longitude_ar').val());
        formData.append('work_proposed', $('#ddl_work_rproposed_ar').val());
        formData.append('storage_capacity', $('#txt_storage_ar').val());
        formData.append('annual_filling_no', $('#txt_annual_fil_ar').val());
        formData.append('recharge', $('#txt_recharge_ar').val());
        formData.append('annual_gw_recharge', $('#txt_annual_recharge_ar').val());
        formData.append('estimated_cost', $('#txt_ap_es_cost_ar').val());
        /*formData.append('fund_avail_convergence', $('#txt_fund_avail_ar').val());*/
        /*formData.append('gap_funding_atal', $('#txt_fund_atal_ar').val());*/
        if ($('#SAVE_BTN').text() == "Save") {
            $.ajax({
                url: '/SupplySide/Save_Data_AR',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    GetARData();
                    if (data != 'Data already entered for that Lat, Long') {
                        window.location.reload();
                    }


                }
            });
        }
        if ($('#SAVE_BTN').text() == "Update") {
            formData.append('IDD_AR', IDD_AR);
            $.ajax({
                url: '/SupplySide/Update_Data_AR',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                    GetARData();
                    window.location.reload();
                }
            });
        }
    }

