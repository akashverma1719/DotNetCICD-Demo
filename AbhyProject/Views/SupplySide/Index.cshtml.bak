

@{
    ViewBag.Title = "WSPgram";
    Layout = null;
}
<title>Supply Side</title>
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>

<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- favicon
============================================ -->

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/datecss.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/css/abhycss.css" rel="stylesheet" />
<link href="~/Content/wsp_formcss.css" rel="stylesheet" />
<script src="~/Content/JS_Files/IdealState.js"></script>
<style>
    .color_database {
        color: green !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
</style>

<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<div class="clearfix">
    <header class="header hederImage">
        <div class="clearfix">
            <div class="clearfix">
                <div class="col-lg-9">
                    <div class="header-top-info">
                        <ul class="clearfix">

                            <li>
                                <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                            </li>

                            <li>
                                <span>
                                    <a href="~/home/index" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                </span>
                                <span>
                                    <a href="javascript:;" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                        Ministry of Jal Shakti
                                    </a>
                                </span>
                                <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size: 14px;">Department of Water Resources,</a></span>
                                <span style="text-align:center;">
                                    <a href="javascript:;" title="GOVERNMENT OF INDIA"
                                       style="text-transform:none; font-size:14px;">
                                        River Development & Ganga Rejuvenation
                                    </a>
                                </span>

                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <ul class="imgHome clearfix">

                        <li>
                            <img src="~/Content/WspImages/user-silhouette.png" title="Username" />
                            <span style="color:#fff;">:@Session["UserName"]</span>
                        </li>
                        <li>

                            <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                        </li>

                    </ul>
                </div>
                <div class="col-md-12" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                    <ul class="imgHome clearfix">
                        <li>
                            <a href="~/WspNew/WSP_GWM_HOME">
                                <span>
                                    <img src="~/Content/WspImages/home-icon-silhouette.png" />
                                </span>
                                <label>MIS Login <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>

                        <li>
                            <a href="~/WaterSecurityPlan/WSP_HOME">
                                <span><img src="~/Content/WspImages/home-icon-silhouette.png" /></span>
                                <label>WSP Home <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>

                        <li>
                            <span><img src="~/Content/WspImages/WSP Home.png" style="width:23px;" /></span>
                            <label>Supply Side</label>
                        </li>
                    </ul>
                </div>

            </div>
        </div>


    </header>

    <div class="tab-content">
        <!--Rainfail_menu Start-->
        <div role="tabpanel" class="tab-pane fade in active" id="music">
            <div class="container-fluid">
                <!--images Row Started-->
                <div class="clearfix">
                    <div class="row" id="Select_dist_level">
                        <ul class="Select_option selectbackhome">
                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Block:</label>
                                <span id="spnblock">@Session["gblock"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Gram panchayat:</label>
                                <span id="spngram">@Session["ggram"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Year:</label>
                                <span id="Year">@Session["Year"]</span>
                            </li>
                            
                        </ul>
                        <ul class="selectbackhome" style="float:right;">
                            <li>
                                <a href="~/WaterSecurityPlan/WSP_HOME" class="btn btn-success">
                                    Back To WSP Home
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="row" style="margin-top:10px;">
                        <div class="col-md-12 col-lg-12">
                            <ul class="tabs_menu sru_menu" id="Surface_menu">
                                <li class="tab-link active subtab1" data-tab="menu-11">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/Agriculture_icons/Gram_Panchayat_2icon.png" /></span>
                                        <label>
                                            Artificial Recharge Structures
                                        </label>
                                    </a>
                                </li>

                                @*abhi1204*@

                                @*<li class="tab-link subtab2" data-tab="menu-12">
                                        <a href="javascript:;">
                                            <span><img src="~/Content/Agriculture_icons/PGWMC.png" /></span>
                                            <label>PGWM Committee</label>
                                        </a>
                                    </li>*@
                                <li class="tab-link subtab3" data-tab="menu-13">
                                    <a href="javascript:;">
                                        <span><img src="/Content/Agriculture_icons/location.png" /></span>
                                        <label>
                                            Water Conservation Structures
                                        </label>
                                    </a>
                                </li>
                                @*<li class="tab-link subtab3" data-tab="menu-14">
                                    <a href="javascript:;">
                                        <span><img src="/Content/Agriculture_icons/location.png" /></span>
                                        <label>
                                            Convergence Options (Central Schemes) (For reference)
                                        </label>
                                    </a>
                                </li>*@
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="clearfix tabfirst">
                    <div class="suface-info active" id="menu-11">
                        <div class="clearfix">
                            <div class="container-fluid">
                                <div class="col-lg-12 col-md-12 col-sm-12 form-body" style="padding:10px 15px">
                                    <div class="form-div">
                                        <div class="col-md-12 background-border-Database ">
                                            <div class="row database_trainer_row ">
                                                <h3>
                                                    Artificial Recharge Structures
                                                    @*<a href="javascript:;" data-toggle="tooltip" title="Data Source : Shapefile(Village Boundary)">
                    <span class="glyphicon glyphicon-info-sign" style="color:#fff" aria-hidden="true"></span>
                </a>*@
                                                </h3>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Village Name <span class="Required_star">*</span>:</label>
                                                </div>

                                                @*<div class="col-md-7 col-sm-8">
                <input type="text" id="txt_village_ar" maxlength="25" class="form-control color_database" name="" placeholder="Vilage Name">
            </div>*@
                                                <div class="col-md-7 col-sm-8">
                                                    <select id="txt_village_ar">
                                                        <option value="0">--select Village Name--</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Location Details :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input type="text" id="txt_loaction_Details_ar" maxlength="40" class="form-control color_database" name="" placeholder="Location">
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Type of Artificial recharge Structure<span class="Required_star">*</span> :
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <select id="ddl_structure_ar" onchange="check_other()">
                                                        <option value="0">--select structure--</option>
                                                        <option value="Anicut/Check Dam/Earthen Dam">Anicut/Check Dam/Earthen Dam</option>
                                                        <option value="Basin / Percolation Tanks">Basin / Percolation Tanks</option>
                                                        <option value="Blast Well">Blast Well</option>
                                                        <option value="Bore Hole Flooding">Bore Hole Flooding</option>
                                                        <option value="Borewell Recharge Pit">Borewell Recharge Pit</option>
                                                        <option value="CCT (Continuous Contour Trench)">CCT (Continuous Contour Trench)</option>
                                                        <option value="Contour Bunds And Contour Trenches">Contour Bunds And Contour Trenches</option>
                                                        <option value="Ditch And Furrow System">Ditch And Furrow System</option>
                                                        <option value="Drainage Pit">Drainage Pit</option>
                                                        <option value="Dug Well Recharge">Dug Well Recharge</option>
                                                        <option value="Field Bund">Field Bund</option>
                                                        <option value="Gabion">Gabion</option>
                                                        <option value="Gravity Head Recharge Wells">Gravity Head Recharge Wells</option>
                                                        <option value="Gully Plugs">Gully Plugs</option>
                                                        <option value="Injection Wells/ Recharge Wells">Injection Wells/ Recharge Wells</option>
                                                        <option value="Kolhapuri Bandhara /KT Weir">Kolhapuri Bandhara /KT Weir</option>
                                                        <option value="Leach Pit/Soak Pit">Leach Pit/Soak Pit</option>
                                                        <option value="Multi Arch Check Dam">Multi Arch Check Dam</option>
                                                        <option value="Nala Development & Dredging">Nala Development & Dredging</option>
                                                        <option value="Nalah Bund">Nalah Bund</option>
                                                        <option value="Rechage Pit And Shaft">Rechage Pit And Shaft</option>
                                                        <option value="Recharge Basins">Recharge Basins</option>
                                                        <option value="Spillway ">Spillway </option>
                                                        <option value="Spreading Channel">Spreading Channel</option>
                                                        <option value="Stop Dam">Stop Dam</option>
                                                        <option value="Straggered Trench">Straggered Trench</option>
                                                        <option value="Sub Surface Barrier">Sub Surface Barrier</option>
                                                        <option value="Subsurface Dykes">Subsurface Dykes</option>
                                                        <option value="Trenchs">Trenchs</option>
                                                        <option value="Underground Dams">Underground Dams</option>
                                                        <option value="Other">Other</option>

                                                    </select>
                                                    <input Type="text" id="txt_structure_ar" class="form-control color_database"  placeholder="">
                                                </div>
                                            </div>

                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Latitude of proposed structure<span class="Required_star">*</span> :
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="txt_latitude_ar" maxlength="11" data-decimal="8" oninput="enforceNumberValidation(this)" class="form-control color_database decimal" name="" placeholder="">
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Longitude of proposed structure<span class="Required_star">*</span> :
                                                        <span class="Required_star"></span>
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="txt_longitude_ar" maxlength="11" data-decimal="8" oninput="enforceNumberValidation(this)" class="form-control color_database decimal" name="" placeholder="">
                                                    <label id="AlertError1" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Work Proposed <span class="Required_star">*</span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    @*abhi1204*@
                                                    <select id="ddl_work_rproposed_ar">
                                                        <option value="0">--Select Work Proposed--</option>
                                                        <option value="New">New</option>
                                                        <option value="Renovation">Renovation</option>
                                                    </select>
                                                    <label id="AlertError2" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Storage capacity  (ha m)
                                                        <span class="Required_star">*</span>:
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    @*abhi1204*@
                                                    <input Type="text" id="txt_storage_ar" maxlength="8" class="form-control color_database decimal" name="" placeholder="" oninput="cal_AR()">
                                                    <label id="AlertError3" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Annual no. of fillings
                                                        <span class="Required_star">*</span>:
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="txt_annual_fil_ar" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'');" onkeyup="validatenum()" class="form-control color_database decimal" name="" placeholder="" oninput="cal_AR()">
                                                    <label id="AlertError4" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">
                                                        Recharge (%)<span class="Required_star">*</span> :
</label>
                                                </div>
                                                @*class="form-control alpha"*@
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="txt_recharge_ar" maxlength="3" class="form-control" name="" placeholder="" oninput="cal_AR(event)">
                                                    <label id="AlertError5" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">

                                                    <label for="lname" class="">
                                                        Annual GW Recharge (ha m) :
                                                        <a href="javascript:;" data-toggle="tooltip" title="(Storage Capacity*Annual no. of fillings*Recharge%*0.01)">
                                                            <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                        </a>
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="txt_annual_recharge_ar" class="form-control decimal" name="" placeholder="" disabled>
                                                    <label id="AlertError6" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">
                                                        Financial year<span class="Required_star">*</span> :
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <select class="form-control disable_btn" id="ar_year">
                                                        <option value="0">--Select Financial Year--</option>
                                                        <option value="2023-24">2023-24</option>
                                                        <option value="2024-25">2024-25</option>
                                                    </select>
                                                    <label id="AlertError7" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">
                                                        Department Name<span class="Required_star">*</span>:
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <select class="form-control" id="ar_department_name"></select>
                                                    <label id="AlertError7" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">
                                                        Scheme Name<span class="Required_star">*</span> :
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <select class="form-control" id="ar_scheme_name" onchange="CheckOther()"></select>
                                                    <input type="text" class="form-control" id="other_scheme" style="display:none" />
                                                    <label id="AlertError7" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Total Approximate Estimated Cost(in lakh)
                                                        <span class="Required_star">*</span>:
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">

                                                    <input type="text" id="txt_ap_es_cost_ar" maxlength="7" data-decimal="4" style="margin-top:6px" @*oninput="minus_val_a(this)"*@ class="form-control decimal" />
                                                    <label id="AlertError8" style="float: right;color: red;font-size: 12px!important;"></label>


                                                </div>
                                            </div>
                                            @*<div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">
                                                        Approximate fund available from Convergence (in lakh) :
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="txt_fund_avail_ar" data-decimal="4" class="form-control decimal" name="" placeholder="" oninput="minus_val_a(this)">
                                                    <label id="AlertError10" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>*@


                                            <!--<div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">
                                                        Gap funding from Atal Jal (in lakh) :-->@*(Total Approximate cost- Approximate fund available  from Convergence)*@
                                                        <!--<a href="javascript:;" data-toggle="tooltip" title="= (Total Approximate cost- Approximate fund available  from Convergence)">
                                                            <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                        </a>
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input type="text" id="txt_fund_atal_ar" class="form-control" style="margin-top:6px" disabled />

                                                    <label id="AlertError9" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>-->

                                            <div class="row database_trainer_row_button">
                                                <div class=" col-md-12">
                                                    <div class="text-center" style="margin-bottom:10px;">
                                                        <span style="color:red">Before going to the summary page or next, click on the save button</span>
                                                        <ul class="clearfix btnall" style=" list-style-type: none; margin: 0;  padding: 0;  overflow: hidden;">
                                                            <li>
                                                                @*<button class="btn btnNext">Next</button>*@
                                                                <a href="~/wspDemandSide/DemandSide#" class="btn btn-danger">Back</a>
                                                            </li>
                                                            <li class=" ">
                                                                <button class="btn btn-success btn_disabled" id="SAVE_BTN" onclick="SaveDetails_AR()"> Save </button>

                                                            </li>

                                                            <li class="">
                                                                <button class="btn btnNext">Next</button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="table-responsive" style="overflow-x:scroll;text-align:left">
                                                <div class="text-right">
                                                    <div class="btn btn-success btn_export"><i class="fa fa-file-excel-o" onclick="Export_Table()"> Export To Excel</i></div>
                                                    <input type="button" id="dli_report_excel" onclick="tableToExcel('tbl1' , 'DLI_Data')" hidden />
                                                </div>
                                                <table class="table wa_table table-bordered table-responsive table-__web-inspector-hide-shortcut__ drinkinganddomestic" id="tbl1">
                                                    <thead>
                                                        <tr>
                                                            <th>Sr. No.</th>
                                                            <th>Go to Map</th>
                                                            <th>Village Name</th>
                                                            <th>Location details</th>
                                                            <th>Type of Artificial recharge Structure</th>
                                                            <th>Latitude of proposed structure</th>
                                                            <th>Longitude of proposed structure</th>
                                                            <th>Work proposed</th>
                                                            <th>Storage capacity  (ha m)</th>
                                                            <th>Annual no. of fillings</th>
                                                            <th>Recharge (%)</th>
                                                            <th>Annual GW Recharge (ha m)</th>
                                                            <th>Financial Year</th>
                                                            <th>Department Name</th>
                                                            <th>Scheme Name</th>
                                                            <th>Total Approximate Estimated Cost(in lakh)</th>
                                                            <th>Edit</th>
                                                            <th>Delete</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbl_ar_details"></tbody>
                                                </table>
                                            </div>
                                            <div style="text-align:center;color:red;"><label id="AlertError"></label></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="hair-info" id="menu-13">
                        <div class="clearfix">
