    function Edit_data_ar(id) {
        var formData = new FormData();
        formData.append('id', id);
        $.ajax({
            url: '/SupplySide/Get_Lists_AR_by_id',
            data: formData,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.length != 0) {
                    debugger;
                    var ii = false;
                    var options = $('#ddl_structure_ar option');
                    // Next, translate that into an array of just the values
                    var values = $.map(options, e => $(e).val())

                    $('#txt_village_ar').val(data[0].village_name);
                    $('#txt_loaction_Details_ar').val(data[0].location_detail);
                    var ddl_structure_ar = data[0].type_of_ar;


                    for (var i = 0; i < values.length; i++) {
                        if (values[i] == ddl_structure_ar) {
                            ii = true;
                        }
                    }
                    if (ii == true) {
                        $('#ddl_structure_ar').val(data[0].type_of_ar);
                    } else {
                        $('#ddl_structure_ar').val("Other");
                        $('#txt_structure_ar').val(data[0].type_of_ar);
                    }
                    if ($('#ddl_structure_ar').val() == 'Other') {
                        /*$('#ddl_structure_ar').hide();*/
                        $('#txt_structure_ar').show();
                    }
                    else {
                        $('#ddl_structure_ar').show();
                        $('#txt_structure_ar').hide();
                    }

                    $('#txt_latitude_ar').val(data[0].latitude);
                     $('#txt_longitude_ar').val(data[0].longitude);
                    $('#ddl_work_rproposed_ar').val(data[0].work_proposed);
                    $('#txt_storage_ar').val(data[0].storage_capacity);
                    $('#txt_annual_fil_ar').val(data[0].annual_filling_no);
                    $('#txt_recharge_ar').val(data[0].recharge);
                    $('#txt_annual_recharge_ar').val(data[0].annual_gw_recharge);
                    $('#txt_funding_soruce').val(data[0].fund_resource);
                    $('#txt_ap_es_cost_ar').val(data[0].estimated_cost);
                     /*$('#txt_fund_avail_ar').val(data[0].fund_avail_convergence);*/
                    $("#ar_year").val(data[0].financial_year);
                    $("#ar_department_name").val(data[0].department_name);
                    $("#ar_scheme_name").val(data[0].scheme_name)
                    if (data[0].scheme_name == "Other") {
                        $("#other_scheme").show();
                        $("#other_scheme").val(data[0].other_scheme);
                    }

                    /*$('#txt_fund_atal_ar').val(data[0].gap_funding_atal);*/
                    $("#txt_village_ar").focus();
                    $('#SAVE_BTN').text('Update');
                    IDD_AR = id;
                }
            },
            error:
                function (response) {
                    console.dir(response)
                    //alert("Error: " + response);
                }
        });
    }
