                slection_options += '<option value="0">--Select VillageName-- </option>';

                for (var i = 0; i < Response.length; i++) {
                    slection_options += '<option value="' + Response[i] + '"> ' + Response[i] + ' </option>';
                    console.log(Response[i]);
                }
                $('#txt_village_ar').html(slection_options);
                $('#txt_village_wr').html(slection_options);

            }
            });

    }

    function enforceNumberValidation(ele) {
        debugger;
        var match = false;
        var match2 = false;
        var matchwr = false;
        var matchwr2 = false;
        var lat = $('#txt_latitude_ar').val();
        var long = $('#txt_longitude_ar').val();



        if (!(lat.indexOf(".") == -1)) {
            match = true; // decimal
        } else {
            match = false;
        }
        if (lat.length == 2 && match != true) {
            $('#txt_latitude_ar').val(lat + '.');
        } else if (lat.length == 1 && match != false) {
            $('#txt_latitude_ar').val('');
        }


        if (!(long.indexOf(".") == -1)) {
            match2 = true; // decimal
        } else {
            match2 = false;
        }
        if (long.length == 2 && match2 != true) {
            $('#txt_longitude_ar').val(long + '.');
        } else if (long.length == 1 && match2 != false) {
            $('#txt_longitude_ar').val('');
        }


        var latwr = $('#txt_latitude_wr').val();
        var longwr = $('#txt_longitude_wr').val();

        if (!(latwr.indexOf(".") == -1)) {
            matchwr = true; // decimal
        } else {
            matchwr = false;
        }
        if (latwr.length == 2 && matchwr != true) {
            $('#txt_latitude_wr').val(latwr + '.');
        } else if (latwr.length == 1 && matchwr != false) {
            $('#txt_latitude_wr').val('');
        }


        if (!(longwr.indexOf(".") == -1)) {
            matchwr2 = true; // decimal
        } else {
            matchwr2 = false;
        }
        if (longwr.length == 2 && matchwr2 != true) {
            $('#txt_longitude_wr').val(longwr + '.');
        } else if (longwr.length == 1 && matchwr2 != false) {
            $('#txt_longitude_wr').val('');
        }


        if ($(ele).data('decimal') != null) {
            // found valid rule for decimal
            var decimal = parseInt($(ele).data('decimal')) || 0;
            var val = $(ele).val();
            if (decimal > 0) {
                var splitVal = val.split('.');
                if (splitVal.length == 2 && splitVal[1].length > decimal) {
                    // user entered invalid input
                    $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                }
            } else if (decimal == 0) {
                // do not allow decimal place
                var splitVal = val.split('.');
                if (splitVal.length > 1) {
                    // user entered invalid input
                    $(ele).val(splitVal[0]); // always trim everything after '.'
                }
            }
        }
    }
    var IDD_AR = 0;
    var IDD_WR = 0;
    function GetARData() {
        var strorage_cap = 0;
        var annual_no_fill = 0;
        var recharge = 0;
        var annual_gw_rech = 0;
        var aprx_est_cost = 0;
        var aprx_fund_avail = 0;
        var gap_fund = 0;
        $.ajax({
            type: 'POST',
            dataType: 'JSON',
            url: '/SupplySide/Get_Lists_AR',
            data: {},
            success: function (data) {
                //if (data == "Logout") {
                //    window.location = "/WspNew/WSP_GWM_HOME";
                //}
                debugger;
                $('.loader').hide();
                var tr = '';

                if (data.length != 0) {

                    for (var i = 0; i < data.length; i++) {
                        var scheme_name = "";
                        if (data[i].scheme_name == "Other") {
                            scheme_name = data[i].scheme_name + ' - ' + data[i].other_scheme;
                        } else {
                            scheme_name = data[i].scheme_name;
                        }

                        tr += '<tr><td>' + (parseInt(i) + 1) + '</td><td><a href="/SupplySide/SupplySide_AR_Pointer?id=' + data[i].id + '" style="font-size: 35px;color: dodgerblue;" target="_blank"><i class="bi-geo-alt"></i></a></td><td>' + data[i].village_name + '</td><td>' + data[i].location_detail + '</td>';
                        tr += '<td>' + data[i].type_of_ar + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td>';
                        tr += '<td>' + data[i].work_proposed + '</td><td>' + data[i].storage_capacity + '</td><td>' + data[i].annual_filling_no + '</td>';
                        tr += '<td> ' + data[i].recharge + '</td ><td>' + data[i].annual_gw_recharge + '</td><td>' + data[i].financial_year + '</td><td>' + data[i].department_name + '</td><td>' + scheme_name + '</td>;'
                        tr += '<td> ' + data[i].estimated_cost + '</td>';
                        tr += '<td><button class="btn btn-primary btn_disabled" onclick="Edit_data_ar(\'' + data[i].id + '\')" >update</button > </td>';
                        tr += '<td><button class="btn btn-primary btn_disabled" onclick="Delete_data_ar(\'' + data[i].id + '\')" >Delete</button > </td></tr>';

                        strorage_cap += parseFloat(data[i].storage_capacity);
                        annual_no_fill += parseFloat(data[i].annual_filling_no);
                        recharge += parseFloat(data[i].recharge);
                        annual_gw_rech += parseFloat(data[i].annual_gw_recharge);
                        aprx_est_cost += parseFloat(data[i].estimated_cost);
                        /*aprx_fund_avail += parseFloat(data[i].fund_avail_convergence);*/
                        /*gap_fund += parseFloat(data[i].gap_funding_atal);*/
                    }

                }
                tr += '<tr><td>Total</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td><input type="text" value="' + strorage_cap.toFixed(2) + '" disabled style="width:100%;"/></td>'
                tr += '<td><input type="text" value="' + annual_no_fill.toFixed(2) + '" disabled style="width:100%;"/></td><td><input type="text" value="' + recharge.toFixed(2) + '" disabled style="width:100%;"/></td><td><input type="text" value="' + annual_gw_rech.toFixed(2) + '" disabled style="width:100%;"/></td><td></td><td></td><td></td><td><input type="text" value="' + aprx_est_cost.toFixed(2) + '" disabled style="width:100%;"/></td>'
                tr += '</tr> ';
                $('#tbl_ar_details').html(tr);
                $('#SAVE_BTN').text('Save');
                if (StateOfficer != "Gram Panchyat Nodal Officer") {
                    $('input[type=text]').prop("disabled", true)
                    $('select').prop("disabled", true);
                    $('input[type=file]').prop("disabled", true)
                    $('.btn_disabled').prop("disabled", true);
                }
                IDD_AR = 0;
            },
            error:
                function (response) {
                    console.dir(response)
                    //alert("Error: " + response);
                }
        });
    }

    function toggle(source) {
        checkboxes = document.getElementsByName('supply_ar');
        for (var i = 0, n = checkboxes.length; i < n; i++) {
            checkboxes[i].checked = source.checked;
