
@{
    Layout = "~/Views/Shared/redirectpage.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>कॉपीराइट नीति</title>
</head>
<body>
    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-12 pb-3">
                <h3 class=" border-bottom pb-2 mb-3">कॉपीराइट नीति</h3>
                <ul>
                    <li>

                        <p class="mb-2">इस साइट पर प्रदर्शित सामग्री अटल भूजल योजना परियोजना से संबंधित है और इसे विशिष्ट अनुमति की आवश्यकता के बिना किसी भी प्रारूप या मीडिया में निःशुल्क पुन: प्रस्तुत किया जा सकता है, बशर्ते कि सामग्री को सटीक रूप से पुन: प्रस्तुत किया जा रहा हो और अपमानजनक तरीके से उपयोग नहीं किया जा रहा हो। भ्रामक संदर्भ में. जहां भी सामग्री प्रकाशित/दूसरों को जारी की जा रही हो, स्रोत को प्रमुखता से स्वीकार/घोषित किया जाना चाहिए। हालाँकि, सामग्रियों को पुन: प्रस्तुत करने की अनुमति इस साइट पर उन सामग्रियों तक विस्तारित नहीं है जिन्हें स्पष्ट रूप से किसी तीसरे पक्ष के कॉपीराइट के रूप में पहचाना जाता है। ऐसी सामग्रियों को पुन: प्रस्तुत करने का प्राधिकरण संबंधित कॉपीराइट धारकों से प्राप्त किया जाएगा।</p>
                    </li>


                </ul>
            </div>
        </div>
    </div>
</body>
</html>
