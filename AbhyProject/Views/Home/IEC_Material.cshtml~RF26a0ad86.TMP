<script src="~/Scripts/all_scripts/dataTables.bootstrap.min.js"></script>
@*<script src="https://cdn.datatables.net/1.10.19/js/dataTables.bootstrap.min.js"></script>*@


<style>
    .maindiv {
        width: 100%;
        margin: auto;
    }

    .tbl-responsive {
        overflow-x: inherit;
    }

    .clearfix:after {
        box-sizing: border-box;
    }

    body {
        font-family: "Open Sans", Helvetica, Arial, sans-serif;
    }

    .classic-title {
        margin: 0 0 16px 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid mediumblue;
        font-weight: 600;
        line-height: 1.5em;
    }

    .panel-group > .panel {
        -webkit-border-radius: 6px;
        border: 1px solid #e8e8e8;
        margin: 5px 0;
    }

    /*.panel-group > .panel-heading {
        background-color: #ffad33;
        padding: 0px;
    }*/

    .panel-title > a {
        position: relative;
        display: block;
        color: #444 !important;
        background-color: #fff;
        padding: 10px 21px;
        font-size: 13px;
        font-weight: 700;
    }

    .text-info {
        color: mediumblue;
    }

    .panel-title > a > .control-icon {
        position: absolute;
        top: 50%;
        right: 10px;
        margin-top: -11px;
    }

    .panel-title > a > i {
        font-size: 1.2em;
        padding-right: 5px;
    }



    .dataTables_filter, .dataTables_paginate {
        float: right;
    }

    .list-group-item {
        position: relative;
        display: block;
        padding: 8px 15px !important;
        margin-bottom: -1px;
        font-size: 12px;
        width: 90%;
    }

    .panel-inner > ul.list-group > li.list-group-item > a {
        color: #3a99ed !important;
    }

        .panel-inner > ul.list-group > li.list-group-item > a:hover {
            color: #6FB11D !important;
        }

    span.tablecellhead {
        font-size: 15px;
        font-weight: bold;
        color: mediumblue;
    }

    .dataTables_empty {
        text-align: center;
    }

    .list_table_function {
        float: none;
        width: 93%;
        margin-left: 13px;
        background: none !important;
    }

    .cricle_round {
        background: #30abec;
        color: white;
        font-size: 13px;
        border-radius: 100%;
        font-weight: bold;
        padding: 4px;
        margin: -6px;
        width: 26px;
        height: 24px;
        text-align: center
    }

    .gujarat-video {
        display: none;
    }

    .haryana {
        display: none;
    }

    .karnataka {
        display: none;
    }

    .MP {
        display: none;
    }

    .maharastra {
        display: none;
    }

    .rajsthan {
        display: none;
    }


    .up {
        display: none;
    }
</style>
<script>
    $("nav#primary-menu > ul.main-menu > li:nth-child(4)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(4)").siblings().removeClass('active');
    $("nav#primary-menu > ul.main-menu > li:nth-child(4) > ul.dropdown > li:nth-child(3) ").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(4) > ul.dropdown > li:nth-child(3) ").siblings().removeClass('active');

</script>
