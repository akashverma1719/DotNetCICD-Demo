<style>
    .box-layout {
        /*margin: 21% 20% -16% -16%;*/
        box-sizing: content-box;
        padding: 0px;
        border-radius: 0.3em;
        /*width: 107px;*/
    }

        .box-layout > ul > li > a {
            padding: 40px 40px;
        }


    span.categories {
        color: white;
        font-size: 12px;
        font-weight: bold;
        display: block;
        /*text-align: left;
        float:left;
            */
    }

    .box-layout:hover {
        transition: all .2s ease-in-out;
        transform: scale(1.1);
        border-radius: 0.3em;
        color: darkgreen;
    }

    .glyphicon-eye-open, glyphicon-remove {
        height: 20px;
        width: 20px;
    }

    img#profile {
        height: auto;
        /* max-width: 79%; */
        /* padding: 8px 0px 0px 15px; */
        width: 100%;
        border: 1px solid black;
        border-radius: 100px;
        background-color: #fff;
    }

    td {
        font-weight: bold;
    }

    .upddeleteicon {
        max-width: 70%;
    }

    .modal-footer {
        text-align: center;
        margin-top: 30px;
        margin-bottom: -20px;
    }

    input[type=text], select {
        margin-left: 29%;
        background: none;
        border: none;
        border-bottom: ridge;
    }

    .underline {
        background-color: dodgerblue;
        display: inline-block;
        height: 2px;
        left: 50px;
        margin-top: -4px;
        position: absolute;
        top: 185px;
        -webkit-transform: scale(0, 1);
        transform: scale(0, 1);
        -webkit-transition: all 0.5s linear;
        transition: all 0.5s linear;
        width: 202px;
    }

    .box-layout:active::after {
        background-color: #191970;
    }

    ul.adminhead {
        display: flex;
        margin: 0% 0% 0% 0%;
        background-color: #f5f5f5;
        border-color: lavender;
        border-radius: 0.6em
    }

        ul.adminhead > li > label {
            display: inline-block;
        }

    ul.adminhead1 > li > label > h4 {
        font-size: 21px;
    }

    ul.adminhead1 {
        display: inline-flex;
    }

        ul.adminhead1 > li {
            padding: 6px 10px 0px 9px;
        }

    ul.adminhead > li {
        padding: 5px 10px 0px 10px;
    }

    h4#profilename {
        margin-top: 10px;
    }

    .nav-pills > li + li {
        margin-left: 0px;
    }

    ul#myTabs {
        margin: 40px 0px 0px 44px;
    }

        ul#myTabs > li {
            margin: 10px 10px 10px 10px;
        }

    .nav-pills > li.active > a, .nav-pills > li.active > a:hover, .nav-pills > li.active > a:focus {
        color: #fff;
        background-color: #000088;
    }

    .nav > li > a {
        position: relative;
        display: block;
        padding: 26px 26px;
    }

        .nav > li > a:hover, .nav > li > a:focus {
            text-decoration: none;
            background-color: darkgreen;
        }

    img {
        vertical-align: bottom;
    }

    @@media screen and (max-width: 1200px) {
        ul#myTabs > li {
            width: 167px;
            height: 136px;
        }
    }

    .form-inline .form-control {
        margin: 0px 0px 0px 0px;
    }

    .tab-pane {
        margin: 40px 0px 0px 0px;
    }


    ul.myTabs1 {
        background-color: #ddd;
    }

    ul#myTabs1 > li.active::after {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #2E578C;
        content: " ";
        position: absolute;
        bottom: -15px;
        margin-left: -15px;
        left: 50%;
    }

    ul#myTabs1 > li {
        background-color: #3A99ED;
        padding: 0px;
    }

        ul#myTabs1 > li > a {
            color: white;
            padding: 15px;
        }

        ul#myTabs1 > li.active > a,
        ul#myTabs1 > li.active > a:focus,
        ul#myTabs1 > li.active > a:hover {
            color: #fff !important;
            background-color: #2E578C !important;
        }

    .tbl-responsive {
        overflow-x: inherit;
    }
</style>


