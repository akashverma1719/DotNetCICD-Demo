        function get_gwl() {
            /* if (confirm("Are you sure you want to delete this entry?")) {*/
            var value = $('#gwl_id').val();
            if (value == "") {
                alert("Please Enter Water level Id");
                return false;
            }
            else {
                $('#gwl_datatable').show();
                $.ajax({
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    url: "/mapview/get_gwl",
                    data: "{'id':'" + value + "'}",
                    dataType: 'JSON',
                    success: function (response) {
                        //alert(response);
                        if (response == "Logout") {
                              window.location = "/Home/LogOut";
                        }
                        var Tbodyhtml = '';
                        if (response == 'No Data') {
                            Tbodyhtml = '<tr colspan="5"><td colspan="5" style="text-align: center;">No Data</td></tr>';
                            $('#tbl_details').html(Tbodyhtml);

                        }
                        else if (response == 'Error') {
                            $('#gwl_datatable').hide();
                        }
                        else {

                            response.sort((a, b) => new Date(b.gwl_date) - new Date(a.gwl_date));

                            // Initialize an empty string to store the HTML for the table rows
                            let Tbodyhtml = '';
                            for (var i = 0; i < response.length; i++) {
                                Tbodyhtml += '<tr id="AWP1_TR_data_waterflow' + i + '"><td id="srNo">' + (i + 1) + '</td>';
                                Tbodyhtml += '<td id="vill">' + response[i].gwl_meta_id + '</td>';
                                Tbodyhtml += '<td id="vill">' + response[i].gwl_reading + '</td>';
                                Tbodyhtml += '<td id="vill">' + response[i].gwl_date + '</td></tr >';

                            }
                            $('#tbl_details').html(Tbodyhtml);
                        }

                    }
                });
            }
        }

