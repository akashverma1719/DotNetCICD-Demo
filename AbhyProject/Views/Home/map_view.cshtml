        function find_data() {
            var data = $('#finddata').val();
            if (data == "level") {
                $('#level').show();
                $('#flow').hide();
                $('#rainfall').hide();
                $('#gwl_datatable').hide();
                $('#flow_datatable').hide();
                $('#rainfall_datatable').hide();
            }
            else if (data == "flow") {
                $('#level').hide();
                $('#flow').show();
                $('#rainfall').hide();
                $('#gwl_datatable').hide();
                $('#flow_datatable').hide();
                $('#rainfall_datatable').hide();
            }
