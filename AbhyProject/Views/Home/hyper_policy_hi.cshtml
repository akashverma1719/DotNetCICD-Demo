
@{
    Layout = "~/Views/Shared/redirectpage.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>हाइपरलिंकिंग नीति</title>
</head>
<body>
    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-12 pb-3">
                <h3 class=" border-bottom pb-2 mb-3">हाइपरलिंकिंग नीति</h3>
                <ul>
                    <li>

                        <p class="mb-2">वेबसाइट पर मौजूद बाहरी लिंक: इस वेबसाइट में कई स्थानों पर आपको अन्य वेबसाइटों/पोर्टलों के वेब-लिंक मिल सकते हैं। ये लिंक आपकी सुविधा के लिए रखे गए हैं। अटल भूजल योजना लिंक की गई वेबसाइटों की सामग्री और विश्वसनीयता के लिए जिम्मेदार नहीं है और जरूरी नहीं कि उनमें या उनके प्रकाशित वेब-लिंक के माध्यम से पहुंच योग्य वेबसाइटों पर व्यक्त विचारों का समर्थन करता हो। इस वेबसाइट पर केवल लिंक की उपस्थिति या इसकी सूची को किसी भी प्रकार का समर्थन नहीं माना जाना चाहिए। हम इसकी गारंटी नहीं दे सकते कि ये लिंक हर समय काम करेंगे और इन लिंक किए गए पृष्ठों की उपलब्धता/अनुपलब्धता पर हमारा कोई नियंत्रण नहीं है।</p>
                    </li>
                    <li>

                        <p class="mb-2">अन्य वेबसाइटों/पोर्टलों द्वारा अटल भूजल योजना के लिंक: किसी भी वेबसाइट/पोर्टल से इस वेबसाइट पर हाइपरलिंक निर्देशित करने से पहले पूर्व अनुमति की आवश्यकता होती है। इसके लिए अनुमति, उन पृष्ठों पर सामग्री की प्रकृति बताते हुए जहां से लिंक दिया जाना है और हाइपरलिंक का सटीक भाषा-पाठ अटल-जल[एट]जीओवी[डॉट]इन पर अनुरोध भेजकर प्राप्त किया जाना चाहिए। .</p>
                    </li>

                </ul>
            </div>
        </div>
    </div>
</body>
</html>
