
@{
    Layout = "~/Views/Shared/WebsiteLayout_hindi.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>term_condition</title>
</head>
<body>
    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-12 pb-3">
                <h3 class=" border-bottom pb-2 mb-3">उपयोग की शर्तें</h3>
                <ul>
                    <li>
                        <p class="mb-2">यह पोर्टल अटल भूजल योजना द्वारा विकसित किया गया था और राष्ट्रीय सूचना विज्ञान केंद्र (एनआईसी) द्वारा होस्ट किया गया था।</p>
                    </li>
                    <li>
                        <p class="mb-2">हालाँकि इस पोर्टल पर सामग्री की सटीकता सुनिश्चित करने के लिए सभी प्रयास किए गए हैं, लेकिन इसे कानून के बयान के रूप में नहीं समझा जाना चाहिए या किसी कानूनी उद्देश्यों के लिए उपयोग नहीं किया जाना चाहिए। अटल भूजल योजना परियोजना सामग्री की सटीकता, पूर्णता, उपयोगिता या अन्यथा के संबंध में कोई जिम्मेदारी स्वीकार नहीं करती है। उपयोगकर्ताओं को सलाह दी जाती है कि वे किसी भी जानकारी को सत्यापित/जांचें, और जानकारी पर कार्रवाई करने से पहले कोई उचित पेशेवर सलाह प्राप्त करें। </p>
                    </li>
					<li>
                        <p class="mb-2">उपयोग की ये शर्तें भारतीय कानूनों के अनुसार नियंत्रित और समझी जाएंगी। उनके नियमों और शर्तों के तहत उत्पन्न होने वाला कोई भी विवाद भारत की अदालतों के विशेष क्षेत्राधिकार के अधीन होगा। </p>
                    </li>
					<li>
                        <p>अटल भूजल योजना परियोजना, जल संसाधन, आरडी और जीआर विभाग, जल शक्ति मंत्रालय, भारत सरकार द्वारा आपके लिए लाई गई सभी सामग्री और जानकारी। </p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
