    <!-- Second Modal Add End -->
    <div class="header">
        <div class="sidebar-brand sidebar_logo">
            <a href="~/Home/map_view">
                <img src="~/Content/Agriculture_icons/logo.png" alt=""> <span>
                    Atal Bhujal
                    Yojana
                </span>
            </a>
        </div>
        <div class="icons" id="info_icons">
            <i class="fa fa-info-circle"></i>
        </div>

    </div>
    <div class="imgBox">
        <img src="~/Content/Agriculture_icons/Identify.jpg" alt="">
    </div>

    <div class="page-wrapper chiller-theme toggled">
        <a id="show-sidebar" class="btn btn-sm btn-primary" href="#">
            <i class="fas fa-bars"></i>
        </a>
        <nav id="sidebar" class="sidebar-wrapper">
            <div class="sidebar-content">
                <div class="sidebar-brand">
                    <a href="index.html"><img src="logo.png" alt=""> <span>Atal Bhujal Yojana</span></a>
                    <div id="close-sidebar">
                        <i class="fas fa-times"></i>
                    </div>
                </div>


                <!-- sidebar-header  -->
                <!-- sidebar-search  -->
                <div class="sidebar-menu">
                    <ul>
                        <li class="header-menu">
                            <!-- <span>General</span> -->
                        </li>
                        <li class="sidebar-dropdown">
                            <a href="#">
                                <i class="fa fa-globe"></i>
                                <span>Select Area (Atal Jal)</span>

                            </a>
                            <div class="sidebar-submenu">
                                <div class="form_container">
                                    <h5>Select Area</h5>

                                    <form>
                                        <div class="form-group">
                                            <label for="">Select State</label>
                                            <select id="cntry" class="custom-select custom-select-sm">
                                                <option>--select--</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="formGroupExampleInput2">Select District</label>
                                            <select id="District" class="custom-select custom-select-sm">
                                                <option>--select--</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="formGroupExampleInput2">Select Block</label>
                                            <select id="Block" class="custom-select custom-select-sm">
                                                <option>--select--</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="formGroupExampleInput2">Select Gram Panchayat</label>
                                            <select id="Gram" class="custom-select custom-select-sm">
                                                <option>--select--</option>
                                            </select>
                                        </div>

                                        <!-- <div class="form-group">
                                            <label for="formGroupExampleInput2">Choose Well</label>
                                            <select id="WellV" class="custom-select custom-select-sm">
                                                <option>--select--</option>
                                            </select>
                                        </div> -->

                                    </form>
                                </div>
                                <div class="data_box">
                                    <h4>Statistics:-</h4>
                                    <h6>Water Level Observation Well : <span class="badge badge-primary" id="wl_count"></span></h6>
                                    <h6>Water Quality Observation Well : <span class="badge badge-primary" id="wq_count"></span></h6>
                                    <!-- <h6>Piezometer :<span class="badge badge-primary" id="piezometer_count"></span></h6> -->
                                    <h6>
                                        ARS and WCS Structures : <span class="badge badge-primary" id="ar_count"></span>
                                    </h6>
                                    <h6>Rainguage : <span class="badge badge-primary" id="rg_count"></span> </h6>
                                    <h6>Water Flow Meter : <span class="badge badge-primary" id="wf_count"></span> </h6>
                                    <h6>
                                        Well Inventory (In GPs) : <span class="badge badge-primary"
                                                                        id="well_count"></span>
                                    </h6>

                                </div>


                            </div>
                        </li>
                        <!-- <li class="sidebar-dropdown">
                            <a href="#">
                                <i class="fa fa-tachometer-alt"></i>
                                <span>Dashboard</span>
                            </a>

                        </li> -->
                        <li class="sidebar-dropdown">
                            <a href="#" id="show_attributes">
                                <i class="fa fa-snowflake"></i>
                                <span>Attributes</span>
                            </a>
                            <!-- <div class="sidebar-submenu">

                            </div> -->
                        </li>
                        <!-- <li class="sidebar-dropdown">
                            <a href="#" id="show_count">
                                <i class="far fa-gem"></i>
                                <span>Well Inventory Statistics</span>
                            </a>
                            <div class="sidebar-submenu">

                            </div>
                        </li> -->
                        <li class="sidebar-dropdown">
                            <div class="ml-4">
                                <button class="btn btn-sm btn-info" id="map_data" type="submit">Hover ON</button>
                                <button class="btn btn-sm btn-info" id="map_data_off" type="submit">Hover OFF</button>
                            </div>
                        </li>


                    </ul>


                </div>
                <!-- sidebar-menu  -->
            </div>
            <!-- sidebar-content  -->
        </nav>

        <!-- main Content Start -->
        <main class="page-content">
            <div class="container-fluid">

                <div class="row">
                    <div class="esri-widget">
                        <calcite-loader id="calciteLoader" label="loading" type="indeterminate"
                                        hidden="true"></calcite-loader>



                        <!-- ////From Here Water Quality Data is Coming -->





                        <div id="tabledata" class="box_shadow1">
                            <div class="flex_box_water_tbl">
                                <h4>Water Quality Table</h4>
                                <input type="text" id="myinput" class="form-control-sm w-25 mr-5"
                                       placeholder="Search..." title="Type in something">
                                <div class="fas fa-times water_close"></div>
                            </div>
                            <!-- <p>Key in your input to filter the table:</p> -->
                            <!-- <p>Click on the header of a column to sort the table:</p> -->

                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>
                                                <span id="ph" class="w3-button table-column">
                                                    PH<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="ec" class="w3-button table-column">
                                                    EC(µs/cm) <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="tds" class="w3-button table-column">
                                                    TDS <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="th" class="w3-button table-column">
                                                    TH(mg/l) <i class="caret"></i>
                                                </span>
                                            </th>

                                            <th>
                                                <span id="calcium" class="w3-button table-column">
                                                    Calcium (mg/l)<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="magnesium" class="w3-button table-column">
                                                    Magnesium (mg/l) <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="sodium" class="w3-button table-column">
                                                    Sodium (mg/l)<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="potassium" class="w3-button table-column">
                                                    Pottasium (mg/l) <i class="caret"></i>
                                                </span>
                                            </th>

                                            <th>
                                                <span id="carbonate" class="w3-button table-column">
                                                    Carbonate (mg/l)<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="bicarbonate" class="w3-button table-column">
                                                    Bicarbonate (mg/l)
                                                    <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="sulphate" class="w3-button table-column">
                                                    Sulphate (mg/l) <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="choloride" class="w3-button table-column">
                                                    Choloride (mg/l) <i class="caret"></i>
                                                </span>
                                            </th>

                                            <th>
                                                <span id="flouride" class="w3-button table-column">
                                                    Flouride (mg/l)<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="nitrate" class="w3-button table-column">
                                                    Nitrate (mg/l) <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="wellid " class="w3-button table-column">
                                                    Well_ID <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="years" class="w3-button table-column">
                                                    Years <i class="caret"></i>
                                                </span>
                                            </th>

                                        </tr>
                                    </thead>
                                    <tbody id="mytable"></tbody>
                                </table>
                            </div>
                        </div>


                        <!-- ////Upto Here Water Quality Data is Coming -->



                        <div id="tabledatarg" class="box_shadow2">
                            <!-- <p>Key in your input to filter the table:</p> -->

                            <div class="flex_box_raing_tbl">
                                <h4>Rainguage Table</h4>
                                <input type="text" id="myinputrg" placeholder="Search..."
                                       class="form-control-sm w-25 mr-5" title="Type in something">
                                <div class="fas fa-times rain_close"></div>
                            </div>
                            <!-- <p>Click on the header of a column to sort the table:</p> -->

                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>
                                                <span id="rf_meta_id" class="w3-button table-column">
                                                    ID<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="rf_reading" class="w3-button table-column">
                                                    RF Reading <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="rf_date" class="w3-button table-column">
                                                    RF Date <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="rf_date_time" class="w3-button table-column">
                                                    RF Date Time <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="id" class="w3-button table-column">
                                                    ID <i class="caret"></i>
                                                </span>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="mytablerg"></tbody>
                                </table>
                            </div>
                        </div>


                        <div id="tabledatawl" class="box_shadow3">
                            <!-- <p>Key in your input to filter the table:</p> -->

                            <div class="flex_box_wl_tbl">
                                <h4>Water Level</h4>
                                <input type="text" id="myinputwl" placeholder="Search..."
                                       class="form-control-sm w-25 mr-5" title="Type in something">
                                <div class="fas fa-times wl_close"></div>
                            </div>
                            <!-- <p>Click on the header of a column to sort the table:</p> -->

                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>
                                                <span id="gwl_meta_id" class="w3-button table-column">
                                                    GWL ID<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="gwl_reading" class="w3-button table-column">
                                                    GWL Reading (mg/l) <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="gwl_date" class="w3-button table-column">
                                                    GWL Date <i class="caret"></i>
                                                </span>
                                            </th>
                                            <!-- <th><span id="gwl_email" class="w3-button table-column">GWL E mail <i
                                                        class="caret"></i></span>
                                            </th> -->
                                            <!-- <th><span id="date_time" class="w3-button table-column">Date Time <i
                                                        class="caret"></i></span>
                                            </th> -->
                                            <!-- <th><span id="id" class="w3-button table-column">ID<i
                                                class="caret"></i></span> -->
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="mytablewl"></tbody>
                                </table>
                            </div>
                        </div>



                        <div id="tabledatawf" class="box_shadow4">
                            <!-- <p>Key in your input to filter the table:</p> -->

                            <div class="flex_box_wf_tbl">
                                <h4>Water Flow</h4>
                                <input type="text" id="myinputwf" placeholder="Search..."
                                       class="form-control-sm w-25 mr-5" title="Type in something">
                                <div class="fas fa-times wf_close"></div>
                            </div>
                            <!-- <p>Click on the header of a column to sort the table:</p> -->

                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>
                                                <span id="wf_meta_id" class="w3-button table-column">
                                                    WF Meta ID<i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="waterreading_date" class="w3-button table-column">
                                                    Water
                                                    Reading Reading <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="meterreading" class="w3-button table-column">
                                                    Meter Reading <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="wf_date_time" class="w3-button table-column">
                                                    Date Time <i class="caret"></i>
                                                </span>
                                            </th>
                                            <th>
                                                <span id="wf_email" class="w3-button table-column">
                                                    WF Email <i class="caret"></i>
                                                </span>
                                            </th>

                                            <!-- <th><span id="id" class="w3-button table-column">ID<i
                                                        class="caret"></i></span>
                                            </th> -->
                                        </tr>
                                    </thead>
                                    <tbody id="mytablewf"></tbody>
                                </table>
                            </div>
                        </div>







                        <!-- </div> -->
                        <!-- <button id="exportButton">Export to CSV</button> -->
                        <!-- <table class="tb" id="historyTable">

                        </table> -->


                    </div>
                    <div id="viewDiv" class="map_view">



                        <div class="item1">
                            <img id='loading' src="https://i.stack.imgur.com/qq8AE.gif" />

                        </div>

                        <div class="container">


                        </div>

                        <div id="sel" class="esri-component esri-widget--button esri-widget" role="button">
                            <span class="esri-icon esri-icon-cursor"></span>
                        </div>
                    </div>

                    <!-- <div id="infoDiv" class="esri-widget">
                        <button id="cluster" class="esri-button">Disable Clustering</button>
                        <div id="legendDiv"></div>
                    </div> -->


                </div>

            </div>

        </main>
        <!-- main Content End -->
    </div>



    <div id="info">
        <span id="headd"></span> <br />
        <span id="name"></span> <br />
        <span id="category"></span> <br />
