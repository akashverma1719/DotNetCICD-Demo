    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body>






    <!--Custom Modal Add Start -->
    <div class="modal_view">
        <div class="modal_content_view">
            <span class="close-button" id="close_button">×</span>
            <h5>View Data</h5>
            <h6>
                <li class="sidebar-dropdown">
                    <a href="#" id="show_count">
                        <i class="far fa-gem"></i>
                        <span>Well Inventory Statistics</span>
                    </a>
                    <div class="sidebar-submenu">

                    </div>
                </li>
            </h6>
            <h4>
                <div class="box">

                    <button class="btn" id="exportButton">Export State</button>
                    <button class="btn" id="exportButtond">Export District</button>
                    <button class="btn" id="exportButtonb">Export Block</button>
                    <button class="btn" id="exportButtong">Export Gram Panchayat</button>
                    <button class="btn" id="exportButtonwl">Export Water Level</button>
                    <button class="btn" id="exportButtonwq">Export Water Quality</button>
                    <button class="btn" id="exportButtonrg">Export Rainguage</button>
                    <button class="btn" id="exportButtonwfm">Export Water Flow Meter</button>
                    <button class="btn" id="exportButtonwi">Export Well Inventory</button>
                    <button class="btn" id="exportButtongeo">Export Geotagging</button>
                </div>
            </h4>
