    <!--Custom Modal Add End-->
    <!-- Second Modal Add Start -->
    <div class="sec_modal_view">
        <div class="sec_modal_content_view">
            <span class="sec_close-button" id="close_button_sec">×</span>
            <h4>Summary</h4>
            <h5>Abbreviations</h5>
            <h6>Well Inventory:- WI</h6>
            <hr>
            <div class="sec_tabs_section">
                <div class="tab_sec_menu">
                    <ul>
                        <li>
                            <a href="javaScript:void(0);" value="state_area" id="state_area" class="tab-sec active-a"
                               data-id="tab1a">State WI</a>
                        </li>
                        <li>
                            <a href="javaScript:void(0);" value="dist_area" id="dist_area" class="tab-sec"
                               data-id="tab2b">
                                District WI
                            </a>
                        </li>
                        <li>
                            <a href="javaScript:void(0);" class="tab-sec" value="block_area" id="block_area"
                               data-id="tab3c">
                                Block WI
                            </a>
                        </li>
                        <li>
                            <a href="javaScript:void(0);" class="tab-sec" value="gram_area" id="gram_area"
                               data-id="tab4d">Gram Panchayat WI</a>
                        </li>

                    </ul>
                </div>

                <div class="tab_sec tab_sec_active" data-id="tab1a">
                    <div class="container custom_sec_con">
                        <div id="theTable"></div>
                    </div>
                </div>
                <div class="tab_sec" data-id="tab2b">
                    <div class="container custom_sec_con">
                        <div id="theTabled"></div>
                    </div>
                </div>
                <div class="tab_sec" data-id="tab3c">
                    <div class="container custom_sec_con">
                        <div id="theTableb"></div>
                    </div>
