<style>
    @@import url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css);


    .slick-prev {
        left: 15px;
    }

    .highcharts-credits {
        display: none !important;
    }

    tspan {
    }

    .slick-prev, .slick-next {
        width: 30px;
        height: 30px;
        background-color: #fff;
        border-radius: 50%;
        right: 15px !important;
    }

    .slick-prev {
        left: 20px;
    }

        .slick-prev:before, .slick-next:before {
            color: #000000 !important;
        }

        .slick-prev:hover, .slick-prev:focus, .slick-next:hover, .slick-next:focus {
            color: transparent;
            outline: none;
            background: #337ab7;
        }

    .slick-next {
        right: 0px;
    }

    .slick-prev::before {
        content: "\f104";
    }

    .slick-next::before {
        content: "\f105";
    }

    .slick-prev:before, .slick-next:before {
        font-family: FontAwesome;
        font-size: 30px;
    }

    .text-dark {
        color: green;
    }

    .sometext {
        text-align: justify;
        padding-right: 20px;
    }

    .capital {
        width: 200px !important;
    }

    #today h2 {
        color: #fff;
        width: 600px !important;
    }

    .capital h3 {
        text-align: center;
        font-size: 18px !important;
    }

    p.wind {
        margin: 10px;
        text-align: center;
        color: #fff;
    }

    p.minmax {
        padding: 0px !important;
        font-size: 14px !important;
        text-align: center;
        color: #fff;
    }

    .capital > a > h4 {
        text-align: center;
        color: #dbda63;
    }

        .capital > a > h4 > label {
            font-size: 24px;
        }

    .capital1 > a:after {
        position: absolute;
        content: "";
        height: 100%;
        width: 1px;
        display: block;
        background-color: #fff;
        right: -1px;
        top: -5px
    }

    h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
        font-family: inherit;
    }

    #today {
        background: linear-gradient(45deg,#3699ea,#0a6dbe, #146eb7,#146eb7) !important;
    }

    caption {
        top: 156px !important;
    }

    .mb-38 {
        margin-bottom: 0px;
    }

    .mt-31 {
        margin-top: 0px;
    }


    .about-area .col-md-6:last-child {
        padding-left: 15px;
    }

    p {
        line-height: 24px !important;
        /*#28394a*/
    }

    #services h2 {
        color: #195b9b !important;
    }

    #promo > h2 {
        color: #195b9b;
    }

    .col8 {
        max-width: 13.5%;
    }

    @@media screen and (max-width: 1000px) and (min-width: 300px) {
        .col8 {
