        }

        .imgageright {
            right: 25px !important;
        }

        #promo {
            padding-right: 20px !important;
        }
    }

    .imgageright {
        top: 20px;
        position: absolute;
        right: 78px;
        width: 82px;
    }

    .mt-31 {
        margin-top: 0px;
        text-align: center;
        color: #000000;
    }

    .col555 {
        color: #000000;
        background-color: #fff;
        padding: 10px;
        /*#E2cf31;*/
    }

    .text-dark {
        color: #1f223e !important;
    }

    .link > a {
        position: relative;
