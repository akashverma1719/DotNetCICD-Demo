<script>
    var state_name = "";
    var state_id = "";
    var Jsondata = "";

    function getstatewiseStartdata(name, sid) {

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/Dashboard/gostatedata',
            data: '{"statename":"' + name + '","stateid":"' + sid + '"}',
            dataType: 'JSON',
            success: function (data) {
               var Jsondata1 = data;
                getvillagewisefilter(Jsondata1);

                //$(".loading-container").hide();
            }
        });
    }


    function getdistrictdata() {
         $("#state").html("");

          $("#Dashdist").html("");
                        $("#Dashdist").prepend($('<option></option>').val("").html("Select District"));
                        $("#Dashblock").html("");
                        $("#Dashblock").prepend($('<option></option>').val("").html("Select Block"));
                        $("#Dashgram").html("");
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashvillage").html("");
        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/Dashboard/dashboardDistrictJsondata',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                $("#state").append($('<option value="0"></option>').val("").html("Select State"));
                Jsondata = JSON.parse(data);

                $.each(Jsondata, function (i, stateval) {

                    $("#state").append($('<option></option>').val(stateval.sid).html(stateval.statename));
                });
               // $("#state").prepend($('<option></option>').val("").html("Select State"));
                $("#state").val("");

                $("#state").change(function () {
                    if (this.value != "") {
                        var distid = this.value;
                        var distjsondata = Jsondata.filter(m => m.sid == distid);
                        $("#Dashdist").html("");
                        $("#Dashblock").html("");
                        $("#Dashblock").prepend($('<option></option>').val("").html("Select Block"));
                        $("#gram").html("");
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                        $.each(distjsondata, function (i, dist) {
                            $.each(dist.abhy_districts, function (j, distval) {
                                $("#Dashdist").append($('<option></option>').val(distval.did).html(distval.district_name));
                            });
                        });
                        $("#Dashdist").prepend($('<option></option>').val("").html("Select District"));
                        $("#Dashdist").val("");
                    }
                    else {
                        $("#Dashdist").html("");
                        $("#Dashdist").prepend($('<option></option>').val("").html("Select District"));
                        $("#Dashblock").html("");
                        $("#Dashblock").prepend($('<option></option>').val("").html("Select Block"));
                        $("#Dashgram").html("");
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                    }
                });
                $("#Dashdist").change(function () {
                    if (this.value != "" && $("#state").val() != "") {
                        var distjsondata2 = Jsondata.filter(m => m.sid == $("#state").val());
                        var mandjsondata = distjsondata2[0].abhy_districts.filter(m => m.did == this.value);
                        $("#Dashblock").html("");
                        $("#Dashgram").html("");
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                        $.each(mandjsondata, function (j, mandval) {
                            $.each(mandval.abhy_blocks, function (k, mandval2) {
                                $("#Dashblock").append($('<option></option>').val(mandval2.bid).html(mandval2.block_name));
                            });
                        });
                        $("#Dashblock").prepend($('<option></option>').val("").html("Select Block"));
                        $("#Dashblock").val("");
                    }
                    else {
                        $("#Dashblock").html("");
                        $("#Dashblock").prepend($('<option></option>').val("").html("Select Block"));
                        $("#Dashgram").html("");
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                    }
                });
                    $("#Dashblock").change(function () {
                    if (this.value != "" && $("#state").val() != "" && $("#Dashdist").val() != "") {
                        var distjsondata3 = Jsondata.filter(m => m.sid == $("#state").val());
                        var mandjsondata2 = distjsondata3[0].abhy_districts.filter(m => m.did == $("#Dashdist").val());
                        var gramjsonata = mandjsondata2[0].abhy_blocks.filter(m => m.bid == this.value);
                        $("#Dashgram").html("");
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                        $.each(gramjsonata, function (j, gramval) {
                            $.each(gramval.abhy_grampanchayat, function (k, gramval2) {
                                $("#Dashgram").append($('<option></option>').val(gramval2.gpid).html(gramval2.gpname));
                            });
                        });
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashgram").val("");
                    }
                    else {
                        $("#Dashgram").html("");
                        $("#Dashgram").prepend($('<option></option>').val("").html("Select Gram Panchayat"));
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                    }
                });
            var data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
                $("#Dashgram").change(function () {
                    if (this.value != "" && $("#state").val() != "" && $("#Dashdist").val() != "" && $("#Dashblock").val() != "") {
                        var distjsondata4 = Jsondata.filter(m => m.sid == $("#state").val());
                        var mandjsondata3 = distjsondata4[0].abhy_districts.filter(m => m.did == $("#Dashdist").val());
                        var gramjsonata2 = mandjsondata3[0].abhy_blocks.filter(m => m.bid == $("#Dashblock").val());
                        var villagejsondata = data.filter(m => m.sid == $("#state").val() && m.did == $("#Dashdist").val() && m.bid == $("#Dashblock").val() && m.gpid == this.value);
                        //var villagejsondata = gramjsonata2[0].abhy_grampanchayat.filter(m => m.gpid == this.value);
                        $("#Dashvillage").html("");
                        $.each(villagejsondata, function (j, villageval) {
                            //$.each(villageval.abhy_villages, function (k, villageval2) {
                            $("#Dashvillage").append($('<option></option>').val(villageval.vid).html(villageval.viname));
                           // });
                        });
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                        $("#Dashvillage").val("");
                    }
                    else {
                        $("#Dashvillage").html("");
                        $("#Dashvillage").prepend($('<option></option>').val("").html("Select Village"));
                    }
                });

            }
        });
    }






</script>
<script>
    function getfilterdata() {


        debugger;
        var ddlstate = "";
        var ddldistrict = "";
        var ddlblock = "";
        var ddlgp = "";
        var statename = "";
        var ddlstateid = "";
        var ddldistid = "";
        var ddlblockid = "";
        var ddlgpid = "";
        var ddlvillage = "";

        if ($("#state option:selected").text() != "Select State") {
            ddlstate = $("#state option:selected").text();
            ddlstateid = $("#state").val();

            $('#listate').show();
            $('#spnstate').text(ddlstate);

        }
        else {
            alert('Please Select State Name');
            $("#state").focus();
            $('#listate').hide();
            return false();
        }
        if ($("#Dashdist option:selected").text() != "Select District") {
            ddldistrict = $("#Dashdist option:selected").text();
            ddldistid = $("#Dashdist").val();
            $('#lidistrict').show();
            $('#spndistrict1').text(ddldistrict);
        }
        else {

            $('#lidistrict').hide();

        }
        if ($("#Dashblock option:selected").text() != "Select Block") {
            ddlblock = $("#Dashblock option:selected").text();
            ddlblockid = $("#Dashblock").val();
            $('#liblock').show();
            $('#spnblock1').text(ddlblock);
        }
        else {
            $('#liblock').hide();
        }

        if ($("#Dashgram option:selected").text() != "Select Gram Panchayat") {
            ddlgp = $("#Dashgram option:selected").text();
            ddlgpid = $("#Dashgram").val();
            $('#lipanchayat').show();
            $('#spnpanchayat1').text(ddlgp);
        } else {

            $('#lipanchayat').hide();
        }

        if ($("#Dashvillage option:selected").text() != "Select Village") {
            ddlvillage = $("#Dashvillage option:selected").text();
            $('#livillage').show();
            $('#spnvillage1').text(ddlvillage);
        }
        debugger;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/Dashboard/gofillterdata',
            data: '{"state":"' + ddlstate + '","district":"' + ddldistrict + '","block":"' + ddlblock + '","gp":"' + ddlgp + '","statename":"' + ddlstate + '","stateid":"' + ddlstateid + '","distid":"' + ddldistid + '","blockid":"' + ddlblockid + '","gpid":"' + ddlgpid + '"}',
            dataType: 'JSON',
            success: function (data) {
                getdistrictdata();
                getvillagewisefilter(data);

            }
        });
    }
    function getvillagewisefilter(result1) {

        var result = "";
        if (result1 != null) {

            result = result1;
            var gwl_totwells_count = 0;
            var gwl_improvedwells_count = 0;
            var implementationsites_count = 0;

            var gwl_totwells = result.Abhy_groundwater_levels;
            var gwl_improvedwells = result.Abhy_WaterUtilization_Approvals;
            for (var g = 0; g < gwl_totwells.length; g++) {
                gwl_totwells_count = (g + 1);
                for (var f = 0; f < gwl_improvedwells.length; f++) {
                    if (gwl_totwells[g]["site_type"] === gwl_improvedwells[f]["site_type"]) {
                        gwl_improvedwells_count = (f + 1);
                    }
                    if (gwl_totwells[g]["site_type"] === gwl_improvedwells[f]["site_type"] && gwl_improvedwells[f]["accept"] === "1") {
                        implementationsites_count = (f + 1);
                    }
                }
            }
            $('#gwltotwells').html(gwl_totwells_count);
            $('#gwlimprovedwells').html(gwl_improvedwells_count);
            var gwl_declined = parseFloat(parseFloat(gwl_totwells_count) - parseFloat(gwl_improvedwells_count));
            $('#gwldeclinedwells').html(gwl_declined);


            //sir is told me the above mentioned details sowing here.
            $('#gwlPiezometertotal').html(gwl_totwells_count);
            $('#gwlPiezometerworking').html(gwl_improvedwells_count);




            var gps_Count1 = 0;
            var improvedgps_Count1 = 0;
            var gps_count = result.abhy_grampanchayas;
            var gwb_Budget = result.abhystates_completecensusdata_Inserts;
            for (var j = 0; j < gps_count.length; j++) {
                gps_Count1 = (j + 1);
                for (var d = 0; d < gwb_Budget.length; d++) {
                    if (gps_count[j]["gpname"] === gwb_Budget[d]["gram_panchayat_name"] && gwb_Budget[d]["approvedorreject"] === "2") {
                        improvedgps_Count1 = (d + 1);
                    }
                }
            }
            $('#gwb_totalgps').html(gps_Count1);
            $('#gwb_improvedgps').html(improvedgps_Count1);
            var declined_gps = parseFloat(parseFloat(gps_Count1) - parseFloat(improvedgps_Count1));
            $('#gwb_diclinedgps').html(declined_gps);

            var wspprepared_Count1 = 0;
            var wsppreparedcompleted_Count1 = 0;
            var wspimplementedcompleted_Count1 = 0;
            var wspprepared_data = result.abhy_grampanchayas;
            var wspsupply_data = result.abhy_supplys;
            var wspdemand_data = result.abhy_demands;
            var finalObj = wspsupply_data.concat(wspdemand_data);
            var wsppreparedcompleted_data = finalObj;
            for (var s = 0; s < wspprepared_data.length; s++) {
                wspprepared_Count1 = (s + 1);
                for (var a = 0; a < wsppreparedcompleted_data.length; a++) {
                    // if (gps_count[s]["gpname"] === wsppreparedcompleted_data[a]["gname"]) {
                    wsppreparedcompleted_Count1 = (a + 1);
                    // }
                    if (gps_count[s]["gpname"] === wsppreparedcompleted_data[a]["gname"] && wsppreparedcompleted_data[a]["accept"]) {
                        wspimplementedcompleted_Count1 = (a + 1);
                    }
                }
            }
            $('#wsppreparedGps').html(wspprepared_Count1);
            $('#wsppreparedcompletedgps').html(wsppreparedcompleted_Count1);
            var wsppreparedworking = parseFloat(parseFloat(wspprepared_Count1) - parseFloat(wsppreparedcompleted_Count1));
            $('#wsppreaparedworkinggps').html(wsppreparedworking);


            $('#wspimplementedgps').html(wspprepared_Count1);
            $('#wspimplementedcompletedgps').html(wspimplementedcompleted_Count1);
            var wspimplementedworking = parseFloat(parseFloat(wspprepared_Count1) - parseFloat(wspimplementedcompleted_Count1));
            $('#wspimplementedworkinggps').html(wspimplementedworking);

            //total sites
            $('#lbltotalsites').html(gwl_totwells_count);
            $('#lblcreatedsites').html(wsppreparedcompleted_Count1);
            $('#lblimplementsites').html(wspimplementedcompleted_Count1);
            var gwlresultsites_count = parseFloat(parseFloat(wsppreparedcompleted_Count1) - parseFloat(wspimplementedcompleted_Count1));
            $('#lblresultsites').html(gwlresultsites_count);

            var wspsupplyside_Count1 = 0;
            var wspsupplyside_acceptCount1 = 0;
            for (var w = 0; w < wspsupply_data.length; w++) {
                wspsupplyside_Count1 = (w + 1);
                if (wspsupply_data[w]["accept"] === "1") {
                    wspsupplyside_acceptCount1 = (w + 1);
                }
            }

            $('#supplysideinterventiontotplanned').html(wspsupplyside_Count1);
            $('#supplysideinterventioncompleted').html(wspsupplyside_acceptCount1);


            var wspdemandside_Count1 = 0;
            var wspdemandside_acceptCount1 = 0;
            for (var y = 0; y < wspdemand_data.length; y++) {
                wspdemandside_Count1 = (y + 1);
                if (wspsupply_data[y]["accept"] === "1") {
                    wspdemandside_acceptCount1 = (y + 1);
                }
            }

            $('#demandsideintenventiontotpalanned').html(wspdemandside_Count1);
            $('#demandsideintenventioncompleted').html(wspdemandside_acceptCount1);
        }

    }

    function getnationalwisedata() {

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/Dashboard/goNationaldata',
            data: '{}',
            dataType: 'JSON',
            success: function (data) {
                getnationaldata(data);
            }
        });
    }

    function getnationaldata(result1) {

        var result = "";
        if (result1 != null) {
            //loader
