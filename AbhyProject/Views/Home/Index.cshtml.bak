    .newsitem {
        box-sizing: border-box;
        width: 100%;
        margin: 0 0 16px;
        padding: 0;
        overflow: hidden;
        border-radius: 6px;
        box-shadow: 0 0 0 1px rgba(0,0,0,.08);
        transition: box-shadow .25s;
    }

    .bnewsitem, .newsitem {
        background-color: #fff;
    }

    newsitem .news-card-body {
        display: flex;
        padding: 16px;
    }

    .news-card-body {
        cursor: pointer;
    }

    newsitem .title {
        font-size: 20px;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: -.5px;
        color: #333;
        max-height: 2.8em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }



    a, #b_header a, #b_header a:hover, .b_toggle, .b_toggle:hover {
        text-decoration: none;
    }



