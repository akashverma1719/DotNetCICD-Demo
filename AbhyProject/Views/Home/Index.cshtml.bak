<style type="text/css">
    .modal-backdrop.in {
        z-index: 0px !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    ul.Select_option {
        list-style: none;
        font-size: 13px;
        margin: 0px;
    }

        ul.Select_option > li {
            display: inline-block;
            padding: 0px 0px 0px 5px;
        }

            ul.Select_option > li > span > i {
                padding: 0px 0px 0px 10px;
            }

    .selectdistshowoption {
        margin-top: 5px;
    }

    .selctingoption > li > div > select {
        text-transform: capitalize;
    }

    .a_link_ui_class > li {
        display: inline-block;
        list-style: none;
    }

    .simple-marquee-container {
        width: 100%;
        background-color: #bcb4b4;
        float: left;
        display: inline-block;
        overflow: hidden;
        box-sizing: border-box;
        height: 35px;
        position: relative;
        cursor: pointer;
        color: #fff;
    }

        .simple-marquee-container .marquee-content-items {
            display: inline-block;
            padding: 2px;
            margin: 0;
            height: 45px;
            position: relative;
        }

            .simple-marquee-container .marquee-content-items li {
                display: inline-block;
                line-height: 35px;
                color: #fff !important;
            }

                .simple-marquee-container .marquee-content-items li a {
                    color: #fff !important;
                    font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
                    font-weight: 500;
                }
