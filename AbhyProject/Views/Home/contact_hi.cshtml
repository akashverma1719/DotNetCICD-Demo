<script type="text/javascript">
    //$(function () {
    //    $("#btnSubmit").click(function () {
    //        
    //        captcha_contact();

    //    });
    //});
    function captcha_contact() {

        var XX = 0;
        
        var UserName = $('#name').val();
        var Email = $('#email').val();
        var Subject = $('#subject').val();
        var MobileNumber = $('#number').val();
        var Message = $('#message').val();
        var clientCaptcha = $('#clientCaptcha').val();
        if (UserName == "") {
            XX = 1;
            $('#status').text("अपना नाम दर्ज करें");
        }
        else if (Email == "") {
            XX = 1;
            $('#status').text("अपना ईमेल पता दर्ज करें");

        }
        else if (Subject == "") {
            XX = 1;
            $('#status').text("अपना विषय दर्ज करें");
        }
        else if (MobileNumber == "") {
            XX = 1;
            $('#status').text("अपना मोबाइल संख्या दर्ज करे");
        } else if (Message == "") {
            XX = 1;
            $('#status').text("अपना संदेश दर्ज करें");
        }
        else if (clientCaptcha == "") {
            XX = 1;
            $('#status').text("लेख टाइप करें");
        }


        if (XX == 0) {
            $.ajax({
                url: "/Home/Contact",
                type: "POST",
                data: function () {
                    var data = new FormData();
                    data.append("Subject", Subject);
                    data.append("UserName", UserName);
                    data.append("clientCaptcha", clientCaptcha);
                    data.append("Email", Email);
                    /*data.append("Subject", Subject);*/
                    data.append("MobileNumber", MobileNumber);
                    data.append("Message", Message);


                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response == "Captcha is Not Matched") {

                    } else if (response == "Your Captcha is Expired") {

                    } else {
                        $("#name").val("");
                        $("#email").val("");
                        $("#subject").val("");
                        $("#mobile")
                        $('#clientCaptcha').val("");
                        $("#number").val("");
                        $("#message").val("");
                    }

                    $('#status').text(response);
                    refress();

                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                }
            });
        }

    }
    function refress() {
        $('#C_img1').attr('src', $('#C_img1').attr('src') + '#');
    }

</script>
