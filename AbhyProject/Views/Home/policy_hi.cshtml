
@{
    Layout = "~/Views/Shared/WebsiteLayout_hindi.cshtml";
}

<!DOCTYPE html>

<html>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>policy</title>
</head>

<body>
    <div class="container mt-4 mb-4">
        <div class="row">
            <div class="col-lg-12 pb-3">
                <h3 class=" border-bottom pb-2 mb-3">वेबसाइट नीतियाँ</h3>
                <ul>

                    <li class="border-bottom pb-2 m-3">
                        <h5>कॉपीराइट नीति</h5>
                    </li>

                    <li>

                        <p class="mb-2 pl-3">
                            इस साइट पर प्रदर्शित सामग्री अटल भूजल योजना परियोजना की संपत्ति है और वही उनके अनुमति के बिना किसी भी प्रारूप या मीडिया
                            में मुफ्त में प्रतिलिपि बनाई जा सकती है, जो कि सटीकता के साथ पुनर्प्रदर्शित हो रही है और नीचे दिए गए संदर्भ में नहीं प्रयुक्त किसी
                            भ्रांतिकारी परिप्रेक्ष्य में उपयोग नहीं हो रही है। जहां सामग्री किसी अलग-थलग तीसरे पक्ष के कॉपीराइट के रूप में पहचानी जा रही है,
                            उन सामग्रियों को प्रतिलिपि करने की अनुमति उस कॉपीराइट के धारकों से प्राप्त की जानी चाहिए।
                        </p>
                    </li>





                    <li class="border-bottom pb-2 m-3">
                        <h5>गोपनीयता नीति</h5>
                    </li>

                    <li>

                        <p class="mb-2 pl-3">
                            अटल भूजल योजना परियोजना - वेबसाइट आपके बारे में कोई विशिष्ट निजी जानकारी स्वतः कैप्चर नहीं करती है, (जैसे नाम, फ़ोन नंबर
                            या ईमेल पता), जो हमें आपकी व्यक्तिगत पहचान करने की अनुमति देती है।
                        </p>
                    </li>
                    <li>

                        <p class="mb-2 pl-3">
                            अगर अटल भूजल योजना परियोजना-वेबसाइट आपसे व्यक्तिगत जानकारी प्रदान करने का अनुरोध करती है, तो आपको सूचित किया
                            जाएगा कि जानकारी किस विशेष उद्देश्य के लिए इकट्ठी की जा रही है और यह सुरक्षा के प्राचीन साधनों के उपयोग से संरक्षित होगी।
                        </p>
                    </li>
                    <li>
                        <p class="mb-2 pl-3">
                            अटल भूजल योजना परियोजना-वेबसाइट पर स्वतंत्र रूप से पहचानी जा सकने वाली कोई भी व्यक्तिगत जानकारी को किसी तीसरे पक्ष
                            (सार्वजनिक / निजी) के साथ बेचती या साझा नहीं करती है। इस वेबसाइट को प्रदान की जाने वाली किसी भी जानकारी को खोने, गलत
                            उपयोग, अनधिकृत पहुंच या उजागर करने से बचाया जाएगा, संशोधित या नष्ट नहीं किया जाएगा।
                        </p>
                    </li>
                    <li>
                        <p class="pl-3">
                            हम यूजर के बारे में निश्चित जानकारी, जैसे इंटरनेट प्रोटोकॉल (आईपी) पते, डोमेन नाम, ब्राउज़र प्रकार, ऑपरेटिंग सिस्टम, यात्रा की
                            तारीख और समय और दौरे की पृष्ठों की जांच करते हैं। हम किसी भी तरह का प्रयास नहीं करते हैं कि इन पतों को हमारी साइट पर आने
                            वाले व्यक्तियों की पहचान के साथ जोड़ें, जब तक कि साइट को हानि पहुंचाने का प्रयास नहीं किया गया हो।
                        </p>
                    </li>


                    <li class="border-bottom pb-2 m-3">
                        <h5>हाइपरलिंकिंग नीति</h5>
                    </li>
                    <li>

                        <p class="mb-2 pl-3">
                            वेबसाइट पर मौजूद बाहरी लिंक: इस वेबसाइट में कई जगहों पर, आप अन्य वेबसाइट / पोर्टल के लिए वेब-लिंक देख सकते हैं। ये लिंक
                            आपकी सुविधा के लिए रखे गए हैं। अटल भूजल योजना लिंक्ड वेबसाइटों की सामग्री और उनमें व्यक्त की गई विचारों का गोपनीयता और
                            विश्वसनीयता उत्पन्न नहीं करती है। लिंक की मौजूदगी या इसे इस वेबसाइट पर सूचीबद्ध करने का कोई मतलब नहीं माना जाना चाहिए।
                            किसी भी समय हम इन लिंकों की उपलब्धता / अपलब्धता की गारंटी नहीं दे सकते और हमारे पास इन लिंक के उपलब्ध पृष्ठों के ऊपर
                            कोई नियंत्रण नहीं है।
                        </p>
                    </li>
                    <li>

                        <p class="mb-2 pl-3">
                            अन्य वेबसाइटों / पोर्टलों द्वारा अटल भूजल योजना को हाइपरलिंक करने के लिए पूर्व अनुमति आवश्यक है। हाइपरलिंक की उपलब्ध पृष्ठों
                            से लिंक करने के लिए, जहां से लिंक दिया जाना है और हाइपरलिंक के ठीक भाषा-पाठ को घोषित करने के लिए, इसके लिए एक अनुरोध
                            atal-jal[at]gov[dot]in पर भेजकर प्राप्त करना चाहिए ।.
                        </p>
                    </li>

                    <li class="border-bottom pb-2 m-3">
                        <h5>वेबसाइट मॉनिटरिंग नीति</h5>
                    </li>
                    <li>

                        <p class="pl-3">
                            वेबसाइट मॉनिटरिंग नीति के अंतर्गत, साइट को नियमित अंतराल पर मॉनिटर किया जाता है ताकि समस्याओं को ठीक किया जा सके,
                            बग्स को ठीक किया जा सके और गलत जानकारी को सही किया जा सके, साथ ही गुणवत्ता को बनाए रखने और इसके संगठनिक मामलों
                            को हल करने के लिए संगठनित किए जाएं:
                        </p>
                        <ul>
                            <p class="pl-3 m-2">
                                <b>कार्यक्षमता:</b> साइट के सभी मॉड्यूलों की कार्यक्षमता और इंटर-लिंकिंग के संगठनिक मामलों की जांच की जाती है ताकि वे सही ढंग से
                                काम करें।
                            </p>
                            <p class="pl-3 m-2">
                                <b>प्रदर्शन:</b>साइट की महत्वपूर्ण पृष्ठों की डाउनलोड समय की जांच की जाती है।
                            </p>
                            <p class="pl-3 m-2">
                                <b>टूटे हुए लिंक:</b>  साइट को ध्यान से समीक्षा की जाती है ताकि किसी भी टूटे हुए लिंक या त्रुटि की मौजूदगी का निराकरण हो सके।
                            </p>
                            <p class="pl-3 m-2">
                                <b> सामग्री:</b> साइट की सामग्री को अनुसंधानशील विषय मामलों (एसएमडीजी ) / विंग द्वारा नियमित रूप से मॉनिटर किया जाता है।
                                अद्यतित सामग्री संबंधीत एसएमडीजी / विंग द्वारा समय-समय पर प्रदान की जाती है ताकि उसे साइट पर अपलोड किया जा सके।
                                
                                
                            </p>
                        </ul>

                    </li>
                    <li class="border-bottom pb-2 m-3 ">
                        <h5>अस्वीकरण</h5>
                    </li>

                    <li>
                        <p class="pl-3">
                            होस्टिंग सेवा प्रदाता के पास उन्नत बहु-पदार्थ सुरक्षा ढांचा और फ़ायरवॉल और प्रवेशन रोकने के सिस्टम जैसे उपकरण हैं।
                        </p>
                    </li>

                       

                </ul>
            </div>
        </div>
    </div>
</body>

</html>