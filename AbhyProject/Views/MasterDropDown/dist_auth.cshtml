<style>
    body {
        background: #D1E8E2 !important;
    }

    .total_div_wsp_home {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        padding: 0px 20px;
        justify-content: center;
    }
</style>
<main>
    <div class="col-md-12 Select_option_div">

        <ul class="Select_option pull-right col-md-2 col-sm-2">
            <li id="back_to_module">
                <a href="~/MasterDropDown/Training_evaluation" class="btn btn-primary">
                    Back to Module
                </a>

            </li>
            <li id="back_to_home">
                <a href="~/Home/LogOut" class="btn btn-primary">
                    Back to Mis Login
                </a>

            </li>
        </ul>
    </div>
    <div id="GP-Training" hidden style="justify-content: space-between;">
        <div class="col-lg-4 col-md-4 col-sm-4 sub_total_div">
            <a href="~/MasterDropDown/currentevent_dist_auth">
                <ul class="ul_image_wsphome text-center">
                    <li>
                        <ul class="arrow_ul_css">
                            @*<li><img src="~/Content/Agriculture_icons/Feedback_info.png" /></li>*@
                            <li>
                                <img src="~/Content/Agriculture_icons/2.png" />
                            </li>
                            <li><i class="fa fa-angle-double-"></i></li>
                        </ul>

                    </li>
                    <li><span></span></li>
                </ul>
            </a>
        </div>

        <div class="col-lg-4 col-md-4 col-sm-4 sub_total_div">
            <a href="~/MasterDropDown/eventmaterial_dist_auth">
                <ul class="ul_image_wsphome text-center">
                    <li>
                        <ul class="arrow_ul_css">
                            @*<li><img src="~/Content/Agriculture_icons/Feedback_info.png" /></li>*@
                            <li>
                                <img src="~/Content/Agriculture_icons/3.png" />
                            </li>
                            <li><i class="fa fa-angle-double-"></i></li>
                        </ul>

                    </li>
                    <li><span></span></li>
                </ul>
            </a>
        </div>
       
    </div>

    <div id="progress">
        <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px;">
            <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                <span class="progress-group-label" data-target="#music" data-toggle="tab">Training Evaluation</span>
                <div class="tri shadow"></div>
                <div class="tri"></div>
            </li>
        </ul>

    </div>
</main>




<script>
    $(document).ready(function () {
        var StateOfficer = '@Session["Officer"]';
        var Auth = '@Session["Access_Auth"]';
        $("#back_to_module").hide();
        $("#back_to_home").hide();
        if (StateOfficer == "") {
              window.location = "/Home/LogOut";
        }
        if (StateOfficer == "District Level Nodal Officer") {

            $('#div2').hide();
        }
        else {
            $('#div2').show();
        }
        if (StateOfficer == "District Level Nodal Officer" || StateOfficer == "Block Level Nodal Officer" || StateOfficer == "District Level Nodal Officer")
        {

            $('#div1').hide();
        }
        else
        {
            $('#div1').show();
        }
        if (Auth == "dist-Training") {
            $('#GP-Training').show();
            $('#others_div').hide();

        }
        if (Auth == "dist-Training" || StateOfficer == "District Level Nodal Officer") {
            $("#back_to_home").show();
            $("#back_to_module").hide();
        } else {
            $("#back_to_home").hide();
            $("#back_to_module").show();
        }
        SessionInfo();

    });
    function SessionInfo() {
        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/SocialMointoring/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }


            }

        });

    }

</script>
