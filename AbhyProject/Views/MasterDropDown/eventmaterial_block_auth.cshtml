                                    '<td> <input type="date"  onpaste="return false;"  class="form-control" id="tdate1_D' + i + '" value="' + data[i].to_date + '" readonly /></td>' +

                                    '<td> <input type="file"  class="form-control" id="upld1_D' + i + '" value="' + upload + '"/></td>' +
                                    '<td> <input type="text"  onpaste="return false;" class="form-control" id="remark1_D' + i + '" value="' + data[i].remark + '"  /></td>' +

                                    '<td> <button type="button" class="btn btn-primary" onclick="Update_AWP1_district(' + data[i].id + ',' + i + ')">Update</button></td>' + '<td><button class="btn btn-danger " type="button" onclick="cancelcomp_A_Support_district(' + i + ');"><i class="fa fa-remove"</button>' + '</td></tr>';
                            }
                            else  {
                                tr += '<tr id="AWP1_TR_Meeting_district' + i + '" style="text-align:center"><td>' + (++j) + '</td><td>' + data[i].p_training_name + '</td><td>' + data[i].type_of_event + '</td> <td>' + data[i].location_expo + '</td> <td>' + data[i].particular_expo + '</td> <td>' + data[i].level_event + '</td> <td>' + data[i].district + '</td><td>' + data[i].block + '</td> <td>' + data[i].year + '</td> <td>' + data[i].month + '</td> <td>' + data[i].event_platform + '</td> <td>' + data[i].from_date + '</td> <td>' + data[i].to_date + '</td> <td><a href="' + upload + '" download="">' + upload + '</a></td><td>' + data[i].remark + '</td> <td></td> <td></td><td></td></tr>';
}
                        }

                    }
                }
                if (tr == '') {
                    tr = '<tr style="text-align:center;"><td colspan="11">No Data</td></tr>';
                    $('#Training_Workshop_New1_district').html(tr);
                    $('#dist_total').text(data.length);
                    $('#dist_ap').text(ap);
                    $('#dist_sub_sp').text(atdp);
                    $('#dist_pen_sp').text(atgp);
                    $('.loader').hide();

                }
                else {
                    $('#Training_Workshop_New1_district').html(tr);
                    $('#dist_total').text(data.length);
                    $('#dist_ap').text(ap);
                    $('#dist_sub_sp').text(atdp);
                    $('#dist_pen_sp').text(atgp);
                    $('.loader').hide();
                }

            }
        });

