<script>

   var Jsondata = "";
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    var access = "";
    $(document).ready(function () {
        // by default financial year and month details show
        access = '@Session["Access_Auth"]';
        if (access == "readonly") {
            $(".disabled_btn").hide()
        }
        var fin_year = getCurrentFiscalYear();

        var year = "";
        if (fin_year == "2021-22") {
            year = "2021-22"
        } else if (fin_year == "2022-23") {
            year = "2022-23";
        } else if (fin_year == "2023-24") {
            year = "2023-24"
        }
        else if (fin_year == "2024-25") {
            year = "2024-25"
        }else if (fin_year == "2025-26") {
            year = "2025-26"
        }

        $("#year").val(year);
        //$("#year_state").val(year);
        //$("#year_district").val(year);
        //$("#year_block").val(year);
        //$("#year_all").val(year);
        /*$("#year_npmu").val(year);*/

        const month = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        const m = new Date()
        let MonthName = month[m.getUTCMonth()];
        $("#month").val(MonthName);
        //$("#month_state").val(MonthName);
        //$("#month_district").val(MonthName);
        //$("#month_block").val(MonthName);
        //$("#month_all").val(MonthName);
        /*$("#month_npmu").val(MonthName);*/

        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
