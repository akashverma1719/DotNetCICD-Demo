        font-weight: 700;
    }

    .panel-group .panel {
        margin-bottom: 13px;
        border-radius: 4px;
    }

    .panel-heading .accordion-toggle:after {
        /* symbol for "opening" panels */
        font-family: 'Glyphicons Halflings'; /* essential for enabling glyphicon */
        content: "\e114"; /* adjust as needed, taken from bootstrap.css */
        float: right; /* adjust as needed */
        color: grey; /* adjust as needed */
    }

    .panel-heading .accordion-toggle.collapsed:after {
        /* symbol for "collapsed" panels */
        content: "\e080"; /* adjust as needed, taken from bootstrap.css */
    }

    .panel-default > .panel-heading {
        background-color: #d5dcde;
        border-color: #ddd;
        padding: 0px;
    }

    .panel-title a {
        font-weight: 500;
        color: #000;
        display: block;
        padding: 10px;
    }

        .panel-title a:hover {
            text-decoration: none;
        }

    .modal-header .close {
        margin-top: 4px;
    }

    .btn:focus {
        outline: unset;
        outline-offset: -2px;
    }

    .model-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-top: 20px;
    }

    .modal-inner-header {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 8px;
    }

        .modal-inner-header label {
            margin-bottom: 0px;
        }

        .modal-inner-header p {
            margin-bottom: 0px;
        }

    .modal-header {
        padding-bottom: 0px;
    }

    .event-popup-tbl td {
        font-size: 14px;
        padding: 3px;
    }

        .event-popup-tbl td label {
            margin-bottom: 0px;
        }
</style>
<!------Event Calender Modal-------->
<!-- The Modal -->
<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="event-title">
                    NPMU Level Events Calendar
                </h4>
                <div class="model-header-content">
                    <div class="modal-inner-header">
                        <label>Completed :</label>
                        <p id="complete-event">Yes</p>
                    </div>
                    <div class="modal-inner-header">
                        <label>Approved :</label>
                        <p id="complete-status" class="text-success"></p>
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="panel-group" id="accordion">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title">
                                <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                                    Event Material
                                </a>
                            </h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse in">
                            <div class="panel-body">
                                <table class="event-popup-tbl">
                                    <tbody>
                                        <tr>
                                            <td><label>Upload</label></td>
                                            <th>:</th>
                                            <td>Yes</td>
                                        </tr>
                                        <tr>
                                            <td><label>Approved</label></td>
                                            <th>:</th>
                                            <td class="text-success"> Auto Approved </td>
                                        </tr>
                                        <tr>
                                            <td><label>File Name</label></td>
                                            <th>:</th>
                                            <td><a href="">Training Calendar 2023-24-National Level (NPMU).pdf</a></td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title">
                                <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                                    Registered Participant
                                </a>
                            </h4>
                        </div>
                        <div id="collapseTwo" class="panel-collapse collapse">
                            <div class="panel-body">
                                <table class="event-popup-tbl">
                                    <tbody>
                                        <tr>
                                            <td><label>Total Participant Registered for that Event</label></td>
                                            <th>:</th>
                                            <td id="total_participant">20</td>
                                        </tr>
                                        <tr>
                                            <td><label>Male</label></td>
                                            <th>:</th>
                                            <td class="text-success"> 5 </td>
                                        </tr>
                                        <tr>
                                            <td><label>Female</label></td>
                                            <th>:</th>
                                            <td>10</td>
                                        </tr>
                                        <tr>
                                            <td><label>Transgender</label></td>
                                            <th>:</th>
                                            <td>0</td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>


