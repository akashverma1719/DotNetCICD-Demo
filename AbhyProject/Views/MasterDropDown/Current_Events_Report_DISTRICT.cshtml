<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demo").innerHTML = today;
</script>

<script>
    var state_name1 = "0";
    var district_name1 = "0";
    var year1 = "0";
    var month1 = "0";
    var State = "0";
    var District = "0";

    $(document).ready(function () {

        var StateOfficer = '@Session["Officer"]';
        var Auth = '@Session["Access_Auth"]';
        State = '@Session["gstate"]';
        state_name1 = '@Session["state_name"]';
        District = '@Session["gdist"]';
        district_name1 = '@Session["district_name"]';
        year1 = '@Session["year1"]';
        month1 = '@Session["month1"]';

        if (state_name1 == 'All') {
            $('#state_name').text("All");
            $('#spnstate').text("All");
        }
        else if (state_name1 != '') {
            $('#state_name').text(state_name1);
            $('#spnstate').text(state_name1);
        }
        else {
            $('#state_name').text("@Session["gstate"]");
            $('#spnstate').text("@Session["gstate"]");
        }
        if (district_name1 == 0) {
            $('#district_name').text("");
            $('#spndistrict').text("");
        }
        else if (district_name1 != '' ) {
            $('#district_name').text(district_name1);
            $('#spndistrict').text(district_name1);
        }

        else {
            $('#district_name').text("@Session["gdist"]");
            $('#spndistrict').text("@Session["gdist"]");
        }

        if (year1 == 'All') {
            $('#year').text("");
            $('#spnyear').text("");
        }
        else if (year1 == 0)
        {
            $('#spnyear').text("");
            $('#year').text("");
        }
        else {
            $('#year').text(year1);
            $('#spnyear').text(year1);
        }
        if (month1 == 0) {
            $('#spnmonth').text("");
            $('#spnmonth1').text("");
        } else {
            $('#spnmonth').text(month1);
            $('#spnmonth1').text(month1);
        }
        if (Auth == "dist-Training") {
            $('#btnExport1').hide();
            $('#btnExport_auth').show();
            $('#btnExport1_1').hide();
            $('#btnExport_auth_1').show();
        }
        else {
            $('#btnExport1').show();
            $('#btnExport_auth').hide();
            $('#btnExport1_1').show();
            $('#btnExport_auth_1').hide();
        }

        var uri = window.location.href.toString();
        if (uri.indexOf("?") > 0) {
            var clean_uri = uri.substring(0, uri.indexOf("?"));
            window.history.replaceState({}, document.title, clean_uri);
        }

        var month_name = Get_Month_Number(month1)
        //$('#state_name').text(month_name);
        //$('#spnmonth1').text(month_name);
        if (StateOfficer == "") {
              window.location = "/Home/LogOut";
        }

        Current_Events_District();

    });


    function Get_Month_Number(month) {

        var month_num = "";
        switch (month) {
            case "1":
                month_num = 'April';
                break;
            case "2":
                month_num = 'May';
                break;
            case "3":
                month_num = "June";
                break;
            case "4":
                month_num = "July";
                break;
            case "5":
                month_num = "August";
                break;
            case "6":
                month_num = "September";
                break;
            case "7":
                month_num = "October";
                break;
            case "8":
                month_num = "November";
                break;
            case "9":
                month_num = "December";
                break;
            case "10":
                month_num = "January";
                break;
            case "11":
                month_num = "February";
                break;
            case "12":
                month_num = "March";
                break;
        }
        return month_num;
    }

    function Current_Events_District() {

        //var year = year1;
        //var month = month1;
        var year_district = year1;
        var month_district = month1;
        var state_name = state_name1;
        var district_name = district_name1;
        var State1 = "@Session["gstate"]";
        var District1 = "@Session["gdist"]";
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/Current_Events_District_Report',
            data: "{'state_name':'" + state_name + "' ,'State1':'" + State1 + "', 'district_name':'" + district_name + "' ,'District1':'" + District1 + "', 'year_district':'" + year_district + "' , 'month_district':'" + month_district + "'}",
            dataType: 'JSON',
            success: function (data) {

                $("#count_total2").text(data.length);
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }

                var tr = '';
                var a = 0;
                if (data.length != 0) {
                    for (var i = 0; i < data.length; i++) {
                        var approve_status = data[i].approve_status;
                        if (approve_status == "Approved") {
                            approve_status = "Approved";
                        }
                        else if (approve_status == "Submitted") {
                            approve_status = "Submitted";
                        }
                        else if (approve_status == "Reject") {
                            approve_status = "Rejected";
                        }
                        else {
                            approve_status = "Pending for Submission";
                        }
                        var filename = data[i].filename;
                        if (filename == null) {
                            filename = "";
                        }
                        var reject_status = data[i].reject_status;
                        if (reject_status == null) {
                            reject_status = "";
                        }
                        tr += '<tr style="text-align:center" id="' + i + '"><td>' + (++a) + '</td><td>' + data[i].p_training_name + '</td><td>' + data[i].type_of_event + '</td><td>' + data[i].location_expo + '</td><td>' + data[i].particular_expo + '</td><td>' + data[i].level_event + '</td><td>' + data[i].district + '</td><td>' + data[i].year + '</td><td>' + data[i].month + '</td><td>' + data[i].event_platform + '</td><td>' + data[i].from_date + '</td><td>' + data[i].to_date + '</td><td>' + data[i].reg_open_date + '</td><td>' + data[i].reg_close_date + '</td><td>' + filename + '</td><td>' + approve_status + '</td><td>' + reject_status + '</td></tr> ';

                    }
                }
                if (tr == '') {
                    tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                    $('#tbldata').html(tr);
                }
                else {
                    $('#tbldata').html(tr);
                }

            }
        });
    }



</script>