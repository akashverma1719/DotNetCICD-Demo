<script>
    var state = "";
    function stateaa() {
        if (StateOfficer == "State Level Nodal Officer") {
            state = statename;
        }
        else {
            state = $('#state').val();
        }

        $('#year').val('0');
        $('#month').val('0');
        if (state == "0") {
            alert("Please Select State Name")
            $('#year').val('0');
            $('#month').val('0');
            return false;
        }

        else {
            state_data();
        }

    }
    function stateaayy() {
        var year = $('#year').val();
        var month = $('#month').val();

        if (StateOfficer == "State Level Nodal Officer") {
            state = statename;
        }
        else {
            state = $('#state').val();
        }

        if (state == "0") {
            alert("Please Select State Name")
            $('#year').val('0');
            $('#month').val('0');
            return false;
        }
        else if (year == '0') {
            if (month != '0') {
                alert("Please Select Year");
                $('#year').val('0');
                $('#month').val('0');
                return false;
            }
            else {
                $('#month').val('0');
                state_data();
            }
        }
        else {
            $('#month').val('0');
            state_data();
        }
    }
    function stateaamm() {
        var year = $('#year').val();
        var month = $('#month').val();

        if (StateOfficer == "State Level Nodal Officer") {
            state = statename;
        }
        else {
            state = $('#state').val();
        }

        if (state == "0") {
            alert("Please Select State Name")
            $('#year').val('0');
            $('#month').val('0');
            return false;
        }
        else if (year == '0') {
            if (month != '0') {
                alert("Please Select Year");
                $('#year').val('0');
                $('#month').val('0');
                return false;
            }
            else {

                state_data();
            }
        }
        else {

            state_data();
        }
    }
    function state_data() {
        $(".loader").show();

        if (StateOfficer == "State Level Nodal Officer") {
            state = statename;
        }
        else {
            state = $('#state').val();
        }

        var year = $('#year').val();
        var month = $('#month').val();
        if (year == '0') {
            var ss = "Cumulative";
            $('#fyn').text(ss);
        }
        else {
            var ss = + year;
            $('#fyn').text(year);
        }

        $.ajax({
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            url: '/MasterDropDown/state_tracker',
            data: {
                statename: state, year: year, month: month
            },
            success: function (data) {
                
                var Tbodyhtml = '';
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (data.length == 1) {
                    var aa = 0;
                    for (var i = 0; i < data.length; i++) {

                        if (year == "2020-21") {
                            aa = 1;
                        }
                        else if (year == "2021-22" || year == "2022-23" || year == "2023-24") {
                            aa = 2;
                        }
                        else if (year == "2024-25") {
                            aa = data[i].other_cost;
                        }
                        else {
                            var bb = 7;
                            aa = data[i].other_cost + bb;
                        }

                        Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].statename + '</label></td>';
                        Tbodyhtml += '<td id="rainfall">' + aa + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].demand_cost + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].supply_cost + '</td></tr >';


                    }


                    $('#tblreport tbody').html(Tbodyhtml);
                    $(".loader").hide();

                }
                else {

                    var demand_cost = 0;
                    var supply_cost = 0;
                    var other_cost = 0;


                    for (var i = 0; i < data.length; i++) {

                        var aa = 0;
                        demand_cost += data[i].demand_cost;
                        if (year == "2020-21") {
                            aa = 1;
                        }
                        else if (year == "2021-22" || year == "2022-23" || year == "2023-24") {
                            aa = 2;
                        }
                        else if (year == "2024-25") {
                            aa = data[i].other_cost;
                        }
                        else {
                            var bb = 7;
                            aa = data[i].other_cost + bb;
                        }
                        supply_cost += data[i].supply_cost;
                        other_cost += aa;

                        Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].statename + '</label></td>';
                        Tbodyhtml += '<td id="rainfall">' + aa + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].demand_cost + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].supply_cost + '</td></tr >';

                    }


                    Tbodyhtml += '<tr><td colspan="2" id="srNo"><label>' + "Total" + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + other_cost + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + demand_cost + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + supply_cost + '</label></td></tr >';

                    $('#tblreport tbody').html(Tbodyhtml);
                    $(".loader").hide();

                }
            }


        });



    }

    function exportTableToExcel(tableID, filename = '') {
        var xx = 0;
        var statea = "0";
        if (StateOfficer == "State Level Nodal Officer") {
            statea = statename;
        }
        else {
            statea = $('#state').val();
        }

        $('#year').val('0');
        $('#month').val('0');
        if (statea == "0") {
            alert("Please Select State Name")
            $('#year').val('0');
            $('#month').val('0');
            return false;
        }

        else {

            if (xx == 0) {
                var downloadLink;
                var dataType = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8';
                var tableSelect = document.getElementById(tableID);
                var tableHTML = tableSelect.outerHTML.replace(/ /g, '%20');

                // Specify file name
                filename = filename ? filename + '.xlsx' : 'Training Tracker for State level.xlsx'; // Change file extension to .xlsx for compatibility with XLSX.write

                // Create download link element
                downloadLink = document.createElement("a");

                document.body.appendChild(downloadLink);

                var ws = XLSX.utils.table_to_sheet(tableSelect);
                var wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "State level");

                var wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

                function s2ab(s) {
                    var buf = new ArrayBuffer(s.length);
                    var view = new Uint8Array(buf);
                    for (var i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
                    return buf;
                }

                // Create a Blob from the binary data
                var blob = new Blob([s2ab(wbout)], { type: dataType });

                // Create an object URL for the Blob and set it as the href attribute of the download link
                downloadLink.href = URL.createObjectURL(blob);

                // Set the download attribute of the link to specify the file name
                downloadLink.download = filename;

                // Trigger the download by simulating a click on the download link
                downloadLink.click();
            }

        }
    }


</script>