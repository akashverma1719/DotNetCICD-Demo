    function Update_AWP1(id, RowNo) {     //for STATE

        var id = id;
        var state1 = $('#state1_S' + RowNo).val();
        //var dist1 = $('#district1' + RowNo).val();
        //var block1 = $('#block1' + RowNo).val();
        var Current1 = $('#Current1_S' + RowNo).find('option:selected').text();
        var month1 = $('#month1_S' + RowNo).find('option:selected').text();
        /*var event1 = $('#event1_S' + RowNo).val();*/
        var fileUpload = $("#dwld1" + RowNo).get(0);
        var fileUpload_files = fileUpload.files;

        var formData = new FormData();

        formData.append("id", id);
        formData.append('State', state1);
        //formData.append('District', dist1);
        //formData.append('Block', block1);
        formData.append('Current', Current1);
        formData.append('month', month1);
        /*formData.append('event_d', event1);*/
        formData.append('file_up', fileUpload_files[0]);

        $.ajax({
            url: '/MasterDropDown/Update_Comm_Part_Info_State',
            data: formData,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (response) {

                alert(response);
                if (response == "SessionTimeOut") {
                    window.location = "/Home/LogOut";
                }
                abhy_Event_Cal_Info_Search1();
            },
            error: function () {
                alert('Update Failed');
            }
        });


    }
    function Delete_Evt_Cal(Id) {
        if (confirm("Do You want to delete")) {
            $('.loader').show();
            var obj = {};
            obj.id = Id;
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: '/MasterDropDown/Delete_Evt_Cal_Part',
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/Home/LogOut";
                    }
                    abhy_Event_Cal_Info_Search1();
                    $('.loader').hide();

