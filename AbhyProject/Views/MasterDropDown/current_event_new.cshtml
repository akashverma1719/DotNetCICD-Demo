<script>
    $(document).ready(function () {
        $('.loader').show();
        var StateOfficer = '@Session["Officer"]';
        
        current_event_info_count();
        SessionInfo();
    });
</script>
<script>
    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/MasterDropDown/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/Home/LogOut";
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();
                    $('#spnstate_state_1').hide();

                    $('#StateLabel_all').hide();
                    $('#StateDropdownLabel_all').hide();
                    $('#DistLabel_all').hide();
                    $('#DistDropdownLabel_all').hide();
                    $('#BlockLabel_all').hide();
                    $('#BlockDropdownLabel_all').hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#text_form').text('NPMU Level Events Calendar');
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                       
                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        $('#text_form').text('State Level Events Calendar');
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').hide();

                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();
                       

                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        $('#text_form').text('District Level Events Calendar');
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();

                        
                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        $('#text_form').text('Block Level Events Calendar');
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();
                        $('#BlockLabel_block').show();
                        $('#spnstate_state_1').hide();
                        $('#StateLabel_state').show();
                        
                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();

                    }


                }

            }

        });
        $('.loader').hide();

    }
    function current_event_info_count() {
        $('.loader').show();

        $.ajax({

            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/current_event_Data_count_new',
            data: {},
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/Home/LogOut";
                }
                var data = data.split(',');

                $('#atstate_approve').text(data[0]);
                $('#atdpmu_approve').text(data[1]);
                $('#atblock_approve').text(data[2]);
                $('#at_gp_approve').text(data[3]);
                $('#atnpmu_approve').text(data[4]);
                $('#at_total_approve').text(data[5]);
                $('.loader').hide();
            }
        });

    }

</script>