                        Tbodyhtml += '<td id="rainfall">' + data[i].uploadevent + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].dpmu + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].spmu + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].reject + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].approve + '</td></tr >';
                    

                    }



                    $('#tblreport tbody').html(Tbodyhtml);
                    $(".loader").hide();

                }
                else {

                    var totalcurrentevent = 0;
                    var uploadevent = 0;
                    var approve = 0;
                    var reject = 0;
                    var spmu = 0;
                    var dpmu = 0;
                    var tt = 0;
                    var currentevent = 0;
                    var c_tt = 0;
                    var currentnoofcurrent = 0;
                   

                    for (var i = 0; i < data.length; i++) {

                        totalcurrentevent += data[i].totalcurrentevent;
                        uploadevent += data[i].uploadevent;
                        approve += data[i].approve;
                        reject += data[i].reject;
                        spmu += data[i].spmu;
                        dpmu += data[i].dpmu;
                        tt += data[i].tt;
                        currentevent += data[i].currentevent;
                      
                       




                        Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
