            var ss = "Cumulative";
            $('#fyn').text(ss);
        }
        else {
            var ss = + year;
            $('#fyn').text(year);
        }
        $.ajax({
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            url: '/MasterDropDown/district_tracker',
            data: {
                statename: state, districtname: Dist, year: year, month: month
            },
            success: function (data) {
                var Tbodyhtml = '';
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (data.length == 1) {
              
