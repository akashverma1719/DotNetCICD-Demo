                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].districtname + '</label></td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].tt + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].totalcurrentevent + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].uploadevent + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].dpmu + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].spmu + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].reject + '</td>';
                        Tbodyhtml += '<td id="rainfall">' + data[i].approve + '</td></tr >';
                       
                       

                    }
                    let formattedValue = (tt % 1 === 0) ? tt.toFixed(0) : tt.toFixed(2);

                    Tbodyhtml += '<tr><td colspan="3" id="srNo"><label>' + "Total" + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + formattedValue + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + totalcurrentevent + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + uploadevent + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + dpmu + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + spmu + '</label></td>';
