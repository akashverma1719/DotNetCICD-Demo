    function Total_Numbers() {
        var total = 0;
        var male_gp = $('#male_gp').val();
        var female_gp = $('#female_gp').val();
        var other_gp = $('#other_gp').val();
        if (male_gp == "") {
            male_gp = 0;
        }
        if (female_gp == "") {
            female_gp = 0;
        }
        if (other_gp == "") {
            other_gp = 0;
        }
        total = parseFloat(male_gp) + parseFloat(female_gp) + parseFloat(other_gp);

        $('#total_participants').val(total);
    }
