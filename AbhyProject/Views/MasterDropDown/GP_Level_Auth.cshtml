    function type_of_event_gp1() {
        $('#reg_training_gp_Info_new').html("");
        var year = $("#year option:selected").text();
        var month = $("#month option:selected").text();
        var type_of_event = $("#type_event_gp1 option:selected").text();
        if (State == "0") {
            alert("Please Select State Name");
            $("#type_event_gp1").val("0");
            $('#p_training_name1').val('0');
            return;
        }
        else if (Dist == "0") {
            alert("Please Select District Name");
            $("#type_event_gp1").val("0");
            $('#p_training_name1').val('0');
            $("#dist11").focus();
            return;
        }
        else if (Block == "0") {
            alert("Please Select Block Name");
            $("#type_event_gp1").val("0");
            $('#p_training_name1').val('0');
            $("#block1").focus();
            return;
        }
        else if (Gram == "0") {
            alert("Please Select Gram Panchayat Name");
            $("#type_event_gp1").val("0");
            $('#p_training_name1').val('0');
            $("#gram").focus();
            return;
        }
        $.ajax({

            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/gp_reg_training_topic_new',
            data: { state: State, district: Dist, block: Block, gram: Gram, TypeEvent: type_of_event, year: year, month: month },
            dataType: 'JSON',
            success: function (response) {

                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                var option = '<option value="0">Select Event/Training</option>';
                var ddlst = {};
                var ddlst_array = [];
                if (response.length != 0) {
                    Full_Info_Events = response;
                    for (var j = 0; j < response.length; j++) {

                        if (!ddlst[response[j].topic_training]) {
                            ddlst_array.push(response[j].topic_training);
                            ddlst[response[j].topic_training] = response[j].topic_training;

                        }

                    }

                }

                if (ddlst_array.length != 0) {
                    for (var i = 0; i < ddlst_array.length; i++) {
                        option += '<option value="' + ddlst_array[i] + '">' + ddlst_array[i] + '</option>';
                    }
                }

                $('#p_training_name1').html(option);


            }


        });
    }

    function Gp_data_fetch() {

        var topic_training_new = $("#p_training_name1 option:selected").text();
        var year = $('#year').val();
        var month = $('#month').val();


        $.ajax({

            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/Reg_Gp_data_fetch',
            data: "{'state':'" + State + "' , 'district':'" + Dist + "' , 'block':'" + Block + "' , 'gram':'" + Gram + "' , 'year':'" + year + "' , 'month':'" + month + "' , 'topic_training_new':'" + topic_training_new + "' }",
            dataType: 'JSON',
            success: function (data) {
                if (data == "Logout") {
                      window.location = "/Home/LogOut";

                }
                var tr = '';
                var sno = 0;
                var total = 0;
                var ap = 0;
                var atdp = 0;
                var atgp = 0;
                var rej = 0;
                if (data.length != 0) {
                    for (var i = 0; i < data.length; i++) {
                        var reject_status = data[i].remark_status_full;
                        if (reject_status == null) {
                            reject_status = "";
                        }
                        var approve_status = data[i].approve_status_full;
                        if (approve_status == null) {
                            approve_status = "";
                        }

                        var atten = "";
                        if (data[i].atten_sheet_filename != null) {
                            atten = data[i].atten_sheet_filename;
                        }
                        var atten_sheet = "";
                        if (data[i].atten_sheet != null) {
                            atten = data[i].atten_sheet;
                        }

                        var Parti_Name = data[i].participant_name;
                        if (Parti_Name == null) {
                            Parti_Name = "";
                        }
                        var Gender = data[i].gender;
                        if (Gender == null) {
                            Gender = "";
                        }
                        var Category = data[i].category;
                        if (Category == null) {
                            Category = "";
                        }
                        var Mobile_No = data[i].mobile_no;
                        if (Mobile_No == null) {
                            Mobile_No = "";
                        }

                        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {

