<script type="text/javascript">

    var StateOfficer = "";
    var State = "";
    var Dist = "";
    var Block = "";
    $(document).ready(function () {
        StateOfficer = '@Session["Officer"]';


    });
    var Main_Statename = "";
    function DropDownInfo1() {

        $('#StateWiseDropdown').hide();
        $('#StateWise').hide();

        Main_Statename = "";


        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/AgencyDashBoard/State_SessionInfo',
            data: '',
            dataType: 'JSON',
            success: function (data) {


                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                else if (data == "Admin") {
                    $('#StateWiseDropdown').show();
                    $('#StateWise').hide();

                    States_Info();

                }
                else {
                    $('#StateWiseDropdown').hide();
                    $('#StateWise').show();

                    Main_Statename = data;
                    $('#spnstate').val(data);

                }
            }

        });

    }
    function States_Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/AgencyDashBoard/PIP_Agency_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                var slection_options = '<option value="0">Select State</option>';

                if (data.length != 0) {
                    slection_options += '<option value="ALL">ALL</option>';
                    slection_options += '<option value="NPMU">NPMU</option>';
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].observation_type == "pip") {

                            slection_options += '<option value="' + data[i].state_name + '"> ' + data[i].state_name + ' </option>';
                        }

                    }
                    slection_options += '<option value="Other">Other</option>';

                    $('#States').html(slection_options);

                }
            }

        });
    }
    function StateWiseInfo() {
        var State = $('#States').val();
        if (State != "0") {
            Main_Statename = State;
            FeedBack_Info();

        } else {
            alert("Select StateName")
        }
    }
    function FeedBack_Info() {

        var obj = {};
        obj.state_name = State;
        obj.district_name = Dist;
        obj.block_name = Block;
