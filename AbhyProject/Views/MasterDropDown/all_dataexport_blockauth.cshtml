<script>
    function getCurrentFiscalYear() {
        //get current date
        var today = new Date();
        if ((today.getMonth() + 1) <= 3) {
            fiscalyear = (today.getFullYear() - 1) + "-" + today.getFullYear()
        } else {
            fiscalyear = today.getFullYear() + "-" + (today.getFullYear() + 1)
        }

        if (fiscalyear == "2020-2021") {
            fincalyear = 2020;
        } else if (fiscalyear == "2021-2022") {
            fincalyear = 2021;
        } else if (fiscalyear == "2022-2023") {
            fincalyear = 2022;
        } else if (fiscalyear == "2023-2024") {
            fincalyear = 2023;
        } else if (fiscalyear == "2024-2025") {
            fincalyear = 2024;
        }

        if (fiscalyear == "2020-2021") {
            fiscalyear = "2020-21";
        } else if (fiscalyear == "2021-2022") {
            fiscalyear = "2021-22";
        } else if (fiscalyear == "2022-2023") {
            fiscalyear = "2022-23";
        } else if (fiscalyear == "2023-2024") {
            fiscalyear = "2023-24";
        } else if (fiscalyear == "2024-2025") {
            fiscalyear = "2024-25";
        }

        return (fiscalyear);
    }
    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/SocialMointoring/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/Home/LogOut";
                    $(".loader").hide();
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();
                    $(".loader").hide();


                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();


                        $(".loader").hide();
                    }
                    else if (Str[0] == "State Level Nodal Officer") {

                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $(".StateLabel_entry").hide();
                        State_Dropdown_Function();
                        $(".loader").hide();
                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $(".StateLabel_entry").hide();
                        Dist_fun();
                        $(".loader").hide();


                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $(".StateLabel_entry").hide();
                        Block_fun();
                        $(".loader").hide();
                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').show();
                        $(".StateLabel_entry").show();
                        $(".loader").hide();
                    }


                }
            }

        });

    }
    function DropDownInfo() {
        $(".loader").show();
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/MasterDropDown/DropdownInfo_Gpdist",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select State</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram1").empty();
                    var opgram = '<option value="0">Select GramPanchayat</option>';
                    $("#gram1").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';
                        for (var i = 0; i < Jsondata.length; i++) {

                            if (!ddlst[Jsondata[i].state_name]) {
                                all_dists.push(Jsondata[i].state_name);
                                ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
                            else if (a > b) return 1;
                            return 0;
                        });
                        optionState = '<option value="0">Select State</option>';
                        optionState += '<option value="All">ALL</option>';
                        optionState += '<option value="NPMU (Delhi)">NPMU (Delhi)</option>';
                        for (var i = 0; i < DistArray.length; i++) {
                            if (DistArray[i] != "Delhi_7") {
                                if (DistArray[i] != null && DistArray[i] != "") {
                                    optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                                }
                            }
                        }
                        $("#spnstate").html(optionState);
                    }

                }

                SessionInfo();


            }
        });
    }
    function NPMU() {
        var npmu = State;
        if (npmu == 'NPMU (Delhi)' || npmu == 'All') {
            $("#DistDropdownLabel").hide();
            $("#BlockDropdownLabel").hide();
            $("#GramDropdownLabel").hide();
        }
        else {
            $("#DistDropdownLabel").show();
            $("#BlockDropdownLabel").show();
            $("#GramDropdownLabel").show();
        }

