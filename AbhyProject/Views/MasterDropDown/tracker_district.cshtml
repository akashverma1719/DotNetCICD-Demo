<script>


    $(document).ready(function () {
        DropDownInfo();
        
         $("#event_calender_icon").hide();
        $("#distlevel").hide();
        $("#blocklevel").hide();
        $("#gplevel").hide();
        var StateOfficer = '@Session["Officer"]';
        var Email = '@Session["Email"]';

        if (StateOfficer == "State Level Nodal Officer") {
            $("#event_calender_icon").show();
            $("#distlevel").show();
            $("#blocklevel").show();
            $("#gplevel").show();
        }
        else if (StateOfficer == "District Level Nodal Officer") {
            //window.location = "/MasterDropDown/new_report_training_dist";
            $("#event_calender_icon").hide();
            $("#distlevel").show();
            $("#blocklevel").show();
            $("#gplevel").show();
        }
        else if (StateOfficer == "Block Level Nodal Officer") {
            //window.location = "/MasterDropDown/new_report_training_block";
            $("#event_calender_icon").hide();
            $("#distlevel").hide();
            $("#blocklevel").show();
            $("#gplevel").show();
        }
        else if (StateOfficer == "Gram Panchyat Nodal Officer") {
            //window.location = "/MasterDropDown/new_report_training_gp";
            $("#event_calender_icon").hide();
            $("#distlevel").hide();
            $("#blocklevel").hide();
            $("#gplevel").show();
        }
        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
            $("#event_calender_icon").show();
            $("#distlevel").show();
            $("#blocklevel").show();
            $("#gplevel").show();
        }

        /*state_data();*/
    });

</script>

<script>
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/SocialMointoring/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                    $(".loader").hide();
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();

                    $(".loader").hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        $(".loader").hide();

                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        State_Dropdown_Function();




                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        Dist_fun();


                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        Block_fun();



                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').show();


                    }


                }
            }

        });

    }
    function DropDownInfo() {
        $(".loader").show();
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/GplevelMobileData/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select StateName</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
