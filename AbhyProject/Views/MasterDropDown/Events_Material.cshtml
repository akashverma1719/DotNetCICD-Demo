    function Save_event_material() {               //abhi
        var NPMU = $("#NPMU option:selected").text();
        var current_event = $("#spnstate option:selected").text();
        var current_event1 = $("#dist11 option:selected").text();
        var current_event2 = $("#block1 option:selected").text();
        var current_event3 = $("#gram1 option:selected").text();

        var p_training_name = $("#p_training_name1 option:selected").val();
        var type_of_event = $("#type_event").val();
        var location_expo = $("#loc_expo").val();
        var particular_expo = $("#parti_expo").val();
        //var level_event = $("#level_event").val();
        //var district = $("#district").val();
        //var block = $("#block").val();
        var year = $("#year option:selected").val();
        
        var event_platform = $("#event_platform").val();
        var from_date = $("#from_date").val();
        var to_date = $("#to_date").val();

        var upload = $("#upload_module").get(0);
        var upload_files = upload.files;
        var remark = $("#remark").val();

        var formdata = new FormData();


            month = $("#month option:selected").val();
       

        var state = $("#spnstate option:selected").text();
        if (state == "0") {
            alert('Select State');
            return;
        }
        var dis = $("#dist11 option:selected").text();
        if (dis == "0") {
            alert('Select District');
            return;
        }
        var block = $("#block1 option:selected").text();
        if (block == "0") {
            alert('Select Block');
            return;
        }
        var gram = $("#gram1 option:selected").text();
        if (gram == "0") {
            alert('Select GramPanchayat');
            return;
        }

        if (year == "0") {
            alert('Select Year');
            return;
        }

        if (month == "0") {
            alert('Select Month');
            return;
        }

        if (type_of_event == "0") {
            alert('Select Type of Event');
            return;
        }
        if (p_training_name == "0") {
            alert('Select Topic of Event');
            return;
        }
        if (type_of_event == "Exposure Visits") {
            if (location_expo == "") {
                alert('Enter Location of Exposure');
                return;
            }
            if (particular_expo == "") {
                alert('Enter Particulars of Exposure Visit');
                return;
            }
        }
        if (type_of_event == "Exposure Visits") {
            event_platform == "";
        }
        else {
            if (event_platform == "") {
                alert('Select Event Platform');
                return;
            }
        }
        if (from_date == "") {
            alert('Enter From Date');
            return;
        }
        if (to_date == "") {
            alert('Enter To Date');
            return;
        }
        if (upload_files.length == "0") {
            alert('Upload File ');
            return;
        }
        if (remark == "") {
            alert('Please Enter Remark');
            return;
        }

        formdata.append("p_training_name", p_training_name);
        formdata.append("type_of_event", type_of_event);
        formdata.append("location_expo", location_expo);
        formdata.append("particular_expo", particular_expo);

        //formdata.append("level_event", level_event);
        //formdata.append("district", district);
        //formdata.append("block", block);
        formdata.append("NPMU", NPMU);
        formdata.append("current_event", current_event);
        formdata.append("current_event1", current_event1);
        formdata.append("current_event2", current_event2);
        formdata.append("current_event3", current_event3);
        formdata.append("year", year);
        formdata.append("month", month);

        formdata.append("event_platform", event_platform);
        formdata.append("from_date", from_date);
        formdata.append("to_date", to_date);
        formdata.append("upload", upload_files[0]);
        formdata.append("remark", remark);

        $.ajax({
            url: '/MasterDropDown/Save_event_material_Data',
            data: formdata,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (response) {

                alert(response);
                if (response == "SessionTimeOut") {
                      window.location = "/Home/LogOut";
                }
                if (response == "Choose Valid File") {
                    $("#upload_module").val("");
                    $("#remark").val("");
                }
                else {
                    $("#p_training_name1").val("0");
                    $("#type_event").val("0");
                    $("#loc_expo").val("");
                    $("#parti_expo").val("");
                    //$("#level_event").val("");
                    //$("#district").val("");
                    //$("#block").val("");
                    //$("#year").val("0");
                    //$("#month").val("0");
                    $("#event_platform").val("");
                    $("#from_date").val("");
                    $("#to_date").val("");
                    $("#upload_module").val("");
                    $("#remark").val("");
                }
                var StateOfficer = '@Session["Officer"]';
                if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
                    abhy_Material_Info_Search_4();
                }
                else {
                    abhy_Material_Info_Search1();
                    abhy_Material_Info_Search2();
                    abhy_Material_Info_Search3();
                    abhy_Material_Info_Search5();
                }
                //event_material_info();
                //event_material_info1();
                //event_material_info12();
                //event_material_info123();
                //event_material_info1234();
            },
            error: function () {
                alert('Data Insert Failed');
            }
        });

        $("#LEV").hide();
        $("#PEV").hide();
        /*event_material_info();*/
    }

