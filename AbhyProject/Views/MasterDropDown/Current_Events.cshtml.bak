<script>

   var Jsondata = "";
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    $(document).ready(function () {

        // by default year and month details show
        var fin_year = getCurrentFiscalYear();

        var year = "";
        var year = "";
        if (fin_year == "2021-22") {
            year = "2021-22"
        } else if (fin_year == "2022-23") {
            year = "2022-23";
        } else if (fin_year == "2023-24") {
            year = "2023-24"
        }

        $("#year").val(year);
        //$("#year_state").val(year);
        //$("#year_district").val(year);
        //$("#year_block").val(year);
        //$("#year_gram").val(year);
        //$("#year_all").val(year);
        //$("#year_npmu").val(year);

        const month = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        const m = new Date()
        let MonthName = month[m.getUTCMonth()];

        $("#month").val(MonthName);
        //$("#month_state").val(MonthName);
        //$("#month_district").val(MonthName);
        //$("#month_block").val(MonthName);
        //$("#month_gram").val(MonthName);
        //$("#month_all").val(MonthName);
        //$("#month_npmu").val(MonthName);

        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $("#ForGp").hide();
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
        $('#spnstate_state_1').hide();
        $('#StateLabel_state').hide();

        $('#StateLabel_district').hide();
        $('#DistLabel_district').hide();

        $('#StateLabel_block').hide();
        $('#DistLabel_block').hide();
        $('#BlockLabel_block').hide();

        $('#StateLabel_gram').hide();
        $('#DistLabel_gram').hide();
        $('#BlockLabel_gram').hide();
        $('#GramLabel_gram').hide();

        $('#StateLabel_all').hide();
        $('#StateDropdownLabel_all').hide();
        $('#DistLabel_all').hide();
        $('#DistDropdownLabel_all').hide();
        $('#BlockLabel_all').hide();
        $('#BlockDropdownLabel_all').hide();
        $('#GramLabel_all').hide();
        $('#GramDropdownLabel_all').hide();

        var StateOfficer = '@Session["Officer"]';

        if (StateOfficer == "Gram Panchyat Nodal Officer" || StateOfficer == "Block Level Nodal Officer" || StateOfficer == "District Level Nodal Officer" || StateOfficer == "State Level Nodal Officer") {

            $('#NPMU').hide();
            $('#NPMU_all').hide();
            $('#spnstate').show();
            $('#dist11').show();
            $('#block1').show();
            $('#gram1').show();
            $('#spnstate_all').show();
            $('#spnstate_all').show();
            $('#spnstate_all').show();

        }
        else {

            $('#NPMU').show();
            $('#spnstate').hide();
            $('#dist11').hide();
            $('#block1').hide();
            $('#gram1').hide();
            $('#NPMU_all').show();
        }
        if (StateOfficer == "Gram Panchyat Nodal Officer" || StateOfficer == "Block Level Nodal Officer" || StateOfficer == "District Level Nodal Officer") {

            $("#event_calender_icon").hide();

        }
        else {

            $("#event_calender_icon").show();
        }
        if (StateOfficer == "Gram Panchyat Nodal Officer") {
            $("#reg_date").hide();
            $("#ForGp").show();
            $("#ForAll").hide();
        }
        else {
            $("#ForGp").hide();
            $("#ForAll").show();
            $("#reg_date").show();
        }

        DropDownInfo();
        DropDownInfo1();

    });
    function pagechange() {
        window.location = "WspWaterAvailability", "WspNew"
    }

    function getCurrentFiscalYear() {
        //get current date
        var today = new Date();
        if ((today.getMonth() + 1) <= 3) {
            fiscalyear = (today.getFullYear() - 1) + "-" + today.getFullYear()
        } else {
            fiscalyear = today.getFullYear() + "-" + (today.getFullYear() + 1)
        }

        if (fiscalyear == "2020-2021") {
            fincalyear = 2020;
        } else if (fiscalyear == "2021-2022") {
            fincalyear = 2021;
        } else if (fiscalyear == "2022-2023") {
            fincalyear = 2022;
        } else if (fiscalyear == "2023-2024") {
            fincalyear = 2023;
        } else if (fiscalyear == "2024-2025") {
            fincalyear = 2024;
        }

        if (fiscalyear == "2020-2021") {
            fiscalyear = "2020-21";
        } else if (fiscalyear == "2021-2022") {
            fiscalyear = "2021-22";
        } else if (fiscalyear == "2022-2023") {
            fiscalyear = "2022-23";
        } else if (fiscalyear == "2023-2024") {
            fiscalyear = "2023-24";
        } else if (fiscalyear == "2024-2025") {
            fiscalyear = "2024-25";
        }

        return (fiscalyear);
    }

</script>


<script>
    /* for Binding*/

    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/MasterDropDown/State_SessionInfo_3",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else {
                    $('#Error_').text("");
                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();
                    $('#spnstate_state_1').hide();

                    $('#StateLabel_all').hide();
                    $('#StateDropdownLabel_all').hide();
                    $('#DistLabel_all').hide();
                    $('#DistDropdownLabel_all').hide();
                    $('#BlockLabel_all').hide();
                    $('#BlockDropdownLabel_all').hide();
                    $('#GramLabel_all').hide();
                    $('#GramDropdownLabel_all').hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#text_form_new').text('NPMU Level Entry Form')
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
