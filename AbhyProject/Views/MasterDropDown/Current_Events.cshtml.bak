    <div class="row" id="entry_form">
        <div class="container-fluid">

            <div class="content">
                <div class="col-lg-12" style="background-color:#fff;">
                    <div id="border">
                        <center>
                            <div class="ss">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div id="text_form_new" class="text-h g-mb-20" style="padding: 0px; color: #337ab7; font-size: 30px; font-family:raleway;margin-top:10px;font-weight:900">
                                            Current Events Entry Form
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </center>

                        <div class="row container-fluid main_div">
                            @*for Binding*@
                            <div class="col-md-12 col-sm-12">
                                <div class="selectdistshowoption">
                                    <label style="text-align:center;color:red;" id="Error_"></label>
                                    <ul class="Select_option selectbackhome" style="text-align:center;">
                                        <li>
                                            <select class="form-control" id="NPMU" disabled>
                                                <option value="NPMU (Delhi)">NPMU (Delhi)</option>
                                            </select>
                                        </li>

                                        <li id="StateLabel">
                                            <label id="lblstate">State:</label>
                                            <span id="spnstate1">@Session["gstate"]</span>
                                        </li>
                                        <li id="StateDropdownLabel">
                                            <select class="form-control" id="spnstate" onchange="State_Dropdown_Function()"></select>
                                        </li>

                                        <li id="DistLabel">
                                            <i class="fas fa fa-angle-double-right"></i>
                                            <label id="lbldistrict">District:</label>
                                            <span id="spndistrict">@Session["gdist"]</span>
                                        </li>

                                        <li id="DistDropdownLabel">
                                            <select class="form-control" id="dist11" onchange="Dist_fun()"></select>
                                        </li>

                                        <li id="BlockLabel">
                                            <i class="fas fa fa-angle-double-right"></i>
                                            <label>Block:</label>
                                            <span id="spnblock">@Session["gblock"]</span>
                                        </li>

                                        <li id="BlockDropdownLabel">

                                            <select class="form-control" id="block1" onchange="Block_fun()"></select>
                                        </li>
                                        <li id="GramLabel">
                                            <i class="fas fa fa-angle-double-right"></i>
                                            <label>GramPanchayat:</label>
                                            <span id="spngram">@Session["ggram"]</span>
                                        </li>

                                        <li id="GramDropdownLabel">

                                            <select class="form-control" id="gram1" onchange="Gram_Fun()"></select>
                                        </li>
                                        <li>
                                            <select class="form-control" id="year">
                                                <option value="0">Select Financial Year</option>
                                                <option value="2021-22">2021-22</option>
                                                <option value="2022-23">2022-23</option>
                                                <option value="2023-24">2023-24</option>
                                                @*<option value="2024">2024-2025</option>
                                                    <option value="2025">2025-2026</option>*@
                                            </select>
                                        </li>
                                        <li id="MonthDropdownLabel">

                                            <select class="form-control" id="month" onchange="Month_change()">
                                                <option value="0">Select Month</option>
                                                <option value="April">April</option>
                                                <option value="May">May</option>
                                                <option value="June">June</option>
                                                <option value="July">July</option>
                                                <option value="August">August</option>
                                                <option value="September">September</option>
                                                <option value="October">October</option>
                                                <option value="November">November</option>
                                                <option value="December">December</option>
                                                <option value="January">January</option>
                                                <option value="February">February</option>
                                                <option value="March">March</option>
                                            </select>
                                        </li>

                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <main>
        <div class="container">
            <div class="clearfix">

                <div class="col-md-12">
                    <div class="A_part_div">


                        <div class="col-md-12">
                            <div class="" id="div_all">
                                <div class="">
                                    <ul class="second_heading" style="text-align:center">
                                        <li> Current Events  </li>
                                    </ul>
                                </div>

                                <div id="style-1" class="tbl-responsive" style="overflow-x: scroll; font-size: 12px; margin-bottom: 20px;">
                                    <table id="" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">

                                        <tbody id="">

                                            <tr>
                                                <td colspan="2" class="font-bold">	Topic of Event: </td>
                                                <td colspan="6">
                                                    <input type="text" class="form-control" id="p_training_name" placeholder="Enter your Topic of Event " style="width:63%;" />
                                                </td>
                                            </tr>

                                            <tr>
                                                <td colspan="3" class="font-bold">	Type of Event: </td>
                                                <td>
                                                    @*<input type="text" class="form-control" id="type_event" placeholder="Enter your Type of Event" />*@
                                                    <select name="Type of Event" id="type_event" class="form-control" onchange="type_of_event()" style="width:250px">
                                                        <option value="0">Type of Event</option>
                                                        <option value="Training">Training</option>
                                                        <option value="Workshop">Workshop</option>
                                                        <option value="Orientation">Orientation</option>
                                                        <option value="Exposure Visits">Exposure Visits</option>
                                                    </select>
                                                </td>
                                                <td id="EventPlatform" colspan="3" class="font-bold">Event Platform : </td>
                                                <td id="EventPlatform1">
                                                    @*<input type="text" class="decimal form-control" id="event_platform" placeholder="Enter your Event Platform" />*@
                                                    <select name="Event Platform" id="event_platform" class="form-control" onchange="event_platform()" style="width:250px">
                                                        <option value="0">Event Platform</option>
                                                        <option value="Physical">Physical</option>
                                                        <option value="Virtual">Virtual</option>
                                                        @*<option value="In-person">In-person</option>*@

                                                    </select>
                                                </td>
                                            </tr>
                                            <tr id="LEV">
                                                <td colspan="3" class="font-bold"> Location of Exposure Visit : </td>
                                                <td>
                                                    <input type="text" class="form-control" id="loc_expo" placeholder="Enter your Location of Exposure Visit" />
                                                </td>
                                                <td colspan="3" class="font-bold">	Particulars of Exposure Visit : </td>
                                                <td>
                                                    <input type="text" class="decimal form-control" id="parti_expo" placeholder="Enter your Particulars of Exposure Visit" />
                                                </td>
                                            </tr>

                                            <tr id="PEV">
                                            </tr>


                                            <tr>
                                            </tr>


                                            <tr>
                                                <td colspan="3" class="font-bold">From Date : </td>
                                                <td>
                                                    <input class="form-control" type="date" id="from_date" name="name" value="" style="width: 248px " />

                                                    @*<input class="form-control" type="time" id="from_date" name="name" value="" style="width: 200px " />*@

                                                </td>
                                                <td colspan="3" class="font-bold">To Date : </td>
                                                <td>
                                                    <input class="form-control" type="date" id="to_date" name="name" value="" style="width: 248px " />

                                                    @*<input class="form-control" type="time" id="to_date" name="name" value="" style="width: 200px " />*@
                                                </td>
                                            </tr>


                                            <tr>
                                            </tr>


                                            <tr id="reg_date">
