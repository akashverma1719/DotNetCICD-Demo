<title>Current_Events</title>
<style>
    .database_trainer_row > h3 {
        background-color: #337ab7;
        color: #fff;
        padding: 7px 15px;
        font-size: 18px;
        margin: 6px 0px;
    }
    /*table fix code*/

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
    }

    .font-bold {
        font-weight: bold;
    }

    /*ends here*/
    .second_heading {
        background-color: #337ab7;
        color: #fff;
        list-style: none;
        padding: 12px 10px;
        font-size: 18px;
        font-weight: bold
    }

    .main_div {
        padding-bottom: 30px;
    }

    .btn-success {
        margin: 5px 0px !important;
    }


    table#TblData_b_part tr.info > th,
    table#TblData_c_part tr.info > th,
    table#TblData_d_part tr.info > th,
    table#TblData_e_part tr.info > th,
    table#TblData_abc_part1 tr.info > th,
    table#TblData_jj_part1 tr.info > th,
    table.GWL_deviation_table tr.info > th,
    table#TblData_g_part tr.info > th {
        background-color: #337ab7;
        color: #fff;
        vertical-align: middle;
    }

        table#TblData_abc_part1 tr.info > th.background_color {
            background-color: #fff !important;
            color: #000;
        }

    .E_table_header > h4 {
        color: #337ab7;
        padding: 10px 0px;
    }

    .alertshowingdiv {
        height: 25px;
    }

        .alertshowingdiv > label {
            color: red;
            font-size: 16px;
        }

    #breadcrumb {
        color: #0000ff;
        font-size: 15px;
        margin: 0;
        height: 15px;
        margin-bottom: 10px;
    }

        #breadcrumb a {
            color: #0000ff;
            text-decoration: underline;
        }

    ul#myTabs > li > a > span > img {
        height: 26px;
        width: 26px;
    }

    ul.ReRecharge_list > li > span {
        width: 70%;
    }

    ul#submenu1 > li > span {
        font-size: 17px;
    }

    ul.imgHome > li > a > span {
        font-size: 17px;
        text-decoration: none;
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

        ul.imgHome > li > a > span :hover {
            text-decoration: none;
        }

    ul.imgHome > li > a > label {
        font-size: 13px;
        text-decoration: underline;
        color: #fff;
        padding: 0px 0px 0px 5px;
        margin: 0;
        height: 15px;
    }

    ul.imgHome > li > label {
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

    ul.imgHome > li > a > span > img,
    ul.imgHome > li > span > img {
        width: 25px;
    }

    ul.imgHome > li > a > label {
        padding: 5px 0px 0px 0px;
    }

    .nav-justified {
        padding-bottom: 0em;
    }

    ul.imgHome > li > img,
    ul.imgHome > li > a > img {
        width: 25px !important;
    }

    .highcharts-background {
        /*width: 100% !important;*/
    }

    .highcharts-title {
        display: none;
    }

    span.marqueegwr {
        font-weight: 700;
        margin-top: 10px;
        /*font-family: raleway;*/
        color: #333;
        font-size: 1vw;
    }

    .modal-backdrop.in {
        z-index: 0px !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    ul.btnall > li {
        display: inline-block;
    }

    .backgroundtr {
        background-color: lightgray !important;
    }

        .backgroundtr:hover {
            background-color: #fff !important;
        }

    .backgroundtr1 {
        background-color: lightgoldenrodyellow !important;
    }

        .backgroundtr1:hover {
            background-color: #fff !important;
        }

    .cust_center {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .cust_center h6 {
            font-size: 15px;
        }

    #style-1::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background-color: #F5F5F5;
        border-radius: 25px;
    }

    #style-1::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
    }

    .selectbackhome li select {
        border-radius: 25px;
        width: 180px;
    }

    .headings_border {
        position: relative;
        color: #fff;
        font-size: 35px;
        text-align: center;
        font-family: raleway;
        font-weight: 900;
        display: inline-block;
    }

    Current_Events
    /*   .headings_border::after {
            content: '';
            position: absolute;
            top: 45px;
            left: 13%;
            width: 168px;
            height: 2px;
            background: #5cb85c;
        }*/
    .card {
        margin-top: 25px;
    }

    .card-body {
        border: 1px solid#ccc;
        /*padding: 5px;*/
    }

    .box_shadow {
        box-shadow: 0px 3px 46px rgb(0 0 0 / 7%);
        padding: 15px 15px;
        background: #f2f2f2;
    }

    ul.Select_option {
        padding-left: 0;
        text-align: initial;
        padding-top: 24px;
    }
</style>
<style>
    .under_list > li {
        list-style: none;
        padding: 5px;
        font-size: 15px;
        font-weight: 600;
    }

        .under_list > li > span > input {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

        .under_list > li > span > select {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

    @@media (max-width:1200px) and (min-width: 360px) {
        .panelbodyheading {
            background: none !important;
            color: #337ab7;
        }
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }
</style>


<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>

<main>
    <header class="header hederImage">
        <div class="clearfix">
            <div class="clearfix">
                <div class="col-lg-9">
                    <div class="header-top-info">
                        <ul class="clearfix">
                            <li>
                                <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                            </li>

                            <li>
                                <span>
                                    <a target="_blank" href="http://ataljal.in/" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                </span>
                                <span>
                                    <a href="Javascript:;" style="color:#fff;font-size:14px;" role="link">Ministry of Jal Shakti</a>
                                </span>
                                <span class="li_eng responsive_go_eng"><a href="javascript:;" role="link" style="color: #fff;font-size:14px;">Department of Water Resources,</a></span>
