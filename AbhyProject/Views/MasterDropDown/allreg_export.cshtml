    function Delete_Reg_Partcipant(Id) {

        if (confirm("Do You want to delete")) {

            var obj = {};
            obj.id = Id;
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: '/MasterDropDown/Delete_Reg_Partcipant_Part',
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/Home/LogOut";
                    }
                    search_event();

                    Participant_reg_info_total();


                }

            });
        }
    }
    function Update_AWP1(id, RowNo) {


        var id = id;
        var topic_event1 = $('#topic_event1_' + RowNo).val();
        var name1 = $('#name1_' + RowNo).val();
        var gender1 = $('#gender1_' + RowNo).val();
        var age1 = $('#age1_' + RowNo).val();
        var occupation1 = $('#occupation1_' + RowNo).val();

        var qual1 = $('#qual1_' + RowNo).val();
        var phonenno1 = $('#phonenno1_' + RowNo).val();

        var emailid1 = $('#emailid1_' + RowNo).val();
        if (IsEmail(emailid1) == false) {
            alert("Enter a Valid Email ID");
            return;
        }

        var address1 = $('#address1_' + RowNo).val();
        var parti_state1 = $('#parti_state1_' + RowNo).val();
        var p_other_state_name1 = $('#p_other_state_name1_' + RowNo).val();
        if (p_other_state_name1 == null) {
            p_other_state_name1 = "";
        }
        var reg1 = $('#reg1_' + RowNo).val();

        var state1 = $('#state1_' + RowNo).val();
        var dist1 = $('#district1_' + RowNo).val();
        var block1 = $('#block1_' + RowNo).val();

        var formData = new FormData();

        formData.append("id", id);
        formData.append("topic_event", topic_event1);
        formData.append("name", name1);
        formData.append("gender", gender1);
        formData.append("age", age1);
        formData.append("occupation", occupation1);
        formData.append("qual", qual1);
        formData.append("phonenno", phonenno1);
        formData.append("emailid", emailid1);
        formData.append("address", address1);
        formData.append("partiState", parti_state1);
        formData.append("p_other_state_name", p_other_state_name1);
        formData.append("reg", reg1);
        formData.append('State', state1);
        formData.append('District', dist1);
        formData.append('Block', block1);

        $.ajax({
            url: '/MasterDropDown/Update_Participant_Part_Info',
            data: formData,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (response) {

                alert(response);
                if (response == "SessionTimeOut") {
                    window.location = "/Home/LogOut";
                }

                search_event();

            },
            error: function () {
                alert('Update Failed');
            }
        });
    }
    function Goto_page() {

        var path = $('#goto_page').val();
        if (path != "0") {
            if (path == "/Vendors/admin_Training_Workshop") {
                if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer" || StateOfficer == "State Level Nodal Officer") {

                    window.location = path;
                }
                else {
                    alert("Login with NPMU or State Credentials");
                    $('#goto_page').val("0");
                    return;
                }
            }
            else if (path == "/MasterDropDown/Participants_Registration") {
                if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer" || StateOfficer == "State Level Nodal Officer" || StateOfficer == "District Level Nodal Officer" || StateOfficer == "Block Level Nodal Officer") {

                    window.location = path;
                }
                else {
                    alert("Login with NPMU, State, District or Block Credentials");
                    $('#goto_page').val("0");
                    return;
                }
            }

            else {
                window.location = path;
            }
        }
    }

