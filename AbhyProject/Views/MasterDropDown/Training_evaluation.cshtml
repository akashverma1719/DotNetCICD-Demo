<script>
    $(".loader").show();
    $(document).ready(function () {

            var currentUrl = window.location.href;
            const myArray = currentUrl.split("/");
            let coun = myArray.length - 1;
            if ((myArray[coun] != "WSP_GWM_HOME") && (myArray[coun] != "LogInForce")) {
                GetCunCurrentUser();
        }
        GetPagelog();
    });

        function GetCunCurrentUser() {
            $.ajax({
                type: 'get',
                url: '@Url.Action("CheckCunCurrentUser", "WspNew")',
                success: function (data) {

                    if (data == "False") {

                        window.location.href = "../../WspNew/WSP_GWM_HOME";
                    }
                    $(".loader").hide();
                }
            });
    }


    function GetPagelog() {
        var dateTime = "@dateTime";
        var pageName = "@lastAccessedPage"
       
        $.ajax({
            url: '/WspNew/UpdatePageLog',
            type: 'POST',
            data: {
                dateTime: dateTime,
                pageName: pageName
            },
            success: function (response) {
                if (response.success) {
                    console.log(response.message);
                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function () {
                alert("Failed to update the log.");
            }
        });
    }

</script>

<script>
    $(document).ready(function () {
        SessionInfo();
    });
    function SessionInfo() {
        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/SocialMointoring/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }


            }

        });

    }

</script>
