    <script type="text/javascript">





        $("#download").click(function () {
            $("#download").hide();
            html2canvas(document.querySelector("#Data1")).then(canvas => {
               
                var dataURL = canvas.toDataURL();
                var pdf = new jsPDF();
                pdf.addImage(dataURL, 'JPEG', 20, 20, 180, 300); //addImage(image, format, x-coordinate, y-coordinate, width, height)
                pdf.save("Dashboard Report.pdf");

            });
            
            $("#download").show();
        });


