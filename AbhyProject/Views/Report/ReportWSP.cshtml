<script>
    var TotalActivity = [];
    var categories = [];
    var TotalBudget = [];
    var pieChart = [];

    $(document).ready(function () {


        $.ajax({
            type: "GET",
            url: "/Report/DemandData",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (results) {
               
                console.log(results);
                if (results != null) {

                    for (var i = 0; i < results.length; i++) {
                        TotalActivity.push(results[i].activity);
                        TotalBudget.push(parseInt(results[i].totalbudget));
                        categories.push(results[i].activity);
                        pieChart.push([
                            results[i].activity, parseInt(results[i].totalbudget)]);
                    }
                    paintChart();
                    BudgetCirclechart();
                }
            }
        });

    });


    function paintChart() {
       
        // Create the chart
        Highcharts.chart('chartdiv', {
            chart: {
                renderTo: 'chartdiv',
                type: 'column'
            },
            title: {
                text: 'Demand Side Funding and  Total Budget of different WSP Methods'
            },
            tooltip: {
                shared: true
            },
            xAxis: {
                categories: categories,
                crosshair: true
            },
            yAxis: [{
                title: {
                    text: ''
                }
            }, {
                title: {
                    text: ''
                },
                minPadding: 0,
                maxPadding: 0,
                max: 100,
                min: 0,
                opposite: true,
                labels: {
                    format: "{value}%"
                }
            }],
            series: [{
                type: 'pareto',
                name: 'Funding',
                yAxis: 1,
                //zIndex: 10,
                baseSeries: 1
            }, {
                name: 'Total Budget ',
                type: 'column',
                //zIndex: 2,
                data: TotalBudget
            }]
        });

    }

</script>

<script>
    function BudgetCirclechart() {
        pieChart.push({
            name: 'Proprietary or Undetectable',
            y: 0.2,
            dataLabels: {
                enabled: false
            }
        }
        )
        Highcharts.chart('chartdivbar', {

            chart: {
                plotBackgroundColor: null,
                plotBorderWidth: 0,
                plotShadow: false
            },

            title: {
                text: 'Demand Side <br/> Methods',
                align: 'center',
                verticalAlign: 'middle',
                y: 30

            },
            tooltip: {
                pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
            },
            plotOptions: {
                pie: {
                    dataLabels: {
                        enabled: true,
                        distance: -50,
                        style: {
                            fontWeight: 'bold',
                            color: 'white'
                        }
                    },

                    center: ['48%', '56%']
                }
            },

            series: [{
                type: 'pie',
                name: 'Browser share',
                innerSize: '50%',
                data: pieChart
            }]
        });
    }
</script>

<script>

    var Supplycategories = [];
