                                                var Avg = parseFloat(data[year_month15]) + parseFloat(data[year_month14]) / 2;
                                                YEARWISEDATA.push(Avg);
                                                YEARWISECAT.push(year_month);
                                            }
                                            else {
                                                var year_month14 = allMonths[j] + '_' + years[i - 3];
                                                if (data[year_month14] != "NULL" && data[year_month14] != "0") {


                                                    YEARWISEDATA.push(data[year_month14]);
                                                    YEARWISECAT.push(year_month);
                                                }

                                            }
                                        }
                                    }
                                }
                            }

                            if (years[i] == 16 && data[year_month] != "NULL" && data[year_month] != "0") {
                                YEARWISEDATA.push(data[year_month]);
                                YEARWISECAT.push(year_month);
                            }
                            else {
                                if (i == 2) {
                                    if (data[year_month1] != "NULL" && data[year_month1] != "0") {
                                        YEARWISEDATA.push(data[year_month1]);
                                        YEARWISECAT.push(year_month);
                                    }
                                    else if (data[year_month2] != "NULL" && data[year_month2] != "0") {
                                        YEARWISEDATA.push(data[year_month2]);
                                        YEARWISECAT.push(year_month);
                                    }
                                    else {
                                        if (data[year_month17] != "NULL" && data[year_month17] != "0") {


                                            var year_month14 = allMonths[j] + '_' + years[i - 2];
                                            var Avg = parseFloat(data[year_month17]) + parseFloat(data[year_month14]) / 2;
                                            YEARWISEDATA.push(Avg);
                                            YEARWISECAT.push(year_month);
                                        }
                                        else {
                                            var year_month14 = allMonths[j] + '_' + years[i - 2];
                                            if (data[year_month14] != "NULL" && data[year_month14] != "0") {


                                                // var Avg = parseFloat(data[year_month17]) + parseFloat(data[year_month14]) / 2;
                                                YEARWISEDATA.push(data[year_month14]);
                                                YEARWISECAT.push(year_month);
                                            }
                                        }
                                    }
                                }
                            }

                            if (i == 0) {
                                if (data[year_month] != "NULL" && data[year_month] != "0") {
                                    YEARWISEDATA.push(data[year_month]);
                                    YEARWISECAT.push(year_month);
                                }
                                else if (data[year_month1] != "NULL" && data[year_month1] != "0") {
                                    YEARWISEDATA.push(data[year_month1]);
                                    YEARWISECAT.push(year_month);
                                }
                                else if (data[year_month2] != "NULL" && data[year_month2] != "0") {
                                    YEARWISEDATA.push(data[year_month2]);
                                    YEARWISECAT.push(year_month);
                                }
                                else if (data[year_month3] != "NULL" && data[year_month3] != "0") {
                                    YEARWISEDATA.push(data[year_month3]);
                                    YEARWISECAT.push(year_month);
                                }

                                else if (data[year_month4] != "NULL" && data[year_month4] != "0") {
                                    YEARWISEDATA.push(data[year_month4]);
                                    YEARWISECAT.push(year_month);
                                }

                            }

                            if (i == 1) {
                                if (data[year_month] != "NULL" && data[year_month] != "0") {
                                    YEARWISEDATA.push(data[year_month]);
                                    YEARWISECAT.push(year_month);
                                }
                                else if (data[year_month1] != "NULL" && data[year_month1] != "0") {
                                    YEARWISEDATA.push(data[year_month1]);
                                    YEARWISECAT.push(year_month);
                                }
                                else if (data[year_month2] != "NULL" && data[year_month2] != "0") {
                                    YEARWISEDATA.push(data[year_month2]);
                                    YEARWISECAT.push(year_month);
                                }
                                else if (data[year_month3] != "NULL" && data[year_month3] != "0") {
                                    YEARWISEDATA.push(data[year_month3]);
                                    YEARWISECAT.push(year_month);
                                }
                                else {
                                    if (data[year_month17] != "NULL" && data[year_month17] != "0") {
                                        YEARWISEDATA.push(data[year_month17]);
                                        YEARWISECAT.push(year_month);
                                    }
                                }

                            }



                        }
                    }



                    var sum_x = 0, sum_y = 0, counter = 0, xy_bar = 0, x_square_bar = 0, y_square_bar = 0;

                    for (var l = 0; l < YEARWISEDATA.length; l++) {
                        counter = l + 1;
                        sum_x += counter;
                        sum_y += parseFloat(YEARWISEDATA[l]);
                        y_square_bar += Math.pow(parseFloat(YEARWISEDATA[l]), 2);

                        xy_bar += counter * parseFloat(YEARWISEDATA[l]);
                        x_square_bar += Math.pow(counter, 2);

                    }

                    var N = YEARWISEDATA.length;
                    var x1 = (sum_y * x_square_bar) - (sum_x * xy_bar);
                    var x2 = (N * (x_square_bar)) - (Math.pow(sum_x, 2));
                    var AValue = x1 / x2;

                    var y1 = (N * (xy_bar)) - (sum_x * sum_y);
                    var y2 = (N * (x_square_bar)) - (Math.pow(sum_x, 2));

                    var BValue = y1 / y2;

                    var R1 = N * (y_square_bar) - (Math.pow(sum_y, 2));;
                    var R2 = y2 * R1;
                    var R3 = Math.abs(R2);
                    var R4 = Math.sqrt(R3);
                    var R_SquareValue = y1 / R4;
                    document.getElementById('RbValue').innerHTML = BValue.toFixed(4);
                    document.getElementById('RaValue').innerHTML = AValue.toFixed(4);
                    document.getElementById('RrSqure').innerHTML = R_SquareValue.toFixed(4);

                    for (var i = 1; i <= counter; i++) {

                        var TTval = AValue + (BValue * i);

                        TrendLine.push(TTval.toFixed(2));

                    }


                    var chartHeight = data.length * 50;
                    $("#Rainfall_Chart").css("height", chartHeight);


                    $("#Rainfall_Chart").kendoChart({
                        title: {
                            text: "Rainfall Data Monthly Wise",
                            padding: {
                                top: 10,
                                left: -100

                            }
                        },
                        legend: {
                            position: "bottom"
                        },
                        chartArea: {

                            background: ""
                        },
                        seriesDefaults: {
                            type: "line",
                            style: "smooth"
                        },
                        series: [{
                            name: "Trend",
                            color: "green",
                            markers: {
                                size: 0
                            },
                            dashType: "dash",
                            data: TrendLine
                        }, {
                            name: "Rainfall Data",
                            color: "blue",
                            data: YEARWISEDATA
                        }],
                        valueAxis: {
                            title: {
                                text: "Rainfall Data(mm)",

                            },
                            //reverse: true,
                            //axisCrossingValue: [10000],
                            //reverse: true,
                            labels: {
                                visible: true,
                                format: "{0}"
                            },
                            line: {
                                visible: false
                            },

                        },
                        categoryAxis: {

                            categories: YEARWISECAT,
                            position: "bottom",
                            majorGridLines: {
                                visible: false
                            },
                            labels: {
                                rotation: "auto"
                            }
                        },
                        tooltip: {
                            visible: true,
                            format: "{0}",
                            template: "#= series.name #: #= value #"
                        }

                    });
                }

    }
</script>

