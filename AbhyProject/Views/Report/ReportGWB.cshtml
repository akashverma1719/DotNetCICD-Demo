<script>
    // Create the chart
    Highcharts.chart('container', {
        chart: {
            type: 'column'
        },
        title: {
            text: 'Water Budgeting Components'
        },
        //subtitle: {
        //    text: 'Click the columns to view versions. Source: <a href="http://statcounter.com" target="_blank">statcounter.com</a>'
        //},
        xAxis: {
            type: 'category'
        },
        yAxis: {
            title: {
                text: 'Value (m³)'
            }

        },
        legend: {
            enabled: false
        },
        plotOptions: {
            series: {
                borderWidth: 0,
                dataLabels: {
                    enabled: true,
                    format: '{point.y:.1f}'
                }
            }
        },

        tooltip: {
            headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
            pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.2f}</b>(m³)<br />'
        },

        series: [
            {
                name: "Water Budgeting Components",
                colorByPoint: true,
                data: [
                    {
                        name: "Surface Water Availability",
                        y: @Session["SurfaceWaterCount"],
                        //drilldown: "Chrome"
                    },
                    {
                        name: "Ground Water Recharge",
                        y: @Session["RechargeTotal"],
                        //drilldown: "Firefox"
                    },
                    {
                        name: "Water Draft",
                        y: @Session["DraftTotal"],
                        //drilldown: "Internet Explorer"
                    },
                    {
                        name: "Balance",
                        y: @Session["ReachargeandDraftTotal"],
                        //drilldown: "Safari"
                    }
                ]
            }
        ],

    });
</script>
<script>
    // Make monochrome colors
    var pieColors = (function () {
        var colors = [],
            base = Highcharts.getOptions().colors[0],
            i;

        for (i = 0; i < 10; i += 1) {
            // Start out with a darkened base color (negative brighten), and end
            // up with a much brighter color
            colors.push(Highcharts.Color(base).brighten((i - 3) / 7).get());
        }
        return colors;
    }());

    // Build the chart
    Highcharts.chart('container4', {
        chart: {
            plotBackgroundColor: null,
            plotBorderWidth: null,
            plotShadow: false,
            type: 'pie'
        },
        title: {
            text: 'Water Draft Components'
        },
        tooltip: {
            pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
        },
        plotOptions: {
            pie: {
                allowPointSelect: true,
                cursor: 'pointer',
                colors: pieColors,
                dataLabels: {
                    enabled: true,
                    format: '<b>{point.name}</b><br>{point.percentage:.1f} %',
                    distance: -50,
                    filter: {
                        property: 'percentage',
                        operator: '>',
                        value: 4
                    }
                }
            }
        },
        series: [{
            name: 'Share',
            data: [
                { name: 'Irrigation', y: @Session["IrrigationDraft"] },
                { name: 'Drinking Purpose	', y: @Session["DrinkingDraft"] },
                { name: 'Industry', y: @Session["DraftIndustry"] },

            ]
        }]
    });
</script>



