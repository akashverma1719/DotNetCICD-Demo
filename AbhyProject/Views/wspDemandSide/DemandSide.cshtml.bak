        }
        tablinks_gw = document.getElementsByClassName("tablinks_gw");
        for (i = 0; i < tablinks_gw.length; i++) {
            tablinks_gw[i].className = tablinks_gw[i].className.replace(" active", "");
        }
        document.getElementById(cityName3).style.display = "block";
