    function get_approved_status() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_new/get_approved_status",
            dataType: 'JSON',
            success: function (data) {
                debugger;

                @* status_id = @ViewBag.status_id;
                alert(status_id) *@
                if (data > 0) {
                    $('input[type=text]').prop("disabled", true)
                    $('select').prop("disabled", true);
                    $('input[type=file]').prop("disabled", true)
                    $('.btn_disabled').prop("disabled", true);
                }
            }
        });
    }

    // Funding Calculation
    function GapFundingCalCrop() {
        var aprx_est_cost_sprinkler = $("#aprx_est_cost_sprinkler_crop").val();
        var aprx_fund_avail_sprinkler = $("#aprx_fund_avail_sprinkler_crop").val();

        var gap_fund_sprinkler = aprx_est_cost_sprinkler - aprx_fund_avail_sprinkler;
        $("#gap_fund_sprinkle_crop").val(gap_fund_sprinkler);
    }

    function GapFundingCalAnyother() {
        var aprx_est_cost_sprinkler = $("#aprx_est_cost_sprinkler_anyother").val();
        var aprx_fund_avail_sprinkler = $("#aprx_fund_avail_sprinkler_anyother").val();

        var gap_fund_sprinkler = aprx_est_cost_sprinkler - aprx_fund_avail_sprinkler;
        $("#gap_fund_sprinkle_anyother").val(gap_fund_sprinkler);
    }

</script>

<script>
    function Department_Info() {

        $.ajax({
            type: "GET",
            url: "/wspDemandSide/Demadside_Department_Info",
            //url: "/WSPHome/SupplaySide_Funding_Source",
            contentType: "application/json;charset=utf-8",
            data: '',
            dataType: 'JSON',
            success: function (response) {

                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                $("#sprinkler_department").empty();
                //$("#ar_possible_funding_source").empty();
                //$("#other_possible_funding_source").empty();

                var optionhtml = "<option value='0'>--Select Department name--</option>";
                if (response.length != 0) {

                    for (var i = 0; i < response.length; i++) {
                        if (response[i].department_name != null && response[i].department_name != "") {
                            optionhtml += '<option value="' + response[i].department_name + '">' + response[i].department_name + '</option>';
                        }
                    }
                    $("#sprinkler_department").append(optionhtml);
                    $("#drip_department").append(optionhtml);
                    $("#pipe_department").append(optionhtml);
                    $("#crop_department").append(optionhtml);
                    $("#anyother_department").append(optionhtml);
                    Scheme_Info();
                }
            }
        });
    }

    function Scheme_Info() {

        $.ajax({
            type: "GET",
            url: "/wspDemandSide/Scheme_Info",
            //url: "/WSPHome/SupplaySide_Funding_Source",
            contentType: "application/json;charset=utf-8",
            data: '',
            dataType: 'JSON',
            success: function (response) {

                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                $("#sprinkler_scheme").empty();
                //$("#ar_possible_funding_source").empty();
                //$("#other_possible_funding_source").empty();

                var optionhtml = "<option value='0'>--Select Scheme name--</option>";
                if (response.length != 0) {

                    for (var i = 0; i < response.length; i++) {
                        if (response[i].scheme_name != null && response[i].scheme_name != "") {
                            optionhtml += '<option value="' + response[i].scheme_name + '">' + response[i].scheme_name + '</option>';
                        }
                    }
                    optionhtml += "<option value='Other'>Other</option>";
                    $("#sprinkler_scheme").append(optionhtml);
                    $("#drip_scheme").append(optionhtml);
                    $("#pipe_scheme").append(optionhtml);
                    $("#crop_scheme").append(optionhtml);
                    $("#anyother_scheme").append(optionhtml);


                }


            }

        });
    }

    function CheckOtherSP() {
        if ($("#sprinkler_scheme").val() == "Other") {
            $("#other_scheme_sp").show();
        } else {
            $("#other_scheme_sp").hide();
        }

        if ($("#drip_scheme").val() == "Other") {
            $("#other_scheme_dp").show();
        } else {
            $("#other_scheme_dp").hide();
        }

        if ($("#pipe_scheme").val() == "Other") {
            $("#other_scheme_pl").show();
        } else {
            $("#other_scheme_pl").hide();
        }
        if ($("#anyother_scheme").val() == "Other") {
            $("#other_scheme_any").show();
        } else {
            $("#other_scheme_any").hide();
        }
        if ($("#crop_scheme").val() == "Other") {
            $("#other_scheme_cp").show();
        } else {
            $("#other_scheme_cp").hide();
        }

    }
</script>

