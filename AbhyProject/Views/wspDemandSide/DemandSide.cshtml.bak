    // Other Option Script Crop4th one
    function CheckCrop_Diversion_kharif_Paddy_FundingSource(val) {

        var element = document.getElementById('other_Crop_Diversion_kharif_Paddy_FundingSource');
        var elementSelect = document.getElementById('Crop_Diversion_kharif_Paddy_FundingSource');
        if (val == 'Others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'Others')
            elementSelect.style.display = 'none';

        else
