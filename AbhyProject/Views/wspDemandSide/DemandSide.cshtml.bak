                                <div id="Tokyo" class="tabcontent">
                                    <div class="row text-center">
                                        <label for="total_population_of_human">
                                            Summer Crops
                                        </label>
                                        <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll; height:350px;">
                                            <table id="TblData_abc_part3" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                                                <thead>
                                                    <tr class="info red">
                                                        <th rowspan="3" class="text-center"><button class="updatenew btn btn-success btn_disabled" onclick="addrow_a_part_Summer()"> New </button></th>
                                                        <th class="text-center">S.No.</th>
                                                        <th class="text-center">Crop Category</th>
                                                        <th class="text-center">Crop Type</th>
                                                        <th class="text-center">Crop Name</th>
                                                        <th class="text-center">Area under Conventional Irrigation (ha)</th>
                                                        <th class="text-center">Net Water Requirement (mm)</th>
                                                        <th class="text-center">Area Proposed for Sprinkler (ha)</th>
