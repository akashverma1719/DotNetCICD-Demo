    // Get the element with id="defaultOpen" and click on it
    document.getElementById("defaultOpen_change").click();

    //Radio button selecting options

    $(document).ready(function () {
        $("input[name$='cars']").click(function () {
            var test = $(this).val();

            $("div.desc").hide();
