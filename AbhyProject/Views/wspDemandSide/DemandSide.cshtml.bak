        $(this).addClass('active');
        $("#" + tab_id).addClass('active');
    });
    $('ul#Surface_menu li').click(function () {
        var tab_id = $(this).attr('data-tab');

        $('ul#Surface_menu li').removeClass('active');
        $('#music [id^="menu-"][class*="-info"]').removeClass('active');
        $(this).addClass('active');
        $("#" + tab_id).addClass('active');
        if (tab_id == "menu-11") {
            $("#" + tab_id + ".active").find('.tab-side > .tablinks:first-child').trigger('click');
        } else if (tab_id == "menu-12") {
            $("#" + tab_id + ".active").find('.tab-side > .tablinks_rabi:first-child').trigger('click');
        } else if (tab_id == "menu-13") {
            $("#" + tab_id + ".active").find('.tab-side > .tablinks_summer:first-child').trigger('click');
        } else if (tab_id == "menu-14") {
            $("#" + tab_id + ".active").find('.tab-side > .tablinks_change:first-child').trigger('click');
        } else if (tab_id == "menu-15") {
            $("#" + tab_id + ".active").find('.tab-side > .tablinks_gw:first-child').trigger('click');
        }
        //} else if (tab_id == "menu-16") {
        //    $("#" + tab_id + ".active").find('.tab-side > .tablinks_pi:first-child').trigger('click');
        //}
        else if (tab_id == "menu-17") {
            $("#" + tab_id + ".active").find('.tab-side > .tablinks_pi:first-child').trigger('click');
        }
    });

    $('ul#Water_draft_menu li').click(function () {
        var tab_id = $(this).attr('data-tab');

        $('ul#Water_draft_menu li').removeClass('active');
        $('.Sider_column > ul.sider_images_sider').removeClass('active');
        $('#Videos [id^="menu-"][class*="-info"]').removeClass('active');

