            $("#cars_summer" + test).show();
        });
    });

</script>

<script>

    // Other Option Script sprinkler
    function Check_Sprinkler_kharif_Paddy_FundingSource(val) {

        var element = document.getElementById('other_Sprinkler_kharif_Paddy_FundingSource');
        var elementSelect = document.getElementById('Sprinkler_kharif_Paddy_FundingSource');
        if (val == 'Others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'Others')
            elementSelect.style.display = 'none';

        else
            elementSelect.style.display = 'block';
    }
    // Other Option Script drip
    function Check_Drip_kharif_Paddy_FundingSource(val) {

        var element = document.getElementById('other_Drip_kharif_Paddy_FundingSource');
