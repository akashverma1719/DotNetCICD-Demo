        document.getElementById(cityName2).style.display = "block";
        evt2.currentTarget.className += " active";
    }

    // Get the element with id="defaultOpen" and click on it
    document.getElementById("defaultOpen_summer").click();
    //5th tab in demanside
    function openCity_gw(evt3, cityName3) {
        var i, tabcontent_gw, tablinks_gw;
        tabcontent_gw = document.getElementsByClassName("tabcontent_gw");
        for (i = 0; i < tabcontent_gw.length; i++) {
