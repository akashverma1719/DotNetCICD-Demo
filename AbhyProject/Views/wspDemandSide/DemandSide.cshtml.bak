    // Get the element with id="defaultOpen" and click on it
    //document.getElementById("defaultOpen_gw").click();
    //6th tab in demanside
    function openCity_pi(evt4, cityName4) {
        var i, tabcontent_pi, tablinks_pi;
        tabcontent_pi = document.getElementsByClassName("tabcontent_pi");
        for (i = 0; i < tabcontent_pi.length; i++) {
            tabcontent_pi[i].style.display = "none";
        }
        tablinks_pi = document.getElementsByClassName("tablinks_pi");
        for (i = 0; i < tablinks_pi.length; i++) {
