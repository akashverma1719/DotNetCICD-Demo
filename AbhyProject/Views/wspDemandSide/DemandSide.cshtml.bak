@{
    ViewBag.Title = "WspDemandside";
    Layout = null;
}
<meta name="viewport" content="width=device-width" />
<title>Water Security Plan</title>
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/datecss.css" rel="stylesheet" />
<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/css/abhycss.css" rel="stylesheet" />
<link href="~/Content/wsp_formcss.css" rel="stylesheet" />
<script src="~/Scripts/validations.js"></script>
@*<script src="~/Content/JS_Files/sprinkler.js"></script>*@
<script src="~/Content/JS_Files/IdealState.js"></script>
<script src="~/Content/JS_Files/wsp_nw_sprinkler.js"></script>
<script src="~/Content/JS_Files/wsp_nw_drip.js"></script>
<script src="~/Content/JS_Files/wsp_nw_pipeline.js"></script>
<script src="~/Content/JS_Files/wsp_nw_anyOther.js"></script>
@*<script src="~/Content/JS_Files/wsp_nw_innovative.js"></script>*@
<script src="~/Content/JS_Files/wsp_nw_crop.js"></script>
<style>
    .new-form-control {
        width: 100%;
        height: 34px;
        padding: 6px 12px;
        font-size: 14px;
        line-height: 1.42857143;
        color: #555;
        background-color: #fff;
        background-image: none;
        border: 1px solid #ccc;
    }

        .new-form-control[readonly], fieldset[disabled] new-form-control {
            background-color: #eee;
            opacity: 1;
        }

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    ul.estimate_cost_ul {
        list-style: none;
        padding: 0px;
        text-align: left;
    }

        ul.estimate_cost_ul > li {
            display: inline-block;
        }

    ul.wsp-content-content > li > a {
        position: absolute;
        right: 30px;
        color: #fff;
        top: 77px;
    }

    ul.labelvalueShowing_leftpanel {
        list-style: none;
        padding: 0px;
        text-align: left;
    }

        ul.labelvalueShowing_leftpanel > li {
            padding: 2px 5px;
        }

    #progress-ui .progress-group#Surface-water {
        margin-left: -2px;
        z-index: 4;
        background-color: #6FB11D;
    }

    #progress-ui .progress-group.active .progress-node, #progress-ui .progress-group.hover .progress-node {
        border-color: #6FB11D;
    }

    #progress-ui .progress-group#Surface-water .progress-label {
        background-color: #6FB11D;
    }

    .settop {
        padding-bottom: 77px;
        text-align: center;
    }


    .form-control {
        box-shadow: none;
        border-bottom: 1px solid;
        border-radius: 0;
        width: 100px;
    }
</style>


<header class="header hederImage">
    <div class="clearfix">
        <div class="clearfix">
            <div class="col-lg-9">
                <div class="header-top-info">
                    <ul class="clearfix">
                        <li>
                            <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                        </li>
                        <li>
                            <span>
                                <a href="~/home/index" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                            </span>
                            <span>
                                <a href="javascript:;" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                    Ministry of Jal Shakti
                                </a>
                            </span>
                            <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size:14px;">Department of Water Resources,</a></span>
                            <span style="text-align:center;">
                                <a href="javascript:;" title="GOVERNMENT OF INDIA"
                                   style="text-transform:none; font-size:14px;">
                                    River Development & Ganga Rejuvenation
                                </a>
                            </span>

                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-3">
                <ul class="imgHome clearfix">

                    <li>
                        <img src="~/Content/WspImages/user-silhouette.png" title="User" />
                        @if (Session["UserName"] != null)
                        {
                            <span style="color:#fff;">:@Session["UserName"].ToString()</span>
                        }

                    </li>
                    <li>
                        <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                    </li>

                </ul>
            </div>
            <div class="col-md-8" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                <ul class="imgHome clearfix">
                    <li>
                        <a href="~/WspNew/WSP_GWM_HOME">
                            <span>
                                <img src="~/Content/WspImages/home-icon-silhouette.png" />
                            </span>
                            <label>MIS Login <i class="fa fa-angle-double-right"></i></label>
                        </a>
                    </li>

                    <li>
                        <a href="~/WaterSecurityPlan/wsp_home">
                            <span><img src="~/Content/WspImages/home-icon-silhouette.png" /></span>
                            <label>WSP Home <i class="fa fa-angle-double-right"></i></label>
                        </a>
                    </li>

                    @*<li>
                            <a href="~/WspNew/WspWaterAvailability">
                                <span><img src="~/Content/WspImages/home-icon-silhouette.png" /></span>
                                <label>WSP Availablity <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>*@
                    <li>

                        <span><img src="~/Content/WspImages/draft new 1.png" /></span>
                        <label>Demand Side</label>

                    </li>


                </ul>
            </div>
            <div class="col-md-4">
                <ul id="myTabs" class="nav nav-pills nav-justified" role="tablist" data-tabs="tabs">
                    <li class="active">
                        <a href="javascript:;">
                            <span> <img src="~/Content/WspImages/draft new 1.png" /></span>Demand Side
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
<section style="padding-bottom:40px;">

    <div class="tab-content">
        <!--Rainfail_menu Start-->
        <div role="tabpanel" class="tab-pane fade in active" id="music">
            <div class="container-fluid">
                <!--images Row Started-->
                <div class="clearfix">
                    <div class="row" id="Select_dist_level">
                        <ul class="Select_option  selectbackhome">
                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Block:</label>
                                <span>@Session["gblock"] </span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Gram panchayat:</label>
                                <span>@Session["ggram"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Year:</label>
                                <span id="Year">@Session["Year"]</span>
                            </li>

                        </ul>
                        <ul class="selectbackhome" style="float:right;">
                            <li>
                                <a href="~/WaterSecurityPlan/wsp_home">
                                    <button class="btn btn-success ">Back To WSP Home</button>
                                </a>
                            </li>

                        </ul>
                    </div>
                    <div class="row" style="margin-top:10px;">
                        <div class="col-md-12 col-lg-12">
                            <ul class="tabs_menu sru_menu" id="Surface_menu">
                                <li class="tab-link active subtab1" data-tab="menu-11">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/Agriculture_icons/Micro irrigation(Sprinkler).png" /></span>
                                        <label>
                                            Micro-Irrigation through Sprinkler
                                        </label>
                                    </a>
                                </li>
                                <li class="tab-link subtab2" data-tab="menu-12">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/Agriculture_icons/Micro irrigation(Drip).png" /></span>
                                        <label>
                                            Micro-Irrigation through Drip
                                        </label>
                                    </a>

                                </li>


                                <li class="tab-link subtab3" data-tab="menu-13">
                                    <a href="javascript:;">
                                        <span> <img src="~/Content/Agriculture_icons/irrigation through underground pipelines.png" /></span>
                                        <label>
                                            Irrigation through underground pipelines
                                        </label>
                                    </a>
                                </li>
                                <li class="tab-link subtab4" data-tab="menu-14">
                                    <a href="javascript:;">
                                        <span> <img src="~/Content/Agriculture_icons/Crop diverfication.png" /></span>
                                        <label>Crop diversification</label>
                                    </a>
                                </li>
                                <li class="tab-link subtab5" data-tab="menu-15">
                                    <a href="#">
                                        <span><img src="~/Content/Agriculture_icons/pond.png" /></span>
                                        <label>
                                            Any other measure for saving of water in agriculture/Innovative measures ( Pl. specify)
                                        </label>
                                    </a>
                                </li>
                                @*<li class="tab-link subtab6" data-tab="menu-16">
                                        <a href="#">
                                            <span><img src="~/Content/Agriculture_icons/pond.png" /></span>
                                            <label>
                                                Innovative Measures
                                            </label>
                                        </a>
                                    </li>*@
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="clearfix tabfirst">
                    <div class="suface-info active" id="menu-11">
                        <div class="container-fluid">
                            <div class="col-md-3 col-sm-12 ">
                                <div class="tab-side">

                                    <div class="tablinks class_active_one" onclick="openCity(event, 'London')" id="defaultOpen">
                                        <ul class="tabs_ul">
                                            <li>
                                                <ul>
                                                    <li> <img src="~/Content/Agriculture_icons/Kharif.png" /></li>
                                                    <li><label> Kharif Crops</label></li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <ul class="labelvalueShowing_leftpanel">
                                            <li><label>Total Ground Water Demand = <span id="Sprinkler_Water_Demand"></span><span>(ha m)</span></label></li>
                                            <li>
                                                <label>
                                                    Net Water Demand  <a href="javascript:;" data-toggle="tooltip" title="((Area - Area proposed for Sprinkler Irrigation) * Water Requirement * 0.001) +(Area proposed for Sprinkler Irrigation* Water Requirement (Net Water Requirement (mm) - Standard Reduction in Water Demand (30%))* 0.001)">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a> = <span id="sprinkler_kharif_total_sprinkler_waterdemand"></span><span>(ha m)</span>
                                                </label>
                                            </li>
                                            <li><label>Reduction in GW Demand <a href="javascript:;" data-toggle="tooltip" title="Water demand (ha m) – Net Water Demand (ha m)"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a>= <span id="sprinkler_kharif_total_reduction_waterdemand"></span><span>(ha m)</span></label></li>
                                        </ul>
                                    </div>
                                    <div class="tablinks class_active_two" onclick="openCity(event, 'Paris')">
                                        <ul class="tabs_ul">
                                            <li>
                                                <ul>
                                                    <li> <img src="~/Content/Agriculture_icons/Rabi.png" /></li>
                                                    <li><label> Rabi Crops</label></li>

                                                </ul>
                                            </li>
                                        </ul>
                                        <ul class="labelvalueShowing_leftpanel">
                                            <li><label>Total Ground Water Demand = <span id="Sprinkler_RabiWater_Demand"></span><span>(ha m)</span></label></li>
                                            <li>
                                                <label>
                                                    Net Water Demand <a href="javascript:;" data-toggle="tooltip" title="((Area - Area proposed for Sprinkler Irrigation) * Water Requirement * 0.001) +(Area proposed for Sprinkler Irrigation* Water Requirement (Standard Reduction in Water Demand (30%) /100)* 0.001)">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a>
                                                    = <span id="sprinkler_rabi_total_rabi_waterdemand"></span><span>(ha m)</span>
                                                </label>
                                            </li>
                                            <li>
                                                <label>Reduction in GW Demand <a href="javascript:;" data-toggle="tooltip" title="Water demand (ha m) – Net Water Demand (ha m)"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a> = <span id="sprinkler_rabi_total_reduction_waterdemand"></span><span>(ha m)</span></label>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="tablinks class_active_three" onclick="openCity(event, 'Tokyo')">
                                        <ul class="tabs_ul">
                                            <li>
                                                <ul>
                                                    <li> <img src="~/Content/Agriculture_icons/Summer crop.png" /></li>
                                                    <li> <label> Summer Crops</label></li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <ul class="labelvalueShowing_leftpanel">
                                            <li><label>Total Ground Water Demand = <span id="Summer_Crops_Water_Demand"></span><span>(ha m)</span></label></li>
                                            <li>
                                                <label>
                                                    Net Water Demand  <a href="javascript:;" data-toggle="tooltip" title="((Area - Area proposed for Sprinkler Irrigation) * Water Requirement * 0.001) +(Area proposed for Sprinkler Irrigation* Water Requirement (Standard Reduction in Water Demand (30%) /100)* 0.001)">
                                                        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                    </a>  = <span id="sprinkler_summer_total_summer_waterdemand"></span><span>(ha m)</span>
                                                </label>
                                            </li>
                                            <li> <label>Reduction in GW Demand <a href="javascript:;" data-toggle="tooltip" title="Water demand (ha m) – Net Water Demand (ha m)"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a> = <span id="sprinkler_summer_total_reduction_waterdemand"></span><span>(ha m)</span></label></li>
                                        </ul>
                                    </div>
                                    <div class="output_div output_div_side">
                                        <label>Total Reduction in GW Demand (ha m) <a href="javascript:;" data-toggle="tooltip" title="Total Reduction in GW Demand (ha m) = Reduction in GW Demand Kharif (ha m) + Reduction in GW Demand Rabi (ha m) + Reduction in GW Demand Summer (ha m)"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a> : <span id="TotalAnnual_sprinkler_Reduction"></span></label>
                                    </div>
                                    <div class="tablinks class_active_four" onclick="openCity(event, 'Dubai')">
                                        <ul class="tabs_ul">
                                            <li>
                                                <ul>
                                                    <li> <img src="~/Content/Agriculture_icons/Summer crop.png" /></li>
                                                    <li> <label> Funding Source</label></li>
                                                </ul>
                                            </li>
                                        </ul>
                                        @*<ul class="labelvalueShowing_leftpanel">
                                                <li><label>Water Demand = <span id="funding_Crops_Water_Demand"></span><span>(ha m)</span></label></li>
                                                <li>
                                                    <label>
                                                        Net Water Demand  <a href="javascript:;" data-toggle="tooltip" title="((Area - Area proposed for Sprinkler Irrigation) * Water Requirement * 0.001) +(Area proposed for Sprinkler Irrigation* Water Requirement (Standard Reduction in Water Demand (30%) /100)* 0.001)">
                                                            <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                                                        </a>  = <span id="funding_summer_waterdemand"></span><span>(ha m)</span>
                                                    </label>
                                                </li>
                                                <li> <label>Reduction in GW Demand <a href="javascript:;" data-toggle="tooltip" title="Water demand (ha m) – Net Water Demand (ha m)"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a> = <span id="sprinkler_summer_total_reduction_waterdemand"></span><span>(ha m)</span></label></li>
                                            </ul>*@
                                    </div>
                                </div>


                            </div>
                            <div class="col-md-9 col-sm-12">
                                <div id="London" class="tabcontent">
                                    <div class="row text-center">
                                        <label for="total_population_of_human">
                                            Kharif Crops
                                        </label>
                                        <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll; height:350px;">
                                            <table id="TblData_abc_part1" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                                                <thead>
                                                    <tr class="info red">
                                                        <th rowspan="3" class="text-center"><button class="updatenew btn btn-success btn_disabled" onclick="addrow_a_part_kharif()"> New </button></th>
                                                        <th class="text-center">S.No.</th>
                                                        <th class="text-center">Crop Category</th>
                                                        <th class="text-center">Crop Type</th>
                                                        <th class="text-center">Crop Name</th>
                                                        <th class="text-center">Area under Conventional Irrigation (ha)</th>
                                                        <th class="text-center">Net Water Requirement (mm)</th>
                                                        <th class="text-center">Area Proposed for Sprinkler (ha)</th>
                                                        <th class="text-center">
                                                            Standard Reduction in Water Demand (30%)
                                                            <a href="javascript:;" data-toggle="tooltip" title="Water Requirement = Net Water Requirement (mm) * 30 / 100"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a>
                                                        </th>
                                                    </tr>


                                                </thead>
                                                <tbody id="TblData_GRAM_PANCHAYAT_DATABASE_a"></tbody>
                                            </table>
                                        </div>



                                    </div>
                                    <div class="col-md-12 col-sm-12 text-center">
                                        <a href="~/WaterSecurityPlan/Water_Budget_report" class="btn btn-danger">Back</a>
                                        <button class="btn btn-info btnNext_tab">Next </button>

                                        <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll; height:350px;">
                                            <table id="TblData_abc_part1_show" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                                                <thead>
                                                    <tr class="info red">

                                                        <th class="text-center">S.No.</th>
                                                        <th class="text-center">Crop Category</th>
                                                        <th class="text-center">Crop Type</th>
                                                        <th class="text-center">Crop Name</th>
                                                        <th class="text-center">Area under Conventional Irrigation (ha)</th>
                                                        <th class="text-center">Net Water Requirement (mm)</th>
                                                        <th class="text-center">Area Proposed for Sprinkler (ha)</th>
                                                        <th class="text-center">
                                                            Standard Reduction in Water Demand (30%)
                                                            <a href="javascript:;" data-toggle="tooltip" title="Water Requirement = Net Water Requirement (mm) * 30 / 100"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span></a>
                                                        </th>
                                                        <th class="text-center">Delete</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="kharif_sp"></tbody>
                                            </table>
                                        </div>
                                    </div>

                                </div>
