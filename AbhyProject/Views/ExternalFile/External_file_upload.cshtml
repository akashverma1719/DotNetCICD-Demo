<div class="row container-fluid">
    <div class="col-md-12 col-sm-12">
        <div class="selectdistshowoption" id="Select_dist_level">
            <label style="text-align:center;color:red;" id="Error_"></label>
            <ul class="Select_option selectbackhome">
                <li id="StateLabel">
                    <label id="lblstate">State:</label>

                </li>
                <li id="StateDropdownLabel">
                    <select class="form-control" id="drpState" onchange="State_Dropdown_Function(this.value)"></select>
                </li>

                <li id="DistLabel">
                    <i class="fas fa fa-angle-double-right"></i>
                    <label id="lbldistrict">District:</label>

                </li>

                <li id="DistDropdownLabel">

                    <select class="form-control" id="dist11" onchange="Dist_fun(this.value)"></select>
                </li>

                <li id="BlockLabel">
                    <i class="fas fa fa-angle-double-right"></i>
                    <label>Block:</label>

                </li>

                <li id="BlockDropdownLabel">

                    <select class="form-control" id="block1" onchange="Block_fun(this.value)"></select>
                </li>
                <li id="GramLabel">
                    <i class="fas fa fa-angle-double-right"></i>
                    <label>Gram panchayat:</label>

                </li>

                <li id="GramDropdownLabel">

                    <select class="form-control" id="gram" onchange="Gram_Fun()"></select>
                </li>
                <li id="DropdownSearch_btn">
                    <button class="btn btn-success" onclick="Dropdown_Search()">Search</button>
                </li>


            </ul>

        </div>
        <div class="row database_trainer_row" style="">
