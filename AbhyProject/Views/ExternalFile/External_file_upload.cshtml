                @*<button type="submit" class="btn btn-primary upload_button_excel" name="Upload"> Upload </button>*@
                @*<button type="button" class="btn btn-success upload_button_excel" name="Upload" onclick="Download_Ar_File()"> Download Excel </button>*@

            </div>
        </div>


        <div class="row database_trainer_row_button">
