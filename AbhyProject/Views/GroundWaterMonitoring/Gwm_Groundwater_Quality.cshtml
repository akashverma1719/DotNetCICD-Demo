                        }
                        else
                            $('#nitrate').text(parseFloat(data[0].nitrate).toFixed(2));
                    }
                    if (data[0].fluoride != null) {
                        if (data[0].fluoride == "ND") {
                            $('#fluoride').text(data[0].fluoride);
                        }
                        else
                            $('#fluoride').text(parseFloat(data[0].fluoride).toFixed(2));
                    }
                    if (data[0].sar != null) {
                        if (data[0].sar == "ND") {
                            $('#sar').text(data[0].sar);
