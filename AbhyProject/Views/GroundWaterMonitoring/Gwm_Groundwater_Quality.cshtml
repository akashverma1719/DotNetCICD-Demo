<script>
    $(document).ready(function () {

        QualityDetails();
    });
    function QualityDetails() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GroundWaterMonitoring/Gwm_Groundwater_Quality_geting',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (data.length != 0) {
                    

                    var ph1 = 0, tds1 = 0, ec1 = 0, th1 = 0, ca1 = 0, mg1 = 0, k1 = 0, carbonate1 = 0, chloride1 = 0, fluoride1 = 0, nitrate1 = 0;
                    //tds
                    if (data[0].tds != null && data[0].tds != '') {

                        tds1 = tds1 + parseFloat((data[0].tds));
                    }
                    if (tds1 >= 500 && tds1 <= 20000) {
                        $('#tds_succuss').append("Suitable")
                    }
                    else {
                        $('#tds_succuss').append("Un Suitable")

                    }
                    // th

                    if (data[0].th != null && data[0].th != '') {

                        th1 = th1 + parseFloat((data[0].th));
                    }
                    if (th1 >= 200 && th1 <= 600) {
                        $('#th_succuss').append("Suitable")
                    }
                    else {
                        $('#th_succuss').append("Un Suitable")

                    }
                    //calcium_succuss

                    if (data[0].ca != null && data[0].ca != '') {

                        ca1 = ca1 + parseFloat((data[0].ca));
                    }
                    if (ca1 >= 75 && th1 <= 200) {
                        $('#calcium_succuss').append("Suitable")
                    }
                    else {
                        $('#calcium_succuss').append("Un Suitable")

                    }
                    //Magnesium_succuss
                    if (data[0].mg != null && data[0].mg != '') {

                        mg1 = mg1 + parseFloat((data[0].mg));
                    }
                    if (ca1 >= 30 && th1 <= 100) {
                        $('#Magnesium_succuss').append("Suitable")
                    }
                    else {
                        $('#Magnesium_succuss').append("Un Suitable")
                    }
                    //Sodium  succuss
                    //Carbonate  succuss
                    if (data[0].carbonate != null && data[0].carbonate != '') {

                        carbonate1 = carbonate1 + parseFloat((data[0].carbonate));
                    }
                    if (carbonate1 >= 200 && carbonate1 <= 600) {
                        $('#Carbonate_succuss').append("Suitable")
                    }
                    else {
                        $('#Carbonate_succuss').append("Un Suitable")
                    }
                    //Chloride_succuss
                    if (data[0].chloride != null && data[0].chloride != '') {

                        chloride1 = chloride1 + parseFloat((data[0].chloride));
                    }
                    if (chloride1 >= 200 && chloride1 <= 600) {
                        $('#Chloride_succuss').append("Suitable")
                    }
                    else {
                        $('#Chloride_succuss').append("Un Suitable")
                    }

                    //Sulphate  succusss
                    if (data[0].chloride != null && data[0].chloride != '') {

                        chloride1 = chloride1 + parseFloat((data[0].chloride));
                    }
                    if (chloride1 >= 200 && chloride1 <= 600) {
                        $('#sulphate_succuss').append("Suitable")
                    }
                    else {
                        $('#sulphate_succuss').append("Un Suitable")
                    }
                    //fluoride_succuss
                    if (data[0].fluoride != null && data[0].fluoride != '') {

                        fluoride1 = fluoride1 + parseFloat((data[0].fluoride));
                    }
                    if (fluoride1 >= 1 && fluoride1 <= 1.5) {
                        $('#fluoride_succuss').append("Suitable")
                    }
                    else {
                        $('#fluoride_succuss').append("Un Suitable")
                    }
                    //nitrate_succuss
                    if (data[0].nitrate != null && data[0].nitrate != '') {

                        nitrate1 = nitrate1 + parseFloat((data[0].nitrate));
                    }
                    if (nitrate1 >= 45 && nitrate1 <= 45) {
                        $('#nitrate_succuss').append("Suitable")
                    }
                    else {
                        $('#nitrate_succuss').append("Un Suitable")
                    }

                    if (data[0].ph != null) {
                        if (data[0].ph == "ND") {
                            $('#ph').text(data[0].ph);
                        }
                        else
                            $('#ph').text(parseFloat(data[0].ph).toFixed(2));
                    }
                    if (data[0].tds != null) {
                        if (data[0].tds == "ND") {
                            $('#tds').text(data[0].tds);
                        }
                        else
                            $('#tds').text(parseFloat(data[0].tds).toFixed(2));
                    }
                    if (data[0].ec != null) {
                        if (data[0].ec == "ND") {
                            $('#ec').text(data[0].ec);
                        }
                        else
                            $('#ec').text(parseFloat(data[0].ec).toFixed(2));
                    }
                    if (data[0].th != null) {
                        if (data[0].th == "ND") {
                            $('#th').text(data[0].th);
                        }
                        else
                            $('#th').text(parseFloat(data[0].th).toFixed(2));
                    }
                    if (data[0].tot_alkalinity != null) {
                        if (data[0].tot_alkalinity == "ND") {
                            $('#tot_alkalinity').text(data[0].tot_alkalinity);
                        }
                        else
                            $('#tot_alkalinity').text(parseFloat(data[0].tot_alkalinity).toFixed(2));
                    }
                    if (data[0].ca != null) {
                        if (data[0].ca == "ND") {
                            $('#ca').text(data[0].ca);
                        }
                        else
                            $('#ca').text(parseFloat(data[0].ca).toFixed(2));
                    }
                    if (data[0].mg != null) {
