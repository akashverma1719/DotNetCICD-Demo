                            $('#mg').text(data[0].mg);
                        }
                        else
                            $('#mg').text(parseFloat(data[0].mg).toFixed(2));
                    }
                    if (data[0].na != null) {
                        if (data[0].na == "ND") {
                            $('#na').text(data[0].na);
                        }
                        $('#na').text(parseFloat(data[0].na).toFixed(2));
                    }
                    if (data[0].k != null) {
                        if (data[0].k == "ND") {
                            $('#k').text(data[0].k);
                        }
                        else
                            $('#k').text(parseFloat(data[0].k).toFixed(2));
                    }
                    if (data[0].fe != null) {
                        if (data[0].fe == "ND") {
                            $('#fe').text(data[0].fe);
                        }
                        $('#fe').text(parseFloat(data[0].fe).toFixed(2));
                    }
                    if (data[0].carbonate != null) {
                        if (data[0].carbonate == "ND") {
                            $('#carbonate').text(data[0].carbonate);
                        }
                        else
                            $('#carbonate').text(parseFloat(data[0].carbonate).toFixed(2));
                    }
                    if (data[0].bicarbonate != null) {
                        if (data[0].bicarbonate == "ND") {
                            $('#bicarbonate').text(data[0].bicarbonate);
                        }
                        $('#bicarbonate').text(parseFloat(data[0].bicarbonate).toFixed(2));
                    }
                    if (data[0].chloride != null) {
                        if (data[0].chloride == "ND") {
                            $('#chloride').text(data[0].chloride);
                        }
                        else
                            $('#chloride').text(parseFloat(data[0].chloride).toFixed(2));
                    }
                    if (data[0].sulphate != null) {
