</div>
<script>
    $(document).ready(function () {

        QuantityDetails();
    });
    function QuantityDetails() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GroundWaterMonitoring/Gwm_Groundwater_Quantity_geting',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (data.length != 0) {


                    if (data[0].area_sq_km != null) {

                        $('#Block_area').text(parseFloat(data[0].area_sq_km).toFixed(2));
                    }
                    if (data[0].avail_ha_m != null) {

                        $('#Annual_GW_Avalibility').text(parseFloat(data[0].avail_ha_m).toFixed(2));
                    }
                    if (data[0].gw_dft_ha_m != null) {

                        $('#Annual_GW_Withdrawal').text(parseFloat(data[0].gw_dft_ha_m).toFixed(2));
                    }
                    if (data[0].stage__gwdev_percentage != null) {

                        $('#Stage_of_GW_Development').text(parseFloat(data[0].stage__gwdev_percentage).toFixed(2));
                    }


                }

                else {

                    alert("No Data for this State,District,Block and Gram panychayat")
                }
            }
        });
    }

</script>


