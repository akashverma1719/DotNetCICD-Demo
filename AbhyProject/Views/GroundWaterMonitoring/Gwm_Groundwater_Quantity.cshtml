                                            <label>Location:</label>
                                        </li>
                                        <li>
                                            <label style="text-transform:capitalize;">Block:</label>
                                            <span name="block" id="block"></span>
                                        </li>

                                    }

                                    <li>
                                        <label>Block Area(sq.km.):</label>
