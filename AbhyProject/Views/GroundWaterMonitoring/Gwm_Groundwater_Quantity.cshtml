            <img src="~/Content/WspImages/Over exploited zone.png" alt="OVER_EXPLOITED" style="display:none;width:275px;padding:10px 0px 0px 0px;" id="OVER_EXPLOITED" name="OVER_EXPLOITED" />
            <img src="~/Content/WspImages/Semi critical zone.png" alt="SEMI-CRITICAL" id="Semi-Critical" name="Semi-Critical" style="display:none;width:275px;padding:10px 0px 0px 0px;" />

            <img src="~/Content/WspImages/critical zone.png" alt="CRITICAL" id="Critical" name="Critical" style="display:none;width:275px;padding:10px 0px 0px 0px;" />
        </div>
                        </div>
