    <script type="text/javascript">
        function ReportPdf() {
            $("#Data1").width(1100);
            var element = document.getElementById('Data1');
            var w = screen.width;
            var h = screen.height;
            var opt = {
                margin: 0,
                filename: 'GroundwaterMonitoringreport.pdf',
                image: { type: 'jpeg', quality: 1.0, w, h },
                html2canvas: { dpi: 192, letterRendering: true },
                jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }
            };
            html2pdf(element, opt);
            $("#Data1").width();
            $('#Data1').addClass('background_after_download');
            $('div.gramReport_div_Data_Collection').addClass('gramReport_div_Data_Collection1');
            $('div.gramReport_div_Groundwater_Information').addClass('gramReport_div_Groundwater_Information1');
            $('div.gramReport_div_Groundwater_Information_last').addClass('gramReport_div_Groundwater_Information_last1');
            $('div.gramReport_div_Data_Collection_table').addClass('gramReport_div_Data_Collection_table1');
            $('div.graphheader').addClass('graphheader1');
            $('div#btnExport').addClass('hideDownload');
            $('div#btnExport1').addClass('hideDownload');
            $(".highcharts-credits").css("display", "none");
            setTimeout(function () {
                $('#Data1').removeClass('background_after_download');
                $('div.gramReport_div_Data_Collection').removeClass('gramReport_div_Data_Collection1');
                $('div.gramReport_div_Groundwater_Information').removeClass('gramReport_div_Groundwater_Information1');
                $('div.gramReport_div_Groundwater_Information_last').removeClass('gramReport_div_Groundwater_Information_last1');
                $('div.gramReport_div_Data_Collection_table').removeClass('gramReport_div_Data_Collection_table1');
                $('div.graphheader').removeClass('graphheader1');
                $('div#btnExport').removeClass('hideDownload');
                $('div#btnExport1').removeClass('hideDownload');
            }, 2000);
        }
    </script>

    <script>
        var currentTime = new Date(),
            hours = currentTime.getHours(),
            minutes = currentTime.getMinutes();

        if (minutes < 10) {
            minutes = "0" + minutes;
        }

        var suffix = "AM";
        if (hours >= 12) {
            suffix = "PM";
            hours = hours - 12;
        }
        if (hours == 0) {
            hours = 12;
        }

        document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
        // date

        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!
        var yyyy = today.getFullYear();

        if (dd < 10) {
            dd = '0' + dd
        }

        if (mm < 10) {
            mm = '0' + mm
        }

        today = mm + '/ ' + dd + '/ ' + yyyy;
        document.getElementById("demo").innerHTML = today;
    </script>

