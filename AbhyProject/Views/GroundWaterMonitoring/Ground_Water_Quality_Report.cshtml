    function QualityDetailsIndividual_report() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GroundWaterMonitoring/Gwm_Groundwater_Quality_geting',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (data.length != 0) {
                    

                    var ph1 = 0, tds1 = 0, ec1 = 0, th1 = 0, ca1 = 0, mg1 = 0, k1 = 0, carbonate1 = 0, chloride1 = 0, fluoride1 = 0, nitrate1 = 0;
                    //tds
                    if (data[0].tds != null && data[0].tds != '') {

                        tds1 = tds1 + parseFloat((data[0].tds));
                    }
                    if (tds1 >= 500 && tds1 <= 20000) {
                        $('#tds_succuss').append("Suitable")
                    }
                    else {
                        $('#tds_succuss').append("Un Suitable")

                    }
                    // th

                    if (data[0].th != null && data[0].th != '') {

                        th1 = th1 + parseFloat((data[0].th));
                    }
                    if (th1 >= 200 && th1 <= 600) {
                        $('#th_succuss').append("Suitable")
                    }
                    else {
                        $('#th_succuss').append("Un Suitable")

                    }
                    //calcium_succuss

                    if (data[0].ca != null && data[0].ca != '') {

                        ca1 = ca1 + parseFloat((data[0].ca));
                    }
                    if (ca1 >= 75 && th1 <= 200) {
                        $('#calcium_succuss').append("Suitable")
                    }
                    else {
                        $('#calcium_succuss').append("Un Suitable")

                    }
                    //Magnesium_succuss
