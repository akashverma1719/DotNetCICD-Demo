                                <th style="background: #867197; color: #fff;">Water available for future irrigation (ha m)</th>
                                <td style="background: #867197; color: #fff;"><span id=""></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align:right">i)</th>
                                <th class="tolat_report_color">Ground Water</th>
                                <td><span id="ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align:right">ii)</th>
                                <th class="tolat_report_color">Surface water</th>
                                <td><span id="surface_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align:right">iii)</th>
                                <th class="tolat_report_color">Total water available for future irrigation</th>
                                <td><span id="total_water"></span></td>
