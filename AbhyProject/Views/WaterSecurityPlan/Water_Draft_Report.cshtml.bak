
@{
    ViewBag.Title = "WaterDraft_report";
    Layout = null;
}

<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="~/Scripts/all_scripts/bootstrap_3.4.0.min.js"></script>
<script src="~/Scripts/all_scripts/highcharts.js"></script>
<script src="~/Scripts/all_scripts/data.js"></script>
<script src="~/Scripts/all_scripts/drilldown.js"></script>
<!--Pie Chart-->
<script src="~/Scripts/all_scripts/exporting.js"></script>
<script src="~/Scripts/all_scripts/export-data.js"></script>
<!--pie chart-->
<script src="https://code.highcharts.com/modules/variable-pie.js"></script>
<!--favicon end-->
<link href="/Scripts/all_scripts/bootstrap.min.css" rel="stylesheet" />

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/css/wsp_report_css.css" rel="stylesheet" />
<!-- jQuery library -->

<script src="~/Content/JS_Files/IdealState.js"></script>
<html>
<head>
    <!-- Latest compiled JavaScript -->
    <style>
        .colorline1 {
            background: #ddd;
            background-size: 100% 6px;
            background-position: 50% 100%;
            background-repeat: no-repeat;
            text-align: center;
            margin-top: 12px;
            height: 3px;
            width: 100%
        }

        .table-striped tbody tr td:last-child {
            text-align: right;
        }

        .dateandtime_ul {
            padding: 0px;
        }

            .dateandtime_ul > li {
                display: inline-block;
                color: #000;
                font-size: 18px;
                padding: 0px 15px;
            }

        .col-md-9 > h1 {
            font-weight: bold;
            color: #404040;
            text-shadow: -1px -1px #000;
        }

        .col-md-9 > p {
            color: #404040;
        }

        .col12 > .firsttable > h6 {
            letter-spacing: 0px;
            padding-left: 10px;
        }

        .firstptag {
            padding-left: 4%;
        }

        body {
            background-color: #ddd;
        }

        .clearfixcolor {
            margin-top: 15px;
        }

        .col12 {
            background-color: #fff;
            padding: 25px;
        }

        .highcharts-credits {
            display: none;
        }



        .highcharts-button-box {
            display: none;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            background: #fff;
        }

        .text-right > .btn-success {
            margin-top: 20px;
            font-weight: bold;
        }

        .text-right {
            padding: 5px;
        }

            .text-right > .btn-success {
                padding: 8px 20px 8px 20px;
                border-radius: 50px;
                font-size: 18px;
            }

        .btn-success {
            color: #fff;
            background-color: #6fb01d;
            border-color: #4cae4c;
        }

        .coll7 {
            padding-right: 0px;
        }

        ul.Select_option {
            list-style: none;
            display: block;
            padding: 0px 0px 0px 0px;
            font-size: 12px;
            margin: 0px;
        }

            ul.Select_option > li {
                display: inline-block;
                padding: 0px 0px 0px 46px;
                text-transform: uppercase;
                word-spacing: 1px;
            }

                ul.Select_option > li > span > i {
                    padding: 0px 0px 0px 10px;
                }

        #Select_dist_level {
            padding: 10px 0px 5px 15px;
            text-transform: capitalize;
        }

        .hideDownload {
            display: none;
        }

        .background_after_download * {
            font-weight: normal !important;
            text-decoration: none !important;
            text-shadow: none !important;
        }

        ul.firstimages {
            display: block;
            margin-bottom: 0px;
            padding: 0px;
        }

            ul.firstimages > li {
                display: inline-block;
                padding-left: 5px;
                border: 1px solid #ddd;
                padding: 10px 10px 5px 10px;
            }

                ul.firstimages > li > img {
                    border-left: 2px solid #ddd;
                }

                ul.firstimages > li > span > img {
                    width: 25px;
                    height: 25px;
                }

        .highcharts-title {
            font-weight: bold;
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
            font-size: 13px;
        }

        tspan {
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
        }


        .secondtable {
            text-align: right;
        }

        sup {
            font-weight: bold;
        }

        #Data1 {
            background-color: #fff;
        }

        .firsttable {
            padding: 10px 0px 0px 0px;
        }

        .report_heading_div {
            background-color: #ddd;
            border-radius: 10px;
            padding: 10px;
        }

        .cololr-div {
            background: #4cae4c;
            height: 3px;
            padding: 0px;
        }

        .last-div-footer {
            padding: 10px 0px;
        }

        .tolat_report_color {
            color: #337ab7;
        }
    </style>
</head>
<body>
    <div class="container" id="Data1">
        <div class="row row_padding_10">
            <div class="col-md-12">
                <div class="firsttable" style="padding:0px;">
                    <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
                </div>

            </div>

            <div class="col-md-12 report_heading_div">
                <div class="col-md-9">
                    <h1>Water Utilization Report </h1>

                </div>
                <div class="col-md-3 text-right" id="btnExport">
                    <button class="btn btn-success download1" onclick="ReportPdf();" id="download">Download</button>
                </div>
                <div class="col-md-12">
                    <ul class="dateandtime_ul">
                        <li>Date : <span id="demouti"></span></li>
                        <li>Time : <span id="demouti2"></span></li>
                        <li>
                            User Name :
                            @if (Session["UserName"] != null)
                            {
                                <span>@Session["UserName"].ToString()</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>


            <div class="col-md-12 state_dist_level" style="margin:5px 0px;">
                <div class="row" id="Select_dist_level">
                    <ul class="Select_option">
                        @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                        {

                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                        {
                            <li>
                                <label id="lblstate">Admin</label>

                            </li>
                        }
                        else
                        {
                            <li>
                                <label id="lblstate">National Level Nodal Officer</label>

                            </li>
                        }


                        @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                        {
                            <li>

                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }

                        @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                        {
                            <li>

                                <label>Block:</label>
                                <span>@Session["gblock"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                        {
                            <li>

                                <label>Gram panchayat:</label>
                                <span>@Session["ggram"]</span>

                            </li>
                        }

                        @if (Session["year"] != null && Session["year"].ToString() != "null" && Session["year"].ToString() != "")
                        {
                            <li>

                                <label>Year:</label>
                                <span>@Session["year"]</span>

                            </li>
                        }
                        @*@if (Session["month"] != null && Session["month"].ToString() != "null" && Session["month"].ToString() != "")
                        {
                            <li>

                                <label>Month :</label>
                                <span>@Session["month"]</span>

                            </li>
                        }*@

                    </ul>
                </div>

            </div>

            <div class="col-md-12">
                <div class="col-md-5">
                    <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer water_draft_individual_table">
                        <thead>
                            <tr class="tableheader1 text-center">
                                <th colspan="3" style="padding:5px;" class="text-center">Water Utilization</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <th>A</th>
                                <th>Drinking /Domestic (ha m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="domestic_demand_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="domestic_demand_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align:center;">iii)</th>
                                <th class="tolat_report_color">Total Drinking /Domestic (ha m)</th>
                                <td><span id="Domestic_Total">0</span></td>
                            </tr>
                            <tr>
                                <th>B</th>
                                <th>Irrigated Agriculture (ha m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="irri_utili_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="irri_utili_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align:center;">iii)</th>
                                <th class="tolat_report_color">Total Irrigated Agriculture (ha m)</th>
                                <td><span id="Irrigated_Total"></span></td>
                            </tr>
                            <tr>
                                <th>C</th>
                                <th>
                                    Industrial Use (ha m)
                                </th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="industry_demand_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="industry_demand_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align:center;">iii)</th>
                                <th class="tolat_report_color">Total Industrial Use (ha m)</th>
                                <td><span id="Industry_Total"></span></td>
                            </tr>
                            <tr>
                                <th>D</th>
                                <th>
                                    Other Uses (if any) (ha m)
                                </th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="other_demand_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="other_demand_ground_water"></span></td>
                            </tr>
                            <tr style="text-align:center;">
                                <th class="tolat_report_color" style="text-align:center;">iii)</th>
                                <th class="tolat_report_color">Total Other Uses (if any) (ha m)</th>
                                <td><span id="Other_Total"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-3">
                    <div id="container_Water_utilization" style="min-width: 610px; height: 450px;"></div>
                </div>

            </div>


            <div class="col-md-12" style="margin-bottom:15px;">
                @*<div class="col-md-12">
                        <p class="text-center">
                            .............................
                        </p>
                        <p class="text-justify">
                            The results and analysis contained within the Water Budgeting Report are generated with the help of inputs given by the
                            user as well as existing database. Each component of water budgeting is designed to make understand the users about
                            the processes, parameters and equations involved in the system. The overall goal of water budgeting is therefore to
                            improve the management of ground water resources in priority areas of the country.
                        </p>
                        <p class="text-center">
                            .............................
                        </p>
                    </div>*@

                <div class="container  hidediv" id="btnExport1">
                    <div class="col-md-12 text-center">
                        <a href="~/WaterSecurityPlan/Water_Utilization" class="btn btn-danger">
                            Back
                        </a>
                        @*<button class="btn btn-success download1" onclick="ReportPdf();">Download</button>*@
                        <a href="~/WaterSecurityPlan/Wsp_Balance" class="btn btn-primary">
                            Go to Balance
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>


<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {


        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterUtilizationReport.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
    }

</script>

<script>
    var total_domestic = 0, total_irr = 0, total_ind = 0, other_total = 0;
    $(document).ready(function () {
        Info1();
        

    });
    var wb_sw_utilization = 0;
    var wb_gw_utilization = 0;
    var total_utilization = 0;
    function Info1() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/WaterutilizationInfo_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    /*window.location = "/WaterSecurityPlan/Water_Aval_report";*/
                }
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }

                if (response.length != 0) {



                    if (response[0].uti_surface_water != null && response[0].uti_surface_water != "") {
                        $('#irri_utili_surface_water').text(parseFloat(response[0].uti_surface_water).toFixed(2));
                        wb_sw_utilization = parseFloat(response[0].uti_surface_water).toFixed(2);

                    }

                    if (response[0].uti_ground_water != null && response[0].uti_ground_water != "") {
                        $('#irri_utili_ground_water').text(parseFloat(response[0].uti_ground_water).toFixed(2));
                        wb_gw_utilization = parseFloat(response[0].uti_ground_water).toFixed(2);
                    }

                    total_utilization = parseFloat(wb_sw_utilization) + parseFloat(wb_gw_utilization);
                    $('#Irrigated_Total').text(total_utilization.toFixed(2));

                    $('#Irrigated_surfacewater').text(wb_sw_utilization);
                    $('#Irrigated_groundwater').text(wb_gw_utilization);
                    debugger;
                    total_irr = total_utilization;
                    Info12();
                    
                }
            }
        });

    }

    var wb_sw_industry = 0, wb_gw_industry = 0;
    var total_industry = 0;
    function Info12() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterUtilization/Get_industry_ground_surface',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    /*window.location = "/WaterSecurityPlan/Water_Aval_report";*/
                }
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }

                if (response != 0) {
                    var result = response.split(",");
                    var Ground = result[1];
                    var Surface = result[0];

                    $('#industry_demand_surface_water').text(parseFloat(Surface).toFixed(2));


                    $('#industry_demand_ground_water').text(parseFloat(Ground).toFixed(2));


                    total_industry = parseFloat(Ground) + parseFloat(Surface);
                    $('#Industry_Total').text(total_industry.toFixed(2));
                    debugger;
                    total_ind = total_industry;


                }
                Info12_2();
            }
        });

    }
    function Info12_2() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterUtilization/Get_other_ground_surface',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                   /* window.location = "/WaterSecurityPlan/water_Aval_report";*/
                }
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (response != 0) {

                    var result = response.split(",");
                    var Ground = result[1];
                    var Surface = result[0];

                    $('#other_demand_surface_water').text(parseFloat(Surface).toFixed(2));


                    $('#other_demand_ground_water').text(parseFloat(Ground).toFixed(2));


                    total_industry = parseFloat(Ground) + parseFloat(Surface);
                    $('#Other_Total').text(total_industry.toFixed(2));
                    debugger;
                    other_total = total_industry;
                    get_domestic();

                }
            }
        });

    }
    var wb_sw_other = 0, wb_gw_other = 0;
    var total_other = 0;

    function get_domestic() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterUtilization/Fetch_domestic_data",
            dataType: 'JSON',
            success: function (response) {

                if (response.length > 0) {
                    var surface = (parseFloat(response[0].water_dem_hum) + parseFloat(response[0].water_dem_liv)).toFixed(2)
                    var ground = (parseFloat(response[0].water_deman_hum) + parseFloat(response[0].water_deman_liv)).toFixed(2)
                    $("#domestic_demand_surface_water").text(surface);
                    $("#domestic_demand_ground_water").text(ground);
                    $("#Domestic_Total").text((parseFloat(surface) + parseFloat(ground)).toFixed(2));
                    debugger;
                    total_domestic = (parseFloat(surface) + parseFloat(ground));


                    $("#avl_surfacewater").text(surface);
                    $("#avl_groundwater").text(ground);

                    Charts();
                }

            }

        });
    }

    function Charts() {
        debugger;
        Highcharts.chart('container_Water_utilization', {
            chart: {
                type: 'column'
            },
            title: {
                text: ' Water Utilization (ha m)'
            },

            xAxis: {
                type: 'category'
            },
            yAxis: {
                title: {
                    text: '(ha m)'
                }

            },
            colors: [
                '#A0D468',
                '#ED5565',
                '#5D9CEC',
                '#EE82EE'

            ],
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.2f}'
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.2f}</b><br />'
            },

            series: [
                {
                    name: " Water Utilization (ha m)",
                    colorByPoint: true,
                    data: [
                        {
                            name: "Total Drinking /Domestic (ha m)",
                            y: total_domestic,

                        },
                        {
                            name: "Total Irrigated Agriculture (ha m)",
                            y: total_irr,

                        },
                        {
                            name: "Total Industrial Use (ha m)",
                            y: total_ind,

                        },
                        {
                            name: "Total Other Uses (if any) (ha m)",
                            y: other_total,

                        }
                    ]
                }
            ],

        });


    }


</script>
<script>
    function Chart() {
        Highcharts.chart('container_utilization_report', {
            data: {
                table: 'datatable'
            },
            chart: {
                type: 'column'
            },
            title: {
                text: 'Water  Utilization'
            },
            yAxis: {
                allowDecimals: false,
                title: {
                    text: 'Units'
                }
            },
            colors: [
                '#ED5565',
                '#a6c96a'
            ],
            tooltip: {
                formatter: function () {
                    return '<b>' + this.series.name + '</b><br/>' +
                        this.point.y + ' ' + this.point.name.toLowerCase();
                }
            }
        });
    }
</script>

<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demouti2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demouti").innerHTML = today;
</script>