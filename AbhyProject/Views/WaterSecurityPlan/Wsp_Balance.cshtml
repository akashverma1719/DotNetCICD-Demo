<script>
    var access_auth = '';
    $(document).ready(function () {
        access_auth = '@Session["access_auth"]';

        $('[data-toggle="tooltip"]').tooltip();
    });
    $(document).ready(function () {
        $('[data-toggle="tooltip1"]').tooltip();
    });


</script>


<script>
    var StateOfficer = '';
    $(document).ready(function () {
        //get_approved_status();
        $('#Wsp_gram_submit').hide();
        $('#Wsp_gram_checkbox').hide();
        AutoSavedData();
        StateOfficer = '@Session["Officer"]';
        if (StateOfficer != "Gram Panchyat Nodal Officer") {
            $('input[type=text]').prop("disabled", true)
            $('select').prop("disabled", true);
            $('input[type=file]').prop("disabled", true)
            $('.btn_disabled').prop("disabled", true);
        }
         else if (StateOfficer != "" && StateOfficer != null) {

        } else {
              window.location = "/Home/LogOut";
        }
    });


    function AutoSavedData() {
        $(".loader").show();
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/WaterBalanceAutoSaved",
            data: "",
            dataType: 'JSON',
            success: function (response) {
                if (response == "1") {
                    $(".loader").hide();
                    alert("You didn't saved the data, Please click on save button in Water Availability");
                    window.location = "/WaterSecurityPlan/Wsp_Water_Availability";
                } else if (response == "2") {
                    $(".loader").hide();
                    alert("You didn't saved the data, Please click on save button in Drinking/Domestic");
                    window.location = "/WaterSecurityPlan/Water_Utilization";
                } else if (response == "3") {
                    $(".loader").hide();
                    alert("You didn't saved the data, Please click on save button in Irrigation");
                    window.location = "/WaterSecurityPlan/Water_Utilization";
                }
                Info();
            }
        });
    }

    var DPMU_Level_Count = 0;
    function Save_Full_Info() {

        DPMU_Submission();

    }


    function DPMU_Submission() {
        DPMU_Level_Count = 1;

        var verification_val = 0;
        var lfckv = document.getElementById("WspTacker_Verification_CheckBox").checked;

        if (lfckv == true) {
            verification_val = 1;
            DPMU_Level_Count += 1;
        } else {
            verification_val = 0;
            alert("Please Check The data entered has been checked and verified by DPMU");
        }
        var obj = {};
        obj.latitude = lat;
        obj.longitude = long;


            obj.wb_sw_avail = $('#wb_sw_avail').val();


            obj.wb_gw_avail = $('#wb_gw_avail').val();

        obj.wb_sw_utili = $('#wb_sw_utili').val();

        obj.wb_total_avail = $('#wb_total_avail').val();

        obj.wb_gw_utili = $('#wb_gw_utili').val();


        obj.wb_total_utili = $('#wb_total_utili').val();



        obj.wb_sw_balance = $('#wb_sw_balance').val();



        obj.wb_gw_balance= $('#wb_gw_balance').val();


        obj.wb_total_balance = $('#wb_total_balance').val();

        

        if (verification_val == 1 && DPMU_Level_Count == 2) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/WaterSecurityPlan/WaterBalanceInfo__InsertData",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert("Verified Successfully");

                    if (response != "Successfully Saved") {
                        window.location = "/Error/DefaultError";
                    }

                }
            });
        }
        else {
            DPMU_Level_Count = 1;
            Info();
        }
    }



    function get_approved_status() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/get_approved_status",
            dataType: 'JSON',
            success: function (data) {
                
                if (data > 1) {
                    //$('input[type=text]').prop("disabled", true)
                    //$('select').prop("disabled", true);
                    //$('input[type=file]').prop("disabled", true)
                    $('.btn_disabled').prop("disabled", true);
                }
                if (access_auth == "admin") {
                    $('.btn_disabled').prop("disabled", false);
                } else {
                    $('.btn_disabled').prop("disabled", true);
                }
            }
        });
    }


    function SaveInfoSummary() {
        
        $('#SAVE_BTN').prop('disabled', true);
        var obj = {};
        obj.latitude = lat;
        obj.longitude = long;

        var wb_sw_avail = $('#wb_sw_avail').val();
        obj.wb_sw_avail = wb_sw_avail;

        var wb_gw_avail = $('#wb_gw_avail').val();
        obj.wb_gw_avail = wb_gw_avail;

        var wb_sw_utili = $('#wb_sw_utili').val();
        obj.wb_sw_utili = wb_sw_utili;

        var wb_total_avail = $('#wb_total_avail').val();
        obj.wb_total_avail = wb_total_avail;

        var wb_gw_utili = $('#wb_gw_utili').val();
        obj.wb_gw_utili = wb_gw_utili;

        var wb_total_utili = $('#wb_total_utili').val();
        obj.wb_total_utili = wb_total_utili;


        var wb_sw_balance = $('#wb_sw_balance').val();
        obj.wb_sw_balance = wb_sw_balance;


        var wb_gw_balance = $('#wb_gw_balance').val();
        obj.wb_gw_balance = wb_gw_balance;

        var wb_total_balance = $('#wb_total_balance').val();
        obj.wb_total_balance = wb_total_balance;

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/WaterBalanceInfo__InsertData_new",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                $('#SAVE_BTN').prop('disabled', false);
                $('#ERRor1').text(response);
                window.location = '/WaterSecurityPlan/Balance_Report'
            }
        });
    }
</script>




