                    <div class="container-fluid">
                        <div class="col-lg-offset-1 col-md-12 col-sm-12 col-lg-10 col-lg-offset-1 form-body1">
                            <div class="form-div">
                                <div class="col-md-12 background-border-Database background-border-Database1">
                                    <div class="row database_trainer_row">
                                        <h2>
                                            Water Balance
                                        </h2>
                                    </div>
                                    <div class="row database_trainer_row database_trainer_row1">
                                        <h3>
                                            Water Availability (ha m)
                                        </h3>
                                    </div>

                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">
                                                Total Ground Water Available:  <a href="javascript:;" data-toggle="tooltip" title="Auto Fetched From Water Availability Module From Point no. 2 Ground Water f. Total Ground Water Available (ha m)">
                                                    <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                                </a>
                                            </label>
                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="text" id="wb_gw_avail" class="form-control" name="" placeholder="Enter ground water.." readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">
                                                Total Surface Water Available :<a href="javascript:;" data-toggle="tooltip" title="Auto Fetched From Water Availability Module From Point no. 3 Surface Water c. Total Surface Water Available (ha m)">
                                                    <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                                </a>
                                            </label>
                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="text" id="wb_sw_avail" class="form-control" name="" placeholder="Enter surface water.." readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">
                                                Total Water Availability: <a href="javascript:;" data-toggle="tooltip" title="(Total Water Availability = Total Ground Water Available + Total Surface Water Available)">
                                                    <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                                </a>
                                            </label>

                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_total_avail" class="form-control" name="" placeholder="Total Availability" readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row database_trainer_row1">
                                        <h3>
                                            Water Utilization (ha m)
                                        </h3>
                                    </div>

                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">Total Ground Water Utilization:</label>
                                            <a href="javascript:;" data-toggle="tooltip" title="Auto Fetched From Water Utilization Module = {[Drinking/Domestic- fetched from table column Name- Water Demand Met From Ground Water (ha m)]+[irrigation- fetched from Utilization From Ground Water (ha m)]+[Industrial-fetched from table column Name- total of Water Demand met from Ground water (ha m)]+[Other- fetched from table column Name- total of Water Demand met from Ground Water (ha m)]}">
                                                <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                            </a>
                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_gw_utili" class="form-control" name="" placeholder="Ground Water " readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">
                                                Total Surface Water Utilization:<a href="javascript:;" data-toggle="tooltip" title="Auto Fetched From Water Utilization Module = {[Drinking/Domestic- fetched from table column Name- Water Demand Met From Surface Water (ha m)]+[irrigation- fetched from Utilization From Surface Water (ha m)]+[Industrial-fetched from table column Name- total of Water Demand met from Surface water (ha m)]+[Other- fetched from table column Name- total of Water Demand met from Surface Water (ha m)]}">
                                                    <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                                </a>
                                            </label>

                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_sw_utili" class="form-control" name="" placeholder="Surface Water.." readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">
                                                Total Water Utilization : <a href="javascript:;" data-toggle="tooltip" title="Utilization Surface Water + Utilization Ground Water ">
                                                    <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                                </a>
                                            </label>

                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_total_utili" class="form-control" name="" placeholder="Total Utilization" readonly>
                                        </div>
                                    </div>

                                    <div class="row database_trainer_row database_trainer_row1">
                                        <h3>
                                            Balance [Surplus (+) / Deficit (-)] (ha m)
                                        </h3>
                                    </div>

                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">Total Ground Water Balance:</label>
                                            <a href="javascript:;" data-toggle="tooltip" title="(Total Ground Water Balance = Total Ground Water Available - Total Ground Water Utilization )">
                                                <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                            </a>
                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_gw_balance" class="form-control" name="" placeholder="Ground Water " readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">Total Surface Water Balance:</label>
                                            <a href="javascript:;" data-toggle="tooltip" title="(Total Surface Water Balance = Total Surface Water Available -  Total Surface Water Utilization)">
                                                <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                            </a>
                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_sw_balance" class="form-control" name="" placeholder="Surface Water.." readonly>
                                        </div>
                                    </div>
                                    <div class="row database_trainer_row">
                                        <div class="col-md-4 col-sm-4">
                                            <label for="lname">Total Water Balance:</label>
                                            <a href="javascript:;" data-toggle="tooltip" title=" (Total Water Balance = Total Ground Water Balance + Total Surface Water Balance) ">
                                                <span class="glyphicon glyphicon-info-sign" style="color:blue;" aria-hidden="true"></span>
                                            </a>
                                        </div>
                                        <div class="col-md-7 col-sm-8">
                                            <input type="number" id="wb_total_balance" class="form-control" name="" placeholder="Total value" readonly>
                                        </div>
                                    </div>

                                    <div id="Wsp_gram_checkbox" style="text-align:center"><input type="checkbox" id="WspTacker_Verification_CheckBox" /><span>The data entered has been checked and verified by DPMU</span></div>

                                    <div class="row database_trainer_row_button">
                                        <div class="col-md-12 col-sm-12 text-center">
                                            <div>
                                                <span style="color:red;font-size:15px;">Before going to the summary page or next, click on the save button</span>
                                            </div>
                                            <a href="~/WaterSecurityPlan/Water_Draft_report" class="btn btn-danger">
                                                Back
                                            </a>
                                            <button class="btn btn-success btn_disabled" id="SAVE_BTN" onclick="SaveInfo()">Save</button>
                                            <button class="btn btn-danger" id="Wsp_gram_submit" onclick="Save_Full_Info()">Submit</button>


                                            <a href="javascript:void(0);" onclick="SaveInfoSummary()" class="btn btn-primary">Summary</a>
                                        </div>
                                    </div>

                                    <div style="color:red;text-align:center;"><label id="ERRor1"></label></div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div id="progress">
            <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
                <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                    <span class="progress-group-label" data-target="#music" data-toggle="tab">Water Balance</span>
                    <div class="tri shadow"></div>
                    <div class="tri"></div>
                </li>
            </ul>
        </div>
    </div>
</div>

