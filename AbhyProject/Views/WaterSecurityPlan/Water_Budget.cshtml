<script>
    function SaveInfo11() {
        var human_a_pop = $('#human_a_pop').val();
        var live_a_pop = $('#live_a_pop').val();
        var gw_proposed_share = $('#gw_proposed_share').val();
        if (human_a_pop == "") {
            alert("Please Enter Annual population growth rate in % (r)");
            $('#human_a_pop').focus();
            return;
        } else if (live_a_pop == "") {
            alert("Please Enter Annual population growth rate in % (r)");
            $('#live_a_pop').focus();
            return;
        } else if (gw_proposed_share == "") {
            alert("Please Enter Proposed share to be met from Ground water (in % )");
            $('#gw_proposed_share').focus();
            return;
        }
        $('#SAVE_BTN').prop('disabled', true);
        var obj = {};
        obj.latitude = lat;
        obj.longitude = long;
        obj.human_p_pop = $('#human_p_pop').val();
        obj.human_a_pop = $('#human_a_pop').val();
        obj.human_no_of_year = $('#human_no_of_year').val();
        obj.human_pre_pop = $('#human_pro_pop').val();
        obj.human_per_capita = $('#human_per_capita').val();
        obj.human_pro_water_req = $('#human_pro_water_req').val();
        obj.live_p_pop = $('#live_p_pop').val();
        obj.live_a_pop = $('#live_a_pop').val();
        obj.live_no_of_year = $('#live_no_of_year').val();
        obj.live_pro_pop = $('#live_pro_pop').val();
        obj.live_pre_capita = $('#live_per_capita').val();
        obj.live_pro_water_req = $('#live_pro_water_req').val();
        obj.total_pro_water_req = $('#total_pro_water_req').val();
        obj.proposed_share_gw = $('#gw_proposed_share').val();
        obj.proposed_share_sw = $('#sw_proposed_share').val();
        obj.demand_gw = $('#gw_demand').val();
        obj.demand_sw = $('#sw_demand').val();
        obj.surface_water = $('#surface_water').val();
        obj.ground_water = $('#ground_water').val();
        obj.total_wt_available = $('#total_water').val();
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/WaterBudgetInfo__InsertData",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                $('#SAVE_BTN').prop('disabled', false);
                $('#ERRor1').text(response);
                if (response != "Successfully Saved") {
                    // window.location = "/Error/DefaultError";
                }
            }
        });
    }



</script>
<script type='text/javascript'>
    var point = false;
    var count = 0;
    function check(e, value) {

        //Check Charater
        
        if (count == 3) return false;
        var unicode = e.charCode ? e.charCode : e.keyCode;

        if (unicode == 46 && point == true)
            return false;
        if (unicode == 46 && point == false) {
            point = true;
        }
        if (unicode != 8) if ((unicode < 48 || unicode > 57) && unicode != 46) return false;
        if (point == true) count++;
    }
    function checkLength() {
        
        var fieldVal = document.getElementById('gw_proposed_share').value;
        //Suppose u want 3 number of character
        if (fieldVal <= 100) {
            return true;
        }
        else {
            var str = document.getElementById('gw_proposed_share').value;
            str = str.substring(0, str.length - 1);
            document.getElementById('gw_proposed_share').value = str;
        }
    }
    // VALIDATION FOR PERCENTAGE VALUE
    function check_percentage() {
        
        var gw_proposed_share = $("#gw_proposed_share").val();
        if (gw_proposed_share >= 100) {
            $("#gw_proposed_share").val("");
        }
    }
    // Decimal Validation
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }


    function get_approved_status() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/get_approved_status",
            dataType: 'JSON',
            success: function (data) {
                

                @* status_id = @ViewBag.status_id;
                alert(status_id) *@
                if (data > 1) {
                    $('input[type=text]').prop("disabled", true)
                    //$('select').prop("disabled", true);
                    //$('input[type=file]').prop("disabled", true)
                    $('.btn_disabled').prop("disabled", true);
                }
                if (access_auth == "admin") {
                    $('input[type=text]').prop("disabled", false)

                    $('.btn_disabled').prop("disabled", false);
                } else {
                    $('input[type=text]').prop("disabled", true)
                    
                    $('.btn_disabled').prop("disabled", true);
                }
            }
        });
    }


    
</script>
