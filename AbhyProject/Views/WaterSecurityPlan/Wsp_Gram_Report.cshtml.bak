
@{

    Layout = null;
}
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>WSP</title>
    <style>
        html,
        body,
        #viewDiv {
            padding: 0;
            margin: 0;
            height: 100%;
            width: 100%;
        }

        html,
        body,
        #viewDiv1 {
            padding: 0;
            margin: 0;
            height: 100%;
            width: 100%;
        }
    </style>
    <link rel="stylesheet" href="https://js.arcgis.com/4.27/esri/themes/light/main.css" />
    <script src="https://jsdev.arcgis.com/4.27/"></script>

    <script type="text/plain" id="labeid">
        var field = $feature.Gram_Panchayat_Name;
        var queryArc = Trim(First(Split(DomainName($feature, 'Gram_Panchayat_Name'),'_')));

        return queryArc ;
    </script>

    @*---------Water Level Map View-----------*@
    <script>
        require([
            "esri/Map",
            "esri/views/MapView",
            "esri/widgets/Home",
            "esri/layers/FeatureLayer",
            "esri/rest/support/Query",
            "esri/layers/support/FeatureEffect",
            "esri/layers/support/FeatureFilter",


        ], function (Map, MapView, Home, FeatureLayer, Query, FeatureEffect, FeatureFilter) {

            var map = new Map({
                basemap: "gray-vector"
            });

            const view = new MapView({
                container: "viewDiv",
                map: map,
                center: [78, 22],

                zoom: 16,
                highlightOptions: {
                    color: "orange"
                },
                popup: {
                    dockEnabled: true,
                    dockOptions: {
                        buttonEnabled: false,
                        breakpoint: false
                    }
                },
                // minScale: 900000,
                // maxScale: 900000,

            });
            //const homeBtn = new Home({
            //    view: view
            //});
            //view.ui.add(homeBtn, "top-left");
            view.when(disableZooming);

        function disableZooming(view) {
          // Removes the zoom action on the popup
          view.popup.actions = [];

          // stops propagation of default behavior when an event fires
          function stopEvtPropagation(event) {
            event.stopPropagation();
          }

          // exlude the zoom widget from the default UI
          view.ui.components = ["attribution"];

          // disable mouse wheel scroll zooming on the view
          view.on("mouse-wheel", stopEvtPropagation);

          // disable zooming via double-click on the view
          view.on("double-click", stopEvtPropagation);

          // disable zooming out via double-click + Control on the view
          view.on("double-click", ["Control"], stopEvtPropagation);

          // disables pinch-zoom and panning on the view
          view.on("drag", stopEvtPropagation);

          // disable the view's zoom box to prevent the Shift + drag
          // and Shift + Control + drag zoom gestures.
          view.on("drag", ["Shift"], stopEvtPropagation);
          view.on("drag", ["Shift", "Control"], stopEvtPropagation);

          // prevents zooming with the + and - keys
          view.on("key-down", (event) => {
            const prohibitedKeys = [
              "+",
              "-",
              "Shift",
              "_",
              "=",
              "ArrowUp",
              "ArrowDown",
              "ArrowRight",
              "ArrowLeft"
            ];
            const keyPressed = event.key;
            if (prohibitedKeys.indexOf(keyPressed) !== -1) {
              event.stopPropagation();
            }
          });

          return view;
        }

            const excludedEffect = "grayscale(100%) opacity(10%)";
            const gwlLabel = {
                type: "simple", // autocasts as new SimpleRenderer()
                symbol: {
                    type: "simple-marker", // autocasts as new SimpleMarkerSymbol()
                    size: 5,
                    color: "green",
                    outline: null
                }
            };

            const labellingID = document.getElementById("labeid").text;
            const labelClass = {  // autocasts as new LabelClass()
                symbol: {
                    type: "text",  // autocasts as new TextSymbol()
                    color: "blue",
                    //   haloColor: "black",
                    //   haloSize: 1,
                    font: {  // autocast as new Font()
                        "family": "Avenir Next LT Pro Medium",
                        "style": "normal",
                        "weight": "bold",
                        size: 9,
                    }
                },
                labelPlacement: "always-horizontal",
                labelExpressionInfo: {
                    expression: labellingID
                },
            };
            const labelClassgwl = {  // autocasts as new LabelClass()
                symbol: {
                    type: "text",  // autocasts as new TextSymbol()
                    color: "green",
                    //   haloColor: "black",
                    //   haloSize: 1,
                    font: {  // autocast as new Font()
                        "family": "Avenir Next LT Pro Medium",
                        "style": "normal",
                        size: 7,
                    }
                },
                labelPlacement: "above-right",
                labelExpressionInfo: {
                    expression: "$feature.wellid"
                },
            };
            var gramPan = new FeatureLayer({
                url: "https://ataljal-arcgis.mowr.gov.in/ajserver/rest/services/Mobile/Map1tt/MapServer/1",

                title: "Gram Panchayat",
                labelingInfo: [labelClass],
                renderer: {
                    type: "simple",
                    symbol: {
                        type: "simple-fill",
                        color: null,
                        outline: {
                            width: 1,
                            color: "blue"
                        }
                    }
                },

                popupTemplate: {
                    title: "Gram Panchayat :- {Gram_Panchayat_Name}",
                    content: [
                        {
                            type: "fields",
                            fieldInfos: [
                                {
                                    fieldName: "Gram_Panchayat_Name",
                                    visible: true,
                                    label: "Gram Panchayat",
                                    format: {
                                        places: 0,
                                        digitSeparator: true
                                    }
                                },
                                {
                                    fieldName: "Block_Name",
                                    visible: true,
                                    label: "Block Name"
                                },
                                {
                                    fieldName: "District_Name",
                                    visible: true,
                                    label: "District Name"
                                },
                                {
                                    fieldName: "State_Name",
                                    visible: true,
                                    label: "State Name"
                                },
                                {
                                    fieldName: "Count_of_Villages_Under_GPs",
                                    visible: true,
                                    label: "Count_of_Villages_Under_GPs"
                                },
                            ]
                        },
                    ]
                },
                outFields: ["*"],
            });

            map.add(gramPan);
            var gp = '@Session["ggram"]';

            view.whenLayerView(gramPan).then(function (layerView) {
                var query = gramPan.createQuery();
                query.where = "Gram_Panchayat_Name = '" + gp + "'";
                gramPan.queryExtent(query).then(function (results) {
                    view.goTo(results.extent);  // go to the extent of all the graphics in the layer view
                });
            });
            gramPan.featureEffect = new FeatureEffect({
                filter: new FeatureFilter({
                    where: "Gram_Panchayat_Name = '" + gp + "'"
                }),
                excludedEffect: excludedEffect

            });
            var gwl = new FeatureLayer({
                url: "https://ataljal-arcgis.mowr.gov.in/ajserver/rest/services/Ataljal/WaterLevelView/MapServer/0",
                renderer: gwlLabel,
                labelingInfo: [labelClassgwl],
            });
            map.add(gwl);
            gwl.featureEffect = new FeatureEffect({
                filter: new FeatureFilter({
                    where: "grampanchayat  = '" + gp + "'"
                }),
                excludedEffect: excludedEffect
            });

        });
    </script>


    @*---------Water Quality Map View-----------*@
    <script>
        require([
            "esri/Map",
            "esri/views/MapView",
            "esri/layers/FeatureLayer",
            "esri/rest/support/Query",
            "esri/layers/support/FeatureEffect",
            "esri/layers/support/FeatureFilter",
        ], function (Map, MapView, FeatureLayer, Query, FeatureEffect, FeatureFilter) {

            var map = new Map({
                basemap: "gray-vector"
            });

            const view = new MapView({
                container: "viewDiv1",
                map: map,
                center: [78, 22],

                zoom: 16,
                highlightOptions: {
                    color: "orange"
                },
                popup: {
                    dockEnabled: true,
                    dockOptions: {
                        buttonEnabled: false,
                        breakpoint: false
                    }
                },
                // minScale: 900000,
                // maxScale: 900000,
            });
             view.when(disableZooming);
        function disableZooming(view) {
          // Removes the zoom action on the popup
          view.popup.actions = [];

          // stops propagation of default behavior when an event fires
          function stopEvtPropagation(event) {
            event.stopPropagation();
          }

          // exlude the zoom widget from the default UI
          view.ui.components = ["attribution"];

          // disable mouse wheel scroll zooming on the view
          view.on("mouse-wheel", stopEvtPropagation);

          // disable zooming via double-click on the view
          view.on("double-click", stopEvtPropagation);

          // disable zooming out via double-click + Control on the view
          view.on("double-click", ["Control"], stopEvtPropagation);

          // disables pinch-zoom and panning on the view
          view.on("drag", stopEvtPropagation);

          // disable the view's zoom box to prevent the Shift + drag
          // and Shift + Control + drag zoom gestures.
          view.on("drag", ["Shift"], stopEvtPropagation);
          view.on("drag", ["Shift", "Control"], stopEvtPropagation);

          // prevents zooming with the + and - keys
          view.on("key-down", (event) => {
            const prohibitedKeys = [
              "+",
              "-",
              "Shift",
              "_",
              "=",
              "ArrowUp",
              "ArrowDown",
              "ArrowRight",
              "ArrowLeft"
            ];
            const keyPressed = event.key;
            if (prohibitedKeys.indexOf(keyPressed) !== -1) {
              event.stopPropagation();
            }
          });

          return view;
        }
            const excludedEffect = "grayscale(100%) opacity(10%)";
            const gwlLabel = {
                type: "simple", // autocasts as new SimpleRenderer()
                symbol: {
                    type: "simple-marker", // autocasts as new SimpleMarkerSymbol()
                    size: 5,
                    color: "green",
                    outline: null
                }
            };
            const labellingID = document.getElementById("labeid").text;
            const labelClass = {  // autocasts as new LabelClass()
                symbol: {
                    type: "text",  // autocasts as new TextSymbol()
                    color: "blue",
                    //   haloColor: "black",
                    //   haloSize: 1,
                    font: {  // autocast as new Font()
                        "family": "Avenir Next LT Pro Medium",
                        "style": "normal",
                        "weight": "bold",
                        size: 9,
                    }
                },
                labelPlacement: "always-horizontal",
                labelExpressionInfo: {
                    expression: labellingID
                },
            };
            const labelClassgwl = {  // autocasts as new LabelClass()
                symbol: {
                    type: "text",  // autocasts as new TextSymbol()
                    color: "green",
                    //   haloColor: "black",
                    //   haloSize: 1,
                    font: {  // autocast as new Font()
                        "family": "Avenir Next LT Pro Medium",
                        "style": "normal",
                        "weight": "bold",
                        size: 9,
                    }
                },
                labelPlacement: "above-right",
                labelExpressionInfo: {
                    expression: "$feature.well_id"
                },
            };
            var gramPan = new FeatureLayer({
                url: "https://ataljal-arcgis.mowr.gov.in/ajserver/rest/services/Mobile/Map1tt/MapServer/1",
                title: "Gram Panchayat",
                labelingInfo: [labelClass],
                renderer: {
                    type: "simple",
                    symbol: {
                        type: "simple-fill",
                        color: null,
                        outline: {
                            width: 1,
                            color: "blue"
                        }
                    }
                },
                popupTemplate: {
                    title: "Gram Panchayat :- {Gram_Panchayat_Name}",
                    content: [
                        {
                            type: "fields",
                            fieldInfos: [
                                {
                                    fieldName: "Gram_Panchayat_Name",
                                    visible: true,
                                    label: "Gram Panchayat",
                                    format: {
                                        places: 0,
                                        digitSeparator: true
                                    }
                                },


                                {
                                    fieldName: "Block_Name",
                                    visible: true,
                                    label: "Block Name"
                                },

                                {
                                    fieldName: "District_Name",
                                    visible: true,
                                    label: "District Name"
                                },

                                {
                                    fieldName: "State_Name",
                                    visible: true,
                                    label: "State Name"
                                },

                                {
                                    fieldName: "Count_of_Villages_Under_GPs",
                                    visible: true,
                                    label: "Count_of_Villages_Under_GPs"
                                },
                            ]
                        },
                    ]
                },
                outFields: ["*"],
            });
            map.add(gramPan);
            var gp = '@Session["ggram"]';
            view.whenLayerView(gramPan).then(function (layerView) {
                var query = gramPan.createQuery();
                query.where = "Gram_Panchayat_Name = '" + gp + "'";
                gramPan.queryExtent(query).then(function (results) {
                    view.goTo(results.extent);  // go to the extent of all the graphics in the layer view
                });
            });
            gramPan.featureEffect = new FeatureEffect({
                filter: new FeatureFilter({
                    where: "Gram_Panchayat_Name = '" + gp + "'"
                }),
                excludedEffect: excludedEffect

            });
            var gwq = new FeatureLayer({
                url: "https://ataljal-arcgis.mowr.gov.in/ajserver/rest/services/Ataljal/wlwqgdb/MapServer/0",
                renderer: gwlLabel,
                labelingInfo: [labelClassgwl],
            });
            map.add(gwq);
            gwq.featureEffect = new FeatureEffect({
                filter: new FeatureFilter({
                    where: "gp  = '" + gp + "'"
                }),
                excludedEffect: excludedEffect

            });
        });
    </script>
</head>
<body>

</body>
</html>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="~/Scripts/all_scripts/bootstrap_3.4.0.min.js"></script>
<script src="~/Scripts/all_scripts/highcharts.js"></script>
<script src="~/Scripts/all_scripts/data.js"></script>
<script src="~/Scripts/all_scripts/drilldown.js"></script>
<script src="~/Scripts/all_scripts/exporting.js"></script>
<script src="~/Scripts/all_scripts/export-data.js"></script>
<meta name="viewport" content="width=device-width" />
<title>Gram Panchayat Report</title>
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<!--favicon end-->
<!-- jQuery library -->
<!-- Latest compiled JavaScript -->
<link href="/Scripts/all_scripts/bootstrap.min.css" rel="stylesheet" />

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/css/wsp_report_css.css" rel="stylesheet" />

<script src="~/Content/JS_Files/IdealState.js"></script>
<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }

        .loader > img {
            top: 45%;
            left: 45%;
            position: fixed;
            height: 150px;
            width: 150px;
        }

    .reportheading {
        color: #337ab7;
        font-size: 25px;
        font-weight: bold;
    }

    .dateandtime_ul {
        padding: 0px;
    }

    .hideDownload {
        display: none;
    }

    .background_after_download * {
        font-weight: normal !important;
        text-decoration: none !important;
        text-shadow: none !important;
    }

    .dateandtime_ul > li {
        display: inline-block;
        color: #000;
        font-size: 18px;
        padding: 0px 15px;
    }

    .tablebaody input {
        text-transform: capitalize;
    }

    .tableheadingbg {
        color: #337ab7 !important;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        background: #fff;
    }

    .row {
        margin: 0px;
    }

    .colorline1 {
        background: #ddd;
        background-size: 100% 6px;
        background-position: 50% 100%;
        background-repeat: no-repeat;
        text-align: center;
        margin-top: 12px;
        height: 3px;
        width: 100%
    }

    .col-md-9 > h1 {
        font-weight: bold;
        color: #404040;
        text-shadow: -1px -1px #000;
    }

    .col-md-9 > p {
        color: #404040;
    }

    .col12 > .firsttable > h6 {
        letter-spacing: 0px;
        padding-left: 10px;
    }

    .firstptag {
        padding-left: 4%;
    }

    body {
        background-color: #ddd;
    }

    .clearfixcolor {
        margin-top: 15px;
    }

    .col12 {
        background-color: #fff;
        padding: 25px;
    }

    .highcharts-credits {
        display: none;
    }



    .highcharts-button-box {
        display: none;
    }


    .text-right > .btn-success {
        margin-top: 20px;
        font-weight: bold;
    }

    .text-right {
        padding: 5px;
    }

        .text-right > .btn-success {
            padding: 8px 20px 8px 20px;
            border-radius: 50px;
            font-size: 18px;
        }

    .btn-success {
        color: #fff;
        background-color: #6fb01d;
        border-color: #4cae4c;
    }

    .coll7 {
        padding-right: 0px;
    }


    ul.Select_option {
        list-style: none;
        display: block;
        padding: 0px 0px 0px 0px;
        font-size: 12px;
        margin: 0px;
    }

        ul.Select_option > li {
            display: inline-block;
            padding: 0px 0px 0px 46px;
            word-spacing: 1px;
            text-transform: uppercase;
        }

            ul.Select_option > li > span > i {
                padding: 0px 0px 0px 10px;
            }

    #Select_dist_level {
        padding: 10px 0px 5px 15px;
        text-transform: capitalize;
    }

    ul.firstimages {
        display: block;
        margin-bottom: 0px;
        padding: 0px;
    }

        ul.firstimages > li {
            display: inline-block;
            padding-left: 5px;
            border: 1px solid #ddd;
            padding: 10px 10px 5px 10px;
        }

            ul.firstimages > li > img {
                border-left: 2px solid #ddd;
            }

            ul.firstimages > li > span > img {
                width: 25px;
                height: 25px;
            }

    .highcharts-title {
        font-weight: bold;
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
        font-size: 13px;
    }

    tspan {
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    }

    /*  .firsttable {
        display: table-cell;
    }*/

    .secondtable {
        /* display: table-cell;*/
        text-align: right;
    }

    sup {
        font-weight: bold;
    }

    .tableheadingbg > span {
        color: purple;
        font-size: 20px;
    }

    #Data1 {
        background-color: #fff;
    }

    .firsttable {
        padding: 10px 0px 0px 0px;
    }

    .report_heading_div {
        background-color: #ddd;
        border-radius: 10px;
        padding: 10px;
    }

    .cololr-div {
        background: #4cae4c;
        height: 3px;
        padding: 0px;
    }

    .last-div-footer {
        padding: 10px 0px;
    }
</style>
<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<div class="container" id="Data1">
    <div class="row row_padding_10">
        <div class="col-md-12 ">
            <div class="firsttable col-md-12">
                <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
            </div>
        </div>

        <div class="col-md-12 report_heading_div">
            <div class="col-md-9">
                <h2>Gram Panchayat (Basic Hydrology Info) Report </h2>
            </div>
            <div class="col-md-3 text-right" id="btnExport">
                <button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>
            </div>
            <div class="col-md-12">
                <ul class="dateandtime_ul">
                    <li>Date : <span id="demogram"></span></li>
                    <li>Time : <span id="demogram2"></span></li>
                    <li>
                        Username:
                        @if (Session["UserName"] != null)
                        {
                            <span>@Session["UserName"].ToString()</span>
                        }
                    </li>
                </ul>
            </div>
        </div>


        <div class="col-md-12 state_dist_level">
            <div class="row" id="Select_dist_level">
                <ul class="Select_option">
                    @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                    {

                        <li>
                            <label id="lblstate">State:</label>
                            <span id="spnstate">@Session["gstate"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                    {
                        <li>
                            <label id="lblstate">Admin</label>

                        </li>
                    }
                    else
                    {
                        <li>
                            <label id="lblstate">National Level Nodal Officer</label>

                        </li>
                    }


                    @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                    {
                        <li>

                            <label id="lbldistrict">District:</label>
                            <span id="spndistrict">@Session["gdist"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>

                    }

                    @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                    {
                        <li>

                            <label>Block:</label>
                            <span id="spnblock">@Session["gblock"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                    {
                        <li>

                            <label>Gram panchayat:</label>
                            <span id="spngram">@Session["ggram"]</span>

                        </li>
                    }
                    @if (Session["Year"] != null && Session["Year"].ToString() != "null" && Session["Year"].ToString() != "")
                    {
                        <li>

                            <label>Year:</label>
                            <span id="Year">@Session["Year"]</span>

                        </li>
                    }
                    @*@if (Session["month"] != null && Session["month"].ToString() != "null" && Session["month"].ToString() != "")
                        {
                            <li>

                                <label>Month:</label>
                                <span id="month">@Session["month"]</span>

                            </li>
                        }*@

                </ul>
            </div>

        </div>
        <div class=" col-md-12 col-sm-12">
            <div id="resetinfo" class="tbl-responsive" style="overflow-x:scroll">
                <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                    <thead>
                        <tr>
                            <th colspan="4">
                                Gram Panchayat (Basic Hydrology Info)
                            </th>
                        </tr>
                    </thead>
                    <tbody class="tablebaody">

                        <tr>
                            <td>State:</td>
                            <td>
                                <label id="state_name"></label>
                            </td>
                            <td>District:</td>
                            <td>
                                <label id="district_name"></label>
                                @*<input type="text" class="form-control decimal" id="district_name" placeholder="Enter the numeric value" />*@
                            </td>
