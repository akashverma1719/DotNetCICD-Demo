<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDgurNrZ8JU8NiUs9bleClqbVul6VR5u4s&callback=initMap" async defer></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
<script>
    function myMap(lat, long) {

        myCenter = new google.maps.LatLng(lat, long);
        var mapOptions = {
            center: myCenter,
            zoom: 10, scrollwheel: false, draggable: false,
            // mapTypeId: google.maps.MapTypeId.ROADMAP
        };
        var map = new google.maps.Map(document.getElementById("map"), mapOptions);

        var marker = new google.maps.Marker({
            position: myCenter,
            //title: "The Church",
        });
        marker.setMap(map);
    }
    function gpimagesgeting_Location() {
        debugger;
        var state = $('#spnstate').text();
        var dist = $('#spndistrict').text();
        var block = $('#spnblock').text();
        var gram = $('#spngram').text();
        var obj = {};
        obj.state_name = state;
        obj.district_name = dist;
        obj.block_name = block;
        obj.gpname = gram;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/MapImagesdetails1',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                //alert(data.length);
                $("#loaction_map_geting").html("");
                $("#Drainage_map_geting").html("");
                $("#Aquifer_map_geting").html("");
                $("#Watershed_map_geting").html("");
                var i = 0;
                var tr = '';
                if (data.length != 0) {
                    //alert('imagegetting');
                    for (var i = 0; i < data.length; i++) {
                        tr += '<tr><td></td></tr > ';
                        tr += '<tr> <th colspan="4" style="background-color: #ddd; text-align: center;">Location Map</th></tr > ';
                        tr += '<tr><td><label><a href="' + data[i].gpimage1 + '" target="_blank"><img src="' + data[i].gpimage1 + '" style="width: 100%;"/></a></label></td></tr>';
                        tr += '<tr><th colspan="4" style="background-color: #ddd; text-align: center;">Watershed Map</th></tr>';
                        tr += '<tr><td><label><a href="' + data[i].gpimage2 + '" target="_blank"><img src="' + data[i].gpimage2 + '"style="width: 100%;"/></a></label></td></tr>';
                        tr += '<tr><th colspan="4" style="background-color: #ddd; text-align: center;">Aquifer Map</th></tr>';
                        tr += '<tr><td><label><a href="' + data[i].gpimage3 + '" target="_blank"><img src="' + data[i].gpimage3 + '" style="width: 100%;"/></a></label></td></tr>';

                    }
                    $('#image_div').append(tr);
                    get_map();
                }

            }

        });
    }
        function ReportPdf() {

        $("#Data1").width(1110);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'Gram_Panchayat_Report.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
            $("#Data1").width();
            $('#Data1').addClass('background_after_download');
            $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
            $('div#btnExport').addClass('hideDownload');
            $('div#btnExport1').addClass('hideDownload');
            $('div.main_heading_pgwm').addClass('main_heading_pgwm1');
            $('div.main_heading_sm').addClass('main_heading_sm1');
            $('div.main_heading_pgwm_change').addClass('main_heading_pgwm_change1');

            setTimeout(function () {
                $('#Data1').removeClass('background_after_download');
                $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
                $('div#btnExport').removeClass('hideDownload');
                $('div#btnExport1').removeClass('hideDownload');
                $('div.main_heading_pgwm').removeClass('main_heading_pgwm1');
                $('div.main_heading_sm').removeClass('main_heading_sm1');
                $('div.main_heading_pgwm_change').removeClass('main_heading_pgwm_change1');
            }, 2000);
    }


     var State = "";
    var Dist ="";
    var Block ="";
    var Gram="";
    $(document).ready(function () {
        $('.Loader').show();
         State = '@Session["gstate"]';
     Dist ='@Session["gdist"]';
     Block ='@Session["gblock"]';
        Gram ='@Session["ggram"]';
        $('#state_name').text(State);
        $('#district_name').text(Dist);
        $('#block_name').text(Block);
        $('#gram_panchayat_name').text(Gram);
        Details();
        WaterLevelWSP()
        $('#div_soc_mngt').hide();
        $('#div_pgwm').hide();


    });
    function Details() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/GrampanchayatDetails',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Error") {
                    window.location = "/WaterSecurityPlan/WSp_Gram_Report";
                }
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (data.length != 0) {
                    var sub_basin_name = data[0].sub_basin_name;
                    if (sub_basin_name == "Other") {
                        sub_basin_name = data[0].sub_basin_name + " - " + data[0].other_sub_basin_name;
                    } else if (sub_basin_name == "0") {
                        sub_basin_name = "";
                    }
                    var basin_name = data[0].basin_name;
                    if (basin_name == "Other") {
                        basin_name = data[0].basin_name + " - " + data[0].other_basin_name;
                    }

                    $('#gp_id').text(data[0].gp_id);
                    if (data[0].block_area != null) {
                        $('#block_area').text(parseFloat(data[0].block_area).toFixed(2));
                    }
                    if (data[0].gp_area != null) {
                        $('#gp_area').text(parseFloat(data[0].gp_area).toFixed(2));
                    }
                    $('#watershed_code').text(data[0].watershed_code);

                    $('#watershed_name').text(data[0].watershed_name);
                    $('#watershed_area_block').text(data[0].watershed_area_block);
                    $('#sub_basin_code').text(data[0].sub_basin_code);
                    $('#sub_basin_name').text(sub_basin_name);

                    $('#basin_name').text(basin_name);
                    $('#basin_code').text(data[0].basin_code);


                }

                $('.Loader').hide();
                gpimagesgeting_Location();
            }
        });
    }


    function get_map() {
        debugger;
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/Get_gp_block_area',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                if (data.length > 0) {
                    Lat = parseFloat(data[0].latitude);
                    Long = parseFloat(data[0].longitude);
                    $(".loader").hide();
                    myMap(Lat, Long);
                }

            }
        });
    }

