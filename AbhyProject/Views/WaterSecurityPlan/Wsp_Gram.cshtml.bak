    function enforceNumberValidation(ele) {

        if ($(ele).data('decimal') != null) {
            // found valid rule for decimal
            var decimal = parseInt($(ele).data('decimal')) || 0;
            var val = $(ele).val();
            if (decimal > 0) {
                var splitVal = val.split('.');
                if (splitVal.length == 2 && splitVal[1].length > decimal) {
                    // user entered invalid input
                    $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                }
            } else if (decimal == 0) {
                // do not allow decimal place
                var splitVal = val.split('.');
                if (splitVal.length > 1) {
                    // user entered invalid input
                    $(ele).val(splitVal[0]); // always trim everything after '.'
                }
            }
        }
    }



    function save_Location_map_Image_Uplaod() {

        State = '@Session["gstate"]';
        Dist ='@Session["gdist"]';
        Block ='@Session["gblock"]';
        Gram = '@Session["ggram"]';
        Year = '@Session["year"]';

        var state_name = State;
        var district_name = Dist;
        var block_name = Block;
        var gpname = Gram;
        var year = Year;
        var files = $('#Location_map_Image_Uplaod')[0].files;

        //Get_month_order(month);
        //var month_order_by = month_order;

        $.ajax({
            type: "POST",
            url: "/WaterSecurityPlan/Location_map_Image_Uplaod",
            data: function () {
                var data = new FormData();
                data.append('Location_map_Image_Uplaod', files[0]);
                //data.append("Location_map_Image_Uplaod", jQuery("#file_upload").get(0).files[0]);
                data.append("state_name", state_name);
                data.append("district_name", district_name);
                data.append("block_name", block_name);
                data.append("gpname", gpname);
                data.append("year", year);
                return data;
            }(),
            contentType: false,
            processData: false,
            success: function (response) {
                debugger;
                alert(response);
                $("#div_location").show();
                $("#btn_img_nxt").show();
                gpimagesgeting_Location();
                //alert(response);
                //if (response == "Logout") {
                //    window.location = "/WspNew/WSP_GWM_HOME";
                //}
                //else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                //    window.location = "/Error/DefaultError";
                //}
            }
        });
    }

    function save_Watershed_map_Image_Uplaod() {

     State = '@Session["gstate"]';
     Dist ='@Session["gdist"]';
     Block ='@Session["gblock"]';
     Gram = '@Session["ggram"]';
           Year = '@Session["year"]';
        var state_name = State;
        var district_name = Dist;
        var block_name = Block;
        var gpname = Gram;
        var year = Year;


        var files = $('#Watershed_map_Image_Uplaod')[0].files;


        $.ajax({
            type: "POST",
            url: "/WaterSecurityPlan/Watershed_map_Image_Uplaod",
            data: function () {
                var data = new FormData();
                data.append('Watershed_map_Image_Uplaod', files[0]);
                //data.append("Location_map_Image_Uplaod", jQuery("#file_upload").get(0).files[0]);
                data.append("state_name", state_name);
                data.append("district_name", district_name);
                data.append("block_name", block_name);
                data.append("gpname", gpname);
                data.append("year", year);
                return data;
            }(),
            contentType: false,
            processData: false,
            success: function (response) {
                alert(response);
                $("#div_location").show();
                $("#btn_img_nxt").show();
                gpimagesgeting_Location();
                //alert(response);
                //if (response == "Logout") {
                //    window.location = "/WspNew/WSP_GWM_HOME";
                //}
                //else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                //    window.location = "/Error/DefaultError";
                //}
            }
        });
    }


    function save_Aquifer_map_Image_Uplaod() {

     State = '@Session["gstate"]';
     Dist ='@Session["gdist"]';
     Block ='@Session["gblock"]';
     Gram = '@Session["ggram"]';
          Year = '@Session["year"]';
        var state_name = State;
        var district_name = Dist;
        var block_name = Block;
        var gpname = Gram;
        var year = Year;

        var files = $('#Aquifer_map_Image_Uplaod')[0].files;
        $.ajax({
            type: "POST",
            url: "/WaterSecurityPlan/Aquifer_map_Image_Uplaod",
            data: function () {
                var data = new FormData();
                data.append('Aquifer_map_Image_Uplaod', files[0]);
                //data.append("Location_map_Image_Uplaod", jQuery("#file_upload").get(0).files[0]);
                data.append("state_name", state_name);
                data.append("district_name", district_name);
                data.append("block_name", block_name);
                data.append("gpname", gpname);
                data.append("year", year);
                return data;
            }(),
            contentType: false,
            processData: false,
            success: function (response) {
                alert(response);
                $("#div_location").show();
                $("#btn_img_nxt").show();
                gpimagesgeting_Location();
                //alert(response);
                //if (response == "Logout") {
                //    window.location = "/WspNew/WSP_GWM_HOME";
                //}
                //else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                //    window.location = "/Error/DefaultError";
                //}
            }
        });
    }

    function CheckOther() {
        if ($("#basin_name").val() == "Other") {
            $("#other_basin_name").show();
        } else {
            $("#other_basin_name").hide();
        }

        if ($("#sub_basin_name").val() == "Other") {
            $("#other_sub_basin_name").show();
        } else {
            $("#other_sub_basin_name").hide();
        }
    }

    $("#MyButton").click(function () {
        alert('Confirm to refresh alert messages.');
        $("#menu-15").load("#menu-15 .reloaded-divs> *");
    });
</script>


