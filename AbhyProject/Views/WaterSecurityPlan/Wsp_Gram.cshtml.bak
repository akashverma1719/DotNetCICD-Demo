                    </div>
                </div>
                <div class="clearfix tabfirst">
                    <div class="suface-info active" id="menu-11">
                        <div class="clearfix">
                            <div class="container-fluid">
                                <div class="col-lg-12 col-md-12 col-sm-12 form-body" style="padding:10px 15px">
                                    <div class="form-div">
                                        <div class="col-md-12 background-border-Database ">
                                            <div class="row database_trainer_row ">
                                                <h3>
                                                    Gram Panchayat (Basic Hydrology Info)
                                                    @*<a href="javascript:;" data-toggle="tooltip" title="Data Source : Shapefile(Village Boundary)">
                                            <span class="glyphicon glyphicon-info-sign" style="color:#fff" aria-hidden="true"></span>
                                        </a>*@
                                                </h3>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">1. State :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input type="text" id="state_name" class="form-control color_database" name="" placeholder="Your State.." readonly>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">2. District :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input type="text" id="district_name" class="form-control color_database" name="" placeholder="District .." readonly>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">3. Block / Taluk  :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="block_name" class="form-control color_database" name="" placeholder="Block / Taluk" readonly>
                                                </div>
                                            </div>

                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">4. Gram Panchayat Name :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="gram_panchayat_name" class="form-control color_database" name="" placeholder="Gram Panchayat Name.." readonly>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">
                                                        5. Gram Panchayat LGD Code
                                                        <a href="javascript:;" data-toggle="tooltip" title="Local Government Directory">
                                                            <span class="glyphicon glyphicon-info-sign" aria-hidden="true" style="color:blue;"></span>
                                                        </a>
                                                        :
                                                    </label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="gp_id" class="form-control color_database alphanum" name="" placeholder="Gram Panchayat ID.." maxlength="10" disabled>
                                                    <label id="AlertError1" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">6. Block Area (ha) @*<span class="Required_star">*</span>*@:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    @*abhi1204*@
                                                    <input Type="text" id="block_area" class="form-control decimal color_database" name="" placeholder="Block Area.." data-decimal="4" oninput="enforceNumberValidation(this)" disabled required>
                                                    <label id="AlertError2" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
