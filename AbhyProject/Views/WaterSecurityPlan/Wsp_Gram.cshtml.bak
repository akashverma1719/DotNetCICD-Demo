        }
    };

    function Delete_data() {

        var obj = {};
        obj.IDD = $(".btn_location").attr("id");
        obj.type = "location";

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/delete_data",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                gpimagesgeting_Location();
                $('#btn_locaton_dlt').hide();
                $("#output").hide();
                $("#Location_map_Image_Uplaod").val("");
            },
            error: function () {
                alert("Error While Saving Data")
            }
        });
    }
    function Delete_data_w() {
        var obj = {};
        obj.IDD = $(".btn_watershed").attr("id");
        obj.type = "watershed";
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/delete_data",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                $('#btn_watershed_dlt').hide();
                $("#Watershed_map_Image_output").hide();
                $("#Watershed_map_Image_Uplaod").val("");
                gpimagesgeting_Location();
            },
            error: function () {
                alert("Error While Saving Data")
            }
        });
    }
    function Delete_data_a() {

        var obj = {};
        obj.IDD = $(".btn_aquifer").attr("id");
        obj.type = "aquifer";
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/delete_data",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                $('#btn_aquifer_dlt').hide();
                $("#Aquifer_map_Image_output").hide();
                $("#Aquifer_map_Image_Uplaod").val("");
                gpimagesgeting_Location();
            },
            error: function () {
                alert("Error While Saving Data")
            }
        });
    }


    function gpimagesgeting_Location() {
        var state = $('#spnstate').text();
        var dist = $('#spndistrict').text();
        var block = $('#spnblock').text();
        var gram = $('#spngram').text();

         Year = '@Session["year"]';


        var obj = {};
        obj.state_name = state;
        obj.district_name = dist;
        obj.block_name = block;
        obj.gpname = gram;

        obj.year = Year;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/MapImagesdetails1',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                //alert(data.length);
                $("#loaction_map_geting").html("");
                //$("#Drainage_map_geting").html("");
                $("#Aquifer_map_geting").html("");
                $("#Watershed_map_geting").html("");
                
                var i = 0;
                $(".btn_location").hide();
                $(".btn_aquifer").hide();
                $(".btn_watershed").hide();
                if (data.length != 0) {
                    $("#div_location").show();
                    $("#btn_img_nxt").show();

                    //alert('imagegetting');
                    var check = 1;
                    var check_b = 1;
                    var check_c = 1;

                    for (var i = 0; i < data.length; i++) {
                        debugger;
                        if (data[i].gpimage1 != null && data[i].gpimage1 != "") {
                            var tr1 = '<label><a href="' + data[i].gpimage1 + '" download="" target="_blank" >' + data[i].gpimage1_filename + '</a></label>';
                            $('#loaction_map_geting').html(tr1);
                            $(".btn_location").show();
                            $("#btn_locaton_dlt").attr("id", data[i].id);


                        }
                        else {
                            check = 0;
                            $(".btn_location").hide();

                        }

                        //if (data[i].gpimage4 != null && data[i].gpimage4 != "") {
                        //    var Drainage_map_geting = '<label><a href="' + data[i].gpimage4 + '" download="" target="_blank" >' + data[i].gpimage4_filename + '</a></label>';
                        //    $('#Drainage_map_geting').html(Drainage_map_geting);

                        //}


                        if (data[i].gpimage3 != null && data[i].gpimage3 != "") {
                            var Aquifer_map_geting = '<label><a href="' + data[i].gpimage3 + '" download="" target="_blank" >' + data[i].gpimage3_filename + '</a></label>';
                            $('#Aquifer_map_geting').html(Aquifer_map_geting);
                            $(".btn_aquifer").show();
                            $("#btn_aquifer_dlt").attr("id", data[i].id);

                        }
                        else {
                            check_b = 0;
                            $(".btn_aquifer").hide();
                        }
                        if (data[i].gpimage2 != null && data[i].gpimage2 != "") {
                            var Watershed_map_geting = '<label><a href="' + data[i].gpimage2 + '" download="" target="_blank" >' + data[i].gpimage2_filename + '</a></label>';
                            $('#Watershed_map_geting').html(Watershed_map_geting);
                            $(".btn_watershed").show();
                            $("#btn_watershed_dlt").attr("id", data[i].id);

                        }
                        else {
                            check_c = 0;
                            $(".btn_watershed").hide();
                        }
                        if (check == 0 && check_b == 0 && check_c == 0 ) {
                            $("#div_location").hide();
                            $("#btn_img_nxt").hide();
                        }
                    }

                }

            }

        });
    }

    //ideal state
    //    let inactivityTime = function() {
    //        let time;
    //    window.onload = resetTimer;
    //    document.onmousemove = resetTimer;
