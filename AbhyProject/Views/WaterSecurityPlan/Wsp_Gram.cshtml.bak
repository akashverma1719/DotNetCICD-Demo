    function Details() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/GrampanchayatDetails',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                $('.loader').hide();
                if (data.length != 0) {

                    
                    $('#watershed_code').val(data[0].watershed_code);

                    $('#watershed_name').val(data[0].watershed_name);
                    $('#watershed_area_block').val(data[0].watershed_area_block);

                    $('#sub_basin_code').val(data[0].sub_basin_code);

                    $('#basin_code').val(data[0].basin_code);
                    if (data[0].basin_name != null && data[0].basin_name != "") {
                        $('#basin_name').val(data[0].basin_name);
                    } else {
                        $('#basin_name').val("");
                    }

                    if (data[0].sub_basin_name != null && data[0].sub_basin_name != "") {
                        $('#sub_basin_name').val(data[0].sub_basin_name);
                    } else {
                        $('#sub_basin_name').val("");
                    }

                    if (data[0].sub_basin_name == "Other") {
                        $('#other_sub_basin_name').val(data[0].other_sub_basin_name);
                        $('#other_sub_basin_name').show();
                    }
                    if (data[0].basin_name == "Other") {
                        $("#other_basin_name").val(data[0].other_basin_name);
                        $("#other_basin_name").show();
                    }


                } else {
                    WaterShedInfo();
                }


                if (DPMU_Level_Count == 1) {
                    DPMU_Submission();
                }
                gpimagesgeting_Location();

            }
        });
    }

    
    function WaterShedInfo() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/WaterShedInfo',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                if (data != null) {
                    $('#watershed_code').val(data.watershed_code);

                    $('#watershed_name').val(data.watershed_name);
                    $('#watershed_area_block').val(data.watershed_area_block);

                    $('#sub_basin_code').val(data.sub_basin_code);
                    $('#basin_code').val(data.basin_code);
                }
            }
        });
    }


    function BasinInfo() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/GrampanchayatDetails_StateWise',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                console.log(data);
                if (data == "Logout") {
                       window.location = "/WspNew/WSP_GWM_HOME";
                    }
                var BasinNameArray = [];
                var Sub_BasinNameArray = [];

                if (data.length != 0) {





                    for (var i = 0; i < data.length; i++) {

                        if (data[i].basin_name != "" && data[i].basin_name != null && data[i].basin_name != "0") {

                            var ss = data[i].basin_name;
                            var basin = ss.trim();

                            if (basin != "") {
                                if (BasinNameArray.indexOf(data[i].basin_name) === -1) {
                                    BasinNameArray.push(data[i].basin_name);
                                }
                            }
                            //  Options1 += '<option value="' + data[i].basin_name + '">' + data[i].basin_name + '</option>';
                        }
                        if (data[i].sub_basin_name != "" && data[i].sub_basin_name != null && data[i].sub_basin_name != "0") {
                            var ss = data[i].sub_basin_name;
                            var basin = ss.trim();

                            if (basin != "") {
                                if (Sub_BasinNameArray.indexOf(data[i].sub_basin_name) === -1) {
                                    Sub_BasinNameArray.push(data[i].sub_basin_name);
                                }
                            }
                            //  Options2 += '<option value="' + data[i].sub_basin_name + '">' + data[i].sub_basin_name + '</option>';
                        }
                    }




                }


                var Options1 = '<option value="0">Please Select  Basin Name</option>';
                var Options2 = '<option value="0">Please Select Sub Basin Name</option>';
                for (var i = 0; i < BasinNameArray.length; i++) {
                    Options1 += '<option value="' + BasinNameArray[i] + '">' + BasinNameArray[i] + '</option>';
                }
                for (var i = 0; i < Sub_BasinNameArray.length; i++) {
                    Options2 += '<option value="' + Sub_BasinNameArray[i] + '">' + Sub_BasinNameArray[i] + '</option>';
                }

                
                Options1 += '<option value="Other" id="Other">Other</option>';
                Options2 += '<option value="Other" id="Other">Other</option>';
                $('#basin_name').html(Options1);
                $('#sub_basin_name').append(Options2)
                Details();

            }
        });

    }


    var DPMU_Level_Count = 0;

    function Save_Full_Info() {
       // DPMU_Level_Count = 1;
        DPMU_Submission();

    }

    function DPMU_Submission() {
        DPMU_Level_Count = 1;

        var verification_val = 0;
        var lfckv = document.getElementById("WspTacker_Verification_CheckBox").checked;

        if (lfckv == true) {
            verification_val = 1;
            DPMU_Level_Count += 1;

        } else {
            verification_val = 0;
            alert("Please Check The data entered has been checked and verified by DPMU");
        }
        document.getElementById('AlertError1').innerHTML = "";
        var ddd = 0;
        var obj = {};
        var state_name = $('#state_name').val();
        var district_name = $('#district_name').val();
        var block_name = $('#block_name').val();
        var gram_panchayat_name = $('#gram_panchayat_name').val();
        obj.gp_id = $('#gp_id').val();
        obj.watershed_name = $('#watershed_name').val();

        obj.watershed_area_block = $('#watershed_area_block').val();

        obj.sub_basin_code = $('#sub_basin_code').val();

        var basin_name = $('#basin_name').val();
        if (basin_name != "") {
            obj.basin_name = $('#basin_name').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            alert("Please Enter Basin Name");
            document.getElementById('AlertError9').innerHTML = "Please Enter Basin Name";
            $('#basin_name').focus();
        }
        var sub_basin_name = $('#sub_basin_name').val();
        if (sub_basin_name != "") {
            obj.sub_basin_name = $('#sub_basin_name').val();
        }
        //else {
        //    ddd = 1;
        //    //document.getElementById('AlertError1').innerHTML = "";
        //    //document.getElementById('AlertError2').innerHTML = "";
        //    //document.getElementById('AlertError3').innerHTML = "";
        //    //document.getElementById('AlertError4').innerHTML = "";
        //    //document.getElementById('AlertError5').innerHTML = "";
        //    //document.getElementById('AlertError6').innerHTML = "";
        //    //document.getElementById('AlertError7').innerHTML = "";
        //    //document.getElementById('AlertError8').innerHTML = "";
        //    //document.getElementById('AlertError9').innerHTML = "";
        //    //document.getElementById('AlertError10').innerHTML = "";
        //    //alert("Please Enter Sub Basin Name");
        //    //document.getElementById('AlertError8').innerHTML = "Please Enter Sub Basin Name";
        //    $('#sub_basin_name').focus();
        //}

        var watershed_code = $('#watershed_code').val();
        if (watershed_code != "") {
            obj.watershed_code = $('#watershed_code').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError9').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            alert("Please Enter Watershed Code");
            document.getElementById('AlertError4').innerHTML = "Please Enter Watershed Code";
            $('#watershed_code').focus();
        }

        var gp_area = $('#gp_area').val();
        if (gp_area != "") {
            obj.gp_area = $('#gp_area').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError9').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "Data not available in GPDCI module";
            $('#gp_area').focus();
            alert("Data not available in GPDCI module");
        }

        var block_area = $('#block_area').val();
        if (block_area != "") {
            obj.block_area = $('#block_area').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError9').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "Please Enter Block Area (Ha)";
            $('#block_area').focus();
            alert("Please Enter Block Area (Ha)");
        }

        obj.basin_code = $('#basin_code').val();

        if (ddd == 0 && verification_val == 1 && DPMU_Level_Count == 2) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/WaterSecurityPlan/SaveGrampanchayatDetails",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    if (response != "Successfully Saved" && response != "Logout" && response != "Please Select Basin Name" && response != "Please Enter Block Area (Ha)" && response != "Data not available in GPDCI module" && response != "Please Select Sub Basin Name" && response != "Please Enter Watershed Code") {
                        window.location = "/Error/DefaultError";
                    }

                    alert("Verified Successfully");
                }
            });
        }
        else {
            DPMU_Level_Count = 1;
            Details();
        }


    }

