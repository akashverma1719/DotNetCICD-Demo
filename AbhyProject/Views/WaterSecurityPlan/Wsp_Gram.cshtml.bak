    function get_approved_status() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterSecurityPlan/get_approved_status",
            dataType: 'JSON',
            success: function (data) {
                debugger;

                @*status_id = @ViewBag.status_id;
                alert(status_id)*@
                if (data > 1) {
                    $('input[type=text]').prop("disabled", true)
                    $('select').prop("disabled", true);
                    $('input[type=file]').prop("disabled", true)
                    $('.btn_disabled').prop("disabled", true);
                }
            }
        });
    }

    function get_gp_block_area() {
        debugger;
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WaterSecurityPlan/Get_gp_block_area',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;

                if (data.length > 0) {
                    $('#block_area').val(data[0].block_area);
                    $('#gp_area').val(data[0].gp_area);
                    $('#gp_id').val(data[0].lg_gram);
                    Lat = parseFloat(data[0].latitude);
                    Long = parseFloat(data[0].longitude);
                    myMap(Lat, Long);
                }
                $('.Loader').hide();
                BasinInfo();
            }
        });
    }



