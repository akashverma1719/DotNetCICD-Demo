@*PGWM Committee Scripts*@
<script>
    // Other Option Script
    function CheckDepartment(val) {

        var element = document.getElementById('otherdepartment');
        var elementSelect = document.getElementById('department');
        if (val == 'others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'others')
            elementSelect.style.display = 'none';

        else
            elementSelect.style.display = 'block';
    }
    // PGWM TABLE
    var a = 1;
    function addrow() {

        var count = 1;
        if (a == 1) {
            a = 0;
            var code = "<tr id='c1_count'><td><button class='btn btn-success' onclick='PGWDepDetails()'>Save</button > <button type='button' class='btn btn-danger' onclick='cancelone();'>Cancel</button></td>" +
                "<td><input type='text' class='form-control alpha' id='countname'/></td> " +
                "<td><input type='text' class='form-control alpha' id='designation'/></td>" +
                "<td><select class='form-control' id='gender'><option value='0'>Select Gender</option><option value='Male'> Male</option><option value='Female'>Female</option><option value='Other'>Other</option></select></td>" +
                "<td> <select id='department' class='form-control' onchange='CheckDepartment(this.value);'><option value='0'>Select Social Oraganization</option><option value='VWSC (Village Water & Sanitation Committee)'>VWSC (Village Water & Sanitation Committee)</option><option value='SHG (Self Help Group)'>SHG (Self Help Group)</option><option value='WUA (Water User Association)'>WUA (Water User Association) </option><option value='Cooperative Societies'>Cooperative Societies</option> <option value='others'>others</option></select><input type='text' class='form-control' name='otherdepartment' id='otherdepartment' style='display:none;' /></td></tr>";
            $('table#TblData tbody').prepend(code);
        }
        //count=count+1;
        //alert(count);
    }
    function cancelone() {
        // addrow();
        $('table#TblData tbody tr#c1_count').remove();
        a = 1;
    }
</script>

