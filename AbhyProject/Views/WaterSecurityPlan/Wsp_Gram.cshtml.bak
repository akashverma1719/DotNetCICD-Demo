<style>
    .color_database {
        color: green !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    #loaction_map_geting label {
        margin-left: 10px;
        margin-top: 10px;
        font-size: 12px;
        width: 246px;
    }

    #Watershed_map_geting label {
        margin-left: 10px;
        margin-top: 10px;
        width: 246px;
        font-size: 12px;
    }

    #Aquifer_map_geting label {
        margin-left: 10px;
        width: 246px;
        margin-top: 10px;
        font-size: 12px;
    }

    .imageUpload_div .btn {
        margin-top: 10px;
    }

    .imageUpload_div input {
        margin-left: 5px;
    }

    .brdr_btm {
        border-bottom: 1px solid #d9d5d5;
        padding-top: 5px;
    }

    .imageUpload_div td {
        padding: 10px 34px;
    }

    .tab-link {
        cursor: pointer;
    }
</style>

