@model IEnumerable<AbhyProject.Models.abhy_procurement_milestone_insertdata>

@{
    ViewBag.Title = "Tender_Awarded";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
    var i = 1;
}
<link href="~/Content/Website/lib/nivo-slider/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<script src="~/Content/Website/js/jquery.dataTables.min.js"></script>
<script src="~/Scripts/all_scripts/dataTables.bootstrap.min.js"></script>
@*<script src="https://cdn.datatables.net/1.10.19/js/dataTables.bootstrap.min.js"></script>*@

<title>Tender Awarded</title>
<script>
    $(document).ready(function () {
        $.noConflict();

        $("nav#primary-menu > ul.main-menu > li:nth-child(3)").addClass("active");
        $("nav#primary-menu > ul.main-menu > li:nth-child(3)").siblings().removeClass('active');
        $("nav#primary-menu > ul.main-menu > li:nth-child(3) > ul.dropdown > li:nth-child(2) ").addClass("active");
        $("nav#primary-menu > ul.main-menu > li:nth-child(3) > ul.dropdown > li:nth-child(2)").siblings().removeClass('active');
        $('#example').DataTable();
    });

</script>
<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid #81dd81;
    }

    table.tenderawd > thead > tr > th {
        background-color: #337ab7;
        color: #fff;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }

    select {
        width: 180px;
    }

    #example_wrapper .row:nth-child(2n+1) {
        width: 100%;
    }
    /*thead {
        background-color: #499BC9;
        color:#fff;
    }*/
</style>

<div class="row">
    <div class="col-md-12">
        <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">Tender Awarded </div>
    </div>
</div>

<div class="container-fluid" style="margin-top:20px;margin-bottom:20px;">

    <!--Start drop down row-->
    <div class="row" style="margin-bottom:50px;">
        <div class="col-md-12">
            <div class="row Training2 upload2 ">
                <div class="col-md-2" style="padding:8px;">
                    <label>Agency Name :</label>
                </div>
                @using (Html.BeginForm("Tender_Awarded", "Tenders", new { @class = "form-horizontal" }))
                {
                    <div class="col-md-6" style="padding:0px;">

                        @*@Html.DropDownList("Agency", (IEnumerable<SelectListItem>)ViewBag.DD, "--Select Agency--", new { id = "Agency", @class = "form-control" })*@

                        <select name="Agency" id="Agency" class="form-control" onchange="Agency_Dropdown()" style="width:180px">
                            <option value="0">--Select Agency--</option>
                            <option value="NPMU">NPMU</option>
                            <option value="Gujarat_24">Gujarat</option>
                            <option value="Haryana_6">Haryana</option>
                            <option value="Karnataka_29">Karnataka</option>
                            <option value="Madhya Pradesh_23">Madhya Pradesh</option>
                            <option value="Maharashtra_27">Maharashtra</option>
                            <option value="Rajasthan_8">Rajasthan</option>
                            <option value="Uttar Pradesh_9">Uttar Pradesh</option>

                        </select>


                        @*@Html.DropDownList("Agency", (IEnumerable<SelectListItem>)ViewBag.DD, "--Select Agency--", new { id = "Agency", @class = "form-control", @onchange = "Checking()" })*@

                    </div>
                    <div class="col-md-2">
                        @*<input type="submit" value="search" class="btn btn-primary" style="width:100px;" />*@
                        <button type="submit" value="search" id="Btn_1" class="btn btn-primary" hidden>search</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!--End drop down row-->
    <!--Start datatable row-->

    <div class="row">
        <div class="col-md-12">
            <div class="tbl-responsive table-responsive">
                <table id="example" style="margin-top:20px !important;" class=" display  tenderawd table stripe row-border order-column  table-striped table-bordered dataTable no-footer" style="width:100%">
                    <thead>
                        <tr>
                            <th>SNO</th>
                            <th>Agency</th>
                            <th>Work and Activity</th>
                            <th>Category of Procurement (As categorised in PP)</th>
                            <th>Description of Service/Goods/Work</th>
                            <th>Office doing Procurement</th>
                            <th>Tender Ref. No.</th>
                            <th>Date of Award of Contract / LOA</th>
                            <th>Accepted Tender Amount (Contract Price) (INR)</th>
                            <th>Name of Consultant/Service Provider/Supplier/Contractor</th>
                            <th>Stipulated date of completion</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @i
                                    </td>
                                    <td>
                                        @item.agency_name
                                    </td>
                                    <td>
                                        @item.activity_name
                                    </td>
                                    <td>
                                        @item.category_of_procurement
                                    </td>
                                    <td>
                                        @item.description_service
                                    </td>
                                    <td>
                                        @item.rfp_date
                                    </td>
                                    <td>
                                        @item.tender_no
                                    </td>
                                    <td>
                                        @item.contract_award_date
                                    </td>
                                    <td>
                                        @item.tender_amt
                                    </td>
                                    <td>
                                        @item.name_of_consultant
                                    </td>
                                    <td>
                                        @item.stipulated_date
                                    </td>
                                </tr>
                                i = i + 1;
                            }



                        }
                        else
                        {
                            <tr><td colspan="20" style="text-align:center;"> No Data</td> </tr>
                        }
                        <!--Rows here-->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script>

    var State = "";
     $(document).ready(function () {

         State = '@Session["Tender_Agency_Name"]';

         if (State != "") {
             $('#Agency').val(State);
         } else {
             $('#Agency').val('0');
         }
    });

    //Btn_1
    $(document).ready(function () {
        $('#Btn_1').hide();
    });

    function Agency_Dropdown() {

        $('#Btn_1').click();

    }


    $(document).ready(function () {
        var uri = window.location.toString();
        if (uri.indexOf("?") > 0) {
            var clean_uri = uri.substring(0, uri.indexOf("?"));
            window.history.replaceState({}, document.title, clean_uri);
        }
        $("#Agency").val("0");
    });
</script>