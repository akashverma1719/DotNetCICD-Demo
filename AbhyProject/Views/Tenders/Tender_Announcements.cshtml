<style>
    .div-w99 {
        max-width: 97% !important;
        margin: auto;
        width: 97% !important;
        padding: 10px;
    }

    .Training-blue {
        color: blue;
        background: #0000ff24 !important;
    }

    .training {
        border: none !important;
    }

        .training:hover {
            box-shadow: 2px 2px 2px 1px rgba(0, 0, 0, 0.2);
        }

    .Training-green {
        color: green;
        background: #0080001c !important;
    }

    .Training-orange {
        color: orange;
        background: #ffa50017 !important;
    }

    .Training-yellow {
        background: #ffff001f !important;
        color: yellow;
    }

    .panel-body {
        width: 100%;
        height: 150px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nav-tabs {
        border-bottom: 1px solid #e4e5e7;
    }

        .nav-tabs > li > a {
            font-weight: 600;
            color: #fff;
            background-color: #30ABEC;
            padding: 8px 10px;
            border: 1px solid #eee;
            border-bottom: none;
        }

        .nav-tabs > li a:hover {
            background: transparent;
        }


    .tab-content {
        border: 1px solid #cacaca;
        padding: 12px 16px;
    }

        .tab-content > .active,
        .pill-content > .active {
            display: block;
        }

        .tab-content p:last-child {
            margin-bottom: 0;
        }

    .fade {
        opacity: 1 !important;
        transition: opacity .15s linear;
    }

    #example_wrapper .row:nth-child(2n+1) {
        width: 100%;
    }


    .nav-tabs > li > a i {
        margin-right: 1px;
        padding-right: 5px;
    }

    ul#myTabs2 > li.active::after {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #2E578C;
        content: " ";
        position: absolute;
        bottom: -15px;
        margin-left: -15px;
        left: 50%;
    }

    ul#myTabs2 > li {
        background-color: #3A99ED;
        padding: 0px;
    }



        ul#myTabs2 > li > a {
            color: #fff;
        }

    body {
        line-height: 24px;
    }


    .panel-title a .control-icon {
        position: absolute;
        right: 33px;
        margin-top: -11px;
    }

    .panel-title a i {
        font-size: 1.2em;
        padding-right: 5px;
    }

    .fa-desktop, .fa-leaf {
        padding: 5px;
    }

    .btn:not(:disabled):not(.disabled) {
        cursor: pointer;
    }

    @@media (min-width: 0) {
        .g-py-12 {
            padding-top: 0.85714rem !important;
            padding-bottom: 0.85714rem !important;
        }

        .g-px-20 {
            padding-left: 1.42857rem !important;
            padding-right: 1.42857rem !important;
        }
    }

    .u-btn-primary {
        color: #fff;
        background-color: #527bcc;
    }

    p.btnhover > a:hover,
    p.btnhover > a:active {
        background-color: green;
        color: #fff;
    }

    h3 {
        margin-bottom: 10px;
        font-size: 18px;
        font-weight: 400;
        color: #337AB7;
        font-family: inherit;
    }

    .Environmental_ul {
        padding: 5px 5px 5px 40px;
        list-style: disc;
    }

        .Environmental_ul > li {
            list-style: disc;
            padding: 2px 0px
        }

    .Environmental_ul_1 {
        list-style: lower-alpha;
        padding: 5px 5px 5px 40px;
    }

        .Environmental_ul_1 > li {
            list-style: lower-alpha;
            padding: 2px 0px;
        }

    .heding_Environmental {
        padding: 10px 0px;
        font-family: inherit;
        color: purple;
    }

    .list-group-item {
        border: 1px solid rgba(0,0,0,125);
        color: #ffffff !important;
        border-color: #eee;
    }

    ul.Etender {
        margin-top: 20px;
    }

        ul.Etender > li {
            padding: 5px 15px;
            width: 50%;
        }


    .marquee-1 {
        background: #337ab747;
        padding-top: 10px;
        margin-top: 20px;
    }
</style>
