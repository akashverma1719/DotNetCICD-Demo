<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid #81dd81;
    }

    table.tenderawd > thead > tr > th {
        background-color: #337ab7;
        color: #fff;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }

    select {
        width: 180px;
    }

    #example_wrapper .row:nth-child(2n+1) {
        width: 100%;
    }
    /*thead {
        background-color: #499BC9;
        color:#fff;
    }*/

    .tableDataResp thead tr th {
        position: sticky !important;
        top: 0px !important; 
