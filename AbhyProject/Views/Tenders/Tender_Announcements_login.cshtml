        line-height: 24px;
    }


    .panel-title a .control-icon {
        position: absolute;
        right: 33px;
        margin-top: -11px;
    }

    .panel-title a i {
        font-size: 1.2em;
        padding-right: 5px;
    }

    .fa-desktop, .fa-leaf {
        padding: 5px;
    }

    .btn:not(:disabled):not(.disabled) {
