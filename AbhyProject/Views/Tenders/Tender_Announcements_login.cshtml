        color: #337AB7;
        font-family: inherit;
    }

    .Environmental_ul {
        padding: 5px 5px 5px 40px;
        list-style: disc;
    }

        .Environmental_ul > li {
            list-style: disc;
            padding: 2px 0px
        }

    .Environmental_ul_1 {
        list-style: lower-alpha;
