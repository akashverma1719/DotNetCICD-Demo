@model IEnumerable<AbhyProject.Models.abhy_procurement_milestone_insertdata>
@*@model IEnumerable<AbhyProject.Models.E_Tender>*@
@{
    ViewBag.Title = "E-Tender_Form";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
    var l = 1;

}
<title> Tender </title>


<link href="~/Content/Website/lib/nivo-slider/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<script src="~/Content/Website/js/jquery.dataTables.min.js"></script>
<script src="~/Scripts/all_scripts/dataTables.bootstrap.min.js"></script>

<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid #81dd81;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }

    thead {
        background-color: #337ab7;
        color: #fff;
        position: sticky;
        top: 0;
    }

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">Tender Archive </div>
    </div>
</div>
<div class="container-fluid" style="margin-top:20px;">
    <div class="row">
        <div class="col-md-12">
            <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll;height:600px;">
                <table id="example" class=" display  table stripe row-border order-column  table-striped table-bordered dataTable no-footer" style="width:100%">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Agency</th>
                            <th>Work and Activity</th>
                            <th>Method of Selection/Procurement (PP)</th>
                            <th>Category of Procurement (As categorised in PP)</th>
                            <th>Description of Service/Goods/Work</th>
                            <th>Office doing Procurement</th>
                            <th>Email address of concerned Office</th>
                            <th>Tender Ref. No.</th>
                            <th>Estimated Cost (in INR)</th>
                            <th>Date of publication of Tender Notice</th>
                            <th>Tender Id</th>
                            <th>Date of start of sale/download of Bid document</th>
                            <th>Date of end of sale/download of Bid document</th>
                            <th>Date of pre-bid meeting</th>
                            <th>Number of envelopes</th>
                            <th>Deadline of submission of bid</th>
                            <th>Bid opening date</th>
                            <th>E-procurement Website URL</th>
                            <th>Uploaded documents</th>

                        </tr>
                    </thead>


                    <tbody>
                        @if (ViewBag.close7daysdatas != null)
                        {
                            foreach (var item3 in Model)
                            {
                                <tr>

                                    <td>
                                        @*<img src="~/Content/WspImages/tendor 3.png" />*@
                                        @l
                                    </td>
                                    <td>
                                        @item3.agency_name
                                    </td>
                                    <td>
                                        @item3.activity_name
                                    </td>
                                    <td>
                                        @item3.producrment_selection
                                    </td>
                                    <td>
                                        @item3.category_of_procurement
                                    </td>
                                    <td>
                                        @item3.description_service
                                    </td>
                                    <td>
                                        @item3.rfp_date
                                    </td>
                                    <td>
                                        @item3.email_office
                                    </td>
                                    <td>
                                        @item3.tender_no
                                    </td>
                                    <td>
                                        @item3.estimated_cost
                                    </td>
                                    <td>
                                        @item3.bid_date
                                    </td>

                                    <td>
                                        @item3.tender_id
                                    </td>
                                    <td>
                                        @item3.bid_evalution_date
                                    </td>
                                    <td>
                                        @item3.award_date
                                    </td>
                                    <td>
                                        @item3.completion_date
                                    </td>

                                    <td>
                                        @item3.noof_envelopes
                                    </td>
                                    <td>
                                        @item3.deadline_date
                                    </td>
                                    <td>
                                        @item3.bid_open_date
                                    </td>

                                    <td>

                                        <a href="https://@item3.website_url" target="_blank">
                                            @item3.website_url
                                        </a>
                                    </td>
                                    <td>
                                        <a href="@item3.filepath" target="_blank" download="">@item3.filename </a>
                                    </td>


                                </tr>
                                l = l + 1;
                            }
                        }
                        else
                        {
                            <tr><td colspan="20" style="text-align:center;"> No Data </td></tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>

<script>
    $(document).ready(function () {
        $.noConflict();
        $("nav#primary-menu > ul.main-menu > li:nth-child(3)").addClass("active");
        $("nav#primary-menu > ul.main-menu > li:nth-child(3)").siblings().removeClass('active');
        $("nav#primary-menu > ul.main-menu > li:nth-child(3) > ul.dropdown > li:nth-child(2) ").addClass("active");
        $("nav#primary-menu > ul.main-menu > li:nth-child(3) > ul.dropdown > li:nth-child(2)").siblings().removeClass('active');
        $('#example').DataTable();
    });
</script>
