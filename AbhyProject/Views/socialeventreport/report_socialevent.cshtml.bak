<script></script>

<script type="text/javascript">
    var find_name = "gwl";
    $(document).ready(function () {
        $(".loader").hide();
        var StateOfficer = '@Session["Officer"]';
        if (StateOfficer == "") {
            window.location = "/WspNew/WSP_GWM_HOME";
        }
    });


</script>

<script src="~/Scripts/validations.js"></script>
<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>

<script>

   var Jsondata = "";
    var WaterAvialability = 0;
    var WaterDropt = 0;
    var AA = 0, DD = 0;
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    var well_loader = "0";
    var StateOfficer = "";
    var button_click = "0";
    var image_path = "";
    $(document).ready(function () {
        StateOfficer = '@Session["Officer"]';
        image_path = '@Session["sUploadDirectory"]';
        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
        $('#state_tt').hide();
        $('#district_tt').hide();
        $('#block_tt').hide();
        $('#gp_tt').hide();
        $('#excel_a').hide();
        $('#excel_b').hide();
        $('#excel_c').hide();
        $('#excel_d').hide();

        DropDownInfo();
    });

    function pagechange() {
        window.location = "WspWaterAvailability", "WspNew"
    }
</script>

<script type="text/javascript">
    var check_table = "";
    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/SocialMointoring/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                    $(".loader").hide();
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();
                    $(".loader").hide();


                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();

                        var StateName = $("#spnstate").val();
                        if (StateName == "All") {
                            check_table = 1;
                            $('#DistDropdownLabel').hide();
                            $('#BlockDropdownLabel').hide();
                            $('#GramDropdownLabel').hide();
                            $('#state_tt').show();
                            $('#district_tt').hide();
                            $('#block_tt').hide();
                            $('#gp_tt').hide();
                            $('#excel_a').show();
                            $('#excel_b').hide();
                            $('#excel_c').hide();
                            $('#excel_d').hide();

                        }
                        else {
                            check_table = 2;
                            $('#state_tt').show();
                            $('#district_tt').hide();
                            $('#block_tt').hide();
                            $('#gp_tt').hide();
                            $('#DistDropdownLabel').show();
                            $('#BlockDropdownLabel').show();
                            $('#GramDropdownLabel').show();
                            $('#excel_a').show();
                            $('#excel_b').hide();
                            $('#excel_c').hide();
                            $('#excel_d').hide();
                        }

                        $(".loader").hide();
                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        State_Dropdown_Function();
                        $(".loader").hide();
                    }
                    else if (Str[0] == "District Level Nodal Officer") {
                        off_1 = "dist";
                        State = Str[1];
                        Dist = Str[2];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        Dist_fun();
                        $(".loader").hide();


                    }
                    else if (Str[0] == "Block Level Nodal Officer") {
                        off_1 = "block";
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        Block_fun();
                        $(".loader").hide();
                    }
                    else if (Str[0] == "Gram Panchyat Nodal Officer") {
                        State = Str[1];
                        Dist = Str[2];
                        Block = Str[3];
                        Gram = Str[4];
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').show();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').show();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').show();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').show();
                        $(".loader").hide();
                    }


                }
            }

        });

    }
    function DropDownInfo() {
        $(".loader").show();
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select StateName</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select GramPanchayat</option>';
                    $("#gram").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';
                        for (var i = 0; i < Jsondata.length; i++) {

                            if (!ddlst[Jsondata[i].state_name]) {
                                all_dists.push(Jsondata[i].state_name);
                                ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
                            else if (a > b) return 1;
                            return 0;
                        });
                        optionState = '<option value="All">ALL</option>';
                        /*optionState = '<option value="All">ALL</option>';*/
                        for (var i = 0; i < DistArray.length; i++) {
                            if (DistArray[i] != null && DistArray[i] != "") {
                                optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                            }
                        }
                        $("#spnstate").html(optionState);
                    }

                }

                SessionInfo();


            }
        });
    }
    function State_Dropdown_Function() {
        $("#dist11").empty();
        var opdist = '<option value="0">Select District</option>';
        $("#dist11").append(opdist);
        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var StateName = $("#spnstate").val();
        if (off_1 == "state") {
            StateName = State;
        } else {
            State = StateName;
        }

        if (State == "0") {
            check_table = 0;
            $('#state_tt').hide();
            $('#district_tt').hide();
            $('#block_tt').hide();
            $('#gp_tt').hide();
            $('#DistDropdownLabel').show();
            $('#BlockDropdownLabel').show();
            $('#GramDropdownLabel').show();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').hide();
            $('#excel_b').hide();
            $('#excel_c').hide();
            $('#excel_d').hide();
        }
        else if (State == "All") {
            check_table = 1;
            $('#DistDropdownLabel').hide();
            $('#BlockDropdownLabel').hide();
            $('#GramDropdownLabel').hide();
            $('#state_tt').show();
            $('#district_tt').hide();
            $('#block_tt').hide();
            $('#gp_tt').hide();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').show();
            $('#excel_b').hide();
            $('#excel_c').hide();
            $('#excel_d').hide();
        }
        else {
            check_table = 2;
            $('#state_tt').show();
            $('#district_tt').hide();
            $('#block_tt').hide();
            $('#gp_tt').hide();
            $('#DistDropdownLabel').show();
            $('#BlockDropdownLabel').show();
            $('#GramDropdownLabel').show();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').show();
            $('#excel_b').hide();
            $('#excel_c').hide();
            $('#excel_d').hide();
        }

        if (StateName != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_dists = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (StateName == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].district_name]) {
                        all_dists.push(Jsondata[i].district_name);
                        ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                    }
                }
            }


            var DistArray = [];
            DistArray = all_dists.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < DistArray.length; i++) {
                if (DistArray[i] != null && DistArray[i] != "") {
                    optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                }
            }
            $("#dist11").append(optionDist);
        }

    }
    function Dist_fun() {

        $("#block1").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block1").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);

        var dist = $("#dist11").val();
        if (off_1 == "dist") {
            dist = Dist;
        } else {
            Dist = dist;
        }
        if (dist == "0") {
            check_table = 2;
            $('#state_tt').show();
            $('#district_tt').hide();
            $('#block_tt').hide();
            $('#gp_tt').hide();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').show();
            $('#excel_b').hide();
            $('#excel_c').hide();
            $('#excel_d').hide();
        }
        else {
            check_table = 3;
            $('#state_tt').hide();
            $('#district_tt').show();
            $('#block_tt').hide();
            $('#gp_tt').hide();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').hide();
            $('#excel_b').show();
            $('#excel_c').hide();
            $('#excel_d').hide();
        }
        if (dist != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_blocks = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                //if (Jsondata[i].district_name == 'Kaithal' ) {
                //    alert(dist);

                //    return;
                //}

                if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].block_name]) {
                        all_blocks.push(Jsondata[i].block_name);
                        ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                        //  $("#block").append(optionDist);
                    }
                }
            }


            var BlockArray = [];
            BlockArray = all_blocks.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < BlockArray.length; i++) {
                if (BlockArray[i] != null && BlockArray[i] != "") {
                    optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                }
            }
            $("#block1").append(optionDist);

        }
    }
    function Block_fun() {

        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);
        var block = $("#block1").val();

        if (off_1 == "block") {
            block = Block;
        } else {
            Block = block;
        }
        if (block == "0") {
            check_table = 3;
            $('#state_tt').hide();
            $('#district_tt').show();
            $('#block_tt').hide();
            $('#gp_tt').hide();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').hide();
            $('#excel_b').show();
            $('#excel_c').hide();
            $('#excel_d').hide();
        }
        else {
            check_table = 4;
            $('#state_tt').hide();
            $('#district_tt').hide();
            $('#block_tt').show();
            $('#gp_tt').hide();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').hide();
            $('#excel_b').hide();
            $('#excel_c').show();
            $('#excel_d').hide();
        }

        if (block != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_grams = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                    if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                        ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                        all_grams.push(Jsondata[i].gram_panchayat_name);
                        //   $("#gram").append(optionDist);
                    }
                }
            }


            var GramArray = [];
            GramArray = all_grams.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < GramArray.length; i++) {
                if (GramArray[i] != null && GramArray[i] != "") {

                    optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
                }
            }
            $("#gram").append(optionDist);
        }
    }
    function Gram_change() {
        Gram = $('#gram').val();
        if (Gram == "0") {
            check_table = 4;
            $('#state_tt').hide();
            $('#district_tt').hide();
            $('#block_tt').show();
            $('#gp_tt').hide();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').hide();
            $('#excel_b').hide();
            $('#excel_c').show();
