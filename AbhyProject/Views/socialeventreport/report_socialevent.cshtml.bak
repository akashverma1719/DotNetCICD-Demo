                    else if (check_table == 3) {
                        district_data();
                        $('#state_tt tbody').html("");
                        $('#district_tt tbody').html("");
                        $('#block_tt tbody').html("");
                        $('#gp_tt tbody').html("");
                    }
                    else if (check_table == 4) {
                        block_data();
                        $('#state_tt tbody').html("");
                        $('#district_tt tbody').html("");
                        $('#block_tt tbody').html("");
                        $('#gp_tt tbody').html("");
                    }
                    else if (check_table == 5) {
                        gp_data();
                        $('#state_tt tbody').html("");
                        $('#district_tt tbody').html("");
                        $('#block_tt tbody').html("");
                        $('#gp_tt tbody').html("");
                    }
                }
            });
        }
    }

    function state_data() {

        $(".loader").show();
        var StateName = $("#spnstate").val();
        var year = $("#year").val();
        var month = $('#month').val();

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/socialeventreport/all_report',
            data: "{'StateName':'" + StateName + "','year':'" + year + "','Month':'" + month + "'}",
            dataType: 'JSON',
            success: function (data) {
                var Tbodyhtml = '';
                if (data.length == 7) {

                    var totalgp = 0;
                    var welltotal = 0;
                    var welltotalgp = 0;
                    var wellnogp = 0;
                    var gwltotal = 0;
                    var gwltotalgp = 0;
                    var gwlnogp = 0;
                    var gwqtotal = 0;
                    var gwqtotalgp = 0;
                    var gwqnogp = 0;
                    var geototal = 0;
                    var total_a = 0;
                    var total_b = 0;
                    var train_a = 0;
                    var train_c = 0;

                    for (var i = 0; i < data.length; i++) {
                        train_a += data[i].train_a;
                        train_c += data[i].train_c;
                        totalgp += data[i].Awareness_meetings_a;
                        welltotal += data[i].Awareness_meetings_c;
                        welltotalgp += data[i].WSP_Related_meetings_a;
                        wellnogp += data[i].WSP_Related_meetings_c;
                        gwltotal += data[i].other_a;
                        gwltotalgp += data[i].other_c;
                        gwlnogp += data[i].male;
                        gwqtotal += data[i].female;
                        gwqtotalgp += data[i].trangender;
                        gwqnogp += data[i].total;
                        geototal += data[i].percent_female;
                        total_a += data[i].total_a;
                        total_b += data[i].total_c;

                        var pp = data[i].percent_female.toFixed(2);


                        Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].statename + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].train_a + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].train_c + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].Awareness_meetings_a + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].Awareness_meetings_c + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].WSP_Related_meetings_a + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].WSP_Related_meetings_c + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].other_a + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].other_c + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].total_a + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].total_c + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].male + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].female + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].trangender + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].total + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + pp + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].year + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + data[i].month + '</label></td></tr>';
                    }
                    var totper = gwlnogp + gwqtotal + gwqtotalgp;
                    var per = (gwqtotal / totper) * 100;

                    Tbodyhtml += '<tr><td colspan="2" id="srNo"><label>' + "Total" + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + train_a + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + train_c + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + totalgp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + welltotal + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + welltotalgp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + wellnogp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + gwltotal + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + gwltotalgp + '</label></td>  ';
                    Tbodyhtml += '<td id="rainfall"><label>' + total_a + '</label></td>  ';
                    Tbodyhtml += '<td id="rainfall"><label>' + total_b + '</label></td>  ';
                    Tbodyhtml += '<td id="rainfall"><label>' + gwlnogp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + gwqtotal + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + gwqtotalgp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + gwqnogp + '</label></td>';
                    Tbodyhtml += '<td id="rainfall"><label>' + per.toFixed(2) + '</label>';
                    Tbodyhtml += '<td id="rainfall"><label></label>';
                    Tbodyhtml += '<td id="rainfall"><label></label></td></tr >';



                    $('#state_tt tbody').html(Tbodyhtml);
                    $(".loader").hide();

                }
                if (data.length == 1) {

                    var totalgp = 0;
                    var welltotal = 0;
                    var welltotalgp = 0;
                    var wellnogp = 0;
                    var gwltotal = 0;
                    var gwltotalgp = 0;
                    var gwlnogp = 0;
                    var gwqtotal = 0;
                    var gwqtotalgp = 0;
                    var gwqnogp = 0;
                    var geototal = 0;
                    var total_a = 0;
                    var total_b = 0;
                    var train_a = 0;
                    var train_c = 0;

                    for (var i = 0; i < data.length; i++) {

                        totalgp += data[i].Awareness_meetings_a;
                        welltotal += data[i].Awareness_meetings_c;
                        welltotalgp += data[i].WSP_Related_meetings_a;
