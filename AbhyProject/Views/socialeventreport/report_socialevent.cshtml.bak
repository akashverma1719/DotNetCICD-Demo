            $('#block_tt').hide();
            $('#gp_tt').show();
            $('#state_tt tbody').html("");
            $('#district_tt tbody').html("");
            $('#block_tt tbody').html("");
            $('#gp_tt tbody').html("");
            $('#excel_a').hide();
            $('#excel_b').hide();
            $('#excel_c').hide();
