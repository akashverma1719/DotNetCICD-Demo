    function Dropdown_Search() {
        $('#alert_waiting').show();
        var StateName = $("#spnstate").val();
        var year = $("#year").val();
        var month = $('#month').val();
        if (Gram != "0") {

        }
        else {
            Gram = $('#gram').val();
        }

        var xx = 0;
        if (StateName == "0") {
            xx = 1;
            alert("Please Select StateName");
        }
        else if (year == "0") {
            xx = 1;
            alert("Please Select Year");
        }
        //else if (month == "0") {
        //    xx = 1;
        //    alert("Please Select Month");
        //}
        if (xx == 0) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: '/GplevelMobileData/StateLevel_Dropdown',
                data: "{'StateName':'" + State + "','Dist':'" + Dist + "','Block':'" + Block + "','Gram':'" + Gram + "','year':'" + year + "','Month':'" + month + "'}",
                dataType: 'JSON',
                success: function (results) {

                    if (check_table == 1 || check_table == 2) {
                        state_data();
                        $('#state_tt tbody').html("");
                        $('#district_tt tbody').html("");
