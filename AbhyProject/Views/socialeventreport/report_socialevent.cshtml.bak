@{
    ViewBag.Title = "report_socialevent";
    Layout = null;
}
<title>Social Event Report</title>
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>

<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- favicon
============================================ -->

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/datecss.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/css/abhycss.css" rel="stylesheet" />
<link href="~/Content/wsp_formcss.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.5/jspdf.min.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>

<!-- jQuery library -->
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<link href="~/Content/Website/css/font-awesome.min.css" rel="stylesheet" />
<link href="~/Content/wspView.css" rel="stylesheet" />
<script src="~/Scripts/all_scripts/core.js"></script>
<script src="~/Scripts/all_scripts/charts.js"></script>
<script src="~/Scripts/all_scripts/animated.js"></script>
<link href="~/Scripts/Scriptsabhy/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<link href="~/Scripts/Scriptsabhy/bootstrap-datetimepicker.css" rel="stylesheet" />
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dom-to-image/2.6.0/dom-to-image.min.js"
        integrity="sha256-c9vxcXyAG4paArQG3xk6DjyW/9aHxai2ef9RpMWO44A=" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.5/jspdf.min.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>
<script src="~/Content/JS_Files/table2excel.js"></script>
<style>
    .color_database {
        color: green !important;
    }

    #imageView label {
        margin-left: 10px;
        margin-top: 10px;
        font-size: 12px;
        width: 246px;
    }

    ul[id$="_menu"] > li > a:hover > label, ul[id$="_menu"] > li > a:focus > label, ul[id$="_menu"] > li.active > a > label {
        border-color: #337ab7;
        background-color: #337ab7c7;
        color: #fff;
    }
</style>


<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }

    .social-table .bg-info {
        background-color: #337ab7 !important;
    }

    .social-table tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    .social-table tr th {
        font-size: 15px;
        line-height: 18px;
        font-weight: 600;
        color: #fff;
        text-align: center;
    }

    .social-table tr td {
        font-size: 14px;
    }

    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
    /*table fix code*/
    .pseudolink {
        color: blue;
        text-decoration: underline;
        cursor: pointer;
    }

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    /*ends here*/
    .new_wd {
        width: 255px !important;
    }

    #Surface_menu {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .Select_option_div {
        box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 17px 0px;
        padding: 20px;
        border: 1px solid #dfdbdb;
        border-radius: 10px;
        background: #edededcc;
    }

    ul.Select_option {
        display: flex;
        justify-content: space-between;
        padding: 0px;
    }

    .StateLabel {
        padding: 8px;
    }

    .display_flex {
        font-size: 12px;
    }

    .number_count_div {
        display: flex;
        justify-content: space-between;
    }

    .comn_table {
        background: #f2f2f2;
    }

        .comn_table thead th {
            border: 1px solid #fff;
        }

    #style-1::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background-color: #F5F5F5;
        border-radius: 25px;
    }

    #style-1::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
    }

    .tbl-responsive {
        box-shadow: rgba(149, 157, 165, 0.2) 0px -6px 22px !important;
        background: #f2f2f2 !important;
        overflow: auto;
        height: 500px;
    }

    #currentgeopageno {
        display: inline !important;
    }
</style>
<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<div class="clearfix">
    <main>
        <header class="header hederImage">
            <div class="clearfix">
                <div class="clearfix">
                    <div class="col-lg-9">
                        <div class="header-top-info">
                            <ul class="clearfix">
                                <li>
                                    <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                                </li>

                                <li>
                                    <span>
                                        <a href="~/home/index" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                    </span>
                                    <span>
                                        <a href="javascript:;" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                            Ministry of Jal Shakti
                                        </a>
                                    </span>
                                    <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size:14px;">Department of Water Resources,</a></span>
                                    <span style="text-align:center;">
                                        <a href="javascript:;" title="GOVERNMENT OF INDIA"
                                           style="text-transform:none; font-size:14px;">
                                            River Development & Ganga Rejuvenation
                                        </a>
                                    </span>

                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <ul class="imgHome clearfix">

                            <li>
                                <img src="~/Content/WspImages/user-silhouette.png" title="User" />
                                @if (Session["UserName"] != null)
                                {
                                    <span style="color:#fff;">:@Session["UserName"].ToString()</span>
                                }

                            </li>
                            <li>
                                <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                            </li>

                        </ul>
                    </div>
                    <div class="col-md-8" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                        <ul class="imgHome clearfix">
                            <li>
                                <a href="~/Home/index">
                                    <span>
                                        <img src="~/Content/WspImages/home-icon-silhouette.png" title="Home" />
                                    </span>
                                    <label>Home <i class="fa fa-angle-double-right"></i></label>
                                </a>
                            </li>
                            <li>
                                <span><img src="~/Content/WspImages/WSP Home.png" style="width:23px;" /></span>
                                <label>Social Event </label>
                            </li>

                        </ul>
                    </div>
                    <div class="col-md-2 pull-right">
                        <a href="~/socialeventreport/main_report" class="btn btn-danger">
                            Back To Module
                        </a>

                    </div>
                </div>
            </div>
        </header>
    </main>
    <center>
        <div class="text-h g-mb-20" style="font-size: 35px; color:white; font-family: raleway; margin-top: 10px; font-weight: 900; background-color: #72a230;padding:15px;">
            Social Event Report
        </div>
    </center>
    <br />

    <div class="tab-content">

        <div role="tabpanel" class="tab-pane fade in active" id="music">
            <div class="container-fluid">

                <div class="clearfix">
                    <div class="row " style="margin-top:30px;">
                        <div class="col-md-12 Select_option_div">
                            <div class="">
                                <label style="text-align:center;color:red;" id="Error_"></label>
                                <ul class="Select_option col-md-12 col-sm-8  text-left">
                                    <li id="StateLabel">
                                        <label id="lblstate">State:</label>
                                        <span id="spnstate1">@Session["gstate"]</span>
                                    </li>
                                    <li id="StateDropdownLabel">

                                        <select class="form-control" id="spnstate" onchange="State_Dropdown_Function()" style="border-radius:5px;">
                                        </select>
                                    </li>

                                    <li id="DistLabel">
                                        <i class="fas fa fa-angle-double-right"></i>
                                        <label id="lbldistrict">District:</label>
                                        <span id="spndistrict">@Session["gdist"]</span>
                                    </li>

                                    <li id="DistDropdownLabel">

                                        <select class="form-control" id="dist11" onchange="Dist_fun()" style="border-radius:5px;">
                                        </select>
                                    </li>

                                    <li id="BlockLabel">
                                        <i class="fas fa fa-angle-double-right"></i>
                                        <label>Block:</label>
                                        <span>@Session["gblock"] </span>
                                    </li>

                                    <li id="BlockDropdownLabel">

                                        <select class="form-control" id="block1" onchange="Block_fun()" style="border-radius:5px;">
                                        </select>
                                    </li>
                                    <li id="GramLabel">
                                        <i class="fas fa fa-angle-double-right"></i>
                                        <label>Gram panchayat:</label>
                                        <span>@Session["ggram"]</span>
                                    </li>

                                    <li id="GramDropdownLabel">

                                        <select class="form-control" id="gram" onchange="Gram_change()" style="border-radius:5px;">
                                        </select>
                                    </li>
                                    <li>
                                        <select class="form-control" id="year" onchange="yearchange()" style="border-radius:5px;">
                                            <option value="0">Select  Year</option>
                                            <option value="2020-21">2020-21</option>
                                            <option value="2021-22">2021-22</option>
                                            <option value="2022-23">2022-23</option>
                                            <option value="2023-24">2023-24</option>
                                            <option value="2024-25">2024-25</option>
                                        </select>
                                    </li>
                                    <li id="MonthDropdownLabel">

                                        <select class="form-control" id="month" onchange="" style="border-radius:5px;">
                                            <option value="0">Select Month</option>
                                            <option value="1">April</option>
                                            <option value="2">May</option>
                                            <option value="3">June</option>
                                            <option value="4">July</option>
                                            <option value="5">August</option>
                                            <option value="6">September</option>
                                            <option value="7">October</option>
                                            <option value="8">November</option>
                                            <option value="9">December</option>
                                            <option value="10">January</option>
                                            <option value="11">February</option>
                                            <option value="12">March</option>
                                        </select>
                                    </li>
                                    <li id="DropdownSearch_btn">
                                        <button class="btn btn-success" onclick="Dropdown_Search()">Search</button>
                                    </li>

                                </ul>
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <br />
    <div id="excel_a" class="text-right btn_hide">
        <div class="btn btn-success btn_export"><i class="fa fa-file-excel-o" onclick="Export_a_Table()"> Export To Excel</i></div>
        <input type="button" id="AComponent_Id" onclick="tableToExcel('state_tt', 'Social Event Report')" hidden />
    </div>
    <div id="excel_b" class="text-right btn_hide">
        <div class="btn btn-success btn_export"><i class="fa fa-file-excel-o" onclick="Export_b_Table()"> Export To Excel</i></div>
        <input type="button" id="BComponent_Id" onclick="tableToExcel('district_tt', 'Social Event Report')" hidden />
    </div>
    <div id="excel_c" class="text-right btn_hide">
        <div class="btn btn-success btn_export"><i class="fa fa-file-excel-o" onclick="Export_c_Table()"> Export To Excel</i></div>
        <input type="button" id="CComponent_Id" onclick="tableToExcel('block_tt', 'Social Event Report')" hidden />
    </div>
    <div id="excel_d" class="text-right btn_hide">
        <div class="btn btn-success btn_export"><i class="fa fa-file-excel-o" onclick="Export_d_Table()"> Export To Excel</i></div>
        <input type="button" id="DComponent_Id" onclick="tableToExcel('gp_tt', 'Social Event Report')" hidden />
    </div>
    <br />
    <div class="col-lg-12 col-md-12 col-sm-12  form-body" style="padding-left:5%;width:95%">
        <div class="table-responsive" id="style-1">
            <table id="state_tt" class="table table-striped table-bordered table-striped social-table">
