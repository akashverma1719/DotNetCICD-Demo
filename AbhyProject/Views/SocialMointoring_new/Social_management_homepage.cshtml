<main>
    <div class="container-fluid notice-ribbon">
        <div class="row">
            <div class="col-lg-12">
                <p class="mb-0">To clear cache, please refresh this page by pressing Ctrl + F5.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 Select_option_div">

        <ul class="Select_option pull-left col-md-2 col-sm-2">
