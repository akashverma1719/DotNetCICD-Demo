                    <li>
                        <ul class="arrow_ul_css">

                            <li><img src="~/Content/Agriculture_icons/Social_Management_info-22.png" /></li>
                            <li><i class="fa fa-angle-double-right"></i></li>
                        </ul>

                    </li>
                    <li><span></span></li>
                </ul>
            </a>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-3 sub_total_div" id="social_div_new">
            <a href="~/SocialMointoring_new/Social_management_new">
                @*<a href="~/Home/under_maintainance">*@
                <ul class="ul_image_wsphome ">
                    <li>
                        <ul class="arrow_ul_css">

                            <li><img src="~/Content/Agriculture_icons/Social_Management_info-23.png" /></li>
                            <li><i class="fa fa-angle-double-right"></i></li>
                        </ul>

                    </li>
                    <li><span></span></li>
                </ul>
            </a>
        </div>
    </div>
    <div id="progress">
        <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
            <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                <span class="progress-group-label" data-target="#music" data-toggle="tab">Social Management</span>
                <div class="tri shadow"></div>
                <div class="tri"></div>
            </li>
        </ul>
