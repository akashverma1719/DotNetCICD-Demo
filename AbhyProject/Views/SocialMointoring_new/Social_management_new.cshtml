    function enforceNumberValidation(ele) {
        if ($(ele).data('decimal') != null) {
            // found valid rule for decimal
            var decimal = parseInt($(ele).data('decimal')) || 0;
            var val = $(ele).val();
            if (decimal > 0) {
                var splitVal = val.split('.');
                if (splitVal.length == 2 && splitVal[1].length > decimal) {
                    // user entered invalid input
                    $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                }
            } else if (decimal == 0) {
                // do not allow decimal place
                var splitVal = val.split('.');
                if (splitVal.length > 1) {
                    // user entered invalid input
                    $(ele).val(splitVal[0]); // always trim everything after '.'
                }
            }
        }
    }

    function Get_Month_Number(month) {

        var month_num = "";
        switch (month) {
            case "April":
                month_num = '4';
                break;
            case "May":
                month_num = '5';
                break;
            case "June":
                month_num = "6";
                break;
            case "July":
                month_num = "7";
                break;
            case "August":
                month_num = "8";
                break;
            case "September":
                month_num = "9";
                break;
            case "October":
                month_num = "10";
                break;
            case "November":
                month_num = "11";
                break;
            case "December":
                month_num = "12";
                break;
            case "January":
                month_num = "1";
                break;
            case "February":
                month_num = "2";
                break;
            case "March":
                month_num = "3";
                break;
        }
        return month_num;
    }
    function getCurrentFiscalYear() {
        //get current date
        var today = new Date();
        if ((today.getMonth() + 1) <= 3) {
            fiscalyear = (today.getFullYear() - 1) + "-" + today.getFullYear()
        } else {
            fiscalyear = today.getFullYear() + "-" + (today.getFullYear() + 1)
        }

        if (fiscalyear == "2020-2021") {
            fincalyear = 2020;
        } else if (fiscalyear == "2021-2022") {
            fincalyear = 2021;
        } else if (fiscalyear == "2022-2023") {
            fincalyear = 2022;
        } else if (fiscalyear == "2023-2024") {
            fincalyear = 2023;
        } else if (fiscalyear == "2024-2025") {
            fincalyear = 2024;
        }

        if (fiscalyear == "2020-2021") {
            fiscalyear = "2020-21";
        } else if (fiscalyear == "2021-2022") {
            fiscalyear = "2021-22";
        } else if (fiscalyear == "2022-2023") {
            fiscalyear = "2022-23";
        } else if (fiscalyear == "2023-2024") {
            fiscalyear = "2023-24";
        } else if (fiscalyear == "2024-2025") {
            fiscalyear = "2024-25";
        }

        return (fiscalyear);
    }
    function DropDownInfo() {

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select State Name</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select Gram Panchayat</option>';
                    $("#gram").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';
                        for (var i = 0; i < Jsondata.length; i++) {
                            if (Jsondata[i].state_name != "Delhi_7") {
                                if (!ddlst[Jsondata[i].state_name]) {
                                    all_dists.push(Jsondata[i].state_name);
                                    ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;
                                }
                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
                            else if (a > b) return 1;
                            return 0;
                        });
                        optionState = '<option value="0">Select State Name</option>';
                        for (var i = 0; i < DistArray.length; i++) {
                            if (DistArray[i] != null && DistArray[i] != "") {
                                optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                            }
                        }
                        $("#spnstate").html(optionState);
                    }

                }

                SessionInfo();


            }
        });
    }
