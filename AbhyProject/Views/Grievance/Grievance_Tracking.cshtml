<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script>
    function ReportPdf() {
        $("#data11").width(1080);
        var element = document.getElementById('data11');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'Grievance Status.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#data11").width();
        $('#data11').addClass('background_after_download');
        $('#data11').addClass('table-condensed');

        $('#download').addClass('hideDownload');
        setTimeout(function () {
            $("#data11").width(1150);
            $('#data11').removeClass('background_after_download');
            $('#download').removeClass('hideDownload');

        }, 2000);
    }
</script>
<script>
    $(document).ready(function () {
        $('#RegForm').hide();
        Info();
    });
    var GrievanceId = "";
    function Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance/Grievance_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                var Total = 0;
                var Approved_total = 0;
                var Pending_total = 0;

                if (data.length != 0) {

                    for (var i = 0; i < data.length; i++) {
                        Total = data.length;
                        if (data[i].accept == "Approved") {
                            Approved_total += 1;
                        }
                        else if (data[i].accept == "Pending") {
                            Pending_total += 1;
                        }
                        else if (data[i].accept == "Decline") {
                            Pending_total += 1;
                        }
                        else if (data[i].accept != null) {

                        } else {
                            Pending_total += 1;
                        }
                    }
                }

                $('#Approved_users').text(Approved_total);
                $('#Total_Users').text(Total);
                $('#Pending_users').text(Pending_total);
            }
        });
    }



    function SearchInfo() {

        var grivanceid = $('#Gid').val();
        if (grivanceid != "") {

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance/Grievance_Tracking",
                data: "{'Gid': '" + grivanceid + "'}",
                dataType: 'JSON',
                success: function (response) {
                    $('#Error1').css('display', 'block');
                    
                    if (response == "NoData") {

                        $('#Error1').text("Your Grievance  Id  is Not Matched.. please check your Grievance Id ");
                        $('#Error1').fadeOut(8000, function () {

                        });
                    }
                    else if (response.length != 0) {
                        $('#Error1').hide();
                        $('#subject').text(response.subject);
                        $('#IdentificationId').text(response.IdentificationId);
                        $('#appeal_address_to').text(response.grievance_address_to);
                        $('#appeal_type').text(response.grievance_type);
                        $('#email').text(response.email);
                        $('#mobile').text(response.mobile);
                        $('#phone').text(response.phone);
                        $('#address').text(response.address);
                        $('#description').text(response.grivance_description);
                        $('#complaint_name').text(response.complaint_name);
                        $('#officer_name').text(response.officer_name);
                        $('#RegForm').show();
                        var s1 = "";
                        if (response.accept != null && response.accept != '') {

                            s1 = response.accept;
                        }
                        else {
                            s1 = "Pending";
                        }
                        var off = "";

                        if (response.mail_count_date == null) {
                            off = " (1st Officer)";
                        } else if (response.mail_count1_date == null) {
                            off = " (2nd Officer)";
                        }
                        else if (response.mail_count2_date == null) {
                            off = " (3rd Officer)";
                        }
                        else {
                            off = " (4th Officer)";
                        }
                        var stt = s1 + off;

                        $('#status_pending').text(stt);


                    }

                }
            });
        }
        else {

            alert("Please Enter Grivance Id")
        }
    }
</script>
