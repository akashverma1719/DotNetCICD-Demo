@model AbhyProject.Models.New_Grievance

@{
    /**/

    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}

<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<title>New Grievance Registration</title>

<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .form-group .form-control {
        margin-top: 5px;
    }

    .btn-success,
    .btn-danger {
        float: none;
        right: 0px;
        width: 100px;
    }

    .msg {
        color: red !important;
        font-weight: bold;
    }

    .body {
        font-family: "Open Sans", Helvetica, Arial, sans-serif;
    }



    .hpanel .panel-body {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        padding: 20px;
        position: relative;
        border-top: 2px solid #62cb31;
    }

    .hpanel {
        border: none !important;
        box-shadow: none;
        margin-bottom: 25px;
    }

    .col-md-12 {
        font-size: 16px;
    }

    .about-area .col-md-6 img {
        margin-top: 0px;
    }

    h4 {
        font-size: 20px;
    }

    .refreshicon {
        position: relative;
        right: 21px;
    }

    textarea {
        font-size: 13px !important;
    }

    input {
        font-size: 13px !important;
    }

    .highlight {
        color: red;
    }
</style>
<script>
    $("nav#primary-menu > ul.main-menu > li:nth-child(6)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(6)").siblings().removeClass('active');
    $("nav#primary-menu > ul.main-menu > li:nth-child(6) > ul.dropdown > li:first-child ").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(6) > ul.dropdown > li:first-child ").siblings().removeClass('active');

    function refress() {

        var img = document.getElementById("captchaimg");
        img.src = "/Contact/GetCaptchaImage?query=" + Math.random();


    }
</script>



<div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">Grievance</div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="text-align:center;">
            <img style="width:100%;" src="~/Content/WspImages/Graviance (1).png" />
        </div>
    </div>

    <div class="content-wrapper">

        <div class="content">
            <div class="col-lg-12" style="background-color:#fff;">
                <div class="hpanel">
                    <div class="">

                        <div class="row mt-3">
                            <div class="col-md-12">
                                <section class="content-header">
                                    <h4 style="color: #337ab7; font-size:20px;font-weight:500">New Registration</h4>
                                    <div style="text-align:center;color:red;font-family: initial;"><label id="Error1" style="font-size:20px;"></label></div>

                                </section>



                                <div class="hpanel hgreen">
                                    <div class="panel-body">
                                        <div class="row">
                                            <div class="form-group col-md-12">
                                                Subject : <span class="msg">*</span>
                                                <span id="Grv_sub" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <span id="" class="highlight" style="font-weight:normal;display:none;">Enter alphanumeric only</span>
                                                @*@Html.EditorFor(model => model.subject, new { htmlAttributes = new { @class = "form-control alpha", required = "required", placeholder = "Enter your subject" } })*@
                                                <input type="text" id="subject" name="subject" class="form-control alphanumspecial" required="required" placeholder="Enter your subject" />
                                            </div>
                                            <div class="form-group col-md-6">
                                                Grievance Type : <span class="msg">*</span>
                                                <span id="Grv_type" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>

                                                <select name="grievance_type" id="grievance_type" class="form-control" required>
                                                    <option value="0">--Select Grievance type--</option>
                                                    <option value="All administrative and financial matters">All administrative and financial matters</option>
                                                    <option value="Parliament questions/VIP reference/RTI related matters">Parliament questions/VIP reference/RTI related matters</option>
                                                    <option value="Procurement and Contract Management Related Matters">Procurement and Contract Management Related Matters.</option>
                                                    <option value="Technical and operational issues">Technical and operational issues</option>
                                                    <option value="Training/ Workshop/Seminars">Training/ Workshop/Seminars</option>
                                                    <option value="Others">Others</option>
                                                </select>
                                            </div>
                                            <div class="form-group col-md-6">
                                                Grievance Addressed To : <span class="msg">*</span>
                                                <span id="Grv_address" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <select name="grievance_address_to" id="grievance_address_to" class="form-control" required>
                                                    <option value="0">--Select Grievance addressed To--</option>
                                                    <option value="NPMU">NPMU</option>
                                                    <option value="Gujarat_24">Gujarat</option>
                                                    <option value="Haryana_6">Haryana</option>
                                                    <option value="Karnataka_29">Karnataka</option>
                                                    <option value="Madhya Pradesh_23">Madhya Pradesh</option>
                                                    <option value="Maharashtra_27">Maharashtra</option>
                                                    <option value="Rajasthan_8">Rajasthan</option>
                                                    <option value="Uttar Pradesh_9">Uttar Pradesh</option>

                                                </select>
                                            </div>
                                            <div class="form-group col-md-6">
                                                Complainant Name   : <span class="msg">*</span>
                                                <span id="Grv_complainant_name" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <span id="" class="highlight" style="font-weight:normal;display:none;">Enter alphabetic characters only</span>
                                                <input type="text" class="form-control alphanum" name="complaint_name" id="complaint_name" required="required" maxlength="40" placeholder="Enter your Complainant name" />
                                                @*@Html.EditorFor(model => model.fullname, new { htmlAttributes = new { @class = "form-control alpha", maxlength = "30", required = "required", placeholder = "Enter your full name" } })*@
                                            </div>
                                            <div class="form-group col-md-6">
                                                Email : <span class="msg">*</span>
                                                <span id="Grv_email" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <input type="email" class="form-control mail" id="email" name="email" required="required" maxlength="50" placeholder="Enter your email Id" />

                                                @*@Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control mail", maxlength = "30", placeholder = "Enter your email Id" } })*@
                                            </div>
                                            <div class="form-group col-md-6">
                                                Mobile Number : <span class="msg">*</span>
                                                <span id="Grv_mobile" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <span id="" class="highlight" style="font-weight:normal;display:none;">Enter numeric only</span>
                                                <input type="text" class="form-control integer" id="mobile" name="mobile" required="required" maxlength="10" placeholder="Enter your mobile number" />

                                                @*@Html.EditorFor(model => model.mobile, new { htmlAttributes = new { @class = "form-control integer", maxlength = "10", required = "required", placeholder = "Enter your mobile number" } })*@
                                            </div>
                                            <div class="form-group col-md-6">
                                                Phone Number :
                                                <span id="Grv_phone" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <input type="text" class="form-control integer" required="required" id="phone" name="phone" maxlength="10" placeholder="Enter your Phone Number" />
                                                @*@Html.EditorFor(model => model.phone, new { htmlAttributes = new { @class = "form-control integer", maxlength = "10", placeholder = "Enter your phone number" } })*@
                                            </div>
                                            <div class="form-group col-md-6">
                                                Address : <span class="msg">*</span>
                                                <span id="Grv_address1" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <span id="" class="highlight" style="font-weight:normal;display:none;">Enter alphanumeric only</span>
                                                <textarea name="address" rows="2" cols="20" id="address" class="form-control alphanumspecial" placeholder="Enter your address"></textarea>
                                            </div>
                                            <div class="form-group col-md-6">
                                                Grievance Description : <span class="msg">*</span>
                                                <span id="Grv_description" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                <span id="" class="highlight" style="font-weight:normal;display:none;">Enter alphanumeric only</span>
                                                <textarea name="grivance_description" rows="2" cols="20" id="grivance_description" class="form-control alphanumspecial" placeholder="Enter your message"></textarea>
                                            </div>
                                            <div class="form-group col-md-6">
                                                Supported Document : <span class="msg">(PDF/ JPG/ PNG Only)</span>

                                                <input type="file" name="files" id="files" class="form-control" accept="image/jpg,image/png,application/pdf" autopostback="true">
                                            </div>
                                            <div class="form-group col-md-6" style="margin-top:28px;">
                                                <div style="display:flex; align-items:center;">

                                                    <img src="@Url.Action("GetCaptchaImage","Home")" id="C_img1" />
                                                    <span class="refreshicon"><i class="fa fa-refresh" onclick="refress()"></i></span>
                                                    <span id="Grv_captcha" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                    <input type="text" class="col-md-3 form-control" style="width:60%;" name="clientCaptcha" id="clientCaptcha" placeholder="Type the text" required />

                                                    <p id="status" style="font-weight:bold;color:red;"></p>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-12 text-center">
                                                <button type="button" name="" value="Save" id="btnSubmit" class="btn btn-success ">Submit</button>
                                                @*<button type="reset" value="Reset" id="" class="btn btn-danger">Reset</button>*@

                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<script>
    $(document).ready(function () {
        $(".loader").hide();
    });



    var s = 0;
    var CapchaInfo = "";
    function Checking() {
        

        $.post("@Url.Action("CustomCaptcha", "Grievance")",
        {
            clientCaptcha: $("#clientCaptcha").val(),

        },
        function (data) {
            if (data == 0) {
                CapchaInfo = "Not Matched";
            $("#status").html('<font color="Green"> Not Matched</font>');
            refress();
        }
            else {
                CapchaInfo = "Matched";
        $("#status").html('<font color="Red">Captch process is Succesfully</font>');
                SearchInfo();
        }

        });
        }







        $(function () {
            $("#btnSubmit").click(function () {
                
                Checking();

            });
        });


    function SearchInfo() {

        var i = 0;
        var grivance_description = $('#grivance_description').val();
        if (grivance_description == "") {
            i = 1;
            $('#Grv_description').show();
        }
        else {
            $('#Grv_description').hide();
        }
        var address = $('#address').val();
        if (address == "") {
            i = 1;
            $('#Grv_address1').show();
            //  $('#Error1').text("Please Select Address");
        }
        else {
            $('#Grv_address1').hide();
        }
        var phone = $('#phone').val();
        if (phone == "") {
            i = 1;
            //  $('#Grv_phone').show();
            // $('#Error1').text("Please Select Phone");
        }

        var mobile = $('#mobile').val();
        if (mobile == "") {
            i = 1;
            $('#Grv_mobile').show();
            //  $('#Error1').text("Please Select Mobile");
        }
        else {
            $('#Grv_mobile').hide();
        }
        var email = $('#email').val();
        if (email == "") {
            i = 1;
            $('#Grv_email').show();
            // $('#Error1').text("Please Select Email");
        } else {
            $('#Grv_email').hide();
        }

        var complaint_name = $('#complaint_name').val();
        if (complaint_name == "") {
            i = 1;
            $('#Grv_complainant_name').show();
            //  $('#Error1').text("Please Select Complaint Name");
        } else {
            $('#Grv_complainant_name').hide();
        }

        var grievance_address_to = $('#grievance_address_to').val();
        if (grievance_address_to == "0" && grievance_address_to == "") {
            i = 1;
            $('#Grv_address').show();
            //  $('#Error1').text("Please Select Grievance Address To");
        }
        else {
            $('#Grv_address').hide();
        }

        var grievance_type = $('#grievance_type').val();
        if (grievance_type == "0" && grievance_type == "") {
            i = 1;
            $('#Grv_type').show();
            // $('#Error1').text("Please Select Grievance Type");
        }
        else {
            $('#Grv_type').hide();
        }
        var Subject = $('#subject').val();
        if (Subject == "") {
            i = 1;
            $('#Grv_sub').show();

            // $('#Error1').text("Please Enter Subject");
        }
        else {
            $('#Grv_sub').hide();
        }
        //clientCaptcha
        
        var clientCaptcha = $('#clientCaptcha').val();
        if (clientCaptcha == "") {
            i = 1;

            $('#Grv_captcha').show();
            //   $('#Error1').text("Please Enter Client Captcha");
        }
        
        var Status = $('#status').text();
        if (Status == "Captch process is Succesfully") {
            i = 0;
        } else if (Status == "") {
            i = 1;
            $('#Grv_captcha').show();

        }
        else {
            i = 1;
            $('#Grv_captcha').show();
        }
        
        if (i == 0) {
            $(".loader").show();
            $('#btnSubmit').prop('disabled', true);
            $.ajax({
                url: "/Grievance/Index",
                type: "POST",
                data: function () {
                    var data = new FormData();
                    data.append("grivance_description", jQuery("#grivance_description").val());
                    data.append("address", jQuery("#address").val());
                    data.append("phone", jQuery("#phone").val());
                    data.append("clientCaptcha", jQuery("#clientCaptcha").val());
                    data.append("mobile", jQuery("#mobile").val());
                    data.append("email", jQuery("#email").val());
                    data.append("complaint_name", jQuery("#complaint_name").val());


                    data.append("grievance_type", jQuery("#grievance_type").val());
                    data.append("grievance_address_to", jQuery("#grievance_address_to").val());
                    data.append("subject", jQuery("#subject").val());
                    data.append("files", jQuery("#files").get(0).files[0]);
                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {
                    $(".loader").hide();
                    $('#btnSubmit').prop('disabled', false);
                    $('#Error1').text('Please Check Mail Id');

                    $("#grivance_description").val("");
                    $("#address").val("");
                    $("#phone").val("");

                    $("#mobile").val("");
                    $("#email").val("");
                    $("#complaint_name").val("");
                    $("#files").val("");

                    $("#grievance_type").val("0");
                    $("#grievance_address_to").val("0");
                    $("#subject").val("");
                    $('#clientCaptcha').val("");
                    var String1 = "You Successfully lodged a Grievance. Your Grievance id is " + response;
                    alert(String1);
                    $('#status').text("")
                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                    $('#btnSubmit').prop('disabled', false);
                }
            });
        }
    }

</script>
<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/validations.js"></script>