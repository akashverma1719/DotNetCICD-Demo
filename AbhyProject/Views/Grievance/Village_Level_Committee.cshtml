<script>

    $(document).ready(function () {
        var tr = '<tr style="text-align:center;"><td colspan="8">No Data</td></tr>';
        $("#tbldata").html(tr);
        var tr1 = '<tr style="text-align:center;"><td colspan="11">No Data</td></tr>';
        $("#tbldata1").html(tr1);
    });

    function pgwn_Data() {
        
        var State_name = document.getElementById('state').value;
        var District_name = document.getElementById('dist').value;
        var Block = document.getElementById('block').value;
        var Gname = document.getElementById('gram').value;
        //  var Villname = document.getElementById('village').value;
        var Villname = "";
        pgwn_Data1();
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance/pgwn_Depdetails',
            data: { 'state': State_name, 'dist': District_name, 'block': Block, 'gram': Gname, 'vill': Villname },
            dataType: 'JSON',
            success: function (data) {
                
                a = 1;
                console.log(data);
                let tr = "";

                if (data != null) {
                    for (var i = 0; i < data.length; i++) {

                        tr += '<tr><td><button onclick="Delete_DeptData(' + data[i].pgwndeptid + ')">Delete</button></td><td>' + data[i].designation + '</td><td>' + data[i].department + '</td><td>' + data[i].countname + '</td><td>' + data[i].activepassive + '</td><td>' + data[i].religon + '</td><td>' + data[i].caste + '</td><td> ' + data[i].gender + '</td></tr>';

                    }

                }
                else {
                    tr += '<tr><td colspan="8" style="text-align:center;">No Data</td></tr>';
                }
                if (tr == "") {
                    tr += '<tr><td colspan="8" style="text-align:center;">No Data</td></tr>';
                }

                $("#tbldata").html(tr);

            }
        });

    }
    function pgwn_Data1() {
        var State_name = document.getElementById('state').value;
        var District_name = document.getElementById('dist').value;
        var Block = document.getElementById('block').value;
        var Gname = document.getElementById('gram').value;
        //var Villname = document.getElementById('village').value;
        var Villname = "";
        var FullData = "";
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance/pgwn_personsdetails',
            data: { 'state': State_name, 'dist': District_name, 'block': Block, 'gram': Gname, 'vill': Villname },
            dataType: 'JSON',
            success: function (data) {

                console.log(data);

                let tr = "";
                FullData = data;
                if (data != null) {
                    for (var i = 0; i < data.length; i++) {

                        tr += '<tr><td><button onclick="Delete_PersonalData(' + data[i].pgwnpdid + ')">Delete</button></td><td>' + data[i].male_sc + '</td><td>' + data[i].female_sc + '</td><td>' + data[i].male_st + '</td><td>' + data[i].female_st + '</td><td>' + data[i].male_obc + '</td><td>' + data[i].female_obc + '</td><td>' + data[i].male_minority + '</td><td>' + data[i].female_minority + '</td><td>' + data[i].male_other + '</td><td> ' + data[i].female_other + '</td></tr>';

                    }

                }
                else {
                    tr += '<tr  style="text-align:center"><td colspan="11">No Data</td></tr>';
                }
                if (tr == "") {
                    tr += '<tr><td colspan="11" style="text-align:center;">No Data</td></tr>';
                }
                $("#tbldata1").html(tr);

            }
        });

    }


    function Delete_PersonalData(id) {
        var obj = {};

        obj.pgwnpdid = id;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Grievance/DeletePGWNPersonalDetail",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {

                document.getElementById('PError').innerHTML = response;
                pgwn_Data();
            }
        });

    }


    function Delete_DeptData(id) {
        var obj = {};

        obj.pgwndeptid = id;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Grievance/DeletePGWNDeptDetail",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                pgwn_Data();
                document.getElementById('DError').innerHTML = response;

            }
        });
    }
</script>
<script>
    function pgwn_personsdetails() {
        var State = document.getElementById('state').value;
        if (State != "") {

            var obj = {};
            obj.state_name = document.getElementById('state').value;
            obj.district_name = document.getElementById('dist').value;
            obj.block = document.getElementById('block').value;
            obj.gname = document.getElementById('gram').value;
            // obj.villname = document.getElementById('village').value;
            obj.villname = "";
            obj.male_sc = document.getElementById('male_sc').value;
            obj.female_sc = document.getElementById('female_sc').value;
            obj.male_st = document.getElementById('male_st').value;
            obj.female_st = document.getElementById('female_st').value;
            obj.male_obc = document.getElementById('male_obc').value;
            obj.female_obc = document.getElementById('female_obc').value;
            obj.male_minority = document.getElementById('male_minority').value;
            obj.female_minority = document.getElementById('female_minority').value;
            obj.male_other = document.getElementById('male_other').value;
            obj.female_other = document.getElementById('female_other').value;


            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance/PGWN_PersonsDetails",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    pgwn_Data();

                    document.getElementById('PError').innerHTML = response;
                    canceltwo();
                    ab = 1;
                }


            });

        }
        else {
            alert("Select Dropdowns");
            canceltwo();
            ab = 1;
        }


    }
    function PGWDepDetails() {
        var State = document.getElementById('state').value;
        if (State != "") {
            var obj = {};
            obj.state_name = document.getElementById('state').value;
            obj.district_name = document.getElementById('dist').value;
            obj.block = document.getElementById('block').value;
            obj.gname = document.getElementById('gram').value;
            //obj.villname = document.getElementById('village').value;
            obj.villname = "";
            obj.designation = document.getElementById('designation').value;
            obj.department = document.getElementById('department').value;
            obj.countname = document.getElementById('countname').value;
            obj.activepassive = document.getElementById('activepassive').value;
            obj.religon = document.getElementById('religon').value;
            obj.caste = document.getElementById('caste').value;
            obj.gender = document.getElementById('gender').value;

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance/PGWN_DepetDetails",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    cancelone();
                    a = 1;
                    pgwn_Data();
                    document.getElementById('DError').innerHTML = response;
                }


            });
        }
        else {
            alert("Select State ");
            a = 1;
            cancelone();
        }

    }
</script>
