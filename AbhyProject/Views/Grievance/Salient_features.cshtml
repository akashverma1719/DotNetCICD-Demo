<script>
    function SaveData() {

        var obj = {};


        obj.hydrological_year_bl = document.getElementById('hydrological_year_bl').value;
        obj.hydrological_year_cy = document.getElementById('hydrological_year_cy').value;
        obj.farmers_participate_bl = document.getElementById('farmers_participate_bl').value;
        obj.farmers_participate_cy = document.getElementById('farmers_participate_cy').value;
        obj.farmers_meet_bl = document.getElementById('farmers_meet_bl').value;
        obj.farmers_meet_cy = document.getElementById('farmers_meet_cy').value;
        obj.primary_learning_material_bl = document.getElementById('primary_learning_material_bl').value;
        obj.primary_learning_material_cy = document.getElementById('primary_learning_material_cy').value;
        obj.farming_plotss_bl = document.getElementById('farming_plotss_bl').value;
        obj.farming_plotss_cy = document.getElementById('farming_plotss_cy').value;
        obj.educational_methods_bl = document.getElementById('educational_methods_bl').value;
        obj.educational_methods_cy = document.getElementById('educational_methods_cy').value;
        obj.hydro_ecosystem_analysis_bl = document.getElementById('hydro_ecosystem_analysis_bl').value;
        obj.hydro_ecosystem_analysis_cy = document.getElementById('hydro_ecosystem_analysis_cy').value;
        obj.experimental_plots_bl = document.getElementById('experimental_plots_bl').value;
        obj.experimental_plots_cy = document.getElementById('experimental_plots_cy').value;

        if (obj != {} && obj != null && obj != "") {


            //
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance/Salient_features",
                // data: "{'stateleveldata':'" + JSON.stringify(obj) + "'}",
                data: "{'fwsData':'" + JSON.stringify(obj) + "'}",

                dataType: 'JSON',
                success: function (response) {
                    // Getdivation();


                    document.getElementById('alert').innerHTML = "Saved Successfully...";


                },
                error: function (a) { }
            });


        }
    }

</script>
