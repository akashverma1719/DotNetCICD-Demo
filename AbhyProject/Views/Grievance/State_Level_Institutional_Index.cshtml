    <script type="text/javascript">
        var Jsondata = "";
        $(document).ready(function () {

            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Dashboard/DashboardJsondata',
                data: '',
                dataType: 'JSON',
                success: function (data) {

                    Jsondata = JSON.parse(data);
                    $.each(Jsondata, function (i, stateval) {
                        $("#state").append($('<option></option>').val(stateval.sid).html(stateval.statename));
                    });
                    $("#state").prepend($('<option></option>').val("").html("Select State"));
                    $("#state").val("");


                }
            });
        });

        

        function GettingInfo() {
        
            var Sid = document.getElementById('state').value;
            Operatiionalization_Of_SystemsInfo();
            Statelevel_Inistutional_IndexInfo();
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Grievance/Abhy_Inistutional_capacityInfo',
                data: { 'StateId': Sid },
                dataType: 'JSON',
                success: function (data) {

                    
                    document.getElementById('technical_Trainings').value = data.technical_Trainings;
                    document.getElementById('registered_entities').value = data.registered_entities;
                    document.getElementById('gw_specialists_tp').value = data.gw_specialists_tp;
                    document.getElementById('gw_specialists_fp').value = data.gw_specialists_fp;
                    document.getElementById('grampanchayat_level').value = data.grampanchayat_level;
                    document.getElementById('functional_meetings_for_mnth').value = data.functional_meetings_for_mnth;


                    document.getElementById('data_entry_operator_tp').value = data.data_entry_operator_tp;
                    document.getElementById('data_entry_operator_fp').value = data.data_entry_operator_fp;
                    document.getElementById('Trained_state_or_PIA').value = data.Trained_state_or_PIA;
                    document.getElementById('Social_sciences_Specialists_tp').value = data.Social_sciences_Specialists_tp;
                    document.getElementById('Social_sciences_Specialists_fp').value = data.Social_sciences_Specialists_fp;
                    document.getElementById('O_and_M').value = data.O_and_M;
                }
            });
        }

       function Operatiionalization_Of_SystemsInfo()
       {
           var Sid = document.getElementById('state').value;
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Grievance/Operatiionalization_Of_SystemsInfo',
                data: { 'StateId': Sid },
                dataType: 'JSON',
                success: function (data) {
                    
                    document.getElementById('bi_weekly_or_monthly').value = data.bi_weekly_or_monthly;
                    document.getElementById('frequecy_data_collection_gw_qulaity_and_Quntity').value = data.frequecy_data_collection_gw_qulaity_and_Quntity;
                    document.getElementById('frequecy_data_collection_is_done_sessionally').value = data.frequecy_data_collection_is_done_sessionally;
                    document.getElementById('Dwlr_installed').value = data.Dwlr_installed;
                    document.getElementById('nabl_accredited_labs').value = data.nabl_accredited_labs;
                    document.getElementById('public_viewing').value = data.public_viewing;

                    document.getElementById('no_of_info_collection').value = data.no_of_info_collection;
                    document.getElementById('regular_basics').value = data.regular_basics;

                    document.getElementById('no_of_Observation_wells_DWL').value = data.no_of_Observation_wells_DWL;
                    document.getElementById('no_of_Observation_wells_GV').value = data.no_of_Observation_wells_GV;
                    document.getElementById('no_of_Observation_wells_GE').value = data.no_of_Observation_wells_GE;
                    document.getElementById('no_of_Observation_wells_GL').value = data.no_of_Observation_wells_GL;
                    document.getElementById('no_of_Observation_wells_GQ_Collected').value = data.no_of_Observation_wells_GQ_Collected;
                    document.getElementById('no_of_Observation_wells_GQ_not_collected').value = data.no_of_Observation_wells_GQ_not_collected;
                }
            });
        }
        function Statelevel_Inistutional_IndexInfo()
        {
            var Sid = document.getElementById('state').value;
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Grievance/Statelevel_Inistutional_IndexInfo',
                data: { 'StateId': Sid },
                dataType: 'JSON',
                success: function (data) {
                    document.getElementById('gw_specialits_tp').value = data.gw_specialits_tp;
                    document.getElementById('gw_specialits_tp').value = data.gw_specialits_tp;
                    document.getElementById('gw_specialits_fp').value = data.gw_specialits_fp;
                    document.getElementById('gw_modelers_tp').value = data.gw_modelers_tp;
                    document.getElementById('gw_modelers_fp').value = data.gw_modelers_fp;
                    document.getElementById('rs_gis_tp').value = data.rs_gis_tp;

                    document.getElementById('rs_gis_fp').value = data.rs_gis_fp;
                    document.getElementById('social_tp').value = data.social_tp;

                    document.getElementById('social_fp').value = data.social_fp;
                    document.getElementById('data_analystics_tp').value = data.data_analystics_tp;
                    document.getElementById('data_analystics_fp').value = data.data_analystics_fp;
                    document.getElementById('economics_tp').value = data.economics_tp;
