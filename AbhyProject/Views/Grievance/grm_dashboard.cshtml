<script>
    var StateName = "";
    var Access_Auth = "";
    $(document).ready(function () {
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            
            $('.btn_disabled').prop("disabled", true);
            
        }
        SessionInfo();
        $('#Approved_users').text('0');
        $('#Total_Users').text('0');
        $('#Pending_users').text('0');
    });

    function Reporting() {
        if (StateName != "") {

            window.location = "/Grievance/grm_report";
        }
        else {

            alert("Please Select StateName");
        }
    }

    function SessionInfo() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/mis_new/State_SessionInfo',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                StateName = "ALL";
                Info1();
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                else if (data == "Admin") {
                    $('#spnstate').text('');
                    $('.selectdistshowoption_Admin').show();
                    $('.selectdistshowoption_state').hide();

                    State_Dropdown();

                }
                else {
                    StateName = data;
                    $('#spnstate').text(data);
                    $('.selectdistshowoption_Admin').hide();
                    $('.selectdistshowoption_state').show();


                }



            }

        });
    }


    function State_Dropdown() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/mis_new/PIP_Agency_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }

                var slection_options = '<option value="0">Select State</option>';

                if (data.length != 0) {
                    slection_options += '<option value="ALL">ALL</option>';
                    slection_options += '<option value="NPMU">NPMU</option>';

                    for (var i = 0; i < data.length; i++) {
                        if (data[i].observation_type == "pip") {
                            slection_options += '<option value="' + data[i].state_name + '"> ' + data[i].state_name + ' </option>';
                        }

                    }
                    $('#States_Dropdown').html(slection_options);

                }

                Info();
            }

        });
    }

    function Grivance_Info() {
        var Statename = $('#States_Dropdown').val();
        if (StateName == "ALL") {
            StateName = "ALL";
            Info();
        }
        if (Statename == "0") {
            alert("Please Select StateName")
        }
        else {
            StateName = Statename;

            Info();
        }
    }

    var OfficersInfo = "";
    function Info1() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance/Grievance_Info_statewise_Officers_List',
            data: { 'StateName': StateName },
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (data.length != 0) {

                    OfficersInfo = data;
                }
                Info();
            }
        });
    }
    function Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance/Grievance_Info_statewise_GrmDB',
            data: { 'StateName': StateName },
            dataType: 'JSON',
            success: function (data) {
                
                var Total = 0;
                var Approved_total = 0;
                var Pending_total = 0;
                var tr = '';
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (data.length != 0) {
                    
                    for (var i = 0; i < data.length; i++) {

                        Total = data.length;
                        if (data[i].accept == "Approved") {
                            Approved_total += 1;
                        }
                        else if (data[i].accept == "Pending") {
                            Pending_total += 1;
                        } else if (data[i].accept == "Decline") {

                            Pending_total += 1;

                        } else {
                            Pending_total += 1;
                        }


                        var Status = "";
                        if (data[i].accept == null) {
                            Status = "Pending";
                        }
                        else if (data[i].accept == "Decline") {
                            Status = "Pending";

                        }
                        else if (data[i].accept == "Approved") {
                            Status = "Approved";

                        }



                        var off = "";

                        if (data[i].mail_count_date == null) {
                            off = "1st Officer";
                        } else if (data[i].mail_count1_date == null) {
                            off = "2nd Officer";
                        }
                        else if (data[i].mail_count2_date == null) {
                            off = "3rd Officer";
                        }
                        else {
                            off = "4th Officer";
                        }

                        var OfficerName = "";
                        if (OfficersInfo.length != 0) {
                            for (var j = 0; j < OfficersInfo.length; j++) {
                                
                                if (OfficersInfo[j].state_name == data[i].grievance_address_to) {
                                    if (off == "1st Officer") {
                                        OfficerName = OfficersInfo[j].first_officername;
                                    }
                                    else if (off == "2nd Officer") {
                                        OfficerName = OfficersInfo[j].second_officername;
                                    }
                                    else if (off == "3rd Officer") {
                                        OfficerName = OfficersInfo[j].third_officername;
                                    }

                                    else {
                                        OfficerName = OfficersInfo[j].fourth_officername;
                                    }
                                }
                            }
                        }

                        tr += '<tr><td>' + (i + 1) + '</td><td>' + data[i].IdentificationId + '</td><td>' + data[i].reg_date + '</td><td>' + data[i].grievance_type + '</td><td>' + data[i].grivance_description + '</td><td>' + data[i].subject + '</td><td>' + data[i].grievance_address_to + '</td><td>' + data[i].complaint_name + '</td><td>' + off + '</td><td>' + OfficerName + '</td><td>' + Status + '</td></tr>';

                    }
                }
                if (tr == '') {
                    tr += '<tr><td colspan="10" style="text-align:center;"> No Data</td></tr>';
                    $('#TblData_abc_part').html(tr);
                }
                else {
                    $('#TblData_abc_part').html(tr);
                }

                $('#Approved_users').text(Approved_total);
                $('#Total_Users').text(Total);
                $('#Pending_users').text(Pending_total);
            }
        });
    }
</script>