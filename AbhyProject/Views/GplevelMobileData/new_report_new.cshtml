    function gwl_data() {

        var state = State;
        var dist = Dist;
        var block = Block;
        var gram = Gram;
        var year = $('#year').val();
        var month = $('#month').val();
        var monthaa = $('#month').find('option:selected').text();



        $.ajax({
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            url: '/GplevelMobileData/state_npmu_data_report',
            data: {
                state: state,
                dist: dist,
                block: block,
                gram: gram,
                year: year,
                month: month
            },
            success: function (results) {

                var Tbodyhtml = '';
                if (results == "No Data") {
                    Tbodyhtml = '<tr colspan="8"><td colspan="8" style="text-align: center;">No Data</td></tr>';
                    $('#exesitingwell').html(Tbodyhtml);

                }
                else {

                    var a = 0;
                    var b = 0;
                    var c = 0;
                    var d = 0;
                    var e = 0;
                    var f = 0;
                    var g = 0;

                    for (var i = 0; i < results.length; i++) {

                        var ss = results[i].state;
                        var ssname = ss.split('_');
                        ss = ssname[0];
                        var district = results[i].district;
                        if (district == '0') {
                            district = 'All District'
                        }
                        else {
                            var districtname = district.split('_');
                            district = districtname[0];
                        }

                        var bblock = results[i].block;
                        if (bblock == '0' || bblock == undefined) {
                            bblock = 'All Block'
                        }
                        else {
                            var blockname = bblock.split('_');
                            bblock = blockname[0];
                        }
                        var yy = year;
                        if (yy == '0') {
                            yy = 'All Year'
                        }
                        var mm = monthaa;
                        if (mm == 'Select Month') {
                            mm = 'All Month'
                        }
                        var aa = 0;
                        if (results[i].total_no_of_wells_sations != 0) {
                            aa = (results[i].static_approved_data / results[i].total_no_of_wells_sations) * 100;
                        }
                        var bb = 0;
                        if (results[i].no_of_dynamic_data_entries != 0) {
                            bb = (results[i].dynamic_approved_data / results[i].no_of_dynamic_data_entries) * 100;
                        }
                        a += results[i].total_gp_count;
                        b += results[i].total_no_of_wells_sations;
                        c += results[i].gp_covered;
                        d += results[i].gp_with_no_data;
                        f += results[i].no_of_dynamic_data_entries;
                        e += aa;
                        g += bb;

                        Tbodyhtml += '<tr><td id="srNo"><label>' + (i + 1) + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + ss + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + district + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + bblock + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + yy + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + mm + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + results[i].total_gp_count + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + results[i].total_no_of_wells_sations + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + results[i].gp_covered + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + results[i].gp_with_no_data + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + aa.toFixed(2) + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + results[i].no_of_dynamic_data_entries + '</label></td>';
                        Tbodyhtml += '<td id="rainfall"><label>' + bb.toFixed(2) + '</label></td></tr>';


                    }

                    if (results.length != 1) {

                        Tbodyhtml += '<tr><td colspan="6"><label>' + "Total" + '</label></td>';

                        Tbodyhtml += '<td><label>' + a + '</label></td>';
                        Tbodyhtml += '<td><label>' + b + '</label></td>';
                        Tbodyhtml += '<td><label>' + c + '</label></td>';
                        Tbodyhtml += '<td><label>' + d + '</label></td>';
                        Tbodyhtml += '<td><label></label></td>';
                        Tbodyhtml += '<td><label>' + f + '</label></td>';
                        Tbodyhtml += '<td><label></label></td></tr>';
                    }
                    $('#exesitingwell').html(Tbodyhtml);

                }

                $(".loader").hide();
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });
    }
