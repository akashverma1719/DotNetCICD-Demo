<script>
    function exportTableToExcel(tableID, filename = '') {
        if (State == "0") {
            xx = 1;
            alert("Please Select StateName");
        }
        else {
            var downloadLink;
            var dataType = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8';
            var tableSelect = document.getElementById(tableID);
            var tableHTML = tableSelect.outerHTML.replace(/ /g, '%20');

            // Specify file name
            filename = filename ? filename + '.xlsx' : 'excel_data.xlsx'; // Change file extension to .xlsx for compatibility with XLSX.write

            // Create download link element
            downloadLink = document.createElement("a");

            document.body.appendChild(downloadLink);

            var ws = XLSX.utils.table_to_sheet(tableSelect);
            var wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "MADB Summary Ground Water Level");

            var wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

            function s2ab(s) {
                var buf = new ArrayBuffer(s.length);
                var view = new Uint8Array(buf);
                for (var i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
                return buf;
            }

            // Create a Blob from the binary data
            var blob = new Blob([s2ab(wbout)], { type: dataType });

            // Create an object URL for the Blob and set it as the href attribute of the download link
            downloadLink.href = URL.createObjectURL(blob);

            // Set the download attribute of the link to specify the file name
            downloadLink.download = filename;

            // Trigger the download by simulating a click on the download link
            downloadLink.click();
        }
    }
