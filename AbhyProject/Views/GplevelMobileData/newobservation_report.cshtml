<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script>
    function ReportPdf() {
        $("#Data1").width(1500);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'New_observation_report.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el11' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A3', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('#Data1').addClass('table-condensed');

        $(".highcharts-credits").css("display", "none");
        $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

        $('div#btnExport').addClass('hideDownload');

        $('div#btnExport1').addClass('hideDownload');

        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");


            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
        window.setTimeout(set_detault, 1000);

    }
    function set_detault() {
        $("#Data1").width(1095);
    }
</script>

<script>
    //Code for print page
    function printpage() {
        //Get the print button and put it into a variable
        var printButton = document.getElementById("print");
        //Set the print button visibility to 'hidden'
        //printButton.style.visibility = 'hidden';
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        //Print the page content
        window.print()
        $('div#btnExport').removeClass('hideDownload');
        $('div#btnExport1').removeClass('hideDownload');
        //printButton.style.visibility = 'visible';
    }
</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demo").innerHTML = today;
</script>

<script>
    $(document).ready(function () {

        report_getting();
        sarpanch_getting();


    });

    function report_getting() {
        

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GplevelMobileData/newobservation_getting',
            data: '',
            //data: { 'state': State, 'dist': Dist, 'block': Block, 'gram': Gram,'year': Year },
            //data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                

                $("#state_name").text(data[0].state);
                $("#district_name").text(data[0].district);
                $("#block_name").text(data[0].block);
                $("#gram_panchayat_name").text(data[0].grampanchayat);
                //$("#state_name").text(data[0].objgpdata[0].year);

                if (data[0].length != 0) {



                } else {

                    $('#state_name').text('');
                    $('#district_name').text('');
                    $('#block_name').text('');
                    $('#gram_panchayat_name').text('');

                }
            }
        });

        sarpanch_getting();

    }

    function sarpanch_getting() {
        

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GplevelMobileData/newobservation_getting',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                
                var tr = "";
                var curr_date;
                var curr_month;
                var curr_year;
                var pre_curr_date;
                var pre_curr_month;
                var pre_curr_year;
                var post_curr_date;
                var post_curr_month;
                var post_curr_year;
                $('#tbldata').html(tr);
                if (response.length != 0) {

                    for (var i = 0; i < response.length; i++) {
                        if (response[i].gp['date'] == null) {
                            curr_date = "";
                            curr_month = "";
                            curr_year = "";
                        } else {
                            var nowDate = new Date(parseInt(response[i].gp['date'].substr(6)))
                            curr_date = nowDate.getDate();
                            curr_month = nowDate.getMonth() + 1;    // months are zero based
                            curr_year = nowDate.getFullYear();
                        }
                        if (response[i].gp['pre_date'] == null) {
                            pre_curr_date = "";
                            pre_curr_month = "";
                            pre_curr_year = "";
                        } else {
                            var pre_nowDate = new Date(parseInt(response[i].gp['pre_date'].substr(6)))
                            pre_curr_date = pre_nowDate.getDate();
                            pre_curr_month = pre_nowDate.getMonth() + 1;    // months are zero based
                            pre_curr_year = pre_nowDate.getFullYear();
                        }
                        if (response[i].gp['post_date'] == null) {
                            post_curr_date = "";
                            post_curr_month = "";
                            post_curr_year = "";
                        } else {
                            var post_nowDate = new Date(parseInt(response[i].gp['post_date'].substr(6)))
                            post_curr_date = post_nowDate.getDate();
                            post_curr_month = post_nowDate.getMonth() + 1;    // months are zero based
                            post_curr_year = post_nowDate.getFullYear();
                        }



                        tr += '<tr><td id="srNo_new" rowId = ' + response[i].gp['id'] + '>' + (i + 1) + '</td>';
                        tr += '<td id="newvill">' + response[i].gp['sitename'] + '</td>';
                        tr += '<td id="newlocation">' + response[i].gp['locationdetails'] + '</td>';
                        tr += '<td id="newlatitude">' + response[i].gp['latitude'] + '</td>';
                        tr += '<td id="newlongtude">' + response[i].gp['longitude'] + '</td>';
                        tr += '<td id="date">' + curr_date + "-" + curr_month + "-" + curr_year + '</td>';
                        tr += '<td id="newWellid">' + response[i].gp['wellid'] + '</td>';
                        tr += '<td id="newtypeofwell">' + response[i].gp['typeofwell'] + '</td>';
                        tr += '<td id="newothertypeofwell">' + response[i].gp['other_well_type'] + '</td>';
                        tr += '<td id="newsource">' + response[i].gp['source'] + '</td>';
                        tr += '<td id="PreMonsoon2019">' + response[i].gp['Diameter_of_Well'] + '</td>';
                        tr += '<td id="date">' + response[i].gp['Depth_of_Well'] + '</td>';
                        tr += '<td id="postMonsoon2019">' + response[i].gp['Depth_of_Water_Level'] + '</td>';
                        tr += '<td id="date">' + response[i].gp['Height_of_Measuring_Point'] + '</td>';
                        tr += '<td id="newwaterlevel">' + response[i].gp['groundwater_level'] + '</td>';
                        tr += '<td><a href=' + response[i].gp['image'] + ' id="newimage1">Image</a></td></tr> ';



                    }

                }
                if (tr == '') {
                    tr = '<tr colspan="11"><td colspan="11" style="text-align: center;">No Data</td></tr>';
                }

                $('#tbldata').html(tr);
                $('#newwell').text(response.length);

            }
        });
    }

</script>