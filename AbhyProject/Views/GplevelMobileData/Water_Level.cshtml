        }
    }

    /*Updated Existing observation Well*/
    // var Updated = $('#New').text(data.length);

    var id = 0;
    function updatewell_data() {
        
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/GplevelMobileData/updatewell_data',
            dataType: 'JSON',
            success: function (data) {
                
                var Tbodyhtml = '';
                for (var i = 0; i < data.length; i++) {

