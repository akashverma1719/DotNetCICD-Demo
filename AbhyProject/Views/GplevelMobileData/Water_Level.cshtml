<script type="text/javascript">

    $(document).ready(function () {
        existingwell();
        updatewell_data();
        newwell();


    });

    /*Existing Well*/
    //  var Existing = $('#existing_well_total').text(data.length);
    
    var id = 0;
    var exist = 0;
    var update = 0;
    var new_well = 0;
    function existingwell() {
        
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/GplevelMobileData/Existingwell',
            dataType: 'JSON',
            success: function (data) {
                
                var Tbodyhtml = '';

                for (var i = 0; i < data.length; i++) {

                    Tbodyhtml += '<tr><td id="srNo" rowId = ' + data[i].gp['id'] + '>' + (i + 1) + '</td>';
                    Tbodyhtml += '<td id="vill">' + data[i].gp['sitename'] + '</td>';
                    Tbodyhtml += '<td id="location">' + data[i].gp['locationdetails'] + '</td>';
                    Tbodyhtml += '<td id="latitude">' + data[i].gp['latitude'] + '</td>';
                    Tbodyhtml += '<td id="longtude">' + data[i].gp['longitude'] + '</td>';
                    Tbodyhtml += '<td id = "date">' + data[i].gp['date'] + '</td>';
                    Tbodyhtml += '<td id="Wellid">' + data[i].gp['wellid'] + '</td>';
                    Tbodyhtml += '<td id="typeofwell">' + data[i].gp['typeofwell'] + '</td>';
                    Tbodyhtml += '<td id="email">' + data[i].gp['other_well_type'] + '</td>';
                    Tbodyhtml += '<td id="email">' + data[i].gp['source'] + '</td>';
                    Tbodyhtml += '<td id="PreMonsoon2019">' + data[i].r['pre_monsoon'] + '</td>';
                    Tbodyhtml += '<td id="updatewaterlevel">' + data[i].gp['pre_date'] + '</td>';
                    Tbodyhtml += '<td id="postMonsoon2019">' + data[i].r['post_monsoon'] + '</td>';
                    Tbodyhtml += '<td id="updatewaterlevel">' + data[i].gp['post_date'] + '</td>';
                    Tbodyhtml += '<td id="updatewaterlevel">' + data[i].gp['groundwater_level'] + '</td>';
                    Tbodyhtml += '<td><a href=' + data[i].gp['image'] + ' id="image1">Image</a></td></tr> ';
                    /* Tbodyhtml += '<td><button type="button" class="btn btn-sm btn-primary glyphicon glyphicon-edit editbtn" data-toggle="modal" data-target="#myModal" onclick="editexisting(this)"></button> <button type="button" class="btn btn-sm btn-danger glyphicon glyphicon-trash deletebtn" onclick="deletedata(' + data[i].gp['id'] + ')"></button></td></tr> ';*/


                }
                $('#mainTable tbody').html(Tbodyhtml);
                exist = data.length;
                $('#existing_well_total').text(exist);

            }
        });

    }

    function update() {
        

        var id = $('#updateButton').attr('rowid');
        var village = $('#Village').val();
        var locationdetail = $('#LocationDetails').val();
        var latitude = $('#Latitude').val();
        var longitude = $('#Longitude').val();
        var date = $('#Date').val();
        var widd = $('#widd').val();
        var toww = $('#toww').val();
        var premm = $('#premm').val();
        var post = $('#post').val();
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: '/GplevelMobileData/Updatewell',
            data: function () {
                
                var data = new FormData();
                data.append("id", id);
                data.append("village", village);
                data.append("locationdetail", locationdetail);
                data.append("latitude", latitude);
                data.append("longitude", longitude);
                data.append("Date", date);
                data.append("widd", widd);
                data.append("toww", toww);
                data.append("premm", premm);
                data.append("post", post);
                data.append("txtimage", jQuery("#txtimage").get(0).files[0]);


                return data;
            }(),
            contentType: false,
            processData: false,
            success: function (response) {
                alert(response);
                existingwell();
                updatewell_data();
                newwell();
            },
            error: function () {
                alert('error');
            },
        });
    }

    function deletedata(id) {

        
        var obj = {};
        obj.id = id;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: '/GplevelMobileData/deletewell',
            data: "{'Id': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                existingwell();
                updatewell_data();
                newwell()
            },
            error: function () {
                alert('error');
            },
        });
    }


    function editexisting(param) {

        
        var tr = $(param).closest("tr");
        var RowId = tr.find('#srNo').attr('rowId');
        var village = tr.find('#vill').html();
        var location = tr.find('#location').html();
        var latitude = tr.find('#latitude').html();
        var longtude = tr.find('#longtude').html();
        var date = tr.find('#date').html();
        var wellid = tr.find('#wellid').html();
        var Type1 = tr.find('#typeofwell').html();
        var pre1 = tr.find('#PreMonsoon2019').html();
        var post1 = tr.find('#postMonsoon2019').html();
        var image = tr.find('#image').html();


        $('#Village').val(village);
        $('#LocationDetails').val(location);
        $('#Latitude').val(latitude);
        $('#Longitude').val(longtude);
        $('#Date').val(date);
        $('#widd').val(wellid);
        $('#toww').val(Type1);
        $('#premm').val(pre1);
        $('#post').val(post1);
        $('#txtimage').val(image);
        $('#updateButton').attr('rowid', RowId);

    }


    function Excel() {
        
        var xx = 0;
        if (xx == 0) {
            window.location = "/GplevelMobileData/exesitingwellexcel";
        }
    }

    function New_Excel() {
        
