<style>
    .color_database {
        color: green !important;
    }

    #imageView label {
        margin-left: 10px;
        margin-top: 10px;
        font-size: 12px;
        width: 246px;
    }

    ul[id$="_menu"] > li > a:hover > label, ul[id$="_menu"] > li > a:focus > label, ul[id$="_menu"] > li.active > a > label {
        border-color: #337ab7;
        background-color: #337ab7c7;
        color: #fff;
    }
    .blinker p {
        font-size: 15px;
        color: #f30606;
        animation: blinker 4s linear infinite;
        margin-bottom: 34px;
    }

    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }
</style>


<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
    /*table fix code*/
    .pseudolink {
        color: blue;
        text-decoration: underline;
        cursor: pointer;
    }

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    /*ends here*/
    .new_wd {
        width: 255px !important;
    }

    #Surface_menu {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .Select_option_div {
        box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 17px 0px;
        padding: 20px;
        border: 1px solid #dfdbdb;
        border-radius: 10px;
        background: linear-gradient(to right, #ece9e6, #ffffff);
    }

    ul.Select_option {
        display: flex;
        justify-content: space-between;
    }

    .StateLabel {
        padding: 8px;
    }

    .display_flex {
        font-size: 12px;
    }

    .number_count_div {
        display: flex;
        justify-content: space-between;
    }

    .comn_table {
        background: #f2f2f2;
    }

        .comn_table thead th {
            border: 1px solid #fff;
        }

    #style-1::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background-color: #F5F5F5;
        border-radius: 25px;
    }

    #style-1::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
    }

    .tbl-responsive {
        box-shadow: rgba(149, 157, 165, 0.2) 0px -6px 22px !important;
        background: #f2f2f2 !important;
        overflow: auto;
        height: 500px;
    }

    #currentgeopageno {
        display: inline !important;
    }

    .notice-ribbon {
        font-size: 14px;
        background: #3585dc;
        color: #fff;
        text-align: center;
        padding: 10px;
    }

        .notice-ribbon p {
            font-size: 14px;
            color: #fff;
            margin-bottom: 0px;
        }

    .content__text_marquee {
        padding: 5px;
        color: #000;
    }

    .marquee {
        width: 100%;
        /*overflow: hidden;*/
        white-space: nowrap;
        box-sizing: border-box;
        animation: marquee 20s linear infinite;
    }

    .marquee-content {
        display: inline-block;
        padding-left: 100%;
    }

    @@keyframes marquee {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-100%);
        }
    }
</style>

