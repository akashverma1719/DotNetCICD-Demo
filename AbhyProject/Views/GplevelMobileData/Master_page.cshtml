    function enforceNumberValidation_well(i, ele) {

        let j = i.toString();
        /*var i = aaa;*/
        var match = false;
        var match2 = false;
        var matchwr = false;
        var matchwr2 = false;
        var lat = $('#latitude_well' + j).val();
        var long = $('#longitude_well' + j).val();




        if (!(lat.indexOf(".") == -1)) {
            match = true; // decimal
        } else {
            match = false;
        }
        if (lat.length == 2 && match != true) {
            $('#latitude_well' + j).val(lat + '.');
        } else if (lat.length == 1 && match != false) {
            $('#latitude_well' + j).val('');
        }


        if (!(long.indexOf(".") == -1)) {
            match2 = true; // decimal
        } else {
            match2 = false;
        }
        if (long.length == 2 && match2 != true) {
            $('#longitude_well' + j).val(long + '.');
        } else if (long.length == 1 && match2 != false) {
            $('#longitude_well' + j).val('');
        }


        var latwr = $('#latitude_well' + j).val();
        var longwr = $('#longitude_well' + j).val();

        if (!(latwr.indexOf(".") == -1)) {
            matchwr = true; // decimal
        } else {
            matchwr = false;
        }
        if (latwr.length == 2 && matchwr != true) {
            $('#latitude_well' + j).val(latwr + '.');
        } else if (latwr.length == 1 && matchwr != false) {
            $('#latitude_well' + j).val('');
        }


        if (!(longwr.indexOf(".") == -1)) {
            matchwr2 = true; // decimal
        } else {
            matchwr2 = false;
        }
        if (longwr.length == 2 && matchwr2 != true) {
            $('#longitude_well' + j).val(longwr + '.');
        } else if (longwr.length == 1 && matchwr2 != false) {
            $('#longitude_well' + j).val('');
        }


        if ($(ele).data('decimal') != null) {
            // found valid rule for decimal
            var decimal = parseInt($(ele).data('decimal')) || 0;
            var val = $(ele).val();
            if (decimal > 0) {
                var splitVal = val.split('.');
                if (splitVal.length == 2 && splitVal[1].length > decimal) {
                    // user entered invalid input
                    $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                }
            } else if (decimal == 0) {
                // do not allow decimal place
                var splitVal = val.split('.');
                if (splitVal.length > 1) {
                    // user entered invalid input
                    $(ele).val(splitVal[0]); // always trim everything after '.'
                }
            }
        }
    }
    function Delete_well(ss) {
        if (confirm("Are you sure you want to Delete this entry?")) {
            var obj = {};
            obj.gid = ss;
            $.ajax({
                type: "POST",
                contentType: "application/json;charset=utf-8",
                url: "/GplevelMobileData/Delete_welldata",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    click_well += 1;
                    if (response == "Logout") {
                          window.location = "/Home/LogOut";
                    }
                    else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                        window.location = "/Error/DefaultError";
                    }
                    PageNumber = PageNumber;
                    if (PageNumber == 1) {
                        sno = 0;
                        countwell = 0;
                    } else {
                        var ssd = (PageNumber - 1);
                        var sdsd = ssd * 100;
                        sno = sdsd;
                    }
                    //PageNumber = 1;
                    //sno = 0;
                    //countwell = 0;
                    totalwellss = 0;
                    totalWellinventory();
                }
            });
        }
    }
