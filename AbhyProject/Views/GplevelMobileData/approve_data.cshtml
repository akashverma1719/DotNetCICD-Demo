    <script type="text/javascript">



        var Other_Total = 0, other_demand_ground_water = 0, other_demand_surface_water = 0;
        function Other_Usage_Info() {
            
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Wsp_new/WaterOther_Usage_Info_Details',
                data: '',
                dataType: 'JSON',
                success: function (response) {

                    
                    if (response == "Logout") {
                          window.location = "/Home/LogOut";
                    }
                    Other_Total = 0, other_demand_ground_water = 0, other_demand_surface_water = 0;
                    var tr = '';


                    if (response.length != 0) {
                        for (var i = 0; i < response.length; i++) {

                            if (response[i].other_demand_ground_water != null && response[i].other_demand_ground_water != "") {
                                other_demand_ground_water += parseFloat(response[i].other_demand_ground_water);
                            }
                            if (response[i].other_demand_surface_water != null && response[i].other_demand_surface_water != "") {
                                other_demand_surface_water += parseFloat(response[i].other_demand_surface_water);
                            }

                        }
                    }


                    

                    Industry_Total = industry_demand_surface_water + industry_demand_ground_water;

                    Other_Total = other_demand_ground_water + other_demand_surface_water;

                    var Total = Domestic_Total + Irrigated_Total + Industry_Total + Other_Total;


                    $('#WaterUtilization').text(Total.toFixed(2));
                }
            });
        }
        function SessionInfo() {

            var obj = {};
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/SocialMointoring/State_SessionInfo_1",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (data) {

                    if (data == "Logout") {
                          window.location = "/Home/LogOut";
                    }
                    else {
                        $('#Error_').text("");

                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').hide();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').hide();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').hide();
                        $('#DropdownSearch_btn').hide();

                        var Str = data.split(',');
                        if (Str[0] == "Admin") {
                            $('#StateLabel').hide();
                            $('#StateDropdownLabel').show();
                            $('#DistLabel').hide();
                            $('#DistDropdownLabel').show();
                            $('#BlockLabel').hide();
                            $('#BlockDropdownLabel').show();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();

                        }
                        else if (Str[0] == "State Level Nodal Officer") {
                            State = Str[1];
                            off_1 = "state";
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').hide();
                            $('#DistDropdownLabel').show();
                            $('#BlockLabel').hide();
                            $('#BlockDropdownLabel').show();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            State_Dropdown_Function();
                            State_Dropdown_Function();

                        }
                        else if (Str[0] == "District Level Nodal Officer") {
                            off_1 = "dist";
                            State = Str[1];
                            Dist = Str[2];
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').show();
                            $('#DistDropdownLabel').hide();
                            $('#BlockLabel').hide();
                            $('#BlockDropdownLabel').show();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            Dist_fun();
                            Dist_fun();

                        }
                        else if (Str[0] == "Block Level Nodal Officer") {
                            off_1 = "block";
                            State = Str[1];
                            Dist = Str[2];
                            Block = Str[3];
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').show();
                            $('#DistDropdownLabel').hide();
                            $('#BlockLabel').show();
                            $('#BlockDropdownLabel').hide();
                            $('#GramLabel').hide();
                            $('#GramDropdownLabel').show();
                            $('#DropdownSearch_btn').show();
                            Block_fun();
                            Block_fun();

                        }
                        else if (Str[0] == "Gram Panchyat Nodal Officer") {
                            State = Str[1];
                            Dist = Str[2];
                            Block = Str[3];
                            Gram = Str[4];
                            $('#StateLabel').show();
                            $('#StateDropdownLabel').hide();
                            $('#DistLabel').show();
                            $('#DistDropdownLabel').hide();
                            $('#BlockLabel').show();
                            $('#BlockDropdownLabel').hide();
                            $('#GramLabel').show();
                            $('#GramDropdownLabel').hide();
                            $('#DropdownSearch_btn').hide();

                        }


                    }
                }

            });

        }
        function DropDownInfo() {

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Home/Sign_Up_DropdownInfo",
                data: "{ }",
                dataType: 'JSON',
                success: function (response) {
                    
                    if (response.length != 0) {
                        Jsondata = response;
                        $("#spnstate").empty();
                        var opstate = '<option value="0">Select StateName</option>';
                        $("#spnstate").append(opstate);
                        $("#dist11").empty();
                        var opdist = '<option value="0">Select District</option>';
                        $("#dist11").append(opdist);
                        $("#block1").empty();
                        var opblock = '<option value="0">Select Block</option>';
                        $("#block1").append(opblock);
                        $("#gram").empty();
                        var opgram = '<option value="0">Select GramPanchayat</option>';
                        $("#gram").append(opgram);
                        //var StateName = $("#spnstate").text();
                        if (Jsondata.length != 0) {
                            var ddlst = {};
                            var all_dists = [];
                            var optionState = '';
                            for (var i = 0; i < Jsondata.length; i++) {

                                if (!ddlst[Jsondata[i].state_name]) {
                                    all_dists.push(Jsondata[i].state_name);
                                    ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                                }
                            }
                            var DistArray = [];
                            DistArray = all_dists.sort(function (a, b) {
                                if (a < b) return -1;
                                else if (a > b) return 1;
                                return 0;
                            });
                            optionState = '<option value="0">Select StateName</option>';
                            for (var i = 0; i < DistArray.length; i++) {
                                if (DistArray[i] != null && DistArray[i] != "") {
                                    optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                                }
                            }
                            $("#spnstate").html(optionState);
                        }

                    }

                    SessionInfo();


                }
            });
        }
        function State_Dropdown_Function() {

            $("#dist11").empty();
            var opdist = '<option value="0">Select District</option>';
            $("#dist11").append(opdist);
            $("#block1").empty();
            var opblock = '<option value="0">Select Block</option>';
            $("#block1").append(opblock);
            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);

            var StateName = $("#spnstate").val();
            if (off_1 == "state") {
                StateName = State;
            } else {
                State = StateName;
            }

            if (StateName != "0" && Jsondata.length != 0) {
                var ddlst = {};
                var all_dists = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata.length; i++) {
                    if (StateName == Jsondata[i].state_name) {

                        if (!ddlst[Jsondata[i].district_name]) {
                            all_dists.push(Jsondata[i].district_name);
                            ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                        }
                    }
                }


                var DistArray = [];
                DistArray = all_dists.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < DistArray.length; i++) {
                    if (DistArray[i] != null && DistArray[i] != "") {
                        optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                    }
                }
                $("#dist11").append(optionDist);
            }

        }
        function Dist_fun() {
            
            $("#block1").empty();
            var opblock = '<option value="0">Select Block</option>';
            $("#block1").append(opblock);
            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);

            var dist = $("#dist11").val();
            if (off_1 == "dist") {
                dist = Dist;
            } else {
                Dist = dist;
            }
            console.log(Jsondata);
            console.log(dist);
            console.log(State);
            if (dist != "0" && Jsondata.length != 0) {
                var ddlst = {};
                var all_blocks = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata.length; i++) {
                    //if (Jsondata[i].district_name == 'Kaithal' ) {
                    //    alert(dist);

                    //    return;
                    //}

                    if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                        if (!ddlst[Jsondata[i].block_name]) {
                            all_blocks.push(Jsondata[i].block_name);
                            ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                            //  $("#block").append(optionDist);
                        }
                    }
                }


                var BlockArray = [];
                BlockArray = all_blocks.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < BlockArray.length; i++) {
                    if (BlockArray[i] != null && BlockArray[i] != "") {
                        optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
                    }
                }
                $("#block1").append(optionDist);

            }
        }
        function Block_fun() {

            $("#gram").empty();
            var opgram = '<option value="0">Select GramPanchayat</option>';
            $("#gram").append(opgram);
            var block = $("#block1").val();

            if (off_1 == "block") {
                block = Block;
            } else {
                Block = block;
            }


            if (block != "0" && Jsondata.length != 0) {
                var ddlst = {};
                var all_grams = [];
                var optionDist = '';
                for (var i = 0; i < Jsondata.length; i++) {
                    if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                        if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                            ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                            all_grams.push(Jsondata[i].gram_panchayat_name);
                            //   $("#gram").append(optionDist);
                        }
                    }
                }


                var GramArray = [];
                GramArray = all_grams.sort(function (a, b) {
                    if (a < b) return -1;
                    else if (a > b) return 1;
                    return 0;
                });
                for (var i = 0; i < GramArray.length; i++) {
                    if (GramArray[i] != null && GramArray[i] != "") {

                        optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
                    }
                }
                $("#gram").append(optionDist);
            }
        }
        function Gram_change() {
            var Gram1 = $("#gram").val();
            if (Gram1 == "0") {
                alert("Please Select Grampanchayat");
            } else {
                Gram = $('#gram').val();
            }
        }
        function Dropdown_Search() {
            
            if (Gram != "0") {

            } else {
                Gram = $('#gram').val();
            }

            var xx = 0;
            if (State == "0") {
                xx = 1;
                alert("Please Select State Name");
            }

            if (xx == 0) {

                $.ajax({
                    type: "Post",
                    url: "/Home/StateLevel_Dropdown",
                    contentType: "application/json;charset=utf-8",
                    data: "{'StateName':'" + State + "','Dist':'" + Dist + "','Block':'" + Block + "','Gram':'" + Gram + "'}",
                    dataType: "json",
                    success: function (results) {


                    }
                });
            }
        }

    </script>
