    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            debugger;
            $('#deleteButton').click(function (e) {
                debugger;
                e.preventDefault(); // Prevent form submission

                var selectedEntries = $('input[name="entry[]"]:checked').map(function () {
                    return this.value;
                }).get();

                if (selectedEntries.length != 0) {
                    var obj = {};
                    obj.id = selectedEntries;
                    $.ajax({
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        url: "/GplevelMobileData/Delete_social",
                        data: "{'Data': '" + JSON.stringify(obj) + "'}",
                        dataType: 'JSON',
                        success: function (response) {
                            alert(response);
                            if (response == "Logout") {
                                window.location = "/WspNew/WSP_GWM_HOME";
                            }
                            else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                                window.location = "/Error/DefaultError";
                            }

                            ssno = 0;
                            count = 0;
                            totalsocialss = 0;
                            socialtotal();

                        }
                    });
                } else {
                    alert('Please select at least one entry to delete.');
                }
            });
        });

    </script>




    <script src="~/Scripts/jquery-3.3.1.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            var StateOfficer = '@Session["Officer"]';
        if (StateOfficer == "") {
            window.location = "/WspNew/WSP_GWM_HOME";
        }
        });
        function Excel() {
            var year = $('#year').val();
            var month = $('#month').val();

            if (State == "0") {
                alert("Please Select State");
                return false;
            } {
                window.location.href = "/GplevelMobileData/socialevent?state1=" + State + "&district1=" + Dist + "&block01=" + Block + "&gp1=" + Gram + "&year1=" + year + "&month1=" + month;
            }
        }

        //function Excel() {
        //    if (State == "0") {
        //        alert("Please Select State");
        //        return false;
        //    }
        //    {
        //        window.location = "/GplevelMobileData/socialevent";
        //    }
        //}
        function Report_PDF() {
            if (State == "0") {
                alert("Please Select State");
                return false;
            }
            {
                window.location = "/GplevelMobileData/Social_report";
            }
        }



        var id = 0;
        function GetData() {        //inserting data into tbale

            let tr = "";
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: '/GplevelMobileData/Fetch_Social_Monitoring',
                dataType: 'JSON',
                success: function (data) {

                    $("#tb1").find("tr:gt(1)").remove();

                    for (var i = 0; i < data.length; i++) {

                        tr += '<tr><td id="one">' + (i + 1) + '</td>  ';
                        tr += '<td id="two" RowId=' + data[i].id + '>' + data[i].village + '</td>  ';
                        tr += '<td id="thr">' + data[i].location + '</td>  ';
                        tr += '<td id="fou">' + data[i].latitude + '</td>   ';
                        tr += '<td id="fiv">' + data[i].longitude + '</td>   ';
                        tr += '<td id="six">' + data[i].date + '</td>   ';
                        tr += '<td id="sev">' + data[i].event1 + '</td>   ';
                        tr += '<td id="eig">' + data[i].male + '</td>   ';
                        tr += '<td id="nin">' + data[i].female + '</td>   ';
                        tr += '<td id="ten">' + data[i].others + '</td>   ';
                        tr += '<td id="ele">' + data[i].numberofattendees + '</td>   ';
                        tr += '<td id="twe"><a href="' + data[i].minutesofmeeting + '">MOM file</a></td> ';
                        tr += '<td id="thi"><a href="' + data[i].image + '">Image</a></td> ';
                    }

                    $("#tb1").append(tr);
                    $('#social_total').text(data.length);
                }

            })

        }


        function DeleteBtn(ID) {//delete data from socialmonitoring
            debugger;
            if (confirm('delete')) {
                $.ajax({
                    url: "/GplevelMobileData/DeleteDatas?Datas=" + ID,
                    type: "POST",
                    contentType: "application/json;charset=UTF-8",
                    dataType: "json",
                    success: function () {
                        //code to delete from view
                        GetData();

                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                    }
                });
            }

        }


        function UpdateBtn() {  //SocMon update code
            debugger;
            //tblSocial = {

            var id = $('#btnUpdate').attr('Rowid');
            var village = $('#text2').val();
            var location = $('#text3').val();
            var latitude = $('#text4').val();
            var longitude = $('#text5').val();
            var date = $('#text6').val();
            var event1 = $('#text7').val();
            var male = $('#text8').val();
            var female = $('#text9').val();
            var others = $('#text10').val();
            var numberofattendees = $('#text11').val();
            var mom_filename = $('#text12').val();



            $.ajax({
                url: "/GplevelMobileData/UpdateData",
                type: "POST",
                contentType: "application/json;charset=utf-8",
                data: function () {
                    var data = new FormData();
                    //data.append("btnUpdate", ID);
                    data.append("id", id);
                    data.append("text2", village);
                    data.append("text3", location);
                    data.append("text4", latitude);
                    data.append("text5", longitude);
                    data.append("text6", date);
                    data.append("text7", event1);
                    data.append("text8", male);
                    data.append("text9", female);
                    data.append("text10", others);
                    data.append("text11", numberofattendees);
                    data.append("text12", mom_filename);
                    data.append("text13", jQuery("#text13").get(0).files[0]);
                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (result) {
                    alert(result);
                    GetData();

                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }


        function EditBtn(event) {   //edit btn assign value
            // console.log(event);

            var tr = $(event).closest("tr");
            var sno = tr.find("#one").html();
            var rowId = tr.find("#two").attr('rowId');
            var village = tr.find("#two").html();
            var locdet = tr.find("#thr").html();
            var lat = tr.find("#fou").html();
            var long = tr.find("#fiv").html();
            var date = tr.find("#six").html();      //date
            var noe = tr.find("#sev").html();
            var mal = tr.find("#eig").html();
            var fem = tr.find("#nin").html();
            var tra = tr.find("#ten").html();
            var tnoa = tr.find("#ele").html();
            var mom = tr.find("#twe").html();
            var imu = tr.find("#thi").html();

            $("#btnUpdate").attr('Rowid', rowId);
            $('#text1').val(sno);
            $('#text2').val(village);
            $('#text3').val(locdet);
            $('#text4').val(lat);
            $('#text5').val(long);
            $('#text6').val(date);
            $('#text7').val(noe);
            $('#text8').val(mal);
            $('#text9').val(fem);
            $('#text10').val(tra);
            $('#text11').val(tnoa);
            $('#text12').val(mom);
            $('#text13').val('');
            $('#text13').attr('Default', imu);



        }


    </script>
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>
    <script>
        $(function () {
            $("#datepicker").datepicker({
                dateFormat: 'dd-mm-yy',
                changeMonth: true,
                changeYear: true,
            });
        });
