<body>
    <center>
        <div class="text-h g-mb-20" style="font-size: 35px; color:white; font-family: raleway; margin-top: 10px; font-weight: 900; background-color: #72a230">
            Social Event
        </div>
        @*<div class="text-h g-mb-20" style="padding: 0px; color: #337ab7; font-size: 45px; font-family:raleway;margin-top:-10px;font-weight:900">

            </div>*@
