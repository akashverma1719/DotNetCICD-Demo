    <br />

    <div class="tab-content">
        <!--Rainfail_menu Start-->
        <div role="tabpanel" class="tab-pane fade in active" id="music">
            <div class="container-fluid">
                <!--images Row Started-->
                <div class="clearfix">

                    <div class="col-md-12 Select_option_div">

                        <ul class="Select_option col-md-12 col-sm-8  text-left">
                            <li id="StateLabel">
                                <label id="lblstate">State:</label>
                                <span id="spnstate1">@Session["gstate"]</span>
                            </li>
                            <li id="StateDropdownLabel">

                                <select class="form-control" id="spnstate" onchange="State_Dropdown_Function()">
                                </select>
                            </li>

                            <li id="DistLabel">
                                <i class="fas fa fa-angle-double-right"></i>
                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                            </li>

                            <li id="DistDropdownLabel">

                                <select class="form-control" id="dist11" onchange="Dist_fun()">
                                </select>
                            </li>

                            <li id="BlockLabel">
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Block:</label>
                                <span>@Session["gblock"] </span>
                            </li>

                            <li id="BlockDropdownLabel">

                                <select class="form-control" id="block1" onchange="Block_fun()">
                                </select>
                            </li>
                            <li id="GramLabel">
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Gram panchayat:</label>
                                <span>@Session["ggram"]</span>
                            </li>

                            <li id="GramDropdownLabel">

                                <select class="form-control" id="gram" onchange="Gram_change()">
                                </select>
                            </li>
                            <li>
                                <select class="form-control" id="year">
                                    <option value="0">Select  Year</option>
                                    <option value="2020">2020</option>
                                    <option value="2021">2021</option>
                                    <option value="2022">2022</option>
                                    <option value="2023">2023</option>
                                    @*<option value="2024">2024</option>
                                        <option value="2025">2025</option>*@

                                </select>
                            </li>
                            <li id="MonthDropdownLabel">

                                <select class="form-control" id="month" onchange="Month_change()">
                                    <option value="0">Select Month</option>
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>
                                </select>
                            </li>
                            <li id="DropdownSearch_btn">
                                <button class="btn btn-success" onclick="Dropdown_Search()">Search</button>
                            </li>
                            @*<li>
                                    <a href="~/GplevelMobileData/MobileData" class="btn btn-success" style="margin-left: 8px;">
                                        Back To MADB Home
                                    </a>
                                </li>*@
                        </ul>

                    </div>
                </div>
            </div>
        </div>
    </div>
