    function GetSocialData() {
        debugger
        $(".loader").show();
        var year = $("#year").val();
        $.ajax({
            type: "POST",
            contentType: 'application/json; chatset=utf-8',
            url: "/Tracker/GetSocialData",
            data: "{'state': '" + State + "','district': '" + Dist + "','block': '" + Block + "','gram': '" + Gram + "','year': '" + year + "'}",
            dataType: 'JSON',
            success: function (data) {
                debugger
                var tr = '';
                var j = 1;
                var TotDistrinctCount = 0;
                var TotBlockCount = 0;
                var TotGpCount = 0;
                var TotSavedGP = 0;
                var NotSavedGP = 0;
                var TotNotSavedGP = 0;
                var TotSubmitGP = 0;
                var TotRejectGP = 0;
                var TotApprovedGP = 0;
                var NotSubmitGP = 0;
                var TotNotSubmitGP = 0;
                var SubmittedGPatDPMU = 0;
                var TotSubmittedGPatDPMU = 0;
                //var TotRejectBySPMU = 0;
                //var TotApprovedBySPMU = 0;
                console.log(data)
                if (data.length != 0) {
                    
                    for (var i = 0; i < data.length; i++) {
                        
                        TotDistrinctCount += data[i].DistrinctCount;
                        TotBlockCount += data[i].BlockCount;
                        TotGpCount += data[i].GpCount;
                        TotSavedGP += data[i].SavedGP;
                        //NotSavedGP = data[i].GpCount - data[i].SavedGP;                       
                        NotSavedGP = data[i].TotalGPCOUNT - data[i].SavedGP;                       
                        NotSubmitGP = data[i].SavedGP - (data[i].ApprovedGP + data[i].SubmitGP);
                        SubmittedGPatDPMU = data[i].SavedGP - NotSubmitGP;
                        TotNotSavedGP += NotSavedGP;
                        TotSubmitGP += data[i].SubmitGP;
                        TotRejectGP += data[i].RejectGP;
                        TotApprovedGP += data[i].ApprovedGP;
                        TotNotSubmitGP += NotSubmitGP;
                        TotSubmittedGPatDPMU += SubmittedGPatDPMU;
                        //TotRejectBySPMU += data[i].RejectBySPMU;
                        //TotApprovedBySPMU += data[i].ApprovedBySPMU;
                        tr += '<tr><td>' + j++ + '</td>';
                        tr += '<td>' + data[i].StateName + '</td>';
                        tr += '<td>' + data[i].DistrinctCount + '</td>';
                        tr += '<td>' + data[i].BlockCount + '</td>';
                        tr += '<td>' + data[i].GpCount + '</td>';
                        tr += '<td>' + data[i].SavedGP + '</td>';
                        tr += '<td>' + NotSubmitGP + '</td>';
                        tr += '<td>' + NotSavedGP + '</td>';                       
                        tr += '<td>' + SubmittedGPatDPMU + '</td>';
                        tr += '<td>' + data[i].SubmitGP + '</td>';
                        tr += '<td>' + data[i].RejectGP + '</td>';
                        tr += '<td>' + data[i].ApprovedGP + '</td></tr>';
                        //tr += '<td>' + data[i].RejectBySPMU + '</td>';
                        //tr += '<td>' + data[i].ApprovedBySPMU + '</td></tr>';
                    }
                } else {
                    tr = '<tr style="text-align:center;"><td colspan="8" style="text-align:center;">No Data</td></tr>';
                }
                if (NodalOfficer == "National Level Nodal Officer" || NodalOfficer == "Admin") {
                    if (j > 2) {
                        tr += '<tr><td style="background-color:orange;color:#fff">Total</td><td></td><td>' + TotDistrinctCount + '</td><td>' + TotBlockCount + '</td><td>' + TotGpCount + '</td><td>' + TotSavedGP + '</td><td>' + TotNotSubmitGP + '</td><td>' + TotNotSavedGP + '</td><td>' + TotSubmittedGPatDPMU + '</td><td>' + TotSubmitGP + '</td><td>' + TotRejectGP + '</td><td>' + TotApprovedGP + '</td></tr>'
                    }
                }
                $("#Social_TrackData").html(tr);
                $(".loader").hide();

            }
        });
    }


