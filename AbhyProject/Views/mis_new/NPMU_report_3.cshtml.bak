                                <td class="text-center">No. of GPs in which well Inventory Completed(At Least 50 % of Well Inventory)</td>
                                @*<td class="text-center">No. of existing Wells in GPs (Well Inventory Initiated)</td>
                                    <td class="text-center">No. of existing Wells in GPs (Well Inventory Completed)</td>*@
                                <td class="text-center">Total No. of existing Wells</td>
                                <td class="text-center">Total No. of wells inventoried</td>
                                <td class="text-center">No. of  wells monitored for water level</td>
                                <td class="text-center">No. of  wells from which water quality sample collected</td>
                                <td class="text-center">Number of GPs with approved Water Budgets</td>
                                <td class="text-center">Number of GPs with approved Water Security Plans</td>
                                <td class="text-center">No. of GPs-GPDCI Module (Basic Information Updated)/Completed</td>
                                <td class="text-center">No. of Environmental Module completed (Baseline Information updated) in the MIS</td>
                                <td class="text-center">No. of Social Management Module Completed in the MIS</td>
                                <td class="text-center">Drip Irrigation</td>
