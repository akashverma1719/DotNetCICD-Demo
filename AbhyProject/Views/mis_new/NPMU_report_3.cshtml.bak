<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {
        $("#Data1").width(2800);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'Physical Cumulative Progress (NPMU Level).pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el11' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A1', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('#Data1').addClass('table-condensed');

        $(".highcharts-credits").css("display", "none");
        $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

        $('div#btnExport').addClass('hideDownload');

        $('div#btnExport1').addClass('hideDownload');

        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");


            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
        window.setTimeout(set_detault, 1000);

    }
    function set_detault() {
        $("#Data1").width(1095);
    }


</script>
<script>

    $(document).ready(function () {

        $('#Finacial_Month').prop('disabled', true);
        var StateOfficer = '@Session["Officer"]';
        if (StateOfficer == "") {
            window.location = "/WspNew/WSP_GWM_HOME";
        }
        if (StateOfficer == "State Level Nodal Officer") {
            $('#StateDropdownLabel').hide();
        }
        else if (StateOfficer == "District Level Nodal Officer") {
            $('#StateDropdownLabel').hide();
        }
        else if (StateOfficer == "Block Level Nodal Officer") {
            $('#StateDropdownLabel').hide();
        }
        else if (StateOfficer == "Gram Panchyat Nodal Officer") {
            $('#StateDropdownLabel').hide();
        }


    });

</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demobalance2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demobalance").innerHTML = today;
</script>
