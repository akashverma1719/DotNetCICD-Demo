<style>
    .list_of_firstpanel {
        list-style: none;
    }

    ul.list_of_firstpanel > li {
        display: inline-block
    }

    .total_label {
        color: red;
    }

    .name_label {
        color: #000;
    }
</style>
<style>

    /*table fix code*/

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
    }



    /*ends here*/

</style>
<link href="~/Content/mis_new/assets/css/mis_new_css.css" rel="stylesheet" />
