            for (var i = 0; i < e_component; i++) {
                if (i == 27) {
                    debugger;
                }
                var ss = "#Hide_Procurements_Of_Equipments_TR" + i;
                $(ss).remove();
            }
        }
        $('#procurements_of_Equipments_report11').click();
