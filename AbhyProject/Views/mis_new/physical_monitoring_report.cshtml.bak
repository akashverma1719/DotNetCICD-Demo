
@{
    /**/

    ViewBag.Title = "physical_monitoring_report";
    Layout = "~/Views/Shared/dashboardlayout.cshtml";
}

<style>
    .nav-tabs {
        border-bottom: 1px solid #ddd;
        display: flex;
        flex-wrap: wrap;
    }
    .list_of_firstpanel {
        list-style: none;
    }

    ul.list_of_firstpanel > li {
        display: inline-block
    }

    .total_label {
        color: red;
    }

    .name_label {
        color: #000;
    }
    .hpanel .panel-body {
        padding: 20px 7px;
    }

    .hviolet {
    }

    .hpanel.hviolet .panel-body {
        border-top: 2px solid #9b59b6;
    }

    .hpanel.hnavyblue .panel-body {
        border-top: 2px solid #34495e;
    }
</style>
<style>

    /*table fix code*/

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
    }



    /*ends here*/

</style>

<link href="~/Content/mis_new/assets/css/mis_new_css.css" rel="stylesheet" />
<script src="~/Content/JS_Files/Physical_monitoring_JS.js"></script>
<main id="app-main" class="app-main">
    <div class="wrap">
        <section class="app-content">

            <div class="row">
                <div class="text-center">
                    <h4 class="text-primary  text-uppercase">Physical progress Monitoring  </h4>
                    <h4 class="text-primary padding-bottom ">Component A</h4>
                </div>
            </div>
            <div class="row" id="">
                <div class="col-lg-12 col-sm-12 col-md-12" style="">
                    <div class="hpanel horange" style="margin-bottom:0px;">
                        <div class="panel-body">
                            <div class="form-group" id="Agency_AWP_DropDown">
                                <ul class="list_of_firstpanel">
                                    <li> Agency : <sup class="Required_star">*</sup></li>
                                    <li>
                                        <select name="" class="form-control" id="awp_agency_state_name_1" onchange="PHP_Agency_StateInfo_B()"></select>
                                    </li>
                                    <li>
                                        <div class="panel-body" style="padding:0px 30px;">
                                            <div class="stats-title text-center">
                                                <h5 class="font-extra-bold no-margins text-info add_fontsize"> <label id="nodal_agency_name">Name of IA/ Nodal Agency </label></h5>
                                            </div>

                                        </div>
                                    </li>
                                    <li class="pull-right">
                                        <select name="" id="Finacial_Year1" class="form-control" onchange="Financial_year_Admin()">
                                            <option value="0">Select Year</option>
                                            <option value="ALL">All 5 Years</option>  @*abhi0206*@
                                            <option value="2020-21">2020-21</option>
                                            <option value="2021-22">2021-22</option>
                                            <option value="2022-23">2022-23</option>
                                            <option value="2023-24">2023-24</option>
                                            <option value="2024-25">2024-25</option>

                                        </select>
                                    </li>
                                    <li>
                                        <select name="" id="Finacial_Month1" class="form-control" onchange="Financial_Month_Admin()">
                                            <option value="0">Select Month</option>
                                            <option value="January">January</option>
                                            <option value="February">February</option>
                                            <option value="March">March</option>
                                            <option value="April">April</option>
                                            <option value="May">May</option>
                                            <option value="June">June</option>
                                            <option value="July">July</option>
                                            <option value="August">August</option>
                                            <option value="September">September</option>
                                            <option value="October">October</option>
                                            <option value="November">November</option>
                                            <option value="December">December</option>
                                        </select>
                                    </li>

                                </ul>

                            </div>
                            <div class="form-group" id="State_AWP_DropDown">
                                <ul class="list_of_firstpanel">
                                    <li>  StateName : <sup class="Required_star">*</sup></li>
                                    <li>
                                        <label id="pip_dropdown_state_name">
                                        </label>
                                    </li>
                                    <li>
                                        <div class="panel-body" style="padding:0px 30px;">
                                            <div class="stats-title text-center">
                                                <h5 class="font-extra-bold no-margins text-info add_fontsize"> <label id="nodal_agency_name1">Agency Name </label></h5>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="pull-right">
                                        <select name="" id="Finacial_Year" class="form-control" onchange="Financial_year_State()">
                                            <option value="0">Select Year</option>
                                            <option value="ALL">All 5 Years</option>  @*abhi0206*@
                                            <option value="2020-21">2020-21</option>
                                            <option value="2021-22">2021-22</option>
                                            <option value="2022-23">2022-23</option>
                                            <option value="2023-24">2023-24</option>
                                            <option value="2024-25">2024-25</option>
                                        </select>
                                    </li>
                                    <li>
                                        <select name="" id="Finacial_Month" class="form-control" onchange="Financial_Month_State()">
                                            <option value="0">Select Month</option>
                                            <option value="January">January</option>
                                            <option value="February">February</option>
                                            <option value="March">March</option>
                                            <option value="April">April</option>
                                            <option value="May">May</option>
                                            <option value="June">June</option>
                                            <option value="July">July</option>
                                            <option value="August">August</option>
                                            <option value="September">September</option>
                                            <option value="October">October</option>
                                            <option value="November">November</option>
                                            <option value="December">December</option>
                                        </select>
                                    </li>


                                </ul>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <ul class="nav nav-tabs">
                    <li class="active col-lg-3 col-md-3 col-sm-12">
                        <a data-toggle="tab" href="#home">
                            <div class="hpanel hgreen contact-panel">

                                <div class="panel-body">
                                    <div class="stats-title text-center border-bottom">

                                        <h5 class="font-extra-bold no-margins text-success">Service: <span id=""></span>  </h5>
                                        <h5><span id="Support_Count">0</span>  </h5>
                                    </div>

                                </div>
                            </div>
                        </a>
                    </li>
                    <li class="col-lg-3 col-md-3 col-sm-12">
