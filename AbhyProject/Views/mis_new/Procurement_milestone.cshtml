        $('#hide_nomination_ref_no').hide();
        $('#hide_nomination_date').hide();
        $('#hide_nomination_amt').hide();
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('input[type=text]').prop("disabled", true);
            $('.btn_disabled').prop("disabled", true);
            $('input[type=file]').prop("disabled", true);
        }
    });

    $('body').on('keypress', ".decimal", function (event) {

        if (event.which === 8 || event.keyCode === 39)
            return true;

        else if ((event.which !== 46 || $(this).val().indexOf('.') !== -1) && (event.which < 48 || event.which > 57))
            event.preventDefault();

    });
    function select_producrment_selection() {
        
        var selected_value = $('#producrment_selection').val();
        if (selected_value == 'Nomination Based') {
            $('#hide_nomination_ref_no').show();
            $('#hide_tender_no').hide();
            $('#hide_nomination_date').show();
            $('#bid_date_tender').hide();
            $('#hide_nomination_amt').show();
            $('#hide_tender_amt').hide();
            $('#estimated_cost').prop('disabled', true);
            $('#website_url').prop('disabled', true);
            $('#final_evaluation_report_date').prop('disabled', true);
            $('#tender_id').prop('disabled', true);
            $('#bid_evalution_date').prop('disabled', true);
            $('#award_date').prop('disabled', true);
            $('#noof_envelopes').prop('disabled', true);
            $('#deadline_date').prop('disabled', true);
            $('#bid_open_date').prop('disabled', true);
            $('#filename').prop('disabled', true);
            $('#valid_bids').prop('disabled', true);
            $('#bids_received').prop('disabled', true);
            $('#evaluation_report_date').prop('disabled', true);
        } else if (selected_value == "Procurement Through Govt. Agency/Direct Contracting") {
            $('#hide_nomination_ref_no').hide();
            $('#hide_tender_no').show();
            $('#hide_nomination_date').hide();
            $('#bid_date_tender').show();
            $('#hide_nomination_amt').hide();
            $('#hide_tender_amt').show();
            $('#estimated_cost').prop('disabled', false);
            $('#website_url').prop('disabled', false);
            $('#final_evaluation_report_date').prop('disabled', false);
            $('#bid_evalution_date').prop('disabled', false);
            $('#award_date').prop('disabled', false);
            $('#noof_envelopes').prop('disabled', false);
            $('#deadline_date').prop('disabled', false);
            $('#bid_open_date').prop('disabled', false);
            $('#filename').prop('disabled', false);
            $('#valid_bids').prop('disabled', false);
            $('#bids_received').prop('disabled', false);
            $('#evaluation_report_date').prop('disabled', false);
            $('#tender_id').prop('disabled', true);
            $('#tender_no').prop('disabled', true);
            $('#bid_date').prop('disabled', true);
        } else {
            $('#hide_nomination_ref_no').hide();
            $('#hide_tender_no').show();
            $('#hide_nomination_date').hide();
            $('#bid_date_tender').show();
            $('#hide_nomination_amt').hide();
            $('#hide_tender_amt').show();
            $('#estimated_cost').prop('disabled', false);
            $('#website_url').prop('disabled', false);
            $('#final_evaluation_report_date').prop('disabled', false);
            $('#tender_id').prop('disabled', false);
            $('#bid_evalution_date').prop('disabled', false);
            $('#award_date').prop('disabled', false);
            $('#noof_envelopes').prop('disabled', false);
            $('#deadline_date').prop('disabled', false);
            $('#bid_open_date').prop('disabled', false);
            $('#filename').prop('disabled', false);
            $('#valid_bids').prop('disabled', false);
            $('#bids_received').prop('disabled', false);
            $('#evaluation_report_date').prop('disabled', false);
            $('#bid_date').prop('disabled', false);
            $('#tender_no').prop('disabled', false);
        }
    }
