﻿
@{
    /**/

    ViewBag.Title = "Fund_release_Monitoring";
    Layout = "~/Views/Shared/dashboardlayout.cshtml";
}
<style>

    .list_of_firstpanel {
        list-style: none;
    }

    ul.list_of_firstpanel > li {
        display: inline-block
    }

    .total_label {
        color: red;
    }

    .name_label {
        color: #000;
    }
</style>
<script src="~/Content/JS_Files/Fund_release.js"></script>
<link href="~/Content/mis_new/assets/css/mis_new_css.css" rel="stylesheet" />
<main id="app-main" class="app-main">
    <div class="wrap">
        <section class="app-content">
            <div class="row">
                <div class="text-center">
                    <h4 class="text-primary padding-bottom text-uppercase">Fund Release Monitoring </h4>
                </div>
            </div>
            <div class="row" id="">
                <div class="col-lg-12 col-sm-12 col-md-12" style="">
                    <div class="hpanel horange" style="margin-bottom:0px;">
                        <div class="panel-body">
                            <div class="form-group" id="Agency_AWP_DropDown">
                                <ul class="list_of_firstpanel">
                                    <li>  StateName : <sup class="Required_star">*</sup></li>
                                    <li>
                                        <select name="" class="form-control" id="awp_agency_state_name_1" onchange="PHP_Agency_StateInfo_B()"></select>
                                    </li>
                                    <li>
                                        <div class="panel-body" style="padding:0px 30px;">
                                            <div class="stats-title pull-left">
                                                <h5 class="font-extra-bold no-margins text-info add_fontsize"> <label id="nodal_agency_name">Agency Name </label></h5>
                                            </div>
                                        </div>
                                    </li>
                                    @*
                                        <li>
                                            <div class="panel-body" style="padding:0px 30px;">
                                                <div class="stats-title pull-left">
                                                    <h5 class="font-extra-bold no-margins text-info add_fontsize"> <label class="total_label">Total Allocated : </label></h5>
                                                    <span id="AWP_Total_value1"></span>
                                                </div>
                                            </div>
                                        </li>*@
                                </ul>
                            </div>
                            <div class="form-group" id="State_AWP_DropDown">
                                <ul class="list_of_firstpanel">
                                    <li>  StateName : <sup class="Required_star">*</sup></li>
                                    <li>
                                        <label id="pip_dropdown_state_name">
                                        </label>
                                    </li>
                                    <li>
                                        <div class="panel-body" style="padding:0px 30px; position:absolute; left:268px;">
                                            <div class="stats-title pull-left">
                                                <h5 class="font-extra-bold no-margins text-info add_fontsize"> <label id="nodal_agency_name1">Agency Name </label></h5>
                                            </div>
                                        </div>
                                    </li>
                                    @*
                                        <li>
                                            <div class="panel-body" style="padding:0px 30px;">
                                                <div class="stats-title pull-left">
                                                    <h5 class="font-extra-bold no-margins text-info add_fontsize"> <label class="total_label">Total Allocated : </label></h5>
                                                    <span id="AWP_Total_value1"></span>
                                                </div>
                                            </div>
                                        </li>*@
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" id="div_form_insert">
                <div class="tab-content">
                    <div id="home" class="tab-pane fade in active">
                        <div class="col-md-12">
                            <div class="widget row no-gutter p-lg border-top-form">
                                <div class="col-md-12  col-sm-12">
                                    <div>
                                        <h5 class="widget-title fz-md text-primary m-b-lg">Fund Release Monitoring  </h5>
                                        <div class="content">
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="hpanel hblue">
                                                        <div class="panel-body">
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Financial Year:</span>
                                                                <select name="fund_year" id="fund_year" class="form-control" onchange="disable_btn()">
                                                                    <option value="0"> Select Financial Year</option>
                                                                    <option value="2020-21">2020-2021</option>
                                                                    <option value="2021-22">2021-2022</option>
                                                                    <option value="2022-23">2022-2023</option>
                                                                    <option value="2023-24">2023-2024</option>
                                                                    <option value="2024-25">2024-2025</option>
                                                                </select>
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Tranche No:</span>
                                                                <input type="text" id="fund_tranche_no" class="form-control decimal" />
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">File No/ Sanction Letter No:</span>
                                                                <input type="text" id="fund_file_no" class="form-control " />
                                                            </div>

                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Date of Sanction:</span>
                                                                <input type="date" id="fund_sanction_date" class="form-control" />
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Utilization Certificate submitted (Yes/ No):</span>
                                                                @*<input type="text" id="fund_certificate_submited" class="form-control decimal" />*@
                                                                <select class="form-control" id="fund_certificate_submited" onchange="DropDownEnableCal()">
                                                                    <option value="0">Select One</option>
                                                                    <option value="Yes">Yes</option>                    @*prateeK drop down*@
                                                                    <option value="No">No</option>
                                                                </select>
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">If Yes, Date of submission of UC :</span>
                                                                <input type="date" id="fund_certificate_submited_date" disabled class="form-control decimal" />
                                                            </div>

                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Grant in Aid (General)(Program Component)</span>
                                                                <select name="" id="grant_in_aid_general_a" onchange="Grant_In_Aid_btn()" class="form-control">
                                                                    <option value="0"> Select One</option>
                                                                </select>
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">DLI</span>
                                                                <select name="" id="grant_in_aid_dli_general_a" class="form-control">
                                                                    <option value="0"> Select One</option>
                                                                    <option value="DLI1">DLI1</option>
                                                                    <option value="DLI2">DLI2</option>
                                                                    <option value="DLI3">DLI3</option>
                                                                    <option value="DLI4">DLI4</option>
                                                                    <option value="DLI5">DLI5</option>
                                                                </select>
                                                            </div>

                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Grant in Aid (General)(Program Component)(Crore):</span>
                                                                <input type="text" onkeyup="Grant_A_Sum()" id="fund_grant_aid_general_a" class="form-control" />
                                                            </div>


                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label"> Grant in Aid (Capital)(Program Component)(Crore):</span>
                                                                <input type="text" onkeyup="Grant_A_Sum()" id="fund_grant_aid_capital_a" class="form-control" />
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Grant in Aid (General)(EAP Component) :</span>
                                                                <select name="" id="fund_grant_aid_general_b" class="form-control">
                                                                    <option value="0"> Select One</option>
                                                                    <option value="DLI1">DLI1</option>
                                                                    <option value="DLI2">DLI2</option>
                                                                    <option value="DLI3">DLI3</option>
                                                                    <option value="DLI4">DLI4</option>
                                                                    <option value="DLI5">DLI5</option>
                                                                </select>
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label">Grant in Aid (General)(EAP Component)(Crore) :</span>
                                                                <input type="text" onkeyup="Grant_B_Sum()" id="fund_general_aid_b_value" class="form-control decimal" />
                                                            </div>


                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label"> Total(EAP Component):</span>
                                                                <input type="text" id="fund_grant_aid_capital_b_total" class="form-control" readonly />
                                                            </div>

                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label"> Total(Program Component):</span>
                                                                <input type="text" id="fund_grant_aid_a_total" class="form-control" readonly />
                                                            </div>
                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label"> Total(Program Component + EAP Component):</span>
                                                                <input type="text" id="fund_total_sum_a_b" class="form-control" readonly />
                                                            </div>

                                                            <div class="form-group col-md-6 col-sm-6" style="display:none">
                                                                <span class="name_label">Value of Grant in Aid (Capital)(B) (Crore) :(remove:chetan)</span>
                                                                <input type="text" onkeyup="Grant_B_Sum()" id="fund_capital_aid_b_value" class="form-control decimal" />
                                                            </div>

                                                            <div class="form-group col-md-4 col-sm-4">
                                                                <span class="name_label"> Cumulative amount released (Crore):</span>
                                                                <input type="text" id="fund_cumalative_amt" class="form-control decimal" />
                                                            </div>
                                                            <div class="form-group col-md-8 col-sm-8">
                                                                <span class="name_label"> Remarks:</span>
                                                                <input type="text" id="fund_timeline" class="form-control " />
                                                            </div>
                                                            <div class="form-group col-md-12 text-center">
                                                                <button type="button" class="btn btn-sm  btn-success" onclick="Save_Fund_Form_Info()" id="Save_Fund_Form_btn" disabled> Submit</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="menu1" class="tab-pane fade">
                        <div class="col-md-12">
                            <div class="widget row no-gutter p-lg border-top-form">
                                <div class="col-md-12  col-sm-12">
                                    <div>
                                        <h5 class="widget-title fz-md text-primary m-b-lg"><span>Financial Progress Monitoring</span> Component B Form </h5>
                                        <div class="content">
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="hpanel hgreen">
                                                        <div class="panel-body">
                                                            <div class="form-group col-md-12 col-sm-12">
                                                                <span class="name_label"> Work and Activity:</span>
                                                                <select name="" id="WorkActivity_B_Form" class="form-control" onchange="WorkActivity_B_Form_Dropdown()"></select>
                                                            </div>
                                                            <div class="form-group col-md-3 col-sm-6">
                                                                <span class="name_label">Component Id:</span>
                                                                <input type="text" id="B_component_id" class="form-control" readonly />
                                                            </div>
                                                            <div class="form-group col-md-6 col-sm-6">
                                                                <span class="name_label">Component Budget Head(EAP)</span>
                                                                <input type="text" id="B_component_budget_head" class="form-control" readonly />
                                                            </div>
                                                            <div class="form-group col-md-3 col-sm-6">
                                                                <span class="name_label">Expenditure Code:</span>
                                                                <input type="text" id="B_expenditure_code" class="form-control" readonly />
                                                            </div>
                                                            <div class="form-group col-md-6 col-sm-6">
                                                                <span class="name_label">Expenditure made(In Crore):</span>
                                                                <input type="text" id="B_Expenditure_Made" class="form-control" />
                                                            </div>
                                                            <div class="form-group col-md-6 col-sm-6">
                                                                <span class="name_label">Cumulative Expenditure (In Crore):</span>
                                                                <input type="text" id="B_Cumulative_Expenditure" class="form-control" />
                                                            </div>
                                                            <div class="form-group col-md-12 text-center">
                                                                <button type="button" class="btn btn-sm  btn-success" onclick="Save_B_Form_Info()"> Submit</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="wrap p-t-0">
        <footer class="app-footer">
            <div class="clearfix">
                <div class="copyright pull-left">Copyright .Kreate Technologies 2021 &copy;</div>
            </div>
        </footer>
    </div>
</main>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.0/jquery.min.js"></script>
<script>
    var Access_Auth = '';
    $(document).ready(function () {
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('input[type=text]').prop("disabled", true);
            $('.btn_disabled').prop("disabled", true);
            $('input[type=file]').prop("disabled", true);
        }
        else if (Access_Auth == 'edit') {
            $('.btn_disabled').prop("disabled", false);
        } else {
            $('#Save_Fund_Form_btn').prop("disabled", true);
        }
        SessionInfo1();
        Grant_In_Aid();  //chetan
        //DropDownEnableCal(sel);
        $("#div_form_insert").hide();
        CHeck_NPMU();
    });
    $('body').on('keypress', ".decimal", function (event) {

        if (event.which === 8 || event.keyCode === 39)
            return true;

        else if ((event.which !== 46 || $(this).val().indexOf('.') !== -1) && (event.which < 48 || event.which > 57))
            event.preventDefault();

    });

    function DropDownEnableCal() {
        var data = $('#fund_certificate_submited').val();
        if (data == "No") {
            $('#fund_certificate_submited_date').prop('disabled', true);

        } else
            $('#fund_certificate_submited_date').prop('disabled', false);

    }

    function disable_btn() {
        var fund_year = $('#fund_year').val();
        if (fund_year == '2020-21' || fund_year == '2021-22') {
            $('#Save_Fund_Form_btn').prop('disabled', true);
        } else {
            $('#Save_Fund_Form_btn').prop('disabled', false);
        }
        if (Access_Auth == 'readonly') {
            $('#Save_Fund_Form_btn').prop('disabled', true);
        } else if (Access_Auth == 'edit') {
            $('#Save_Fund_Form_btn').prop("disabled", false);
        }

    }
</script>

<script>

</script>
