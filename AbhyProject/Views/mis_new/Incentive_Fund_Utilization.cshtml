<script src="~/Content/JS_Files/incentive_fund_report.js"></script>
<script>
    var Access_Auth = '';
   $(document).ready(function () {
        
        Access_Auth = '@Session["Access_Auth"]';
       if (Access_Auth == "readonly") {
           $(".btn_disabled").hide()
       }
        @*var Email = '@Session["Email"]';*@
       SessionInfo1();
       Proc_Info();
       PHP_FN_Info_B_Form();
       $('#producrment_selection_other').hide();
       $('#rfp_date_other').hide();

       $(function () {
           $("input[name='numonly_decimal']").on('input', function (e) {
               $(this).val($(this).val().replace(/[^0-9/]/g, ''));
           });
       });
    });
</script>