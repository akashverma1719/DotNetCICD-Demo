<script>

    function Export_a_Table() {
        $('#th_edit').hide();
        $('#th_delete').hide();
        if (awp_a_component != 0) {
            for (var i = 0; i < awp_a_component; i++) {
                var ss = "#Hide_AWP1_TR" + i;
                $(ss).remove();
            }
        }

        $('#AComponent_Id').click();
        AWP_Info();
        $('#th_edit').show();
        $('#th_delete').show();
    }
    function Export_b_Table() {
        
        if (awp_b_component != 0) {
            for (var i = 0; i < awp_b_component; i++) {
                var ss = "#Hide_AWP2_TR" + i;
                $(ss).remove();
            }
        }
        $('#BComponent_Id').click();
        AWP_B_Info();
    }

