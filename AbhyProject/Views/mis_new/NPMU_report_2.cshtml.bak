                        <thead>
                            <tr class="tableheader1"></tr>
                            <tr class="success">
                                <td rowspan="3">SI.No</td>
                                <td rowspan="3">States</td>
                                <td colspan="15" class="text-center"> IEC Activities</td>

                                <td colspan="2" class="text-center"> Social Outreach</td>

                                <td colspan="8" class="text-center"> Trainings conducted at Different Levels (Numbers)</td>


                            </tr>
                            <tr class="success">
                                <td rowspan="2">No. Awareness/Publicity meeting conducted</td>
                                <td rowspan="2">No. of IEC material prepared (Pamphlets, Leaflets,Magzine, Brochures etc.)</td>
                                <td colspan="4">No. of IEC material displayed</td>
                                <td rowspan="2">No. of  Audio/Video  material prepared</td>
                                <td rowspan="2">No. of Road Shows/Street plays conducted</td>
                                <td rowspan="2">No. of HHs covered under Door to Door Campaign</td>
                                <td rowspan="2">No. of Post in Facebook/Twitter/You tube etc.</td>
                                <td rowspan="2">No. of Exhibitions/Seminars/Fair Conducted at District and Block Level</td>

                                <td colspan="4" class="text-center">Workshops conducted at Different levels (Numbers)</td>

                                <td rowspan="2">No. of Community meetings conducted </td>
                                <td rowspan="2">Percentage(%) of Female participation in the community meetings</td>

                                <td colspan="2" class="text-center"> State level </td>
                                <td colspan="2" class="text-center">District level </td>
                                <td colspan="2" class="text-center">Block level  </td>
                                <td colspan="2" class="text-center">Gram Panchayat  </td>

                                @*<td rowspan="2">No. of Sensitization/Awareness camps conducted</td>*@

                            </tr>
                            <tr class="success">

                                <td class="text-center">Paintings / Wall Writing</td>
                                <td class="text-center">Hordings</td>
                                <td class="text-center">Posters</td>
                                <td class="text-center">Signages</td>


                                <td class="text-center">State </td>
                                <td class="text-center">District</td>
                                <td class="text-center">GP Level</td>
                                <td class="text-center">Total </td>
                                <td class="text-center">Target</td>
                                <td class="text-center">Achieved</td>
                                <td class="text-center">Target</td>
                                <td class="text-center">Achieved</td>
                                <td class="text-center">Target</td>
                                <td class="text-center">Achieved</td>
                                <td class="text-center">Target</td>
                                <td class="text-center">Achieved</td>




