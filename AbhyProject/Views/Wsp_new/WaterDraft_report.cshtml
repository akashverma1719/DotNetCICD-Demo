                        <thead>
                            <tr class="tableheader1 text-center">
                                <th colspan="3" style="padding:5px;" class="text-center">Water Utilization</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <th>A</th>
                                <th>Drinking /Domestic (Ha.m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="domestic_demand_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="domestic_demand_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total</th>
                                <td><span id="Domestic_Total">0</span></td>
                            </tr>
                            <tr>
                                <th>B</th>
                                <th>Irrigated Agriculture (Ha.m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="irri_utili_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="irri_utili_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total</th>
                                <td><span id="Irrigated_Total"></span></td>
                            </tr>
                            <tr>
                                <th>C</th>
                                <th>
                                    Industrial Use (Ha.m)
                                </th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="industry_demand_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="industry_demand_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total </th>
                                <td><span id="Industry_Total"></span></td>
                            </tr>
                            <tr>
                                <th>D</th>
                                <th>
                                    Other Uses (if any) (Ha.m)
                                </th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>Form Surface Water</td>
                                <td><span id="other_demand_surface_water"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Form Ground Water</td>
                                <td><span id="other_demand_ground_water"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total </th>
                                <td><span id="Other_Total"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <div id="container_Water_Utilization" style="height: 500px;"></div>
                </div>
            </div>


            <div class="col-md-12" style="margin-bottom:15px;">
                <div class="col-md-12">
                    <p class="text-center">
                        .............................
                    </p>
                    <p class="text-justify">
                        The results and analysis contained within the Water Budgeting Report are generated with the help of inputs given by the
                        user as well as existing database. Each component of water budgeting is designed to make understand the users about
                        the processes, parameters and equations involved in the system. The overall goal of water budgeting is therefore to
                        improve the management of ground water resources in priority areas of the country.
                    </p>
                    <p class="text-center">
                        .............................
                    </p>
                </div>

                <div class="container  hidediv" id="btnExport1">
                    <div class="col-md-12 text-center">
                        <a href="~/WspNew/WspDraft" class="btn btn-danger">
                            Back
                        </a>
                        @*<button class="btn btn-success download1" onclick="ReportPdf();">Download</button>*@
                        <a href="~/WspNew/WspBalance" class="btn btn-primary">
                            Go to Balance
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>


<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {


        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterUtilizationReport.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
    }

</script>

<script>
    $(document).ready(function () {
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
        Info();
    });
    var Domestic_value = [];
    var Irrigation = [];
    var Industry = [];
    var Others = [];
    var Domestic_Total = 0, domestic_demand_surface_water = 0, domestic_demand_ground_water = 0;
    var Irrigated_Total = 0, irri_utili_surface_water = 0, irri_utili_ground_water = 0;

    function Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/Water_Domestic_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                
                if (response == "Error") {
                    window.location = "/Wsp_new/WaterDraft_report";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                

                if (response.length != 0) {


                    if (response[0].domestic_demand_surface_water_total_value != null && response[0].domestic_demand_surface_water_total_value != "") {
                        domestic_demand_surface_water = parseFloat(response[0].domestic_demand_surface_water_total_value).toFixed(2);
                        if (isNaN(domestic_demand_surface_water) == true) {
                            domestic_demand_surface_water = 0;
                        }
                    }
                    if (response[0].domestic_demand_ground_water_total_value != null && response[0].domestic_demand_ground_water_total_value != "") {
                        domestic_demand_ground_water = parseFloat(response[0].domestic_demand_ground_water_total_value).toFixed(2);
                        if (isNaN(domestic_demand_ground_water) == true) {
                            domestic_demand_ground_water = 0;
                        }
                    }
                    $('#domestic_demand_surface_water').text(parseFloat(domestic_demand_ground_water).toFixed(2));

                    $('#domestic_demand_ground_water').text(parseFloat(domestic_demand_surface_water).toFixed(2));


                    Domestic_Total = parseFloat(domestic_demand_surface_water) + parseFloat(domestic_demand_ground_water);
                    $('#Domestic_Total').text(parseFloat(Domestic_Total).toFixed(2));

                    //Domestic.push(parseFloat(domestic_demand_surface_water));
                    //Domestic.push(parseFloat(domestic_demand_ground_water));

                }

                Info1();

            }
        });

    }

    function Info1() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/WaterDraftInfo_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                
                if (response == "Error") {
                    window.location = "/Wsp_new/WaterDraft_report";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                

                if (response.length != 0) {



                    if (response[0].irri_utili_surface_water != null && response[0].irri_utili_surface_water != "") {
                        irri_utili_surface_water = parseFloat(response[0].irri_utili_surface_water);

                        if (isNaN(irri_utili_surface_water) == true) {
                            irri_utili_surface_water = 0;
                        }

                    }


                    $('#irri_utili_surface_water').text(parseFloat(irri_utili_surface_water).toFixed(2));
                    if (response[0].irri_utili_ground_water != null && response[0].irri_utili_ground_water != "") {
                        irri_utili_ground_water = parseFloat(response[0].irri_utili_ground_water);
                        if (isNaN(irri_utili_ground_water) == true) {
                            irri_utili_ground_water = 0;
                        }
                    }
                    $('#irri_utili_ground_water').text(parseFloat(irri_utili_ground_water).toFixed(2));
                    Irrigated_Total = irri_utili_surface_water + irri_utili_ground_water;


                }

                Industry_Info();

            }
        });

    }

    var Industry_Total = 0, industry_demand_surface_water = 0, industry_demand_ground_water = 0;

    function Industry_Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/WaterIndustry_Info_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {

                
                if (response == "Error") {
                    window.location = "/WspNew/WspDraft";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (response.length != 0) {
                    for (var j = 0; j < response.length; j++) {


                        if (response[j].industry_demand_surface_water != null && response[j].industry_demand_surface_water != "") {
                            industry_demand_surface_water += parseFloat(response[j].industry_demand_surface_water);
                            if (isNaN(industry_demand_surface_water) == true) {
                                industry_demand_surface_water = 0;
                            }
                        }
                        if (response[j].industry_demand_ground_water != null && response[j].industry_demand_ground_water != "") {
                            industry_demand_ground_water += parseFloat(response[j].industry_demand_ground_water);
                            if (isNaN(industry_demand_ground_water) == true) {
                                industry_demand_ground_water = 0;
                            }
                        }

                    }
                }


                Other_Usage_Info();
            }
        });
    }
    var Other_Total = 0, other_demand_ground_water = 0, other_demand_surface_water = 0;


    function Other_Usage_Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/WaterOther_Usage_Info_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                
                if (response == "Error") {
                    window.location = "/WspNew/WspDraft";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                var tr = '';
                

                if (response.length != 0) {
                    for (var i = 0; i < response.length; i++) {

                        if (response[i].other_demand_ground_water != null && response[i].other_demand_ground_water != "") {
                            other_demand_ground_water += parseFloat(response[i].other_demand_ground_water);
                            if (isNaN(other_demand_ground_water) == true) {
                                other_demand_ground_water = 0;
                            }
                        }
                        if (response[i].other_demand_surface_water != null && response[i].other_demand_surface_water != "") {
                            other_demand_surface_water += parseFloat(response[i].other_demand_surface_water);
                            if (isNaN(other_demand_surface_water) == true) {
                                other_demand_surface_water = 0;
                            }
                        }

                    }
                }


                
                var domestic_demand_ground_water1 = parseFloat(domestic_demand_ground_water);
                var domestic_demand_surface_water1 = parseFloat(domestic_demand_surface_water);
                var Total_Domestic = domestic_demand_ground_water1 + domestic_demand_surface_water1;
                
                $('#Domestic_Total').text(parseFloat(Total_Domestic).toFixed(2));
                Domestic_value.push(domestic_demand_surface_water1);
                Domestic_value.push(domestic_demand_ground_water1);
                $('#Irrigated_Total').text(parseFloat(Irrigated_Total).toFixed(2));

                Industry_Total = industry_demand_surface_water + industry_demand_ground_water;
                $('#Industry_Total').text(parseFloat(Industry_Total).toFixed(2));
                $('#industry_demand_surface_water').text(parseFloat(industry_demand_surface_water).toFixed(2));
                $('#industry_demand_ground_water').text(parseFloat(industry_demand_ground_water).toFixed(2));
                Industry.push(industry_demand_ground_water);
                Industry.push(industry_demand_surface_water);
                Irrigation.push(irri_utili_ground_water);
                Irrigation.push(irri_utili_surface_water);



                $('#other_demand_surface_water').text(parseFloat(other_demand_surface_water).toFixed(2));
                $('#other_demand_ground_water').text(parseFloat(other_demand_ground_water).toFixed(2));
                Other_Total = other_demand_ground_water + other_demand_surface_water;
                $('#Other_Total').text(parseFloat(Other_Total).toFixed(2));

                Others.push(other_demand_ground_water);
                Others.push(other_demand_surface_water);
                
                Charts();
            }
        });
    }



    function Charts() {

        Highcharts.chart('container_Water_Utilization', {
            chart: {
                type: 'column'
            },
            title: {
                text: 'Water Utilization by different sectors'
            },
            //subtitle: {
            //    text: 'Source: WorldClimate.com'
            //},
            xAxis: {
                categories: [
                    'Ground Water',
                    'Surface Water'

                ],
                crosshair: true
            },
            colors: [
                '#ED5565',
                '#5D9CEC',
                '#A0D468',
                '#c42525'
            ],
            yAxis: {
                title: {
                    text: ''
                }

            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.1f} </b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },

            series: [{
                name: 'Drinking / Domestic (Ha.m)',
