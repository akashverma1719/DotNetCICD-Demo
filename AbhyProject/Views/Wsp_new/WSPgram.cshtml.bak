<script>

    // first location Image preview
    var loadFile = function (event) {
        var output = document.getElementById('output');
        output.src = URL.createObjectURL(event.target.files[0]);
        output.onload = function () {
            URL.revokeObjectURL(output.src) // free memory
        }
    };

    // Watershed map Image
    var Watershed_map_Image = function (event) {

        var Watershed_map_Image_output = document.getElementById('Watershed_map_Image_output');
        Watershed_map_Image_output.src = URL.createObjectURL(event.target.files[0]);
        Watershed_map_Image_output.onload = function () {
            URL.revokeObjectURL(Watershed_map_Image_output.src) // free memory
        }
    };
    //Aquifer map Image Uplaod
    var Aquifer_map_Image = function (event) {
        var Aquifer_map_Image_output = document.getElementById('Aquifer_map_Image_output');
        Aquifer_map_Image_output.src = URL.createObjectURL(event.target.files[0]);
        Aquifer_map_Image_output.onload = function () {
            URL.revokeObjectURL(Aquifer_map_Image_output.src) // free memory
        }
    };
    // Drainage map Image
    var Drainage_map_Image = function (event) {
        $('#Drainage_map_Image_output').show();
        var Drainage_map_Image = document.getElementById('Drainage_map_Image_output');
        Drainage_map_Image.src = URL.createObjectURL(event.target.files[0]);
        Drainage_map_Image.onload = function () {
            URL.revokeObjectURL(Drainage_map_Image.src) // free memory
        }
    };

    function gpimagesgeting_Location() {
        var state = $('#spnstate').text();
        var dist = $('#spndistrict').text();
        var block = $('#spnblock').text();
        var gram = $('#spngram').text();
        var obj = {};
        obj.state_name = state;
        obj.district_name = dist;
        obj.block_name = block;
        obj.gpname = gram;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/MapImagesdetails1',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                //alert(data.length);
                $("#loaction_map_geting").html("");
                $("#Drainage_map_geting").html("");
                $("#Aquifer_map_geting").html("");
                $("#Watershed_map_geting").html("");
                var i = 0;
                if (data.length != 0) {
                    //alert('imagegetting');
                    for (var i = 0; i < data.length; i++) {

                        if (data[i].gpimage1 != null && data[i].gpimage1 != "") {
                            var tr1 = '<label><a href="' + data[i].gpimage1 + '" download="" target="_blank" >' + data[i].gpimage1_filename + '</a></label>';
                            $('#loaction_map_geting').html(tr1);

                        }


                        if (data[i].gpimage4 != null && data[i].gpimage4 != "") {
                            var Drainage_map_geting = '<label><a href="' + data[i].gpimage4 + '" download="" target="_blank" >' + data[i].gpimage4_filename + '</a></label>';
                            $('#Drainage_map_geting').html(Drainage_map_geting);

                        }


                        if (data[i].gpimage3 != null && data[i].gpimage3 != "") {
                            var Aquifer_map_geting = '<label><a href="' + data[i].gpimage3 + '" download="" target="_blank" >' + data[i].gpimage3_filename + '</a></label>';
                            $('#Aquifer_map_geting').html(Aquifer_map_geting);

                        }

                        if (data[i].gpimage2 != null && data[i].gpimage2 != "") {
                            var Watershed_map_geting = '<label><a href="' + data[i].gpimage2 + '" download="" target="_blank" >' + data[i].gpimage2_filename + '</a></label>';
                            $('#Watershed_map_geting').html(Watershed_map_geting);

                        }
                    }

                }

            }

        });
    }

    //ideal state
    //    let inactivityTime = function() {
    //        let time;
    //    window.onload = resetTimer;
    //    document.onmousemove = resetTimer;
    //    document.onkeypress = resetTimer;
