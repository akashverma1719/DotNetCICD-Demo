    function Delete_mom_photo(id) {
        var idd = parseInt(id);
        var obj = {};
        obj.id = idd;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Wsp_new/DeletePHotograph_file_Detail",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                    window.location = "/Error/DefaultError";
                }
                Social_Monitor_Details();

            }
        });
    }
    function Delete_mom_pdf(id) {
        var idd = parseInt(id);
        var obj = {};
        obj.id = idd;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Wsp_new/DeleteMOM_file_Detail",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {

                alert(response);
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                    window.location = "/Error/DefaultError";
                }
                Social_Monitor_Details();
            }
        });
    }

    function save_Location_map_Image_Uplaod() {
    State = '@Session["gstate"]';
     Dist ='@Session["gdist"]';
     Block ='@Session["gblock"]';
        Gram = '@Session["ggram"]';

        var state_name = State;
        var district_name = Dist;
        var block_name = Block;
        var gpname = Gram;
        debugger;

        var files = $('#Location_map_Image_Uplaod')[0].files;

        $('#Location_map_Image_Uplaod1').prop('disabled', true);
        $('#Watershed_map_Image_Uplaod1').prop('disabled', true);
        $('#Aquifer_map_Image_Uplaod1').prop('disabled', true);
        $('#Drainage_map_Image_Uplaod1').prop('disabled', true);
        $.ajax({
            type: "POST",
            url: "/HOME/Location_map_Image_Uplaod",
            data: function () {
                var data = new FormData();
                data.append('Location_map_Image_Uplaod', files[0]);
                //data.append("Location_map_Image_Uplaod", jQuery("#file_upload").get(0).files[0]);
                data.append("state_name", state_name);
                data.append("district_name", district_name);
                data.append("block_name", block_name);
                data.append("gpname", gpname);
                return data;
            }(),
            contentType: false,
            processData: false,
            success: function (response) {
                alert(response);
                $('#Location_map_Image_Uplaod1').prop('disabled', false);
                $('#Watershed_map_Image_Uplaod1').prop('disabled', false);
                $('#Aquifer_map_Image_Uplaod1').prop('disabled', false);
                $('#Drainage_map_Image_Uplaod1').prop('disabled', false);
                gpimagesgeting_Location();
                //alert(response);
                //if (response == "Logout") {
                //    window.location = "/WspNew/WSP_GWM_HOME";
                //}
                //else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                //    window.location = "/Error/DefaultError";
                //}
            }
        });
    }

