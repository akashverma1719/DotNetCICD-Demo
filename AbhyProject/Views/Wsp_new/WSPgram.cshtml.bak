

@{
    ViewBag.Title = "WSPgram";
    Layout = null;
}
<title>Water Gram Panchayat</title>
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>

<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- favicon
============================================ -->

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/datecss.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/css/abhycss.css" rel="stylesheet" />
<link href="~/Content/wsp_formcss.css" rel="stylesheet" />
<script src="~/Content/JS_Files/IdealState.js"></script>
<script name="clear-browser-cache" src='~/Content/JS_Files/clear-browser-cache.js' value="true"></script>
<style>
    .color_database {
        color: green !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
</style>

<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<div class="clearfix">
    <header class="header hederImage">
        <div class="clearfix">
            <div class="clearfix">
                <div class="col-lg-9">
                    <div class="header-top-info">
                        <ul class="clearfix">

                            <li>
                                <img src="/Content/Website/images/banner/emblem-dark.png" alt="" style="height:60px ;width: 40px;">
                            </li>

                            <li>
                                <span>
                                    <a href="~/home/index" title="ATAL BHUJAL YOJANA (ATAL JAL)" role="link" class="atlaligan" style="font-weight:800">ATAL BHUJAL YOJANA (ATAL JAL)</a>
                                </span>
                                <span>
                                    <a href="javascript:;" title="GOVERNMENT OF INDIA" style="color:#fff;font-size:14px;" role="link">
                                        Ministry of Jal Shakti
                                    </a>
                                </span>
                                <span class="li_eng responsive_go_eng"><a href="javascript:;" title="GOVERNMENT OF INDIA" role="link" style="color: #fff;font-size: 14px;">Department of Water Resources,</a></span>
                                <span style="text-align:center;">
                                    <a href="javascript:;" title="GOVERNMENT OF INDIA"
                                       style="text-transform:none; font-size:14px;">
                                        River Development & Ganga Rejuvenation
                                    </a>
                                </span>

                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <ul class="imgHome clearfix">

                        <li>
                            <img src="~/Content/WspImages/user-silhouette.png" title="Username" />
                            <span style="color:#fff;">:@Session["UserName"]</span>
                        </li>
                        <li>

                            <a href="~/Home/LogOut"> <img src="~/Content/WspImages/Logout white1.png" title="Logout" /></a>
                        </li>

                    </ul>
                </div>
                <div class="col-md-12" style="padding: 0px 0px 0px 5px; margin-top:10px;">
                    <ul class="imgHome clearfix">
                        <li>
                            <a href="~/WspNew/WSP_GWM_HOME">
                                <span>
                                    <img src="~/Content/WspImages/home-icon-silhouette.png" />
                                </span>
                                <label>MIS Login <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>

                        <li>
                            <a href="~/Wsp_new/WSPHOME">
                                <span><img src="~/Content/WspImages/home-icon-silhouette.png" /></span>
                                <label>WSP Home <i class="fa fa-angle-double-right"></i></label>
                            </a>
                        </li>

                        <li>
                            <span><img src="~/Content/WspImages/WSP Home.png" style="width:23px;" /></span>
                            <label>Gram Panchayat</label>
                        </li>
                    </ul>
                </div>

            </div>
        </div>


    </header>

    <div class="tab-content">
        <!--Rainfail_menu Start-->
        <div role="tabpanel" class="tab-pane fade in active" id="music">
            <div class="container-fluid">
                <!--images Row Started-->
                <div class="clearfix">
                    <div class="row" id="Select_dist_level">
                        <ul class="Select_option selectbackhome">
                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Block:</label>
                                <span id="spnblock">@Session["gblock"]</span>
                            </li>
                            <li>
                                <i class="fas fa fa-angle-double-right"></i>
                                <label>Gram panchayat:</label>
                                <span id="spngram">@Session["ggram"]</span>
                            </li>
                        </ul>
                        <ul class="selectbackhome" style="float:right;">
                            <li>
                                <a href="~/Wsp_new/WSPHOME" class="btn btn-success">
                                    Back To WSP Home
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="row" style="margin-top:10px;">
                        <div class="col-md-12 col-lg-12">
                            <ul class="tabs_menu sru_menu" id="Surface_menu">
                                <li class="tab-link active subtab1" data-tab="menu-11">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/Agriculture_icons/Gram_Panchayat_2icon.png" /></span>
                                        <label>Gram Panchayat</label>
                                    </a>
                                </li>
                                <li class="tab-link subtab2" data-tab="menu-12">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/Agriculture_icons/PGWMC.png" /></span>
                                        <label>PGWM Committee</label>
                                    </a>
                                </li>
                                <li class="tab-link subtab3" data-tab="menu-13">
                                    <a href="javascript:;">
                                        <span><img src="/Content/Agriculture_icons/location.png" /></span>
                                        <label>Image Upload</label>
                                    </a>
                                </li>
                                <li class="tab-link subtab4" data-tab="menu-14">
                                    <a href="javascript:;">
                                        <span><img src="~/Content/Agriculture_icons/location.png" /></span>
                                        <label>Location</label>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="clearfix tabfirst">
                    <div class="suface-info active" id="menu-11">
                        <div class="clearfix">
                            <div class="container-fluid">
                                <div class="col-lg-12 col-md-12 col-sm-12 form-body" style="padding:10px 15px">
                                    <div class="form-div">
                                        <div class="col-md-12 background-border-Database ">
                                            <div class="row database_trainer_row ">
                                                <h3>
                                                    Gram Panchayat
                                                    <a href="javascript:;" data-toggle="tooltip" title="Data Source : Shapefile(Village Boundary)">
                                                        <span class="glyphicon glyphicon-info-sign" style="color:#fff" aria-hidden="true"></span>
                                                    </a>
                                                </h3>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">State :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input type="text" id="state_name" class="form-control color_database" name="" placeholder="Your State.." readonly>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">District :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input type="text" id="district_name" class="form-control color_database" name="" placeholder="District .." readonly>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Block / Taluk  :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="block_name" class="form-control color_database" name="" placeholder="Block / Taluk" readonly>
                                                </div>
                                            </div>

                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Gram Panchayat Name :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="gram_panchayat_name" class="form-control color_database" name="" placeholder="Gram Panchayat Name.." readonly>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Gram Panchayat ID <span class="Required_star"></span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="gp_id" class="form-control color_database alphanum" name="" placeholder="Gram Panchayat ID..">
                                                    <label id="AlertError1" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Block Area (Ha) <span class="Required_star">*</span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="block_area" class="form-control decimal color_database" name="" placeholder="Block Area..">
                                                    <label id="AlertError2" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Gram Panchayat Area (Ha) <span class="Required_star">*</span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="gp_area" class="form-control color_database decimal" name="" placeholder="Gram Panchayat area..">
                                                    <label id="AlertError3" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Watershed Code <span class="Required_star">*</span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="watershed_code" class="form-control color_database alphanum" name="" placeholder="Watershed Code..">
                                                    <label id="AlertError4" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">Watershed Name :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="watershed_name" class="form-control alpha" name="" placeholder="Watershed name..">
                                                    <label id="AlertError5" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">Watershed Area in Block / Taluk (Ha) :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="watershed_area_block" class="form-control decimal" name="" placeholder="Watershed are in Block / Taluk..">
                                                    <label id="AlertError6" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">Sub-basin Code :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="sub_basin_code" class="form-control alphanumspecial" name="" placeholder="Sub-basin Code..">
                                                    <label id="AlertError7" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Sub Basin Name <span class="Required_star">*</span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <select id="sub_basin_name" class="form-control alpha"></select>
                                                    @*<input Type="text" id="sub_basin_name" class="form-control color_database alpha" name="" placeholder="Sub basin name..">*@
                                                    <label id="AlertError8" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname">Basin Code :</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <input Type="text" id="basin_code" class="form-control alphanum" name="" placeholder="Basin Code..">
                                                    <label id="AlertError10" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>
                                            <div class="row database_trainer_row">
                                                <div class="col-md-4 col-sm-4">
                                                    <label for="lname" class="">Basin Name <span class="Required_star">*</span>:</label>
                                                </div>
                                                <div class="col-md-7 col-sm-8">
                                                    <select id="basin_name" class="form-control alpha"></select>

                                                    <label id="AlertError9" style="float: right;color: red;font-size: 12px!important;"></label>
                                                </div>
                                            </div>

                                            <div class="row database_trainer_row_button">
                                                <div class=" col-md-12">
                                                    <div class="text-center" style="margin-bottom:10px;">
                                                        <span style="color:red">Before going to the summary page or next, click on the save button</span>
                                                        <ul class="clearfix btnall" style=" list-style-type: none; margin: 0;  padding: 0;  overflow: hidden;">
                                                            <li class=" ">
                                                                <button class="btn btn-success" id="SAVE_BTN" onclick="SaveDetails()"> Save </button>

                                                            </li>

                                                            <li class="">
                                                                <button class="btn btnNext">Next</button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <div style="text-align:center;color:red;"><label id="AlertError"></label></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="hair-info" id="menu-12">
                        <div class="clearfix">
                            <div class="container-fluid">
                                <div class="col-md-12" style="margin-bottom:10px;">
                                    <div class="row database_trainer_row ">
                                        <h3>
                                            PGWM Committee
                                        </h3>
                                    </div>
                                    <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:hidden;">
                                        <table id="TblData" class="display  table stripe row-border order-column   table-striped table-bordered dataTable no-footer" style="width:100% !important">

                                            <thead>
                                                <tr>
                                                    <th><button class="btn btn-primary" id="add_row_btn" onclick="addrow();"><span class="updatenew"> New </span></button></th>
                                                    <th>Name</th>
                                                    <th> Designation</th>
                                                    <th> Gender</th>
                                                    <th> Social Organization </th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbldata"></tbody>
                                        </table>
                                        <div style="text-align:center;">  <label id="DError" style="text-align:center;color:red;"></label></div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-offset-1 col-md-12 col-sm-12 col-lg-10 col-lg-offset-1 form-body1">
                                        <div class="form-div">
                                            <div class="col-md-12 background-border-Database">


                                                <div class="row database_trainer_row">
                                                    <h3>
                                                        Social Monitoring
                                                    </h3>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Date</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="text" id="sm_date" class="form-control color_database" name="" placeholder="Current date..">
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Location:</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <textarea class="form-control color_database alphanum" id="sm_location" rows="2" style="border: 1px solid #ccc; border-radius: 4px;" placeholder="Location"></textarea>
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">
                                                            No of Attendees :
                                                        </label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="text" id="numberofattendees" class="form-control color_database decimal" name="" placeholder="No of Attendees...">
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Number of Male:</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="number" id="sm_male" class="form-control color_database" name="" placeholder="Number of Male..." min="0">
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Number of Female:</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="number" id="sm_female" class="form-control color_database decimal" name="" placeholder="Number of Female..." min="0">
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Latitude:</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="number" id="sm_latitude" class="form-control color_database decimal" name="" placeholder="Lattitude..." min="0">
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Longitude:</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="number" id="sm_longitude" class="form-control color_database decimal" name="" placeholder="Longitude..." min="0">
                                                    </div>
                                                </div>

                                                @*<div class="row database_trainer_row">
                                                        <div class="col-md-6 col-sm-6">
                                                            <label for="lname">Meeting Agenda:</label>
                                                        </div>
                                                        <div class="col-md-5 col-sm-6">
                                                            <input type="file" id="sm_meeting_agenda" name="sm_meeting_agenda" accept='.pdf,.doc' />
                                                        </div>
                                                    </div>*@
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">MOM(Minutes of Meeting):</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="file" id="sm_mom" name="sm_mom" accept='.pdf,.doc,.jpeg,.jpg' />
                                                    </div>
                                                </div>
                                                <div class="row database_trainer_row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <label for="lname">Photograph:</label>
                                                    </div>
                                                    <div class="col-md-5 col-sm-6">
                                                        <input type="file" id="sm_photoshop" name="sm_photoshop" accept='.jpeg,.jpg' @*onchange="validateImageFile()"*@ />
                                                    </div>
                                                </div>

                                                <div class="row database_trainer_row_button">
                                                    <div class="col-md-12 col-sm-12 text-center">
                                                        <div>
                                                            <span style="color:red">Before going to the summary page or next, click on the save button</span>
                                                        </div>
                                                        <button class="btn btn-success" id="SAVE_BTN1" onclick="Save_Social_Monitor()">Save</button>

                                                    </div>
                                                </div>
                                                <div style="text-align:center;color:red;"><label id="SMError"></label></div>
                                                <div class="row database_trainer_row_button">
                                                    <div class="col-md-6 col-sm-6 text-left">
                                                        <label>MOM(Minutes of Meeting):</label>
                                                        <div id="momtr1">

                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6 text-left">
                                                        <label>Photograph:</label>
                                                        <div id="SW_Image"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row database_trainer_row_button">
                                    <div class=" col-md-12">
                                        <div class="text-center" style="margin-bottom:10px;">

                                            <button class="btn btn-danger btnPrevious">Back</button>
                                            <button class="btn btnNext">Next</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="hair-info" id="menu-13">
                        <div class="clearfix">
                            <div class="container-fluid">
                                <div class="col-lg-12 col-md-12 col-sm-12  form-body">
                                    <div class="col-md-12 imageUpload_div text-left" style="margin-bottom:10px;">
                                        <div class="row">
                                            <div class="col-md-3 col-sm-3">

                                                <label>1.Location Map Image Upload:</label>
