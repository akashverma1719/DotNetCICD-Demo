        }

        var watershed_code = $('#watershed_code').val();
        if (watershed_code != "") {
            obj.watershed_code = $('#watershed_code').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError9').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            alert("Please Enter Watershed Code");
            document.getElementById('AlertError4').innerHTML = "Please Enter Watershed Code";
            $('#watershed_code').focus();
        }

        var gp_area = $('#gp_area').val();
        if (gp_area != "") {
            obj.gp_area = $('#gp_area').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError9').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "Please Enter Gram Panchayat area (Ha)";
            $('#gp_area').focus();
            alert("Please Enter Gram Panchayat area (Ha)");
        }

        var block_area = $('#block_area').val();
        if (block_area != "") {
            obj.block_area = $('#block_area').val();
        }
        else {
            ddd = 1;
            document.getElementById('AlertError1').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "";
            document.getElementById('AlertError3').innerHTML = "";
            document.getElementById('AlertError4').innerHTML = "";
            document.getElementById('AlertError5').innerHTML = "";
            document.getElementById('AlertError6').innerHTML = "";
            document.getElementById('AlertError7').innerHTML = "";
            document.getElementById('AlertError8').innerHTML = "";
            document.getElementById('AlertError9').innerHTML = "";
            document.getElementById('AlertError10').innerHTML = "";
            document.getElementById('AlertError2').innerHTML = "Please Enter Block Area (Ha)";
            $('#block_area').focus();
            alert("Please Enter Block Area (Ha)");
        }

        obj.basin_code = $('#basin_code').val();

        if (ddd == 0 && verification_val == 1 && DPMU_Level_Count == 2) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Wsp_new/SaveGrampanchayatDetails",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    if (response != "Successfully Saved" && response != "Logout" && response != "Please Select Basin Name" && response != "Please Enter Block Area (Ha)" && response != "Please Enter Gram Panchayat Area (Ha)" && response != "Please Select Sub Basin Name" && response != "Please Enter Watershed Code") {
                        window.location = "/Error/DefaultError";
                    }

                    alert("Verified Successfully");
                }
            });
        }
        else {
            DPMU_Level_Count = 1;
            Details();
        }


    }

</script>
@*PGWM Committee Scripts*@
<script>
    // Other Option Script
    function CheckDepartment(val) {

        var element = document.getElementById('otherdepartment');
        var elementSelect = document.getElementById('department');
        if (val == 'others')
            element.style.display = 'block';

        else
            element.style.display = 'none';
        if (val == 'others')
            elementSelect.style.display = 'none';

        else
            elementSelect.style.display = 'block';
    }
    // PGWM TABLE
    var a = 1;
    function addrow() {

        var count = 1;
        if (a == 1) {
            a = 0;
            var code = "<tr id='c1_count'><td><button class='btn btn-success' onclick='PGWDepDetails()'>Save</button > <button type='button' class='btn btn-danger' onclick='cancelone();'>Cancel</button></td>" +
                "<td><input type='text' class='form-control alpha' id='countname'/></td> " +
                "<td><input type='text' class='form-control alpha' id='designation'/></td>" +
                "<td><select class='form-control' id='gender'><option value='0'>Select Gender</option><option value='Male'> Male</option><option value='Female'>Female</option><option value='Other'>Other</option></select></td>" +
                "<td> <select id='department' class='form-control' onchange='CheckDepartment(this.value);'><option value='0'>Select Social Oraganization</option><option value='VWSC (Village Water & Sanitation Committee)'>VWSC (Village Water & Sanitation Committee)</option><option value='SHG (Self Help Group)'>SHG (Self Help Group)</option><option value='WUA (Water User Association)'>WUA (Water User Association) </option><option value='Cooperative Societies'>Cooperative Societies</option> <option value='others'>others</option></select><input type='text' class='form-control' name='otherdepartment' id='otherdepartment' style='display:none;' /></td></tr>";
            $('table#TblData tbody').prepend(code);
        }
        //count=count+1;
        //alert(count);
    }
    function cancelone() {
        // addrow();
        $('table#TblData tbody tr#c1_count').remove();
        a = 1;
    }
</script>

<script>
    var today = new Date();
    $(document).ready(function () {

    });


    function Save_Social_Monitor() {
        //File Extension check
        debugger;
        
        
        var ii = 0;
        var ext = $('#sm_mom').val().split('.').pop().toLowerCase();
        var ext1 = $('#sm_photoshop').val().split('.').pop().toLowerCase();
        if (ext != "") {
            if ($.inArray(ext, ['pdf', 'jpg', 'jpeg', 'doc']) == -1) {
                alert('Your Upload file has Not valid File, Please Upload proper file');
                ii = 1;
                return false;
            }
        }
        if (ext1 != "") {
            if ($.inArray(ext1, ['png', 'jpg', 'jpeg']) == -1) {
                alert('Your Upload file has Not valid File, Please Upload proper file');
                ii = 1;
                return false;
            }
        }
        
        $('#SAVE_BTN1').prop('disabled', true);
        var sm_date = $('#sm_date').val();
        var sm_location = $('#sm_location').val();
        var numberofattendees = $('#numberofattendees').val();
        var sm_male = $('#sm_male').val();
        var sm_female = $('#sm_female').val();
        var sm_latitude = $('#sm_latitude').val();
        var sm_longitude = $('#sm_longitude').val();

        if (ii == 0) {
            $.ajax({
                url: "/Wsp_new/Social_Monitoring_info",
                type: "POST",
                data: function () {
                    var data = new FormData();
                    data.append("sm_date", sm_date);
                    data.append("sm_location", sm_location);
                    data.append("numberofattendees", numberofattendees);
                    data.append("sm_male", sm_male);
                    data.append("sm_female", sm_female);
                    data.append("sm_latitude", sm_latitude);
                    data.append("sm_longitude", sm_longitude);
                    data.append("sm_mom", jQuery("#sm_mom").get(0).files[0]);
                    data.append("sm_photoshop", jQuery("#sm_photoshop").get(0).files[0]);

                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {


                    alert(response);
                    if (response == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else if (response != "Successfully Saved" && response != 'Your Upload file has Not valid File, Please Upload proper file' && response != "Your Upload file has Double Extention, Please Upload proper file" && response != "Logout") {
                        window.location = "/Error/DefaultError";

                    }
                    else {
                        $('#SMError').text(response);
                    }

                    $("#sm_date").val("");
                    $("#sm_location").val("");
                    $("#numberofattendees").val("");
                    $("#sm_male").val("");
                    $("#sm_female").val("");
                    $("#sm_latitude").val("");
                    $("#sm_longitude").val("");
                    $("#sm_mom").val("");
                    $("#sm_photoshop").val("");
                    Social_Monitor_Details();
                    $('#SAVE_BTN1').prop('disabled', false);

                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                }
            });
        }

    }

    function Social_Monitor_Details() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/Social_Monitor_Details_website1',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                $("#momtr1").html("");
                $("#SW_Image").html("");
                if (data.length != 0) {
                    //alert(data.length);
                    $('#sm_date').val(data[0].date);
                    $('#sm_location').val(data[0].location);
                    $('#numberofattendees').val(data[0].numberofattendees);
                    $('#sm_male').val(data[0].male);
                    $('#sm_female').val(data[0].female);
                    $('#sm_latitude').val(data[0].latitude);
                    $('#sm_longitude').val(data[0].longitude);


                    if (data[0].minutesofmeeting != null && data[0].minutesofmeeting != "" && data[0].minutesofmeeting != "null") {
                        var abc = '<a href="' + data[0].minutesofmeeting + '" download="" target="_blank">' + data[0].mom_filename + '</a>' + ' <button class = "btn btn-danger disable_btn" type= "button" onclick="Delete_mom_pdf(' + data[0].id + ')">Delete</button>'
                        $("#momtr1").html(abc);
                    }
                    if (data[0].image != null && data[0].image != "" && data[0].image != "null") {
                        var abcd = '<a href="' + data[0].image + '" download="" target="_blank">' + data[0].photogragh_filename + '</a>' + ' <button class = "btn btn-danger disable_btn" type= "button" onclick="Delete_mom_photo(' + data[0].id + ')">Delete</button>'
                        $("#SW_Image").html(abcd);
                    }
                    $('.disable_btn').prop('disabled', true);
                    if (Auth == "WSP") { $('.disable_btn').prop('disabled', false);}
                }

            }

        });
    }



    function PGWDepDetails() {

        var State = $('#spnstate').text();
        var Designation = document.getElementById('designation').value;
        var department = document.getElementById('department').value;
        if (department == "others") {
            department = $('#otherdepartment').val();
        }
        var UserName = document.getElementById('countname').value;
        var Gender = document.getElementById('gender').value;
        var i = 0;
        if (Designation == "") {
            i = 1;
            document.getElementById('DError').innerHTML = "Please Enter Designation";
        }
        if (department == "0") {
            i = 1;
            document.getElementById('DError').innerHTML = "Please select  Department";
        }
        if (UserName == "") {
            i = 1;
            document.getElementById('DError').innerHTML = "Please Enter UserName";
        }
        if (Gender == "0") {
            i = 1;
            document.getElementById('DError').innerHTML = "Please select Gender";
        }
        if (i == 0) {
            var obj = {};
            obj.state_name = $('#spnstate').text();
            obj.district_name = $('#spndistrict').text();
            obj.block = $('#spnblock').text();
            obj.gname = $('#spngram').text()
            obj.villname = "";
            obj.designation = document.getElementById('designation').value;
            obj.department = department;
            obj.countname = document.getElementById('countname').value;
            obj.gender = document.getElementById('gender').value;

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Wsp_new/PGWN_DepetDetails",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else if (response != "Successfully Saved" && response != "Logout" && response != "Please Enter Designation" && response != "Please Select Social Organization" && response != "Please Enter Name" && response != "Please Select Gender") {
                        window.location = "/Error/DefaultError";

                    }
                    cancelone();
                    a = 1;
                    pgwn_Data();
                    document.getElementById('DError').innerHTML = response;
                }


            });
        }
        else {

            a = 1;
            cancelone();
        }

    }
    function pgwn_Data() {

        var State_name = $('#spnstate').text();
        var District_name = $('#spndistrict').text();
        var Block = $('#spnblock').text();
        var Gname = $('#spngram').text();
        //  var Villname = document.getElementById('village').value;
        var Villname = "";

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/pgwn_Depdetails',
            data: { 'state': State_name, 'dist': District_name, 'block': Block, 'gram': Gname, 'vill': Villname },
            dataType: 'JSON',
            success: function (data) {

                if (data == "Error") {
                    window.location = "/Wsp_new/WSPgram";
                }
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }


                let tr = "";

                if (data != null || data.length != 0) {

                    //alert("data is not equal to null");
                    ////alert(data);
                    ////alert(data.length);
                    for (var i = 0; i < data.length; i++) {
                        tr += '<tr><td><button type="button" class="btn btn-danger disable_btn" onclick="Delete_DeptData(' + data[i].pgwndeptid + ')">Delete</button></td><td>' + data[i].countname + '</td><td>' + data[i].designation + '</td><td>' + data[i].gender + '</td><td> ' + data[i].department + '</td></tr>';
                    }
                }
                else {
                    tr += '<tr><td colspan="5"  style="text-align:center;">No Data</td></tr>';
                }
                if (tr == "") {
                    tr += '<tr><td colspan="5" style="text-align:center;">No Data</td></tr>';
                }

                $("#tbldata").html(tr);
                //$('.disable_btn').prop('disabled', true);
                //if (Auth == "WSP") { $('.disable_btn').prop('disabled', false); }

            }
        });

    }

    function Delete_DeptData(id) {
        var obj = {};

        obj.pgwndeptid = id;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Wsp_new/DeletePGWNDeptDetail",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);

                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                } else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                    window.location = "/Error/DefaultError";
                }
                pgwn_Data();
                document.getElementById('DError').innerHTML = response;

            }
        });
    }
</script>
<script type="text/javascript">
    $('li.leftbtnnext > button.btnprocess1').click(function () {

        $('ul#myTabs.nav-pills.nav-justified > li').siblings('li').removeClass('active');
