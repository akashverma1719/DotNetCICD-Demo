<body>
    <div class="container" id="Data1">
        <div class="row row_padding_10">
            <div class="col-md-12 ">
                <div class="firsttable col-md-12">
                    <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
                </div>

            </div>
            <div class="col-md-12 report_heading_div">
                <div class="col-md-9">
                    <h1>Water Availability Report </h1>
                </div>
                <div class="col-md-3 text-right btn_hide" id="btnExport">
                    <button class="btn btn-success download1" onclick="ReportPdf();" id="download">Download</button>
                </div>
                <div class="col-md-12">
                    <ul class="dateandtime_ul">
                        <li>Date : <span id="demoaval"></span></li>
                        <li>Time : <span id="demoaval2"></span></li>
                        <li>
                            User Name :
                            @if (Session["UserName"] != null)
                            {
                                <span>@Session["UserName"].ToString()</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-md-12 state_dist_level">
                <div class="row" id="Select_dist_level">
                    <ul class="Select_option">
                        @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                        {

                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                        {
                            <li>
                                <label id="lblstate">Admin</label>

                            </li>
                        }
                        else
                        {
                            <li>
                                <label id="lblstate">National Level Nodal Officer</label>

                            </li>
                        }


                        @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                        {
                            <li>

                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }

                        @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                        {
                            <li>

                                <label>Block:</label>
                                <span>@Session["gblock"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                        {
                            <li>

                                <label>Gram panchayat:</label>
                                <span>@Session["ggram"]</span>

                            </li>
                        }


                    </ul>
                </div>

            </div>
            <div class="col-md-12">
                <div class="col-md-6">
                    <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer Water_Availability_table_individual">
                        <thead>
                            <tr class="tableheader1 text-center">
                                <th colspan="3" style="padding-bottom:15px;" class="text-center">Water Availability </th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <th>A</th>
                                <th>
                                    Total Available Water From Rainfall
                                </th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Annual Rainfall (mm)</td>
                                <td><span id="sw_annual_rainfall"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Volume of Rainfall (Ha.m)</td>
                                <td><span id="sw_tol_water_avail"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Evapotranspiration (mm)</td>
                                <td><span id="sw_evapo"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Evapotranspiration Losses (Ha.m)</td>
                                <td><span id="sw_evapo_loses"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="tolat_report_color"> Water Available  From Rainfall</td>
                                <td><span id="total_sw_availble"></span></td>
                            </tr>



                            <tr>
                                <th>B</th>
                                <th>GROUND WATER</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>
                                    Recharge From Rainfall (Ha.m)
                                </td>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Monsoon </td>
                                <td><span id="gw_rainfall_monsoon"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Non-Monsoon</td>
                                <td><span id="gw_rainfall_nonmonsoon"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color"></th>
                                <th class="tolat_report_color">Total (Ha.m)</th>
                                <td><span id="gw_rainfal_tol_recharge"></span></td>
                            </tr>
                            <tr>
                                <th>ii</th>
                                <th>Recharge From Other Sources (Ha.m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Monsoon </td>
                                <td><span id="gw_other_monsoon"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Non-Monsoon</td>
                                <td><span id="gw_other_nonmonsoon"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color"></th>
                                <th class="tolat_report_color">Total (Ha.m)</th>
                                <td><span id="gw_other_tol_recharge"></span></td>
                            </tr>
                            <tr>
                                <th class="">iii</th>
                                <th class="">
                                    Losses Due to Natural Discharge (Ha.m)
                                </th>
                                <td><span id="natural_losses"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iv</th>
                                <th class="tolat_report_color">
                                    Total Ground Water Available (Ha.m)
                                </th>
                                <td><span id="total_gw_available"></span></td>
                            </tr>
                            <tr>
                                <th>C</th>
                                <th>SURFACE WATER STORAGES</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>
                                    No. of Surface Water Bodies
                                </td>
                                <td><span id="noof_sw_storage_structures"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>
                                    Storage Capacity of the Structures (Ha. m)
                                </td>
                                <td><span id="total_storage_capacity"></span></td>
                            </tr>
                            <tr>
                                <td>iii)</td>
                                <td>
                                    Surface Water Available (Ha.m)in Storages
                                </td>
                                <td><span id="sw_available_for_use"></span></td>
                            </tr>
                            <tr>
                                <td>iv)</td>
                                <td>
                                    Losses if Any (%) :
                                </td>
                                <td><span id="loss_percentage"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">v)</th>
                                <th class="tolat_report_color">
                                    Total Water Available for Utilization(Ha.m)
                                </th>
                                <td class=""><span id="total_water_avaliable_utiilization"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">vi)</th>
                                <th class="tolat_report_color">
                                    Rainfall Available for Future Use(Ha.m)
                                </th>
                                <td class=""><span id="volume_of_runoff"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Weighted Average Runoff Coefficient</td>
                                <td><span id="weighted_avg_runoff"></span></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Utilizable Rainfall Runoff (Ha.m)</td>
                                <td><span id="utilizable_rainfall_runoff"></span></td>
                            </tr>
                            @*<tr>
                                    <td>v)</td>
                                    <td>Ground Water recharge (Ha.m)</td>
                                    <td><span id="total_gw_racharge"></span></td>
                                </tr>*@

                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <div id="container_Water_Availability" style="min-width: 310px; height: 450px;"></div>
                </div>
            </div>
            <div class="col-md-12" style="margin-bottom:15px;">
                <div class="col-md-12 ">
                    <p class="text-center">
                        .............................
                    </p>
                    <p class="text-justify">
                        The results and analysis contained within the Water Budgeting Report are generated with the help of inputs given by the
                        user as well as existing database. Each component of water budgeting is designed to make understand the users about
                        the processes, parameters and equations involved in the system. The overall goal of water budgeting is therefore to
                        improve the management of ground water resources in priority areas of the country.
                    </p>
                    <p class="text-center">
                        .............................
                    </p>
                </div>
                <div class="col-md-12 last-div-footer hidediv" id="btnExport1">
                    <div class="col-md-12 text-center">
                        <a href="~/WspNew/WspWaterAvailability" class="btn btn-danger">
                            Back
                        </a>
                        @*<button type="button" id="download" onclick="ReportPdf();" class="btn btn-success download1">Download</button>*@
                        <a href="~/WspNew/WspDraft" class="btn btn-primary">
                            Go to Water Utilization
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {


        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterAvailabilityreport.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
    }


</script>

<script>
    var GroundWater = 0, SurfaceWater = 0, Total_Water_Available = 0, volume_of_runoff = 0, Utilizable_Rainfall_Runoff1 = 0;
    var Access_Auth = "";
    $(document).ready(function () {
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
        Info1();
    });
    function Info1() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/WaterAvailabiltyInfo_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    window.location = "/Wsp_new/waterAval_report";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (response.length != 0) {


                    if (response[0].gw_rainfall_monsoon != null && response[0].gw_rainfall_monsoon != "") {
                        $('#gw_rainfall_monsoon').text(parseFloat(response[0].gw_rainfall_monsoon).toFixed(2));
                    }
                    if (response[0].gw_rainfall_nonmonsoon != null && response[0].gw_rainfall_nonmonsoon != "") {
                        $('#gw_rainfall_nonmonsoon').text(parseFloat(response[0].gw_rainfall_nonmonsoon).toFixed(2));
                    }
                    if (response[0].gw_rainfal_tol_recharge != null && response[0].gw_rainfal_tol_recharge != "") {
                        $('#gw_rainfal_tol_recharge').text(parseFloat(response[0].gw_rainfal_tol_recharge).toFixed(2));
                    }

                    if (response[0].gw_other_monsoon != null && response[0].gw_other_monsoon != "") {
                        $('#gw_other_monsoon').text(parseFloat(response[0].gw_other_monsoon).toFixed(2));
                    }
                    if (response[0].gw_other_nonmonsoon != null && response[0].gw_other_nonmonsoon != "") {
                        $('#gw_other_nonmonsoon').text(parseFloat(response[0].gw_other_nonmonsoon).toFixed(2));
                    }

                    if (response[0].gw_other_tol_recharge != null && response[0].gw_other_tol_recharge != "") {
                        $('#gw_other_tol_recharge').text(parseFloat(response[0].gw_other_tol_recharge).toFixed(2));
                    }

                    if (response[0].total_gw_available != null && response[0].total_gw_available != "") {
                        GroundWater = parseFloat(response[0].total_gw_available);
                        $('#total_gw_available').text(parseFloat(response[0].total_gw_available).toFixed(2));
                    }

                    if (response[0].sw_annual_rainfall != null && response[0].sw_annual_rainfall != "") {

                        $('#sw_annual_rainfall').text(parseFloat(response[0].sw_annual_rainfall).toFixed(2));
                    }

                    if (response[0].sw_tol_water_avail != null && response[0].sw_tol_water_avail != "") {

                        $('#sw_tol_water_avail').text(parseFloat(response[0].sw_tol_water_avail).toFixed(2));
                    }

                    if (response[0].sw_evapo != null && response[0].sw_evapo != "") {

                        $('#sw_evapo').text(parseFloat(response[0].sw_evapo).toFixed(2));
                    }

                    if (response[0].sw_evapo_loses != null && response[0].sw_evapo_loses != "") {

                        $('#sw_evapo_loses').text(parseFloat(response[0].sw_evapo_loses).toFixed(2));
                    }

                    if (response[0].total_gw_racharge != null && response[0].total_gw_racharge != "") {

                        $('#total_gw_racharge').text(parseFloat(response[0].total_gw_racharge).toFixed(2));
                    }

                    if (response[0].total_sw_availble != null && response[0].total_sw_availble != "") {
                        Total_Water_Available = parseFloat(response[0].total_sw_availble);
                        $('#total_sw_availble').text(parseFloat(response[0].total_sw_availble).toFixed(2));
                    }

                    //GroundWater

                    //Surface Water

                    if (response[0].noof_sw_storage_structures != null && response[0].noof_sw_storage_structures != "") {

                        $('#noof_sw_storage_structures').text(parseFloat(response[0].noof_sw_storage_structures).toFixed(2));
                    }

                    if (response[0].total_storage_capacity != null && response[0].total_storage_capacity != "") {

                        $('#total_storage_capacity').text(parseFloat(response[0].total_storage_capacity).toFixed(2));
                    }

                    if (response[0].sw_available_for_use != null && response[0].sw_available_for_use != "") {
                        SurfaceWater = parseFloat(response[0].sw_available_for_use);
                        $('#sw_available_for_use').text(parseFloat(response[0].sw_available_for_use).toFixed(2));
                    }

                    if (response[0].volume_of_runoff != null && response[0].volume_of_runoff != "") {

                        $('#volume_of_runoff').text(parseFloat(response[0].volume_of_runoff).toFixed(2));
                        volume_of_runoff = parseFloat(response[0].volume_of_runoff);
                    }

                    if (response[0].weighted_avg_runoff != null && response[0].weighted_avg_runoff != "") {

                        $('#weighted_avg_runoff').text(parseFloat(response[0].weighted_avg_runoff).toFixed(2));

                    }

                    if (response[0].utilizable_rainfall_runoff != null && response[0].utilizable_rainfall_runoff != "") {
                        Utilizable_Rainfall_Runoff1 = parseFloat(response[0].utilizable_rainfall_runoff);
                        $('#utilizable_rainfall_runoff').text(parseFloat(response[0].utilizable_rainfall_runoff).toFixed(2));

                    }

                    if (response[0].natural_losses != null && response[0].natural_losses != "") {
                        $('#natural_losses').text(parseFloat(response[0].natural_losses).toFixed(2));
                    }

                    if (response[0].loss_percentage != null && response[0].loss_percentage != "") {
                        $('#loss_percentage').text(parseFloat(response[0].loss_percentage).toFixed(2));
                    }
                    if (response[0].total_water_avaliable_utiilization != null && response[0].total_water_avaliable_utiilization != "") {
                        $('#total_water_avaliable_utiilization').text(parseFloat(response[0].total_water_avaliable_utiilization).toFixed(2));
                    }


                }

                Charts();
            }
        });

    }
    function Charts() {
        Highcharts.chart('container_Water_Availability', {
            chart: {
                type: 'column'
            },
            title: {
                text: ' Water Availability (Ha. M)'
            },

            xAxis: {
                type: 'category'
            },
            yAxis: {
                title: {
                    text: ''
                }

            },
            colors: [
                '#A0D468',
                '#ED5565',
                '#5D9CEC',
                '#c42525'

            ],
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
