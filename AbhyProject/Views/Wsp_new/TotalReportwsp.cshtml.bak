<meta name="viewport" content="width=device-width" />
 <META Http-Equiv="Cache-Control" Content="no-cache" />
  <META Http-Equiv="Pragma" Content="no-cache" />
  <META Http-Equiv="Expires" Content="0" />

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/css/wsp_report_css.css" rel="stylesheet" />
<!-- Latest compiled JavaScript -->

<script src="~/Content/JS_Files/IdealState.js"></script>
<style>
    .page2el {
        margin-top: 15px;
    }
</style>
<style>
    body {
        font-family: Calibri !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .reportheading {
        color: #337ab7;
        font-size: 25px;
        font-weight: bold;
    }

    .demandside_text > tbody > tr > td {
        text-align: right;
        font-size: 14px !important;
    }

    .demandside_text > tbody > tr.tableheader_text > th {
        font-size: 14px !important;
    }

    .demandside_text > tbody > tr > td:last-child {
        text-align: left !important;
    }

    .demanside_padding_heading1 {
        padding: 0px !important;
    }

    .supplyside_demandside_space1 > .reportheading > p {
        margin: 0px 0 6px !important;
    }

    .demandside_text_123 > tbody > tr > th {
        font-size: 14px !important;
    }

    .dateandtime_ul {
        padding: 0px;
    }

    .image_space_gap {
        margin-top: 230px;
    }

    .pgwm_table_space {
        margin-top: 320px;
    }

    .main_heading_sm_total {
        margin-top: 70px;
        margin-bottom: 280px;
    }

    .sm_image_gap {
        margin-top: 210px;
        margin-bottom: 100px;
    }

    .image_space_gap_2 {
        margin-top: 40px;
    }

    .image_space_gap31 {
        margin-top: 15px;
    }

    .dateandtime_ul > li {
        display: inline-block;
        color: #000;
        font-size: 18px;
        padding: 0px 15px;
    }

    .table-striped tbody tr td:last-child {
        text-align: right;
    }

    .pgwmtable tbody tr td:last-child,
    .demandsidetable tr td:last-child {
        text-align: left !important;
    }

    .wateravaliablity_space {
        margin-top: 186px;
    }

    .waterdrft_space {
        margin-top: 18px;
    }

    .waterdrft_balance {
        margin-top: 180px;
    }

    .waterdrft_Budgeting_space {
        margin-top: 280px;
    }

    .hideDownload {
        display: none;
    }

    .singnatire_table tbody tr td {
        height: 100px;
    }

    .supplyside_demandside_space {
        margin-top: 340px;
    }

    .pgwmCommiteee_space {
        margin-top: 70px;
        margin-bottom: 50px;
    }

    .pgwm_range {
        margin-top: 280px;
    }

    .background_after_download * {
        font-weight: normal !important;
        text-decoration: none !important;
        text-shadow: none !important;
    }

    .tableheadingbg {
        color: #337ab7 !important;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        background: #fff;
    }

    .colorline1 {
        background: #ddd;
        background-size: 100% 6px;
        background-position: 50% 100%;
        background-repeat: no-repeat;
        text-align: center;
        margin-top: 12px;
        height: 3px;
        width: 100%
    }

    .col-md-9 > h1 {
        font-weight: bold;
        color: #404040;
        text-shadow: -1px -1px #000;
    }

    .col-md-9 > p {
        color: #404040;
    }

    .col12 > .firsttable > h6 {
        letter-spacing: 0px;
        padding-left: 10px;
    }

    .firstptag {
        padding-left: 4%;
    }

    body {
        background-color: #ddd;
    }

    .clearfixcolor {
        margin-top: 15px;
    }

    .col12 {
        background-color: #fff;
        padding: 25px;
    }

    .highcharts-credits {
        display: none;
    }



    .highcharts-button-box {
        display: none;
    }


    .text-right > .btn-success {
        margin-top: 20px;
        font-weight: bold;
    }

    .text-right {
        padding: 5px;
    }

        .text-right > .btn-success {
            padding: 8px 20px 8px 20px;
            border-radius: 50px;
            font-size: 18px;
        }

    .btn-success {
        color: #fff;
        background-color: #6fb01d;
        border-color: #4cae4c;
    }

    .coll7 {
        padding-right: 0px;
    }

    ul.Select_option {
        list-style: none;
        display: block;
        padding: 0px 0px 0px 0px;
        font-size: 15px;
        margin: 0px;
    }

        ul.Select_option > li {
            display: inline-block;
            padding: 0px 0px 0px 46px;
            word-spacing: 1px;
            text-transform: uppercase;
        }

            ul.Select_option > li > span > i {
                padding: 0px 0px 0px 10px;
            }

    #Select_dist_level {
        padding: 10px 0px 5px 15px;
        text-transform: capitalize;
    }

    ul.firstimages {
        display: block;
        margin-bottom: 0px;
    }

        ul.firstimages > li {
            display: inline-block;
            padding-left: 5px;
            border: 1px solid #ddd;
            padding: 10px 10px 5px 10px;
        }

            ul.firstimages > li > img {
                border-left: 2px solid #ddd;
            }

            ul.firstimages > li > span > img {
                width: 25px;
                height: 25px;
            }

    .highcharts-title {
        font-weight: bold;
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
        font-size: 13px;
    }

    tspan {
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    }



    .secondtable {
        text-align: right;
    }

    sup {
        font-weight: bold;
    }

    .tableheadingbg > span {
        color: purple;
        font-size: 20px;
    }

    .totatal_value_label {
        background-color: #fff;
        padding: 10px;
    }

    #Data1 {
        background-color: #fff;
    }

    .firsttable {
        padding: 0px 0px 0px 0px;
    }

    .report_heading_div {
        background-color: #ddd;
        border-radius: 10px;
        padding: 10px;
    }

    .cololr-div {
        background: #4cae4c;
        height: 3px;
        padding: 0px;
    }

    .last-div-footer {
        padding: 10px 0px;
    }

    .table-condensed {
        font-weight: 100;
        text-shadow: none;
    }

    .tolat_report_color {
        color: #6FB11D !important;
    }

    .wateravaliablity_table > thead > tr > td,
    .wateravaliablity_table > tbody > tr > td {
        padding: 0px 3px;
    }

    table > tbody > tr > td {
        color: #337ab7 !important;
        font-weight: 500;
    }

    table > tbody > tr > th {
        color: #337ab7 !important;
    }

    table > tbody > tr > td > label {
        color: #000 !important;
    }

    table > tbody > tr > td > span {
        color: #000 !important;
    }

    .pgwmtable > tbody > tr > td {
        color: #000 !important;
    }
</style>
<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<div class="container" id="Data1">
    <div class="row row_padding_10">
        <div class="col-md-12">
            <div class="firsttable col-md-12">
                <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
            </div>
        </div>
        <div class="col-md-12 report_heading_div">
            <div class="col-md-9">
                <h1>Water Security Plan Report </h1>
            </div>
            <div class="col-md-3 text-right btn_hide" id="btnExport">
                <button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>
            </div>
            <div class="col-md-12">
                <ul class="dateandtime_ul">
                    <li>Date : <span id="demo"></span></li>
                    <li>Time : <span id="demo2"></span></li>
                    <li>
                        User Name:
                        @if (Session["UserName"] != null)
                        {
                            <span>@Session["UserName"].ToString()</span>
                        }
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12 state_dist_level">
            <div class="row" id="Select_dist_level">
                <ul class="Select_option">
                    @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                    {

                        <li>
                            <label id="lblstate">State:</label>
                            <span id="spnstate">@Session["gstate"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                    {
                        <li>
                            <label id="lblstate">Admin</label>

                        </li>
                    }
                    else
                    {
                        <li>
                            <label id="lblstate">National Level Nodal Officer</label>

                        </li>
                    }


                    @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                    {
                        <li>

                            <label id="lbldistrict">District:</label>
                            <span id="spndistrict">@Session["gdist"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }

                    @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                    {
                        <li>

                            <label>Block:</label>
                            <span id="spnblock">@Session["gblock"]</span>
                            <i class="fas fa fa-angle-double-right"></i>
                        </li>
                    }
                    @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                    {
                        <li>

                            <label>Gram panchayat:</label>
                            <span id="spngram">@Session["ggram"]</span>

                        </li>
                    }



                </ul>
            </div>

        </div>
        <div class="gramReport_div_start col-md-12">
            <div class="text-center reportheading">
                <p>Gram Panchayat Information</p>
            </div>

            <div class="col-md-12">
                <div id="resetinfo" class="tbl-responsive" style="padding:5px;overflow-x:scroll">
                    <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <tbody class="tablebaody">

                            <tr>
                                <td>State:</td>
                                <td>
                                    <span id="state_name"></span>
                                </td>
                                <td>District:</td>
                                <td>
                                    <span id="district_name"></span>
                                    @*<input type="text" class="form-control decimal" id="district_name" placeholder="Enter the numeric value" />*@
                                </td>
                            </tr>
                            <tr>
                                <td>Block / Taluk :</td>
                                <td>
                                    <span id="block_name"></span>
                                    @*<input type="text" class="form-control decimal" id="block_name" placeholder="Enter the numeric value" />*@
                                </td>
                                <td>GP Name :</td>
                                <td>
                                    <span id="gram_panchayat_name"></span>
                                    @*<input type="text" class="form-control decimal" id="gram_panchayat_name" placeholder="Enter the numeric value" />*@
                                </td>
                            </tr>

                            <tr>
                                <td>GP ID :</td>
                                <td>
                                    <span id="gp_id"></span>
                                    @*<input type="text" class="form-control decimal" id="gp_id" placeholder="Enter the numeric value" />*@
                                </td>
                                <td>Block Area  (Ha) :</td>
                                <td>
                                    <span id="block_area"></span>
                                    @*<input type="text" class="form-control decimal" id="block_area" placeholder="Enter the numeric value" />*@
                                </td>
                            </tr>
                            <tr>
                                <td>GP area (Ha) :</td>
                                <td>
                                    <span id="gp_area"></span>
                                    @*<input type="text" class="form-control decimal" id="gp_area" placeholder="Enter the numeric value" />*@
                                </td>
                                <td>Watershed Code :</td>
                                <td>
                                    <span id="watershed_code"></span>


                                </td>
                            </tr>
                            <tr>
                                <td>Watershed name :</td>
                                <td>
                                    <span id="watershed_name"></span>

                                </td>
                                <td>Watershed area in Block / Taluk (Ha) :</td>
                                <td>
                                    <span id="watershed_area_block"></span>

                                </td>
                            </tr>

                            <tr>
                                <td>Sub-basin Code :</td>
                                <td>
                                    <span id="sub_basin_code"></span>

                                </td>
                                <td>Sub basin name :</td>
                                <td>
                                    <span id="sub_basin_name"></span>

                                </td>
                            </tr>
                            <tr>
                                <td>Basin Code :</td>
                                <td>
                                    <span id="basin_code"></span>

                                </td>
                                <td>Basin Name :</td>
                                <td>
                                    <span id="basin_name"></span>
                                    @*<input type="text" class="form-control decimal" id="basin_name" placeholder="Enter the numeric value" />*@
                                </td>
                            </tr>
                            <tr>
                                <td>Livestock Population:</td>
                                <td>
                                    <span id="domestic_livestock_count"></span>

                                </td>
                                <td>Human Population:</td>
                                <td>
                                    <span id="domestic_people_count"></span>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="page2el">
            <div class="col-md-12 wateravaliablity_space1">
                <div class="text-center reportheading">
                    <p>Water Availability  Report</p>
                </div>

                <div class="col-md-12">
                    <div class="col-md-6">
                        <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer wateravaliablity_table">
                            <tbody>

                                <tr>
                                    <th>A</th>
                                    <th>
                                        Total Available Water From Rainfall
                                    </th>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <td>i)</td>
                                    <td>Annual Rainfall (mm)</td>
                                    <td><span id="sw_annual_rainfall"></span></td>
                                </tr>
                                <tr>
                                    <td>ii)</td>
                                    <td>Volume of Rainfall (Ha.m)</td>
                                    <td><span id="sw_tol_water_avail"></span></td>
                                </tr>
                                <tr>
                                    <td>iii)</td>
                                    <td>Evapotranspiration (mm)</td>
                                    <td><span id="sw_evapo"></span></td>
                                </tr>
                                <tr>
                                    <td>iv)</td>
                                    <td>Evapotranspiration losses (Ha.m)</td>
                                    <td><span id="sw_evapo_loses"></span></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <th class="tolat_report_color">Water Available From Rainfall</th>
                                    <td><span id="total_sw_availble"></span></td>
                                </tr>


                                <tr>
                                    <th>B</th>
                                    <th>GROUND WATER</th>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <td>i)</td>
                                    <td>
                                        Recharge From Rainfall  (Ha.m)
                                    </td>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <th></th>
                                    <td>Monsoon </td>
                                    <td><span id="gw_rainfall_monsoon"></span></td>
                                </tr>
                                <tr>
                                    <th></th>
                                    <td>Non-Monsoon</td>
                                    <td><span id="gw_rainfall_nonmonsoon"></span></td>
                                </tr>
                                <tr>
                                    <th class="tolat_report_color"></th>
                                    <th class="tolat_report_color">Total</th>
                                    <td><span id="gw_rainfal_tol_recharge"></span></td>
                                </tr>
                                <tr>
                                    <td>ii</td>
                                    <td>Recharge From Other Sources (Ha.m)</td>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <th></th>
                                    <td>Monsoon </td>
                                    <td><span id="gw_other_monsoon"></span></td>
                                </tr>
                                <tr>
                                    <th></th>
                                    <td>Non-Monsoon</td>
                                    <td><span id="gw_other_nonmonsoon"></span></td>
                                </tr>
                                <tr>
                                    <th class="tolat_report_color"></th>
                                    <th class="tolat_report_color">Total</th>
                                    <td><span id="gw_other_tol_recharge"></span></td>
                                </tr>
                                <tr>
                                    <th class="">iii</th>
                                    <th class="">Losses Due to Natural Discharge (Ha.m)</th>
                                    <td><span id="natural_losses"></span></td>
                                </tr>
                                <tr>
                                    <th class="tolat_report_color">iv</th>
                                    <th class="tolat_report_color">
                                        Total Ground Water Available (Ha.m)
                                    </th>
                                    <td><span id="total_gw_available"></span></td>
                                </tr>

                                <tr>
                                    <th>C</th>
                                    <th>SURFACE WATER STORAGES</th>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <td>i)</td>
                                    <td>
                                        No. of Surface Water Bodies
                                    </td>
                                    <td><span id="noof_sw_storage_structures"></span></td>
                                </tr>
                                <tr>
                                    <td>ii)</td>
                                    <td>
                                        Storage Capacity of the structures (Ha. m)
                                    </td>
                                    <td><span id="total_storage_capacity"></span></td>
                                </tr>
                                <tr>
                                    <td>iii)</td>
                                    <td>
                                        Surface Water Available (Ha.m)in Storages
                                    </td>
                                    <td><span id="sw_available_for_use"></span></td>
                                </tr>
                                <tr>
                                    <td>iv)</td>
                                    <td>
                                        Losses if Any (%) :
                                    </td>
                                    <td><span id="loss_percentage"></span></td>
                                </tr>
                                <tr>
                                    <th class="tolat_report_color">v)</th>
                                    <th class="tolat_report_color">
                                        Total Water Available for Utilization(Ha.m):
                                    </th>
                                    <td><span id="total_water_avaliable_utiilization"></span></td>
                                </tr>
                                <tr>
                                    <th class="tolat_report_color">vi)</th>
                                    <th class="tolat_report_color">
                                        Rainfall Available for Future Use(Ha.m)
                                    </th>
                                    <td style="text-align:right"><span id="volume_of_runoff"></span></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td>Weighted Average Runoff Coefficient</td>
                                    <td><span id="weighted_avg_runoff"></span></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td>Utilizable Rainfall Runoff ( Ha.M)</td>
                                    <td><span id="utilizable_rainfall_runoff"></span></td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <div id="container_Water_Availability" style="min-width: 310px; height: 450px;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page2el">
            <div class="col-md-12 waterdrft_space1">
                <div class="text-center reportheading">
                    <p>Water Utilization  Report</p>
                </div>

                <div class="col-md-12">
                    <div class="col-md-6">
                        <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer">
                            <tbody>
                                <tr class="tableheader1 text-center">
                                    <th colspan="3" style="padding-bottom:15px;" class="text-center">Water Utilization</th>
                                </tr>
                                <tr>
                                    <th>A</th>
                                    <th>Drinking / Domestic (Ha.m)</th>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <td>i)</td>
                                    <td>Form Surface Water</td>
                                    <td><span id="domestic_demand_surface_water"></span></td>
                                </tr>
                                <tr>
                                    <td>ii)</td>
                                    <td>Form Ground Water</td>
                                    <td><span id="domestic_demand_ground_water"></span></td>
                                </tr>
                                <tr>
                                    <th class="tolat_report_color">iii)</th>
                                    <th class="tolat_report_color">Total</th>
                                    <td><span id="Domestic_Total"></span></td>
                                </tr>
                                <tr>
                                    <th>B</th>
                                    <th>Irrigated Agriculture (Ha.m)</th>
                                    <td><span id=""></span></td>
                                </tr>
                                <tr>
                                    <td>i)</td>
                                    <td>Form Surface Water</td>
