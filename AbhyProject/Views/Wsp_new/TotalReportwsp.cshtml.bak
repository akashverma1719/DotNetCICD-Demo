<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demo2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demo").innerHTML = today;
</script>

<script>
    function PGWCHART() {
        $(function () {
            Highcharts.setOptions({
                chart: {
                    style: {
                        fontFamily: 'Arial, Helvetica, sans-serif',
                        fontSize: '2em',
                        color: '#f00'
                    }
                }
            });

            $('#PGWM_pie_chart').highcharts({
                chart: {
                    type: 'pie'
                },
                colors: [
                    '#ED5565',
                    '#5D9CEC',
                    '#A0D468'
                ],
                title: {
                    text: 'PGWM Committee',
                    style: {
                        color: '#555'
                    }
                },
                legend: {
                    layout: 'horizontal',
                    align: 'center',
                    verticalAlign: 'bottom',
                    borderWidth: 0,
                    backgroundColor: '#FFFFFF'
                },

                yAxis: {
                    title: {
                        text: ''
                    }
                },
                tooltip: {
                    shared: false,
                    valueSuffix: 'points'
                },
                credits: {
                    enabled: false
                },
                plotOptions: {
                    areaspline: {
                        fillOpacity: 0.1
                    },
                    series: {
                        groupPadding: .15
                    }
                },
                series: [{
                    type: 'pie',
                    name: 'PGWM Committee',
                    data: [
                        ['male', Male],
                        ['Female', Female],
                        ['Others', Others]
                    ]
                }]
            });
        });
    }



    function get_demandside_fund() {
        var tr_sp = '';
        
        $.ajax({
            type: "POST",
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_new/get_demandside_fund",
            data: "",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                var department_name = "";
                var scheme_name = "";
                var proposed_area = "";
                var approximate_cost = "";
                var fund = 0;
                for (var i = 0; i < data.length; i++) {
                    if (data[i].department_name != null && data[i].department_name != "" && data[i].department_name != "NULL") {
                        department_name = data[i].department_name;
                    }
                    if (data[i].scheme_name != null && data[i].scheme_name != "" && data[i].scheme_name != "NULL") {
                        scheme_name = data[i].scheme_name;
                    }
                    if (data[i].proposed_area != null && data[i].proposed_area != "" && data[i].proposed_area != "NULL") {
                        proposed_area = data[i].proposed_area;
                    }
                    if (data[i].approximate_cost != null && data[i].approximate_cost != "" && data[i].approximate_cost != "NULL") {
                        approximate_cost = data[i].approximate_cost;
                        fund += parseFloat(data[i].approximate_cost);
                    }


                    tr_sp += '<tr><td>' + (i + 1) + '</td>' +
                        '<td>' + data[i].type + '</td >' +
                        '<td>' + data[i].claim_year + '</td >' +
                        '<td>' + data[i].other_measures + '</td >' +
                        '<td>'+ department_name + '</td >' +
                        '<td>' + scheme_name + '</td >' +
                        '<td>' + proposed_area + '</td >' +
                        '<td>' + approximate_cost + '</td ></tr>'
                        
                }
                fund = parseFloat(fund).toFixed(2);
                tr_sp += '<tr><td>Total</td><td></td><td></td><td></td><td></td><td></td><td></td><td>' + (fund + " Lakhs") + '</td></tr>'
                if (tr_sp != '') {
                    $('#sprinkler_data').html(tr_sp);
                } else {
                    tr_sp = '<tr style="text-align:center;"><td colspan="16" style="text-align:center;">No Data</td></tr>';
                    $('#sprinkler_data').html(tr_sp);
                }
                get_supplyside_fund();
            }
        })
    }


    function get_supplyside_fund() {
        var tr_sp = '';
        var j = 0;
        $.ajax({
            type: "POST",
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_new/get_ar_supplyside_fund",
            data: "",
            dataType: 'JSON',
            success: function (data) {
                debugger;
                var ar = "Artificial Recharge Structures";
                var possible_funding = '';
                var fund = 0;
                for (var i = 0; i < data.length; i++) {
                    if (data[i].possible_funding_source == "Others") {
                        possible_funding = data[i].other_funding_source;
                    } else {
                        possible_funding = data[i].possible_funding_source;
                    }
                    if (data[i].ar_approx_estimated_cost != null && data[i].ar_approx_estimated_cost != "NULL" && data[i].ar_approx_estimated_cost != "") {
                        fund += parseFloat(data[i].ar_approx_estimated_cost);
                    }

                    tr_sp += '<tr><td>' + (++j) + '</td>' +
                        '<td>' + ar + '</td >' +
                        '<td>' + data[i].type_ar_structure + '</td >' +
                        '<td>' + data[i].latitude + '</td >' +
                        '<td>' + data[i].longitude + '</td >' +
                        '<td>' + data[i].sp_year + '</td >' +
                        '<td>' + data[i].ar_department_name + '</td >' +
                        '<td>' + possible_funding + '</td >' +

                        '<td>' + (data[i].ar_approx_estimated_cost + " Lakhs") + '</td ></tr>'

                }
                $.ajax({
                    type: "POST",
                    contentType: 'application/json; chatset=utf-8',
                    url: "/Wsp_new/get_wc_supplyside_fund",
                    data: "",
                    dataType: 'JSON',
                    success: function (data) {
                        debugger;
                        var wc = "Water Conservation Structures";
                        for (var i = 0; i < data.length; i++) {
                            if (data[i].possible_funding_source == "Others") {
                                possible_funding = data[i].other_funding_source;
                            } else {
                                possible_funding = data[i].possiable_funding_source;
                            }
                            if (data[i].wc_approx_estimated_cost != null && data[i].wc_approx_estimated_cost != "NULL" && data[i].wc_approx_estimated_cost != "") {
                                fund += parseFloat(data[i].wc_approx_estimated_cost);
                            }

                            tr_sp += '<tr><td>' + (++j) + '</td>' +
                                '<td>' + wc + '</td >' +
                                '<td>' + data[i].type_wc_structure + '</td >' +
                                '<td>' + data[i].latitude + '</td >' +
                                '<td>' + data[i].longitude + '</td >' +
                                '<td>' + data[i].wc_year + '</td >' +
                                '<td>' + data[i].wc_department_name + '</td >' +
                                '<td>' + possible_funding + '</td >' +

                                '<td>' + (data[i].wc_approx_estimated_cost + " Lakhs") + '</td ></tr>'

                        }

                        $.ajax({
                            type: "POST",
                            contentType: 'application/json; chatset=utf-8',
                            url: "/Wsp_new/get_other_supplyside_fund",
                            data: "",
                            dataType: 'JSON',
                            success: function (data) {
                                debugger;
                                var ot = "Any Other Intervention";
                                for (var i = 0; i < data.length; i++) {

                                    if (data[i].possible_funding_source == "Others") {
                                        possible_funding = data[i].other_funding_source;
                                    } else {
                                        possible_funding = data[i].possible_funding_source;
                                    }
                                    if (data[i].anyother_approx_estimated_cost != null && data[i].anyother_approx_estimated_cost != "NULL" && data[i].anyother_approx_estimated_cost != "") {
                                        fund += parseFloat(data[i].anyother_approx_estimated_cost);
                                    }

                                    tr_sp += '<tr><td>' + (++j) + '</td>' +
                                        '<td>' + ot + '</td >' +
                                        '<td>' + data[i].other_structure + '</td >' +
                                        '<td>' + data[i].latitude + '</td >' +
                                        '<td>' + data[i].longitude + '</td >' +
                                        '<td>' + data[i].any_year + '</td >' +
                                        '<td>' + data[i].other_department_name + '</td >' +
                                        '<td>' + possible_funding + '</td >' +

                                        '<td>' + (data[i].anyother_approx_estimated_cost + " Lakhs") + '</td ></tr>'

                                }
                                fund = parseFloat(fund).toFixed(2);
                                tr_sp += '<tr><td>Total</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td>' + (fund + " Lakhs") + '</td></tr>'
                                if (tr_sp != '') {
                                    $('#supply_data').html(tr_sp);
                                } else {
                                    tr_sp = '<tr style="text-align:center;"><td colspan="16" style="text-align:center;">No Data</td></tr>';
                                    $('#supply_data').html(tr_sp);
                                }
                            }
                        })
                    }
                })

            }
        })


    }
</script>
<script src="~/Content/JS_Files/WSPTotalReport.js"></script>
<script src="~/Content/JS_Files/deamendside_report_js.js"></script>