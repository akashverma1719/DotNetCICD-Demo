<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {
        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterbalanceReport.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $('div.balnace_mater_space').addClass('balnace_mater_space1');
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
            $('div.balnace_mater_space').removeClass('balnace_mater_space1');
        }, 2000);
    }
</script>





<script>
    var Access_Auth = "";
    $(document).ready(function () {
    Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
        Info();

    });


    function Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Wsp_new/WaterBalanceInfo_Details',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    window.location = "/Wsp_new/Balancereport";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }

                var wb_sw_avail = 0, wb_gw_avail = 0, wb_total_avail = 0;

                var wb_sw_utili = 0, wb_gw_utili = 0, wb_total_utili = 0;
                var wb_sw_balance = 0, wb_gw_balance = 0, wb_total_balance = 0;

                if (response.length != 0) {

                    if (response[0].wb_sw_avail != null && response[0].wb_sw_avail != "") {
                        wb_sw_avail = parseFloat(response[0].wb_sw_avail);
                    }
                    if (response[0].wb_gw_avail != null && response[0].wb_gw_avail != "") {
                        wb_gw_avail = parseFloat(response[0].wb_gw_avail);
                    }
                    if (response[0].wb_total_avail != null && response[0].wb_total_avail != "") {
                        wb_total_avail = parseFloat(response[0].wb_total_avail);
                    }



                    if (response[0].wb_sw_utili != null && response[0].wb_sw_utili != "") {
                        wb_sw_utili = parseFloat(response[0].wb_sw_utili);
                    }
                    if (response[0].wb_gw_utili != null && response[0].wb_gw_utili != "") {
                        wb_gw_utili = parseFloat(response[0].wb_gw_utili);
                    }
                    if (response[0].wb_total_utili != null && response[0].wb_total_utili != "") {
                        wb_total_utili = parseFloat(response[0].wb_total_utili);
                    }


                    if (response[0].wb_sw_balance != null && response[0].wb_sw_balance != "") {
                        wb_sw_balance = parseFloat(response[0].wb_sw_balance);
                    }
                    if (response[0].wb_gw_balance != null && response[0].wb_gw_balance != "") {
                        wb_gw_balance = parseFloat(response[0].wb_gw_balance);
                    }
                    if (response[0].wb_total_balance != null && response[0].wb_total_balance != "") {
                        wb_total_balance = parseFloat(response[0].wb_total_balance);
                    }

                }
                $('#wb_sw_avail').text(wb_sw_avail);
                $('#wb_gw_avail').text(wb_gw_avail);
                $('#wb_total_avail').text(wb_total_avail);
                $('#avl_surfacewater').text(wb_sw_avail);
                $('#avl_groundwater').text(wb_gw_avail);
                $('#wb_sw_utili').text(wb_sw_utili);
                $('#wb_gw_utili').text(wb_gw_utili);

                $('#Utilization_surfacewater').text(wb_sw_utili);
                $('#Utilization_groundwater').text(wb_gw_utili);

                $('#wb_total_utili').text(wb_total_utili);

                $('#wb_sw_balance').text(wb_sw_balance);
                $('#wb_gw_balance').text(wb_gw_balance);

                $('#Balance_surfacewater').text(wb_sw_balance);
                $('#Balance_groundwater').text(wb_gw_balance);
                $('#wb_total_balance').text(wb_total_balance);

                Chart();
            }
        });
    }


</script>


<script>
    function Chart() {
        Highcharts.chart('container_balance_Report', {
            data: {
                table: 'datatable'
            },
            chart: {
                type: 'column'
            },
            title: {
                text: 'Water Balance'
            },
            yAxis: {
                allowDecimals: false,
                title: {
                    text: 'Units'
                }
            },
            colors: [
                '#ED5565',
                '#a6c96a'
            ],
            tooltip: {
                formatter: function () {
                    return '<b>' + this.series.name + '</b><br/>' +
                        this.point.y + ' ' + this.point.name.toLowerCase();
                }
            }
        });
    }
</script>
<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demobalance2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = mm + '/ ' + dd + '/ ' + yyyy;
    document.getElementById("demobalance").innerHTML = today;
</script>