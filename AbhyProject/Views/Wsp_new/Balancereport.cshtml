                        <thead>
                            <tr class="tableheader1 text-center">
                                <th colspan="3" style="padding-bottom:15px;" class="text-center">Water Balance</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <th>A</th>
                                <th>Availability (Ha.m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td> Surface Water</td>
                                <td><span id="wb_sw_avail"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Ground Water</td>
                                <td><span id="wb_gw_avail"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total</th>
                                <td><span id="wb_total_avail"></span></td>
                            </tr>
                            <tr>
                                <th>B</th>
                                <th>Utilization (Ha.m)</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>Surface Water</td>
                                <td><span id="wb_sw_utili"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Ground Water</td>
                                <td><span id="wb_gw_utili"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total Utilization</th>
                                <td><span id="wb_total_utili"></span></td>
                            </tr>
                            <tr>
                                <th>C</th>
                                <th>Balance [Surplus (+) / Deficit (-)]</th>
                                <td><span id=""></span></td>
                            </tr>
                            <tr>
                                <td>i)</td>
                                <td>Surface Water</td>
                                <td><span id="wb_sw_balance"></span></td>
                            </tr>
                            <tr>
                                <td>ii)</td>
                                <td>Ground Water</td>
                                <td><span id="wb_gw_balance"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color">iii)</th>
                                <th class="tolat_report_color">Total </th>
                                <td><span id="wb_total_balance"></span></td>
                            </tr>
                        </tbody>
                    </table>

                </div>
                <div class="col-md-6">
                    <div id="container_balance_Report" style="min-width: 310px; height: 440px; margin: 0 auto ;"></div>
                    <table id="datatable" style="display:none;">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Surface Water </th>
                                <th>Ground Water</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Availability </th>
                                <td id="avl_surfacewater"></td>
                                <td id="avl_groundwater"></td>
                            </tr>
                            <tr>
                                <th>Utilization </th>
                                <td id="Utilization_surfacewater"></td>
                                <td id="Utilization_groundwater"></td>
                            </tr>
                            <tr>
                                <th>Balance </th>
