    function Update_data_social(id, RowNo) {

        var i = 0;
        var id = id;

        var latitude = $('#latitude' + RowNo).val();
        var longitude = $('#longitude' + RowNo).val();
        var village = $('#village' + RowNo).val();
        var location = $('#location_details' + RowNo).val();

        if (latitude == "") {
            alert("Please Enter latitude");
            i = 1;
        }
        else if (longitude == "") {

            alert("Please Enter longitude");
            i = 1;
        }
        else if (village == "" || village == null) {

            alert("Please Enter Village Name");
            i = 1;
        }
        else if (location == "" || location == null) {

            alert("Please Enter Location Details");
            i = 1;
        }


        if (i == 0) {


            var formdata = new FormData();
            formdata.append("id", id);
            formdata.append("latitude", latitude);
            formdata.append("longitude", longitude);
            formdata.append("village", village);
            formdata.append("location", location);

            $.ajax({
                url: '/GplevelMobileData/Update_social',
                data: formdata,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (response) {

                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    ssno = 0;
                    count = 0;
                    totalsocialss = 0;
                    socialtotal();
                },
                error: function () {
                    alert('Update Failed');
                }
            });
        }
    }

    function enforceNumberValidation(i, ele) {
        debugger;

        let j = i.toString();
        var match = false;
        var match2 = false;
        var matchwr = false;
        var matchwr2 = false;
        var lat = $('#latitude' + j).val();
        var long = $('#longitude' + j).val();




        if (!(lat.indexOf('.') == -1)) {
            match = true; // decimal
        } else {
            match = false;
        }
        if (lat.length == 2 && match != true) {
            $('#latitude' + j).val(lat + '.');
        } else if (lat.length == 1 && match != false) {
            $('#latitude' + j).val('');
        }


        if (!(long.indexOf('.') == -1)) {
            match2 = true; // decimal
        } else {
            match2 = false;
        }
        if (long.length == 2 && match2 != true) {
            $('#longitude' + j).val(long + '.');
        } else if (long.length == 1 && match2 != false) {
            $('#longitude' + j).val('');
        }


        var latwr = $('#latitude' + j).val();
        var longwr = $('#longitude' + j).val();

        if (!(latwr.indexOf(".") == -1)) {
            matchwr = true; // decimal
        } else {
            matchwr = false;
        }
        if (latwr.length == 2 && matchwr != true) {
            $('#latitude' + j).val(latwr + '.');
        } else if (latwr.length == 1 && matchwr != false) {
            $('#latitude' + j).val('');
        }


        if (!(longwr.indexOf(".") == -1)) {
            matchwr2 = true; // decimal
        } else {
            matchwr2 = false;
        }
        if (longwr.length == 2 && matchwr2 != true) {
            $('#longitude' + j).val(longwr + '.');
        } else if (longwr.length == 1 && matchwr2 != false) {
            $('#longitude' + j).val('');
        }


        if ($(ele).data('decimal') != null) {
            // found valid rule for decimal
            var decimal = parseInt($(ele).data('decimal')) || 0;
            var val = $(ele).val();
            if (decimal > 0) {
                var splitVal = val.split('.');
                if (splitVal.length == 2 && splitVal[1].length > decimal) {
                    // user entered invalid input
                    $(ele).val(splitVal[0] + '.' + splitVal[1].substr(0, decimal));
                }
            } else if (decimal == 0) {
                // do not allow decimal place
                var splitVal = val.split('.');
                if (splitVal.length > 1) {
                    // user entered invalid input
                    $(ele).val(splitVal[0]); // always trim everything after '.'
                }
            }
        }
    }
    function isNumberKey(txt, evt) {

        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode == 46) {
            //Check if the text already contains the . character
            if (txt.value.indexOf('.') === -1) {
                return true;
            } else {
                return false;
            }
        } else {
            if (charCode > 31 &&
                (charCode < 48 || charCode > 57))
                return false;
        }
        return true;
    }

