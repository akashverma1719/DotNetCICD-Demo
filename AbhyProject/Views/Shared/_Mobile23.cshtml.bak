    function Delete_social(ss) {
        if (confirm("Are you sure you want to delete this entry?")) {
            var obj = {};
            obj.id = ss;
            $.ajax({
                type: "POST",
                contentType: "application/json;charset=utf-8",
                url: "/GplevelMobileData/Delete_socialdata",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    else if (response != "Deleted Successfully" && response != "Logout" && response != "No Data") {
                        window.location = "/Error/DefaultError";
                    }

                    ssno = 0;
                    count = 0;
                    totalsocialss = 0;
                    socialtotal();
                }
            });
        }
    }
    function submit_spmu_social(ss) {

        var obj = {};
        obj.id = ss;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/GplevelMobileData/submit_spmu_social",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (response != "Successfully Submited" && response != "Logout" && response != "No Data") {
                    window.location = "/Error/DefaultError";
                }

                ssno = 0;
                count = 0;
                totalsocialss = 0;
                socialtotal();
            }
        });

    }
    function approve_spmu_social(ss) {

        var obj = {};
        obj.id = ss;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/GplevelMobileData/approve_social",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (response != "Approve Successfully" && response != "Logout" && response != "No Data") {
                    window.location = "/Error/DefaultError";
                }

                ssno = 0;
                count = 0;
                totalsocialss = 0;
                socialtotal();
            }
        });

    }

