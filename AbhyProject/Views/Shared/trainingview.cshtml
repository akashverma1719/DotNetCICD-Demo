            "/MasterDropDown/reg_state": 1,
            "/MasterDropDown/reg_district": 1,
            "/MasterDropDown/reg_block": 1,
            "/MasterDropDown/allreg_export": 1,
            "/MasterDropDown/feed_npmu": 2,
            "/MasterDropDown/feed_state": 2,
            "/MasterDropDown/feed_district": 2,
            "/MasterDropDown/feed_block": 2,
            "/MasterDropDown/allfeed_export": 2,
            /*"/MasterDropDown/rp_state": 2,*/
            "/MasterDropDown/cal_npmu": 3,
            "/MasterDropDown/cal_state": 3,
            "/MasterDropDown/rp_npmu": 7,
            "/MasterDropDown/rp_npmu": 4,
            "/MasterDropDown/rp_block": 4,
            "/MasterDropDown/tracker_state": 5,
            "/MasterDropDown/tracker_district": 5,
            "/MasterDropDown/tracker_block": 5,
            "/MasterDropDown/tracker_gp": 5,

        };
        const currentPath = window.location.pathname;
        const targetIndex = pathToLiIndexMap[currentPath];

        if (targetIndex !== undefined) {
            const liElements = document.querySelectorAll("#myTab li");
            if (liElements[targetIndex]) {
                liElements[targetIndex].classList.add("ActiveElement");
            }
        }
    });

