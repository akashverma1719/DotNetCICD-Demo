
@{
    ViewBag.Title = "loginlogoutcheck";
    Layout = null;
}
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<link href="/Content/bootstrap.min.css" rel="stylesheet">

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Content/JS_Files/IdealState.js"></script>

<style>


    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }

    .container-fluid {
        width: 100%;
        padding: 0px !important;
    }
</style>

<div class="" style="width:100%;padding:0px!important">
    @RenderBody()
</div>
<div class="loading-container" style="width:100%;padding:0px!important">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<script>
    $(".loader").show();
    $(document).ready(function () {

        window.location.href = "https://ataljal.mowr.gov.in";
    });

      
</script>






