<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta name="keywords" content="HTML,CSS,XML,JavaScript">
    <meta name="author" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Atal Jal</title>
    <link rel="icon" type="image/x-icon" href="~/DashboardStyles/images/atal-jal-logo.png">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/swiper.min.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/nav-style.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/bootstrap.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/swiper.min.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/global.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/responsive.css">
    <link rel="stylesheet" type="text/css" href="~/DashboardStyles/css/font.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css">
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,500,700,700i,900&display=swap"
          rel="stylesheet">
    <link href="~/Content/css/darkmode.min.css" rel="stylesheet" />
    <style>
        .new_twitter {
            font-size: 14px;
            background: black;
            height: 24px;
            width: 25px;
            display: flex;
            border-radius: 5px;
            align-items: center;
            justify-content: center;
        }

            .new_twitter img {
                height: 15px;
                filter: invert(1);
            }
    </style>
</head>

<body>
    <div class="page-wrapper flex">
        <!-- #header top div -->
        <div class="flex-top-header-fix">
            <header>
                <div class="top-header">
                    <div class="container-fluid md-plr-10 top-banner-bg">
                        <div class="container-wrapper"> </div>
                    </div>
                </div>

                <div class="header-wrapper header-wrap-bg">
                    <div class="container-fluid">
                        <div class="container-wrapper">
                            <div class="d-flex align-items-center pt-1 pb-1 sm-flex-direc-column">
                                <div class="col-md-6">
                                    <ul class="d-flex align-items-center sm-flex-wrap">
                                        <li class="ml-2">
                                            <a class="d-flex align-items-center">
                                                <img src="~/DashboardStyles/images/atal-jal-logo.png"
                                                     class="img-fluid atal-icon-sec" alt="logo">
                                                <img src="~/DashboardStyles/images/logosec1.png"
                                                     class="img-fluid atal-logo-sec" alt="logo">
                                            </a>
                                        </li>

                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        </div>

        <div class="container-fluid nav-bg-clr">
            <div class="container-wrapper">
                <div class="row align-items-center ">
                    <div class="col-md-12">
                        <div class="d-flex align-items-start align-items-md-center flex-column flex-md-row justify-content-between pt-1 pb-1">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-wrapper p-0 container-fluid">
            @RenderBody()
        </div>
        <footer>
            <div class="container-fluid copyright p-2">
                <div class="text-center ">
                    Copyright &copy 2024- All Rights Reserved - Official Website of Atal Jal
                    Yojana, Ministry of Water Resources, River Development and Ganga Rejuvenation, Ministry of Jal
                    Shakti, Government of India.
                </div>
                <div class="text-center ">Website last updated date 12-08-2024 10:14:50.</div>
            </div>
        </footer>
    </div>

    <script src="https://www.amcharts.com/lib/4/core.js"></script>
    <script src="https://www.amcharts.com/lib/4/charts.js"></script>
    <script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <script src="~/DashboardStyles/js/swiper.min.js"></script>
    <script src="~/DashboardStyles/js/custom-script.js"></script>
    <script>
        $('body').FontSize({
            increaseTimes: 4,
            reduceTimes: 4,
        });
    </script>
    <script src="~/DashboardStyles/js/nav-script.js"></script>


</body>

</html>
