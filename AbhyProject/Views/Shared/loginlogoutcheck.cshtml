
@{
    ViewBag.Title = "loginlogoutcheck";
    Layout = null;
}
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<link href="/Content/bootstrap.min.css" rel="stylesheet">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
@*<script src="~/Scripts/jquery-3.3.1.min.js"></script>*@
<script src="~/Content/JS_Files/IdealState.js"></script>

<style>


    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }

    .container-fluid {
        width: 100%;
        padding: 0px !important;
    }
</style>

<div class="" style="width:100%;padding:0px!important">
    @RenderBody()
</div>
<div class="loading-container" style="width:100%;padding:0px!important">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>
<script>
    $(".loader").show();
    $(document).ready(function () {
            var currentUrl = window.location.href;
            const myArray = currentUrl.split("/");
            let coun = myArray.length - 1;
            if ((myArray[coun] != "WSP_GWM_HOME") && (myArray[coun] != "LogInForce")) {
                GetCunCurrentUser();
                setInterval(GetCunCurrentUser, 30000);
            }
    });

    function GetCunCurrentUser() {
            $.ajax({
                type: 'get',
                url: '@Url.Action("CheckCunCurrentUser", "WspNew")',
                success: function (data) {

                    if (data == "False") {

                        window.location.href = "../../WspNew/WSP_GWM_HOME";
                    }
                    $(".loader").hide();
                }
            });
        }
</script>




