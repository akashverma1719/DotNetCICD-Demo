<script>
    $(".loader").show();
    $(document).ready(function () {

            var currentUrl = window.location.href;
            const myArray = currentUrl.split("/");
            let coun = myArray.length - 1;
            if ((myArray[coun] != "WSP_GWM_HOME") && (myArray[coun] != "LogInForce")) {
                GetCunCurrentUser();
                setInterval(GetCunCurrentUser, 30000);
            }
    });

        function GetCunCurrentUser() {
            $.ajax({
                type: 'get',
                url: '@Url.Action("CheckCunCurrentUser", "WspNew")',
                success: function (data) {

                    if (data == "False") {

                        window.location.href = "../../WspNew/WSP_GWM_HOME";
                    }
                    $(".loader").hide();
                }
            });
        }
</script>