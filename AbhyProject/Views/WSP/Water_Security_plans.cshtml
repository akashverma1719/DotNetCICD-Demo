        bindtooldropdown();
    }



    function update_toolkifulldetail(DID, i) {

        document.getElementById('TError').innerHTML = "";
        document.getElementById('TFError').innerHTML = "";
        var obj = {};

        obj.toolkittype = $('#ToolKitsListcopy').val();
        obj.item = $('#Item' + i).val();
        obj.quantity = $('#Quantity' + i).val();
        obj.ttkdid = DID;

        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Admin/UpdateToolKitFullDetail",
            data: "{'ToolKitFullDetails': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                var dropDown = document.getElementById("tolProjects");
                dropDown.selectedIndex = 0;
                document.getElementById('TFError').innerHTML = response;
                $('#TKD' + i).hide();
            }
        });


    }

    function delete_toolkitfulldetail(DID, i) {

        document.getElementById('TError').innerHTML = "";
        document.getElementById('TFError').innerHTML = "";
        var obj = {};

        obj.ttkdid = DID;

        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: "/Admin/DeleteToolKitFullDetail",
            data: "{'ToolKitFullDetails': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                var dropDown = document.getElementById("tolProjects");
                dropDown.selectedIndex = 0;

                document.getElementById('TFError').innerHTML = response;
                $('#thiderowoneditdeta_' + i).remove();
            }
        });


    }


    function SaveToolKitFullDetails(a) {

        var project1 = $('#tolProjects :selected').text();
        var ToolKitName = $('#ToolKitsList :selected').text();

        if (project1 != undefined && project1 != "") {
            document.getElementById('TFError').innerHTML = "";
            var obj = {};

            obj.item = $('#toolkititem').val();
            obj.quantity = $('#toolkitquantity').val();
            obj.projectname = project1;
            obj.toolkittype = ToolKitName;


            $.ajax({
                type: "POST",
                contentType: "application/json;charset=utf-8",
                url: "/Admin/InsertToolKitFullDetails",
                data: "{'ToolKitFullDetails': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    var dropDown = document.getElementById("tolProjects");
                    dropDown.selectedIndex = 0;
                    document.getElementById('TFError').innerHTML = response;
                    $('#trntable2' + a).remove();

                }
            });
        }
        else {
            var dropDown = document.getElementById("tolProjects");
            dropDown.selectedIndex = 0;
            document.getElementById('TFError').innerHTML = "Please Select Project";
            $('#trntable2' + a).remove();
        }
    }



