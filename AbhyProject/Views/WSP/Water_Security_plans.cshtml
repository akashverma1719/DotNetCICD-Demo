    <script type="text/javascript">

        //tabs functionality
        function activaTab(tab) {
            $('.nav-tabs a[href="#' + tab + '"]').tab('show');
        };

        activaTab('bbb');

        //checkbox functionlity
        $("#Register").click(function (e) {
            if ($(this).is(':checked')) {
                var m = confirm("your message");
                if (m != true) {
                    $(this).removeAttr('checked');
                    e.preventDefault();
                }
            }

        });

        //auto calculation functionality demend
        $(document).ready(function () {
            //this calculates values automatically
            sum();
            sum2();
            $("#number, #unitcost").on("keydown keyup", function () {
                sum();
            });
            $("#EDITnumber, #EDITunitcost").on("keydown keyup", function () {
                sum2();
            });
        });

        function sum() {
            var number = document.getElementById('number').value;
            var unitcost = document.getElementById('unitcost').value;
            //var area = document.getElementById('area').value;
            //var funding = document.getElementById('funding').value;
            var result = parseInt(number) * parseInt(unitcost);

            if (!isNaN(result)) {
                document.getElementById('Total_Budget').value = result;

            }
        }

        function sum2() {
            var number = document.getElementById('EDITnumber').value;
            var unitcost = document.getElementById('EDITunitcost').value;

            if (number != "" && unitcost != "") {
                var result = parseInt(number) * parseInt(unitcost);

                if (!isNaN(result)) {

                    document.getElementById('EDITTotal_Budget').value = result;
                }
            }
        }
        //auto calculation functionality supply
        $(document).ready(function () {
            //this calculates values automatically
            sum1();
            $("#number1, #unitcost1").on("keydown keyup", function () {
                sum1();
            });
        });

        function sum1() {
            var number1 = document.getElementById('number1').value;
            var unitcost1 = document.getElementById('unitcost1').value;
            //var area1 = document.getElementById('area1').value;
            //var funding1 = document.getElementById('funding1').value;
            var result1 = parseInt(number1) * parseInt(unitcost1);

            if (!isNaN(result1)) {
                document.getElementById('Total_Budget1').value = result1;

            }
        }

        //multiple checkbox of demend and suppliers will open model pop up
        $(function () {
            //demends popups
            $('.abc').click(function () {
                if ($('.abc').is(":checked")) {
                    //$('.abc').parent().addClass("green");
                    $('#myModal').modal('show');

                } else {
                    $('#myModal').modal('hide');
                }
            });
            //supliers popups
            $('.abc1').click(function () {
                if ($('.abc1').is(":checked")) {
                    $('#myModal1').modal('show');
                } else {
                    $('#myModal1').modal('hide');
                }
            });
        });

        //checked values of demends and suppliers  displaying in popup header
        valueChange = function (item) {

            //demend titles
            document.getElementById('activity').value = item.value;
            //suppliers titles
            document.getElementById('activity1').value = item.value;
            CheckedValue = item.value;

        }

    </script>

</head>
