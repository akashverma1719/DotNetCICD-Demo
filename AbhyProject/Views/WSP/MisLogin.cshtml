<script type="text/javascript">
    var Jsondata = "";
    $(document).ready(function () {
        $("#Change").css("display", "none");
        DropDownInfo();
    });

    function DropDownInfo() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                setTimeout(function () {
                    $('.loading').hide();
                    $('.allcontent').show();
                }, 4000);
                if (response.length != 0) {
                    var all_states = [];
                    $("#dist").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist").append(opdist);
                    $("#block").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select GramPanchayat</option>';
                    $("#gram").append(opgram);
                    Jsondata = response;
                    var ddlst = {};
                    var optionhtml = '';
                    // var optionState = '<option value="0">Please Select State</option>';
                    for (var i = 0; i < response.length; i++) {

                        if (!ddlst[response[i].state_name]) {
                            all_states.push(response[i].state_name);
                            ddlst[response[i].state_name] = response[i].state_name;
                            // $("#state").append(optionState);
                        }
                    }

                    var StateArray = [];
                    StateArray = all_states.sort(function (a, b) {
                        if (a < b) return -1;
                        else if (a > b) return 1;
                        return 0;
                    });
                    for (var i = 0; i < StateArray.length; i++) {
                        if (StateArray[i] != null && StateArray[i] != "") {
                            optionhtml += '<option value="' + StateArray[i] + '">' + StateArray[i] + '</option>';
                        }
                    }
                    $("#state").append(optionhtml);

                }

            }
        });
    }

    $("#state").change(function () {

        $("#dist").empty();
        var opdist = '<option value="0">Select District</option>';
        $("#dist").append(opdist);
        $("#block").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block").append(opblock);
        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);
        var StateName = $("#state").val();
        if (StateName != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_dists = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (StateName == Jsondata[i].state_name) {

                    if (!ddlst[Jsondata[i].district_name]) {
                        all_dists.push(Jsondata[i].district_name);
                        ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                    }
                }
            }


            var DistArray = [];
            DistArray = all_dists.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < DistArray.length; i++) {
                if (DistArray[i] != null && DistArray[i] != "") {
                    optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
                }
            }
            $("#dist").append(optionDist);
        }
    });

    $("#dist").change(function () {

        $("#block").empty();
        var opblock = '<option value="0">Select Block</option>';
        $("#block").append(opblock);
        $("#gram").empty();
