<script>
    function Report() {

        if (WaterAbc.length == 0) {
            WaterTable = 1;
        }
        if (Abc.length == 0) {
            RainfallTable = 1;
        }
        if (WaterTable == 0) {
            document.getElementById('Alert11').innerHTML = "Please Save Ground Water Deviation";
        }
        else if (RainfallTable == 0) {
            document.getElementById('Alert11').innerHTML = "Please Save RainFall Deviation";
        }
        else if (WaterTable != 0 && RainfallTable != 0) {
            $.ajax({
                type: 'GET',
                contentType: 'application/json; chatset=utf-8',
                url: '/Report/Report',
                data: '',
                dataType: 'JSON',
                success: function (data) {


                    if (data == "Success") {
                        window.open("/Report/ReportGWm", "_blank");


                    }
                    else {

                        document.getElementById('Alert11').innerHTML = data;
                    }
                }
            });
        }
        else {
            document.getElementById('Alert11').innerHTML = "Please Save Ground Water Deviation and RainFall Deviation";
        }
    }
</script>
