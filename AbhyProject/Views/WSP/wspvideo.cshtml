<style>
    .color_database {
        color: green !important;
    }

    tr.info th {
        background-color: #337ab7 !important;
        color: #fff;
        text-align: center;
    }

    ul.imgHome.clearfix > li > label {
        position: static;
        top: 4px;
        margin: 0px;
    }

    .btn-div {
        padding: 20px;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #050b30ed;
    }

    .videoPlayButton {
        /*top: 50px;*/
    }

    .play-btn {
        width: 65px;
        height: 65px;
        background: radial-gradient(#004590 63%,#fff 69%);
        border-radius: 50%;
        position: relative;
        display: block;
        box-shadow: 0 0 25px 3px #00458f
    }

        .play-btn::after {
            content: "";
            position: absolute;
            left: 50%;
            top: 50%;
            -webkit-transform: translateX(-40%) translateY(-50%);
            transform: translateX(-40%) translateY(-50%);
            transform-origin: center center;
            width: 0;
            height: 0;
            border-top: 12px solid #fff0;
            border-bottom: 12px solid #fff0;
            border-left: 20px solid #fff;
            z-index: 100;
            -webkit-transition: .4s cubic-bezier(.55,.055,.675,.19);
            transition: .4s cubic-bezier(.55,.055,.675,.19)
        }

        .play-btn:before {
            content: "";
            position: absolute;
            width: 150%;
            height: 150%;
            -webkit-animation: 2s steps(1) infinite pulsate1;
            animation: 2s steps(1) infinite pulsate1;
            animation-fill-mode: forwards;
            -webkit-animation-fill-mode: forwards;
            opacity: 1;
            border-radius: 50%;
            border: 5px solid;
            top: -25%;
            left: -25%;
            background: #fff0
        }

    @@-webkit-keyframes pulsate1 {
        0% {
            -webkit-transform: scale(.6);
            transform: scale(.6);
            opacity: 1;
            box-shadow: inset 0 0 25px 3px rgb(255 255 255 / .75),0 0 25px 10px rgb(255 255 255 / .75)
        }

        100% {
            -webkit-transform: scale(1);
            transform: scale(1);
            opacity: 0;
            box-shadow: none
        }
    }

    @@keyframes pulsate1 {
        0% {
            -webkit-transform: scale(.6);
            transform: scale(.6);
            opacity: 1;
            box-shadow: inset 0 0 25px 3px rgb(255 255 255 / .75),0 0 25px 10px rgb(255 255 255 / .75)
        }

        100% {
            -webkit-transform: scale(1,1);
            transform: scale(1);
            opacity: 0;
            box-shadow: none
        }
    }
</style>
