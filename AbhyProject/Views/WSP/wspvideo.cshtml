<script>
    let videoWrapper = document.querySelectorAll(".video-wrapper");
    let videos = document.querySelectorAll("video");
    let videoPlayButtonAll = document.querySelectorAll(".videoPlayButton");

    videoWrapper.forEach(wrapper => {
        let selectedVideo = wrapper.querySelector("video");
        wrapper.querySelector(".play-btn").addEventListener("click", () => {
            videos.forEach(video => {
                video.pause();
                video.currentTime = 0;
            });
            selectedVideo.play();
            videoPlayButtonAll.forEach(overlay => {
                overlay.style.display = "flex";
            });
            wrapper.querySelector(".videoPlayButton").style.display = "none";
        });
    });

</script>

