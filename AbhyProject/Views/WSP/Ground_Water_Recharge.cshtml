            padding: 10px 20px;
            width: auto;
            white-space: nowrap;
            font-size: .9em;
        }

            #progress-ui .progress-node .progress-label .pointer {
                position: absolute;
                left: 50%;
                top: 100%;
                -webkit-transform: translateX(-50%);
                -moz-transform: translateX(-50%);
                -o-transform: translateX(-50%);
                -ms-transform: translateX(-50%);
                transform: translateX(-50%);
                display: block;
                width: 0;
                height: 0;
                border-top: 10px solid #003f69;
                border-left: 10px solid transparent;
                border-right: 10px solid transparent
            }

        #progress-ui .progress-node.answered {
            cursor: pointer;
            background-color: #fff
        }

        #progress-ui .progress-node.answering {
            cursor: pointer;
            background-color: rgba(255, 255, 255, 0.5)
        }

        #progress-ui .progress-node.closed {
