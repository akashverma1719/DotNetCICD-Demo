                var _cropsesonval = 0, _cropavgval1 = 0;
                var respcrops = response;
                if ($("#ddlkarif option:selected").text() != "Select Karif") {
                    if (respcrops["karif"] == 'rice') {
                        _cropsesonval = parseFloat(respcrops["karif_cu"]);
                        _cropavgval1 = parseFloat(respcrops["kharif_rice"]);
                    }
                    if (respcrops["karif"] == 'sugarcane') {
                        _cropsesonval = parseFloat(respcrops["karif_cu"]);
                        _cropavgval1 = parseFloat(respcrops["kharif_rice"]);
                    }
                    if (respcrops["karif"] == 'cotton') {
                        _cropsesonval = parseFloat(respcrops["karif_cu"]);
                        _cropavgval1 = parseFloat(respcrops["kharif_cotton"]);
                    }
                    if (respcrops["karif"] == 'maize') {
                        _cropsesonval = parseFloat(respcrops["karif_cu"]);
                        _cropavgval1 = parseFloat(respcrops["kharif_maize"]);
                    }
                }
                if ($("#ddlrabi option:selected").text() != "Select Rabi") {
                    if (respcrops["rabi"] == 'wheat') {
                        _cropsesonval = parseFloat(respcrops["rabi_cu"]);
                        _cropavgval1 = parseFloat(respcrops["rabi_wheat"]);
                    }
                    if (respcrops["rabi"] == 'mustard') {
                        _cropsesonval = parseFloat(respcrops["rabi_cu"]);
                        _cropavgval1 = parseFloat(respcrops["rabi_mustard"]);
                    }
                    if (respcrops["rabi"] == 'gram') {
                        _cropsesonval = parseFloat(respcrops["rabi_cu"]);
                        _cropavgval1 = parseFloat(respcrops["rabi_gram"]);
                    }
                    if (respcrops["rabi"] == 'barley') {
                        _cropsesonval = parseFloat(respcrops["rabi_cu"]);
                        _cropavgval1 = parseFloat(respcrops["rabi_barley"]);
                    }
                }
                $('#txtcropwaterneed').val(_cropsesonval);
                $('#txtareacropavg').val(_cropavgval1);

                //start crop season
                var _irridraft1 = 0;
                if ($("#ddlkarif option:selected").text() != "Select Karif") {
                    $('#lblbalDraftIrrigation').html('');
                    var _cropwtrneed0 = $('#txtcropwaterneed').val();
                    var _cropavg0 = $('#txtareacropavg').val();
                    _irridraft1 = parseFloat(parseFloat(_cropwtrneed0) * parseFloat(parseFloat(_cropavg0) * 10 * 10 * 10 * 10 * 10) / 2).toFixed(2);
                    if (_irridraft1 == "NaN") {
                        _irridraft1 = 0.00;
                        $('#lblbalDraftIrrigation').html(_irridraft1);
                    }
                    else {
                        $('#lblbalDraftIrrigation').html(_irridraft1);
                    }
                }

                if ($("#ddlrabi option:selected").text() != "Select Rabi") {
                    $('#lblbalDraftIrrigation').html('');
                    var _cropwtrneed2 = $('#txtcropwaterneed').val();
                    var _cropavg2 = $('#txtareacropavg').val();
                    _irridraft1 = parseFloat(parseFloat(_cropwtrneed2) * parseFloat(parseFloat(_cropavg2) * 10 * 10 * 10 * 10 * 10) / 2).toFixed(2);
                    if (_irridraft1 == "NaN") {
                        _irridraft1 = 0.00;
                        $('#lblbalDraftIrrigation').html(_irridraft1);
                    }
                    else {
                        $('#lblbalDraftIrrigation').html(_irridraft1);
                    }
                }
                if ($("#ddlkarif option:selected").text() == "Select Karif" && $("#ddlrabi option:selected").text() == "Select Rabi") {
                    $('#lblIrrigationCalculation').val("");
                    $('#lblbalDraftIrrigation').val('');
                    var TotalNumberoffunctionalwellsforirrigation = $("#txtTotnumoffunwellsforIrr_Draft").val();
                    var AvgofDailyPumping = $("#txtAvgofdailyPupmingHD_Draft").val();
                    var TotalNoofpumpingdays = $('#txtTotNumofPumpingHD_Draft').val();
                    var AvgWellDischarge = $('#txtAvgWellDischarge_Draft').val();
                    _irridraft1 = parseFloat(parseFloat(AvgofDailyPumping) * parseFloat(TotalNumberoffunctionalwellsforirrigation) * parseFloat(TotalNoofpumpingdays * 40) * parseFloat(AvgWellDischarge)).toFixed(2);
                    if (_irridraft1 == "NaN") {
                        _irridraft1 = 0.00;
                        $('#lblbalDraftIrrigation').html(_irridraft1);
                    }
                    else {
                        $('#lblbalDraftIrrigation').html(_irridraft1);
                    }
                }
                //end crop season
            },
            error: function (a) { }
        });
    }

</script>


