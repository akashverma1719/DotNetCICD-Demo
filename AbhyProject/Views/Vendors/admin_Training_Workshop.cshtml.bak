<script name="clear-browser-cache" src='~/Content/JS_Files/clear-browser-cache.js' value="true"></script>
<title>Training/Workshop</title>
<style>

    .table_tender_pdf tr th {
        background-color: #337ab7;
        color: #fff;
    }

    .color_red_pdf {
        color: red;
    }

    #evnt_dropdown {
        margin-top: 10px;
    }

    .g-brd-gray-light-v4 {
        border-color: #72c02c78 !important;
    }

    .cf-99 {
        text-align: center;
        /*height: 137px;
            margin-bottom: 20px;*/
        color: #337ab7;
    }

        .cf-99 > h1 {
            padding: 25px;
            font-size: 29px;
            color: #337ab7;
            padding-right: 38px;
        }

    label.col-md-1 {
        padding: 10px;
    }

    .cc-99 {
        border: none;
    }

        .cc-99 > label {
            margin-top: 25px;
            margin-bottom: 15px;
            font-weight: bold;
            color: #000;
            font-size: 17px;
        }

    h6 {
        color: #1f223e;
        font-family: inherit;
        font-weight: 500;
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .anchorlinktraining {
        font-size: 1.8rem !important;
    }

    .justify-content-between {
        -ms-flex-pack: justify !important;
        justify-content: space-between !important;
    }

    @@media (min-width: 992px) {
        .d-lg-flex {
            display: flex !important;
        }

        .g-mr-30 {
            margin-right: 2.14286rem !important;
        }

        .g-mr-5 {
            margin-right: 0.35714rem !important;
        }
    }
</style>
<style>
    .form-group {
        margin-top: 5px;
    }

    .color_red_text {
        color: red;
    }

    .msg {
        color: red !important;
        font-weight: bold;
    }

    .hpanel .panel-body {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        padding: 20px;
        position: relative;
        border-top: 2px solid #62cb31;
    }

    .hpanel {
        border: none !important;
        box-shadow: none;
        margin-bottom: 25px;
    }

    .col-md-12 {
        font-size: 16px;
    }

    .about-area .col-md-6 img {
        margin-top: 0px;
    }

    h4 {
        font-size: 20px;
    }

    .refreshicon {
        position: relative;
        right: 21px;
        top: -12px;
    }

    .highlight {
        color: red;
    }
</style>
<style>
    .table_tender_pdf tr th {
        background-color: #337ab7;
        color: #fff;
    }

    .b_part_div1 {
        margin-bottom: 30px;
    }
</style>
<style>

    /*table fix code*/

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
    }

    .loader {
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      position: fixed;
      display: block;
      opacity: 0.95;
      visibility: visible;
      background-color: #fff;
      z-index: 9999;
      text-align: center;
      
    }

        .loader > img {
         top: 45%;
         left: 45%;
         position: fixed;
         height: 150px;
         width: 150px;
         
        }



    /*ends here*/

</style>

