</header>
<main>
    <div class="row container-fluid">
        <div class="col-md-12 col-sm-12">
            <ul class="Select_option selectbackhome grm_selecting">
                <li class="pull-right">
                    <a href="~/WSPHome/Monitoring_evaluation" class="btn btn-success"><i class="zmdi zmdi-hc-lg  fa fa-angle-double-left"> </i> Back To Modules</a>
                </li>
            </ul>
        </div>
        <div class="row">
            <div class="container">
                <div class="content">
                    <div class="col-lg-12" style="background-color:#fff;">
                        <div class="hpanel">
                            <div class="panel-body">
                                <div class="row">


                                    <div class="col-md-12 text-right msg">
                                        * Fields are mandatory
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <section class="content-header">
                                        </section>
                                        <div class="hpanel hgreen">
                                            <div class="panel-body">
                                                <div class="row">
                                                    <div class="form-group col-md-6">
                                                        Event/training : <span class="msg">*</span>
                                                        <span id="Grv_sub" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                        @*<span id="" class="highlight" style="font-weight:normal;display:none;">Enter alphanumeric only</span>*@
                                                        <input type="text" id="p_training_name" name="p_training_name" class="form-control alpha" required="required" placeholder="Enter your Event/Course" />
                                                    </div>
                                                    <div class="form-group col-md-6">
                                                        From Date  : <span class="msg">*</span>

                                                        <div class="input-group input-append date  form_datetime from_date" id="">
                                                            <input type="text" class="form-control" id="from_date" name="from_date" />

                                                            <span class="input-group-addon add-on"><span class="fa fa-calendar bid_date1" id=""></span></span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-md-6">
                                                        To Date  : <span class="msg">*</span>
                                                        <div class="input-group input-append date  form_datetime12 to_date" id="">
                                                            <input type="text" class="form-control" id="to_date" name="to_date" />
                                                            <span class="input-group-addon add-on"><span class="fa fa-calendar to_date1 terminated_date"></span></span>
                                                        </div>
                                                    </div>

                                                    <div class="form-group col-md-6">
                                                        Status : <span class="msg">*</span>
                                                        <span id="Grv_status" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                        @*<span id="" class="highlight" style="font-weight:normal;display:none;">Enter alphabetic characters only</span>*@
                                                        <input type="text" class="form-control alpha" id="training_status" name="training_status" required="required" placeholder="Enter your Status" />


                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-md-6">
                                                        State : <span class="msg">*</span>
                                                        <span id="" title="Required" class="highlight" style="font-weight:normal;display:none;">Required</span>
                                                        <select name="state_name" id="state_name" class="form-control" onchange="Event_State_Chnage()">
                                                            <option value="0">Select State Name</option>
                                                            <option value="NPMU (DELHI)">NPMU (DELHI)</option>
                                                            <option value="Gujarat">Gujarat</option>
                                                            <option value="Haryana">Haryana</option>
                                                            <option value="Maharashtra">Maharashtra</option>
                                                            <option value="Madhya Pradesh">Madhya Pradesh</option>
                                                            <option value="Karnataka">Karnataka</option>
                                                            <option value="Rajasthan">Rajasthan</option>
                                                            <option value="Uttar Pradesh">Uttar Pradesh</option>
                                                            <option value="Other">Other</option>

                                                        </select>
                                                        <input type="text" class="form-control" id="other_state_name" name="other_state_name" required="required" placeholder="Enter your State" />


                                                    </div>
                                                    <div class="form-group col-md-6">
                                                        Registration Open Date  : <span class="msg">*</span>
                                                        <div class="input-group input-append date  form_datetime13 training_start" id="">
                                                            <input type="text" class="form-control" id="training_start" name="training_start" />
                                                            <span class="input-group-addon add-on"><span class="fa fa-calendar training_start1 terminated_date"></span></span>
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="form-group col-md-6">
                                                    Registration Close Date  : <span class="msg">*</span>
                                                    <div class="input-group input-append date  form_datetime13  training_end" id="">
                                                        <input type="text" class="form-control" id="training_end" name="training_end" />
                                                        <span class="input-group-addon add-on"><span class="fa fa-calendar training_end1 terminated_date"></span></span>
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-12 text-center">
                                                    <button type="button" name="" value="Save" id="btnSubmit" onclick="Save_Training_Working_Info()" class="btn btn-success btn-sm ">Submit</button>


                                                </div>

                                            </div>
                                        </div>
                                        @*<div class="col-6">
                                            Upload Excel <i class="color_red_pdf">Only .xlsx and .xls</i>
                                            @using (Html.BeginForm("admin_Training_Workshop", "Vendors", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return myFunction()" }))
                                            {
                                                <input type="file" name="filetraining" id="filetraining" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                                <input type="button" value="Upload " class="btn btn-primary" onclick="return Excel_upload_training()" name="submit" />
                                                <input type="submit" value="Upload" id="uploadbtnSubmit" class="btn btn-primary" />
                                            }
                                        </div>
                                        <div class="col-6">
                                            Demo Excel:
                                            <div>
                                                <a href="~/Ataljalimages/training_workshop_excel/abhy_training_workshops_demo.xlsx" download="abhy_training_workshops_demo">Download</a>
                                            </div>
                                        </div>*@

                                        <div style="text-align:center;">

                                            @if (ViewBag.Error != null)
                                            {
                                                <label style="color:red;" id="error_1">@ViewBag.Error</label>
                                            }

                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-12 col-sm-12">
                                    <div class="col-md-6 col-sm-6">
                                        <select class="form-control" id="evnt_dropdown" onchange="Event_Registration_Count()">
                                        </select>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <label class="color_red_text"> Total Registration : <label id="EVNT_REG_Count">0000</label></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-sm-12">
            <div class="selectdistshowoption">
                <ul class="Select_option selectbackhome grm_selecting">
                    <li id="StateWise" style="margin: 10px;">
                        <label id="lblstate"><b>State:</b></label>
                        <label id="spnstate"></label>

                    </li>
                    <li id="StateWiseDropdown" style="margin: 10px;">
                        <div class="col-md-2" style=" margin: 8px;"><span id="lblstate"><b>State:</b></span></div>
                        <div class="col-md-8"><select class="form-control" id="States" onchange="StateWiseInfo()"></select></div>

                    </li>


                    <li class="pull-right">
                        <div class="btn btn-success form-control"><i class="fa fa-file-excel-o" onclick="Export_a_Table()"> Export To Excel</i></div>
                        <input type="button" id="AComponent_Id" onclick="tableToExcel('TblData_abc_part1', 'testing')" hidden />
                    </li>
                </ul>

            </div>
        </div>
        <div class="col-md-12">
            <div class="b_part_div">
                <div class="panelbodyheading">
                    Training & Workshop
                </div>
                <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll;height:400px; font-size:12px;">
                    <table id="TblData_abc_part1" class="table_tender_pdf table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                        <thead>
                            <tr>
                                <th class="text-center">S.No</th>
                                <th class="text-center">Event/training</th>
                                <th class="text-center">From Date</th>
                                <th class="text-center">To Date</th>


                                <th class="text-center">Status</th>
                                <th class="text-center">Registration Open Date</th>
                                <th class="text-center">Registration Close Date</th>

                                <th class="text-center">State</th>
                                <th class="text-center">Total Registration Participant</th>
                                <th class="text-center">Edit</th>
                                <th class="text-center">Delete</th>
                            </tr>
                        </thead>
                        <tbody id="admin_event_table">
                        </tbody>
                    </table>
                </div>
                <br />
                <br />
            </div>
        </div>

        <div class="col-md-12 col-sm-12">
            <div class="selectdistshowoption">
                <ul class="Select_option selectbackhome grm_selecting">
                    
                    <li id="StateWise1" style="margin: 10px;">
                        <label id="lblstate"><b>State:</b></label>
                        <label id="spnstate1"></label>

                    </li>
                    <li id="StateWiseDropdown1" style="margin: 10px;">
                        
                        <div class="col-md-2" style=" margin: 8px;"><span id="lblstate"><b>State:</b></span></div>
                        <div class="col-md-8"><select class="form-control" id="States1" onchange="StateWiseInfo1()"></select></div>



                    </li>
                    <li class="pull-right">
                        <div class="btn btn-success form-control"><i class="fa fa-file-excel-o" onclick="Export_b_Table()"> Export To Excel</i></div>
                        <input type="button" id="BComponent_Id" onclick="tableToExcel('TblData_abc_part2', 'testing')" hidden />


                    </li>

                </ul>

            </div>
        </div>

        <div class="col-md-12">
            <div class="b_part_div1">
                <div class="panelbodyheading">
                    New Training Registration Table
                </div>
                <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll;height:400px; font-size:12px;">
                    <table id="TblData_abc_part2" class="table_tender_pdf table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                        <thead>
                            <tr>
                                <th class="text-center">S.No</th>
                                <th class="text-center">Name of the participant</th>
                                <th class="text-center">Gender </th>
                                <th class="text-center">Age </th>
                                <th class="text-center">Occupation</th>
                                <th class="text-center">Qualification</th>
                                <th class="text-center">Phone no. </th>
                                <th class="text-center">Email id </th>
                                <th class="text-center">Address</th>
                                <th class="text-center">State</th>
                                <th class="text-center">Event/training</th>
                                <th>Registration Number</th>
                                <th class="text-center">Edit</th>
                                <th class="text-center">Delete</th>
                            </tr>
                        </thead>
                        <tbody id="admin_newregs_table">
                        </tbody>
                    </table>
                </div>
                <br />
                <br />
            </div>
        </div>
    </div>
    <div>
        <section>
            <div id="progress">
                <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
                    <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                        <span class="progress-group-label" data-target="#music" data-toggle="tab"> Events &Trainings</span>
                        <div class="tri shadow"></div>
                        <div class="tri"></div>
                    </li>
                </ul>
            </div>
        </section>
    </div>
</main>


<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.js"></script>
<link rel="stylesheet" type="text/css" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.10.4/themes/redmond/jquery-ui.css">
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.10.4/jquery-ui.js"></script>


<script>
    $(document).ready(function () {
        $('#other_state_name').hide();
        $('#uploadbtnSubmit').hide();
        $('.loader').hide();
        DropDownInfo1();
        Get_Newregs_Training_Info();
        Get_Training_Working_Info();


    });

    $("#from_date").datepicker({
        dateFormat: 'dd/mm/yy',
        //minDate: new Date(currentYear, currentMonth - 2, currentDate),
        onSelect: function (date) {

            var Abc = date.split('/');
            var SS = Abc[1] + '/' + Abc[0] + '/' + Abc[2];
            var result = new Date(SS);
            result.setDate(result.getDate() + 0);
            $("#to_date").datepicker('option', 'minDate', result);
        }
    });
    $('.bid_date1').click(function () {
        $("#from_date").focus();
    });

    $("#to_date").datepicker({
        dateFormat: 'dd/mm/yy',
        //minDate: new Date(currentYear, currentMonth - 2, currentDate),
        onSelect: function (date) {

            var Abc = date.split('/');
            var SS = Abc[1] + '/' + Abc[0] + '/' + Abc[2];
            var result = new Date(SS);

            result.setDate(result.getDate() + 0);
            // $("#bid_evalution_date").datepicker('option', 'minDate', result);
        }
    });
    $('.to_date1').click(function () {
        $("#to_date").focus();
    });
    $("#training_start").datepicker({
        dateFormat: 'dd/mm/yy',
        //minDate: new Date(currentYear, currentMonth - 2, currentDate),
        onSelect: function (date) {

            var Abc = date.split('/');
            var SS = Abc[1] + '/' + Abc[0] + '/' + Abc[2];
            var result = new Date(SS);
            result.setDate(result.getDate() + 1);
            $("#training_end").datepicker('option', 'minDate', result);
        }
    });
    $('.training_start1').click(function () {
        $("#training_start").focus();
    })
    $("#training_end").datepicker({
        dateFormat: 'dd/mm/yy',
        //minDate: new Date(currentYear, currentMonth - 2, currentDate),
        onSelect: function (date) {
            debugger;
            var Abc = date.split('/');
            var SS = Abc[1] + '/' + Abc[0] + '/' + Abc[2];
            var result = new Date(SS);
            result.setDate(result.getDate() + 0);
            //$("#to_date").datepicker('option', 'minDate', result);
        }
    });
    $('.training_end1').click(function () {
        $("#training_end").focus();
    });

</script>

<script>
    var tableToExcel = (function () {
        debugger;
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--><meta http-equiv="content-type" content="text/plain; charset=UTF-8"/></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            debugger;
            window.location.href = uri + base64(format(template, ctx))
        }
    })()


</script>

<script src="~/Scripts/validations.js"></script>
<script>
    function Excel_upload_training() {
        var fileInput = document.getElementById('filetraining');
        var filePath = fileInput.value;

        // Allowing file type
        var allowedExtensions = /(\.xlsx|\.xls)$/i;

        if (!allowedExtensions.exec(filePath)) {
            alert('Invalid file type');
            fileInput.value = '';
            return false;
        } else {

            $('#uploadbtnSubmit').click();
        }
    }


    function Export_a_Table() {

        debugger;
        if (Training_Workshop_Count.length != 0) {
            for (var i = 0; i < Training_Workshop_Count.length; i++) {
                var ss = "#" + Training_Workshop_Count[i];
                $(ss).remove();
            }
        }

        $('#AComponent_Id').click();
        Get_Training_Working_Info();
    }




    function Export_b_Table() {
        debugger;
        if (New_Registration_Count.length != 0) {
            for (var i = 0; i < New_Registration_Count.length; i++) {
                var ss = "#" + New_Registration_Count[i];
                $(ss).remove();


            }
        }

        $('#BComponent_Id').click();

        Get_Newregs_Training_Info();
    }
</script>