@model IEnumerable<AbhyProject.Models.VendorRegisters>

@{
    ViewBag.Title = "VendorList";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}




<link href="~/Content/Website/lib/nivo-slider/jquery.dataTables.min.css" rel="stylesheet" />
@*<link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css">*@
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
@*<script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>*@
<script src="~/Content/Website/js/jquery.dataTables.min.js"></script>

<script src="~/Scripts/all_scripts/dataTables.bootstrap.min.js"></script>
@*<script src="https://cdn.datatables.net/1.10.19/js/dataTables.bootstrap.min.js"></script>*@
<title>List of Registered Vendors</title>
<script>
    $(document).ready(function () {
        $.noConflict();

        $('#example').DataTable();
    });
</script>


<style>
    .Training1 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid #3498db;
    }

    .upload1 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .h3 {
        font-size: 1.75rem;
        line-height: 1.4;
    }

    .lblValue {
        font-size: 40px;
    }
    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">List of Registered Vendors</div>
    </div>
</div>
<div class="container-fluid" style="margin-top:20px;">
    <!--First Row Start-->
    <div class="row">

        <div class="col-md-12">
            <div class="row g-mb-20 vendorHeader">
                <div class="col-md-10">
                    <p>
                        The data displayed here is received through registration of vendors and is only subject to gather information related to hydrometeorology from various sources and nothing related to the proposed project.
                    </p>
                </div>
                <div class="col-md-2">
                    <div class="pull-right"><a href="~/Vendors/vendors" class="btn btn-primary">New Vendor Registration</a></div>
                </div>
            </div>
            </div>

        </div>
    <!--First Row End-->
    <!-- 2nd row start-->
    <div class="row" style="margin-top:40px;">
        <div class="col-md-12">
            <div class="tbl-responsive">
                <table id="example" class=" display  table stripe row-border order-column table-striped table-bordered dataTable no-footer" style="width:100%">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Company Name</th>
                            <th>Nodal Officer</th>
                            <th>Email </th>
                            <th>Website Link</th>
                            <th>Address</th>
                            <th>Phone/Mobile Number</th>
                       



                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>@item.Vid</td>
                            <td>@item.CompanyName</td>
                            <td>@item.NodalOfficer</td>
                            <td>@item.Email</td>
                            <td><a href="@item.WebsiteLink">@item.WebsiteLink</a></td>
                            <td>@item.Address</td>
                            <td>@item.MobileNumber</td>




                        </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>




</div>

