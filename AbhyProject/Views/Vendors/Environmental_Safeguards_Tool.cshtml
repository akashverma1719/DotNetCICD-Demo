    function updatesafeguard(DID, i) {
        var formData = new FormData();

        // Append form fields to FormData
        formData.append("id", DID);
        formData.append("state_name", $('#state_name1' + i).val());
        formData.append("district_name", $('#district_name1' + i).val());
        formData.append("block_name", $('#block_name1' + i).val());
        formData.append("gpname", $('#gpname1' + i).val());
        formData.append("latitude", $('#latitude1' + i).val());
        formData.append("longitude", $('#longitude1' + i).val());
        //formData.append("finacial_year", $('#finacial_year1' + i).val());
        formData.append("safeguard_tool", $('#safeguard_tool1' + i).val());
        formData.append("safeguard_compliance", $('#safeguard_compliance' + i).val());

        // Append file to FormData
        var fileInput = $('#safeguard_download1' + i)[0];
        if (fileInput.files.length > 0) {
            formData.append("file", fileInput.files[0]);
        }

        $.ajax({
            type: "POST",
            url: '/Vendors/updatesafeguard',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                alert(response);
                if (response != 'Updated Successfully' && response != 'Logout') {
                    window.location = "/Error/DefaultError";
                }
                Get_Environment_Info();
                Dropdown_Search();
            }
        });
    }


    function deletesafegaurd(id) {
        var obj = {};
        obj.id = id;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: '/Vendors/deletesafegaurd',

            data: "{'updatesafeguard_string': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                if (response != 'Deleted Successfully' && response != 'Not Deleted' && response != 'Logout') {
                    window.location = "/Error/DefaultError";
                }
                Get_Environment_Info();
                Dropdown_Search();
            }
        });
    }



