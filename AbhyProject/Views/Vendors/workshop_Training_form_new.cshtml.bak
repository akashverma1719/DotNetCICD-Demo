    function Block_fun() {

        $("#gram").empty();
        var opgram = '<option value="0">Select GramPanchayat</option>';
        $("#gram").append(opgram);
        var block = $("#block1").val();

        if (off_1 == "block") {
            block = Block;
        } else {
            Block = block;
        }


        if (block != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_grams = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                    if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                        ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                        all_grams.push(Jsondata[i].gram_panchayat_name);
                        //   $("#gram").append(optionDist);
                    }
                }
            }


            var GramArray = [];
            GramArray = all_grams.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < GramArray.length; i++) {
                if (GramArray[i] != null && GramArray[i] != "") {
                    var GramArr = GramArray[i].split("_");
                    optionDist += '<option value="' + GramArray[i] + '">' + GramArr[0] + '</option>';
                }
            }
            $("#gram").append(optionDist);

        }
        /* event_calendar_info_new2();*/
        current_event_info_block();
    }

    function Gram_Fun() {
        current_event_info_gram();
    }

</script>

<script>

    var currentPage = 1;
    $('#currentpageno').text(currentPage);
    var rowsPerPage = 5;

    function showRows() {
        var startIndex = (currentPage - 1) * rowsPerPage;
        var endIndex = startIndex + rowsPerPage;
        $('#example tbody tr').hide(); // hide all rows
        $('#example tbody tr').slice(startIndex, endIndex).show(); // show current page's rows
    }

    //$(document).ready(function () {
    //    showRows();   //call on page load data fetch function
    //});

    $('#prevPage').click(function () {
        if (currentPage > 1) {
            currentPage--;
            $('#currentpageno').text(currentPage);
            showRows();
        }
    });

    $('#nextPage').click(function () {
        var numRows = $('#example tbody tr').length;
        var lastPage = Math.ceil(numRows / rowsPerPage);
        if (currentPage < lastPage) {
            currentPage++;
            $('#currentpageno').text(currentPage);
            showRows();
        }
    });


</script>


