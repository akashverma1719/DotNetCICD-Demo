@model AbhyProject.Models.Abhy_Training_Workshops

@{
    ViewBag.Title = "workshop_Training_form_new";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}
<title>Event Calendar</title>
<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Content/JS_Files/Master_DRP.js"></script>

<style>
    .form-horizontal .control-label {
        margin-bottom: 6px;
        font-weight: 600;
    }

    .table_tender_pdf tr th {
        background-color: #337ab7;
        color: #fff;
    }

    .form-horizontal .form-group {
        margin-left: 10px;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }
</style>
<style>
    .aa > div > input,
    .bb > div > span > input {
        width: 21px;
        height: 18px;
    }

    /*.labelcheckbox {
        padding-left: 0px !important;
        font-size: 18px;
    }*/

    .msg {
        color: red !important;
        font-weight: bold;
    }

    .hpanel .panel-body {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        padding: 20px;
        position: relative;
        border-top: 2px solid #62cb31;
    }

    .hpanel {
        border: none !important;
        box-shadow: none;
        margin-bottom: 25px;
        padding: 20px;
    }

    .col-md-6 {
        font-size: 16px;
    }

    .btn-primary {
        width: 100px;
    }

    a.btn-primary {
        width: 200px;
    }

    .btnlist {
        margin-top: 10px;
    }

    .about-area .col-md-6 img {
        margin-top: 0px;
    }

    .about-area .col-md-6:last-child {
        padding-left: 15px;
    }

    p {
        margin: 0;
    }
</style>

<style>
    .maindiv {
        width: 100%;
        margin: auto;
    }

    .tbl-responsive {
        overflow-x: inherit;
    }

    .clearfix:after {
        box-sizing: border-box;
    }

    body {
        font-family: "Open Sans", Helvetica, Arial, sans-serif;
    }

    .classic-title {
        margin: 0 0 16px 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid mediumblue;
        font-weight: 600;
        line-height: 1.5em;
    }

    .panel-group > .panel {
        -webkit-border-radius: 6px;
        border: 1px solid #e8e8e8;
        margin: 5px 0;
    }

    /*.panel-group > .panel-heading {
        background-color: #ffad33;
        padding: 0px;
    }*/

    .panel-title > a {
        position: relative;
        display: block;
        color: #444 !important;
        background-color: #fff;
        padding: 10px 21px;
        font-size: 13px;
        font-weight: 700;
    }

    .text-info {
        color: mediumblue;
    }

    .panel-title > a > .control-icon {
        position: absolute;
        top: 50%;
        right: 10px;
        margin-top: -11px;
    }

    .panel-title > a > i {
        font-size: 1.2em;
        padding-right: 5px;
    }



    .dataTables_filter, .dataTables_paginate {
        float: right;
    }

    .list-group-item {
        position: relative;
        display: block;
        padding: 8px 15px !important;
        margin-bottom: -1px;
        font-size: 12px;
        width: 90%;
    }

    .panel-inner > ul.list-group > li.list-group-item > a {
        color: #3a99ed !important;
    }

        .panel-inner > ul.list-group > li.list-group-item > a:hover {
            color: #6FB11D !important;
        }

    span.tablecellhead {
        font-size: 15px;
        font-weight: bold;
        color: mediumblue;
    }

    .dataTables_empty {
        text-align: center;
    }

    .list_table_function {
        float: none;
        width: 93%;
        margin-left: 13px;
        background: none !important;
    }

    .cricle_round {
        background: #30abec;
        color: white;
        font-size: 13px;
        border-radius: 100%;
        font-weight: bold;
        padding: 4px;
        margin: -6px;
        width: 26px;
        height: 24px;
        text-align: center
    }

    .tbl-responsive thead {
        position: sticky;
        top: 0px;
    }
</style>

<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>

