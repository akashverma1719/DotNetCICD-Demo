<div class="row justify-content-center">
    <label style="text-align:center;color:red;" id="Error_"></label>

    <div id="StateDropdownLabel" class="col-md-2">
        <select class="form-control" id="spnstate_state_1" onchange="State_Dropdown_Function_1()" style="border-radius: 25px;"></select>
    </div>

    <div id="DistDropdownLabel" class="col-md-2">
        <select class="form-control" id="dist11" onchange="Dist_fun()" style="border-radius: 25px;"></select>
    </div>

    <div id="BlockDropdownLabel" class="col-md-2">

        <select class="form-control" id="block1" onchange="Block_fun()" style="border-radius: 25px;"></select>
    </div>

    <div id="GramDropdownLabel" class="col-md-2">

        <select class="form-control" id="gram" onchange="Gram_Fun()" style="border-radius: 25px;"></select>
    </div>



</div>


<div class="container-fluid box_shadow" style="margin-top:25px">
    <div class="row">
        <div class="content-wrapper" style="width: 100%;">
            <div class="content">
                <div class="col-lg-12">
                    <div class="">
                        <div class="">
                            <div class="tbl-responsive" style="height: 650px; overflow-x: scroll; font-size: 15px;">
                                <table id="example" class=" display  table stripe row-border order-column table-striped table-bordered dataTable no-footer table_tender_pdf">
                                    <thead>
                                        <tr class="text-center" style="text-align:center">
                                            <th class="text-center" style="text-align:center" colspan="20">List of Current Events</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="2" class="text-center">Sr.No</th>
                                            @*<th class="text-center">Current Event</th>*@
                                            <th rowspan="2" class="text-center">Topic of Event</th>
                                            <th rowspan="2" class="text-center">Type of Event</th>
                                            <th rowspan="2" class="text-center">Location Of Exposure Visit</th>
                                            <th rowspan="2" class="text-center">Particulars Of Exposure Visit</th>
                                            <th colspan="4" class="text-center">Level Of Event</th>
                                            @*<th rowspan="2" class="text-center">District</th>
                                                <th rowspan="2" class="text-center">Block</th>*@
                                            <th rowspan="2" class="text-center">Event Platform</th>
                                            <th rowspan="2" class="text-center">From Date</th>
                                            <th rowspan="2" class="text-center">To Date</th>
                                            <th rowspan="2" class="text-center">Registration Open Date</th>
                                            <th rowspan="2" class="text-center">Registration Close Date</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="2" class="text-center">NPMU and State</th>
                                            <th rowspan="2" class="text-center">District</th>
                                            <th rowspan="2" class="text-center">Block</th>
                                            <th rowspan="2" class="text-center">GP</th>
                                        </tr>
                                    </thead>
                                    <tbody id="Training_Workshop"></tbody>
                                </table>
                                <table id="example_gp" class=" display  table stripe row-border order-column table-striped table-bordered dataTable no-footer table_tender_pdf">
                                    <thead>
                                        <tr class="text-center" style="text-align:center">
                                            <th class="text-center" style="text-align:center" colspan="20">Table For Current Events</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="2" class="text-center">Sr.No</th>
                                            @*<th class="text-center">Current Event</th>*@
                                            <th rowspan="2" class="text-center">Topic of Event</th>
                                            <th rowspan="2" class="text-center">Type of Event</th>
                                            <th rowspan="2" class="text-center">Location Of Exposure Visit</th>
                                            <th rowspan="2" class="text-center">Particulars Of Exposure Visit</th>
                                            <th colspan="4" class="text-center">Level Of Event</th>
                                            @*<th rowspan="2" class="text-center">District</th>
                                                <th rowspan="2" class="text-center">Block</th>*@
                                            <th rowspan="2" class="text-center">Event Platform</th>
                                            <th rowspan="2" class="text-center">From Date</th>
                                            <th rowspan="2" class="text-center">To Date</th>
                                            @*<th rowspan="2" class="text-center">Registration Open Date</th>
                                                <th rowspan="2" class="text-center">Registration Close Date</th>*@
                                        </tr>
                                        <tr>
                                            <th rowspan="2" class="text-center">NPMU and State</th>
                                            <th rowspan="2" class="text-center">District</th>
                                            <th rowspan="2" class="text-center">Block</th>
                                            <th rowspan="2" class="text-center">GP</th>
                                        </tr>
                                    </thead>
                                    <tbody id="Training_Workshop_gp"></tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div><label id="Error" style="text-align:center;color:red;margin-left: 50%;font-size:20px;"></label></div>

