    $("nav#primary-menu > ul.main-menu > li:nth-child(5) > ul.dropdown > li:nth-child(6) ").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(5) > ul.dropdown > li:nth-child(6) ").siblings().removeClass('active');
</script>
