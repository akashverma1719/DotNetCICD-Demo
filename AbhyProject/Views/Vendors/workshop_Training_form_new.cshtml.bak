    <div class="col-md-12" style="background-color: #337ab7; text-align: center;">
        <div class="text-h g-mb-20" style="padding: 10px; color: #e4e5e7; font-size: 20px; margin-left: 10px; font-family: raleway; margin-top: 10px; font-weight: 900;">CURRENT EVENTS </div>
    </div>
</div>

