    function Get_Newregs_Training_Info11() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Vendors/Get_Newregs_Training_Info',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                ;
                var tr = '';

                if (response == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (response.length != 0) {
                    Full_Info = response;
                }

            }
        });
    }

    function Event_Count() {

        if (Full_Info.length != 0) {
            for (var i = 0; i < Full_Info.length; i++) {
                if (EventName == Full_Info[i].p_training_name) {
                    evnt_count += 1;
                }
            }
        }

    }


    function current_event_info() {       //abhi

        $.ajax({

            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/current_event_Data',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;

                var pages = Math.ceil(data.length / 5);
                $('#pages_count').text(pages);

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";

                }
                var tr = '';
                if (data.length != 0) {
                    for (var i = 0; i < data.length; i++) {

                        var StateName = data[i].level_event.split("_");
                        var Dist = data[i].district.split("_");
                        var Block = data[i].block.split("_");
                        var Gp = data[i].gp.split("_");
                        if (data[i].type_of_event == null) {
                            data[i].type_of_event = "";
                        }
                        if (data[i].location_expo == null) {
                            data[i].location_expo = "";
                        }
                        if (data[i].particular_expo == null) {
                            data[i].particular_expo = "";
                        }
                        if (data[i].p_training_name == null) {
                            data[i].p_training_name = "";
                        }
                        if (data[i].level_event == null) {
                            data[i].level_event = "";
                        }
                        if (data[i].district == null) {
                            data[i].district = "";
                        }
                        if (data[i].block == null) {
                            data[i].block = "";
                        }
                        if (data[i].gp == null) {
                            data[i].gp = "";
                        }
                        if (data[i].event_platform == null) {
                            data[i].event_platform = "";
                        }
                        if (data[i].from_date == null) {
                            data[i].reg_open_date = "";
                        }
                        if (data[i].to_date == null) {
                            data[i].to_date = "";
                        }
                        if (data[i].reg_open_date == null) {
                            data[i].reg_open_date = "";
                        }
                        if (data[i].reg_close_date == null) {
                            data[i].reg_close_date = "";
                        }

                        tr += '<tr><td>' + (i + 1) + '</td><td>' + data[i].p_training_name + '</td><td>' + data[i].type_of_event + '</td> <td>' + data[i].location_expo + '</td> <td>' + data[i].particular_expo + '</td> <td>' + StateName[0] + '</td> <td>' + Dist[0] + '</td> <td>' + Block[0] + '</td> <td>' + Gp[0] + '</td> <td>' + data[i].event_platform + '</td> <td>' + data[i].from_date + '</td> <td>' + data[i].to_date + '</td><td>' + data[i].reg_open_date + '</td><td>' + data[i].reg_close_date + '</td></tr>';
                    }
                }
                if (tr == '') {
                    tr = '<tr style="text-align:center;"><td colspan="18">No Data</td></tr>';
                    $('#Training_Workshop').html(tr);
                }
                else {
                    $('#Training_Workshop').html(tr);
                }
                showRows();
                $('.loader').hide();
            }
        });
    }

    function current_event_info_state() {       //abhi
        debugger;
