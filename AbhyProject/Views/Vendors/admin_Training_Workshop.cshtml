                window.location.href = "/MasterDropDown/Events_Calendar_Report_NPMU?state_name=" + state_name + "&year1=" + year + "&month1=" + month;
            }
        }
    }

    function Report_BTN_STATE() {

        var year = $('#year_state').val();
        var month = $('#month_state').val();
        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
            var state_name = $('#spnstate_state_1').val();
            if (state_name == "0") {
                alert("Please Select State");
                return false;
            }
            {
                window.location.href = "/MasterDropDown/Events_Calendar_Report_STATE?state_name=" + state_name + "&year1=" + year + "&month1=" + month;
            }
        }
        if (StateOfficer == "State Level Nodal Officer") {
            var state_name = $('#spnstate1').text();
            if (state_name == "0") {
                alert("Please Select State");
                return false;
            }
            {
                window.location.href = "/MasterDropDown/Events_Calendar_Report_STATE?state_name=" + state_name + "&year1=" + year + "&month1=" + month;
            }
        }
    }

