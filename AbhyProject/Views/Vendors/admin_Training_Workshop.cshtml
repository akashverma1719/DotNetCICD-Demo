    //block approve
    function approve_block(id) {

        var obj = {};
        obj.id = id;
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/approve_block',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                /* alert(response);*/
                if (response == "Approved") {
                    $('#editrowcomp_A_Good2_block').prop('disabled', true);
                    $('#Delete_Evt_Cal').prop('disabled', true);
                    $('#btn_block_approved').prop('disabled', true);
                    $('#btn_block_reject').prop('disabled', false);
                    $('#label_block').text("Approved");
                }
                if (response == "SessionTimeOut") {
                      window.location = "/Home/LogOut";
                }
            }

        });
    }

