    function Get_Newregs_Training_Info11() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Vendors/Get_Newregs_Training_Info',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                
                var tr = '';

                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }
                if (response.length != 0) {
                    Full_Info = response;
                }

            }
        });
    }

    function Event_Count() {

        if (Full_Info.length != 0) {
            for (var i = 0; i < Full_Info.length; i++) {
                if (EventName == Full_Info[i].p_training_name) {
                    evnt_count += 1;
                }
            }
        }

    }

    function event_calendar_info() {          //abhi
        
        var event_calendar = $("#event_calendar option:selected").val();
        var event_calendar_year = $("#event_calendar_year").val();

        $.ajax({

            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/MasterDropDown/event_calendar_Data',
            data: { Event_Calendar: event_calendar, YEAR: event_calendar_year },
            dataType: 'JSON',
            success: function (data) {
                
                if (data == "Logout") {
                      window.location = "/Home/LogOut";

                }
                var tr = '';
                var tr_npmu = '';
                var j = 0;
                if (data.length != 0) {
                    for (var i = 0; i < data.length; i++) {

                        var download1 = "";
                        var StateName = data[i].current_event.split("_");

                        if (data[i].download != null) {
                            download1 = data[i].download;
                        }
                        if (data[i].event_calendar == null) {
                            data[i].event_calendar = "";
                        }
                        if (data[i].current_event_year == null) {
                            data[i].current_event_year = "";
                        }
                        if (data[i].current_event == null) {
                            data[i].current_event = "";
                        }
                        if (data[i].current_event == "NPMU (Delhi)") {
                            tr_npmu = '<tr><td>' + (data.length) + '</td><td>' + StateName[0] + '</td><td>' + data[i].current_event_year + '</td><td>' + data[i].event_calendar + '</td> <td><a href="' + download1 + '" download="">' + data[i].download_filename + '</a></td> </tr>';
                        } else {
                            tr += '<tr><td>' + (++j) + '</td><td>' + StateName[0] + '</td><td>' + data[i].current_event_year + '</td><td>' + data[i].event_calendar + '</td> <td><a href="' + download1 + '" download="">' + data[i].download_filename + '</a></td> </tr>';
                        }
                        
                    }
                }
                if (tr == '' && tr_npmu == '') {
                    
                    tr = '<tr style="text-align:center;"><td colspan="11">No Data</td></tr>';
                    $('#Training_Workshop_New').html(tr);
                }
                else {
                    tr += tr_npmu;
                    $('#Training_Workshop_New').html(tr);
                }
                $('.loader').hide();
            }
        });
    }


