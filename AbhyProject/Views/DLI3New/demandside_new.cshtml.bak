            background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
        }

        #style-5::-webkit-scrollbar {
            width: 8px;
            height: 8px;
            background-color: #F5F5F5;
            border-radius: 25px;
        }

        #style-5::-webkit-scrollbar-thumb {
            border-radius: 10px;
            background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
        }

        #style-6::-webkit-scrollbar {
            width: 8px;
            height: 8px;
            background-color: #F5F5F5;
            border-radius: 25px;
        }

        #style-6::-webkit-scrollbar-thumb {
            border-radius: 10px;
            background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
        }

        #style-7::-webkit-scrollbar {
            width: 8px;
            height: 8px;
            background-color: #F5F5F5;
            border-radius: 25px;
        }

        #style-7::-webkit-scrollbar-thumb {
            border-radius: 10px;
            background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0.44, rgb(122,153,217)), color-stop(0.72, rgb(73,125,189)), color-stop(0.86, rgb(28,58,148)));
        }

        .box-shadow {
            box-shadow: 0px 3px 46px rgb(0 0 0 / 7%);
            padding: 15px 15px;
            background: #f2f2f2;
        }

        .card {
            margin-top: 25px;
        }

        .card-body {
            border: 1px solid#ccc;
            padding: 5px;
        }

        .headings_border {
            position: relative;
            color: white;
            font-size: 25px;
            text-align: center;
            font-family: raleway;
            font-weight: 900;
            display: inline-block;
            padding-left: 15px;
        }

            .headings_border::after {
                content: '';
                position: absolute;
                top: 45px;
                left: 13%;
                width: 168px;
                height: 2px;
                /*background: #5cb85c;*/
            }

        .headings_border_gram {
            position: relative;
            color: white;
            font-size: 25px;
            text-align: center;
            font-family: raleway;
            font-weight: 900;
            display: inline-block;
            padding-left: 15px;
        }

            .headings_border_gram::after {
                content: '';
                position: absolute;
                top: 45px;
                left: 33%;
                width: 168px;
                height: 2px;
                /*background: #5cb85c;*/
            }

        .w-100 {
            width: 100% !important
        }

        #demandside::-webkit-scrollbar {
