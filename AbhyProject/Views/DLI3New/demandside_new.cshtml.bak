    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.1/themes/base/jquery-ui.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <script src="~/Content/JS_Files/Dli3_new.js"></script>

</head>

<body>
    <center>
        <div class="text-h g-mb-20" style="font-size: 35px; color:white; font-family: raleway; margin-top: 10px; font-weight: 900; background-color: #72a230">
            DLI 3 Convergence Claim (Demand Side)
        </div>

    </center>
    <div>
        <ul style="color:white;">
            <li style=" text-align: right; margin-top:10px;">
                <select name="" id="state_p1" class="form-control" onchange="allsummary()" style="float:right;width:160px;margin-top:0px;margin-left:5px">
                    <option value="0">Select Summary</option>
                    <option value="State">Summary (State Phase 1)</option>
                </select>
                <select name="" id="district_p1" class="form-control" onchange="districtsummary()" style="float: right; width: 160px; margin-top: 0px; margin-left: 5px">
                    <option value="0">Select Summary</option>
                    <option value="District">Summary (District Phase 1)</option>
                    <option value="Block">Summary (Block Phase 1)</option>
                </select>
                <select name="" id="demanddistrictblock_p1" class="form-control" onchange="p1districtblocksummary()" style="float: right; width: 160px; margin-top: 0px; margin-left: 5px">
                    <option value="0">Select Summary</option>
                    <option value="Block">Summary (Block Phase 1)</option>
                </select>
                <select name="" id="state_p2" class="form-control" onchange="p2allsummary()" style="float:right;width:160px;margin-top:0px;margin-left:5px">
                    <option value="0">Select Summary</option>
                    <option value="State">Summary (State Phase 2)</option>
                </select>
                <select name="" id="district_p2" class="form-control" onchange="p2districtsummary()" style="float: right; width: 160px; margin-top: 0px; margin-left: 5px">
                    <option value="0">Select Summary</option>
                    <option value="District">Summary (District Phase 2)</option>
                    <option value="Block">Summary (Block Phase 2)</option>
                </select>
                <select name="" id="demanddistrictblock_p2" class="form-control" onchange="p2districtblocksummary()" style="float: right; width: 160px; margin-top: 0px; margin-left: 5px">
                    <option value="0">Select Summary</option>
                    <option value="Block">Summary (Block Phase 2)</option>
                </select>

                <button class="btn btn-success download1" id="btnexcelphase1" onclick="Exceldemandside_phase1()">Export To Excel (Phase1)</button>
                <button class="btn btn-success download1" id="btnexcelphase2" onclick="Exceldemandside_phase2()">Export To Excel (Phase2)</button>
                @*<button type="button" id="pdf" onclick="Report_PDF()" class="btn btn-success btn-sm"> Export To PDF</button>*@

                <a href="~/DLI3New/viewdemandsidesupplyside_new" class="btn btn-danger">
                    Back To Module
                </a>
                <a href="~/DLI3New/suppyside_new" class="btn btn-primary">
                    Go To Supply Side
                </a>

                @*<button type="button" style="float: right; width: 150px; margin-right: 30px; margin-left: 10px;" id="next_page" onclick="Goto_page()" class="btn btn-primary btn-sm">Go To Supply Side</button>*@


                @*<select style="float: right; width: 150px; margin-right: 30px; margin-left: 10px;" class="form-control" id="ddlpage" onchange="Goto_page()">
                        <option value="0">--Select Page--</option>
                        <option value="Supply Side">Supply Side</option>
                    </select>*@
            </li>
        </ul>
    </div>




    <div class="row showdiv">
        <div class="container-fluid">
            <div class="content">
                <div class="col-lg-12" style="background-color:#fff;">
                    <div id="border">
                        <div class="row container-fluid main_div">
                            <div class="col-md-12 col-sm-12">
                                <div>
                                    <div class="">
                                        <div class="selectdistshowoption">
                                            <ul class="Select_option col-md-12 col-sm-12  text-left">
                                                <li id="StateLabel">
                                                    <label id="lblstate">State:</label>
                                                    <span id="spnstate1">@Session["gstate"]</span>
                                                </li>
                                                <li id="StateDropdownLabel">

                                                    <select class="form-control" id="spnstate" onchange="State_Dropdown_Function()">
                                                    </select>
                                                </li>

                                                <li id="DistLabel">
                                                    <i class="fas fa fa-angle-double-right"></i>
                                                    <label id="lbldistrict">District:</label>
                                                    <span id="spndistrict">@Session["gdist"]</span>
                                                </li>

                                                <li id="DistDropdownLabel">

                                                    <select class="form-control" id="dist11" onchange="Dist_fun()">
                                                    </select>
                                                </li>

                                                <li id="BlockLabel">
                                                    <i class="fas fa fa-angle-double-right"></i>
                                                    <label>Block:</label>
                                                    <span>@Session["gblock"] </span>
                                                </li>

                                                <li id="BlockDropdownLabel">

                                                    <select class="form-control" id="block1" onchange="Block_fun()">
                                                    </select>
                                                </li>
                                                <li id="GramLabel">
                                                    <i class="fas fa fa-angle-double-right"></i>
                                                    <label>Gram panchayat:</label>
                                                    <span>@Session["ggram"]</span>
                                                </li>

                                                <li id="GramDropdownLabel">
                                                    <select class="form-control" id="gram" onchange="Gram_change()">
                                                    </select>
                                                </li>
                                                <li>
                                                    <select class="form-control" id="Demand_side">
                                                        <option value="0">Select Demand Side </option>
                                                        <option value="All">All Intervention</option>
                                                        <option value="Sprinkler">Micro-Irrigation through Sprinkler</option>
                                                        <option value="Drip">Micro-Irrigation through Drip</option>
                                                        <option value="UG Pipelines">Irrigation through underground pipelines</option>
                                                        <option value="Crop Diversification">Crop diversification</option>
                                                        <option value="Other Measures">Any other measure for saving of water in agriculture/Innovative measures ( Pl. specify)</option>
                                                    </select>
                                                </li>
                                                <li class="">
                                                    <select name="" id="year" class="form-control" onchange="">
                                                        <option value="0">Select Year</option>
                                                        <option value="2023-24">2023-24</option>
                                                        <option value="2024-25">2024-25</option>



                                                    </select>
                                                </li>
                                                <li class="" style="display:none;">
                                                    <select name="" id="phase" class="form-control" onchange="" disabled>
                                                        <option value="phase1">Phase1 [April 2023-September 2023]</option>
                                                        <option value="phase2">Phase2 [October 2023 - March 2024]</option>
                                                    </select>
                                                </li>

                                                <li id="DropdownSearch_btn">
                                                    <button class="btn btn-success" onclick="Dropdown_Search()">Search</button>
