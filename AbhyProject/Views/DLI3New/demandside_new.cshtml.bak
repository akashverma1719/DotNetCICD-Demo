    <script>

   var Jsondata = "";

    var WaterAvialability = 0;
    var WaterDropt = 0;
    var AA = 0, DD = 0;
    var State = "0";
    var Dist = "0";
            var Block = "0";

    /*var Gram = "0";*/
        var off_1 = "";
        var Gram = "0";
        var StateOfficer = '';
            $(document).ready(function () {
         StateOfficer = '@Session["Officer"]';
            if (StateOfficer == "") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            else if (StateOfficer == "Gram Panchayat Nodal Officer") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }

        Jsondata = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GPLIst));
        $('#Error_').text("States Information is Loading....");
        $('#StateLabel').hide();
        $('#StateDropdownLabel').hide();
        $('#DistLabel').hide();
        $('#DistDropdownLabel').hide();
        $('#BlockLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramLabel').hide();
        $('#GramDropdownLabel').hide();
        $('#DropdownSearch_btn').hide();
        $('#supply_side').hide();
            $('#btnpreexe').hide();
            $('#btnnextexe').hide();
            $('#pdf').prop('disabled', true);
            $('#excel').prop('disabled', true);
            $('#Excel').hide();
            $('#div_other').hide();
            $('#div_other_2').hide();
            $('#txtrejectremark').hide();
            $('#phase1reject').hide();
                $('#btnexcelphase1').hide();
                $('#btnexcelphase2').hide();
                $('#state_p1').hide();
                $('#state_p1').attr("disabled", "disabled");
                $('#district_p1').hide();
                $('#district_p1').attr("disabled", "disabled");
                $('#state_p2').hide();
                $('#state_p2').attr("disabled", "disabled");
                $('#district_p2').hide();
                $('#district_p2').attr("disabled", "disabled");
                $('#demanddistrictblock_p1').hide();
                $('#demanddistrictblock_p1').attr("disabled", "disabled");
                $('#demanddistrictblock_p2').hide();
                $('#demanddistrictblock_p2').attr("disabled", "disabled");

                var phase = $('#phase').val();
                if (phase == "phase1") {
                    $('#btnexcelphase1').show();
                    $('#btnexcelphase2').hide();
                    $('#state_p1').hide();
                    $('#district_p1').hide();
                    $('#state_p2').hide();
                    $('#state_p2').attr("disabled", "disabled");
                    $('#district_p2').hide();
                    $('#district_p2').attr("disabled", "disabled");
                    $('#demanddistrictblock_p1').hide();
                    $('#demanddistrictblock_p1').attr("disabled", "disabled");
                    $('#demanddistrictblock_p2').hide();
                    $('#demanddistrictblock_p2').attr("disabled", "disabled");
                    $('#txtyear').text("Phase1[April 2023 - September 2023]");
                }
                else if (phase == "phase2") {
                    $('#btnexcelphase1').hide();
                    $('#btnexcelphase2').show();
                    $('#state_p1').hide();
                    $('#district_p1').hide();
                    $('#state_p2').hide();
                    $('#district_p2').hide();
                    $('#txtyear').text("Phase2[October 2023 - March 2024]");
                    $('#demanddistrictblock_p1').hide();
                    $('#demanddistrictblock_p1').attr("disabled", "disabled");
                    $('#demanddistrictblock_p2').hide();
                    $('#demanddistrictblock_p2').attr("disabled", "disabled");
                }

            DropDownInfo();



            });
        function validate(e) {
            debugger;
            var c = 0;
            var { value } = event.target;
            var count1 = 0;

            for (var i = 0; i < value.length; i++) {
                count1++;
                if (value[i] != '.') {
                    if (count1 == 6 && value[i] != '.') {

                        e.preventDefault();
                    }
                } else {
                    var count = 0, point = false;
                    for (var i = 0; i < value.length; i++) {

                        if (value[i] == '.' || point) {
                            count++;
                            point = true;
                        }
                        if (count > 2) {
                            e.preventDefault();
                        }
                    }
                }

            }
        }
    function pagechange() {
        window.location = "WspWaterAvailability", "WspNew"
        }

        function allsummary() {
            var all = $('#state_p1').val();
            if (all == "State") {
                window.location = "/DLI3New/demand_state_report";
            }
            else if (all == "0") {
                alert("Please Select Summary ");
            }
        }
        function districtsummary() {
            var dist = $('#district_p1').val();
            if (dist == "District") {
                window.location = "/DLI3New/demand_district_report";
            }
            else if (dist == "Block") {
                window.location = "/DLI3New/demand_block_report";
            }
            else if (dist == "0") {
                alert("Please Select Summary ");
            }
        }
        function p1districtblocksummary() {
            var all = $('#demanddistrictblock_p1').val();
            if (all == "Block") {
                window.location = "/DLI3New/demand_districtblock_report";
            }
            else if (all == "0") {
                alert("Please Select Summary ");
            }
        }
        function p2allsummary() {
            var all = $('#state_p2').val();
            if (all == "State") {
                window.location = "/DLI3New/p2demand_state_report";
            }
            else if (all == "0") {
                alert("Please Select Summary ");
            }
        }
        function p2districtsummary() {
            var dist = $('#district_p2').val();
            if (dist == "District") {
                window.location = "/DLI3New/p2demand_district_report";
            }
            else if (dist == "Block") {
                window.location = "/DLI3New/p2demand_block_report";
            }
            else if (dist == "0") {
                alert("Please Select Summary ");
            }
        }
        function p2districtblocksummary() {
            var all = $('#demanddistrictblock_p2').val();
            if (all == "Block") {
                window.location = "/DLI3New/demand_districtblock_reportp2";
            }
            else if (all == "0") {
                alert("Please Select Summary ");
            }
        }

    </script>

