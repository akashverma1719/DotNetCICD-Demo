                display: inline;
            }

            .under_list > li > span > select {
                width: 500px;
                height: 30px;
                padding: 3px 10px;
                display: inline;
            }

        @@media (max-width:1200px) and (min-width: 360px) {
            .panelbodyheading {
                background: none !important;
                color: #fff !important;
            }
        }

        #border {
            border-spacing: 2px;
            /* border: 2px solid green;*/
            box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 4px;
            margin-left: 50px;
            margin-right: 50px;
            margin-top: 15px;
            background: #f2f2f2;
        }

        .selectdistshowoption .Select_option li {
            width: 14%;
        }

        #border select {
            width: 100% !important;
            border-radius: 4px !important;
        }

        .Select_option.selectbackhome li select {
            border-radius: 25px;
            width: 200px;
        }

        ul.Select_option {
            list-style: none;
            font-size: 13px;
            padding-left: 0;
        }

        .selectdistshowoption {
            width: 100% !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            margin-bottom: 20px !important;
            margin-top: 30px !important;
        }

