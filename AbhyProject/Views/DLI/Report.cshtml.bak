                                '<td> <button type="button" class="btn btn-primary" onclick="Update_AWP1(' + data[i].Id + ',' + i + ')">Update</button></td>' + '<td><button class="btn btn-danger " type="button" onclick="cancelcomp_A_Support(' + i + ');"><i class="fa fa-remove"</button>' + '</td></tr>';

                        } else {
                            tr1 += '<tr id="AWP1_TR_Meeting' + i + '"><td>' + (parseInt(i) + 1) + '</td><td>' + data[i].State + '</td><td>' + data[i].Year + '</td><td>' + data[i].Type + '</td><td>' + data[i].Target + '</td>';
                            tr1 += '<td>' + data[i].Achievement + '</td> <td><button class="btn btn-primary disable_btn" onclick="editrowcomp_A_Good2(' + i + ')" disabled> <i class="fa fa-edit"></i></button></td> <td><button class="btn btn-danger disable_btn" onclick="Delete_SocMan(' + data[i].Id + ')" disabled><i class="fa fa-trash"></i></button></td>' +
