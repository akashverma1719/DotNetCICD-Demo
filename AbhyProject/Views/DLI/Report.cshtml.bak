                                <label for="Type">Type</label>
                                <input type="text" name="Type" class="form-control" id="Type" placeholder="Type" required readonly>
                            </div>
                            <div class="form-group" id="WQT">
                                <label for="Target">Water Quality Target</label>
                                <input type="number" name="WQTarget" class="form-control number" id="WQTarget" placeholder="Target" required>
                            </div>
                            <div class="form-group" id="WQA">
