                        </form>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-secondary" data-dismiss="modal">Close</a>
                        <button type="button" id="updateModalButton" class="btn btn-primary" rowid="" onclick="update()" data-dismiss="modal">Update</button>
                    </div>
                </div>*@

                </div>
            </div>
            <br />
            <br />
            <div class="tbl-responsive" id="DLI1_div" style="overflow-x:scroll;overflow-y:scroll; height:500px; ">
                <table id="DliTable" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                    <thead>
                        <tr class="info red">

                            <th class="text-center">Sr.No</th>
                            <th class="text-center">States</th>
                            <th class="text-center">Fy Year</th>
