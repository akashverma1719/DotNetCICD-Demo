                                '<td> <input type="text" class="form-control" id="state1' + i + '" value="' + data[i].State + '" readonly/></td>' +
                                '<td> <input type="text" class="form-control" id="year1' + i + '" value="' + data[i].Year + '" readonly/></td>' +
                                '<td> <input type="text" class="form-control" id="type1' + i + '" value="' + data[i].Type + '" readonly /></td>' +

                                '<td> <input type="tel" maxlength="5" class="form-control" id="tar1' + i + '" value="' + data[i].Target + '"  /></td>' +

                                '<td id="ACH1' + i + '"> <input type="tel" maxlength="5" class="form-control" id="ach1' + i + '" value="' + data[i].Achievement + '"  /></td>' +
                                '<td id="ACH_DLI1' + i + '"> <input type="tel" class="form-control" id="ach_dli1' + i + '" value="' + data[i].Achievement + '" readonly /></td>' +

                                '<td> <button type="button" class="btn btn-primary" onclick="Update_AWP1(' + data[i].Id + ',' + i + ')">Update</button></td>' + '<td><button class="btn btn-danger " type="button" onclick="cancelcomp_A_Support(' + i + ');"><i class="fa fa-remove"</button>' + '</td></tr>';

                        }

                    }
                }
                if (tr == '') {
                    tr = '<tr colspan="19"><td colspan="19" style="text-align: center;">No Data</td></tr>';
                }
                if (tr1 == '') {
                    tr1 = '<tr colspan="19"><td colspan="19" style="text-align: center;">No Data</td></tr>';
                }
                $('#Tbody1').html(tr1);
                $('#Tbody').html(tr);
                debugger;

                if (Email == 'neetynagi@gmail.com') {
                    $('.disable_btn').prop('disabled', false);
                }

            }


        });
    }

    /*Akash*/
    function Delete_SocMan(Id) {
        debugger;
        var obj = {};
        obj.Id = Id;
        $.ajax({
            type: "POST",
            contentType: "application/json;charset=utf-8",
            url: '/DLI/delete_DLI',
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {
                alert(response);
                FetchData();
                //  Get_Fund_Form_Info();


            }
        });
    }

    function editrowcomp_A_Good2(i) {
          debugger;
        $('#AWP1_TR_Meeting' + i).hide();
        $('#hide_AWP1_TR_Meeting' + i).show();

        var Type = $('#type1' + i).val();
        if (Type == "DLI1") {
            $('#tar1' + i).show();
            $('#wla1' + i).show();
            $('#wqa1' + i).show();
            $('#hgra1' + i).show();
            $('#ACH_DLI1' + i).show();
            $('#ACH1' + i).hide();

        }
        else {
            $('#tar1' + i).show();
            $('#wla1' + i).hide();
            $('#wqa1' + i).hide();
            $('#hgra1' + i).hide();
            $('#ach_dli1' + i).hide();
            $('#ACH_DLI1' + i).hide();
            $('#ach1' + i).show();
        }

    }

    function cancelcomp_A_Support(i) {
        /*  debugger;*/
        $('#AWP1_TR_Meeting' + i).show();
        $('#hide_AWP1_TR_Meeting' + i).hide();
    }

    function Total_Numbers_update(RowNo) {
        /*alert('ok');*/
        /* debugger;*/
        var total = 0;
        var wla = $('#wla1' + RowNo).val();
        var wqa = $('#wqa1' + RowNo).val();
        var hgra = $('#hgra1' + RowNo).val();

        if (wla == "") {

            wla = 0;
        }

        if (wqa == "") {

            wqa = 0;
        }
        if (hgra == "") {

            hgra = 0;
        }

        total = parseFloat(wla) + parseFloat(wqa) + parseFloat(hgra);

        $('#ach_dli1' + RowNo).val(total);


    }


    function Update_AWP1(Id, RowNo) {
        /*alert('ok');*/
        debugger;
        var xx = 0;
        var Id = Id;

        var State = $('#state1' + RowNo).val();
        var Year = $('#year1' + RowNo).val();
        var Type = $('#type1' + RowNo).val();
        var TAR = $('#tar1' + RowNo).val();

        var WLA = $('#wla1' + RowNo).val();
        var WQA = $('#wqa1' + RowNo).val();
        var HGRA = $('#hgra1' + RowNo).val();

        if (Type == "DLI1") {
            var ACH = $('#ach_dli1' + RowNo).val();
        }
        else {
            var ACH = $('#ach1' + RowNo).val();
        }

        if (Type == "DLI1") {
            if (WLA == "") {
                xx = 1;
                alert("Please Enter Water Level Achievement");
            }
            else if (WQA == "") {
                xx = 1;
                alert("Please Enter Water Quality Achievement");
            }
            else if (HGRA == "") {
                xx = 1;
                alert("Please Enter HGR Achievement");
            }
            else if (TAR == "") {
                xx = 1;
                alert("Please Enter Target");
            }

        }
        if (Type !== "DLI1") {

             if (TAR == "") {
                xx = 1;
                alert("Please Enter Target");
            }
            if (ACH == "") {
                xx = 1;
                alert("Please Enter Achievement");
            }

        }

        if (xx == 0) {
            var formData = new FormData();

            formData.append("Id", Id);
            formData.append("State", State);
            formData.append("Year", Year);
            formData.append("Type", Type);
            formData.append('TAR', TAR);
            formData.append("WLA", WLA);
            formData.append("WQA", WQA);
            formData.append('HGRA', HGRA);
            formData.append('ACH', ACH);

            $.ajax({
                url: '/DLI/Update',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (response) {

                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }

                    FetchData();

                },
                error: function () {
                    alert('Update Failed');
                }
            });
        }
    }

</script>
