                                <input type="number" name="WQAchievement" class="form-control number" id="WQAchievement" placeholder="Achievement" required>
                            </div>
                            <div class="form-group" id="HGRT">
                                <label for="Target">HGR Target</label>
                                <input type="number" name="HGRTarget" class="form-control number" id="HGRTarget" placeholder="Target" required>
                            </div>
                            <div class="form-group" id="HGRA">
                                <label for="Achievement">HGR Achievement</label>
