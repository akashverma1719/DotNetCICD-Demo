                        <option value="ALL">All 5 Years</option>
                        <option value="2020-21">2020-2021</option>
                        <option value="2021-22">2021-2022</option>
                        <option value="2022-23">2022-2023</option>
                        <option value="2023-24">2023-2024</option>
                        <option value="2024-25">2024-2025</option>
                    </select>
                </div>
                <div class="col-lg-4 col-sm-4 col-md-4" style="">
                    <select class="form-control" id="Stype_check" onchange="FetchData()">
                        <option value="0">Select DLI</option>
                        <option value="DLI1">DLI1</option>
                        <option value="DLI2">DLI2</option>
                        <option value="DLI3">DLI3</option>
                        <option value="DLI4">DLI4</option>
                        <option value="DLI5">DLI5</option>
                    </select>
                    <br />
                    <br />

                    <div class="col-md-12 bg-light btn_hide" style="text-align:right; width:100%; padding:0;">
                        <div class="btn btn-success btn_export"><i class="fa fa-file-excel-o" onclick="Export_Table()"> Export To Excel</i></div>
                        <input type="button" id="dli_report_excel" onclick="tableToExcel('DliTable' , 'DLI_Data')" hidden />

                    </div>

                </div>
            </div>



            <div class="modal fade" id="myModal" role="dialog" aria-labelledby="Modelledby" aria-hidden="true">
                <div class="modal-dialog">

                    <!-- Modal content-->
                    @*<div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Edit Data</h4>
                    </div>
