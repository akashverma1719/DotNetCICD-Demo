<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/JS_Files/DLI.js"></script>
<script type="text/javascript">
    var Email = "";
    var Access_Auth = "";
    $(document).ready(function () {
        $("#btnSave").text("Save");
        Email = '@Session["Email"]';
        $('#hide_div_DLI').hide();
        State();
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_hide').hide();
        }
        //FetchData();

    });

    function Export_Table() {
        //if (component != 0) {
        //    for (var i = 0; i < component; i++) {
        //        var ss = "TRA01" + i;
        //        $(ss).remove();
        //    }
        //}

        $('#dli_report_excel').click();
        Dli_1_Details();

    }

    var tableToExcel = (function () {

        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--><meta http-equiv="content-type" content="text/plain; charset=UTF-8"/></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()

    function State() { //add value to state dropdown

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/DLI/Get_States',
            dataType: 'JSON',
            success: function (data) {


                var html = '';
                html += '<option id="' + "0" + '" value="0" id="lblstates"> ' + "Select state" + ' </option>';
                html += '<option id="' + "ALL" + '" value="ALL" id="lblstates"> ' + "ALL states" + ' </option>';
                for (var i = 0; i < data.length; i++) {
                    html += '<option stateid="' + data[i].state_name + '" id="lblstates"> ' + data[i].state_name + ' </option>';

                }
                var html1 = '';
                html1 += '<option id="' + "0" + '" value="0" id="lblstates"> ' + "Select state" + ' </option>';
                for (var i = 0; i < data.length; i++) {
                    html1 += '<option stateid="' + data[i].state_name + '" id="lblstates"> ' + data[i].state_name + ' </option>';

                }
                $('#Sstate').html(html1);
                //html += '<option stateid="ALL" id="lblstates">ALL </option>';
                $('#Sstate_check').html(html);

                var StateOfficer = '@Session["gstate"]';
                if (StateOfficer != '') {
                    $('#Sstate_check').val(StateOfficer);
                    $('#Sstate_check').prop('disabled', true);
                }
            }
        });

    }

    function Check_Data() {      //check whether the data exist or not

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: "/DLI/Get_Data",
            dataType: 'JSON',
            success: function (data) {


                var state_s = $("#Sstate").val();
                var year_s = $("#Syear").val();
                var type_s = $("#Stype").val();
                for (var i = 0; i < data.length; i++) {
                    if (data[i].Year == year_s && data[i].State == state_s && data[i].Type == type_s) {
                        //if data exists
                        $("#btnSave").text("Update");
                        $("#DLTarget").val(data[i].Target);
                        $("#DLAchievement").val(data[i].Achievement);
                        $('#DLTarget').attr('RowId', data[i].Id);
                        return;
                    } else {
                        $("#DLTarget").val('');
                        $("#DLAchievement").val('');

                    }


                }
                FetchData();

            }

        });
    }

    function FetchData() {      //check whether the data exist or not

        /*var html = "";*/
        var state_s = $("#Sstate_check").val();
        var year_s = $("#Syear_check").val();
        var type_s = $("#Stype_check").val();
        if (type_s != "0") {
            if (type_s == 'DLI1') {
                $('#DLI1_div').show();
                $('#hide_div_DLI').hide();
            } else {
                $('#DLI1_div').hide();
                $('#hide_div_DLI').show();
            }
        }

        var StateOfficer = '@Session["gstate"]';
        if (StateOfficer != '') {
            state_s = StateOfficer;
            $('.state-disabled').hide();
        }
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: "/DLI/Get_Data",
            data: { 'State': state_s, 'year': year_s, 'type': type_s },
            //data: '{state:' + state_s + ',year:' + year_s + ',type:' + type_s +'}',
            dataType: 'JSON',
            success: function (data) {

                //for (var i = 0; i < data.length; i++) {
                //    html += '<tr><td><label id="srNo" rowId = ' + data[i].Id + '>' + (i + 1) + '</label></td>';
                //    html += '<td><label id="year">' + data[i].Year + '</label></td>';
                //    html += '<td><label id="State">' + data[i].State + '</label></td>';
                //    html += '<td><label id="Type">' + data[i].Type + '</label></td>';
                //    html += '<td><label id="Target">' + data[i].Target + '</label></td>';
                //    html += '<td><label id="Achievement">' + data[i].Achievement + '</label></td>';
                //    html += '<td><label id="WaterQuality_Target">' + data[i].WaterQuality_Target + '</label></td>';
                //    html += '<td><label id="WaterQuality_Achievement">' + data[i].WaterQuality_Achievement + '</label></td>';
                //    html += '<td><label id="HGR_Target">' + data[i].HGR_Target + '</label></td>';
                //    html += '<td><label id="HGR_Achievement">' + data[i].HGR_Achievement + '</label></td>';
                //    if (StateOfficer == '') {
                //        html += '<td><button class="btn btn-primary" data-toggle="modal" data-target="#myModal" onclick="edit(this)" > <i class="fa fa-edit"></i></button ></td><td><button class="btn btn-danger" onclick="deletecomp_release(' + data[i].Id + ')"><i class="fa fa-trash"></i></button></td></tr> '

                //    }

                //}
                //$('#DliTable tbody').html(html);

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                var tr = '';
                var tr1 = '';
                if (data.length != 0) {

                    for (var i = 0; i < data.length; i++) {
                        debugger;
                        if (data[i].Type == "DLI1") {
                            tr += '<tr id="AWP1_TR_Meeting' + i + '"><td>' + (parseInt(i) + 1) + '</td><td>' + data[i].State + '</td><td>' + data[i].Year + '</td><td>' + data[i].Type + '</td><td>' + data[i].Target + '</td><td>' + data[i].WaterLevel_Achievement + '</td><td>' + data[i].WaterQuality_Achievement + '</td>';
                            tr += '<td>' + data[i].HGR_Achievement + '</td><td>' + data[i].Achievement + '</td> <td><button class="btn btn-primary disable_btn" onclick="editrowcomp_A_Good2(' + i + ')" disabled> <i class="fa fa-edit"></i></button></td> <td><button class="btn btn-danger disable_btn" onclick="Delete_SocMan(' + data[i].Id + ')" disabled><i class="fa fa-trash"></i></button></td>' +
                                '<tr id="hide_AWP1_TR_Meeting' + i + '" style="display:none;"><td>' + (i + 1) + '</td>' +

                                '<td> <input type="text" class="form-control" id="state1' + i + '" value="' + data[i].State + '" readonly/></td>' +
                                '<td> <input type="text" class="form-control" id="year1' + i + '" value="' + data[i].Year + '" readonly/></td>' +
                                '<td> <input type="text" class="form-control" id="type1' + i + '" value="' + data[i].Type + '" readonly /></td>' +

                                '<td> <input type="tel" maxlength="5" class="form-control" id="tar1' + i + '" value="' + data[i].Target + '"  /></td>' +
                                '<td> <input type="tel" maxlength="5" class="form-control" id="wla1' + i + '" value="' + data[i].WaterLevel_Achievement + '" onkeyup="Total_Numbers_update(' + i + ')"  onkeydown="Total_Numbers_update(' + i + ')" /></td>' +

