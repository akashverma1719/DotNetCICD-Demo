<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid orange;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }
</style>
<style type="text/css">
    .modal-backdrop.in {
        z-index: 0px !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
</style>
@*<div class="loading" id="loading" style="text-align:center;">

    <img src="~/Content/WspImages/loader.gif" width="300" height="300" />

</div>*@

<div class="loading-container loading" id="loading">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="300" width="300" />
    </div>
</div>
<div class="ss" style="display:none">
    <div class="row">
        <div class="col-md-12">
            <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">TAMC Contact</div>
        </div>
    </div>

    <div class="container-fluid" style="margin-top:20px;">


        <!--Start datatable row-->

        <div class="row">
            <div class="col-md-12">
                <div class="tbl-responsive">
                    <table id="example" class=" display  table stripe row-border order-column table-striped table-bordered dataTable no-footer" style="width:100%">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Location</th>

                            </tr>
                        </thead>
                        <tbody>

                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.designation)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.mobile)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.email)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.location)
                                        </td>
                                    </tr>
                                    i = i + 1;
                                }




                            }
                            <!--Rows here-->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>