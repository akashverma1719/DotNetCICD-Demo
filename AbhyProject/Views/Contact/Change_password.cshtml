        <div class="sc-container">
            <!-- form card change password -->
            <div class="card card-outline-secondary">

                <div class="card-body">
                    @*<form autocomplete="off">
                                        <div class="form-group">
                            <label for="inputPasswordOld">Current Password</label> <span class="" id="password_req" style="display:none;">required</span>
                            <input type="password" class="form-control" name="old_password" id="old_password" autocomplete="off" required="">
                        </div>*@
                    @using (Html.BeginForm("Change_password", "Contact", FormMethod.Post))
                    {
                        <div class="form-group">
                            <label for="inputPasswordNew">Email</label> <span class="" id="Email_req" style="display:none;">required</span>
