                            <input type="password" class="form-control" name="Password" id="new_password" autocomplete="off" required="" onkeyup="CheckPasswordStrength(this.value)">
                            <span toggle="#new_password" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                            <label>Password Strength: </label><strong id="password_strength"></strong><br><br>
                        </div>
                        <div class="form-group">
                            <label for="inputPasswordNew">Confirm Password</label> <span class="" id="_req" style="display:none;">required</span>
                            <input type="password" class="form-control" name="CheckingCode" id="confirm_password" required="">

                        </div>

                        @*<input type="text" name="Villagename" id="Villagename" hidden />*@
