@model IEnumerable<AbhyProject.Models.abhy_agencies>

@{
    ViewBag.Title = "Additional_Contacts";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
    var i = 1;
}
<link href="~/Content/Website/lib/nivo-slider/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<script src="~/Content/Website/js/jquery.dataTables.min.js"></script>
<script src="~/Scripts/all_scripts/dataTables.bootstrap.min.js"></script>
@*<script src="https://cdn.datatables.net/1.10.19/js/dataTables.bootstrap.min.js"></scrip*@
<title>Additional Contacts</title>
<script>
    $(window).load(function () {
        $('.loading').hide();
        $('.ss').show();
    });
</script>
<script>
    $(document).ready(function () {
        $.noConflict();

        $('#example').DataTable();
    });

</script>
<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid orange;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
    table.dataTable thead td {
        padding: 10px 18px 10px 9px;
    }
</style>

<style type="text/css">
    .modal-backdrop.in {
        z-index: 0px !important;
    }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
</style>



<div class="loading-container loading" id="loading">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="300" width="300" />
    </div>
</div>
<div class="ss" style="display:none">

    <div class="row">
        <div class="col-md-12">
            <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">Additional Contacts</div>
        </div>
    </div>

    <div class="container-fluid" style="margin-top:20px;">


        <!--Start datatable row-->

        <div class="row">
            <div class="col-md-12">
                <div class="tbl-responsive">
                    <table id="example" class=" display  table stripe row-border order-column table-striped table-bordered dataTable no-footer" style="width:100%">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>
                                    Name
                                </th>
                                <th>Designation</th>
                                @*<th>
                                        Authority Name
                                    </th>*@

                                <th>
                                    office
                                </th>
                                <th>
                                    Phone No
                                </th>
                                <th>
                                    Email Id
                                </th>


                            </tr>
                        </thead>
                        <tbody>

                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    if (i == 1)
                                    {
                                        <tr><th colspan="6">National Project Monitoring Unit (NPMU), Atal Bhujal Yojana</th></tr>
                                    }
                                    else if (i == 9)
                                    {
                                        <tr><th colspan="6">Central Ground Water Board</th></tr>
                                    }
                                    <tr>
                                        <td>@i</td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.staff_name)
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.designation)</td>
                                        @*<td>
                                                @Html.DisplayFor(modelItem => item.authorizedname)
                                            </td>*@
                                        <td>
                                            @Html.DisplayFor(modelItem => item.agencies)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.mobile)
                                        </td>

                                        <td>
                                            @Html.DisplayFor(modelItem => item.emailid)
                                        </td>

                                    </tr>
                                    i = i + 1;
                                }




                            }
                            <!--Rows here-->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>
<script>
    $("nav#primary-menu > ul.main-menu > li:nth-child(11)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(11)").siblings().removeClass('active');
    $("nav#primary-menu > ul.main-menu > li:nth-child(11) > ul.dropdown > li:nth-child(3)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(11) > ul.dropdown > li:nth-child(3)").siblings().removeClass('active');

</script>