<td colspan="5">Project Co-ordinator</td>

<script>
    $(document).ready(function () {
        Info();
        $('#example').DataTable();
    });
    function Info() {
        
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/About/Agencies_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                
                var Divv = "";
                var Second = "";
                var j = 1;
                var k = 1;
                var Headers = ["Project Co-ordinator", "Project Director/Nodal Officer"];
                if (data != null) {

                    var Divv1 = "";
                    var Divv2 = "";

                    for (var i = 0; i < data.length; i++) {
                        var State = "";
                        var project_coordinator = "";
                        var designation = "";
                        var agency_name = "";
                        var contact = "";
                        var contact_details = "";

                        if (data[i].state != null) {
                            State = data[i].state;
                        }
                        if (data[i].project_coordinator != null) {
                            project_coordinator = data[i].project_coordinator;
                        }
                        if (data[i].designation != null) {
                            designation = data[i].designation;
                        }
                        if (data[i].contact != null) {
                            contact = data[i].contact;
                        }

                        if (data[i].contact_details != null) {
                            contact_details = data[i].contact_details;
                        }
                        if (data[i].agency_name != null) {
                            agency_name = data[i].agency_name;
                        }


                        if (data[i].header == "Project Co-ordinator") {
                            if (j == 1) {
                                Divv1 += '<tr><th colspan="7">Project Co-ordinator</th></tr> <tr> <td>' + j + '</td><td>' + State + '</td><td>' + project_coordinator + ' </td><td>' + designation + '<td>' + agency_name + '</td>' +
                                    '<td>' + contact + '</td><td>' + contact_details + '</td></tr>';
                            }
                            else {
                                Divv1 += '<tr>  <td>' + j + '</td><td>' + State + '</td><td>' + project_coordinator + ' </td><td>' + designation + '<td>' + agency_name + '</td>' +
                                    '<td>' + contact + '</td><td>' + contact_details + '</td></tr>';
                            }
                            j = j + 1;
                        }

                        if (data[i].header == "Project Director/Nodal Officer") {
                            if (k == 1) {
                                Divv2 += '<tr><th colspan="7">Project Director/Nodal Officer</th></tr> <tr> <td>' + k + '</td><td>' + State + '</td><td>' + project_coordinator + ' </td><td>' + designation + '<td>' + agency_name + '</td>' +
                                    '<td>' + contact + '</td><td>' + contact_details + '</td></tr>';
                            }
                            else {
                                Divv2 += '<tr> <td>' + k + '</td><td>' + State + '</td><td>' + project_coordinator + ' </td><td>' + designation + '<td>' + agency_name + '</td>' +
                                    '<td>' + contact + '</td><td>' + contact_details + '</td></tr>';

                            }
                            k = k + 1;
                        }


                    }

                    Divv = Divv1 + Divv2;
                    $('#AgenciesInfo').html(Divv);

                }

                else {
                    Divv += ' <tr><td colspan="7"> No Data</td> </tr>';
                    $('#AgenciesInfo').html(Divv);

                }

            }
        });
    }
</script>