<title> Contacts SPMU</title>


<style>
    .Training2 {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        border: 2px solid orange;
    }

    .upload2 {
        border-radius: 2px;
        padding: 20px;
        position: relative;
        box-sizing: border-box;
    }

    .table.dataTable thead th,
