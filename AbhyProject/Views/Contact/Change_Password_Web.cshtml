<script type="text/javascript">
    var Captcha_str_1 = "";


        function refress() {

            
            $('#C_img1').attr('src', $('#C_img1').attr('src') + '#');
        }


    function ChangePassword() {

        document.getElementById('AlertInfo_mail').innerHTML = "";
        var old_password = $('#old_password').val();
        var gmail_change = $('#gmail_change').val();
        var new_password = $('#new_password').val();
        var Status = $('#status').text();
        var str = document.getElementById("new_password").value;
        var confirm_password = $('#confirm_password').val();
        var s = 0;
        if (old_password == "") {
            $('#AlertInfo_mail').css('display', 'block');
            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter Old Password";
            s = 1;
            $('#AlertInfo_mail').fadeOut(5000, function () {

            });

        } else if (gmail_change == "") {
            $('#AlertInfo_mail').css('display', 'block');
            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter your Email id";
            s = 1;
            $('#AlertInfo_mail').fadeOut(5000, function () {

            });

        }
        else if (new_password == "") {
            $('#AlertInfo_mail').css('display', 'block');
            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter New Password";
            s = 1;
            $('#AlertInfo_mail').fadeOut(5000, function () {

            });

        }
        else if (confirm_password == "") {
            $('#AlertInfo_mail').css('display', 'block');
            document.getElementById('AlertInfo_mail').innerHTML = "Please Enter Confirm Password";
            s = 1;
            $('#AlertInfo_mail').fadeOut(5000, function () {

            });

        }
        else if (new_password != "") {

            if (str.match(/[a-z]/g) && str.match(/[A-Z]/g) && str.match(/[0-9]/g) && str.match(/[^a-zA-Z\d]/g) && str.length >= 8) {
                s = 0;
                //  alert("Your Password is Strong")
            }


            else {
                alert("Your  Password should be [Minimum 8 characters which contain at least one lowercase letter, one uppercase letter, one numeric digit, and one special character]");
                s = 1;
            }

        } else if (confirm_password != new_password) {
            $('#AlertInfo_mail').css('display', 'block');
            document.getElementById('AlertInfo_mail').innerHTML = "New Password and Confirm Password not matched";
            s = 1;
            $('#AlertInfo_mail').fadeOut(5000, function () {
            });

        }

        else if (clientCaptcha == "") {
            s = 1;
            $('#status').text("Please Enter  Captcha");
            $('#clientCaptcha').focus();
        }
        else if (new_password == old_password) {
            $('#AlertInfo_mail').css('display', 'block');
            document.getElementById('AlertInfo_mail').innerHTML = "Old Password and New Password Same Please Change";
            s = 1;
            $('#AlertInfo_mail').fadeOut(5000, function () {

            });
        } else if (Status == "Captch process is Succesfully") {

            s = 0;
        }
        else if (Status == "Not Matched") {
            s = 1;
            $('#clientCaptcha').focus();

        }

        



        if (s == 0) {
            var obj = {};


         // $('#Verifiedornot').val(new_password);
            obj.Password = new_password;
            //  obj.DepartmentName = old_password;
            obj.Email = gmail_change;

            //var randomnumber = $('#randomnumber').text();
            var new_hashText = CryptoJS.SHA256(new_password);

          //  var new_Compound = randomnumber.concat(new_hashText);

            //var new_Complex = CryptoJS.SHA256(new_Compound);

            $('#new_password').val(new_hashText);

            var old_hashText = CryptoJS.SHA256(old_password);
            $('#Verifiedornot').val(old_password);

           // var old_Compound = randomnumber.concat(old_hashText);

          //  var old_Complex = CryptoJS.SHA256(old_Compound);
            $('#old_password').val(old_hashText);


            var confirm_hashText = CryptoJS.SHA256(confirm_password);

            $('#confirm_password').val(confirm_hashText);

            if (new_hashText == old_hashText) {
                $('#AlertInfo_mail').css('display', 'block');
                document.getElementById('AlertInfo_mail').innerHTML = "Old Password and NewPassword Matched";
                s = 1;
                $('#AlertInfo_mail').fadeOut(5000, function () {

                });
            } else {

                $('#Change_btn').click();

            }

        }

    }
    $('input[type=email]').bind("cut copy paste", function (e) {
        e.preventDefault();
    })
    $('input[type=password]').bind("cut copy paste", function (e) {
        e.preventDefault();
    })
    $(".toggle-password").click(function () {
        $(this).toggleClass("fa-eye fa-eye-slash");
        var input = $($(this).attr("toggle"));
        if (input.attr("type") == "password") {
            input.attr("type", "text");
        } else {
            input.attr("type", "password");
        }
    });
    // captch code here
    $(function () {
        $("#btnSubmit").click(function () {
            ChangePassword();
        });
    });

    var s = 0;
    var CapchaInfo = "";

    function CheckPasswordStrength(password) {

        var password_strength = document.getElementById("password_strength");

        //TextBox left blank.
        if (password.length == 0) {
            password_strength.innerHTML = "";
            return;
        }

        //Regular Expressions.
        var regex = new Array();
        regex.push("[A-Z]"); //Uppercase Alphabet.
        regex.push("[a-z]"); //Lowercase Alphabet.
        regex.push("[0-9]"); //Digit.
        regex.push("[$@@$!%*#?&]"); //Special Character.

        var passed = 0;

        //Validate for each Regular Expression.
        for (var i = 0; i < regex.length; i++) {
            if (new RegExp(regex[i]).test(password)) {
                passed++;
            }
        }

        //Display status.
        var color = "";
        var strength = "";
        switch (passed) {
            case 0:
            case 1:
            case 2:
                strength = "Weak";
                color = "red";
                break;
            case 3:
                strength = "Medium";
                color = "orange";
                break;
            case 4:
                strength = "Strong";
                color = "green";
                break;

        }
        password_strength.innerHTML = strength;
        password_strength.style.color = color;

        if (passed <= 2) {
            document.getElementById('show').disabled = true;
        } else {
            document.getElementById('show').disabled = false;
        }

    }
</script>

