<title>Feedback</title>
<style>
    .hpanel .panel-body {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        padding: 20px;
        position: relative;
        border: 2px solid #337ab7;
        border-top: 2px solid #337ab7;
    }

    .refreshicon {
        position: relative;
        /* right: 21px; */
        top: -39px;
        left: 91px;
    }

    .highlight {
        color: red;
    }



    .hpanel {
        border: none !important;
        box-shadow: none;
        margin-bottom: 25px;
    }

    .feedback_table tbody tr td {
        padding: 10px 0px;
    }

    .td_graph {
        width: 20px;
    }

    .text_span {
        color: #000;
        font-weight: bold;
        font-size: 15px;
    }

    .red_band {
        color: red;
    }

    .requrid_star {
        color: red;
    }

    .font-16 {
        font-size: 16px;
    }

    .chk, .chk1, .chk2, .chk3, .chk4, .chk5, .chk6, .chk7, .chk8 {
        width: 25px;
        height: 25px;
        vertical-align: middle;
    }

    .check-font {
        font-size: 14px;
        vertical-align: middle;
        padding-left: 5px;
    }

    .width-17 {
        width: 118%;
    }

    @@media (max-width: 767px) {
        .container, .wrapper.boxed-layout, .wrapper.box-layout {
            width: 350px;
        }
    }
</style>

<div class="ss">
