    function Search_Info() {
        var reg = $("#registration_no").val();
       
        $.ajax({
            url: '/Contact/registration_selection',
            type: 'GET',
            data: { REG: reg },
            dataType: 'json',
            contentType: 'application/json',

            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }

                if (data != null) {

                    $('#p_training_name').val(data.p_training_name);
                    $('#participant_name').val(data.p_name);
                    $('#level_event').val(data.level_event);
                    $('#level_event_dist').val(data.district);
                    $('#level_event_block').val(data.block);
                    $('#event_platform').val(data.event_platform);
                    var date1 = $('#from_date').val(data.from_date);
                    var date2 = $('#to_date').val(data.to_date);

                    var fromdate = $('#from_date').val();
                    var todate = $('#to_date').val();

                    var dt1 = new Date(fromdate);      //for total no. of days count
                    var dt2 = new Date(todate);

                    var diff = dt2.getTime() - dt1.getTime();

                    var days_diff = [diff / (1000 * 3600 * 24)];
                    var iNum = parseInt(days_diff)
                    var DAY_DIFF = iNum + 1;            // add 1 bcz of last day is also count for registration
                    $('#total_days').val(DAY_DIFF);


                }

            },
            error:
                function (response) {
                    console.dir(response)
                    //alert("Error: " + response);
                }
        });
    }

