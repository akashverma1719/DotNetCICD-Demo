    function calculatesum() {
        debugger;
        document.getElementById('Very Beneficial_27-34').checked = false;
        document.getElementById('Beneficial_18-26').checked = false;
        document.getElementById('Less Beneficial_9-17').checked = false;
        document.getElementById('Not Beneficial_1-8').checked = false;
        var classesToCheck = ['chk', 'chk1', 'chk2', 'chk3', 'chk4', 'chk5', 'chk6'];
        for (let className of classesToCheck) {
            if ($('input[class="' + className + '"]:checked').length === 0) {
                $(".loader").hide();
                return;
            }
        }
        let structure_of_training = 0;
        let course_material = 0;
        let interaction_with_trainer = 0;
        let hands_on_practice = 0;
        let usefulness_of_contents = 0;
        let information_presented = 0;
        let participant_questions = 0;
        let food_quality = 0;

        $('.chkAll').each(function () {
            let li = $(this).find('td');
            li.each(function () {
                let input = $(this).find('input[type=checkbox], select');

                if (input.prop('checked')) {
                    let id = input.attr("id");
                    let name = input.attr("name");
                    let splitArray = id.split('_');
                    let value = parseInt(splitArray[1]) || 0;  // Ensure conversion to number

                    switch (name) {
                        case "structure_of_training":
                            structure_of_training = value;
                            break;
                        case "course_material":
                            course_material = value;
                            break;
                        case "interaction_with_trainer":
                            interaction_with_trainer = value;
                            break;
                        case "hands_on_practice":
                            hands_on_practice = value;
                            break;
                        case "usefulness_of_contents":
                            usefulness_of_contents = value;
                            break;
                        case "information_presented":
                            information_presented = value;
                            break;
                        case "participant_questions":
                            participant_questions = value;
                            break;
                        case "food_quality":
                            food_quality = value;
                            break;
                    }
                }
            });
        });
        let total = structure_of_training + course_material + interaction_with_trainer + hands_on_practice + usefulness_of_contents + information_presented + participant_questions + food_quality;
        debugger;

        if (total >= 27 && total <= 34) {
            document.getElementById('Very Beneficial_27-34').checked = true;
        }
        else if (total >= 18 && total <= 26) {
            document.getElementById('Beneficial_18-26').checked = true;
        }
        else if (total >= 9 && total <= 17) {
            document.getElementById('Less Beneficial_9-17').checked = true;
        }
        else if (total >= 1 && total <= 8) {
            document.getElementById('Not Beneficial_1-8').checked = true;
        }
    }


</script>
