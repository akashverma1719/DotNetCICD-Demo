                                                        </div>
                                                    </td>
                                                    @*<td>

                                                        </td>*@
                                                </tr>


                                                <tr>
                                                    <td class="text_span" style="padding-left: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Topic Of Training : </td>
