                                                    <td class="text_span" style=" white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Name of the Participant : </td>
                                                    <td colspan="2"><input type="text" onpaste="return false;" id="participant_name" name="participant_name" class="form-control alpha" readonly /></td>

                                                </tr>
                                                <tr>
                                                    <td class="text_span">  State (Training) : </td>
                                                    <td colspan="2"><input type="text" onpaste="return false;" id="level_event" class="form-control alphanum" readonly /></td>
                                                    <td class="text_span" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">District (Training) : </td>
                                                    <td colspan="2"><input type="text" onpaste="return false;" id="level_event_dist" name="participant_name" class="form-control alpha" readonly /></td>

                                                </tr>
                                                <tr>
                                                    <td class="text_span">  Block (Training): </td>
