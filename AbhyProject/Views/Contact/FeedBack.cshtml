                                                    <td class="text_span" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Event Platform : </td>
                                                    <td colspan="2"><input type="text" onpaste="return false;" id="event_platform" name="event_platform" class="form-control alpha" readonly /></td>

                                                </tr>
                                                <tr>
