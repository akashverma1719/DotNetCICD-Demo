        function WSPDownload() {


            var State = $("#cntry").val();
            var Dist = $("#District").val();
            var Block = $("#Block").val();
            var Gram = $("#Gram").val();

            if (State === "0" || State === "--Select State--" || State === "All") {
                alert("Please select a State");
                return false; // Prevent further execution
            }

            else {

                $('#loader').show();
                let url;
                url = "/mapview/WSP_Excel_combined";


                $.ajax({
                    type: "GET",
                    url: `${url}`,
                    contentType: "application/json; charset=utf-8",
                    //data: `{"State" : '${State}',"District": '${Dist}', "Block" : '${Block}', "Gram": '${Gram}', "Module_name" : '1.1', "Year" : '${Year}'}`,
                    data: {
                        "State": `${State}`,
                        "Dist": `${Dist}`,
                        "Block": `${Block}`,
                        "Gram": `${Gram}`,
                    },
                    success: function (Rdata) {
                        console.log(Rdata);
                        console.log('success');
                        if (Rdata !== null) {
                            console.log('robj');
                            if (Rdata.hasOwnProperty('robj')) {
                                console.log('ds');
                                console.log(Rdata.robj.FileContents)
                                var bytes = new Uint8Array(Rdata.robj.FileContents);
                                var blob = new Blob([bytes], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                                var link = document.createElement('a');
                                link.href = window.URL.createObjectURL(blob);
                                link.download = Rdata.robj.FileDownloadName;
                                link.click();
                                $('.loadera').hide();
                                //$('#myModal').attr('data-backdrop', 'false');
                            }
                            else {
                                var bytes = new Uint8Array(Rdata.FileContents);
                                var blob = new Blob([bytes], {
                                    type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                                });
                                var link = document.createElement('a');
                                link.href = window.URL.createObjectURL(blob);
                                link.download = Rdata.FileDownloadName;
                                link.click();



                            }
                        } else {
                            alert("No data found.");
                        }
                        $('#loader').hide();
                    },
                    error: function (err) {

                    }

                });

            }
        }
    </script>


