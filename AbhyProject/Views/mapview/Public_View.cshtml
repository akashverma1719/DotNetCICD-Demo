    <script>
        function extractValue(str) {
            // Use a regular expression to extract the substring after ':'
            const match = str.match(/:(.*)/);
            return match ? match[1].trim() : ''; // Extract the substring and trim any leading/trailing whitespaces
        }

        function exportToCSV() {
            // Get values dynamically from your HTML
            const gpe = extractValue(document.getElementById('infoPanelTitleg').innerText);
            const blocke = extractValue(document.getElementById('infoPanelContentg').innerText);
            const diste = extractValue(document.getElementById('infoPanelContentg1').innerText);
            const statee = extractValue(document.getElementById('infoPanelContentg2').innerText);
            const gpae = extractValue(document.getElementById('infoPanelContentg3').innerText);
            const bloce = extractValue(document.getElementById('infoPanelContentg4').innerText);
            const villne = extractValue(document.getElementById('infoPanelContentg5').innerText);
            const villce = extractValue(document.getElementById('infoPanelContentg6').innerText);
            const wle = extractValue(document.getElementById('infoPanelCount1').innerText);
            const wqe = extractValue(document.getElementById('infoPanelCount2').innerText);
            const welle = extractValue(document.getElementById('infoPanelCount3').innerText);
            const arse = extractValue(document.getElementById('infoPanelCount4').innerText);
            const rge = extractValue(document.getElementById('infoPanelCount5').innerText);
            const wfe = extractValue(document.getElementById('infoPanelCount6').innerText);


            // Create an array with headers and values
            const data = [
                ['Gram Panchayat', 'Block', 'District', 'State', 'GP Area', 'Block Area',
                    'Village Name', 'Total Village', 'Water Level Observation Well', 'Water Quality Observation Well',
                    'Well', 'ARS and WCS', 'Rainguage', 'Water Flow Meter'],
                [gpe, blocke, diste, statee, gpae, bloce, villne, villce, wle, wqe, welle, arse, rge, wfe]

            ];

            const ws = XLSX.utils.aoa_to_sheet(data);

            // Generate the CSV content
            const csv = XLSX.utils.sheet_to_csv(ws);

            // Create a Blob containing the CSV data
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });

            // Create a download link and trigger a click to download the file
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Gram Panchayat Summary.csv';
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
