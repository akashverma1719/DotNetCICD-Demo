    <script>
        $(document).ready(function () {
            $('#toggleButtonfeed').click(function () {
                $('#popupfeed').toggle();
                $('#mapInfo').hide();
            });

            $('#togglemapInfo').click(function () {
                $('#mapInfo').toggle();
                $('#popupfeed').hide();
            });

            $('#openLayerListData').click(function () {
                $('#dataPopup').toggle();
            });

            $('#popupfeed .close').click(function () {
                $('#popupfeed').hide();
            });

            $('#mapInfo .close').click(function () {
                $('#mapInfo').hide();
            });

            $('#dataPopup .close').click(function () {
                $('#dataPopup').hide();
            });

            // Star hover event (to handle visual feedback on hover)
            $('.star').hover(function () {
                $(this).addClass('hovered'); // Add 'hovered' class to the hovered star and its preceding stars
                $(this).prevAll().addClass('hovered');
            }, function () {
                $(this).removeClass('hovered'); // Remove 'hovered' class on mouseout
                $(this).prevAll().removeClass('hovered');
            });

            // Star click event (to set the rating)
            $('.star').click(function () {
                var value = parseInt($(this).attr('data-value'));
                $('#rating').val(value); // Set the numeric rating value to the hidden input field

                // Remove 'active' class from all stars
                $('.star').removeClass('active');

                // Add 'active' class to the clicked star and its preceding stars
                $(this).addClass('active').prevAll().addClass('active');
            });

            // Reset button click event
            $('#resetRating').click(function () {
                $('#rating').val(0); // Reset the rating value to 0
                $('.star').removeClass('active'); // Remove 'active' class from all stars
                $('#comment').val("");
            });


            // Update button click event (to submit the feedback)
            $('#updateButton').click(function () {
                var comment_section = $('#comment').val().trim();
                var rating = parseInt($('#rating').val());

                if (comment_section === "") {
                    alert("Please provide a comment");
                    $('#comment').focus();
                    return;
                }

                if (comment_section.length > 100) {
                    alert("Comment should not exceed 100 characters");
                    return;
                }
                // Make AJAX call to update feedbacktttttt
                $.ajax({
                    type: "POST",
                    url: "/mapview/UpdateFeedback",
                    data: JSON.stringify({ comment_section: comment_section, rating: rating }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        // Check if the response contains a success flag
                        alert(response);
                        if (response == "Feedback saved successfully") {
                            $('#comment').val("");
                            $('#rating').val(0);
                            $('.star').removeClass('active'); // Clear star ratingsww
                        }
                    },
                    error: function (xhr, status, error) {
                        // Display error message
                        alert('Error updating feedback: ' + error);
                    }
                });
            });
            $('#popupfeed').hide();
        });

