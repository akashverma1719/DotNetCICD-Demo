    <style>
        .d-none {
            display: none !important;
        }

        .last-updated {
            padding: 0px 20px;
        }

            .last-updated p {
                color: #fff;
                font-size: 12px;
                font-weight: 400;
                font-family: 'Avenir Next';
            }


        .esri-widget--button {
            background-color: #004592;
            color: #ffffff;
        }

        .graphCont {
            height: 270px;
        }

        .popup {
            height: 400px !important;
        }

        label {
            margin-bottom: 0px;
            font-weight: 500;
            color: #000;
        }

        .mapview-marquee {
            display: flex;
            color: #fff;
            background: #004592;
            padding: 8px;
            font-size: 15px;
            font-weight: 500;
            z-index: 999;
            position: relative;
        }

        table {
            width: 100%;
        }

            table th {
                border-bottom-width: 2px;
                background: #004592;
                color: #ffff;
                font-size: 15px;
                font-weight: 600;
                text-align: center;
            }



        #rainfall_id {
            color: #fff;
            border-radius: 6px;
            margin-top: 10px;
            margin-right: 10px;
            padding: 5px 11px;
            border: unset;
        }

        #flow_id {
            color: #fff;
            border-radius: 6px;
            margin-top: 10px;
            margin-right: 10px;
            margin-right: 10px;
            padding: 5px 11px;
            border: unset;
        }


        .esri-legend__group-layer-child {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        h3.esri-widget__heading {
            margin-bottom: 0px;
        }

        .esri-legend__layer-table--size-ramp {
            margin-bottom: 0px;
        }

        #map_data {
            font-size: 12px;
            width: 36px;
            height: 36px;
            background-color: #fff !important;
            border: 1px solid #f1f1f1;
            border-radius: 3px;
            padding: 4px 8px;
            cursor: pointer;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        }

            #map_data i {
                color: #000;
            }

        #map_data_off {
            position: absolute;
            font-size: 12px;
            width: 36px;
            height: 36px;
            background-color: #fff !important;
            border: 1px solid #f1f1f1;
            border-radius: 3px;
            padding: 4px 8px;
            cursor: pointer;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        }

            #map_data_off i {
                color: #000;
            }

        .map-hover-btn,
        .map-hover-btn-off {
            position: fixed;
            top: calc(5.8vw + 47px);
            right: 65px;
            z-index: 999;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: row-reverse;
            column-gap: 10px;
        }


            .map-hover-btn button {
                background-color: #004592 !important;
                padding: 10px;
            }

            .map-hover-btn::after {
                content: "Will work on the open Data Point Layer";
                position: absolute;
                top: calc(100% + 5px);
                left: 80%;
                width: 138px;
                transform: translateX(-50%);
                background-color: rgba(0, 0, 0, 0.7);
                color: white;
                padding: 5px 10px;
                border-radius: 5px;
                font-size: 12px;
                white-space: nowrap;
                opacity: 0;
                transition: opacity 0.3s ease;
                word-wrap: break-word;
                text-wrap: wrap;
            }

            .map-hover-btn:hover::after {
                opacity: 1; /* Show the tooltip on hover */
            }
    </style>
</head>

