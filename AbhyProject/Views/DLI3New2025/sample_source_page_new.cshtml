    function Delete(ss) {
        if (confirm("Do You want to delete?")) {
            $('.loader').show();
            var obj = {};
            obj.id = ss;
            $.ajax({
                type: "POST",
                contentType: "application/json;charset=utf-8",
                url: "/DLI3New2025/Delete_data_upload",
                data: "{'Data': '" + JSON.stringify(obj) + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                        window.location = "/Home/LogOut";
                    }
                    else if (response == "Deleted Successfully") {
                        Data_get();
                    }
                }
            });
        }
    }
    function Update(id, i) {

        $('.loader').show();
        var xx = 0;
        var id = id;

        var state = $('#state' + i).val();
        var district = $('#district' + i).val();
        var description = $('#description' + i).val();
        var mom_filename = $('#image' + i).get(0);
        var mom_filename_files = mom_filename.files;
        const oFile = document.getElementById("image" + i).files[0];
        if (oFile != undefined) {
            if (oFile.size > 2097152) // 10 MiB for bytes.
            {
                alert("Upload Document File size must be less than 2 MB");
                return;
            }
        }

        if (xx == 0) {
            $.ajax({
                url: '/DLI3New2025/Update_upload',
                type: "POST",
                data: function () {

                    var data = new FormData();
                    data.append("id", id);
                    data.append("state", state);
                    data.append("dist", district);
                    data.append("description", description);
                    data.append("image", mom_filename_files[0]);
                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                          window.location = "/Home/LogOut";
                    }
                    else if (response == "Successfully Update") {
                        Data_get();
                    }
                    else if (response == "Please select valid file") {
                        $('.loader').hide();
                    }
                     else if (response == "Your Upload file has Double Extention, Please Upload proper file") {
                        $('.loader').hide();
                    }
                    else if (response == "Please use the proper file name without special characters (# , $) .") {
                        $('.loader').hide();
                    }

                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                }
            });
        }
    }
