<script>

    var StateOfficer = "";
    var State = "0";
    var Dist = "0";
    var Block = "0";
    var Gram = "0";
    var off_1 = "";
    var state = '';
    $(document).ready(function () {

        $(".hide_div").hide();
        StateOfficer = '@Session["Officer"]';
        state = '@Session["gstate"]';
         if (StateOfficer == "Gram Panchyat Nodal Officer") {
               window.location = "/Home/LogOut";
             $(".entryfoam").hide();

        }
         if (StateOfficer == "District Level Nodal Officer") {
             $(".entryfoam").show();
             $(".hide_div").hide();
        }
         if (StateOfficer == "State Level Nodal Officer") {
             $(".entryfoam").hide();
             $(".hide_div").hide();


        }
        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
            $(".entryfoam").hide();
            $(".hide_div").hide();

        }

        divhideshow();
        DropDownInfo();

        //$('#myModal').modal('show');
    });

    function divhideshow() {

        var phase = $("#phase").val();
        if (StateOfficer == "District Level Nodal Officer") {
            if (phase == "phase1") {
                $("#uploadtext").text("Upload Document " + phase)
                $(".entryfoam").show();
                Data_get();
            }
            if (phase == "phase2") {
                $("#uploadtext").text("Upload Document " + phase)
                $(".entryfoam").show();
                Data_get();
            }
            if (phase == "Left Over phase 1") {
                $("#uploadtext").text("Upload Document " + phase)
                $(".entryfoam").show();
                Data_get();
            }
            else {
                $("#uploadtext").text("Upload Document " + phase)
                if (State == "Haryana_6" || State == "Karnataka_29" || State == "Madhya Pradesh_23" || State == "Maharashtra_27" || State == "Gujarat_24" || State == "Rajasthan_8" || State == "Uttar Pradesh_9") {
                    $('.entryfoam').show();
                    Data_get();
            }
            else {
                    $('.entryfoam').show();
                    Data_get();
            }
           //     $(".entryfoam").show();

            }
        }
        else {
            $(".entryfoam").hide();
            Data_get();
        }

    }
    function DropDownInfo() {

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Home/Sign_Up_DropdownInfo",
            data: "{ }",
            dataType: 'JSON',
            success: function (response) {

                if (response.length != 0) {
                    Jsondata = response;
                    $("#spnstate").empty();
                    var opstate = '<option value="0">Select StateName</option>';
                    $("#spnstate").append(opstate);
                    $("#dist11").empty();
                    var opdist = '<option value="0">Select District</option>';
                    $("#dist11").append(opdist);
                    $("#block1").empty();
                    var opblock = '<option value="0">Select Block</option>';
                    $("#block1").append(opblock);
                    $("#gram").empty();
                    var opgram = '<option value="0">Select GramPanchayat</option>';
                    $("#gram").append(opgram);
                    //var StateName = $("#spnstate").text();
                    if (Jsondata.length != 0) {
                        var ddlst = {};
                        var all_dists = [];
                        var optionState = '';

                        for (var i = 0; i < Jsondata.length; i++) {

                            if (!ddlst[Jsondata[i].state_name]) {
                                all_dists.push(Jsondata[i].state_name);
                                ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                            }
                        }
                        var DistArray = [];
                        DistArray = all_dists.sort(function (a, b) {
                            if (a < b) return -1;
