                                    tr += '<tr id="AWP1_TR_new' + i + '"><td>' + (sno) + '</td><td>' + data[i].phase + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].description + '</td><td><a href="' + data[i].image_path + '" download=""> ' + data[i].image_name + '</a></td><td><label style="color: black;">Not Applicable</label></td><td><label style="color: black;">Not Applicable</label></td><td></td><td></td><td><label style="color: Black;">At DPMU</label></td></tr> ';

                                }
                            }

                        }

                    }
                    $('#tbl_details').html(tr);
                    if (State == "Haryana_6") {
                        $('.hidebutton').show();
                    }
                    else {
                        $('.hidebutton').hide();
                    }
                    


                }
                $('.loader').hide();

            }
        });
    }
