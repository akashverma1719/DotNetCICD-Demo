    function Insert_data() {

        $('.loader').show();
        var xx = 0;
        var state = State;
        var dist = Dist;
        var description = $('#to_date').val();
        var phase = $('#phase').val();
        var mom_filename = $('#upload_module').get(0);
        var mom_filename1 = $('#upload_module').val();
        var mom_filename_files = mom_filename.files;

        if (State == "0") {
            alert("Please Select State Name");
            $('.loader').hide();
            return false;
        } else if (Dist == "0") {
            alert("Please Select District Name");
            $('.loader').hide();
            return false;
        } else if (description == "") {
            alert("Please Enter Description");
            $('.loader').hide();
            return false;
        }
        else if (mom_filename1 == "") {
            alert("Please Select Upload Document");
            $('.loader').hide();
            return false;
        }
        const oFile = document.getElementById("upload_module").files[0];
        if (oFile != undefined) {
            if (oFile.size > 2097152) // 10 MiB for bytes.
            {
                alert("Upload Document File size must be less than 2 MB");
                return;
            }
        }

        if (xx == 0) {
            if (confirm("Are you sure you want to save data.")) {
            $.ajax({
                url: "/DLI3New2025/Save_data",
                type: "POST",
                data: function () {

                    var data = new FormData();
                    data.append("state", state);
                    data.append("dist", dist);
                    data.append("description", description);
                    data.append("phase", phase);
                    data.append("image", mom_filename_files[0]);
                    return data;
                }(),
                contentType: false,
                processData: false,
                success: function (response) {
                    alert(response);
                    if (response == "Logout") {
                          window.location = "/Home/LogOut";
                    }
                    else if (response == "Successfully Saved") {
                        Data_get();
                        $('#to_date').val("");
                        $('#upload_module').val("");
                    }
                    else if (response == "Please select valid file") {
                        $('.loader').hide();
                    }
                    else if (response == "Your Upload file has Double Extention, Please Upload proper file") {
                        $('.loader').hide();
                    }
                    else if (response == "Please use the proper file name without special characters (# , $) .") {
                        $('.loader').hide();
                    }
                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log(errorMessage);
                }
            });
            }

            else {
                $('.loader').hide();
            }
        }


    }
