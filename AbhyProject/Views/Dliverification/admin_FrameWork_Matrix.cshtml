<script>
    var Session_StateName = "";
    var Access_Auth = '';
    $(document).ready(function () {
        
        Access_Auth = '@Session["Access_Auth"]';
        if (Access_Auth == 'readonly') {
            $('.btn_disabled').prop("disabled", true);
        }
        $('#State_Dropdown_value').hide();
        $('#State_Value').hide();
        Session_StateName = '@Session["gstate"]';
        if (Session_StateName == "0") {

            $('#State_Dropdown_value').show();
            $('#State_Value').hide();
        }
       else if (Session_StateName == "") {

            $('#State_Dropdown_value').show();
            $('#State_Value').hide();
        }
        else {
            $('#State_Dropdown_value').hide();
            $('#State_Value').show();
            admin_framematrix();
            Dli_1_Details();
            Dli_2_Details();
            Total_Population_of_the_GP_Info();
            //Socio_economic_demographic_profile_Info();
            //vwms_Info();
            //baselinedata_geting();
            Dli_4_Details();
            Dli_5_Details();
        }


    });


    $("#State_Dropdownvalue").change(function () {

        $('.loader').show();
        
        var Session_StateName1 = $("#State_Dropdownvalue").val();
        if (Session_StateName1 != "0") {
            $('#spnstate').text(Session_StateName);
            Session_StateName = Session_StateName1;
            admin_framematrix();
            Dli_1_Details();
            Dli_2_Details();
            Total_Population_of_the_GP_Info();
           // Socio_economic_demographic_profile_Info();
            //vwms_Info();
            //baselinedata_geting();
            Dli_4_Details();
            Dli_5_Details();
        }
        else {
            alert("Please Select Statename");
        }
    });

    function Download_StateInfo() {
        var Session_StateName1 = $("#State_Dropdownvalue").val();
        if (Session_StateName1 != "0") {
            window.location = "/Dliverification/Export_admin_FrameWork_Matrix_ToExcel";
        } else {
            alert("Please Select Statename")

        }

    }

</script>

