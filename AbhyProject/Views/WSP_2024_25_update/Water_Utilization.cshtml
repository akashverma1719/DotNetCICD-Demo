    }

    .tabcontent label {
        font-weight: 600;
        font-size: 24px;
        margin-bottom: 7px;
        position: relative;
        background: #337ab7;
        display: block;
        color: #fff;
        padding: 6px;
    }

    @@media (min-width: 992px) {
        .Sider_column {
            width: 23%;
        }
