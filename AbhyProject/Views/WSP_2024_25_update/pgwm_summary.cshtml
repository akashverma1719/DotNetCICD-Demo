    function report_getting() {
        
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/GplevelMobileData/social_report_getting',
            data: '',
            //data: { 'state': State, 'dist': Dist, 'block': Block, 'gram': Gram,'year': Year },
            //data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {
                

                $("#state_name").text(data[0].state);
                $("#district_name").text(data[0].district);
                $("#block_name").text(data[0].block);
                $("#gram_panchayat_name").text(data[0].grampanchayat);


                if (data[0].length != 0) {



                } else {

                    $('#state_name').text('');
                    $('#district_name').text('');
                    $('#block_name').text('');
                    $('#gram_panchayat_name').text('');

                }
            }
        });

        sarpanch_getting();

    }


    function sarpanch_getting() {
        
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSP_2024_25_update/Getting_abhy_wsp_pgwm_committee_member',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                      window.location = "/Home/LogOut";

                }
                var tr = '';
