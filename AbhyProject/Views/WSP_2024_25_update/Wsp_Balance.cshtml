<script>
    var access_auth = '';
    $(document).ready(function () {
        access_auth = '@Session["access_auth"]';

        $('[data-toggle="tooltip"]').tooltip();
    });
    $(document).ready(function () {
        $('[data-toggle="tooltip1"]').tooltip();
    });


</script>


<script>
    var StateOfficer = '';
    $(document).ready(function () {
        get_approved_status_balance();
        $('#Wsp_gram_submit').hide();
        $('#Wsp_gram_checkbox').hide();
        
        StateOfficer = '@Session["Officer"]';
        if (StateOfficer != "Gram Panchyat Nodal Officer") {
            $('input[type=text]').prop("disabled", true)
            $('select').prop("disabled", true);
            $('input[type=file]').prop("disabled", true)
            $('.btn_disabled').prop("disabled", true);
        }
         else if (StateOfficer != "" && StateOfficer != null) {

        } else {
              window.location = "/Home/LogOut";
        }
        AutoSavedData();
    });

    function AutoSavedData() {
        if (StateOfficer == "Gram Panchyat Nodal Officer") {
            $(".loader").show();
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/WSP_2024_25_update/WaterBalanceAutoSaved",
                data: "",
                dataType: 'JSON',
                success: function (response) {
                    if (response == "1") {
                        $(".loader").hide();
                        alert("You didn't saved the data, Please click on save button in Water Availability");
                        window.location = "/WSP_2024_25_update/Wsp_Water_Availability";
                    } else if (response == "2") {
                        $(".loader").hide();
                        alert("You didn't saved the data, Please click on save button in Drinking/Domestic");
                        window.location = "/WSP_2024_25_update/Water_Utilization";
                    } else if (response == "3") {
                        $(".loader").hide();
                        alert("You didn't saved the data, Please click on save button in Irrigation");
                        window.location = "/WSP_2024_25_update/Water_Utilization";
                    }
                }
            });
        } else {
            $(".loader").hide();
        }
        Info();
    }
    function checkDataSavedorNot() {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WSP_2024_25_update/Check_WaterBalance_Data",
            dataType: 'JSON',
            success: function (response) {
                if (response.result == true) {
                    window.location = "Balance_Report", "WSP_2024_25_update"
                } else {
                    alert(response)
                }
            }
        });

    }
</script>




