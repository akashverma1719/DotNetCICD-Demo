                        <a href="~/WSP_2024_25_update/Wsp_Balance" class="btn btn-dark">
                            Back
                        </a>
                        @*<button class="btn btn-success download1" onclick="ReportPdf()" id="download">Download</button>*@
                        <a href="~/WSP_2024_25_update/Water_Budget" class="btn btn-primary">
