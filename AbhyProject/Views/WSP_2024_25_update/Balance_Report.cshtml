<script src="https://rawgit.com/eKoopmans/html2pdf/master/dist/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.5.0-beta4/html2canvas.js" integrity="sha256-EzjZPP7sOCQ+ugF/U8x2VH3PEvg3NFjis/dpwogN3T0=" crossorigin="anonymous"></script>
<script type="text/javascript">

    function ReportPdf() {
        $("#Data1").width(1100);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'WaterbalanceReport.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A4', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('div.demandsidesupplyside_space1').addClass('demandsidesupplyside_space');
        $('div#btnExport').addClass('hideDownload');
        $('div#btnExport1').addClass('hideDownload');
        $('div.balnace_mater_space').addClass('balnace_mater_space1');
        $(".highcharts-credits").css("display", "none");
        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $('div.demandsidesupplyside_space1').removeClass('demandsidesupplyside_space');
            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
            $('div.balnace_mater_space').removeClass('balnace_mater_space1');
        }, 2000);
    }
</script>





<script>
    var total_avia = 0;
    var uti_tot = 0;
    var total_water_b = 0;
    $(document).ready(function () {

        Info();

    });

    function Info() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/WSP_2024_25_update/WaterBalanceData',
            data: '',
            dataType: 'JSON',
            success: function (response) {
                if (response == "Error") {
                    //window.location = "/WspNew/WspBalance";
                }
                if (response == "Logout") {
                      window.location = "/Home/LogOut";
                }

                if (response.length != 0) {
                    $('#wb_sw_avail').text(response.wb_sw_avail.toFixed(4));
                    $('#wb_gw_avail').text(response.wb_gw_avail.toFixed(4));
                    $('#wb_total_avail').text(response.wb_total_avail.toFixed(4));
                    $('#wb_gw_utili').text(response.wb_gw_utili.toFixed(4));
                    $('#wb_sw_utili').text(response.wb_sw_utili.toFixed(4));
                    $('#wb_total_utili').text(response.wb_total_utili.toFixed(4));
                    $('#wb_gw_balance').text(response.wb_gw_balance.toFixed(4));
                    $('#wb_sw_balance').text(response.wb_sw_balance.toFixed(4));
                    $('#wb_total_balance').text(response.wb_total_balance.toFixed(4));
                    total_avia = response.wb_total_avail.toFixed(4);
                    uti_tot = response.wb_total_utili.toFixed(4);
                    total_water_b = response.wb_total_balance.toFixed(4);
                    Charts();
                }
            }
        });
    }

    
    function Charts() {

        Highcharts.chart('container_balance_Report', {
            chart: {
                type: 'column'
            },
            title: {
                text: ' Water Balance (ha m)'
            },

            xAxis: {
                type: 'category'
            },
            yAxis: {
                title: {
                    text: '(ha m)'
                }

            },
            colors: [
                '#A0D468',
                '#ED5565',
                '#5D9CEC'

            ],
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.4f}',
                        crop: false,
                        overflow: 'none'
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.4f}</b><br />'
            },
            exporting: {
                buttons: {
                    contextButton: {
                        enabled: false
                    }
                }
            },
            series: [
                {
                    name: " Water Balance (ha m)",
                    colorByPoint: true,
                    data: [
                        {
                            name: "Total Water Availability (ha m)",
                            y: parseFloat(total_avia),

                        },
                        {
                            name: "Total Water Demand (ha m)",
                            y: parseFloat(uti_tot),

                        },
                        {
                            name: "Total Water Balance (ha m)",
                            y: parseFloat(total_water_b),

                        }
                    ]
                }
            ],

        });


    }



</script>

<script>
    var currentTime = new Date(),
        hours = currentTime.getHours(),
        minutes = currentTime.getMinutes();

    if (minutes < 10) {
        minutes = "0" + minutes;
    }

    var suffix = "AM";
    if (hours >= 12) {
        suffix = "PM";
        hours = hours - 12;
    }
    if (hours == 0) {
        hours = 12;
    }

    document.getElementById("demobalance2").innerHTML = hours + ":" + minutes + " " + suffix;
</script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd
    }

    if (mm < 10) {
        mm = '0' + mm
    }

    today = dd + '/ ' + mm + '/ ' + yyyy;
    document.getElementById("demobalance").innerHTML = today;
</script>