<body>
    <div class="container" id="Data1">
        <div class="row row_padding_10">
            <div class="col-md-12 ">
                <div class="firsttable col-md-12">
                    <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
                </div>

            </div>

            <div class="col-md-12 report_heading_div">
                <div class="col-md-9">
                    <h1>Water Balance Report </h1>

                </div>
                <div class="col-md-3 text-right" id="btnExport">
                    <button class="btn btn-success download1" onclick="ReportPdf()" id="download">Download</button>
                </div>
                <div class="col-md-12">
                    <ul class="dateandtime_ul">
                        <li>Date : <span id="demobalance"></span></li>
                        <li>Time : <span id="demobalance2"></span></li>
                        <li>
                            User Name :
                            @if (Session["UserName"] != null)
                            {
                                <span>@Session["UserName"].ToString()</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-md-12 state_dist_level">
                <div class="row" id="Select_dist_level">
                    <ul class="Select_option">
                        @if (Session["gstate"] != null && Session["gstate"].ToString() != "0" && Session["gstate"].ToString() != "")
                        {

                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                        {
                            <li>
                                <label id="lblstate">Admin</label>

                            </li>
                        }
                        else
                        {
                            <li>
                                <label id="lblstate">National Level Nodal Officer</label>

                            </li>
                        }


                        @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                        {
                            <li>

                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }

                        @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                        {
                            <li>

                                <label>Block:</label>
                                <span>@Session["gblock"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                        {
                            <li>

                                <label>Gram panchayat:</label>
                                <span>@Session["ggram"]</span>

                            </li>
                        }
                        @if (Session["Year"] != null && Session["Year"].ToString() != "null" && Session["Year"].ToString() != "")
                        {
                            <li>

                                <label>Year:</label>
                                <span id="Year">@Session["Year"]</span>

                            </li>
                        }
                        @if (Session["month"] != null && Session["month"].ToString() != "null" && Session["month"].ToString() != "")
                        {
                            <li>

                                <label>Month:</label>
                                <span id="month">@Session["month"]</span>

                            </li>
                        }

                    </ul>
                </div>
            </div>


            <div class="col-md-12">
                <div class="col-md-6">
                    <table class="table table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer balance_table_individual">
                        <thead>
                            <tr class="tableheader1 text-center">
                                <th colspan="3" style="padding-bottom:0px;" class="text-center">Water Balance</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <th style="background: #867197; color: #fff">A</th>
                                <th style="background: #867197; color: #fff">Water Availability (ha m)</th>
                                <td style="background: #867197; color: #fff"><span id=""></span></td>
                            </tr>

                            <tr>
                                <td style="text-align: center;">i)</td>
                                <td>Total Ground Water Available</td>
                                <td><span id="wb_gw_avail"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">ii)</td>
                                <td> Total Surface Water Available</td>
                                <td><span id="wb_sw_avail"></span></td>
                            </tr>
                            <tr>
                                <th class="tolat_report_color" style="text-align: center;"></th>
                                <th class="tolat_report_color">Total Water Availability (ha m)</th>
                                <td><span id="wb_total_avail"></span></td>
                            </tr>
                            <tr>
                                <th style="background: #867197; color: #fff">B</th>
                                <th style="background: #867197; color: #fff">Water Demand (ha m)</th>
                                <td style="background: #867197; color: #fff"><span id=""></span></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">i)</td>
                                <td>Total Ground Water Demand</td>
                                <td><span id="wb_gw_utili"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">ii)</td>
                                <td>Total Surface Water Demand</td>
                                <td><span id="wb_sw_utili"></span></td>
                            </tr>

                            <tr>
                                <th class="tolat_report_color" style="text-align: center;"></th>
                                <th class="tolat_report_color">Total Water Demand </th>
                                <td><span id="wb_total_utili"></span></td>
                            </tr>
                            <tr>
                                <th style="background: #867197; color: #fff">C</th>
                                <th style="background: #867197; color: #fff">Balance [Surplus (+) / Deficit (-)] (ha m)</th>
                                <td style="background: #867197; color: #fff"><span id=""></span></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">i)</td>
                                <td>Total Ground Water Balance</td>
                                <td><span id="wb_gw_balance"></span></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">ii)</td>
                                <td>Total Surface Water Balance</td>
                                <td><span id="wb_sw_balance"></span></td>
                            </tr>

                            <tr>
                                <th class="tolat_report_color" style="text-align: center;"></th>
                                <th class="tolat_report_color">Total Water Balance </th>
                                <td><span id="wb_total_balance"></span></td>
                            </tr>
