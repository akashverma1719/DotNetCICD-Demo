                        }
                        if (data[i].gpimage3 != null && data[i].gpimage3 != "") {
                            var Aquifer_map_geting = '<label><a href="/WSP_2024_25_update/ViewFile?FileName=' + encodeURIComponent(data[i].gpimage3) + '" download="" target="_blank" >' + data[i].gpimage3_filename + '</a></label>';
