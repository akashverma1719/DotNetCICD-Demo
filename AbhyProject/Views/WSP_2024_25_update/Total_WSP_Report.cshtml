                    location.reload();
                }
            }
        });
    }

    function wsp_reject_status() {

        var x = 0;
        var gp_remarks = $('#gp_remarks').val();
        var wa_remarks = $('#wa_remarks').val();
        var wu_remarks = $('#wu_remarks').val();
        var wb_remarks = $('#wb_remarks').val();
        var wbu_remarks = $('#wbu_remarks').val();
        var ds_remarks = $('#ds_remarks').val();
        var ss_remarks = $('#ss_remarks').val();
        var pgwm_remarks = $('#pgwm_remarks').val();
        if (gp_remarks != '') {
            x = 1;
        }
        if (wa_remarks != '') {
            x = 1;
        }
        if (wu_remarks != '') {
            x = 1;
        }
        if (wb_remarks != '') {
            x = 1;
        }
        if (wbu_remarks != '') {
            x = 1;
        }
        if (ds_remarks != '') {
            x = 1;
        }
        if (ss_remarks != '') {
            x = 1;
        }
        if (pgwm_remarks != '') {
            x = 1;
        }

        if (x != 0) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/WSP_2024_25_update/wsp_reject_status",
