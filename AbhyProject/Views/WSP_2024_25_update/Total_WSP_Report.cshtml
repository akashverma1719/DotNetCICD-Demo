<body>

    <div class="loading-container">
        <div class="loader">
            <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
        </div>
    </div>
    <div class="container" id="Data1">
        <div class="row">
            <div class="col-md-12">
                <div class="firsttable col-md-12">
                    <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
                </div>
            </div>
        </div>
        <div class="row row_padding_10 justify-content-between">

            <div class="col-md-12 report_heading_div">
                <div class="row justify-content-between" style="justify-content: space-between; align-items: center; display: flex;">
                    <div class="col-md-6">
                        <h1>Water Security Plan Report </h1>

                    </div>
                    <div class="col-md-3 text-left" id="btnExport">
                        <button class="btn btn-success" id="download" onclick="ReportPdf();">Download</button>
                    </div>
                    <div class="col-md-3 text-right" id="wsp_approved">
                        <button id="bntWspApproved" class="btn btn-primary" onclick="ReportPdfUpload()">
                            Click Here For Upload WSP
                        </button>

                    </div>
                </div>


                <div class="col-md-12">
                    <ul class="dateandtime_ul">
                        <li>Date : <span id="demo"></span></li>
                        <li>Time : <span id="demo2"></span></li>
                        <li>
                            User Name :
                            @if (Session["UserName"] != null)
                            {
                                <span>@Session["UserName"].ToString()</span>
                            }
                        </li>
                    </ul>
                </div>

            </div>
            <div class="col-md-12 state_dist_level">
                <div class="row" id="Select_dist_level">
                    <ul class="Select_option">
                        @if (Session["gstate"] != null && Session["gstate"].ToString() != "null" && Session["gstate"].ToString() != "")
                        {

                            <li>
                                <label id="lblstate">State:</label>
                                <span id="spnstate">@Session["gstate"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        else if (Session["Officer"] != null && Session["Officer"].ToString() == "Admin")
                        {
                            <li>
                                <label id="lblstate">Admin</label>

                            </li>
                        }
                        else
                        {
                            <li>
                                <label id="lblstate">National Level Nodal Officer</label>

                            </li>
                        }


                        @if (Session["gdist"] != null && Session["gdist"].ToString() != "null" && Session["gdist"].ToString() != "")
                        {
                            <li>

                                <label id="lbldistrict">District:</label>
                                <span id="spndistrict">@Session["gdist"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }

                        @if (Session["gblock"] != null && Session["gblock"].ToString() != "null" && Session["gblock"].ToString() != "")
                        {
                            <li>

                                <label>Block:</label>
                                <span id="spnblock">@Session["gblock"]</span>
                                <i class="fas fa fa-angle-double-right"></i>
                            </li>
                        }
                        @if (Session["ggram"] != null && Session["ggram"].ToString() != "null" && Session["ggram"].ToString() != "")
                        {
                            <li>

                                <label>Gram panchayat:</label>
                                <span id="spngram">@Session["ggram"]</span>
                                <i class="fas fa fa-angle-double-right"></i>

                            </li>
                        }
                        @if (Session["Year"] != null && Session["Year"].ToString() != "null" && Session["Year"].ToString() != "")
                        {
                            <li>

                                <label>Year:</label>
                                <span id="Year">@Session["Year"]</span>
                                <i class="fas fa fa-angle-double-right"></i>

                            </li>
                        }
                        @if (Session["month"] != null && Session["month"].ToString() != "null" && Session["month"].ToString() != "")
                        {
                            <li>

                                <label>Month:</label>
                                <span id="month">@Session["month"]</span>

                            </li>
                        }


                    </ul>
                </div>

            </div>
            <div class="html2pdf__page-break"></div>
            <div class="page2el">
                <div class="gramReport_div_start col-md-12" style="background:#fff;">
                    <div class="text-center reportheading">
                        <p>Gram Panchayat Information</p>
                    </div>

                    <div class="col-md-12 ">
                        <div id="resetinfo" class="tbl-responsive" style="padding:5px;overflow-x:scroll">
                            <table class="table table-striped page-break-avoid table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                                <tbody class="tablebaody">

                                    <tr>
                                        <td>State:</td>
                                        <td>
                                            <span id="state_name"></span>
                                        </td>
                                        <td>District:</td>
                                        <td>
                                            <span id="district_name"></span>
                                            @*<input type="text" class="form-control decimal" id="district_name" placeholder="Enter the numeric value" />*@
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Block / Taluk :</td>
                                        <td>
                                            <span id="block_name"></span>
                                            @*<input type="text" class="form-control decimal" id="block_name" placeholder="Enter the numeric value" />*@
                                        </td>
                                        <td>GP Name :</td>
                                        <td>
                                            <span id="gram_panchayat_name"></span>
                                            @*<input type="text" class="form-control decimal" id="gram_panchayat_name" placeholder="Enter the numeric value" />*@
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>GP ID :</td>
                                        <td>
                                            <span id="gp_id"></span>
                                            @*<input type="text" class="form-control decimal" id="gp_id" placeholder="Enter the numeric value" />*@
                                        </td>
                                        <td>Block Area  (Ha) :</td>
                                        <td>
                                            <span id="block_area"></span>
                                            @*<input type="text" class="form-control decimal" id="block_area" placeholder="Enter the numeric value" />*@
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>GP area (Ha) :</td>
                                        <td>
                                            <span id="gp_area"></span>
                                            @*<input type="text" class="form-control decimal" id="gp_area" placeholder="Enter the numeric value" />*@
                                        </td>
                                        <td>Watershed Code :</td>
                                        <td>
                                            <span id="watershed_code"></span>


                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Watershed name :</td>
                                        <td>
                                            <span id="watershed_name"></span>

                                        </td>
                                        <td>Watershed area in Block / Taluk (Ha) :</td>
                                        <td>
                                            <span id="watershed_area_block"></span>

                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Sub-basin Code :</td>
                                        <td>
                                            <span id="sub_basin_code"></span>

                                        </td>
                                        <td>Sub basin name :</td>
                                        <td>
                                            <span id="sub_basin_name"></span>

                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Basin Code :</td>
                                        <td>
                                            <span id="basin_code"></span>

                                        </td>
                                        <td>Basin Name :</td>
                                        <td>
                                            <span id="basin_name"></span>
                                            @*<input type="text" class="form-control decimal" id="basin_name" placeholder="Enter the numeric value" />*@
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="html2pdf__page-break"></div>
            <div id="page_break1">
                <div class="html2pdf__page-break"></div>
                <div class="container page2el">
                    <div class="row">
                        <div class="col-md-12" id="image_div1">
                            <p style=" background: #ececec; padding: 5px; text-align: center; margin-top: 25px; color: #5080a9; font-weight: 700; font-size: 16px; border-top-left-radius: 10px; border-top-right-radius: 10px;">Location Map</p>

                        </div>
                    </div>
                </div>
                <div class="html2pdf__page-break"></div>
