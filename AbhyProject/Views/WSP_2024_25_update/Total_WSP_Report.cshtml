                alert(data)

                if (data == "Please Upload Maps!") {
                    window.location = "/WSP_2024_25_update/wsp_gram"
                } else if (data == "Area Proposed for Sprinkler (in Fund)(ha) should be equal to Total Area Proposed for Sprinkler (ha)" || data == "Area Proposed for Drip (in Fund)(ha) should be equal to Total Area Proposed for Drip (ha)" || data == "Area Proposed for Pipelines (in Fund)(ha) should be equal to Total Area Proposed for Pipelines (ha)" || data == "Area Proposed for Crop Diversification (in Fund)(ha) should be equal to Total Area Proposed for Crop Diversification (ha)" || data == "Area Proposed for Any Other (in Fund)(ha) should be equal to Total Area Proposed for Any Other (ha)") {
                    window.location = "/WSP_2024_25_update/DemandSide"
