<script>

    function ReportPdf() {
        
        $("#hide_download").hide();
        $("#hide_btn").hide();
        $("#data11").width(1095);
        var element = document.getElementById('data11');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'Grievance Status.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el11' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A3', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#data11").width();
        $('#data11').addClass('background_after_download');
        $('#data11').addClass('table-condensed');

        $(".highcharts-credits").css("display", "none");
        $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

        $('div#download').addClass('hideDownload');

        setTimeout(function () {
            $('#data11').removeClass('background_after_download');
            $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

            $('div#download').removeClass('hideDownload');
            $("#hide_download").show();
            $("#hide_btn").show();
        }, 2000);
    }

</script>
<script>
    $(document).ready(function () {
        window.location = "/Home/under_maintainance";
        return;
        $('#RegForm').hide();
        Info();
    });
    var GrievanceId = "";
    function Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance_new/Grievance_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {

                var Total = 0;
                var Approved_total = 0;
                var Pending_total = 0;


                if (data.length != 0) {

                    for (var i = 0; i < data.length; i++) {
                        var accept = data[i].accept;
                        if (accept == null) {
                            accept = "";
                        }

                        Total = data.length;
                        if (accept == "Approved") {
                            Approved_total += 1;
                        }
                        else if (accept == "") {
                            Pending_total += 1;
                        }

                    }
                }

                $('#Approved_users').text(Approved_total);
                $('#Total_Users').text(Total);
                $('#Pending_users').text(Pending_total);
            }
        });
    }

    var grivanceid = "";
    var s1 = "";
    var off = "";
    var yes_no = "";
    function SearchInfo() {

        grivanceid = $('#Gid').val();
        if (grivanceid != "") {

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance_new/Grievance_Tracking",
                data: "{'Gid': '" + grivanceid + "'}",
                dataType: 'JSON',
                success: function (response) {

                    $('#Error1').css('display', 'block');

                    if (response == "NoData") {

                        $('#Error1').text("Your Grievance  Id  is Not Matched.. please check your Grievance Id ");
                        $('#Error1').fadeOut(8000, function () {

                        });
                    }
                    else if (response[0].length != 0) {
                        $('#Error1').hide();
                        $('#subject').text(response[0].subject);
                        $('#IdentificationId').text(response[0].IdentificationId);
                        $('#appeal_address_to').text(response[0].grievance_address_to);
                        $('#appeal_type').text(response[0].grievance_type);
                        $('#email').text(response[0].email);
                        $('#mobile').text(response[0].mobile);
                        $('#phone').text(response[0].phone);
                        $('#address').text(response[0].address);
                        $('#description').text(response[0].grivance_description);
                        $('#complaint_name').text(response[0].complaint_name);
                        $('#officer_name').text(response[0].officer_name);
                        $('#RegForm').show();
                        yes_no = response[0].yes_no;

                        if (response[0].accept != null && response[0].accept != '') {

                            s1 = "Resolved";

                        }

                        else {
                            s1 = "Pending";
                        }


                        if (response[0].mail_count_date == null) {
                            off = " (1st Officer)";
                        } else if (response[0].mail_count1_date == null) {
                            off = " (2nd Officer)";
                        }
                        else if (response[0].mail_count2_date == null) {
                            off = " (3rd Officer)";
                        }
                        else {
                            off = " (4th Officer)";
                        }
                        var stt = s1 + off;
                        $('#status_pending').text(stt);





                        days();



                    }

                }
            });
        }
        else {

            alert("Please Enter Grievance Id")
        }
    }

    function days() {


        if (grivanceid != "") {

            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance_new/Grievance_days",
                data: "{'Gid': '" + grivanceid + "'}",
                dataType: 'JSON',
                success: function (response) {

                    var days = "";

                    if (response == "NoData") {
                        days = "";
                    }
                    else {
                        days = response;
                    }
                    
                    if (s1 == "Approved" || s1 =="Resolved" && yes_no == "No" && off == " (1st Officer)") {
                        if (13 >= days) {
                            $('#send_2nd').show();
                            $('#send_3rd').hide();
                        }
                        else {
                            $('#send_2nd').hide();
                            $('#send_3rd').hide();
                        }
                    }
                    else if (s1 == "Approved" || s1 == "Resolved" && yes_no == "No" && off == " (2nd Officer)") {
                        if (23 >= days) {
                            $('#send_2nd').hide();
                            $('#send_3rd').show();
                        }
                        else {
                            $('#send_2nd').hide();
                            $('#send_3rd').hide();
                        }
                    }
                    else if (off == " (3rd Officer)") {
                        $('#send_2nd').hide();
                        $('#send_3rd').hide();
                    }
                    else {
                        $('#send_2nd').hide();
                        $('#send_3rd').hide();
                    }
                }
            });
        }

    }
    function forward2ndlevel() {

        var id = grivanceid;
        if (id != "") {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance_new/forward2ndlevel",
                data: "{'id': '" + grivanceid + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    window.location = "/GRM/Grievance_Tracking";
                },
                error: function () {
                    alert('Approved Failed');
                }
            });
        }

    }
    function forward3rdlevel() {

        var id = grivanceid;
        if (id != "") {
            $.ajax({
                type: 'POST',
                contentType: 'application/json; chatset=utf-8',
                url: "/Grievance_new/forward3rdlevel",
                data: "{'id': '" + grivanceid + "'}",
                dataType: 'JSON',
                success: function (response) {
                    alert(response);
                    window.location = "/GRM/Grievance_Tracking";
                },
                error: function () {
                    alert('Approved Failed');
                }
            });
        }

    }

</script>
