    var StateName = "";
    function SessionInfo() {
        debugger;
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/mis_new/State_SessionInfo',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (data == "Admin") {
                    StateName = "All";

                }
                else {
                    StateName = data;

                }



            }

        });
    }

</script>
