
@{
    ViewBag.Title = "";
    Layout = null;
}


<meta name="viewport" content="width=device-width" />

<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="~/Scripts/all_scripts/bootstrap_3.4.0.min.js"></script>
<script src="~/Scripts/all_scripts/highcharts.js"></script>
<script src="~/Scripts/all_scripts/data.js"></script>
<script src="~/Scripts/all_scripts/drilldown.js"></script>
<!--Pie Chart-->
<script src="~/Scripts/all_scripts/exporting.js"></script>
<script src="~/Scripts/all_scripts/export-data.js"></script>
<!--pie chart-->

<script src="https://code.highcharts.com/modules/variable-pie.js"></script>
<!--favicon end-->
<link href="/Scripts/all_scripts/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/css/wsp_report_css.css" rel="stylesheet" />
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

<script src="~/Content/JS_Files/IdealState.js"></script>
<script src="~/Content/JS_Files/table2excel.js"></script>

<html>
<head>

    <style>
        .colorline1 {
            background: #ddd;
            background-size: 100% 6px;
            background-position: 50% 100%;
            background-repeat: no-repeat;
            text-align: center;
            margin-top: 12px;
            height: 3px;
            width: 100%
        }

        .table-striped tbody tr td:last-child {
            /*text-align: right;*/
        }

        .dateandtime_ul {
            padding: 0px;
        }

            .dateandtime_ul > li {
                display: inline-block;
                color: #000;
                font-size: 18px;
                padding: 0px 15px;
            }

        .hideDownload {
            display: none;
        }

        .background_after_download * {
            font-weight: normal !important;
            text-decoration: none !important;
            text-shadow: none !important;
        }


        .col-md-9 > h1 {
            font-weight: bold;
            color: #404040;
            text-shadow: -1px -1px #000;
        }

        .col-md-9 > p {
            color: #404040;
        }

        .col12 > .firsttable > h6 {
            letter-spacing: 0px;
            padding-left: 10px;
        }

        .firstptag {
            padding-left: 4%;
        }

        body {
            background-color: #ddd;
        }

        .clearfixcolor {
            margin-top: 15px;
        }

        .col12 {
            background-color: #fff;
            padding: 25px;
        }

        .highcharts-credits {
            display: none;
        }



        .highcharts-button-box {
            display: none;
        }

        #Data1 {
            background-color: #fff;
        }

        .firsttable {
            padding: 10px 0px 0px 0px;
        }

        .report_heading_div {
            background-color: #ddd;
            border-radius: 10px;
            padding: 10px;
        }

        .cololr-div {
            background: #4cae4c;
            height: 3px;
            padding: 0px;
        }

        .last-div-footer {
            padding: 10px 0px;
        }

        .text-right > .btn-success {
            margin-top: 20px;
            font-weight: bold;
        }

        .text-right {
            padding: 5px;
        }

            .text-right > .btn-success {
                padding: 8px 20px 8px 20px;
                border-radius: 50px;
                font-size: 18px;
            }

        .btn-success {
            color: #fff;
            background-color: #6fb01d;
            border-color: #4cae4c;
        }

        .coll7 {
            padding-right: 0px;
        }

        ul.Select_option {
            list-style: none;
            display: block;
            padding: 10px 0px 0px 0px;
            font-size: 15px;
            /*margin: 0px;*/
        }

            ul.Select_option > li {
                display: inline-block;
                padding: 0px 0px 0px 46px;
                text-transform: uppercase;
                word-spacing: 1px;
            }

                ul.Select_option > li > span > i {
                    padding: 0px 0px 0px 10px;
                }

        #Select_dist_level {
            padding: 10px 0px 5px 15px;
            text-transform: capitalize;
        }

        ul.firstimages {
            display: block;
            margin-bottom: 0px;
            padding: 0px;
        }

            ul.firstimages > li {
                display: inline-block;
                padding-left: 5px;
                border: 1px solid #ddd;
                padding: 10px 10px 5px 10px;
            }

                ul.firstimages > li > img {
                    border-left: 2px solid #ddd;
                }

                ul.firstimages > li > span > img {
                    width: 25px;
                    height: 25px;
                }

        .highcharts-title {
            font-weight: bold;
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
            font-size: 13px;
        }

        tspan {
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
        }



        .secondtable {
            text-align: right;
        }

        sup {
            font-weight: bold;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            background: #fff;
        }

        .tolat_report_color {
            color: #337ab7;
        }

        .balnace_mater_space1 {
            margin-top: 75px;
        }
    </style>
    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
        }
    </style>
</head>
<body>
    <div class="container" id="Data1" @*style="width: 1850px;"*@>
        <div class="row row_padding_10">
            <div class="col-md-12 ">
                <div class="firsttable col-md-12">
                    <h6>Atal Bhujal Yojana (ATAL JAL), Ministry of Jal Shakti, Department of Water Resources, River Development & Ganga Rejuvenation </h6>
                </div>

            </div>

            <div class="col-md-12 report_heading_div">
                <div class="col-md-9">
                    <h1>Grievance Month wise Report</h1>

                </div>
                <div class="col-md-3 text-right" id="btnExport">
                    @*<button class="btn btn-success download1" onclick="ReportPdf()" id="download">Download</button>*@
                    <button class="btn btn-success download1" id="btnexcel">Excel</button>
                </div>
                <div class="col-md-12">
                    <ul class="dateandtime_ul">
                        <li>Date : <span id="demobalance"></span></li>
                        <li>Time : <span id="demobalance2"></span></li>
                        <li>
                            User Name :
                            @if (Session["UserName"] != null)
                            {
                                <span>@Session["UserName"].ToString()</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>
            <br />
            <br />
            <div class="col-md-10 Select_option_div">

                <ul class="Select_option col-md-12 col-sm-12  text-left">

                    <li id="">
                        <label id="">Year:</label>
                    </li>
                    <li class="">
                        <select name="" id="Finacial_Year" class="form-control" onchange="state_data()">
                            <option value="0">Select Year</option>
                            <option value="ALL">All 5 Year</option>
                            <option value="2020-21">2020-21</option>
                            <option value="2021-22">2021-22</option>
                            <option value="2022-23">2022-23</option>
                            <option value="2023-24">2023-24</option>
                            <option value="2024-25">2024-25</option>

                        </select>
                    </li>


                </ul>


            </div>

            <div class="col-md-6">
                <div class="tbl-responsive" style="overflow-x: scroll; width: 200%;">
                    <table id="tblreport" style="width:100%" class="table pgwmtable table-striped table-condensed table-hover row-border order-column table-striped table-bordered dataTable no-footer" style="border:1px solid #dddddd; margin-top:10px;">
                        <thead>
                            <tr class="tableheader1"></tr>
                            <tr style="display:none">
                                <td colspan="11" class="text-center">
                                    <label>
                                        Year :
                                        <label id="year_fill"></label>
                                    </label>
                                </td>
                            </tr>
                            <tr class="success">
                                <td rowspan="2" class="text-center"><label style="padding-top:20px;">Sl.No</label></td>
                                <td rowspan="2" class="text-center"><label style="padding-top:20px;">States</label></td>
                                <td colspan="3" class="text-center"><label>April  <label id="year"></label></label> </td>
                                <td colspan="3" class="text-center"><label>May  <label id="yeara"></label></label></td>
                                <td colspan="3" class="text-center"><label>June  <label id="yearb"></label></label></td>
                                <td colspan="3" class="text-center"><label>July  <label id="yearc"></label></label></td>
                                <td colspan="3" class="text-center"><label>August  <label id="yeard"></label></label></td>
                                <td colspan="3" class="text-center"><label>September  <label id="yeare"></label></label></td>
                                <td colspan="3" class="text-center"><label>October  <label id="yearf"></label></label> </td>
                                <td colspan="3" class="text-center"><label>November  <label id="yearg"></label></label> </td>
                                <td colspan="3" class="text-center"><label>December  <label id="yearh"></label></label> </td>
                                <td colspan="3" class="text-center"><label>January  <label id="yeari"></label></label></td>
                                <td colspan="3" class="text-center"><label>February  <label id="yearj"></label></label></td>
                                <td colspan="3" class="text-center"><label>March  <label id="yeark"></label></label></td>



                            </tr>
                            <tr class="success">
                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

                                <td colspan="1" class="text-center"><label>Registered</label></td>
                                <td colspan="1" class="text-center"><label>Resolved </label></td>
                                <td colspan="1" class="text-center"><label>Pending</label></td>

