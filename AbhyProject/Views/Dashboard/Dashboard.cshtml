                                        <div id="sixth_bar_char_st_id"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12 mb-2">
                                    <h6 class="good_heading">Works<var id="txt_change_year2"></var></h6>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="work_section all_section">
                                        <h6 class="heading">Construction of Piezometers</h6>
                                        <div id="fivth_bar_char_id"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12 mb-2">
                                    <h6 class="good_heading">Status of Equipment<var id="txt_change_year3"></var></h6>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="water_section all_section">
                                        <h6 class="heading">Digital Water Level Recorder (DWLR)</h6>
                                        <div id="second_bar_char_id"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="analog_section all_section">
                                        <h6 class="heading">Digital/Analog Water level Indicators</h6>
                                        <div id="first_bar_char_id"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="analog_section all_section">
                                        <h6 class="heading">Rain Guage</h6>
                                        <div id="third_bar_char_rain_id"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="analog_section all_section">
                                        <h6 class="heading">Water Flow Meters</h6>
                                        <div id="third_bar_char_id"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="analog_section all_section">
                                        <h6 class="heading">Water Quality Testing Kit</h6>
                                        <div id="fourth_bar_char_id"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-lg-12">
                                    <h6 class="status_heading">Status of DLIs<var id="txt_change_year4"></var></h6>
                                </div>
                            </div>
                            <div class="row mb-2" id="div_dli1_graph">
                                <div class="col-sm-12">
                                    <div class="water_quality all_section">
                                        <h6 class="heading">
                                            DLI-1:  Public Disclosure of Groundwater Data
                                        </h6>
                                        <figure class="highcharts-figure">
                                            <div id="container"></div>
                                        </figure>
                                        @*<div id="seven_bar_char_id_dli1_id"></div>*@
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2" id="div_dli2_graph">
                                <div class="col-sm-12 ">
                                    <div class="water_security all_section">
