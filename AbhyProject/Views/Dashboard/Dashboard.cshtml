                                        <h6 class="heading">DLI-3: Public Financing of Approved Water Security Plans</h6>
                                        <div id="nine_bar_char_dli3_id"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2" id="div_dli4_graph">
    <div class="col-sm-12">
        <div class="water_security all_section">
