                                    <h1 class="heading" id="txtTotalallocation_B" style="text-align:right"></h1>
                                    <h1 class="heading" id="txtTotalRelease_B" style="text-align:right"></h1>
                                    <h1 class="heading" id="txtTotalexpenditure_B" style="text-align:right"></h1>
                                    <div id="ten_bar_char_id"></div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2" id="div_graph_eleven">
                            <div class="col-sm-12">
                                <div class="water_security all_section">
                                    <h6 class="heading">Allocation vs Expenditure by Major Heads (Component-A)<var id="txt_change_year7"></var></h6>
                                    <h1 class="heading" id="txtTotalallocation_eleven" style="text-align:right"></h1>
                                    <h1 class="heading" id="txtTotalexp_eleven" style="text-align:right"></h1>
                                    <div id="eleven_bar_char_id"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- physcical section end -->
                </div>

            </div>

        </section>
    </div>
</main>
