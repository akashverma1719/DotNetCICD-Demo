                                        <!-- Fifth Circle Chart -->
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div id="fifth_pie_chart_id"></div>
                                            </div>
                                        </div>
                                        <!-- Fifth Circle Chart -->
                                    </div>
                                </div>
                                <div class="col-lg-4 pl-0" id="div_awp_b">
                                    <div class="awp-compo-b">
                                        <h6 class="awp-compo-heading-b pb-2 pt-2 pl-2 pr-2">Total Allocated Amount - Component B</h6>
                                        <!-- Sixth Circle Chart -->
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div id="sixth_pie_chart_id"></div>
                                            </div>
                                        </div>
                                        <!-- Sixth Circle Chart -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- upper part end -->


            <div class="container-fluid mt-4">
                <div class="button_box">
                    <button type="button" id="btnPhysical" class="db-btn btn1 tab-active">Physical Progress (In Number)  </button>
                    <button type="button" id="btnfinancial" class="db-btn btn2">Financial Progress (In Crores)</button>
                </div>
                <div class="parent_div">

                    <div class="financial_section">
                        <div class="heading_div" id="div_Physical">
                            <div class="row mb-2">
                                <div class="col-lg-12">
                                    <h6 class="status_heading">Training<var id="txt_change_year1"></var></h6>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="work_section all_section">
                                        <h6 class="heading">No. of Trainings Conducted in Gram Panchayats</h6>
                                        <div id="sixth_bar_char_gp_id"></div>
                                    </div>
                                </div>
                            </div>
