                                        <h6 class="heading">No. of Trainings Conducted in Blocks</h6>
                                        <div id="sixth_bar_char_bl_id"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-12">
                                    <div class="work_section all_section">
                                        <h6 class="heading">No. of Trainings Conducted in Districts</h6>
                                        <div id="sixth_bar_char_dis_id"></div>
                                    </div>
