@{
    /**/


    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}
<style>
    /*.color_database {
        color: green !important;
    }*/

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        padding: 4px 6px;
        text-align: left;
        line-height: 1.4;
    }

    .dot-ttl {
        font-size: 13px !important;
    }

    .mr-bt {
        margin-bottom: 6px;
        margin-top: 10px;
    }

    .sub-second-two {
        border: 1px solid #004592;
        margin: 5px !important;
    }

    .sub-second {
        border: 1px solid #004592;
        margin: 5px !important;
    }

    .pl-0 {
        padding-left: 0px;
    }

    .pr-0 {
        padding-right: 0px;
    }

    .awp-compo-a-b, .awp-compo-a, .awp-compo-b {
        margin: 5px !important;
    }

    .mt-4 {
        margin-top: 30px;
    }

    .mb-0 {
        margin-bottom: 0px;
    }

    .mb-1 {
        margin-bottom: 10px;
    }

    .analog_section .heading, .water_section .heading, .work_section .heading, .water_quality .heading, .water_security .heading {
        border-bottom: 1px solid #004592;
        padding: 10px;
        font-weight: bold;
        text-align: left;
        color: #004592;
        font-size: 13px;
        margin: 0px;
    }

    .mb-2 {
        margin-bottom: 10px;
    }

    .secondchild-heading {
        font-size: 12px !important;
    }

    #first_pie_chart_id {
        height: 230px !important;
    }

    .state-ttl {
        font-size: 18px;
        font-weight: 600;
        line-height: 20px;
        color: #000;
        padding: 5px 14px;
        border-radius: 8px;
        text-transform: capitalize;
        letter-spacing: 0px;
    }
</style>
<link href="~/DashboardStyles/css/DashboardStyle.css" rel="stylesheet" />


<div class="loading-container">
    <div class="loader">
        <img src="~/Content/WspImages/loader.gif" height="200" width="200" />
    </div>
</div>

<main id="app-main" class="app-main">
    <div class="wrap">
        <section class="app-content" id="data11">
            <div class="upper-title mt-2 ">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12 col-sm-12 d-flex align-items-end justify-content-between">
                            <div class="title">
                                <h2 class="project-heading">Project at a Glance</h2>
                            </div>
                            <a style="margin-left: auto; margin-bottom: auto;" class="font-extra-bold bg-primary text-white btn btn-sm" type="button" href="/Content/VideosRecording/17_Dashboard_final.mp4" target="_blank">VIDEO TUTORIAL</a>
                            <p class="state-ttl" id="pip_dropdown_state_name"></p>
                            <select class="form-control ml-1" id="state" onchange="DropDownVal()" style="width:14%;float:right"></select>
                        </div>
                    </div>
                </div>
            </div>

            <!--Dashboard box-->

            <div class="pip">
                <div class="container-fluid">
                    <div class="pip-parent pb-3">
                        <div class="row">
                            <div class="col-lg-12 col-md-12">
                                <h6 class="pip-heading pl-4" id="txt_pip_heading">Project Implementation Plan (PIP)-5 Years</h6>
                            </div>
                        </div>
                        <div class="pip-firstchild">
                            <div class="row">
                                <div class="col-lg-12 col-md-12">
                                    <h6 class="firstchild-heading pb-2 pt-2 pl-3" id="txt_a_b">
                                        Activities Under Component A and B
                                    </h6>
                                </div>
                            </div>
                            <!--Circle First Chart-->
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="row">
                                        <div class="col-md-12 col-lg-6">
                                            <div class="d-flex blue align-items-center pt-3 mr-bt">
                                                <p class="blue-dot"></p>
                                                <p class="dot-ttl">
                                                    Component A (Institutional Strengthening and Capacity
                                                    Building)
                                                </p>
                                            </div>
                                            <table class="table table-borderless component-table mb-0 mt-2">
                                                <tbody>
                                                    <tr id="div_1">
                                                        <td id="txt11">A1 : Institutional Support</td>
                                                        <td>A5 : Training</td>
                                                    </tr>
                                                    <tr id="div_2">
                                                        <td style="border:none;">A2 : Equipment</td>
                                                        <td style="border:none;">A6 : Lab and Data Center</td>
                                                    </tr>
                                                    <tr>
                                                        <td id="div_3" style="border:none;">A3 : Works</td>
                                                        <td id="txt_npmu_tile" style="border:none;"></td>
                                                    </tr>
                                                    <tr id="div_4">
                                                        <td style="border:none;padding-top:0px">A4 : Information Education & Communication (IEC)</td>
                                                        <td style="border:none;"></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="col-md-12 col-lg-6" id="div_b">
                                            <div class="d-flex orange align-items-center pt-3 mr-bt">
                                                <p class="orange-dot"></p>
                                                <p class="dot-ttl">
                                                    Component B (Incentive)
                                                </p>
                                            </div>
                                            <table class="table table-borderless component-table mb-0 mt-2">
                                                <tbody>
                                                    <tr>
                                                        <td style="min-width: 55px"><b>DLI-1 :</b></td>
                                                        <td>Public disclosure of groundwater data (Number)</td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <b>DLI-2 :</b>
                                                        </td>
                                                        <td>
                                                            Preparation of Community led Water Security Plans
                                                            (Gram Panchayat Wise)
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <b>DLI-3 :</b>
                                                        </td>
                                                        <td>
                                                            Public financing of approved Water Security Plans (Rs. In Crores)
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <b>DLI-4 :</b>
                                                        </td>
                                                        <td>
                                                            Adoption of practices for efficient water use
                                                            (Area in Ha)
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <b>DLI-5 :</b>
                                                        </td>
                                                        <td>
                                                            Improvement in the rate of decline of groundwater
                                                            levels (Block Wise)
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Circle First Chart end-->
                        </div>

                        <div class="pip-secondchild" id="div_total_a_b">
                            <div class="row">
                                <div class="col-lg-4 col-md-12 col-sm-12 pr-0" id="div_pip_a_b">
                                    <div class="sub-second">
                                        <h6 class="secondchild-heading pb-2 pt-2 pl-3">
                                            Total Allocated Amount (Including Component A and B)
                                        </h6>
                                        <div id="first_pie_chart_id"></div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-12 col-sm-12 pr-0 pl-0" id="div_pip_a">
                                    <div class="sub-second">
                                        <h6 class="secondchild-heading pb-2 pt-2 pl-3">Total Allocated Amount - Component A</h6>
                                        <div id="second_pie_chart_id"></div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-12 col-sm-12 pl-0" id="div_pip_b">
                                    <div class="sub-second-two">
                                        <h6 class="secondchild-heading pb-2 pt-2 pl-3">Total Allocated Amount - Component B</h6>
                                        <div id="thired_pie_chart_id"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Financial Dropdown-->
            <div class="financial mt-3">
                <div class="container-fluid">

                    <div class="row">
                        <div class="col-lg-3"></div>
                        <div class="col-lg-3"></div>
                        <div class="col-lg-3"></div>
                        <div class="col-lg-3">
                            <div class="financial-dropdown ml-auto">
                                <form>
                                    <div class="form-group">
                                        <select class="form-control" onchange="Year_Wise_AWP_Info()" id="AWP_Financial_Year">

                                            <option value="ALL">Cumulative Progress</option>
                                            <option value="2020-21">2020-2021</option>
                                            <option value="2021-22">2021-2022</option>
                                            <option  value="2022-23">2022-2023</option>
                                            <option selected value="2023-24">2023-2024</option>
                                                <option value="2024-25">2024-2025</option>
                                                <option value="2025-26">2025-2026</option>
                                        </select>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Anual Work Plan box-2-->
            <div class="awp" id="div_awp">
                <div class="container-fluid">
                    <div class="awp-parent mb-2">
                        <div class="row">
                            <div class="col-lg-12 col-md-12">
                                <h6 class="awp-heading pl-4" id="awp_text">Annual Work Plan (AWP) <var id="txt_change_year"></var></h6>
                            </div>
                        </div>

                        <div class="awp_firstchild">
                            <div class="row">
                                <div class="col-lg-4 pr-0" id="div_awp_a_b">
