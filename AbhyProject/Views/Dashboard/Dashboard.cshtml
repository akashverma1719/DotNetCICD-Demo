            <div id="ten_bar_char_dli4_id"></div>
        </div>
    </div>
</div>
                            <div class="row mb-1" id="div_dli5_graph">
                                <div class="col-sm-12">
                                    <div class="water_security all_section">
                                        <h6 class="heading">DLI-5: Improvement in the rate of decline of groundwater levels (Block Wise)</h6>
                                        <div id="eleven_bar_char_dli5_id"></div>
                                    </div>
                                </div>
                            </div>


                        </div>



                    </div>
                    <!-- physcical section start -->
                    <div class="physical_section" style="border: unset;">

                        <div class="row">
                            <div class="col-sm-12 mb-2">
                                <div class="water_quality all_section" id="contenshow">
                                    <h5 class="heading" id="div_fin_A_graph">Allocation vs Release vs Expenditure - Component A (Institutional Strengthening and Capacity Building)<var id="txt_change_year5"></var></h5>
                                    <h1 class="heading" id="txtTotalallocation_A" style="text-align:right"></h1>
                                    <h1 class="heading" id="txtTotalRelease_A" style="text-align:right"></h1>
                                    <h1 class="heading" id="txtTotalexpenditure_A" style="text-align:right"></h1>
                                    <div id="nine_bar_char_id"></div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2" id="div_graph_ten">
                            <div class="col-sm-12">
                                <div class="water_security all_section">
