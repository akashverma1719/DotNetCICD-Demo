    function getvillagewisefilter(result1) {

        var result = "";
        if (result1 != null) {

            result = result1;
            var gwl_totwells_count = 0;
            var gwl_improvedwells_count = 0;
            var implementationsites_count = 0;

            var gwl_totwells = result.Abhy_groundwater_levels;
            var gwl_improvedwells = result.Abhy_WaterUtilization_Approvals;
            for (var g = 0; g < gwl_totwells.length; g++) {
                gwl_totwells_count = (g + 1);
                for (var f = 0; f < gwl_improvedwells.length; f++) {
                    if (gwl_totwells[g]["site_type"] === gwl_improvedwells[f]["site_type"]) {
                        gwl_improvedwells_count = (f + 1);
                    }
                    if (gwl_totwells[g]["site_type"] === gwl_improvedwells[f]["site_type"] && gwl_improvedwells[f]["accept"] === "1") {
                        implementationsites_count = (f + 1);
                    }
                }
            }
            $('#gwltotwells').html(gwl_totwells_count);
            $('#gwlimprovedwells').html(gwl_improvedwells_count);
            var gwl_declined = parseFloat(parseFloat(gwl_totwells_count) - parseFloat(gwl_improvedwells_count));
            $('#gwldeclinedwells').html(gwl_declined);


            //sir is told me the above mentioned details sowing here.
            $('#gwlPiezometertotal').html(gwl_totwells_count);
            $('#gwlPiezometerworking').html(gwl_improvedwells_count);




            var gps_Count1 = 0;
            var improvedgps_Count1 = 0;
            var gps_count = result.abhy_grampanchayas;
            var gwb_Budget = result.abhystates_completecensusdata_Inserts;
            for (var j = 0; j < gps_count.length; j++) {
                gps_Count1 = (j + 1);
                for (var d = 0; d < gwb_Budget.length; d++) {
                    if (gps_count[j]["gpname"] === gwb_Budget[d]["gram_panchayat_name"] && gwb_Budget[d]["approvedorreject"] === "2") {
                        improvedgps_Count1 = (d + 1);
                    }
                }
            }
            $('#gwb_totalgps').html(gps_Count1);
            $('#gwb_improvedgps').html(improvedgps_Count1);
            var declined_gps = parseFloat(parseFloat(gps_Count1) - parseFloat(improvedgps_Count1));
            $('#gwb_diclinedgps').html(declined_gps);

            var wspprepared_Count1 = 0;
            var wsppreparedcompleted_Count1 = 0;
            var wspimplementedcompleted_Count1 = 0;
            var wspprepared_data = result.abhy_grampanchayas;
            var wspsupply_data = result.abhy_supplys;
            var wspdemand_data = result.abhy_demands;
            var finalObj = wspsupply_data.concat(wspdemand_data);
            var wsppreparedcompleted_data = finalObj;
            for (var s = 0; s < wspprepared_data.length; s++) {
                wspprepared_Count1 = (s + 1);
                for (var a = 0; a < wsppreparedcompleted_data.length; a++) {
                    // if (gps_count[s]["gpname"] === wsppreparedcompleted_data[a]["gname"]) {
                    wsppreparedcompleted_Count1 = (a + 1);
                    // }
                    if (gps_count[s]["gpname"] === wsppreparedcompleted_data[a]["gname"] && wsppreparedcompleted_data[a]["accept"]) {
                        wspimplementedcompleted_Count1 = (a + 1);
                    }
                }
            }
            $('#wsppreparedGps').html(wspprepared_Count1);
            $('#wsppreparedcompletedgps').html(wsppreparedcompleted_Count1);
            var wsppreparedworking = parseFloat(parseFloat(wspprepared_Count1) - parseFloat(wsppreparedcompleted_Count1));
            $('#wsppreaparedworkinggps').html(wsppreparedworking);


            $('#wspimplementedgps').html(wspprepared_Count1);
            $('#wspimplementedcompletedgps').html(wspimplementedcompleted_Count1);
            var wspimplementedworking = parseFloat(parseFloat(wspprepared_Count1) - parseFloat(wspimplementedcompleted_Count1));
            $('#wspimplementedworkinggps').html(wspimplementedworking);

            //total sites
            $('#lbltotalsites').html(gwl_totwells_count);
            $('#lblcreatedsites').html(wsppreparedcompleted_Count1);
            $('#lblimplementsites').html(wspimplementedcompleted_Count1);
            var gwlresultsites_count = parseFloat(parseFloat(wsppreparedcompleted_Count1) - parseFloat(wspimplementedcompleted_Count1));
            $('#lblresultsites').html(gwlresultsites_count);

            var wspsupplyside_Count1 = 0;
            var wspsupplyside_acceptCount1 = 0;
            for (var w = 0; w < wspsupply_data.length; w++) {
                wspsupplyside_Count1 = (w + 1);
                if (wspsupply_data[w]["accept"] === "1") {
                    wspsupplyside_acceptCount1 = (w + 1);
                }
            }

            $('#supplysideinterventiontotplanned').html(wspsupplyside_Count1);
            $('#supplysideinterventioncompleted').html(wspsupplyside_acceptCount1);


            var wspdemandside_Count1 = 0;
            var wspdemandside_acceptCount1 = 0;
            for (var y = 0; y < wspdemand_data.length; y++) {
                wspdemandside_Count1 = (y + 1);
                if (wspsupply_data[y]["accept"] === "1") {
                    wspdemandside_acceptCount1 = (y + 1);
                }
            }

            $('#demandsideintenventiontotpalanned').html(wspdemandside_Count1);
            $('#demandsideintenventioncompleted').html(wspdemandside_acceptCount1);
        }

    }



