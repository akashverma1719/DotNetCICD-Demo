    <style type="text/css">
        .comp_layout {
            height: 150px !important;
        }

        .comp_layout1 {
            background-color: lightslategray;
        }

        .comp_layout22 {
            background-color: lightgray;
        }

        .comp_layout33 {
            background-color: darkgray;
        }

        .comp_layout .content {
            line-height: 1.7em !important;
            color: #000;
        }

        .content:hover {
            color: #fff;
        }

        .dept_head_bg > h4:hover {
            color: #fff;
        }

        .comp_layout h1, .comp_layout h4 {
            color: #000;
        }

            .comp_layout h4 :focus,
            .comp_layout h4 :hover {
                color: #fff;
            }

        .totalcontentrow {
            margin-top: 12px;
        }

        .comp_lightblueall {
            background-color: #E2cf31;
        }

            .comp_lightblueall:hover {
                background-color: gray;
                color: #fff;
            }

        .bgcolorline {
            min-width: 10px;
            padding: 3px 7px;
            font-size: 12px;
            font-weight: bold;
            line-height: 1;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            background-color: #999;
            border-radius: 10px;
        }

        .content_logo > img {
            width: 50px;
        }

        .dept_head_bg > h4 {
            font-size: 18px;
            margin-top: 3px;
        }

        .card-body {
            -webkit-box-flex: 1;
            flex: 1 1 auto;
            padding: 1.25rem;
        }


        .dib {
            display: inline-block;
        }

        .stat-widget-one .stat-icon i {
            font-size: 30px;
            border-width: 3px;
            border-style: solid;
            border-radius: 100px;
            padding: 15px;
            font-weight: 900;
            display: inline-block;
        }

        [class^="ti-"], [class*=" ti-"] {
            font-family: 'themify';
            speak: none;
            font-style: normal;
            font-variant: normal;
            text-transform: none;
            line-height: 1;
            -webkit-font-smoothing: antialiased;
        }

        .dept_no_bg1 {
            padding: 19px !important;
        }

        .twt-feed.blue-bg {
            background: #58C9F3;
        }

        .twt-feed {
            -webkit-border-radius: 4px 4px 0 0;
            color: #FFFFFF;
            padding: 40px 10px 10px;
            position: relative;
            min-height: 150px;
        }

        .black-ribon {
            background: url(../../images/3d_images/twitter_corner_black.png) no-repeat;
        }

        .corner-ribon {
            text-align: center;
            width: 71px;
            height: 71px;
            position: absolute;
            right: 0;
            top: 0;
            font-size: 20px;
        }

        .twt-feed .wtt-mark {
            color: rgba(255, 255, 255, 0.15);
            font-size: 120px;
            position: absolute;
            top: 10px;
            left: 40%;
        }

        .corner-ribon i {
            padding: 10px 0 0 35px;
            color: #fff;
        }

        .twt-footer, .twt-footer a {
            color: #d2d2d2;
        }

        .twt-footer {
            padding: 12px 15px;
        }

        .card .card-footer ul {
            margin-top: 10px;
        }

            .card .card-footer ul li {
                display: table-cell;
                padding: 0 1rem;
                text-align: center;
                line-height: 1.8em;
            }

        .pg1 {
            background-color: #28a745;
        }

        .pg2 {
            background-color: #17a2b8;
