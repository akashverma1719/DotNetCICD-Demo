
@{
    ViewBag.Title = "External_Resources";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}
<title>External Resources</title>
<style>
    @@media (min-width: 0) {
        .g-px-15 {
            padding-left: 1.07143rem !important;
            padding-right: 1.07143rem !important;
        }
    }

    @@media (min-width: 0) {
        .g-py-10 {
            padding-top: 0.71429rem !important;
            padding-bottom: 0.71429rem !important;
        }
    }

    .g-font-size-13 {
        font-size: 0.92857rem !important;
    }


    .btn {
        position: relative;
        transition: .2s ease;
        cursor: pointer;
    }

    .fa-pull-right, .pull-right {
        float: right;
    }

    .text-uppercase {
        text-transform: uppercase !important;
    }

    .btn {
        display: inline-block;
        font-weight: 400 !important;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1.3rem !important;
        line-height: 1.5 !important;
        border-radius: 0.25rem !important;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .u-btn-outline-primary {
        color: #527bcc !important;
        border-color: #527bcc !important;
        background-color: transparent !important;
    }

    .alignmentofbox {
        line-height: 1.6em;
        font-size: 15px;
        padding: 15px 0px 0px 0px !important;
    }

    ul#myTabs > li.active::after {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #2E578C;
        content: " ";
        position: absolute;
        bottom: -15px;
        margin-left: -15px;
        left: 50%;
    }

    ul#myTabs > li {
        background-color: #3A99ED;
        padding: 0px;
    }

        ul#myTabs > li.active > a,
        ul#myTabs > li.active > a:focus,
        ul#myTabs > li.active > a:hover {
            color: #fff !important;
            background-color: #2E578C !important;
        }

    .nav > li > a:focus, .nav > li > a:hover {
        text-decoration: none;
        background-color: #6FB11D;
    }

    #accordion {
        padding: 10px;
    }

    .panel-body {
        padding: 0px;
    }

    ul#myTabs > li > a {
        color: #fff;
    }

    .text-center > h4 {
        padding: 10px;
        text-decoration: underline;
    }

    @@media only screen and (max-width: 600px) {
        .g-py-10 {
            font-size: 0.5em !important;
            right: 0px;
            position: absolute;
            bottom: 1px;
        }
    }

    .classic-title {
        padding-bottom: 8px;
        padding: 0px 0px 0px 23px;
    }

    .panel-group .panel {
        border: 1px solid #e8e8e8;
        margin: 5px 0;
    }

    .panel-title {
        font-size: 13px;
        font-weight: 600;
    }

        .panel-title a {
            position: relative;
            display: block;
            color: #444 !important;
            padding: 6px 12px;
            background-color: #fff;
        }

            .panel-title a .control-icon {
                position: absolute;
                top: 50%;
                right: 10px;
                margin-top: -11px;
            }

            .panel-title a i {
                font-size: 1.2em;
                padding-right: 5px;
            }

            .panel-title a.collapsed {
                color: #444;
                box-shadow: 0 0 15px rgba(0,0,0,.04) inset !important;
            }

    .panel-default > .panel-heading + .panel-collapse .panel-body {
        border-top: none !important;
    }

    .tab-pane .panel-body {
        border-top: none;
    }

    .panel-collapse .panel-body {
        border: none;
        background-color: #fff;
    }

    .well {
        min-height: 20px;
        padding: 19px;
        margin-bottom: 20px;
        background-color: #f5f5f5;
        border: 1px solid #e3e3e3;
        border-radius: 4px;
        -webkit-box-shadow: inset 0 1px 1px rgba(0,0,0,.05);
        box-shadow: inset 0 1px 1px rgba(0,0,0,.05);
        line-height: 1.5em;
    }

    a:focus, a:hover {
        color: #eee8e8;
        outline: none;
        text-decoration: none;
    }

    .panel-group .panel-heading {
        background-color: #f7f9fa;
    }

    ui.Main_page_list {
        padding: 10px !important;
    }
</style>
<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<script>
   $("nav#primary-menu > ul.main-menu > li:nth-child(4)").addClass("active");
   $("nav#primary-menu > ul.main-menu > li:nth-child(4)").siblings().removeClass('active');
   $("nav#primary-menu > ul.main-menu > li:nth-child(4) > ul.dropdown > li:nth-child(5) ").addClass("active");
   $("nav#primary-menu > ul.main-menu > li:nth-child(4) > ul.dropdown > li:nth-child(5) ").siblings().removeClass('active');

</script>
