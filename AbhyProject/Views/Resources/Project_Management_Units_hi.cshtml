<script>
    $(document).ready(function () {
        $.noConflict();
        $("nav#primary-menu > ul.main-menu > li:nth-child(2)").addClass("active");
        $("nav#primary-menu > ul.main-menu > li:nth-child(2)").siblings().removeClass('active');
        $("nav#primary-menu > ul.main-menu > li:nth-child(2)> ul.dropdown > li:nth-child(4) ").addClass("active");
        $("nav#primary-menu > ul.main-menu > li:nth-child(2) > ul.dropdown > li:nth-child(4)").siblings().removeClass('active');
        

    });

</script>
