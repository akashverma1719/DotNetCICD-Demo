<script>
    $("nav#primary-menu > ul.main-menu > li:nth-child(4)").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(4)").siblings().removeClass('active');
    $("nav#primary-menu > ul.main-menu > li:nth-child(4) > ul.dropdown > li:nth-child(2) ").addClass("active");
    $("nav#primary-menu > ul.main-menu > li:nth-child(4) > ul.dropdown > li:nth-child(2) ").siblings().removeClass('active');

</script>

<div class="row somerow">
    <div class="col-md-12">
        <div class="text-h g-mb-20" style="padding: 10px; color: #337ab7; font-size: 20px;margin-left:10px; font-family:raleway;margin-top:20px;font-weight:900">Catalog Search</div>
    </div>
</div>

<div class="clearfix">
    <div class="row">

        <div class="container text-center">
            <ul class="listof_searchbox">
                <li class="col-md-3"></li>
                <li class="col-md-4 col-sm-7">
                    <div class=" ">
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-search"></i></span>
                            <input id="search_id" type="text" class="form-control " placeholder="Search...">
                        </div>
                    </div>
                </li>
                <li class="col-md-2 col-sm-5"> <button type="button" onclick="Search()" class="btn btn-primary">Search</button></li>
            </ul>



        </div>

    </div>
</div>


<script>
    function Search() {
        
        var search_id = $('#search_id').val();
        if (search_id != "") {
            var Search_Item = search_id.toLowerCase();
            var Search_Itemm1 = Search_Item.trim().split(" ").join("");

            if (Search_Itemm1 == "home") {
                window.location = "/Home/Index";
            }
            else if (Search_Itemm1 == "about") {
                window.location = "/About/About";
            }
            else if (Search_Itemm1 == "aboutataljal") {
                window.location = "/About/About";
            }
            else if (Search_Itemm1 == "mislogin") {
                  window.location = "/Home/LogOut";
            }
            else if (Search_Itemm1 == "tenderannouncements") {
                window.location = "/Tenders/Tender_Announcements";
            }
            else if (Search_Itemm1 == "tenderawarded") {
                window.location = "/Tenders/Tender_Awarded";
            }
            else if (Search_Itemm1 == "etenders") {
                window.location = "/Tenders/E_Tender";
            }
            else if (Search_Itemm1 == "newgrievanceregistration") {
                window.location = "/Grievance/Index";
            }
            else if (Search_Itemm1 == "newappealregistration") {
                window.location = "/Grievance/Appeal_Registration";
            }
            else if (Search_Itemm1 == "grievancestatus") {
                window.location = "/Grievance/Grievance_Tracking";
            }
            else if (Search_Itemm1 == "dashboard") {
                window.location = "/Dashboard/Dashboard";
            }
            else if (Search_Itemm1 == "contactus") {
                window.location = "/Home/Contact";
            }
            else if (Search_Itemm1 == "faqs") {
                window.location = "/Home/FAQs";
            }
            else if (Search_Itemm1 == "mapview") {
                window.location = "http://ataljal-mapdata.mowr.gov.in/index.php";
            }
            else if (Search_Itemm1 == "additionalcontacts") {
                window.location = "/Contact/Additional_Contacts";
            }
            else {
                alert("Name is Not Matched");
            }
        }
    }
</script>



