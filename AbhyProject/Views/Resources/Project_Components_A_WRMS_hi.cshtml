    <script type="text/javascript">
        function openPopUp(popupId) {
            $('#' + popupId).modal('show');
        }

        document.getElementById('compS1').childNodes[1].setAttribute("class", "active");
        document.getElementById('compS1').childNodes[1].children[0].setAttribute("class", "active");
        document.getElementById('compS1Desc').childNodes[1].setAttribute("class", "tab-pane fade active in");
        var opt = location.href.substring(location.href.length - 1, location.href.length);
        document.getElementById("ISTable" + opt).style.display = "table";
    </script>

