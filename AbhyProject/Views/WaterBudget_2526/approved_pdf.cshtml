        //var distName = $("#spndistrict option:selected").text();
        //var State = $("#spnstate1 option:selected").text();
        if (off_1 == "dist") {
            dist = Dist;
        } else {
            Dist = dist;
        }
        console.log(Dist)
        if (Dist != "0" && Jsondata.length != 0) {
            GetApprovedGpCount();
            var ddlst = {};
            var all_blocks = [];
            var optionDist = '';

            for (var i = 0; i < Jsondata.length; i++) {

                if (dist == Jsondata[i].lg_dist && State == Jsondata[i].lg_state) {
                    if (!ddlst[Jsondata[i].block_name]) {
                        all_blocks.push({ lg_block: Jsondata[i].lg_block, block_name: Jsondata[i].block_name });
                        ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                        //  $("#block").append(optionDist);
                    }
                }
            }


            var BlockArray = [];
            BlockArray = all_blocks.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < BlockArray.length; i++) {
                if (BlockArray[i] != null && BlockArray[i] != "") {
                    optionDist += '<option value="' + BlockArray[i].lg_block + '">' + BlockArray[i].block_name + '</option>';
                }
            }
            $("#block1").append(optionDist);

        }
    }



