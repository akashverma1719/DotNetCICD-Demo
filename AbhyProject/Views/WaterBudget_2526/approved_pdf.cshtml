    // Convert /Date(xxxxxxxx)/ format to readable date
    function formatDate(jsonDate) {
        if (!jsonDate) return ''; // Handle null or undefined date

        // Extract the number part from /Date(xxxxxxxxxx)/
        var timestamp = parseInt(jsonDate.replace(/\/Date\((.*?)\)\//, '$1'), 10);

        // Convert timestamp to a JavaScript Date object
        var date = new Date(timestamp);

        // Check if the date is valid
        if (isNaN(date.getTime())) {
            return 'Invalid Date'; // Handle invalid date
        }

        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0'); // Month is zero-based
        var year = date.getFullYear();

        return `${day}/${month}/${year}`; // Format as dd/MM/yyyy
    }


