        $("#gram").append(opgram);
        Gram = "0";
        //var block = $("#block1").val();
        var blockName = $("#block1 option:selected").text();
        var StateName = $("#spnstate option:selected").text();
        var DistName = $("#dist11 option:selected").text();

        if (off_1 == "block") {
            StateName = Block;
        } else {
            Block = $("#block1").val();
        }


        if (Block != "0" && Jsondata.length != 0) {
            var ddlst = {};
            var all_grams = [];
            var optionDist = '';
            for (var i = 0; i < Jsondata.length; i++) {
                if (StateName == Jsondata[i].state_name && DistName == Jsondata[i].district_name && blockName == Jsondata[i].block_name) {

                    if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                        ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                        all_grams.push({ lg_gram: Jsondata[i].lg_gram, gram_panchayat_name: Jsondata[i].gram_panchayat_name });
                        //   $("#gram").append(optionDist);
                    }
                }
            }


            var GramArray = [];
            GramArray = all_grams.sort(function (a, b) {
                if (a < b) return -1;
                else if (a > b) return 1;
                return 0;
            });
            for (var i = 0; i < GramArray.length; i++) {
                if (GramArray[i] != null && GramArray[i] != "") {

                    optionDist += '<option value="' + GramArray[i].lg_gram + '">' + GramArray[i].gram_panchayat_name + '</option>';
                }
            }
            $("#gram").append(optionDist);
        }
        GetApprovedGpCount();
    }


