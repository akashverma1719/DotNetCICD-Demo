    function SessionInfo() {

        var obj = {};
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/WaterBudget_2526/State_SessionInfo_1",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/Home/LogOut";
                }
                else {
                    $('#Error_').text("");

                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').hide();
                    $('#YearLabel').hide();
                    $('#YearDropdownLabel').hide();
                    //$('#MonthLabel').hide();
                    //$('#MonthDropdownLabel').hide();

                    var Str = data.split(',');
                    if (Str[0] == "Admin") {
                        $('#StateLabel').hide();
                        $('#StateDropdownLabel').show();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $('#YearLabel').hide();
                        $('#YearDropdownLabel').show();
                        $(".loader").hide();
                        //$('#MonthLabel').show();
                        //$('#MonthDropdownLabel').show();

                    }
                    else if (Str[0] == "State Level Nodal Officer") {
                        State = Str[1];
                        off_1 = "state";
                        $('#StateLabel').show();
                        $('#StateDropdownLabel').hide();
                        $('#DistLabel').hide();
                        $('#DistDropdownLabel').show();
                        $('#BlockLabel').hide();
                        $('#BlockDropdownLabel').show();
                        $('#GramLabel').hide();
                        $('#GramDropdownLabel').show();
                        $('#YearLabel').hide();
                        $('#YearDropdownLabel').show();
                        $('#YearLabel').show();
                        $('#YearDropdownLabel').show();
                        $('#DropdownSearch_btn').show();
                        $(".loader").hide();
                        //$('#MonthLabel').hide();
                        //$('#MonthDropdownLabel').show();
                        State_Dropdown_Function();
