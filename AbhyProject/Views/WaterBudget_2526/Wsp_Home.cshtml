<main>
    <h2 class="Main_heading">Water Budgeting</h2>

    <div class="container-fluid">
        @*<h2 class="Main_heading">Water Budgeting</h2>*@
        <div class="navLabels">
            <div>

                <label>State :</label>
                <label>@Session["lg_stateName"]</label>
            </div>
            <span>&#62;&#62;</span>
            <div>
                <label>District :</label>
                <label>@Session["lg_distName"]</label>
            </div>
            <span>&#62;&#62;</span>
            <div>
                <label>Block/Taluk :</label>
                <label>@Session["lg_blockName"]</label>
            </div>
            <span>&#62;&#62;</span>
            <div>
                <label>Gram Panchayat :</label>
                <label>@Session["lg_gramName"]</label>
            </div>
        </div>
        <div class="wrapper">

            <div class="form-content">
                @*<form action="#">*@
                <div class="steps-wrapper">
                    <div class="steps-nav left"><i class="fa fa-chevron-left" aria-hidden="true"></i></div>
                    <div class="steps">
                        <ul>
                        </ul>
                    </div>
                    <div class="steps-nav right"><i class="fa fa-chevron-right" aria-hidden="true"></i></div>
                </div>
                <div id="wizard">
                    <!-- SECTION 1 -->
                    <h4></h4>
                    <section>
                        <h3 class="HeadingText">ग्राम पंचायत की मूलभूत जानकारी</h3>
                        <h3 class="HeadingText Eng_Heading">Gram Panchayat Basic Information</h3>
                        <div class="info">

                            <div class="row">
                                <div class="col-md-8">



                                    @using (Html.BeginForm("StepOne", "WaterBudget_2526", FormMethod.Post, new { @class = "stepForm form-div", id = "form_0" }))
                                    {
                                        <ul>
                                            <li class="row">
                                                <span class="col-md-7"><strong>1. राज्य :</strong> <br /><strong> State :</strong></span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary" id="lblstate">
                                                        <input type="text" class="form-control disabledInputcss2" id="txtStateName" style="color: #717171; font-weight: 500; font-size: 14px" disabled>
                                                        @Html.HiddenFor(model => model.wb_grampanchayat_basic_info.state_id)
                                                        @Html.HiddenFor(model => model.wb_grampanchayat_basic_info.year)

                                                    </p>
                                                </span>

                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>2. ज़िला :</strong> <br /><strong> District :</strong></span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        <input type="text" class="form-control disabledInputcss2" id="txtDistrictName" style="color: #717171; font-weight: 500; font-size: 14px;" disabled>
                                                        @Html.HiddenFor(model => model.wb_grampanchayat_basic_info.district_id)
                                                    </p>
                                                </span>


                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>3. ब्लॉक/तालुक :</strong> <br /><strong> Block / Taluk:</strong></span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        <input type="text" class="form-control disabledInputcss2" id="txtBlockName" style="color: #717171; font-weight: 500; font-size: 14px;" disabled>
                                                    </p>
                                                </span>
                                                @Html.HiddenFor(model => model.wb_grampanchayat_basic_info.block_id)
                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>4. ग्राम पंचायत नाम :</strong> <br /><strong> GP Name :</strong></span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        <input type="text" class="form-control disabledInputcss2" id="txtGPName" style="color: #717171; font-weight: 500; font-size: 14px;" disabled>
                                                        @Html.HiddenFor(model => model.wb_grampanchayat_basic_info.gp_id)
                                                    </p>
                                                </span>

                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>5. ग्राम पंचायत क्षेत्र (हेक्टेयर) :</strong> <br /><strong> GP area (ha) :</strong> <span class="text-danger">*</span></span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_grampanchayat_basic_info.gp_area, new { @class = "form-control input gp_area", placeholder = "Enter GP area (ha)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_grampanchayat_basic_info.gp_area, null, new { @class = "text-danger" })
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>6. वार्षिक वर्षा (मिमी) :</strong> <br /><strong> Annual Rainfall (mm) :</strong> <span class="text-danger">*</span></span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_grampanchayat_basic_info.annual_rainfall, new { @class = "form-control input rainfall", placeholder = "Enter  Annual Rainfall (mm)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_grampanchayat_basic_info.annual_rainfall, null, new { @class = "text-danger" })

                                                    @*<input type="text" class="form-control input" placeholder="Please Enter  Annual Rainfall (mm)">*@
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>7.  मानव आबादी (संख्या) :</strong> <br /><strong> Human population (Nos.) :</strong> <span class="text-danger">*</span></span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_grampanchayat_basic_info.human_population, new { @class = "form-control input population numeric", placeholder = "Enter Human population (Nos.)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_grampanchayat_basic_info.human_population, null, new { @class = "text-danger" })

                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-7"><strong>8.  पशुधन आबादी (संख्या) :</strong> <br /><strong> Livestock Population (Nos.) :</strong> <span class="text-danger">*</span></span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_grampanchayat_basic_info.livestock_population, new { @class = "form-control input livestock_population numeric", placeholder = "Enter Livestock Population (Nos.)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_grampanchayat_basic_info.livestock_population, null, new { @class = "text-danger" })
                                                </span>
                                            </li>
                                        </ul>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <img src="~/Content/waterbudget/images/step-1.png" class="w-100 Image_Icon" />
                                    <img src="~/Content/waterbudget/images/stepp-1.png" class="w-100" />
                                </div>
                            </div>

                        </div>


                    </section>

                    <!-- SECTION 2 -->
                    <h4></h4>
                    <section>
                        <h3 class="HeadingText"> अनुमानित भूजल उपलब्धता</h3>
                        <h3 class="HeadingText Eng_Heading"> Estimated Ground Water Availability</h3>
                        <div class="info">
                            <div class="row">
                                <div class="col-md-8">


                                    @using (Html.BeginForm("StepTwo", "WaterBudget_2526", FormMethod.Post, new { @class = "stepForm form-div", id = "form_1" }))
                                    {
                                        <ul>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>1. वार्षिक वर्षा (मीटर) :</strong> <br /><strong>
                                                        Annual Rainfall (m) :
                                                        <a data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="right" data-bs-title="(वार्षिक वर्षा (मिमी) / 1000)</br>(Annual Rainfall (mm) / 1000)">
                                                            <img src="~/Content/waterbudget/images/info-button.svg" width="16" height="16" />
                                                        </a>
                                                    </strong>
                                                </span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        @Html.TextBoxFor(model => model.wb_est_ground_water_avail.annual_rainfall, new { @class = "disabledInputcss form-control", @readonly = "readonly" })
                                                    </p>
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        2. वर्षा की अनुमानित मात्रा (हेक्टेयर मी) :
                                                        <a data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="right" data-bs-title="(ग्राम पंचायत क्षेत्र X वार्षिक वर्षा)</br>(Gram Panchayat Area X Annual Rainfall)">
                                                            <img src="~/Content/waterbudget/images/info-button.svg" width="16" height="16" />
                                                        </a>

                                                    </strong>
                                                    <br />
                                                    <strong> Estimated Volume of Rainfall (ha m) :</strong>
                                                </span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        @Html.TextBoxFor(model => model.wb_est_ground_water_avail.est_vol_rainfall, new { @class = "disabledInputcss form-control", @readonly = "readonly" })
                                                    </p>
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        3. वाष्पीकरण-उत्सर्जन हानि (हेक्टेयर मी) :
                                                        <a data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="right" data-bs-title="(कुल वर्षा की मात्रा का 30%)</br>(30 % of total volume of rainfall)">
                                                            <img src="~/Content/waterbudget/images/info-button.svg" width="16" height="16" />
                                                        </a>
                                                    </strong> <br /><strong> Evapotranspiration losses (ha.m) :</strong>
                                                </span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        @Html.TextBoxFor(model => model.wb_est_ground_water_avail.evapo_loss, new { @class = "disabledInputcss form-control", @readonly = "readonly" })

                                                    </p>
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        4. वर्षा से उपलब्ध अनुमानित जल (हेक्टेयर मी)
                                                        :
                                                        <a data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="right" data-bs-title="(वर्षा की अनुमानित मात्रा - वाष्पोत्सर्जन)</br>(Estimated Volume of Rainfall - Evapotranspiration)">
                                                            <img src="~/Content/waterbudget/images/info-button.svg" width="16" height="16" />
                                                        </a>
                                                    </strong> <br />
                                                    <strong>
                                                        Estimated Water Available from Rainfall  (ha m) :
                                                    </strong>
                                                </span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        @Html.TextBoxFor(model => model.wb_est_ground_water_avail.est_water_avai_rainfall, new { @class = "disabledInputcss form-control", @readonly = "readonly" })

                                                    </p>
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        5. भूजल में पुनर्भरण की अनुमानित मात्रा (हेक्टेयर मी)
                                                        :
                                                        <a data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="right" data-bs-title="(वर्षा की अनुमानित मात्रा  x12%)</br>(Estimated Volume of Rainfall X12%) ">
                                                            <img src="~/Content/waterbudget/images/info-button.svg" width="16" height="16" />
                                                        </a>
                                                    </strong> <br />
                                                    <strong>
                                                        Estimated Volume of Recharge into Groundwater (ha m) :
                                                    </strong>
                                                </span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        @Html.TextBoxFor(model => model.wb_est_ground_water_avail.est_vol_rech_gw, new { @class = "disabledInputcss form-control", @readonly = "readonly" })

                                                    </p>
                                                </span>
                                            </li>

                                        </ul>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <img src="~/Content/waterbudget/images/step-2.png" class="w-100 Image_Icon" />

                                </div>
                            </div>
                        </div>


                    </section>

                    <!-- SECTION 3 -->
                    <h4></h4>
                    <section>

                        <h3 class="HeadingText">   आपूर्ति पक्ष के हस्तक्षेप की योजना के लिए वर्षा से अनुमानित उपलब्धता</h3>
                        <h3 class="HeadingText Eng_Heading">Estimated Availability from Rainfall for planning of supply side interventions</h3>
                        <div class="info">
                            <div class="row">
                                <div class="col-md-8">



                                    @using (Html.BeginForm("StepThree", "WaterBudget_2526", FormMethod.Post, new { @class = "stepForm form-div", id = "form_2" }))
                                    {
                                        <ul>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        1. उपयोगी वर्षा अपवाह (हेक्टेयर मी) :
                                                        <a data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="right" data-bs-title="(वर्षा से उपलब्ध अनुमानित जल X 0.4 (अपवाह गुणांक))</br> (Estimated water available from rainfall X 0.4 (runoff coefficient)) ">
                                                            <img src="~/Content/waterbudget/images/info-button.svg" width="16" height="16" />
                                                        </a>
                                                    </strong> <br />
                                                    <strong>
                                                        Utilisable Rainfall Runoff(ha m)  :
                                                    </strong>
                                                </span>
                                                <span class="col-md-3">
                                                    <p class="m-0 text-secondary">
                                                        @Html.TextBoxFor(model => model.wb_est_avai_rainfall_supply_intervention.uti_rainfall_runoff, new { @class = "disabledInputcss form-control", @readonly = "readonly" })

                                                    </p>
                                                </span>
                                            </li>


                                        </ul>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <img src="~/Content/waterbudget/images/step-3.png" class="w-100 Image_Icon" />

                                </div>
                            </div>
                        </div>



                    </section>
                    <!-- SECTION 4 -->
                    <h4></h4>
                    <section>
                        <h3 class="HeadingText">सतही जल भंडारण की उपलब्धता</h3>
                        <h3 class="HeadingText Eng_Heading">  Availability of Surface Water Storage</h3>
                        <div class="info">
                            <div class="row">
                                <div class="col-md-8">


                                    @using (Html.BeginForm("StepFour", "WaterBudget_2526", FormMethod.Post, new { @class = "stepForm form-div", id = "form_3" }))
                                    {
                                        <ul>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        1. मौजूदा सतही जल निकायों/संरचनाओं की संख्या :
                                                    </strong> <br /><strong> Number of Existing Surface Water Bodies/Structures (Nos.) :</strong> <span class="text-danger">*</span>
                                                </span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_avai_surface_water_stor.exist_structure, new { @class = "form-control input BodiesStructure numeric", placeholder = "Enter Bodies/Structures (Nos.)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_avai_surface_water_stor.exist_structure, null, new { @class = "text-danger" })
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8"><strong>2. वार्षिक भरण संख्या (कम से कम 2 भरण) (संख्या) :</strong> <br /><strong> Annual Number of Fillings (at least 2 fillings) (Nos.) :</strong> <span class="text-danger">*</span></span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_avai_surface_water_stor.annual_filling, new { @class = "form-control input AnnualnoFilling numeric", placeholder = "Enter Annual Number of Filling (Nos.)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_avai_surface_water_stor.annual_filling, null, new { @class = "text-danger" })
                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8"><strong>3. संरचना की कुल भंडारण क्षमता (हेक्टेयर मी) :</strong> <br /><strong> Storage Capacity of the Structures (ha m)  :</strong> <span class="text-danger">*</span></span>
                                                <span class="col-md-3">
                                                    @Html.TextBoxFor(model => model.wb_avai_surface_water_stor.capacity_structure, new { @class = "form-control input StoreCapecity", placeholder = "Enter Storage Capacity of the Structures (ha m)", autocomplete = "off", maxlength = "8" })
                                                    @Html.ValidationMessageFor(model => model.wb_avai_surface_water_stor.capacity_structure, null, new { @class = "text-danger" })

                                                </span>
                                            </li>
                                            <li class="row">
                                                <span class="col-md-8">
                                                    <strong>
                                                        4. संरचनाओं की कुल भंडारण क्षमता (हेक्टेयर मी) :
