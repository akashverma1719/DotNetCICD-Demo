                approveButtonLi.classList.add('customButtonWrapper');
                rejectButtonLi.classList.add('customButtonWrapper');
           /* }*/
        }


        function showButtonsIfWizardPaneVisible() {
            let wizardPane = document.getElementById("wizard-p-11");
            if (wizardPane.style.display === "block" || window.getComputedStyle(wizardPane).display === "block") {
                let pane = document.querySelectorAll(".customButtonWrapper");
                pane.forEach((tabpane) => {
                    tabpane.style.display = "block";
                });
            } else {
                let pane = document.querySelectorAll(".customButtonWrapper");
                pane.forEach((tabpane) => {
                    tabpane.style.display = "none";
                });
            }
        }
        showButtonsIfWizardPaneVisible();
        let observer = new MutationObserver(function (mutations) {

            mutations.forEach(function (mutation) {
                if (mutation.attributeName === "style") {
                    showButtonsIfWizardPaneVisible();
                }
            });
            get_approved_reject_status();
        });
        observer.observe(document.getElementById("wizard-p-11"), { attributes: true });

        get_approved_reject_status();
    });

