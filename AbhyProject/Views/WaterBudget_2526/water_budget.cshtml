<style>
    .Select_option li select {
        border-radius: 25px;
        border: 1px solid #337ab7;
        width: 216px;
        height: 37px;
    }

    #DropdownSearch_btn a {
        border-radius: 25px;
        padding: 10px 24px;
        margin-left: 10px;
    }

        #DropdownSearch_btn a:hover {
            border-bottom: 0px;
            padding: 10px 24px;
        }

    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .totaldivwsphome > .totaldiv {
        display: inline-block;
        vertical-align: middle;
        margin-top: 15px;
    }
    /*.fade {
        opacity: 0 !important;
    }*/

    .arrow_ul_css > li {
        display: inline-block;
    }
    /*  .Select_option_div {
        background-color: gray;
        padding: 0px;
        color: #fff;
    }*/
    .maniullist1 {
        width: 100%;
        background: #fff;
        padding: 3px;
        margin: 0 0 30px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        transition: 400ms ease-in-out;
        cursor: pointer;
        align-items: center
    }

        .maniullist1 > li > a > span > img:hover {
            transform: translateY(-5px);
        }

    .maniullist1 {
        margin: 0px 0px 10px;
    }

    .ul_image_wsphome {
        list-style: none;
        padding: 0px;
    }

        .ul_image_wsphome > li > img {
            width: 100%
        }

    @@media screen and (max-width: 767px) and (min-width: 300px) {
        .ul_image_wsphome > li > img {
            width: 35%
        }
    }

    body {
        background: linear-gradient(#a5b7c5,#b6c4cf, #e2e7ec,#ffffff);
    }

    .total_div_wsp_home {
        height: 100%;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        padding: 0px;
    }

    .sub_total_div:hover {
        transition: all .2s ease-in-out;
        transform: scale(1.1);
        border-radius: 0.7em;
    }

    .sub_total_div > a {
        text-decoration: none;
    }

    .ul_image_wsphome > li > span {
        color: #000;
        text-decoration: none;
    }

    .sub_total_div {
    }
