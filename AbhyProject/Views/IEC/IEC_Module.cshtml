        var cumulative_total = $('#cumulative_total' + RowNo).val();
        var IEC_activity = $('#IEC_activity' + RowNo).val();
        var remark = $('#remark' + RowNo).val();

        if (activity == "0") {
            alert("Please Select Activity");
            i = 1;
        }
        else if (activity == "Others" && other_activity == "") {

            alert("Please Enter Other Activity");
            i = 1;
        }
        else if (other_activity == "Others" && sub_act1 == "Select Sub Activity ") {
            //alert("Please Select  Sub Activity");
            //i = 1;
        }
        else if (sub_act1 == "0") {

            alert("Please Enter Sub Activity");
            i = 1;
        }
        else if (activity != "" && sub_act1 == "Select Sub Activity ") {

            alert("Please Enter Sub Activity");
            i = 1;
        }
        else if (sub_act1 == "Others" && sub_activity_other == "") {
            alert("Please Enter Other Sub Activity");
            i = 1;
        }
        else if (number == "") {
            alert("Please Enter Number");
            i = 1;
        }
        else if (cumulative_total == "") {
            alert("Please Enter Cumulative");
            i = 1;
        }
        else if (IEC_activity == "") {
            alert("Please Enter IEC Activity");
            i = 1;
        }
        //else if (remark == "") {
        //    alert("Please Enter Remark");
        //    i = 1;
        //}

        if (i == 0) {


            var formdata = new FormData();
            formdata.append("id", id);
            formdata.append("activity", activity);
            formdata.append("other_activity", other_activity);
            formdata.append("sub_act1", sub_act1);
            formdata.append("sub_activity_other", sub_activity_other);
            formdata.append("number", number);
            formdata.append("cumulative_total", cumulative_total);
            formdata.append("IEC_activity", IEC_activity);
            formdata.append("remark", remark);

            $.ajax({
                url: '/IEC/Update_data',
