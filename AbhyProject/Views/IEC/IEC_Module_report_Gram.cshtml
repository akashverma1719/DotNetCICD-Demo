<script>
    function ReportPdf() {
        $("#Data1").width(2200);
        var element = document.getElementById('Data1');
        var w = screen.width;
        var h = screen.height;
        var opt = {
            margin: 0,

            filename: 'IEC GramPanchayat Level.pdf',
            image: { type: 'jpeg', quality: 1.0, w, h },
            pagebreak: { mode: 'avoid-all', before: '.page2el11' },
            html2canvas: { dpi: 192, letterRendering: true },
            jsPDF: { unit: 'pt', format: 'A2', orientation: 'landscape' }

        };
        html2pdf(element, opt);
        $("#Data1").width();
        $('#Data1').addClass('background_after_download');
        $('#Data1').addClass('table-condensed');

        $(".highcharts-credits").css("display", "none");
        $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");

        $('div#btnExport').addClass('hideDownload');

        $('div#btnExport1').addClass('hideDownload');

        setTimeout(function () {
            $('#Data1').removeClass('background_after_download');
            $(".gp_profile.table > tbody > tr > td").css("padding", "4px 5px");


            $('div#btnExport').removeClass('hideDownload');
            $('div#btnExport1').removeClass('hideDownload');
        }, 2000);
        window.setTimeout(set_detault, 1000);

    }
    function set_detault() {
        $("#Data1").width(1095);
    }

</script>

