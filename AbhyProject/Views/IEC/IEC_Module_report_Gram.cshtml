    function Get_Month_Number(month) {
        
        var month_num = "";
        switch (month) {
            case "1":
                month_num = 'April';
                break;
            case "2":
                month_num = 'May';
                break;
            case "3":
                month_num = "June";
                break;
            case "4":
                month_num = "July";
                break;
            case "5":
                month_num = "August";
                break;
            case "6":
                month_num = "September";
                break;
            case "7":
                month_num = "October";
                break;
            case "8":
                month_num = "November";
                break;
            case "9":
                month_num = "December";
                break;
            case "10":
                month_num = "January";
                break;
            case "11":
                month_num = "February";
                break;
            case "12":
                month_num = "March";
                break;
        }
        return month_num;
    }

    function Data_dist() {
        
       var State1 = '@Session["gstate"]';
       var Dist1 = '@Session["gdist"]';
       var Block1 = '@Session["gblock"]';
       var Gram1 = '@Session["ggram"]';
       var state_name1 = '@Session["state_name"]';
       var dist_name = '@Session["dist_name"]';
       var block_name = '@Session["block_name"]';
       var gram_name1 = '@Session["gram_name"]';
       var year1 = '@Session["year1"]';
       var month1 = '@Session["month1"]';


        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/IEC/Data_get_gram',
            data: "{'State1':'" + State1 + "' ,'Dist1':'" + Dist1 + "', 'Block1':'" + Block1 + "' , 'Gram1':'" + Gram1 + "' , 'state_name1':'" + state_name1 + "' ,'dist_name':'" + dist_name + "', 'block_name':'" + block_name + "' , 'gram_name1':'" + gram_name1 + "', 'year1':'" + year1 + "' , 'month1':'" + month1 + "'}",
            dataType: 'JSON',
            success: function (data) {
                
                if (data == "Logout") {
                      window.location = "/Home/LogOut";
                }

                var tr = '';
                var a = 0;
                if (data.length != 0) {
                    for (var i = 0; i < data.length; i++) {
                        var reject_status = data[i].reject_status;
                        if (reject_status == null) {
                            reject_status = "";
                        }
                        var approve_status = data[i].approve_status;
                        if (approve_status == null) {
                            approve_status = "";
                        }
                        else if (approve_status == "District") {
                            approve_status = "Submited To DPMU";
                        }
                        else if (approve_status == "Approved") {
                            approve_status = "Approved By DPMU";
                        }
                        else if (approve_status == "Gram") {
                            approve_status = "Rejected By DPMU";
                        }
                        tr += '<tr id="' + i + '"><td>' + (++a) + '</td><td>' + data[i].state_name + '</td><td>' + data[i].district_name + '</td><td>' + data[i].block_name + '</td><td>' + data[i].gpname + '</td><td>' + data[i].activity + '</td><td>' + data[i].activity_other + '</td><td>' + data[i].sub_activity + '</td><td>' + data[i].sub_activity_other + '</td><td>' + data[i].number + '</td><td>' + data[i].cumulative_total + '</td><td>' + data[i].IEC_activity + '</td><td>' + data[i].remark + '</td><td>' + approve_status + '</td><td>' + reject_status + '</td></tr> ';

                    }
                }
                if (tr == '') {
                    tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                    $('#tbldata').html(tr);
                }
                else {
                    $('#tbldata').html(tr);
                }

            }
        });
    }



</script>