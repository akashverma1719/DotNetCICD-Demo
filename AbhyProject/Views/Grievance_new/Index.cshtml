        $('#ddlstatte').hide();
        $('#ddldist').hide();
        $('#ddlstate_show').hide();
        $('#other').hide();

        var fin_year = getCurrentFiscalYear();

        if (fin_year == "2021-22") {
            year = "2021-22"
        } else if (fin_year == "2022-23") {
            year = "2022-23";
        } else if (fin_year == "2023-24") {
            year = "2023-24"
        }else if (fin_year == "2024-25") {
