<script src="~/Content/Website/js/vendor/jquery-1.12.4.min.js"></script>
<title>New Grievance Registration</title>

<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }
    .form-group .form-control {
        margin-top: 5px;
    }

    .btn-success,
    .btn-danger {
        float: none;
        right: 0px;
        width: 100px;
    }

    .msg {
        color: red !important;
        font-weight: bold;
    }

    .body {
        font-family: "Open Sans", Helvetica, Arial, sans-serif;
    }



    .hpanel .panel-body {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        padding: 20px;
        position: relative;
        border-top: 2px solid #62cb31;
    }

    .hpanel {
        border: none !important;
        box-shadow: none;
        margin-bottom: 25px;
    }

    .col-md-12 {
        font-size: 16px;
    }

    .about-area .col-md-6 img {
        margin-top: 0px;
    }

    h4 {
        font-size: 20px;
    }

    .refreshicon {
        position: relative;
        right: 21px;
        top: 9px;
    }

    .highlight {
        color: red;
    }

    .border_radius {
        border-radius: 25px !important;
    }
</style>
