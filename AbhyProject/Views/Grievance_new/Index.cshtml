<script>

    function checkmobile() {
        var mobile = $("#mobile").val();
        if (mobile == "0" || mobile == "1" || mobile == "2" || mobile == "3" || mobile == "4" || mobile == "5" || mobile == "5") {
            alert("Please Enter Valid Mobile No ");
            $("#mobile").val("");
        }

    }


    function district() {

            $.ajax({
                url: '/Grievance_new/Dist',
                type: 'POST',
                dataType: 'json',
                contentType: 'application/json',
                success: function (data) {
                    var option_state = ' <option value="0"> Select Grievance Addressed To District </option>';



                    if (data.length != 0) {

                        for (var i = 0; i < data.length; i++) {

                            if (data[i] != null && data[i] != "") {
                                option_state += '<option value="' + data[i].district_id + '">' + data[i].district_name + '</option>';
                            }
                        }
                    }
                    $("#spnstate_get").html(option_state);

                }
            });
    }
    function state_name() {

        $('#state_get').val("");
        var drpid = $('#spnstate_get').val();
            /*alert(drpid);*/
            $.ajax(
                {
                    type: 'POST',
                    dataType: 'JSON',
                    url: '/Grievance_new/state_name',
                    data: { id: drpid },
                    success: function (data) {

                        var option_district = '';
                        if (data.length != 0) {
                            for (var i = 0; i < data.length; i++) {
                                if (data[i] != null && data[i] != "") {
                                    option_district += '<option value="' + data[i].state_id + '">' + data[i].state_name + '</option>';
                                }
                            }
                        }
                        $("#state_get").html(option_district);
                    }
                });

    }
