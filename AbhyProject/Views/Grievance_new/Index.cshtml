        var files = $('#files').val();
        var filesa = $('#files').get(0);
        var filesaa = filesa.files;
        const oFile = document.getElementById("files").files[0];
        if (oFile != undefined) {
            if (oFile.size > 10485760) // 10 MiB for bytes.
            {
                $('#btnSubmit').prop('disabled', false);
