    function other_text() {
        var ddl = $('#Grievance_type').val();
        if (ddl == 'Others') {
            $('#grv_type').show();
            $('#other').show();
        }
        else {
            $('#Grievance_other').val("");
            $('#grv_type').show();
            $('#other').hide();
        }
