        }
        else if (state == "District" && spnstate_get == '0') {
            i = 1;
            $('#btnSubmit').prop('disabled', false);
            alert(" Please Select Grievance Addressed To District");
            return;
        }
        else if (complaint_name == "") {
            i = 1;
            $('#btnSubmit').prop('disabled', false);
            alert(" Please Enter Complainant Name ");
            return;
        }
        else if (email == "") {
            i = 1;
            $('#btnSubmit').prop('disabled', false);
            alert(" Please Enter Email  ");
            return;
        }
        else if (mobile == "") {
