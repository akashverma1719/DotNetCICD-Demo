@{
    ViewBag.Title = "grm_dashboard";
    Layout = null;
}


<meta name="viewport" content="width=device-width" />
<title>grm_dashboard</title>
<title></title>
<link rel="icon" type="image/png" sizes="32x32" href="~/Content/WspImages/Favicon 32 px.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/Content/WspImages/Favicon 96 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="57x57" href="~/Content/WspImages/Favicon 57 px.png">
<link rel="apple-touch-icon" type="image/png" sizes="114x114" href="~/Content/WspImages/Favicon 114 px.png">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/datecss.css" rel="stylesheet" />
<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/wspView.css" rel="stylesheet" />
<link href="~/Content/css/Dli_css.css" rel="stylesheet" />
<script src="~/Content/JS_Files/IdealState.js"></script>

<style>
    .msg {
        color: red !important;
        font-weight: bold;
    }

    .margin-bottom-60 {
        margin-bottom: 60px;
    }

    .body {
        font-family: "Open Sans", Helvetica, Arial, sans-serif;
    }

    .hpanel .panel-body {
        background: #fff;
        border: 1px solid #e4e5e7;
        border-radius: 2px;
        padding: 20px;
        position: relative;
        border-top: 2px solid #62cb31;
    }

    .hpanel {
        border: none !important;
        box-shadow: none;
        margin-bottom: 25px;
    }

    .col-md-12 {
        font-size: 14px;
    }
    /*.grvancestatus {
        border: 1px solid yellow;
        background: yellow;
    }*/
    .grm_selecting > li > label {
        padding: 6px 0px;
        border: 1px solid #000;
        background: #337ab7;
        color: #fff !important;
        width: 200px;
        text-align: center;
        font-size: 15px;
    }


    ul.grvancestatus,
    ul.grvancestatus1 {
        line-height: 2.6em;
        font-size: 20px;
    }

    ul.grvancestatus1 {
        /*padding:0px 0px 0px 85px;*/
    }



    .grvancestatus2 {
        border: 1px solid #ddd;
        border-top: 1px solid green;
        border-bottom: 4px solid green;
    }

    ul.grvancestatus > li > label {
        font-size: 18px;
    }

    .gravancestate3 {
        font-size: 18px;
    }

    .Approvedclass {
        text-align: right;
    }

    .btn-success {
        float: none;
    }

    button.btn-success {
        right: 0px;
    }

    h4 {
        font-size: 20px;
    }

    span.somestatusid {
        padding: 5px;
        font-weight: 600;
    }

    .content-header > h4 {
    }

    .jumbotron {
        padding: 2rem 1rem;
        margin-bottom: 10px;
        background-color: #e9ecef;
        border-radius: .3rem;
    }

    .my-card {
        position: absolute;
        left: 45%;
        top: -20px;
        border-radius: 50%;
    }

    .text-info {
        color: #17a2b8 !important;
    }

        .text-info > h4 {
            padding: 10px;
        }

    .p-3 {
        padding: 1rem !important;
    }

    .text-success {
        color: #28a745 !important;
    }

    .border-success {
        border-color: #28a745 !important;
    }

    .text-success > h4 {
        padding: 10px;
    }

    .shadow {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .border-info {
        border-color: #17a2b8 !important;
    }

    .text-danger > h4 {
        padding: 10px;
    }

    .border-danger {
        border-color: #dc3545 !important;
    }

    .wrapper11 {
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        padding: 7px 0px;
    }

    .card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        background-color: #fff;
        background-clip: border-box;
        border: 1px solid rgba(0,0,0,.125);
    }
</style>
<style>

    /*table fix code*/

    table {
        text-align: left;
        position: relative;
        border-collapse: collapse;
    }

    thead {
        background: white;
        position: sticky;
        top: 0;
    }

    .Popup {
        width: 400px;
        background: #fff;
        border-radius: 6px;
        position: absolute;
        top: 0%;
        left: 50%;
        transform: translate(-50%,-50%) scale(0.1);
        text-align: center;
        padding: 0 30px 30px;
        color: #333;
        visibility: hidden;
        transition: transform 0.4s, top 0.4s;
    }

    .open-popup {
        visibility: visible;
        top: 50%;
        transform: translate(-50%,-50%) scale(1);
    }

    .Popup img {
        width: 100px;
        margin-top: -50px;
        border-radius: 50px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    .Popup h2 {
        font-size: 38px;
        font-weight: 500;
        margin: 30px 0 10px;
    }

    .Popup button {
        width: 100px;
        margin-top: 50px;
        padding: 10px 0;
        background: #6fd649;
        color: #fff;
        border: 0;
        outline: none;
        font-size: 18px;
        border-radius: 4px;
        cursor: pointer;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    /*ends here*/

</style>

<header class="header hederImage">
