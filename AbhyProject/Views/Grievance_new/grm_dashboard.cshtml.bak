                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
<main>
    <div class="row">
        <div class="">
            <div class="wrapper11">
                <div class="col-md-12 col-sm-12 col-lg-12">
                    <div class="jumbotron">
                        <div class="row w-100">
                            <div class="col-md-4">
                                <div class="card border-info mx-sm-1 p-3">
                                    <div class="card border-info shadow text-info p-3 my-card"><span class="fa fa-cogs" aria-hidden="true"></span></div>
                                    <div class="text-info text-center mt-3">
                                        <h4>Total</h4>
                                    </div>
                                    <div class="text-info text-center mt-2">
                                        <h1>
                                            <label id="Total_Users" style=" font-family: fantasy; font-size: 30px; color: #000;">0</label>

                                        </h1>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-success mx-sm-1 p-3">
                                    <div class="card border-success shadow text-success p-3 my-card"><span class="fa fa-envelope" aria-hidden="true"></span></div>
                                    <div class="text-success text-center mt-3">
                                        <h4>Resolved</h4>
                                    </div>
                                    <div class="text-success text-center mt-2">
                                        <h1>
                                            <label id="Approved_users" style=" font-family: fantasy; font-size: 30px; color: #000;">0</label>

                                        </h1>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-danger mx-sm-1 p-3">
                                    <div class="card border-danger shadow text-danger p-3 my-card"><span class="fa fa-close" aria-hidden="true"></span></div>
                                    <div class="text-danger text-center mt-3">
                                        <h4>Pending</h4>
                                    </div>
                                    <div class="text-danger text-center mt-2">
                                        <h1>
                                            <label id="Pending_users" style=" font-family: fantasy; font-size: 30px; color: #000;">0</label>


                                        </h1>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div class="row container-fluid">
        <div class="col-md-12 col-sm-12">
            <div class="selectdistshowoption selectdistshowoption_state">
                <ul class="Select_option selectbackhome grm_selecting">
                    <li>
                        <label id="lblstate">State:</label>
                        <label id="spnstate"></label>
                    </li>

                </ul>
                <ul class="pull-right" style="list-style:none">
                    <li>
                        <a href="~/GRM/GRM_dasbord" class="btn btn-success"><i class="zmdi zmdi-hc-lg  fa fa-angle-double-left"> </i> Back To Modules</a>
                    </li>
                </ul>
            </div>
            <div class="selectdistshowoption selectdistshowoption_Admin">
                <ul class="Select_option selectbackhome grm_selecting">
                    <li>
                        <label>
                            Select State
                        </label>
                    </li>
                    <li>
                        <select class="form-control" id="States_Dropdown" onchange="Grivance_Info()">
                        </select>
                    </li>

                </ul>
                <ul class="pull-right" style="list-style:none">
                    <li>
                        <button class="btn btn-success" id="excel" onclick="Create_Excel()">Export (Excel)</button>
                        <a href="~/GRM/GRM_dasbord" class="btn btn-success"><i class="zmdi zmdi-hc-lg  fa fa-angle-double-left"> </i> Back To Modules</a>
                    </li>
                </ul>
            </div>
            @*<div class="text-right">
                    <button class="btn btn-success btn_disabled" onclick="Reporting()">Report</button>
                </div>*@
        </div>

        <div class="col-md-12 margin-bottom-60">
            <div class="b_part_div">
                <div class="panelbodyheading">
                    Grievance Management
                </div>

                <div class="tbl-responsive" style="overflow-x:scroll;overflow-y:scroll;height:350px; font-size:12px;">
                    <table id="TblData_abc_part1" class="GWL_deviation_table table table-bordered table-responsive table-__web-inspector-hide-shortcut__">
                        <thead>
                            <tr class="info">
                                <th class="text-center">S.No.</th>
                                <th class="text-center">Grievance ID</th>
                                <th class="text-center">Registration Mode</th>
                                <th class="text-center">Subject</th>
                                <th class="text-center">Grievance Type </th>
                                <th class="text-center">Grievance Addressed To States</th>
                                <th class="text-center">Complainant Name</th>
                                <th class="text-center">Email</th>
                                <th class="text-center">Mobile Number</th>
                                <th class="text-center">Phone Number</th>
                                <th class="text-center">Address</th>
                                <th class="text-center">Grievance Description</th>
                                <th class="text-center">Supported Document</th>
                                <th class="text-center">Registation Date</th>
                                <th class="text-center">Stage of Application</th>
                                <th class="text-center">Officer Name</th>
                                <th class="text-center">Grievance Status</th>
                                <th class="text-center" style="padding-right: 90px;padding-left:70px">Description of Resolution Provided</th>
                                <th class="text-center" style="padding-right: 70px;"> Mode of disposal </th>
                                <th class="text-center" style="padding-right: 70px;">Upload Document</th>
                                <th class="text-center">Resolution Status</th>
                                <th class="text-center">Forwarded Status</th>
                                <th class="text-center">Feedback Satisfaction</th>
                                <th class="text-center">Resolved Date</th>
                            </tr>


                        </thead>
                        <tbody id="TblData_abc_part">
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    <div class="Popup" id="pop">
        @*<img src="~/Content/Agriculture_icons/gmail.png" />*@
        <h2>Forward Mail</h2>

        <label>
            Select State :
        </label>
        <div id="npmulevel">
            <select class="form-control" id="States_Dropdown_mail" onchange="stateonchange()">
            </select>
        </div>
        <div id="spmulevel">
            <label id="spnstate_spmu"></label>
        </div>
        <br />
        <div id="distnpmu">
            <label>
                Select District :
            </label>

            <select class="form-control" id="district_Dropdown_mail">
                <option value="0">Select District Name</option>
            </select>
        </div>
        <div>
            <button type="button" style="background:blue; width:130px;" id="send_npmu" onclick="closepop_NPMU()">Send to NPMU</button>
            <button type="button" id="send_state" onclick="closepop()">Send</button>
            <button type="button" id="send_npmu_mail" onclick="closepop_npmu()">Send</button>
            <button type="button" style="background:red;" onclick="closepopbutton()">Close</button>
        </div>



    </div>

    <section>
        <div id="progress">
            <ul id="progress-ui" class="nav-tabs" role="tablist" data-tabs="tabs" style="padding:0px">
                <li id="Surface-water" class="progress-group set tabs_menu sru_menu active">
                    <span class="progress-group-label" data-target="#music" data-toggle="tab"> Grievance Management</span>



                    <div class="tri shadow"></div>
                    <div class="tri"></div>
                </li>
            </ul>

        </div>
    </section>
</main>
<p id="GFG_DOWN" style="color:green; font-size: 20px; font-weight: bold;">
</p>
<script>
    var StateName = "";
    var Access_Auth = "";
    var StateOfficer = "";
    var Email = "";
    $(document).ready(function () {
        debugger;
        Access_Auth = '@Session["Access_Auth"]';
        Email = '@Session["Email"]';
        if (Access_Auth == 'readonly') {

            $('.btn_disabled').prop("disabled", true);

        }
         StateOfficer = '@Session["Officer"]';
                if (StateOfficer == "") {
                    window.location = "/WspNew/WSP_GWM_HOME";
        }
        StateOfficer = '@Session["Officer"]';
        if (StateOfficer == "Gram Panchyat Nodal Officer" || StateOfficer == "District Level Nodal Officer" ) {
                    window.location = "/WspNew/WSP_GWM_HOME";
        }



        SessionInfo();
        $('#Approved_users').text('0');
        $('#Total_Users').text('0');
        $('#Pending_users').text('0');
    });

    function Reporting() {
        if (StateName != "") {

            window.location = "/Grievance_new/grm_report";
        }
        else {

            alert("Please Select StateName");
        }
    }
    function Create_Excel() {

        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
            if (StateName == "0") {
                alert("Please Select State");
                return false;
            }
            {
                window.location.href = "/Grievance_new/Excel_state_level?State1=" + StateName;

            }
        }
        else if (StateOfficer == "State Level Nodal Officer") {
            {
                window.location.href = "/Grievance_new/Excel_state_level?State1=" + StateName;

            }
        }

    }
    var StateName_mail = "";
    function SessionInfo() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/mis_new/State_SessionInfo',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                debugger;
                StateName = "ALL";
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                else if (data == "Admin") {
                    $('#spnstate').text('');
                    $('#spnstate_spmu').text('');
                    $('.selectdistshowoption_Admin').show();
                    $('.selectdistshowoption_state').hide();
                    $('#npmulevel').show();
                    $('#spmulevel').hide();
                    $('#send_npmu').hide();
                    $('#distnpmu').hide();
                    $('#send_npmu_mail').show();
                    $('#send_state').hide();
                    State_Dropdown();
                    State_Dropdown_mail();
                    Info1();

                }
                else {
                    StateName = data;
                    StateName_mail = data;
                    $('#spnstate').text(data);
                    $('#spnstate_spmu').text(data);

                    $('.selectdistshowoption_Admin').hide();
                    $('.selectdistshowoption_state').show();
                    $('#npmulevel').hide();
                    $('#spmulevel').show();
                    $('#send_npmu').show();
                    $('#distnpmu').show();
                    $('#send_npmu_mail').hide();
                    $('#send_state').show();
                    district_name();
                    Info1();


                }



            }

        });
    }
    function State_Dropdown() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/mis_new/PIP_Agency_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                slection_options_b = '<option value="0">Select State</option>';
                slection_options_b += '<option value="ALL">ALL</option>';
                slection_options_b += '<option value="NPMU">NPMU</option>';
                var AwpStateArr = [];

                for (var i = 0; i < data.length; i++) {
                    if (data[i].observation_type == "awp") {
                        AwpStateArr.push(data[i].state_name)
                    }
                }

                AwpStateArr.sort();
                AwpStateArr.forEach((val) => {
                    slection_options_b += '<option value="' + val + '"> ' + val + ' </option>';

                });

                $('#States_Dropdown').html(slection_options_b);
                Info();

            }

        });
    }
    function State_Dropdown_mail() {
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/mis_new/PIP_Agency_Info',
            data: '',
            dataType: 'JSON',
            success: function (data) {
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                slection_options_b = '<option value="0">Select State Name</option>';
                var AwpStateArr = [];

                for (var i = 0; i < data.length; i++) {
                    if (data[i].observation_type == "awp") {
                        AwpStateArr.push(data[i].state_name)
                    }
                }

                AwpStateArr.sort();
                AwpStateArr.forEach((val) => {
                    slection_options_b += '<option value="' + val + '"> ' + val + ' </option>';

                });

                $('#States_Dropdown_mail').html(slection_options_b);


            }

        });
    }
    function stateonchange() {

        var Statename_npmu = $('#States_Dropdown_mail').val();
        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
            if (Statename_npmu == "NPMU") {
                StateName_mail = Statename_npmu;
                $('#distnpmu').hide();
            }
            else {
                $('#distnpmu').hide();
                StateName_mail = Statename_npmu;
                district_name();
            }
        }
        else {
            if (Statename_npmu == "NPMU") {
                StateName_mail = Statename_npmu;
                $('#distnpmu').hide();
            }
            else {
                $('#distnpmu').show();
                StateName_mail = Statename_npmu;
                district_name();
            }
        }
    }
    function district_name() {

                $.ajax({
                    type: 'GET',
                    contentType: 'application/json; chatset=utf-8',
                    url: '/Grievance_new/district_name',
                    data: { 'StateName': StateName_mail },
                    dataType: 'JSON',
                success: function (data) {


                    if (data == "0") {
                        option_district = '<option value="0">Select District Name</option>';
                    }
                    else {
                        option_district = '<option value="0">Select District Name</option>';
                        for (var i = 0; i < data.length; i++) {
                            if (data[i] != null && data[i] != "") {
                                option_district += '<option value="' + data[i].district_name + '">' + data[i].district_name + '</option>';
                            }
                        }

                    }
                    $("#district_Dropdown_mail").html(option_district);
                }
            });

    }
    function Grivance_Info() {
        var Statename = $('#States_Dropdown').val();
        if (StateName == "ALL") {
            StateName = "ALL";
            Info();
        }
        if (Statename == "0") {
            alert("Please Select StateName")
        }
        else {
            StateName = Statename;

            Info();
        }
    }

    var OfficersInfo = "";
    function Info1() {
        debugger;
        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance_new/Grievance_Info_statewise_Officers_List',
            data: { 'StateName': StateName },
            dataType: 'JSON',
            success: function (data) {

                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (data.length != 0) {

                    OfficersInfo = data;
                }
                Info();
            }
        });
    }
    function Info() {

        $.ajax({
            type: 'GET',
            contentType: 'application/json; chatset=utf-8',
            url: '/Grievance_new/Grievance_Info_statewise_GrmDB',
            data: { 'StateName': StateName },
            dataType: 'JSON',
            success: function (data) {

                var Total = 0;
                var Approved_total = 0;
                var Pending_total = 0;
                var tr = '';
                if (data == "Logout") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (data.length != 0) {

                    for (var i = 0; i < data.length; i++) {

