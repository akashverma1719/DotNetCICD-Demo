    function approve_state(id, RowNo) {


        var i = 0;
        var id = id;
        var process = $('#process' + RowNo).val();
        var mode = $('#mode' + RowNo).val();
        if (process == "") {
            alert("Please Enter Description of Resolution Provided")
            return false;
        }
        if (mode == "0") {
            alert("Please Select Mode of disposal")
            return false;
        }
        if (i == 0) {


            var formdata = new FormData();
            formdata.append("id", id);
            formdata.append("process", process);
            formdata.append("District_name", mode);
            formdata.append("files", jQuery('#file' + RowNo).get(0).files[0]);
            $.ajax({
                url: '/Grievance_new/approve_data_state',
                data: formdata,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (response) {

                    alert(response);
                    if (response == "SessionTimeOut") {
                        window.location = "/WspNew/WSP_GWM_HOME";
                    }
                    Info();
                },
                error: function () {
                    alert('Approved Failed');
                }
            });
        }


    }
    let popup = document.getElementById("pop");

    var oldid = "";
    function forward(id, RowNo) {

        oldid = id;
        popup.classList.add("open-popup");

    }

    var oldid_npmu = "";
    function forward_npmu(id, RowNo) {

        oldid_npmu = id;
        popup.classList.add("open-popup");

    }

    function closepop() {
        debugger;
        var id = oldid;
        var state = StateName_mail;
        var dist = $('#district_Dropdown_mail').val();
        if (state == "" || state == "0") {
            alert("Please Select State Name")
            return false;
        }
        if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {

        }
        else if (state == "NPMU") {

        }
        else {
         if (dist == "0") {
            alert("Please Select District Name")
            return false;
            }
        }
        var formdata = new FormData();
        formdata.append("id", id);
        formdata.append("state", state);
        formdata.append("dist", dist);
        $.ajax({
            url: '/Grievance_new/mail_forward',
            data: formdata,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (response) {
                alert(response);
				Info();
                popup.classList.remove("open-popup");

                if (response == "SessionTimeOut") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
                    $('#States_Dropdown_mail').val('0');
                    $('#district_Dropdown_mail').val('0');
                }
                else {
                    $('#district_Dropdown_mail').val('0');
                }

            },
            error: function () {
                alert('Not Forward Mail');
            }
        });

    }

    function closepop_npmu() {
        debugger;
        var id = oldid_npmu;
        var state = StateName_mail;
        var dist = $('#district_Dropdown_mail').val();
        if (state == "" || state == "0") {
            alert("Please Select State Name")
            return false;
        }
        var formdata = new FormData();
        formdata.append("id", id);
        formdata.append("state", state);

        $.ajax({
            url: '/Grievance_new/mail_forward_npmu',
            data: formdata,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (response) {
                alert(response);
                Info();
                popup.classList.remove("open-popup");

                if (response == "SessionTimeOut") {
                    window.location = "/WspNew/WSP_GWM_HOME";
                }
                if (StateOfficer == "Admin" || StateOfficer == "National Level Nodal Officer") {
                    $('#States_Dropdown_mail').val('0');
                    $('#district_Dropdown_mail').val('0');
                }
                else {
                    $('#district_Dropdown_mail').val('0');
                }

            },
            error: function () {
                alert('Not Forward Mail');
            }
        });

    }

    function closepopbutton() {

        popup.classList.remove("open-popup");

    }

    function closepop_NPMU() {
        debugger;
        StateName_mail = "NPMU";
        $('#distnpmu').hide();
        $('#send_state').prop('disabled', true);
        closepop();
    }

</script>