        function setActiveTab() {
            // Get the current page URL
            const currentUrl = window.location.pathname;

            // Get all tab links
            const tabLinks = document.querySelectorAll('.tab-link');

            // Remove the active class from all tab links
            tabLinks.forEach(tab => tab.classList.remove('active'));

            // Add the active class to the correct tab link based on the current URL
            if (currentUrl.includes('report_IECMonthly')) {
                document.querySelector('li[data-tab="menu-11"]').classList.add('active');
            } else if (currentUrl.includes('report_IEC')) {
                document.querySelector('li[data-tab="menu-12"]').classList.add('active');
            }
        }

        // Call the function to set the active tab when the page loads
        window.onload = setActiveTab;
    });


</script>

