    </center>
    <div class="row" id="tablediv">
        <div class="tab-content">
            <!--2nd Water Budget Form-->
            <div role="tabpanel" class="tab-pane fade in active" id="WaterbudgetingformWBF">

                @*<div class="col-md-12 scrollform">*@
                <div class="col-md-12">
                    <!-- Accordion -->
                    <div class="" id="">
                        <div class="col-md-15">
