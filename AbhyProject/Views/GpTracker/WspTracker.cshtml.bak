                            <option value="2023-24" selected>2023-24</option>

                            @*<option value="2023">2024-25</option>*@
                            @*<option value="2026">2026</option>*@
                        </select>
                    </li>

                    @*<li id="MonthDropdownLabel">

                            <select class="form-control" id="month" onchange="Month_change()">
