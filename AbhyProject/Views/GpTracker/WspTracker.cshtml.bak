<style>
    .loader {
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        position: fixed;
        display: block;
        opacity: 0.95;
        visibility: visible;
        background-color: #fff;
        z-index: 9999;
        text-align: center;
    }


    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }

    .loader > img {
        top: 45%;
        left: 45%;
        position: fixed;
        height: 150px;
        width: 150px;
    }

    .database_trainer_row > h3 {
        background-color: #72a230;
        color: #fff;
        padding: 7px 15px;
        font-size: 18px;
        margin: 6px 0px;
    }

    table#TblData_b_part tr.info > th,
    table#TblData_c_part tr.info > th,
    table#TblData_d_part tr.info > th,
    table#TblData_e_part tr.info > th,
    table#TblData_abc_part1 tr.info > th,
    table#TblData_jj_part1 tr.info > th,
    table.GWL_deviation_table tr.info > th,
    table#TblData_g_part tr.info > th {
        background-color: #337ab7;
        color: #fff;
    }

    .E_table_header > h4 {
        color: #337ab7;
        padding: 10px 0px;
    }

    .alertshowingdiv {
        height: 25px;
    }

        .alertshowingdiv > label {
            color: red;
            font-size: 16px;
        }

    #breadcrumb {
        color: #0000ff;
        font-size: 15px;
        margin: 0;
        height: 15px;
        margin-bottom: 10px;
    }

        #breadcrumb a {
            color: #0000ff;
            text-decoration: underline;
        }

    ul#myTabs > li > a > span > img {
        height: 26px;
        width: 26px;
    }

    ul.ReRecharge_list > li > span {
        width: 70%;
    }

    ul#submenu1 > li > span {
        font-size: 17px;
    }

    ul.imgHome > li > a > span {
        font-size: 17px;
        text-decoration: none;
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

        ul.imgHome > li > a > span :hover {
            text-decoration: none;
        }

    ul.imgHome > li > a > label {
        font-size: 13px;
        text-decoration: underline;
        color: #fff;
        padding: 0px 0px 0px 5px;
        margin: 0;
        height: 15px;
    }

    ul.imgHome > li > label {
        color: #fff;
        padding: 0px 0px 0px 5px;
    }

    ul.imgHome > li > a > span > img,
    ul.imgHome > li > span > img {
        width: 25px;
    }

    ul.imgHome > li > a > label {
        padding: 5px 0px 0px 0px;
    }

    .nav-justified {
        padding-bottom: 0em;
    }

    ul.imgHome > li > img,
    ul.imgHome > li > a > img {
        width: 25px !important;
    }

    .highcharts-background {
        /*width: 100% !important;*/
    }

    .highcharts-title {
        display: none;
    }

    span.marqueegwr {
        font-weight: 700;
        margin-top: 10px;
        /*font-family: raleway;*/
        color: #333;
        font-size: 1vw;
    }

    .modal-backdrop.in {
        z-index: 0px !important;
    }




    .loading-inactive {
        opacity: 0;
        visibility: hidden;
    }



    ul.btnall > li {
        display: inline-block;
    }

    .backgroundtr {
        background-color: lightgray !important;
    }

        .backgroundtr:hover {
            background-color: #fff !important;
        }

    .backgroundtr1 {
        background-color: lightgoldenrodyellow !important;
    }

        .backgroundtr1:hover {
            background-color: #fff !important;
        }
</style>
<style>
    .under_list > li {
        list-style: none;
        padding: 5px;
        font-size: 15px;
        font-weight: 600;
    }

        .under_list > li > span > input {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

        .under_list > li > span > select {
            width: 500px;
            height: 30px;
            padding: 3px 10px;
            display: inline;
        }

    .panel-title {
        font-size: 18px;
        font-weight: 700;
    }

    .ullistdiv_menu {
        margin: 10px 0px;
    }

    .firstformtable > thead > tr > td {
        padding: 5px;
        font-weight: 600;
    }

    * {
        box-sizing: border-box;
    }

    panel-group .panel {
        border-radius: 0;
        box-shadow: none;
        border-color: #EEEEEE;
    }

    .panel-default > .panel-heading {
        padding: 0;
        border-radius: 0;
        color: #212121;
        /*background-color: #FAFAFA;
            border-color: #EEEEEE;*/
    }




    .panel-title > a {
        display: block;
        padding: 7px;
        text-decoration: none;
    }

    .more-less {
        float: right;
        color: #212121;
    }

    .panel-default > .panel-heading + .panel-collapse > .panel-body {
        border-top-color: #EEEEEE;
    }


    .demo-footer {
        position: fixed;
        bottom: 0;
        width: 100%;
        padding: 15px;
        background-color: #212121;
        text-align: center;
    }

        .demo-footer > a {
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            color: #fff;
        }

    .panel-heading {
        text-align: left;
        font-size: 19PX;
    }

    .panel-body {
        text-align: left;
    }

    /*for upload button*/
    .container {
        display: inline-flex;
    }

    .fixed {
        width: 750px;
    }

    .flex-item {
        flex-grow: 1;
        padding: 20px;
    }

    #label {
        background-color: #8c8591;
        color: white;
        padding: 0.5rem;
        font-family: sans-serif;
        border-radius: 0.3rem;
        cursor: pointer;
        margin-top: 1rem;
    }

    #file-chosen {
        margin-left: 0.3rem;
        font-family: sans-serif;
    }

    .firstformt > thead > tr > td {
        padding-top: 5px;
        padding-right: 5px;
        padding-bottom: 5px;
        padding-left: 25px;
        font-weight: 600;
    }

    .atal-icon-sec {
        height: 73px;
    }

    .atal-logo-sec {
        height: 60px;
        margin-left: 9px;
    }

    .list_style li {
        line-height: 25px;
    }
</style>
