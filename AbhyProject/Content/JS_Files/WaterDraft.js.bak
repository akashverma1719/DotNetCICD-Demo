// Live stock 
function IndustrialWater() {
	alert();
    var WaterReq = $('#industry_daily_water_req').val();
    var dayUse = $('#industry_days_use').val();
    if (WaterReq == "") {
        WaterReq = 0;
    }
    if (dayUse == "") {
        dayUse = 0;
    }
    
    var total = parseFloat(WaterReq) * parseFloat(dayUse) * (parseFloat(1) / parseFloat(10000000));
    $('#industry_waterdemand').val(total);
}

function Total_livestock_function() {
    x1 += 1;
    var buffalo_count = 0;
    var bullock_count = 0;
    var cow_count = 0;
    var sheeps_count = 0;
    var goat_count = 0;

    var donkey_count = 0;
    var camel_count = 0;

    buffalo_count = $("#domestic_buffalo_count").val();
    if (buffalo_count == "") {
        buffalo_count = 0;
    }
    bullock_count = $("#domestic_bullocks_count").val();
    if (bullock_count == "") {
        bullock_count = 0;
    }
    cow_count = $("#domestic_cow_count").val();
    if (cow_count == "") {
        cow_count = 0;
    }
    sheeps_count = $("#domestic_sheeps_count").val();
    if (sheeps_count == "") {
        sheeps_count = 0;
    }
    goat_count = $("#domestic_goat_count").val();
    if (goat_count == "") {
        goat_count = 0;
    }
    donkey_count = $("#domestic_donkey_count").val();
    if (donkey_count == "") {
        donkey_count = 0;
    }
    camel_count = $("#domestic_camel_count").val();
    if (camel_count == "") {
        camel_count = 0;
    }

    var total_livestock_population_v = parseFloat(buffalo_count) + parseFloat(bullock_count) + parseFloat(cow_count) + parseFloat(sheeps_count) + parseFloat(goat_count) + parseFloat(donkey_count) + parseFloat(camel_count);

    if (total_livestock_population_v != 0) {
        $('#domestic_livestock_count').val(parseFloat(total_livestock_population_v));
    }

    var domestic_livestock_water_requirement = $('#domestic_livestock_water_requirement').val();
    if (domestic_livestock_water_requirement == "") {
        domestic_livestock_water_requirement = 0;
    }
    var domestic_livestock_count = $('#domestic_livestock_count').val();
    if (domestic_livestock_count == "") {
        domestic_livestock_count = 0;
    }

    //if (domestic_livestock_count != "" && domestic_livestock_count != "") {
    //    $('#domestic_livestock_water_req').text((parseFloat(domestic_livestock_count) * parseFloat(domestic_livestock_water_requirement)).toFixed(2));
    //}
    //else {

    //    $('#domestic_livestock_water_req').text('0');
    //}


}

$("#domestic_livestock_count,#domestic_livestock_water_requirement").on("keydown keyup", function () {
    $('#domestic_livestock_water_req_li').show();
    $('#domestic_livestock_water_req_avg_li').show();


    var domestic_livestock_count = $('#domestic_livestock_count').val();
    var domestic_livestock_water_requirement = $('#domestic_livestock_water_requirement').val();
    var x = 0;

    if (domestic_livestock_count == "") {
        domestic_livestock_count = "0";
    }
    if (domestic_livestock_water_requirement == "") {
        domestic_livestock_water_requirement = "0";
    }



    if (domestic_livestock_count == "0" && domestic_livestock_water_requirement == "0") {


        $("#domestic_buffalo_count").removeAttr("disabled");
        $("#domestic_buffalo_water_requirement").removeAttr("disabled");

        $("#domestic_bullocks_count").removeAttr("disabled");
        $("#domestic_bullock_water_requirement").removeAttr("disabled");

        $("#domestic_cow_count").removeAttr("disabled");
        $("#domestic_cow_water_requirement").removeAttr("disabled");

        $("#domestic_sheeps_count").removeAttr("disabled");
        $("#domestic_sheeps_water_requirement").removeAttr("disabled");

        $("#domestic_goat_count").removeAttr("disabled");
        $("#domestic_goat_water_requirement").removeAttr("disabled");

        $("#domestic_donkey_count").removeAttr("disabled");
        $("#domestic_donkey_water_requirement").removeAttr("disabled");

        $("#domestic_camel_count").removeAttr("disabled");
        $("#domestic_camel_water_requirement").removeAttr("disabled");

    }
    else {

        var Sum = parseFloat(domestic_livestock_count) * parseFloat(domestic_livestock_water_requirement);

        $('#domestic_livestock_water_req').html(Sum.toFixed(2));

        var avg_req = Sum / domestic_livestock_count;

        var domestic_annual_req_livestock = parseFloat(domestic_livestock_count) * parseFloat(avg_req) * 365 * 0.0000001;

        $('#domestic_annual_req_livestock').text(domestic_annual_req_livestock.toFixed(2));

        $("#domestic_buffalo_count").attr("disabled", "disabled");
        $("#domestic_buffalo_water_requirement").attr("disabled", "disabled");

        $("#domestic_bullocks_count").attr("disabled", "disabled");
        $("#domestic_bullock_water_requirement").attr("disabled", "disabled");

        $("#domestic_cow_count").attr("disabled", "disabled");
        $("#domestic_cow_water_requirement").attr("disabled", "disabled");

        $("#domestic_sheeps_count").attr("disabled", "disabled");
        $("#domestic_sheeps_water_requirement").attr("disabled", "disabled");

        $("#domestic_goat_count").attr("disabled", "disabled");
        $("#domestic_goat_water_requirement").attr("disabled", "disabled");

        $("#domestic_donkey_count").attr("disabled", "disabled");
        $("#domestic_donkey_water_requirement").attr("disabled", "disabled");

        $("#domestic_camel_count").attr("disabled", "disabled");
        $("#domestic_camel_water_requirement").attr("disabled", "disabled");
    }



    var avg_req = parseFloat(domestic_livestock_count) / parseFloat(domestic_livestock_count);

    var ss = isNaN(avg_req);
    if (ss == true) {
        avg_req = "0";
    }
    var avg_res = parseFloat(avg_req);
    $('#domestic_livestock_water_req_avg').text(avg_res.toFixed(2));
    var domestic_annual_req_livestock = 0;
    domestic_annual_req_livestock = (parseFloat(domestic_livestock_count) * avg_res * 0.0000001 * 365);
    //  domestic_annual_req_livestock = (parseFloat(Sumvalue) * 0.0000001 * 365);

    $('#domestic_annual_req_livestock').text(domestic_annual_req_livestock.toFixed(2));



    var domestic_demand_surface_water = 0;
    var domestic_demand_ground_water = 0;


    //var tol_1 = parseFloat(domestic_annual_req_people) + parseFloat(domestic_annual_req_livestock);
    //$('#domestic_annual_req_total_value').text(tol_1); 



    var domestic_demand_surface_water_livestock = 0;
    var domestic_demand_ground_water_livestock = 0;
    if (domestic_annual_req_livestock != "") {
        var UserEntry_groundwater1 = $('#domestic_demand_userentry_groundwater_livestock').val();
        var UserEntry_surfacewater1 = $('#domestic_demand_userentry_surfacewater_livestock').val();
        if (UserEntry_groundwater1 == "") {
            UserEntry_groundwater1 = 0;
        }
        if (UserEntry_surfacewater1 == "") {
            UserEntry_surfacewater1 = 0;
        }

        domestic_demand_surface_water_livestock = parseFloat(domestic_annual_req_livestock * parseFloat(UserEntry_surfacewater1)).toFixed(2);
        domestic_demand_ground_water_livestock = parseFloat(domestic_annual_req_livestock * parseFloat(UserEntry_groundwater1)).toFixed(2);
        $('#domestic_demand_surface_water_livestock').text(domestic_demand_surface_water_livestock);
        $('#domestic_demand_ground_water_livestock').text(domestic_demand_ground_water_livestock);
    }


    var domestic_demand_ground_water_total_value = parseFloat(domestic_demand_surface_water) + parseFloat(domestic_demand_surface_water_livestock);
    $("#domestic_demand_ground_water_total_value").text(domestic_demand_ground_water_total_value.toFixed(2));
    var domestic_demand_surface_water_total_value = parseFloat(domestic_demand_ground_water) + parseFloat(domestic_demand_ground_water_livestock);

    $("#domestic_demand_surface_water_total_value").text(domestic_demand_surface_water_total_value.toFixed(2));



});
