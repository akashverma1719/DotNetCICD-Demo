function Info() {

    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/WaterDraftInfo_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {
            Irri_Kharif_Count = 0;
            Irri_Kharif_Count1 = 0;
            Irri_Kharif_Count2 = 0;
            Irri_Kharif_Count3 = 0;
            Irri_Kharif_Count4 = 0;
            Irri_Kharif_Count5 = 0;

            Irri_Rabi_Count = 0;
            Irri_Rabi_Count1 = 0;
            Irri_Rabi_Count2 = 0;
            Irri_Rabi_Count3 = 0;
            Irri_Rabi_Count4 = 0;
            Irri_Rabi_Count5 = 0;

            Irri_Summer_Count = 0;
            Irri_Summer_Count1 = 0;
            Irri_Summer_Count2 = 0;
            Irri_Summer_Count3 = 0;
            Irri_Summer_Count4 = 0;
            Irri_Summer_Count5 = 0;

            if (response == "Error") {
                window.location = "/WspNew/WspDraft";
            }
            if (response == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            if (response.length != 0) {

                //Kharif
                if (response[0].irri_kharif_othercrop_name1 == null || response[0].irri_kharif_othercrop_name1 == "") {
                    Irri_Kharif_Count1 = 1;
                }
                else {
                    Irri_Kharif_Count = Irri_Kharif_Count + 1;
                }

                if (response[0].irri_kharif_othercrop_name2 == null || response[0].irri_kharif_othercrop_name2 == "") {
                    Irri_Kharif_Count2 = 2;
                } else {
                    Irri_Kharif_Count = Irri_Kharif_Count + 1;
                }
                if (response[0].irri_kharif_othercrop_name3 == null || response[0].irri_kharif_othercrop_name3 == "") {
                    Irri_Kharif_Count3 = 3;
                }
                else {
                    Irri_Kharif_Count = Irri_Kharif_Count + 1;
                }

                if (response[0].irri_kharif_othercrop_name4 == null || response[0].irri_kharif_othercrop_name4 == "") {
                    Irri_Kharif_Count4 = 4;
                }
                else {
                    Irri_Kharif_Count = Irri_Kharif_Count + 1;
                }
                if (response[0].irri_kharif_othercrop_name5 == null || response[0].irri_kharif_othercrop_name5 == "") {
                    Irri_Kharif_Count5 = 5;
                } else {
                    Irri_Kharif_Count = Irri_Kharif_Count + 1;
                }

                if (Irri_Kharif_Count == 5) {
                    $('#Kharif_Add_Crop').hide();
                }

                if (response[0].irri_kharif_othercrop_name1 != null && response[0].irri_kharif_othercrop_name1 != "null" && response[0].irri_kharif_othercrop_name1 != "" && response[0].irri_kharif_othercrop_name1 != "0") {
                    var irri_kharif_othercrop_area1 = "";
                    var irri_kharif_othercrop_waterdemand1 = "";
                    var irri_kharif_othercrop_water_req1 = "";
                    if (response[0].irri_kharif_othercrop_area1 != null && response[0].irri_kharif_othercrop_area1 != "" && response[0].irri_kharif_othercrop_area1 != "0") {
                        irri_kharif_othercrop_area1 = response[0].irri_kharif_othercrop_area1;
                    }
                    if (response[0].irri_kharif_othercrop_waterdemand1 != null && response[0].irri_kharif_othercrop_waterdemand1 != "" && response[0].irri_kharif_othercrop_waterdemand1 != "0") {
                        irri_kharif_othercrop_waterdemand1 = response[0].irri_kharif_othercrop_waterdemand1;
                    }
                    if (response[0].irri_kharif_othercrop_water_req1 != null && response[0].irri_kharif_othercrop_water_req1 != "" && response[0].irri_kharif_othercrop_water_req1 != "0") {
                        irri_kharif_othercrop_water_req1 = response[0].irri_kharif_othercrop_water_req1;
                    }


