                $('#domestic_buffalo_count').val(response[0].domestic_buffalo_count);
                $('#domestic_bullocks_count').val(response[0].domestic_bullocks_count);
                $('#domestic_cow_count').val(response[0].domestic_cow_count);
                $('#domestic_sheeps_count').val(response[0].domestic_sheeps_count);
                $('#domestic_goat_count').val(response[0].domestic_goat_count);
                $('#domestic_donkey_count').val(response[0].domestic_donkey_count);
                $('#domestic_camel_count').val(response[0].domestic_camel_count);
                $('#domestic_people_water_req').text(response[0].domestic_people_water_req);
                $('#domestic_buffalo_water_req').text(response[0].domestic_buffalo_water_req);
                $('#domestic_bullock_water_req').text(response[0].domestic_bullock_water_req);
                $('#domestic_cow_water_req').text(response[0].domestic_cow_water_req);
                $('#domestic_sheeps_water_req').text(response[0].domestic_sheeps_water_req);
                $('#domestic_goat_water_req').text(response[0].domestic_goat_water_req);
                $('#domestic_donkey_water_req').text(response[0].domestic_donkey_water_req);
                $('#domestic_camel_water_req').text(response[0].domestic_camel_water_req);

                $('#domestic_livestock_water_req').text(response[0].domestic_livestock_water_req);
                $('#domestic_annual_req_people').text(response[0].domestic_annual_req_people);
                $('#domestic_annual_req_livestock').text(response[0].domestic_annual_req_livestock);

                if (response[0].domestic_demand_userentry_groundwater_human != null) {
                    $('#domestic_demand_userentry_groundwater_human').val(response[0].domestic_demand_userentry_groundwater_human);
                }
                else {
                    $('#domestic_demand_userentry_groundwater_human').val(0.7);
                }
                $('#domestic_demand_ground_water').text(response[0].domestic_demand_ground_water);

                if (response[0].domestic_demand_userentry_surfacewater_human != null) {
                    $('#domestic_demand_userentry_surfacewater_human').val(response[0].domestic_demand_userentry_surfacewater_human);
                }
                else {
                    $('#domestic_demand_userentry_surfacewater_human').val(0.3);
                }
                $('#domestic_demand_surface_water').text(response[0].domestic_demand_surface_water);

                if (response[0].domestic_demand_userentry_groundwater_livestock != null) {
                    $('#domestic_demand_userentry_groundwater_livestock').val(response[0].domestic_demand_userentry_groundwater_livestock);
                } else {
                    $('#domestic_demand_userentry_groundwater_livestock').val(0.7);
                }
                $('#domestic_demand_ground_water_livestock').text(response[0].domestic_demand_ground_water_livestock);

                if (response[0].domestic_demand_userentry_surfacewater_livestock != null) {
                    $('#domestic_demand_userentry_surfacewater_livestock').val(response[0].domestic_demand_userentry_surfacewater_livestock);
                } else {
                    $('#domestic_demand_userentry_surfacewater_livestock').val(0.3);
                }
                $('#domestic_demand_surface_water_livestock').text(response[0].domestic_demand_surface_water_livestock);
                $('#domestic_demand_ground_water_total_value').text(response[0].domestic_demand_ground_water_total_value);
                $('#domestic_demand_surface_water_total_value').text(response[0].domestic_demand_surface_water_total_value);
            }
            else {
                $('#domestic_people_water_requirement').val(130);
                //  $('#domestic_livestock_water_requirement').val(40);
                $('#domestic_buffalo_water_requirement').val(55);
                $('#domestic_bullock_water_requirement').val(55);
                $('#domestic_cow_water_requirement').val(45);
                $('#domestic_sheeps_water_requirement').val(6.5);
                $('#domestic_goat_water_requirement').val(6.5);
                $('#domestic_donkey_water_requirement').val(37.5);
                $('#domestic_camel_water_requirement').val(30);
            }
            Domestic();
            if (DPMU_Level_Count == 1) {
                DPMU_Submission();
            }

        }
    });
}


