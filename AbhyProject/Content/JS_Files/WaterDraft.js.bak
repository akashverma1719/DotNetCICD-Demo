                        '<label style="color:#fff">' + response[0].irri_kharif_othercrop_name2 + ' </label></div>' +
                        '<div class="content"><ul class="wsp-content-content"><li>' +
                        '<input type="text" class="form-control" title="Crop name" placeholder="Crop Name" id="irri_kharif_othercrop_name2"  value="' + response[0].irri_kharif_othercrop_name2 + '"/></li><li>' +
