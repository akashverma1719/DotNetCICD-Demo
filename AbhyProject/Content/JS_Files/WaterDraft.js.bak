$("#industry_daily_water_req,#industry_days_use").on("keydown keyup", function () {

    Industrial_water_demand();

});
function Industrial_water_demand() {
    var industry_daily_water_req = $("#industry_daily_water_req").val();
    if (industry_daily_water_req == "") {
        industry_daily_water_req = "0";
    }
    var industry_days_use = $("#industry_days_use").val();
    if (industry_days_use == "") {
        industry_days_use = "0";
    }
    // var ss = parseFloat(industry_daily_water_req) * parseFloat(industry_days_use) * Math.pow(10, -7);
    var ss = parseFloat(industry_daily_water_req) * parseFloat(industry_days_use) * (1 / 10000000);
    $('#industry_waterdemand').val(ss.toFixed(2));
}

function myFunction(j) {
    Industrial_water_demand(j);

}

function Industrial_water_demand(j) {
    var Or1 = "#industry_daily_water_req" + j;
    var industry_daily_water_req = $(Or1).val();
    if (industry_daily_water_req == "") {
        industry_daily_water_req = "0";
    }
    var Or2 = "#industry_days_use" + j;
    var industry_days_use = $(Or2).val();
    if (industry_days_use == "") {
        industry_days_use = "0";
    }
    // var ss = parseFloat(industry_daily_water_req) * parseFloat(industry_days_use) * Math.pow(10, -7);
    var ss = parseFloat(industry_daily_water_req) * parseFloat(industry_days_use) * (1 / 10000000);
    var Or3 = '#industry_waterdemand' + j;
    $(Or3).val(ss.toFixed(2));
}


