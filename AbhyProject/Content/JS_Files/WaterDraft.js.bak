function Industry_Info() {

    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/WaterIndustry_Info_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {
            var tr = '';

            if (response == "Error") {
                window.location = "/WspNew/WspDraft";
            }
            if (response == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            if (response.length != 0) {
                var i = response.length - 1;

                for (var j = 0; j < response.length; j++) {
                    var x1 = 0;
                    var industry_name = "";
                    if (response[j].industry_name != null) {
                        x1 = 1;
                        industry_name = response[j].industry_name;
                    }
                    var industry_daily_water_req = "";
                    if (response[j].industry_daily_water_req != null) {
                        x1 = 1;
                        industry_daily_water_req = response[j].industry_daily_water_req;
                    }
                    var industry_days_use = "";
                    if (response[j].industry_days_use != null) {
                        x1 = 1;
                        industry_days_use = response[j].industry_days_use;
                    }
                    var industry_waterdemand = "";
                    if (response[j].industry_waterdemand != null) {
                        x1 = 1;
                        industry_waterdemand = response[j].industry_waterdemand;
                    }




                    var industry_demand_surface_water = "";
                    if (response[j].industry_demand_surface_water != null) {
                        x1 = 1;
                        industry_demand_surface_water = response[j].industry_demand_surface_water;
                    }
                    var industry_demand_ground_water = "";
                    if (response[j].industry_demand_ground_water != null) {
                        x1 = 1;
                        industry_demand_ground_water = response[j].industry_demand_ground_water;
                    }
                    if (x1 == 1) {
                        tr += '<tr id="trindustry' + j + '" class="database_trainer_row " role="row" style="display:none">' +

                            '<td class="tdborder"><input type="text" class="form-control" id="industry_name' + j + '" value="' + industry_name + '" /> </td >' +
                            '<td class="tdborder"><input type="text" class="form-control" id="industry_daily_water_req' + j + '" onkeyup="myFunction(' + j + ')" value="' + industry_daily_water_req + '" /> </td >' +
                            '<td class="tdborder"><input type="text" class="form-control" id="industry_days_use' + j + '" onkeyup="myFunction(' + j + ')" value="' + industry_days_use + '" /> </td >' +
                            '<td class="tdborder"><input type="text" class="form-control" id="industry_waterdemand' + j + '" value="' + industry_waterdemand + '" /> </td >' +
                            '<td class="tdborder"><input type="text" class="form-control" id="industry_demand_surface_water' + j + '" value="' + industry_demand_surface_water + '" /> </td >' +
                            '<td class="tdborder"><input type="text" class="form-control" id="industry_demand_ground_water' + j + '" value="' + industry_demand_ground_water + '" /> </td >' +
                            '<td><button type="button"  class="btn btn-primary" onclick="updateindustry(' + response[j].id + ',' + j + ')">Update</button>' + '</td><td><button  class="btn btn-danger " type="button" onclick="cancelindustry(' + j + ');"><i class="fa fa-remove"</button>' + '</td>' +
                            '<tr role="row"  id="hideindustry_' + j + '"><td>' + industry_name + '</td><td id="">' + industry_daily_water_req + '</td><td id="">' + industry_days_use + '</td><td id="">' + industry_waterdemand + '</td><td id="">' + industry_demand_surface_water + '</td><td id="">' + industry_demand_ground_water + '</td>' +
                            '<td > <button class="btn btn-primary"  onclick=editindustry(' + j + ')><i class="fa fa-edit"></i></button></td > <td><button class="btn btn-danger" onclick="deleteindustry(' + response[j].id + ') "><i class="fa fa-trash"></i></button></td></tr>';
                    }
                }

                $('#IndustryData_Table').html(tr);
            }
            else {
                tr = '<tr><td colspan="8">No Data</td> </tr>';
                //OtherUseageData_Table
                $('#IndustryData_Table').html(tr);
            }

        }
    });
}
function cancelindustry(j) {
    $('#hideindustry_' + j).show();
    $('#trindustry' + j).hide();
}
function editindustry(j) {

    $('#trindustry' + j).show();
    $('#hideindustry_' + j).hide();


}

function updateindustry(DID, j) {
    var obj = {};
    obj.industry_name = $('#industry_name' + j).val();
    obj.industry_daily_water_req = $('#industry_daily_water_req' + j).val();

    obj.industry_days_use = $('#industry_days_use' + j).val();
    obj.industry_waterdemand = $('#industry_waterdemand' + j).val();
    obj.industry_demand_surface_water = $('#industry_demand_surface_water' + j).val();
    obj.industry_demand_ground_water = $('#industry_demand_ground_water' + j).val();

    obj.id = DID;
    $.ajax({
        type: "POST",
        contentType: "application/json;charset=utf-8",
        url: '/Wsp_new/WaterIndustry_update',

        data: "{'WaterIndustry_update1': '" + JSON.stringify(obj) + "'}",
        dataType: 'JSON',
        success: function (response) {
            alert(response);
            Industry_Info();

        }
    });
}


function deleteindustry(id) {

    var obj = {};
    obj.id = id;
    $.ajax({
        type: "POST",
        contentType: "application/json;charset=utf-8",
        url: '/Wsp_new/WaterIndustry_delete',

        data: "{'WaterIndustry_update1': '" + JSON.stringify(obj) + "'}",
        dataType: 'JSON',
        success: function (response) {
            alert(response);
            Industry_Info();
        }
    });
}

