    //    Total_Water_Demand_for_Summer_Crops = Total_Water_Demand_for_Summer_Crops + irri_summer_beans_waterdemand;
    //}

    //Floriculture
    $('#irri_summer_floriculture_waterdemand').text("0");
    var irri_summer_floriculture_water_requirement = $('#irri_summer_floriculture_water_requirement').val();
    var irri_summer_floriculture_waterdemand = 0;
    var irri_summer_floriculture_crop_area = $('#irri_summer_floriculture_crop_area').val();
    if (irri_summer_floriculture_crop_area != "") {

        if (irri_summer_floriculture_water_requirement != "" && irri_summer_floriculture_water_requirement != null) {
            irri_summer_floriculture_waterdemand = (parseFloat(irri_summer_floriculture_crop_area) * parseFloat(irri_summer_floriculture_water_requirement) * 0.001);
        }
        $('#irri_summer_floriculture_waterdemand').text(irri_summer_floriculture_waterdemand.toFixed(2));

        Total_Water_Demand_for_Summer_Crops = Total_Water_Demand_for_Summer_Crops + irri_summer_floriculture_waterdemand;

    }


    //Maize
    $('#irri_summer_maize_waterdemand').text("0");
    var irri_summer_maize_water_requirement = $('#irri_summer_maize_water_requirement').val();
    var irri_summer_maize_waterdemand = 0;
    var irri_summer_maize_crop_area = $('#irri_summer_maize_crop_area').val();
    if (irri_summer_maize_crop_area != "") {

        if (irri_summer_maize_water_requirement != "" && irri_summer_maize_water_requirement != null) {
            irri_summer_maize_waterdemand = (parseFloat(irri_summer_maize_crop_area) * parseFloat(irri_summer_maize_water_requirement) * 0.001);
        }
        $('#irri_summer_maize_waterdemand').text(irri_summer_maize_waterdemand.toFixed(2));

        Total_Water_Demand_for_Summer_Crops = Total_Water_Demand_for_Summer_Crops + irri_summer_maize_waterdemand;

    }

    //Fodder
    $('#irri_summer_fodder_waterdemand').text("0");
    var irri_summer_fodder_water_requirement = $('#irri_summer_fodder_water_requirement').val();
    var irri_summer_fodder_waterdemand = 0;
    var irri_summer_fodder_crop_area = $('#irri_summer_fodder_crop_area').val();
    if (irri_summer_fodder_crop_area != "") {

        if (irri_summer_fodder_water_requirement != "" && irri_summer_fodder_water_requirement != null) {
            irri_summer_fodder_waterdemand = (parseFloat(irri_summer_fodder_crop_area) * parseFloat(irri_summer_fodder_water_requirement) * 0.001);
        }
        $('#irri_summer_fodder_waterdemand').text(irri_summer_fodder_waterdemand.toFixed(2));

        Total_Water_Demand_for_Summer_Crops = Total_Water_Demand_for_Summer_Crops + irri_summer_fodder_waterdemand;

    }

    //Sugarcane
    $('#irri_summer_sugarcane_waterdemand').text("0");
    var irri_summer_sugarcane_water_requirement = $('#irri_summer_sugarcane_water_requirement').val();
    var irri_summer_sugarcane_waterdemand = 0;
    var irri_summer_sugarcane_crop_area = $('#irri_summer_sugarcane_crop_area').val();
    if (irri_summer_sugarcane_crop_area != "") {

        if (irri_summer_sugarcane_water_requirement != "" && irri_summer_sugarcane_water_requirement != null) {
            irri_summer_sugarcane_waterdemand = (parseFloat(irri_summer_sugarcane_crop_area) * parseFloat(irri_summer_sugarcane_water_requirement) * 0.001);
        }
        $('#irri_summer_sugarcane_waterdemand').text(irri_summer_sugarcane_waterdemand.toFixed(2));

        Total_Water_Demand_for_Summer_Crops = Total_Water_Demand_for_Summer_Crops + irri_summer_sugarcane_waterdemand;
    }
    // Horiculer

    $('#irri_summer_horticulture_waterdemand').text("0");
    var irri_summer_horticulture_water_requirement = $('#irri_summer_horticulture_water_requirement').val();
    var irri_summer_horticulture_waterdemand = 0;
    var irri_summer_horticulture_crop_area = $('#irri_summer_horticulture_crop_area').val();
    if (irri_summer_horticulture_crop_area != "") {

        if (irri_summer_horticulture_water_requirement != "" && irri_summer_horticulture_water_requirement != null) {
            irri_summer_horticulture_waterdemand = (parseFloat(irri_summer_horticulture_crop_area) * parseFloat(irri_summer_horticulture_water_requirement) * 0.001);
        }
        $('#irri_summer_horticulture_waterdemand').text(irri_summer_horticulture_waterdemand.toFixed(2));

        Total_Water_Demand_for_Summer_Crops = Total_Water_Demand_for_Summer_Crops + irri_summer_horticulture_waterdemand;
    }




    $('#irri_summer_total_waterdemand_summercrops').text(Total_Water_Demand_for_Summer_Crops.toFixed(2));

    $('#irri_summer_waterdemand').text(Total_Water_Demand_for_Summer_Crops.toFixed(2));

    total_annual_water_demand = parseFloat(Total_Water_Demand_for_Kharif_Crops) + parseFloat(Total_Water_Demand_for_Rabi_Crops) + parseFloat(Total_Water_Demand_for_Summer_Crops);
    $('#total_annual_water_demand').text(total_annual_water_demand.toFixed(2));
    Utilization_from_Surface_Water();
}


