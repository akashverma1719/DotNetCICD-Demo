var total_annual_water_demand = 0;
var Total_Water_Demand_for_Kharif_Crops = 0;
var Total_Water_Demand_for_Rabi_Crops = 0;
var Total_Water_Demand_for_Summer_Crops = 0;
function Kharif_WaterRequire() {



    Total_Water_Demand_for_Kharif_Crops = 0;
    total_annual_water_demand = 0;

    //Other Crop
    var irri_kharif_othercrop_waterdemand1 = 0;
    var irri_kharif_othercrop_water_req1 = $('#irri_kharif_othercrop_water_req1').val();
    $('#irri_kharif_othercrop_waterdemand1').text("0");

    var irri_kharif_othercrop_area1 = $('#irri_kharif_othercrop_area1').val();
    if (irri_kharif_othercrop_area1 != "") {

        if (irri_kharif_othercrop_water_req1 != "" && irri_kharif_othercrop_water_req1 != null) {
            irri_kharif_othercrop_waterdemand1 = (parseFloat(irri_kharif_othercrop_area1) * parseFloat(irri_kharif_othercrop_water_req1) * 0.001);
        }

        $('#irri_kharif_othercrop_waterdemand1').text(irri_kharif_othercrop_waterdemand1.toFixed(2));

        Total_Water_Demand_for_Kharif_Crops = irri_kharif_othercrop_waterdemand1 + Total_Water_Demand_for_Kharif_Crops;



    }


    var irri_kharif_othercrop_waterdemand2 = 0;
