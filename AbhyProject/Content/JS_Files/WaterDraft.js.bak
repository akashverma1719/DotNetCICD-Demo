                        '<label style="color:#fff">' + response[0].irri_kharif_othercrop_name1 + ' </label></div>' +
                        '<div class="content"><ul class="wsp-content-content"><li>' +
                        '<input type="text" class="form-control" title="Crop name" placeholder="Crop Name" id="irri_kharif_othercrop_name1"  value="' + response[0].irri_kharif_othercrop_name1 + '"/></li><li>' +
                        '<input type="text"  onkeyup="Kharif_WaterRequire()" class="form-control  color_database decimal" id="irri_kharif_othercrop_area1" value="' + irri_kharif_othercrop_area1 + '" placeholder="Crop Area(ha)" title="Crop Area(ha)">' +
                        '</li><li> <input type="text" onkeyup="Kharif_WaterRequire()" id="irri_kharif_othercrop_water_req1" value="' + irri_kharif_othercrop_water_req1 + '" class="form-control  color_database decimal" placeholder="Water Requirement (mm)" title="Water Requirement(mm)"></li>' +
                        '<li><label>Water Demand: <span id="irri_kharif_othercrop_waterdemand1">' + irri_kharif_othercrop_waterdemand1 + '</span><span>(ha.m)</span></label></li>' +
                        '<li><label>Other Crop 1</label></li></ul></div> </div>';

                    $('#Irr_Kharif_add_crp_1').html(S1);
                    $('#irri_kharif_othercrop_name1').hide();
                    $('#Irr_Kharif_add_crp_1').show();
                    //if (StateOfficer != "Gram Panchyat Nodal Officer") {

                    //    document.getElementById("irri_kharif_othercrop_name1").disabled = true;
                    //    document.getElementById("irri_kharif_othercrop_area1").disabled = true;
                    //    document.getElementById("irri_kharif_othercrop_water_req1").disabled = true;

                    //}
                }
                if (response[0].irri_kharif_othercrop_name2 != null && response[0].irri_kharif_othercrop_name2 != "null" && response[0].irri_kharif_othercrop_name2 != "" && response[0].irri_kharif_othercrop_name2 != "0") {
                    var irri_kharif_othercrop_area2 = "";
                    var irri_kharif_othercrop_waterdemand2 = "";
                    var irri_kharif_othercrop_water_req2 = "";
                    if (response[0].irri_kharif_othercrop_area2 != null && response[0].irri_kharif_othercrop_area2 != "" && response[0].irri_kharif_othercrop_area2 != "0") {
                        irri_kharif_othercrop_area2 = response[0].irri_kharif_othercrop_area2;
                    }
                    if (response[0].irri_kharif_othercrop_waterdemand2 != null && response[0].irri_kharif_othercrop_waterdemand2 != "" && response[0].irri_kharif_othercrop_waterdemand2 != "0") {
