    }
    var domestic_livestock_water_req = $('#domestic_livestock_water_req').text();

    var Sumvalue_Count = 0;
    var Sumvalue_require = 0;

    if (domestic_buffalo_water_req != "" && domestic_bullock_water_req != "" && domestic_cow_water_req != "" && domestic_sheeps_water_req != "" && domestic_goat_water_req != "" && domestic_donkey_water_req != "" && domestic_camel_water_req != "") {
        Sumvalue_require = (parseFloat(domestic_buffalo_water_req) * parseFloat(domestic_buffalo_count)) + (parseFloat(domestic_bullock_water_req) * parseFloat(domestic_bullocks_count)) + (parseFloat(domestic_cow_water_req) * parseFloat(domestic_cow_count)) + (parseFloat(domestic_sheeps_water_req) * parseFloat(domestic_sheeps_count)) + (parseFloat(domestic_goat_water_req) * parseFloat(domestic_goat_count)) + (parseFloat(domestic_donkey_water_req) * parseFloat(domestic_donkey_count)) + (parseFloat(domestic_camel_water_req) * parseFloat(domestic_camel_count));
    }

    if (domestic_buffalo_count != "" && domestic_bullocks_count != "" && domestic_cow_count != "" && domestic_sheeps_count != "" && domestic_goat_count != "" && domestic_donkey_count != "" && domestic_camel_count != "") {
        Sumvalue_Count = parseFloat(domestic_buffalo_count) + parseFloat(domestic_bullocks_count) + parseFloat(domestic_cow_count) + parseFloat(domestic_sheeps_count) + parseFloat(domestic_goat_count) + parseFloat(domestic_donkey_count) + parseFloat(domestic_camel_count);
    }

    if (LiveStockval != 1) {
        $('#domestic_livestock_water_requirement').val(Sumvalue_require);
    } else {
        var X1 = $('#domestic_livestock_water_requirement').val();
        if (X1 == "") {
            X1 = 0;
        }
        Sumvalue_require = parseFloat(X1);
    }
    if (LiveStock_reqVal != 1) {
        $('#domestic_livestock_count').val(Sumvalue_Count);

    } else {
        var X1 = $('#domestic_livestock_count').val();
        if (X1 == "") {
            X1 = 0;
        }
        Sumvalue_Count = parseFloat(X1);
    }


    var avg_req = Sumvalue_require / Sumvalue_Count;

    var ss = isNaN(avg_req);
    if (ss == true) {
        avg_req = "0";
    }
    var avg_res = parseFloat(avg_req);

    $('#domestic_livestock_water_req').text(avg_res.toFixed(2));
    $('#domestic_livestock_water_req_avg').text(avg_res.toFixed(2));


    //if (domestic_livestock_water_req != "") {
    //    Sumvalue = parseFloat(domestic_livestock_water_req);
    //}
    //$("#domestic_livestock_count").attr("disabled", "disabled");
    //$("#domestic_livestock_water_requirement").attr("disabled", "disabled");



    var domestic_annual_req_livestock = 0;
    domestic_annual_req_livestock = (Sumvalue_Count * avg_res * 0.0000001 * 365);
    //  domestic_annual_req_livestock = (parseFloat(Sumvalue) * 0.0000001 * 365);

    $('#domestic_annual_req_livestock').text(domestic_annual_req_livestock.toFixed(2));

    var domestic_annual_req_people = $('#domestic_annual_req_people').text();

    var domestic_demand_surface_water = 0;
    var domestic_demand_ground_water = 0;

    if (domestic_annual_req_people != "") {
        var UserEntry_groundwater = $('#domestic_demand_userentry_groundwater_human').val();
        var UserEntry_surfacewater = $('#domestic_demand_userentry_surfacewater_human').val();
        if (UserEntry_groundwater == "") {
            UserEntry_groundwater = 0;
        }
        if (UserEntry_surfacewater == "") {
            UserEntry_surfacewater = 0;
        }
        domestic_demand_surface_water = parseFloat(domestic_annual_req_people) * parseFloat(UserEntry_surfacewater);
        domestic_demand_ground_water = parseFloat(domestic_annual_req_people) * parseFloat(UserEntry_groundwater);
        $('#domestic_demand_surface_water').text(domestic_demand_surface_water.toFixed(2));
        $('#domestic_demand_ground_water').text(domestic_demand_ground_water.toFixed(2));
    }
    else {
        domestic_annual_req_people = 0;
        var UserEntry_groundwater = $('#domestic_demand_userentry_groundwater_human').val();
        var UserEntry_surfacewater = $('#domestic_demand_userentry_surfacewater_human').val();
        if (UserEntry_groundwater == "") {
            UserEntry_groundwater = 0;
        }
        if (UserEntry_surfacewater == "") {
            UserEntry_surfacewater = 0;
        }
        domestic_demand_surface_water = (domestic_annual_req_people * parseFloat(UserEntry_surfacewater)).toFixed(2);
        domestic_demand_ground_water = (domestic_annual_req_people * parseFloat(UserEntry_groundwater)).toFixed(2);
        $('#domestic_demand_surface_water').text(domestic_demand_surface_water);
        $('#domestic_demand_ground_water').text(domestic_demand_ground_water);
    }
    //var tol_1 = parseFloat(domestic_annual_req_people) + parseFloat(domestic_annual_req_livestock);
    //$('#domestic_annual_req_total_value').text(tol_1); 



    var domestic_demand_surface_water_livestock = 0;
    var domestic_demand_ground_water_livestock = 0;
    if (domestic_annual_req_livestock != "") {
        var UserEntry_groundwater1 = $('#domestic_demand_userentry_groundwater_livestock').val();
        var UserEntry_surfacewater1 = $('#domestic_demand_userentry_surfacewater_livestock').val();
        if (UserEntry_groundwater1 == "") {
            UserEntry_groundwater1 = 0;
        }
        if (UserEntry_surfacewater1 == "") {
            UserEntry_surfacewater1 = 0;
        }

        domestic_demand_surface_water_livestock = parseFloat(domestic_annual_req_livestock * parseFloat(UserEntry_surfacewater1)).toFixed(2);
        domestic_demand_ground_water_livestock = parseFloat(domestic_annual_req_livestock * parseFloat(UserEntry_groundwater1)).toFixed(2);
        $('#domestic_demand_surface_water_livestock').text(domestic_demand_surface_water_livestock);
        $('#domestic_demand_ground_water_livestock').text(domestic_demand_ground_water_livestock);
    }
    else {
        domestic_annual_req_livestock = "0";
        var UserEntry_groundwater1 = $('#domestic_demand_userentry_groundwater_livestock').val();
        var UserEntry_surfacewater1 = $('#domestic_demand_userentry_surfacewater_livestock').val();
        if (UserEntry_groundwater1 == "") {
            UserEntry_groundwater1 = 0;
        }
        if (UserEntry_surfacewater1 == "") {
            UserEntry_surfacewater1 = 0;
        }

        domestic_demand_surface_water_livestock = parseFloat(domestic_annual_req_livestock * parseFloat(UserEntry_surfacewater1)).toFixed(2);
        domestic_demand_ground_water_livestock = parseFloat(domestic_annual_req_livestock * parseFloat(UserEntry_groundwater1)).toFixed(2);
        $('#domestic_demand_surface_water_livestock').text(domestic_demand_surface_water_livestock);
        $('#domestic_demand_ground_water_livestock').text(domestic_demand_ground_water_livestock);
    }




    var domestic_demand_ground_water_total_value = parseFloat(domestic_demand_surface_water) + parseFloat(domestic_demand_surface_water_livestock);
    $("#domestic_demand_ground_water_total_value").text(domestic_demand_ground_water_total_value.toFixed(2));
    var domestic_demand_surface_water_total_value = parseFloat(domestic_demand_ground_water) + parseFloat(domestic_demand_ground_water_livestock);

    $("#domestic_demand_surface_water_total_value").text(domestic_demand_surface_water_total_value.toFixed(2));



    Total_livestock_daily_water_req_function();
    Total_livestock_function();
}

function Utilization_from_Surface_Water() {

    var total_annual_water_demand = $('#total_annual_water_demand').text();
    var irri_utili_ground_water = $('#irri_utili_ground_water').val();
    if (total_annual_water_demand == "") {
        total_annual_water_demand = 0;
    }
    if (irri_utili_ground_water == "") {
        irri_utili_ground_water = 0;
    }


    var irri_utili_surface_water = parseFloat(total_annual_water_demand) - parseFloat(irri_utili_ground_water);
    $('#irri_utili_surface_water').val(irri_utili_surface_water.toFixed(2));

}

$("#irri_utili_ground_water,#irri_utili_surface_water").on("keydown keyup", function () {

    Utilization_from_Surface_Water();

});

function Industry_Uses_Save() {
    debugger;
    var i = 0;
    var industry_name = $('#industry_name').val();
    var industry_daily_water_req = $('#industry_daily_water_req').val();
    var industry_days_use = $('#industry_days_use').val();
    var industry_waterdemand = $('#industry_waterdemand').val();
    var industry_demand_surface_water = $('#industry_demand_surface_water').val();
    var industry_demand_ground_water = $('#industry_demand_ground_water').val();

    var obj = {};
    if (industry_name == "") {
        i = 1;
        $('#IndustryError').text("Please Enter Industry Name");
    }
    if (industry_daily_water_req == "") {
        i = 1;
        $('#IndustryError').text("Please Enter Daily water requirement(l/day)");
    }
    if (industry_days_use == "") {
        i = 1;
        $('#IndustryError').text("Please Enter No. of days in use");
    }
    if (industry_waterdemand == "") {
        i = 1;
        $('#IndustryError').text("Please Enter Industrial water demand (Ha.m)");
    }
    if (industry_demand_surface_water == "") {
        i = 1;
        $('#IndustryError').text("Please Enter Demand (Ha.m) met from surface water");
    }

    if (industry_demand_ground_water == "") {
        i = 1;
        $('#IndustryError').text("Please Enter Demand (Ha.m) met from ground water");
    }

    if (i == 0) {
        obj.state_name = $('#spnstate').text();
        obj.district_name = $('#spndistrict').text();
        obj.block_name = $('#spnblock').text();
        obj.gpname = $('#spngram').text();
        obj.longitude = long;
        obj.latitude = lat;
        obj.industry_name = industry_name;
        obj.industry_daily_water_req = industry_daily_water_req;
        obj.industry_days_use = industry_days_use;
        obj.industry_waterdemand = industry_waterdemand;
        obj.industry_demand_surface_water = industry_demand_surface_water;
        obj.industry_demand_ground_water = industry_demand_ground_water;

        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: "/Wsp_new/WaterIndustry_InsertData",
            data: "{'Data': '" + JSON.stringify(obj) + "'}",
            dataType: 'JSON',
            success: function (response) {

                $('#IndustryError').text(response);
                $('#IndustryError').fadeIn();
                $('#IndustryError').delay(3000).fadeOut();
                Industry_Info();

                $('#industry_name').val("");
                $('#industry_daily_water_req').val("");
                $('#industry_days_use').val("");
                $('#industry_waterdemand').val("");
                $('#industry_demand_surface_water').val("");
                $('#industry_demand_ground_water').val("");
            }
        });
    }

}


