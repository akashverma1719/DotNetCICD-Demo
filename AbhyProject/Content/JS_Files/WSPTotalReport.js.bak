var Industry_Total = 0, industry_demand_surface_water = 0, industry_demand_ground_water = 0;

function Industry_Info() {

    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/WaterIndustry_Info_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {


            //if (response == "Error") {
            //    window.location = "/WspNew/WspDraft";
            //}
            if (response == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            if (response.length != 0) {
                for (var j = 0; j < response.length; j++) {


                    if (response[j].industry_demand_surface_water != null && response[j].industry_demand_surface_water != "") {
                        var ss = parseFloat(response[j].industry_demand_surface_water);
                        if (isNaN(ss) == true) {
                            ss = 0;
                        }
                        industry_demand_surface_water += ss;
                    }
                    if (response[j].industry_demand_ground_water != null && response[j].industry_demand_ground_water != "") {
                        var ss = parseFloat(response[j].industry_demand_ground_water);
                        if (isNaN(ss) == true) {
                            ss = 0;
                        }
                        industry_demand_ground_water += ss;
                    }

                }
            }


            Other_Usage_Info();
        }
    });
}
var Other_Total = 0, other_demand_ground_water = 0, other_demand_surface_water = 0;


function Other_Usage_Info() {

    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/WaterOther_Usage_Info_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {

            //if (response == "Error") {
            //    window.location = "/WspNew/WspDraft";
            //}
            if (response == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            var tr = '';


            if (response.length != 0) {
                for (var i = 0; i < response.length; i++) {

                    if (response[i].other_demand_ground_water != null && response[i].other_demand_ground_water != "") {
                        var ss = parseFloat(response[i].other_demand_ground_water);
                        if (isNaN(ss) == true) {
                            ss = 0;
                        }
                        other_demand_ground_water += ss;
                    }
                    if (response[i].other_demand_surface_water != null && response[i].other_demand_surface_water != "") {
                        var ss = parseFloat(response[i].other_demand_surface_water);
                        if (isNaN(ss) == true) {
                            ss = 0;
                        }
                        other_demand_surface_water += ss;
                    }

                }
            }




            Industry_Total = industry_demand_surface_water + industry_demand_ground_water;
            $('#Industry_Total').text(parseFloat(Industry_Total).toFixed(2));
            $('#industry_demand_surface_water').text(parseFloat(industry_demand_surface_water).toFixed(2));
            $('#industry_demand_ground_water').text(parseFloat(industry_demand_ground_water).toFixed(2));
            Industry.push(industry_demand_ground_water);
            Industry.push(industry_demand_surface_water);




            $('#other_demand_surface_water').text(parseFloat(other_demand_surface_water).toFixed(2));
            $('#other_demand_ground_water').text(parseFloat(other_demand_ground_water).toFixed(2));
            Other_Total = other_demand_ground_water + other_demand_surface_water;
            $('#Other_Total').text(parseFloat(Other_Total).toFixed(2));

            Others.push(other_demand_ground_water);
            Others.push(other_demand_surface_water);
            WaterUtilizationDraftChart();

            BalanceCal();
        }
    });
}

function BalanceCal() {
    WaterBalance_Info();
}

function WaterBalance_Info() {
    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/WaterBalanceInfo_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {
            if (response == "Error") {
                window.location = "/Wsp_new/Balancereport";
            }
            if (response == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            var wb_sw_avail = 0, wb_gw_avail = 0, wb_total_avail = 0;

            var wb_sw_utili = 0, wb_gw_utili = 0, wb_total_utili = 0;
            var wb_sw_balance = 0, wb_gw_balance = 0, wb_total_balance = 0;

            if (response.length != 0) {

                if (response[0].wb_sw_avail != null && response[0].wb_sw_avail != "") {
                    wb_sw_avail = parseFloat(response[0].wb_sw_avail);
                }
                if (response[0].wb_gw_avail != null && response[0].wb_gw_avail != "") {
                    wb_gw_avail = parseFloat(response[0].wb_gw_avail);
                }
                if (response[0].wb_total_avail != null && response[0].wb_total_avail != "") {
                    wb_total_avail = parseFloat(response[0].wb_total_avail);
                }



                if (response[0].wb_sw_utili != null && response[0].wb_sw_utili != "") {
                    wb_sw_utili = parseFloat(response[0].wb_sw_utili);
                }
                if (response[0].wb_gw_utili != null && response[0].wb_gw_utili != "") {
                    wb_gw_utili = parseFloat(response[0].wb_gw_utili);
                }
                if (response[0].wb_total_utili != null && response[0].wb_total_utili != "") {
                    wb_total_utili = parseFloat(response[0].wb_total_utili);
                }


                if (response[0].wb_sw_balance != null && response[0].wb_sw_balance != "") {
                    wb_sw_balance = parseFloat(response[0].wb_sw_balance);
                }
                if (response[0].wb_gw_balance != null && response[0].wb_gw_balance != "") {
                    wb_gw_balance = parseFloat(response[0].wb_gw_balance);
                }
                if (response[0].wb_total_balance != null && response[0].wb_total_balance != "") {
                    wb_total_balance = parseFloat(response[0].wb_total_balance);
                }

            }
            $('#wb_sw_avail').text(wb_sw_avail);
            $('#wb_gw_avail').text(wb_gw_avail);
            $('#wb_total_avail').text(wb_total_avail);
            $('#avl_surfacewater').text(wb_sw_avail);
            $('#avl_groundwater').text(wb_gw_avail);
            $('#wb_sw_utili').text(wb_sw_utili);
            $('#wb_gw_utili').text(wb_gw_utili);

            $('#Utilization_surfacewater').text(wb_sw_utili);
            $('#Utilization_groundwater').text(wb_gw_utili);

            $('#wb_total_utili').text(wb_total_utili);

            $('#wb_sw_balance').text(wb_sw_balance);
            $('#wb_gw_balance').text(wb_gw_balance);

            $('#Balance_surfacewater').text(wb_sw_balance);
            $('#Balance_groundwater').text(wb_gw_balance);
            $('#wb_total_balance').text(wb_total_balance);

            debugger;
            var a = wb_sw_avail - wb_sw_utili;
            Blance_SurfaceWater.push(a);
            var c = wb_gw_avail - wb_gw_utili;
            Blance_GroundWater.push(c);
            var d = a + c;            
            Blance_Total.push(d);

            BalanceCharts();
        }
    });
}

