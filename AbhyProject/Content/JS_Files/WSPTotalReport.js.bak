var Domestic = [];
var Irrigation = [];
var Industry = [];
var Others = [];
var Domestic_Total = 0, domestic_demand_surface_water = 0, domestic_demand_ground_water = 0;
var Irrigated_Total = 0, irri_utili_surface_water = 0, irri_utili_ground_water = 0;
var domestic_demand_surface_water = 0, domestic_demand_surface_water_livestock = 0, irri_utili_surface_water = 0, industry_demand_surface_water = 0, other_demand_surface_water = 0;
var domestic_demand_ground_water = 0, domestic_demand_ground_water_livestock = 0, irri_utili_ground_water = 0, industry_demand_ground_water = 0, other_demand_ground_water = 0;
function Info() {
    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/Water_Domestic_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {

            if (response == "Error") {
                window.location = "/Wsp_new/WaterDraft_report";
            }
            if (response == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }


            if (response.length != 0) {


                if (response[0].domestic_demand_surface_water_total_value != null && response[0].domestic_demand_surface_water_total_value != "") {
                    var ss = parseFloat(response[0].domestic_demand_surface_water_total_value);
                    if (isNaN(ss) == true) {
                        ss = 0;
                    }
                    domestic_demand_surface_water = ss.toFixed(2);

                }
                if (response[0].domestic_demand_ground_water_total_value != null && response[0].domestic_demand_ground_water_total_value != "") {
                    var ss = parseFloat(response[0].domestic_demand_ground_water_total_value);
                    if (isNaN(ss) == true) {
                        ss = 0;
                    }
                    domestic_demand_ground_water = ss.toFixed(2);

                }
                $('#domestic_demand_surface_water').text(parseFloat(domestic_demand_ground_water).toFixed(2));

                $('#domestic_demand_ground_water').text(parseFloat(domestic_demand_surface_water).toFixed(2));


                Domestic_Total = parseFloat(domestic_demand_surface_water) + parseFloat(domestic_demand_ground_water);
                $('#Domestic_Total').text(parseFloat(Domestic_Total).toFixed(2));

                Domestic.push(parseFloat(domestic_demand_surface_water));
                Domestic.push(parseFloat(domestic_demand_ground_water));

            }



        }
    });

}

function WaterUtilizationDetails() {
    Info();
    $.ajax({
        type: 'GET',
        contentType: 'application/json; chatset=utf-8',
        url: '/Wsp_new/WaterDraftInfo_Details',
        data: '',
        dataType: 'JSON',
        success: function (response) {
            //if (response == "Error") {
            //    window.location = "/Wsp_new/TotalReportwsp";
            //}
