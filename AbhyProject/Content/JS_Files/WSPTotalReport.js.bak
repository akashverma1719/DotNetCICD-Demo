                    $('#wb_drinking_from_gw').text(ss.toFixed(2));
                }
                if (response[0].wb_drinking_total != null) {
                    var ss = parseFloat(response[0].wb_drinking_total);
                    if (isNaN(ss) == true) {
                        ss = 0;
                    }
                    wb_drinking_total = ss;
                    $('#wb_drinking_total').text(ss.toFixed(2));
                }
                if (response[0].wb_irri_agri_sw != null) {
                    var ss = parseFloat(response[0].wb_irri_agri_sw);
                    if (isNaN(ss) == true) {
                        ss = 0;
                    }
                    wb_irri_agri_sw = ss;
                    $('#wb_irri_agri_sw').text(ss.toFixed(2));
                }
                if (response[0].wb_irri_agri_gw != null) {
                    var ss = parseFloat(response[0].wb_irri_agri_gw);
                    if (isNaN(ss) == true) {
                        ss = 0;
                    }
                    wb_irri_agri_gw = ss;
                    $('#wb_irri_agri_gw').text(ss.toFixed(2));
                }
                if (response[0].wb_irri_agri_total != null) {
                    var ss = parseFloat(response[0].wb_irri_agri_total);
                    if (isNaN(ss) == true) {
                        ss = 0;
                    }
                    wb_irri_agri_total = ss;
                    $('#wb_irri_agri_total').text(ss.toFixed(2));
                }





                Ground_Water.push(wb_drinking_from_gw);
                Ground_Water.push(wb_drinking_from_sw);

                Surface_Water.push(wb_irri_agri_gw);
                Surface_Water.push(wb_irri_agri_sw);
                BudgetCharts();

            }

        }
    });

}




