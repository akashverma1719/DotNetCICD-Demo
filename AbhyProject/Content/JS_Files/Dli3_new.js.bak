$(function () {

    $("input[name='numonlydecimal']").on('input', function (f) {
        $(this).val($(this).val().replace(/[^0-9.]/g, ''));
    });
});
$(function () {

    $("input[name='numonly']").on('input', function (f) {
        $(this).val($(this).val().replace(/[^0-9]/g, ''));
    });
});

