    $('#txtdepartment').val("0");
    $('#txtotherdepartment').val("");
    $('#txtschema').val("0");
    $('#txtotherScheme').val("");
    $('#r').val("");
    $('#s').val("");
    $('#t').val("");
    $('#u').val("");
    $('.loader').show();
    $('.disable').attr("disabled", "disabled");
    $('.disable').hide();
    Data_get();
}

