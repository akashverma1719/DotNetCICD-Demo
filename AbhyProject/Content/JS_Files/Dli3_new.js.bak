                    phasea = "";
                }
                if (phaseb == null) {
                    phaseb = "";
                }
                if (phasec == null) {
                    phasec = "";
                }
                if (phased == null) {
                    phased = "";
                }
                if (phasee == null) {
                    phasee = "";
                }
                if (phasef == null) {
                    phasef = "";
                }
                if (phaseg == null) {
                    phaseg = "";
                }
