                            Tbodyhtml += '<td id="vill">' + data[i].expenditure_phase1 + '</td>';
                            Tbodyhtml += '<td id="vill">' + data[i].remark_phase1 + '</td></tr>';
                        }
                        else {

                        }
                    }
                    // $('#leftoverphase1_data_old').html("");
                }
                $('#phase2_data').html(Tbodyhtml);
            }
        }
    });
}
