    }
    if (xx == 0) {
        $.ajax({
            type: 'POST',
            contentType: 'application/json; chatset=utf-8',
            url: '/DLI3New/supplysidephase1reject',
            data: "{'id': '" + id + "' , 'reject': '" + reject + "' }",
