                    var other_scheme = data[i].other_schema_name_phase1;
                    if (other_scheme == null) {
                        other_scheme = "";
                    }
                    var approve_phase1 = data[i].approve_phase1;
                    if (approve_phase1 == null) {
                        approve_phase1 = "";
