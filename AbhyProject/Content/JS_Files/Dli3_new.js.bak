function delete_phase2(id) {
    $('.loader').show();
    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: '/DLI3New/delete_phase2',
        data: "{'id': '" + id + "'}",
        dataType: 'JSON',
        success: function (response) {
            var data = response.split(',');
            var a = data[0];
            var b = data[1];
            alert(a);
            if (a == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            if (b == "No") {
                data_show_phase2(id);
            }
            else {
                Data_get_phase2();
                $("#exampleModal__ddphase_two").hide();
                $(".showdiv").show();
            }
        }
    });
}
