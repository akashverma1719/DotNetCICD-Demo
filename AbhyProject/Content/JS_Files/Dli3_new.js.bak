function sssummery() {
 $('#ssdistrict_p1').hide();
 $('#ssdistrict_p2').hide();
    var phase = $('#phase').val();
    if (phase == "phase1") {
        $('#btnexcelphase2').hide();
        $('#btnexcelphase1').show();
        if (State == "All") {
            $('#ssstate_p1').show();
            $('#ssdistrict_p1').hide();
            $('#ssdemanddistrictblock_p1').hide();
            $('#ssstate_p2').hide();
            $('#ssdistrict_p2').hide();
            $('#districtblock_p1').hide();

        }
        else if (State != "All" || State != "0") {
            if (Dist == "0") {
                $('#ssstate_p1').hide();
                $('#ssdistrict_p1').show();
                $('#ssdemanddistrictblock_p1').hide();
                $('#ssstate_p2').hide();
                $('#ssdistrict_p2').hide();
                $('#districtblock_p1').hide();
            }
            else if (Dist != "0") {
                if (Block == "0") {
                    $('#ssstate_p1').hide();
                    $('#ssdistrict_p1').hide();
                    $('#ssdemanddistrictblock_p1').show();
                    $('#ssstate_p2').hide();
                    $('#ssdistrict_p2').hide();
                    $('#districtblock_p1').hide();
                }
                else {
                    $('#ssstate_p1').hide();
                    $('#ssdistrict_p1').hide();
                    $('#ssdemanddistrictblock_p1').hide();
                    $('#ssstate_p2').hide();
                    $('#ssdistrict_p2').hide();
                    $('#districtblock_p1').hide();
                }
            }
            else {
                $('#ssstate_p1').hide();
                $('#ssdistrict_p1').hide();
                $('#ssdemanddistrictblock_p1').hide();
                $('#ssstate_p2').hide();
                $('#ssdistrict_p2').hide();
                $('#districtblock_p1').hide();
            }


        }
        else if (State != "All" || State != "0" || Dist != "0") {
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').hide();
            $('#ssdemanddistrictblock_p1').hide();
            $('#ssstate_p2').hide();
            $('#ssdistrict_p2').hide();
            $('#districtblock_p1').hide();
        }
        else {
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').hide();
            $('#ssdemanddistrictblock_p1').hide();
            $('#ssstate_p2').hide();
            $('#ssdistrict_p2').hide();
            $('#districtblock_p1').hide();
        }



    }
    if (phase == "phase2") {
        $('#btnexcelphase2').show();
        $('#btnexcelphase1').hide();
        if (State == "All") {
            $('#ssstate_p2').show();
            $('#ssdistrict_p2').hide();
            $('#ssdemanddistrictblock_p2').hide();
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').hide();
            $('#districtblock_p1').hide();
        }
        else if (State != "All" || State != "0") {
            if (Dist == "0") {
                $('#ssstate_p2').hide();
                $('#ssdistrict_p2').show();
                $('#ssdemanddistrictblock_p2').hide();
                $('#ssstate_p1').hide();
                $('#ssdistrict_p1').hide();
                $('#districtblock_p1').hide();
            }
            else if (Dist != "0") {
                if (Block == "0") {
                    $('#ssstate_p2').hide();
                    $('#ssdistrict_p2').hide();
                    $('#ssdemanddistrictblock_p2').show();
                    $('#ssstate_p1').hide();
                    $('#ssdistrict_p1').hide();
                    $('#districtblock_p1').hide();
                }
                else {
                    $('#ssstate_p2').hide();
                    $('#ssdistrict_p2').hide();
                    $('#ssdemanddistrictblock_p2').hide();
                    $('#ssstate_p1').hide();
                    $('#ssdistrict_p1').hide();
                    $('#districtblock_p1').hide();
                }
            }

        }

        else if (State != "All" || State != "0" || Dist != "0") {
            $('#ssstate_p2').hide();
            $('#ssdistrict_p2').hide();
            $('#ssdemanddistrictblock_p2').hide();
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').hide();
            $('#districtblock_p1').hide();
        }




    }
}
/*supplyside Phase2 end*/