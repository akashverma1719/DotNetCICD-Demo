function Data_get_phase2supply() {
    $('.loader').show();
    var year = $('#year').val();
    var month = $('#month').val();
    supply_val = $('#supply_val').val();


    var obj = {};
    obj.statename = State;
    obj.districtname = Dist;
    obj.blockname = Block;
    obj.gpname = Gram;
    obj.year = year;
    obj.month = month;
    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: '/DLI3New/Data_get_supply',
        data: "{'Data': '" + JSON.stringify(obj) + "','supply_val': '" + supply_val + "'}",
        dataType: 'JSON',
        success: function (data) {

            if (data == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            var tr = '';
            var sno = 0;
            if (data == 'No Data') {
                tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                $('#supply_tbl_details').html(tr);
            }
            else {
                if (data.length != 0) {
                    if (StateOfficer == "State Level Nodal Officer") {
                        for (var i = 0; i < data.length; i++) {
                            sno += 1;
                            var other_scheme = data[i].other_scheme;
                            if (other_scheme == null) {
                                other_scheme = "";
                            }
                            var entry_phase = data[i].entry_phase2;
                            if (entry_phase == null) {
                                entry_phase = "";
                            }
                            var approve = data[i].approve_phase2;
                            if (approve == null) {
                                approve = "";
                            }
                            if (approve == "Approved") {
                                if (entry_phase == "phase2") {
                                    tr += '<tr id="AWP1_TR' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gp + '</td><td>' + data[i].gp_center_point_latitude + '</td><td>' + data[i].gp_center_point_longitude + '</td><td>' + data[i].village_name + '</td><td>' + data[i].financial_year + '</td><td>' + data[i].type_of_supply_side_structure + '</td><td>' + data[i].name_of_structure + '</td><td>' + data[i].gw_recharge_or_effective_storage + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name_possible_funding_source + '</td><td>' + other_scheme + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].total_approximate_estimated_cost + '</td><td><button  class="btn btn-primary" data-toggle="modal" data-target="#exampleModal__phase_twoss"  onclick="fill_data_wsp_ss2phase2(' + data[i].id + ')">Edit / View Data</button ></td><td><label style="color: blue;">Approved</label></td><td></td><td><a href="/DLI3New/Mapview_supplysidePhase2?id=' + data[i].id + '" style="font-size: 35px;color: dodgerblue;" target="_blank"><i class="bi-geo-alt"></i></a></td></tr> ';
                                }
                            }
                            else if (approve == "Submit to SPMU") {
                                if (entry_phase == "phase2") {
                                    tr += '<tr id="AWP1_TR' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gp + '</td><td>' + data[i].gp_center_point_latitude + '</td><td>' + data[i].gp_center_point_longitude + '</td><td>' + data[i].village_name + '</td><td>' + data[i].financial_year + '</td><td>' + data[i].type_of_supply_side_structure + '</td><td>' + data[i].name_of_structure + '</td><td>' + data[i].gw_recharge_or_effective_storage + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name_possible_funding_source + '</td><td>' + other_scheme + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].total_approximate_estimated_cost + '</td><td><button  class="btn btn-primary" data-toggle="modal" data-target="#exampleModal__phase_twoss"  onclick="fill_data_wsp_ss2phase2(' + data[i].id + ')">Edit / View Data</button ></td><td><label style="color: green;">At SPMU</label></td><td></td><td><a href="/DLI3New/Mapview_supplysidePhase2?id=' + data[i].id + '" style="font-size: 35px;color: dodgerblue;" target="_blank"><i class="bi-geo-alt"></i></a></td></tr> ';
                                }
