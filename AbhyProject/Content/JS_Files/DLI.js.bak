function fill_data_wsp(id) {

    id = id;
    idd = id;
    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: '/DLI3New/filldata_demand_wsp',
        data: "{'id': '" + id + "'}",
        dataType: 'JSON',
        success: function (data) {

            var tr = '';
            var sno = 0;
            if (data.length != 0) {
                for (var i = 0; i < data.length; i++) {
                    var scheme_name = data[i].scheme_name;
                    if (scheme_name == "Other") {
                        var other = data[i].other_scheme;
                        var abc = scheme_name + ' - ' + other;
                        scheme_name = abc;
                    }
                    sno = i + 1;
                    tr += '<tr id="AWP1_TR' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gp + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].financial_year + '</td><td>' + data[i].fund_for + '</td><td>' + data[i].department_name + '</td><td>' + scheme_name + '</td><td>' + data[i].total_crop_area + '</td><td>' + data[i].area_proposed + '</td><td>' + data[i].approx_est_cost + '</td><td>' + data[i].total_water_demand + '</td><td>' + data[i].total_reduction_gw + '</td></tr> ';
                }
                $('#tbl_details_add').html(tr);
            }
        }
    });
}
var bb = 0;
function editrowcomp_A_Good_data(i) {

    bb = i;
    var other = $('#schemename_phase_aa' + i).val();
    if (other == "Other") {
        $('#otherschemename_phase_aa' + i).show();
    }
    else {
        $('#otherschemename_phase_aa' + i).hide();
    }
    var other_new = $('#schemename_phase_new' + i).val();
    if (other_new == "Other") {
        $('#otherschemename_phase_new' + i).show();
    }
    else {
        $('#otherschemename_phase_new' + i).hide();
    }
    $('#AWP1_TR_edit' + i).hide();
    $('#Hide_AWP1_TR_edit' + i).show();
    $('#Hide_AWP1_TR_edit_new' + i).hide();
    Department_name_old();
    Department_name_addnew();
}
function ddlother(i) {
    var other = $('#schemename_phase_aa' + i).val();
    if (other == "Other") {
        $('#otherschemename_phase_aa' + i).show();
    }
    else {
        $('#otherschemename_phase_aa' + i).hide();
    }
}
function ddlother_new(i) {
    var other_new = $('#schemename_phase_new' + i).val();
    if (other_new == "Other") {
        $('#otherschemename_phase_new' + i).show();
    }
    else {
        $('#otherschemename_phase_new' + i).hide();
    }
}
function ddlother_addnew(i) {
    var other_new = $('#schemename_phase' + i).val();
    if (other_new == "Other") {
        $('#otherschemename_phase' + i).show();
    }
    else {
        $('#otherschemename_phase' + i).hide();
    }
}

