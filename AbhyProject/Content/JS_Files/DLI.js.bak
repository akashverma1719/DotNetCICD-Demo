/*supplyside Phase1 start*/

function Dropdown_Search_supply() {
    $('.loader').show();
    var year = $('#year').val();
    Gram = $('#gram').val();
    var phase = $('#phase').val();
    var xx = 0;
    if (State == "0") {
        xx = 1;
        alert("Please Select State Name");
        $('.loader').hide();
    }
    if (xx == 0) {

        $.ajax({
            type: "Post",
            url: "/Home/StateLevel_Dropdown",
            contentType: "application/json;charset=utf-8",
            data: "{'StateName':'" + State + "','Dist':'" + Dist + "','Block':'" + Block + "','Gram':'" + Gram + "','year':'" + year + "'}",
            dataType: "json",
            success: function (results) {
                debugger;

                if (State == "All") {
                    $('.loader').hide();
                    if (phase == "phase1") {
                        $('#ssstate_p1').attr("disabled", false);
                        $('#btnexcelphase1').hide();
                        $('#btnexcelphase2').hide();
                        var tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                        $('#supply_tbl_details').html(tr);
                        $('#supply_total').html(0);
                        $('#ssstate_p2').hide();
                    }
                    if (phase == "phase2") {
                        $('#ssstate_p1').hide();
                        $('#ssstate_p2').attr("disabled", false);
                        $('#btnexcelphase1').hide();
                        $('#btnexcelphase2').hide();
                        $('#ssstate_p1').hide();
                        $('#ssdistrict_p1').hide();

                    }
                }
                else {
                    if (phase == "phase1") {
                        $('#btnexcelphase1').show();
                        $('#btnexcelphase2').hide();
                        $('#ssstate_p2').hide();
                        $('#ssdistrict_p2').hide();
                        $('#ssdistrict_p1').attr("disabled", false);
                        
                        Data_get_supply();
                    }
                    if (phase == "phase2") {
                        $('#ssdistrict_p2').attr("disabled", false);
                        $('#btnexcelphase1').hide();
                        $('#btnexcelphase2').show();
                        $('#ssstate_p1').hide();
                        $('#ssdistrict_p1').hide();

                        Data_get_phase2supply();
                    }
                }




            }
        });
    }
}

var supply_val = "";
function Data_get_supply() {
    $('.loader').show();
    var year = $('#year').val();
    var month = $('#month').val();
    supply_val = $('#supply_val').val();


    var obj = {};
    obj.statename = State;
    obj.districtname = Dist;
    obj.blockname = Block;
    obj.gpname = Gram;
    obj.year = year;
    obj.month = month;
    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: '/DLI3New/Data_get_supply',
        data: "{'Data': '" + JSON.stringify(obj) + "','supply_val': '" + supply_val + "'}",
        dataType: 'JSON',
        success: function (data) {

            if (data == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            var tr = '';
            var sno = 0;
            if (data == 'No Data') {
                tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                $('#supply_tbl_details').html(tr);
            }
            else {
                if (data.length != 0) {
                    if (StateOfficer == "State Level Nodal Officer") {
                        for (var i = 0; i < data.length; i++) {
                            sno += 1;
