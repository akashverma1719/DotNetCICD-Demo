/*phase2_start*/
function Data_get_phase2() {
    $('.loader').show();
    year = $('#year').val();
    month = $('#month').val();
    demand_val = $('#Demand_side').val();


    var obj = {};
    obj.statename = State;
    obj.districtname = Dist;
    obj.blockname = Block;
    obj.gpname = Gram;
    obj.year = year;
    obj.month = month;
    obj.PageNumber = PageNumberexe;
    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: '/DLI3New/Data_get',
        data: "{'Data': '" + JSON.stringify(obj) + "','demand_va': '" + demand_val + "'}",
        dataType: 'JSON',
        success: function (data) {

            if (data == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            var tr = '';
            var sno = 0;
            if (data == 'No Data') {
                tr = '<tr style="text-align:center;"><td colspan="15">No Data</td></tr>';
                $('#tbl_details').html(tr);
                $('#pdf').prop('disabled', true);
            }
            else {
                if (data.length != 0) {
                    if (StateOfficer == "State Level Nodal Officer") {
                        for (var i = 0; i < data.length; i++) {
                            sno = i + 1;
                            var entry_phase = data[i].entry_phase2;
                            if (entry_phase == null) {
                                entry_phase = "";
                            }
                            var approve = data[i].approve_phase2;
                            if (approve == null) {
                                approve = "";
                            }
                            if (approve == "Approved") {
                                if (entry_phase == "phase2") {
                                    tr += '<tr id="AWP1_TR' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gp + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].financial_year + '</td><td>' + data[i].fund_for + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].total_crop_area + '</td><td>' + data[i].area_proposed + '</td><td>' + data[i].approx_est_cost + '</td><td>' + data[i].total_water_demand + '</td><td>' + data[i].total_reduction_gw + '</td><td><button   class="btn btn-primary" data-toggle="modal" data-target="#exampleModal__ddphase_two"  onclick="data_show_phase2(' + data[i].id + ')">Edit / View Data</button ></td><td><label style="color: blue;">Approved</label></td><td></td></tr> ';
                                }

                            }
                            else if (approve == "Submit to SPMU") {
                                if (entry_phase == "phase2") {
                                    tr += '<tr id="AWP1_TR' + i + '"><td>' + (sno) + '</td><td>' + data[i].state + '</td><td>' + data[i].district + '</td><td>' + data[i].block + '</td><td>' + data[i].gp + '</td><td>' + data[i].latitude + '</td><td>' + data[i].longitude + '</td><td>' + data[i].financial_year + '</td><td>' + data[i].fund_for + '</td><td>' + data[i].department_name + '</td><td>' + data[i].scheme_name + '</td><td>' + data[i].total_crop_area + '</td><td>' + data[i].area_proposed + '</td><td>' + data[i].approx_est_cost + '</td><td>' + data[i].total_water_demand + '</td><td>' + data[i].total_reduction_gw + '</td><td><button   class="btn btn-primary" data-toggle="modal" data-target="#exampleModal__ddphase_two"  onclick="data_show_phase2(' + data[i].id + ')">Edit / View Data</button ></td><td><label style="color: green;">At SPMU</label></td><td></td></tr> ';
                                }
                            }
                            else if (approve == "Rejected") {
                                if (entry_phase == "phase2") {
