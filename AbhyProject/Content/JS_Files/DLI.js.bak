}
function Excel() {

    var year = $("#year").val();
    var demand_val = $('#Demand_side').val();

    if (State == "0") {
        alert("Please Select State");
        return false;
    }
    {
        window.location.href = "/Demand_new/Demand_excel?State=" + State + "&Dist=" + Dist + "&Block=" + Block + "&Gram=" + Gram + "&Year=" + year + "&demand_val=" + demand_val;
    }
}
function SessionInfo() {

    var obj = {};
    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: "/Demand_new/State_SessionInfo_1",
        data: "{'Data': '" + JSON.stringify(obj) + "'}",
        dataType: 'JSON',
        success: function (data) {

            if (data == "Logout") {
                window.location = "/WspNew/WSP_GWM_HOME";
            }
            else {
                $('#Error_').text("");

                $('#StateLabel').hide();
                $('#StateDropdownLabel').hide();
                $('#DistLabel').hide();
                $('#DistDropdownLabel').hide();
                $('#BlockLabel').hide();
                $('#BlockDropdownLabel').hide();
                $('#GramLabel').hide();
                $('#GramDropdownLabel').hide();
                $('#DropdownSearch_btn').hide();


                var Str = data.split(',');
                if (Str[0] == "Admin") {
                    $('#StateLabel').hide();
                    $('#StateDropdownLabel').show();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').show();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').show();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').show();
                    $('#DropdownSearch_btn').show();
                    $('.loader').hide();

                }
                else if (Str[0] == "State Level Nodal Officer") {
                    State = Str[1];
                    off_1 = "state";
                    $('#StateLabel').show();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').hide();
                    $('#DistDropdownLabel').show();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').show();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').show();
                    $('#DropdownSearch_btn').show();
                    State_Dropdown_Function();
                    State_Dropdown_Function();
                    $('.loader').hide();
                    var phase = $('#phase').val();
                    if (phase == "phase1") {
                        $('#district_p1').show();
                        $('#district_p2').hide();
                        $('#district_p1').attr("disabled", "disabled");
                        $('#ssdistrict_p1').show();
                        $('#ssdistrict_p2').hide();
                        $('#ssdistrict_p1').attr("disabled", "disabled");
                        
                    }
                    if (phase == "phase2") {
                        $('#district_p1').hide();
                        $('#district_p2').show();
                        $('#district_p2').attr("disabled", "disabled");
                        $('#ssdistrict_p1').hide();
                        $('#ssdistrict_p2').show();
                        $('#ssdistrict_p2').attr("disabled", "disabled");
                    }

                }
                else if (Str[0] == "District Level Nodal Officer") {
                    off_1 = "dist";
                    State = Str[1];
                    Dist = Str[2];
                    $('#StateLabel').show();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').show();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').hide();
                    $('#BlockDropdownLabel').show();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').show();
                    $('#DropdownSearch_btn').show();
                    Dist_fun();
                    Dist_fun();
                    $('.loader').hide();
                    $('#district_p1').hide();
                    $('#district_p1').attr("disabled", "disabled");
                    $('#block_p1').hide();
                    $('#block_p1').attr("disabled", "disabled");
                    $('#ssdistrict_p1').hide();
                    $('#ssdistrict_p1').attr("disabled", "disabled");
                    $('#ssblock_p1').hide();
                    $('#ssblock_p1').attr("disabled", "disabled");
                    $('#state_p2').hide();
                    $('#district_p2').hide();


                }
                else if (Str[0] == "Block Level Nodal Officer") {
                    off_1 = "block";
                    State = Str[1];
                    Dist = Str[2];
                    Block = Str[3];
                    $('#StateLabel').show();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').show();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').show();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').hide();
                    $('#GramDropdownLabel').show();
                    $('#DropdownSearch_btn').show();
                    Block_fun();
                    Block_fun();
                    $('.loader').hide();



                }
                else if (Str[0] == "Gram Panchyat Nodal Officer") {
                    State = Str[1];
                    Dist = Str[2];
                    Block = Str[3];
                    Gram = Str[4];
                    $('#StateLabel').show();
                    $('#StateDropdownLabel').hide();
                    $('#DistLabel').show();
                    $('#DistDropdownLabel').hide();
                    $('#BlockLabel').show();
                    $('#BlockDropdownLabel').hide();
                    $('#GramLabel').show();
                    $('#GramDropdownLabel').hide();
                    $('#DropdownSearch_btn').show();
                    $('.loader').hide();




                }


            }
        }

    });

}
function DropDownInfo() {

    $.ajax({
        type: 'POST',
        contentType: 'application/json; chatset=utf-8',
        url: "/Home/Sign_Up_DropdownInfo",
        data: "{ }",
        dataType: 'JSON',
        success: function (response) {

            if (response.length != 0) {
                Jsondata = response;
                $("#spnstate").empty();
                var opstate = '<option value="0">Select StateName</option>';
                $("#spnstate").append(opstate);
                $("#dist11").empty();
                var opdist = '<option value="0">Select District</option>';
                $("#dist11").append(opdist);
                $("#block1").empty();
                var opblock = '<option value="0">Select Block</option>';
                $("#block1").append(opblock);
                $("#gram").empty();
                var opgram = '<option value="0">Select GramPanchayat</option>';
                $("#gram").append(opgram);
                //var StateName = $("#spnstate").text();
                if (Jsondata.length != 0) {
                    var ddlst = {};
                    var all_dists = [];
                    var optionState = '';

                    for (var i = 0; i < Jsondata.length; i++) {

                        if (!ddlst[Jsondata[i].state_name]) {
                            all_dists.push(Jsondata[i].state_name);
                            ddlst[Jsondata[i].state_name] = Jsondata[i].state_name;

                        }
                    }
                    var DistArray = [];
                    DistArray = all_dists.sort(function (a, b) {
                        if (a < b) return -1;
                        else if (a > b) return 1;
                        return 0;
                    });
                    optionState = '<option value="0">Select StateName</option>';
                    optionState += '<option value="All">ALL</option>';

                    for (var i = 0; i < DistArray.length; i++) {
                        if (DistArray[i] != null && DistArray[i] != "") {
                            optionState += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';

                        }
                    }
                    $("#spnstate").html(optionState);

                }

            }

            SessionInfo();


        }
    });
}
function DBG_hide() {
    var state = $("#spnstate").val();
    if (state == "All") {
        $('#DistDropdownLabel').hide();
        $('#BlockDropdownLabel').hide();
        $('#GramDropdownLabel').hide();
    }
    else {
        $('#DistDropdownLabel').show();
        $('#BlockDropdownLabel').show();
        $('#GramDropdownLabel').show();
    }
}

function State_Dropdown_Function() {
    debugger;
    $('#state_p2').hide();
    $('#district_p2').hide();
    $('#ssstate_p2').hide();
    $('#ssdistrict_p2').hide();
   
    var state = $("#spnstate").val();
    var phase = $('#phase').val();
    if (phase == "phase1") {
        $('#ssstate_p2').hide();
        $('#ssdistrict_p2').hide();
        if (state == "All") {
            $("#dist11").prop("disabled", true);
            $("#block1").prop("disabled", true);
            $("#gram").prop("disabled", true);
            $('#state_p1').show();
            $('#district_p1').hide();
            $('#district_p1').attr("disabled", "disabled");
            $('#block_p1').hide();
            $('#block_p1').attr("disabled", "disabled");
            $('#ssstate_p1').show();
            $('#ssdistrict_p1').hide();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            $('#ssblock_p1').hide();
            $('#ssblock_p1').attr("disabled", "disabled");

            $('#state_p2').hide();
            $('#district_p2').hide();
        }
        else if (state == "0") {
            $('#state_p1').hide();
            $('#district_p1').hide();
            $('#block_p1').hide();
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').hide();
            $('#ssblock_p1').hide();
            $("#dist11").prop("disabled", false);
            $("#block1").prop("disabled", false);
            $("#gram").prop("disabled", false);
            $('#state_p2').hide();
            $('#district_p2').hide();
        }
        else {
            $('#state_p2').hide();
            $('#district_p2').hide();
            $("#dist11").prop("disabled", false);
            $("#block1").prop("disabled", false);
            $("#gram").prop("disabled", false);
            $('#state_p1').hide();
            $('#district_p1').show();
            $('#district_p1').attr("disabled", "disabled");
            $('#block_p1').show();
            $('#block_p1').attr("disabled", "disabled");
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').show();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            $('#ssblock_p1').show();
            $('#ssblock_p1').attr("disabled", "disabled");

        }
    }
    if (phase == "phase2") {

        if (state == "All") {
            $("#dist11").prop("disabled", true);
            $("#block1").prop("disabled", true);
            $("#gram").prop("disabled", true);
            $('#state_p1').hide();
            $('#district_p1').hide();
            $('#state_p2').show();
            $('#district_p2').hide();
            $('#state_p2').attr("disabled", "disabled");
            $('#district_p2').attr("disabled", "disabled");
            $('#ssstate_p1').hide();
            $('#ssstate_p2').show();
            $('#ssdistrict_p1').hide();
            $('#ssstate_p1').attr("disabled", "disabled");
            $('#ssstate_p2').attr("disabled", "disabled");
            $('#ssdistrict_p1').attr("disabled", "disabled");
            
           

        }
        else if (state == "0") {
            $('#state_p1').hide();
            $('#district_p1').hide();
            $('#state_p2').hide();
            $('#district_p2').hide();
            $('#block_p1').hide();
            $('#ssstate_p1').hide();
            $('#ssstate_p2').hide();
            $('#ssdistrict_p1').hide();
            $('#ssdistrict_p2').hide();
            $('#ssblock_p1').hide();
            $("#dist11").prop("disabled", false);
            $("#block1").prop("disabled", false);
            $("#gram").prop("disabled", false);

        }
        else {
            debugger;
            $("#dist11").prop("disabled", false);
            $("#block1").prop("disabled", false);
            $("#gram").prop("disabled", false);
            $('#state_p1').hide();
            $('#district_p1').hide();
            $('#district_p1').attr("disabled", "disabled");
            $('#district_p2').show();
            $('#district_p2').attr("disabled", "disabled");
            $('#ssstate_p1').hide();
            $('#ssdistrict_p1').hide();
            $('#ssdistrict_p2').show();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            $('#ssdistrict_p2').attr("disabled", "disabled");
           
        }
      
    }

    $("#dist11").empty();
    var opdist = '<option value="0">Select District</option>';
    $("#dist11").append(opdist);
    $("#block1").empty();
    var opblock = '<option value="0">Select Block</option>';
    $("#block1").append(opblock);
    $("#gram").empty();
    var opgram = '<option value="0">Select GramPanchayat</option>';
    $("#gram").append(opgram);

    var StateName = $("#spnstate").val();
    if (off_1 == "state") {
        StateName = State;
    } else {
        State = StateName;
    }

    if (StateName != "0" && Jsondata.length != 0) {
        var ddlst = {};
        var all_dists = [];
        var optionDist = '';
        for (var i = 0; i < Jsondata.length; i++) {
            if (StateName == Jsondata[i].state_name) {

                if (!ddlst[Jsondata[i].district_name]) {
                    all_dists.push(Jsondata[i].district_name);
                    ddlst[Jsondata[i].district_name] = Jsondata[i].district_name;

                }
            }
        }


        var DistArray = [];
        DistArray = all_dists.sort(function (a, b) {
            if (a < b) return -1;
            else if (a > b) return 1;
            return 0;
        });
        for (var i = 0; i < DistArray.length; i++) {
            if (DistArray[i] != null && DistArray[i] != "") {
                optionDist += '<option value="' + DistArray[i] + '">' + DistArray[i] + '</option>';
            }
        }
        $("#dist11").append(optionDist);
    }

}
function Dist_fun() {
    var phase = $('#phase').val();
    var dist = $("#dist11").val();
    if (phase == "phase1") {
        
        if (dist == 0) {
            $('#district_p1').show();
            $('#district_p1').attr("disabled", "disabled");
            $('#block_p1').show();
            $('#block_p1').attr("disabled", "disabled");
            $('#ssdistrict_p1').show();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            $('#ssblock_p1').show();
            $('#ssblock_p1').attr("disabled", "disabled");

        }
        else {
            $('#district_p1').hide();
            $('#district_p1').attr("disabled", "disabled");
            $('#block_p1').hide();
            $('#block_p1').attr("disabled", "disabled");
            $('#ssdistrict_p1').hide();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            $('#ssblock_p1').hide();
            $('#ssblock_p1').attr("disabled", "disabled");

        }
    }
    if (phase == "phase2") {
        if (dist == 0) {
            $('#district_p1').hide();
            $('#district_p1').attr("disabled", "disabled");
            $('#district_p2').show();
            $('#district_p2').attr("disabled", "disabled");
            $('#ssdistrict_p1').show();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            

        }
        else {
            $('#district_p2').hide();
            $('#district_p2').attr("disabled", "disabled");
            $('#district_p1').hide();
            $('#district_p1').attr("disabled", "disabled");
            $('#block_p1').hide();
            $('#block_p1').attr("disabled", "disabled");
            $('#ssdistrict_p1').hide();
            $('#ssdistrict_p1').attr("disabled", "disabled");
            
        }
    }
    $("#block1").empty();
    var opblock = '<option value="0">Select Block</option>';
    $("#block1").append(opblock);
    $("#gram").empty();
    var opgram = '<option value="0">Select GramPanchayat</option>';
    $("#gram").append(opgram);

    var dist = $("#dist11").val();
    if (off_1 == "dist") {
        dist = Dist;
    } else {
        Dist = dist;
    }

    if (dist != "0" && Jsondata.length != 0) {
        var ddlst = {};
        var all_blocks = [];
        var optionDist = '';
        for (var i = 0; i < Jsondata.length; i++) {
            //if (Jsondata[i].district_name == 'Kaithal' ) {
            //    alert(dist);

            //    return;
            //}

            if (dist == Jsondata[i].district_name && State == Jsondata[i].state_name) {

                if (!ddlst[Jsondata[i].block_name]) {
                    all_blocks.push(Jsondata[i].block_name);
                    ddlst[Jsondata[i].block_name] = Jsondata[i].block_name;
                    //  $("#block").append(optionDist);
                }
            }
        }


        var BlockArray = [];
        BlockArray = all_blocks.sort(function (a, b) {
            if (a < b) return -1;
            else if (a > b) return 1;
            return 0;
        });
        for (var i = 0; i < BlockArray.length; i++) {
            if (BlockArray[i] != null && BlockArray[i] != "") {
                optionDist += '<option value="' + BlockArray[i] + '">' + BlockArray[i] + '</option>';
            }
        }
        $("#block1").append(optionDist);

    }
}
function Block_fun() {

    $("#gram").empty();
    var opgram = '<option value="0">Select GramPanchayat</option>';
    $("#gram").append(opgram);
    var block = $("#block1").val();

    if (off_1 == "block") {
        block = Block;
    } else {
        Block = block;
    }


    if (block != "0" && Jsondata.length != 0) {
        var ddlst = {};
        var all_grams = [];
        var optionDist = '';
        for (var i = 0; i < Jsondata.length; i++) {
            if (State == Jsondata[i].state_name && Dist == Jsondata[i].district_name && block == Jsondata[i].block_name) {

                if (!ddlst[Jsondata[i].gram_panchayat_name]) {
                    ddlst[Jsondata[i].gram_panchayat_name] = Jsondata[i].gram_panchayat_name;
                    all_grams.push(Jsondata[i].gram_panchayat_name);
                    //   $("#gram").append(optionDist);
                }
            }
        }


        var GramArray = [];
        GramArray = all_grams.sort(function (a, b) {
            if (a < b) return -1;
            else if (a > b) return 1;
            return 0;
        });
        for (var i = 0; i < GramArray.length; i++) {
            if (GramArray[i] != null && GramArray[i] != "") {

                optionDist += '<option value="' + GramArray[i] + '">' + GramArray[i] + '</option>';
            }
        }
        $("#gram").append(optionDist);
    }
}
