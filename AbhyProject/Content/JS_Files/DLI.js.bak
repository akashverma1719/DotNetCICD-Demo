    var phase = $('#phase').val();
    var xx = 0;
    if (State == "0") {
        xx = 1;
        alert("Please Select State Name");
        $('.loader').hide();
    }
    //if (StateOfficer != "Admin" && StateOfficer != "National Level Nodal Officer") {
    //    if (Dist == "0") {
    //        xx = 1;
