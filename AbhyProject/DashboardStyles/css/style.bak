/* By Mohit Ends Here */

.topbar_whitebox {
    width: 15px;
    height: 15px;
    background: #fff;
    border: 2px solid #f3f3f3;
    margin-right: 3px;
}

.topbar_blackbox {
    width: 15px;
    height: 15px;
    background: #000;
    border: 1px solid #e3e3e3;
}

.topscreenreader_txt {
    font-weight: 500;
    font-size: 13px;
    line-height: 18px;
    text-align: left;
    color: #fff;
}

    .topscreenreader_txt:hover {
        text-decoration: none;
    }

.topsearch {
    font-size: 14px;
    color: #fff;
    padding-left: 8px;
}

.topbar_rightsec {
    padding-left: 0px;
    list-style-type: none;
    display: flex;
    align-items: center;
    line-height: 15px;
}

.topbar_leftsec {
    padding-left: 0px;
    list-style-type: none;
    display: flex;
    align-items: center;
    line-height: 15px;
    justify-content: end;
}

.topbar_rightsec li {
    position: relative;
}

.topbar_leftsec li {
    position: relative;
}

.topbar_rightsec li:not(:last-child):after {
    content: "";
    position: absolute;
    z-index: 1;
    border-right: 1px solid #cdcaca;
    display: block;
    top: 0;
    right: 0;
    height: 100%;
}

#language-picker-select {
    border: none;
    background-color: rgb(9 64 128);
    color: white;
}

.topbar_leftsec {
    padding-left: 0px;
    list-style-type: none;
    display: flex;
    align-items: center;
    line-height: 15px;
}

.smallfont {
    font-size: 12px;
}

.screen-brd {
    border-right: 1px solid #cdcaca;
}

    .screen-brd a {
        font-size: 13px;
        color: white;
    }

.top-banner-bg {
    padding: 5px;
    background: #094080;
}

.container-wrapper {
    width: 100%;
    margin: 0 auto;
}

.logo-right-brd {
    border-right: 2px solid #b1aaaa;
}

.header-wrap-bg {
    background-image: url("../images/sec-top-banner-bg.png");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center top;
}

.link-col {
    display: flex;
    flex-direction: column;
    flex-basis: 100%;
    flex: 1;
    align-items: center;
}

.link-icon-width {
    width: 20px;
}

.external-link-icon {
    background-color: #d5d942;
    border-radius: 50%;
    width: 43px;
    height: 43px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.external-link-p {
    font-size: 12px;
    font-weight: 500;
    text-align: center;
    margin-top: 7px;
    line-height: 13px;
    padding: 0px 2px;
}

.atal-icon-sec {
    height: 73px;
}

.atal-logo-sec {
    height: 60px;
    margin-left: 9px;
}

.navigation-bar {
    position: relative;
    width: 100%;
    background: blue;
}

.bar1,
.bar2,
.bar3 {
    width: 25px;
    height: 2px;
    background-color: #fff;
    transition: 0.4s;
    margin: 2px 0px 5px 0px;
}

.change .bar1 {
    -webkit-transform: rotate(-45deg) translate(-9px, 6px);
    transform: rotate(-45deg) translate(-9px, 6px);
}

.change .bar2 {
    opacity: 0;
}

.change .bar3 {
    -webkit-transform: rotate(45deg) translate(-4px, -1px);
    transform: rotate(45deg) translate(-4px, -1px);
}

.atal-jal-para {
    margin-top: 30px;
    font-weight: normal;
    font-size: 16px;
    line-height: 25px;
    text-align: justify;
    color: #6d6e71;
}

.project-at-image {
    position: relative;
}

.footer_links {
    font-size: 14px;
    line-height: 31px;
    text-align: left;
    color: #fff;
}

    .footer_links:hover {
        transition: all 0.3s cubic-bezier(0, 0, 0.23, 1);
    }

#topBanner .culturalActivitySlider-arrowbtn .swiper-button-prev {
    left: 6%;
    top: 55%;
    /* color: #000; */
    font-size: 17px;
    width: 35px;
    height: 35px;
    background: transparent;
    /* box-shadow: 0px 3px 15px rgb(0 0 0 / 17%); */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* border: 1px solid #000; */
}

#topBanner .culturalActivitySlider-arrowbtn .swiper-button-next {
    /* color: #000; */
    top: 55%;
    right: 6%;
    font-size: 17px;
    box-shadow: 0px 3px 96px rgb(215 208 208 / 7%);
    width: 35px;
    height: 35px;
    background: transparent;
    /* box-shadow: 0px 3px 15px rgb(0 0 0 / 17%); */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* border: 1px solid #000; */
}

#topBanner .swiper-button-next:after,
#topBanner .swiper-button-prev:after {
    content: unset;
}

.news-section-dark-text {
    font-size: 13px;
    /* line-height: 16px; */
    color: #000;
    /* margin-bottom: 10px; */
    width: 70%;
}

.news-section-light-text {
    font-size: 13px;
    /* line-height: 12px; */
    color: #000;
    /* margin-bottom: 10px; */
    font-family: italic;
}

.table-header {
    background-color: #004592;
}

.about-atal-jal-button {
    background: rgb(169, 233, 67);
    border: none;
    padding: 5px 16px 5px 16px;
    cursor: pointer;
    margin-top: 44px;
    font-size: 16px;
    line-height: 30px;
    text-align: center;
    color: #000;
    outline: none;
}

.topscreenreader_txt:hover {
    text-decoration: none;
    color: #eee;
}

.table-header p {
    color: #fff;
    font-size: 15px;
    line-height: 16px;
    text-align: center;
}

.get-intouch-txt {
    color: #337ab7;
    font-size: 30px;
    font-weight: 600;
    margin-bottom: 20px;
}

.pl-50 {
    padding-left: 50px;
}

.contact-detail-p {
    font-size: 15px;
    line-height: 22px;
}

.banner-prevnextbtn {
    background: aliceblue;
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 25px;
    font-weight: 700;
    box-shadow: 0px 3px 15px rgb(0 0 0 / 17%);
}

.readmore-link a {
    text-decoration: underline;
    color: #fff;
}

.style-1::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
    border-radius: 10px;
    background-color: #F5F5F5;
}

.style-1::-webkit-scrollbar {
    width: 12px;
    background-color: #F5F5F5;
}

.style-1::-webkit-scrollbar-thumb {
    border-radius: 10px;
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
    background-color: #004592;
}

.style-1 {
    overflow-y: auto;
}

.style-2 {
    height: 320px;
    overflow-x: hidden !important;
    overflow-y: visible;
}

    .style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 10px;
        background-color: #F5F5F5;
    }

    .style-2::-webkit-scrollbar {
        width: 12px;
        background-color: #F5F5F5;
    }

    .style-2::-webkit-scrollbar-thumb {
        border-radius: 10px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: #004592;
    }

.container_width {
    height: 410px !important;
}

#table {
    font-family: arial, sans-serif;
    border-collapse: collapse;
    width: 100%;
}

    #table td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    #table tr:nth-child(even) {
        background-color: #dddddd;
    }

.style-1::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
    border-radius: 10px;
    background-color: #F5F5F5;
}

.style-1::-webkit-scrollbar {
    width: 12px;
    background-color: #F5F5F5;
}

.style-1::-webkit-scrollbar-thumb {
    border-radius: 10px;
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
    background-color: #004592;
}

#evecal {
    position: relative;
}

.year_box {
    flex-direction: column;
    background: aliceblue;
    padding: 10px;
    display: none;
    margin-top: 10px;
}

    .year_box a {
        border-bottom: 1px solid;
        line-height: 24px;
        font-size: 14px;
        display: flex;
        align-items: center;
        width: 100%;
        justify-content: space-between;
    }

.tablinks:active {
    position: relative;
}

.tablinks.active .year_box {
    display: block;
}

.year_box a p {
    height: 17px;
    width: 17px;
    background: #3a99ed;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fff;
    font-size: 12px;
}

.search-container {
    float: right;
    margin-bottom: 10px;
}

.tabcontent input[type=text] {
    padding: 6px;
    margin-top: 8px;
    font-size: 17px;
    border: 1px solid #e3e3e3;
}

.search-container button {
    float: right;
    padding: 6px 10px;
    margin-top: 8px;
    margin-right: 16px;
    background: #ddd;
    font-size: 18px;
    border: none;
    cursor: pointer;
}

.topnav .search-container button:hover {
    background: #ccc;
}

.text-black {
    color: black !important
}
