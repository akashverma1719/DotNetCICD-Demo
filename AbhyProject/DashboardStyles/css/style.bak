/* about atal jal */
.about-atal-jal .heading {
    position: relative;
    display: inline-block;
}


    .about-atal-jal .heading::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 135%;
        width: 100%;
        height: 4px;
        background: rgb(169, 233, 67);
    }

.about-atal-jal button {
    background: rgb(169, 233, 67);
    border: none;
    padding: 5px 16px 5px 16px;
    cursor: pointer;
    margin-top: 44px;
    font-size: 16px;
    line-height: 30px;
    text-align: center;
    color: #000;
    outline: none;
}

    .about-atal-jal button:hover {
        opacity: 0.8;
        color: rgb(11, 13, 110);
    }

.about-atalvideo {
    position: relative;
    height: 310px;
}

    .about-atalvideo video {
        height: 100%;
        width: 100%;
    }



    .about-atalvideo .fa {
        font-size: 100px;
        color: rgb(247, 245, 245);
    }

.about-atalvideo {
    position: relative;
}

    .about-atalvideo .fa {
        position: absolute;
        transform: translate(-50%, -50%);
        top: 50%;
        left: 50%;
    }
/* Related Websites */
.related-websites {
    background-color: #eef1f5;
}

.websites-text .heading {
    position: relative;
    display: inline-block;
}

    .websites-text .heading:after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        margin-top: 10px;
        width: 50%;
        height: 4px;
        background: rgb(169, 233, 67);
    }

.web-text-border p {
    position: relative;
    display: inline-block;
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
}

    .web-text-border p:hover {
        color: blue;
    }

    .web-text-border p:after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        margin-top: 10px;
        width: 100%;
        height: 1px;
        background: rgb(92, 88, 88);
    }

.web-text {
    margin-bottom: 30px;
}
/* project at a glance */
.bg-image .heading {
    position: relative;
    display: inline-block;
}

.bg-image .circle p {
    font-size: 10px;
}

.bg-image .heading::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 10px;
    width: 100%;
    height: 4px;
    background: rgb(169, 233, 67);
}

.bg-image {
    background-image: url("../images/projectataglance-bg.jpg");
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

    .bg-image .circle {
        position: relative;
    }

.project-at-image .text-over-image p {
    color: white;
}

.bg-image .para-center-one {
    color: white;
    position: absolute;
    top: 22%;
    left: 25%;
    transform: translate(-50%, -50%);
}

.bg-image .para-center-two {
    color: white;
    position: absolute;
    top: 20%;
    left: 38%;
    transform: translate(50%, 50%);
}

.bg-image .para-center-three {
    color: white;
    position: absolute;
    top: 50%;
    left: 36%;
    transform: translate(-100%, 100%);
}

.bg-image .map .svg-map-cursor-pointer {
    cursor: pointer;
}

/* footer */
footer {
    /* background: linear-gradient(42deg, rgba(11, 25, 179, 85%), rgba(10, 14, 221)), 
  url(../images/maskedFooter.png); */
    background: url(../images/footerbg.jpg) no-repeat;
    background-size: 100% 100%;
}

.footer-heading {
    color: rgb(214, 142, 8);
    font-size: 18px;
    margin-bottom: 15px;
}

footer p a {
    font-size: 13px;
    color: white;
    text-decoration: none;
}

footer address {
    color: white;
    font-size: 14px;
    line-height: 23px;
}

footer p a:hover {
    color: rgb(214, 142, 8);
    text-decoration: none;
}

.copyright {
    color: white;
    font-size: 13px;
    background-color: #094080;
}

.visitors span {
    color: white;
    font-size: 13px;
}

.visitors .number {
    background-color: rgb(228, 149, 4);
    padding: 5px 20px 10px 5px;
    font-size: 20px;
}

