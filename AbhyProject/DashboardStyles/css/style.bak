/* By MOHIT start*/
#blink {
    animation: blinker 10s linear infinite;
    color: #1c87c9;
    font-size: 30px;
    font-weight: bold;
    font-family: sans-serif;
}

@keyframes blinker {
    50% {
        opacity: 0;
    }
}

.social-icons {
    padding: 5px;
    font-size: 15px;
    width: 25px;
    text-align: center;
    text-decoration: none;
    border-radius: 5px;
    color: white;
}

.fa-facebook {
    background: #216aca;
    color: white;
}

.fa-twitter {
    background: #55acee;
    color: white;
}

.fa-youtube-play {
    background-color: rgb(139, 13, 13);
}

.fa-instagram {
    background: #f09433;
    background: -moz-linear-gradient( 45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100% );
    background: -webkit-linear-gradient( 45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100% );
    background: linear-gradient( 45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100% );
    filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#f09433', endColorstr='#bc1888', GradientType=1);
}

.searchBar {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
}

#searchQueryInput {
    width: 168px;
    height: 30px;
    background: #f5f5f5;
    outline: none;
    border: none;
    border-radius: 1.625rem;
    padding: 0 3.5rem 0 1.5rem;
    font-size: 12px;
}

#searchQuerySubmit {
    background: none;
    border: none;
    outline: none;
    position: absolute;
    right: 8%;
    top: 10%;
}

    #searchQuerySubmit:hover {
        cursor: pointer;
    }

.home-page {
    background-color: #004592;
}

.whats-new-bg {
    background-repeat: no-repeat;
    background-size: cover;
    background: linear-gradient(0deg, rgb(0 69 146 / 99%), rgb(0 69 146 / 59%)), url(../images/whats-new-bg.png);
    background-position: center top;
    /* padding-right: 60px; */
}

.heading {
    line-height: 35px;
    font-size: 30px;
    text-align: left;
    color: #000;
}

.home-page .heading {
    position: relative;
    display: inline-block;
}

.news-part {
    align-items: center;
    justify-content: space-between;
}

.home-page .heading::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 10px;
    width: 80%;
    height: 4px;
    background: rgb(169, 233, 67);
}

.home-page .swiper-slide img {
    height: 400px;
}

