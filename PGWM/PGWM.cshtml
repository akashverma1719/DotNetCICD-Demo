<script>
    $(function () {
        $("#meeting_date").datepicker({
            dateFormat: 'dd-mm-yy',
            changeMonth: true,
            changeYear: true,
        });
    });

    function GetVillageName() {
        var slection_options = '';
        $.ajax({
            type: 'POST',
            dataType: 'JSON',
            url: '/WSP_23_24_updation/GetVillageName',
            data: {},
            success: function (data) {

                const Response = data.split(',');
                slection_options += '<option value="0">--Select VillageName-- </option>';

                for (var i = 0; i < Response.length; i++) {
                    slection_options += '<option value="' + Response[i] + '"> ' + Response[i] + ' </option>';
                    console.log(Response[i]);
                }
                $('#village_pgwm').html(slection_options);

            }
        });

    }


</script>